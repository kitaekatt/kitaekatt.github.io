        unittest.main(verbosity=2)
    except Exception:                          # pragma: no cover
        traceback.print_exc()
        sys.exit(1)
#!/usr/bin/env python3
"""End-to-end acceptance for the balance loop: a bounded run, twice, identical.

Architecture stage S5's own gate, in the form that can run everywhere and on
every build. It drives the REAL C simulator through the whole loop -- score the
base state, emit seeded candidates, stage each one on disk, re-simulate,
accept/reject, archive, verify, re-score -- and then does it again into the
same path and requires the archive artifacts to be BYTE-IDENTICAL.

WHAT IS DELIBERATELY NOT HERE: the solver. This test runs the `no-perfect`
roster at `--solve-profile skip`, so it needs no GPU, no torch, no node and no
policy set, and it finishes in seconds. The solver-backed acceptance (full
36-entrant roster, coarse profile, CUDA backend) is a manual, GPU-bound run;
its command and its recorded numbers are in
`sandboxes/monkey-baiting/CLAUDE.md` and in section 8.1 of the architecture
spec. Putting it in ctest would make the suite depend on a particular GPU.

SKIPS when mb_sim is not where a standard build puts it (`MB_SIM`, or the
usual build outputs), the same rule test_mb_driver follows.

Run directly:
    python3 sandboxes/monkey-baiting/tests/test_mb_loop_acceptance.py
"""

from __future__ import annotations

import json
import os
import shutil
import sys
import tempfile
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
SANDBOX = HERE.parent
ROOT = SANDBOX.parent.parent
sys.path.insert(0, str(SANDBOX / "tools"))

from mb_loop import archive, runner  # noqa: E402
from mb_loop.search import KNOB_DEFAULTS  # noqa: E402

GRAMMAR = SANDBOX / "data" / "balance-grammar.yaml"

# Pinned so the archive is a pure function of its inputs (runner.RunOptions
# pin_clock). Any ISO-8601 instant will do; this one is the stage's date.
PIN_CLOCK = "2026-07-30T00:00:00+00:00"

# Bounded on purpose: this is an acceptance gate, not a campaign.
KNOBS = {**KNOB_DEFAULTS, "max_depth": 2, "candidates_per_depth": 2,
         "failure_budget": 2, "eval_seeds": 2}
SEED = 21

# Archive artifacts to compare. The scratch trees (emit/, stage/, solve/) are
# byproducts, not archive; run.json and the round records are the contract.
ARTIFACTS = ("run.json", "grammar.yaml", "pins.yaml", "base", "rounds", "final")


def _mb_sim() -> Path | None:
    env = os.environ.get("MB_SIM")
    if env and Path(env).exists():
        return Path(env)
    for cand in ("build/local/Release/mb_sim.exe", "build/local/Debug/mb_sim.exe",
                 "build/local/mb_sim", "build/local/mb_sim.exe"):
        p = ROOT / cand
        if p.exists():
            return p
    return None


MB_SIM = _mb_sim()


def _snapshot(run_dir: Path, dest: Path) -> dict[str, bytes]:
    """Copies the archive artifacts out of a run directory and returns their
    bytes keyed by relative path."""
    out: dict[str, bytes] = {}
    for name in ARTIFACTS:
        src = run_dir / name
        if not src.exists():
            continue
        target = dest / name
        if src.is_dir():
            shutil.copytree(src, target)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, target)
    for p in sorted(dest.rglob("*")):
        if p.is_file():
            out[str(p.relative_to(dest)).replace("\\", "/")] = p.read_bytes()
    return out


@unittest.skipIf(MB_SIM is None, "mb_sim binary not built")
class TestLoopAcceptance(unittest.TestCase):
    def test_bounded_run_completes_archives_and_replays_identically(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            run_dir = tmp / "run"          # SAME path both passes, by design:
            runs_root = tmp / "runs"       # the paths are then identical by
            snapshots = []                 # construction and what is compared
            outcomes = []                  # is the loop's own determinism

            for attempt in (1, 2):
                shutil.rmtree(run_dir, ignore_errors=True)
                shutil.rmtree(runs_root, ignore_errors=True)
                runs_root.mkdir(parents=True)
                heights = archive.HeightArchive(runs_root / "archive.json")
                opts = runner.RunOptions(
                    sandbox=SANDBOX, root=ROOT, seed=SEED, out=run_dir,
                    runs_root=runs_root, knobs=dict(KNOBS),
                    roster_mode="no-perfect", solve_profile="skip",
                    binary=MB_SIM, pin_clock=PIN_CLOCK, quiet=True)
                outcome = runner.run_once(opts, heights, log=lambda line: None)
                outcomes.append(outcome)
                self.assertEqual(outcome.exit_code, 0, outcome.failure)
                snapshots.append(_snapshot(run_dir, tmp / f"pass{attempt}"))

            # --- the run did real work ------------------------------------
            first = outcomes[0]
            self.assertGreater(first.rounds, 0, "no rounds were evaluated")
            self.assertIsNotNone(first.base_score)
            self.assertTrue(first.end_reason)
            self.assertGreater(first.timings["tournament_ms"], 0.0,
                               "the C simulator was never invoked")

            # --- the archive is well formed -------------------------------
            self.assertEqual(archive.verify(run_dir), [])
            doc = archive.read_run(run_dir)
            self.assertEqual(doc["run"]["status"], "complete")
            self.assertEqual(len(doc["rounds"]), first.rounds)
            self.assertEqual(doc["run"]["sim"]["sim_version"], "mb-1")
            self.assertIsNotNone(doc["stack"])
            self.assertIn("comparability", doc["stack"])

            # every round carries the oracle stamp and a real candidate
            for r in doc["rounds"]:
                self.assertEqual(r["score"]["sim_version"], "mb-1")
                self.assertTrue(r["score"]["sim_hash"])
                self.assertEqual(r["candidate"]["schema"], "mb-patch/2")
                self.assertTrue(r["candidate"]["edits"])
                self.assertIn(r["score"]["verdict"], ("accept", "reject"))

            # --- re-scoring the stored inputs reproduces the run ----------
            rescored = archive.rescore(run_dir, GRAMMAR)
            self.assertEqual(rescored["base"]["old_score"],
                             rescored["base"]["new_score"])
            for r in rescored["rounds"]:
                self.assertEqual(r["old_score"], r["new_score"], r["round"])
                self.assertEqual(r["old_verdict"], r["new_verdict"], r["round"])
            self.assertEqual(rescored["revoked"], 0)

            # --- the two passes are byte-identical ------------------------
            a, b = snapshots
            self.assertEqual(sorted(a), sorted(b), "archive file sets differ")
            differing = [k for k in a if a[k] != b[k]]
            self.assertEqual(differing, [],
                             f"{len(differing)} archive artifact(s) differ "
                             f"between two identical runs")
            self.assertGreater(len(a), 5, "suspiciously few artifacts compared")

            # and the two runs agree on what they found
            self.assertEqual(outcomes[0].run_id, outcomes[1].run_id)
            self.assertEqual(outcomes[0].base_score, outcomes[1].base_score)
            self.assertEqual(outcomes[0].final_score, outcomes[1].final_score)
            self.assertEqual(outcomes[0].accepted, outcomes[1].accepted)
            self.assertEqual(json.dumps(outcomes[0].heights, sort_keys=True),
                             json.dumps(outcomes[1].heights, sort_keys=True))

    def test_the_canonical_data_is_never_written(self) -> None:
        """The loop's hardest rule: a run evaluates through overlays and stages,
        and touches data/ only under an explicit --apply."""
        before = {p: p.read_bytes() for p in
                  sorted((SANDBOX / "data").rglob("*.yaml"))}
        before[SANDBOX / "app.yaml"] = (SANDBOX / "app.yaml").read_bytes()
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            opts = runner.RunOptions(
                sandbox=SANDBOX, root=ROOT, seed=SEED, out=tmp / "run",
                runs_root=tmp / "runs",
                knobs={**KNOBS, "max_depth": 1, "candidates_per_depth": 1,
                       "failure_budget": 1},
                roster_mode="no-perfect", solve_profile="skip",
                binary=MB_SIM, pin_clock=PIN_CLOCK, quiet=True)
            runner.run_once(opts, None, log=lambda line: None)
        for path, content in before.items():
            self.assertEqual(path.read_bytes(), content,
                             f"the run modified canonical data: {path}")


if __name__ == "__main__":
    unittest.main(verbosity=2)
/* MONKEY BAITING - simulator tests (stage 2).
 *
 * Covers: the rules load and its refusal to default anything, the C schema
 * against the on-disk component YAML (the drift guard), the character/move
 * tables and their data-driven cap assertions, the entrant identity format
 * and its refusals, the accumulating-division residual, the batch world
 * build, canonical result ordering, repeat determinism, batch-width
 * invariance, and the non-triviality of real matches (KOs happen, both sides
 * win, frame counts vary) - the determinism items being the permanent gates
 * from the architecture spec section 6.2, in miniature. */
#include "test.h"

#include "mb_world.h"
#include "mb_rules.h"
#include "mb_step.h"
#include "mb_rng.h"
#include "mb_perfect.h"
#include "mb_pool.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SANDBOX "sandboxes/monkey-baiting"

/* The real solved policies are large and regenerable, so they live outside
 * the repo data dirs and are gitignored. The one test that wants a real
 * artefact SKIPS when they are absent rather than failing a clean checkout;
 * everything about the loader and the index math is covered by the tiny
 * fixture in tests/fixtures, which IS checked in. */
#ifndef PERFECT_DIR
#define PERFECT_DIR "web/monkey-baiting/policies-full-v3"
#endif

static MbRules g_rules;
static int g_rules_ok = 0;

/* Build a canonical queue over the first `entrants` roster characters, each
 * running the `house` bot: every pairing, `seeds` matches each, sides
 * swapping on odd seeds. Entrant ids are the real "<char>:<bot>" format. */
static int build_queue(MbPairing *q, int cap, int entrants, int seeds) {
    int i, j, s, k = 0;
    char id[MB_MAX_CHARS][48];
    int house = mb_rules_bot_id("house");

    for (i = 0; i < entrants; i++)
        snprintf(id[i], sizeof(id[i]), "%s:house",
                 mb_rules_char_name(i % g_rules.chars.count));

    for (i = 0; i < entrants; i++) {
        for (j = i + 1; j < entrants; j++) {
            for (s = 1; s <= seeds && k < cap; s++) {
                int a = (s % 2 == 1) ? i : j;
                int b = (s % 2 == 1) ? j : i;
                q[k].entrant0 = a;
                q[k].entrant1 = b;
                q[k].char0 = a % g_rules.chars.count;
                q[k].char1 = b % g_rules.chars.count;
                q[k].bot0 = house;
                q[k].bot1 = house;
                q[k].seed_index = s;
                q[k].seed = mb_seed_for(id[a], id[b], s);
                k++;
            }
        }
    }
    return k;
}

static uint32_t run_queue(const MbPairing *q, int n, int batch, int64_t *ticks) {
    MbWorld *w = mb_world_create(&g_rules, batch);
    uint32_t h;
    if (!w) return 0;
    if (!mb_world_set_queue(w, q, n)) { mb_world_destroy(w); return 0; }
    if (!mb_world_run(w, 0, ticks)) { mb_world_destroy(w); return 0; }
    h = mb_world_result_hash(w);
    mb_world_destroy(w);
    return h;
}

/* ---------------------------------------------------------------- tests */

TEST(rules_load_from_yaml) {
    ASSERT(g_rules_ok);
    ASSERT_EQ(g_rules.logic_hz, 60);
    ASSERT_EQ(g_rules.ring_left, 26);
    ASSERT_EQ(g_rules.ring_right, 374);
    ASSERT_EQ(g_rules.ring_center, 200);
    ASSERT_EQ(g_rules.ring_start_offset, 70);
    ASSERT_EQ(g_rules.intro_frames, 170);
    ASSERT_EQ(g_rules.end_frames, 140);
    ASSERT_EQ(g_rules.time_seconds, 120);
    ASSERT_EQ(g_rules.max_rounds_per_match, 5);
    ASSERT_EQ(g_rules.wins_to_take_match, 2);
    ASSERT_EQ(g_rules.ai_decision_interval, 16);
    /* 0.2 in Q16.16, rounded: 0.2 * 65536 = 13107.2 */
    ASSERT_EQ(g_rules.block_chip_ratio, 13107);
    ASSERT_EQ(g_rules.knockback_scale, MB_FP_ONE);
    ASSERT(g_rules.chars.count >= 2);
    ASSERT_EQ(g_rules.chars.max_health[0], mb_from_int(100));
    ASSERT_STR_EQ(mb_rules_char_name(0), "jacco");
    /* finisher.window_seconds 6.0 * 60 Hz */
    ASSERT_EQ(g_rules.finisher_window_frames, 360);
}

/* Every constant that used to be a literal in logic.js is now data. These
 * are the exact Q16.16 conversions of the authored decimals. */
TEST(the_js_literals_are_now_authored_data) {
    ASSERT_EQ(g_rules.ko_fall_vy, -(mb_fp)(32 * 65536 / 10));      /* -3.2 */
    ASSERT_EQ(g_rules.ko_fall_vx, (mb_fp)(22 * 65536 / 10));       /*  2.2 */
    /* 0.85 * 65536 = 55705.6 -> 55706; 0.86 * 65536 = 56360.96 -> 56361 */
    ASSERT_EQ(g_rules.idle_vx_decay, 55706);
    ASSERT_EQ(g_rules.stun_vx_decay, 56361);
    ASSERT_EQ(g_rules.knockback_vy_scale, 85197);                  /*  1.3 */
    ASSERT_EQ(g_rules.launch_vy_threshold, 91750);                 /*  1.4 */
    ASSERT_EQ(g_rules.separate_inset, mb_from_int(4));
    ASSERT_EQ(g_rules.separate_y_window, mb_from_int(20));
    ASSERT_EQ(g_rules.retreat_step, (mb_fp)(25 * 65536 / 10));     /*  2.5 */
    ASSERT_EQ(g_rules.stance_attacker_stun, 18);
    ASSERT_EQ(g_rules.coins_margin, 20);
    ASSERT_EQ(g_rules.thrown_spread, 60);
}

TEST(rules_load_refuses_a_missing_file) {
    MbRules bad;
    ASSERT_EQ(mb_rules_load(&bad, "sandboxes/monkey-baiting-does-not-exist"), 0);
}

TEST(fixed_point_helpers) {
    ASSERT_EQ(mb_from_int(3), 3 * 65536);
    ASSERT_EQ(mb_to_int(mb_from_int(-7)), -7);
    ASSERT_EQ(mb_mul(mb_from_int(3), MB_FP_HALF), mb_from_int(3) / 2);
    ASSERT_EQ(mb_div(mb_from_int(9), mb_from_int(3)), mb_from_int(3));
    /* the timeout comparison never divides */
    ASSERT_EQ(mb_cmp_ratio(50, 100, 50, 100), 0);
    ASSERT_EQ(mb_cmp_ratio(51, 100, 50, 100), 1);
    ASSERT_EQ(mb_cmp_ratio(1, 3, 1, 2), -1);
}

/* mulberry32 and FNV-1a must match the JS reference bit for bit, because
 * every archived result depends on the draw sequence they produce. */
TEST(rng_matches_the_js_reference) {
    uint32_t st;
    ASSERT_EQ(mb_fnv1a(""), 2166136261u);
    ASSERT_EQ(mb_fnv1a("a"), 0xE40C292Cu);
    ASSERT_EQ(mb_fnv1a("foobar"), 0xBF9CF968u);
    st = 0;
    ASSERT_EQ(mb_rng_next(&st), 1144304738u);
    ASSERT_EQ(mb_rng_next(&st), 1416247u);
    ASSERT_EQ(mb_rng_next(&st), 958946056u);
    st = 0;
    ASSERT_EQ(mb_rng_next(&st), 1144304738u);
}

/* The YAML in components/ and the C structs in mb_types.h are two
 * declarations of one schema. This is the drift guard. */
TEST(c_schema_matches_component_yaml) {
    MbYamlDoc doc;
    char path[256];
    int i, f;

    for (i = 0; i < mb_schema_count; i++) {
        const MbCompDesc *d = &mb_schema[i];
        const char *v;
        snprintf(path, sizeof(path), "%s/components/%s.yaml", SANDBOX, d->name);
        ASSERT(mb_yaml_read(path, &doc));

        v = mb_yaml_get(&doc, "name");
        ASSERT_NOT_NULL(v);
        ASSERT_STR_EQ(v, d->name);

        v = mb_yaml_get(&doc, "kind");
        ASSERT_NOT_NULL(v);
        ASSERT_STR_EQ(v, d->kind);

        for (f = 0; f < d->field_count; f++) {
            char key[192];
            snprintf(key, sizeof(key), "fields.%s.type", d->fields[f].name);
            v = mb_yaml_get(&doc, key);
            ASSERT_NOT_NULL(v);
            ASSERT_STR_EQ(v, d->fields[f].type);

            snprintf(key, sizeof(key), "fields.%s.count", d->fields[f].name);
            v = mb_yaml_get(&doc, key);
            if (d->fields[f].count > 1) {
                char want[16];
                ASSERT_NOT_NULL(v);
                snprintf(want, sizeof(want), "%d", d->fields[f].count);
                ASSERT_STR_EQ(v, want);
            } else {
                ASSERT_NULL(v);
            }
        }
    }
}

/* Every field the YAML declares must also exist in the C descriptor: the
 * guard has to catch a field ADDED to the YAML, not only a changed type. */
TEST(component_yaml_declares_no_field_the_c_schema_lacks) {
    MbYamlDoc doc;
    char path[256];
    int i, e, f;

    for (i = 0; i < mb_schema_count; i++) {
        const MbCompDesc *d = &mb_schema[i];
        int declared = 0;
        snprintf(path, sizeof(path), "%s/components/%s.yaml", SANDBOX, d->name);
        ASSERT(mb_yaml_read(path, &doc));
        for (e = 0; e < doc.n; e++) {
            const char *k = doc.e[e].key;
            if (strncmp(k, "fields.", 7) != 0) continue;
            if (!strstr(k + 7, ".type")) continue;
            declared++;
            for (f = 0; f < d->field_count; f++) {
                if (strncmp(k + 7, d->fields[f].name,
                            strlen(d->fields[f].name)) == 0 &&
                    k[7 + strlen(d->fields[f].name)] == '.')
                    break;
            }
            ASSERT(f < d->field_count);
        }
        ASSERT_EQ(declared, d->field_count);
    }
}

/* -------------------------------------------------- character data */

TEST(character_tables_carry_the_real_data) {
    const MbChar *jacco = &g_rules.chars.c[mb_rules_char_id("jacco")];
    const MbChar *brock = &g_rules.chars.c[mb_rules_char_id("brock")];
    const MbChar *aistrop = &g_rules.chars.c[mb_rules_char_id("aistrop")];

    /* 1.7 * 65536 = 111411.2 -> 111411 */
    ASSERT_EQ(jacco->walk_speed, 111411);
    ASSERT_EQ(jacco->grip_resistance, 9);
    ASSERT_EQ(jacco->hurt_w, mb_from_int(24));
    ASSERT_EQ(jacco->wall_scramble, 1);
    ASSERT_EQ(jacco->ripple_frames, 4);
    ASSERT_EQ(jacco->finisher_move, MB_MK_SPECIAL);
    ASSERT_EQ(jacco->moves[MB_MK_LIGHT].present, 1);
    ASSERT_EQ(jacco->moves[MB_MK_LIGHT].startup, 5);
    ASSERT_EQ(jacco->moves[MB_MK_LIGHT].active, 4);
    ASSERT_EQ(jacco->moves[MB_MK_LIGHT].damage, mb_from_int(5));
    ASSERT_EQ(jacco->moves[MB_MK_SPECIAL].type, MB_MT_GRAB);
    ASSERT_EQ(jacco->moves[MB_MK_SPECIAL].grab_hold_frames, 48);
    ASSERT_EQ(jacco->moves[MB_MK_SPECIAL].has_leap, 1);
    ASSERT_EQ(jacco->moves[MB_MK_STAKES_DOWN].present, 0);

    ASSERT_EQ(brock->moves[MB_MK_HEAVY].type, MB_MT_STANCE);
    ASSERT_EQ(brock->post_exchange_retreat, 22);
    ASSERT_EQ(brock->has_stance_chance, 1);

    ASSERT_EQ(aistrop->moves[MB_MK_HEAVY].type, MB_MT_CHAIN_YANK);
    ASSERT_EQ(aistrop->moves[MB_MK_HEAVY].unblockable, 1);
    ASSERT_EQ(aistrop->moves[MB_MK_STAKES_DOWN].present, 1);
    ASSERT_EQ(aistrop->moves[MB_MK_STAKES_DOWN].input_bit, MB_IN_JUMP);
    ASSERT_EQ(aistrop->has_the_cross, 1);
    ASSERT_EQ(aistrop->cross_window_frames, 480);      /* 8.0 s at 60 Hz */
    /* 0.35 -> 22938 in Q16.16, times 100 hp = 2293800, which is 35.0006 hp.
     * That deliberate 1/65536-scale difference from the JS float is the
     * fixed-point contract winning; the value is exact and reproducible. */
    ASSERT_EQ(aistrop->cross_trigger_health_abs, 2293800);
    ASSERT_EQ(aistrop->has_keep_range, 1);
    ASSERT_EQ(aistrop->has_stakes_down_health, 1);
    ASSERT_EQ(aistrop->stakes_down_health_abs, 3932200);   /* 0.6 * 100 hp */
}

/* Launch angles are resolved into Q16.16 sin/cos at load. No runtime
 * trigonometry, and the table is exact for whole degrees. */
TEST(launch_angles_are_precomputed) {
    const MbChar *jacco = &g_rules.chars.c[mb_rules_char_id("jacco")];
    const MbMove *light = &jacco->moves[MB_MK_LIGHT];
    const MbMove *heavy = &jacco->moves[MB_MK_HEAVY];

    ASSERT_EQ(light->launch_angle_deg, 20);
    ASSERT_EQ(light->launch_sin, 22415);          /* sin 20 deg */
    ASSERT_EQ(light->launch_cos, 61584);          /* cos 20 deg = sin 70 deg */
    ASSERT_EQ(heavy->launch_angle_deg, 45);
    ASSERT_EQ(heavy->launch_sin, heavy->launch_cos);
    ASSERT_EQ(heavy->launch_sin, 46341);          /* sin 45 deg */
}

/* Root CLAUDE.md decision 17: the compile-time caps are ASSERTED against the
 * loaded data, never trusted. */
TEST(data_fits_the_compile_time_caps) {
    int c, k;
    ASSERT(g_rules.chars.count > 0);
    ASSERT(g_rules.chars.count <= MB_MAX_CHARS);
    ASSERT(MB_MOVE_KEYS <= MB_MAX_MOVES);
    for (c = 0; c < g_rules.chars.count; c++) {
        const MbChar *ch = &g_rules.chars.c[c];
        ASSERT(ch->move_count > 0);
        ASSERT(ch->move_count <= MB_MAX_MOVES);
        ASSERT(ch->weight > 0);
        ASSERT(ch->max_health > 0);
        for (k = 0; k < MB_MOVE_KEYS; k++) {
            const MbMove *mv = &ch->moves[k];
            if (!mv->present) continue;
            ASSERT(mv->launch_angle_deg >= 0 && mv->launch_angle_deg <= 90);
            if (mv->type == MB_MT_HAZARD_COINS)
                ASSERT(mv->coins_zones > 0 && mv->coins_zones <= MB_HAZARD_CAP);
            if (mv->type == MB_MT_GRAB) ASSERT(mv->grab_hold_frames > 0);
        }
    }
    ASSERT(g_rules.bots.count > 0);
    ASSERT(g_rules.bots.count <= MB_MAX_BOTS);
    ASSERT(g_rules.bots.hold_frames > 0);
}

TEST(bot_tables_load_and_validate) {
    int house = mb_rules_bot_id("house");
    int novice = mb_rules_bot_id("novice");
    const MbBot *b;

    ASSERT(house >= 0);
    ASSERT(novice >= 0);
    b = &g_rules.bots.bot[house];
    ASSERT_EQ(b->count, 1);
    ASSERT_EQ(b->pure, 1);
    ASSERT_EQ(b->comp[0].kind, MB_POLICY_DEFAULT);

    b = &g_rules.bots.bot[novice];
    ASSERT_EQ(b->count, 2);
    ASSERT_EQ(b->pure, 0);
    /* the heaviest ungated entry is the fallback: random at weight 7 */
    ASSERT_EQ(b->comp[b->fallback].kind, MB_POLICY_RANDOM);
    ASSERT_EQ(b->comp[b->fallback].weight, 7);
}

/* Entrant identity is "<char_id>:<bot_id>", and the resolver refuses every
 * malformed or unsupported form loudly (root CLAUDE.md decision 12). */
TEST(entrant_identity_resolves_and_refuses) {
    int c = -1, b = -1;
    ASSERT(mb_rules_resolve_entrant(&g_rules, "jacco:house", 0, &c, &b));
    ASSERT_EQ(c, mb_rules_char_id("jacco"));
    ASSERT_EQ(b, mb_rules_bot_id("house"));

    ASSERT(mb_rules_resolve_entrant(&g_rules, "aistrop:chaos", 0, &c, &b));
    ASSERT_EQ(c, mb_rules_char_id("aistrop"));

    /* no colon, unknown character, unknown bot */
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, "jacco", 0, &c, &b), 0);
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, ":house", 0, &c, &b), 0);
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, "nobody:house", 0, &c, &b), 0);
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, "jacco:nobot", 0, &c, &b), 0);

    /* A bot that can roll `perfect` is refused while no policies are loaded,
     * and accepted once they are - a refusal, never a demotion. Whether the
     * SPECIFIC pair is present is checked by mb_world_set_queue. */
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, "jacco:perfect", 0, &c, &b), 0);
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, "jacco:champion", 0, &c, &b), 0);
    ASSERT_EQ(mb_rules_resolve_entrant(&g_rules, "jacco:gentle", 0, &c, &b), 0);
    ASSERT(mb_rules_resolve_entrant(&g_rules, "jacco:perfect", 1, &c, &b));
    ASSERT_EQ(c, mb_rules_char_id("jacco"));
    ASSERT_EQ(b, mb_rules_bot_id("perfect"));
    ASSERT(mb_rules_resolve_entrant(&g_rules, "jacco:champion", 1, &c, &b));
}

/* The accumulating division is the highest-risk item in the fixed-point
 * inventory: rounding error there compounds over thousands of frames and can
 * flip a KO. After N frames the total must be exact to the residual. */
TEST(accumulating_division_is_exact_after_n_frames) {
    MbVitals v;
    int i;
    const int32_t denom = 60;
    const mb_fp num = mb_from_int(5);        /* 5 hp per second at 60 Hz */
    int64_t taken;

    memset(&v, 0, sizeof(v));
    v.hp = mb_from_int(100);
    for (i = 0; i < 60; i++) mb_chip_apply(&v, num, denom);
    /* one second of a 5 dps drain is exactly 5 hp */
    ASSERT_EQ(v.hp, mb_from_int(95));
    ASSERT_EQ(v.chip_residual, 0);
    ASSERT_EQ(v.took_damage, 1);

    /* a denominator that does not divide the numerator evenly: after N
     * frames the total is (N * num - residual) / denom, exactly. */
    memset(&v, 0, sizeof(v));
    v.hp = mb_from_int(100);
    for (i = 0; i < 1000; i++) mb_chip_apply(&v, mb_from_int(16), 48);
    taken = (int64_t)mb_from_int(100) - v.hp;
    ASSERT(taken * 48 + v.chip_residual == (int64_t)mb_from_int(16) * 1000);
    ASSERT(v.chip_residual >= 0 && v.chip_residual < 48);
    /* a naive per-frame round would drift; the residual bounds the error to
     * under one Q16.16 unit of hp over the whole run */
    ASSERT(taken >= mb_from_int(333) && taken <= mb_from_int(334));
}

/* ----------------------------------------------------------- the world */

TEST(world_builds_and_registers_components) {
    MbWorld *w = mb_world_create(&g_rules, 4);
    MbBatch *b;
    ecs_world_t *world;
    int i;

    ASSERT_NOT_NULL(w);
    world = mb_world_ecs(w);
    b = mb_world_batch(w);
    ASSERT_NOT_NULL(world);
    ASSERT_EQ(b->count, 4);

    for (i = 0; i < mb_schema_count; i++)
        ASSERT(ecs_lookup(world, mb_schema[i].name) != 0);

    ASSERT_NOT_NULL(b->clock);
    ASSERT_NOT_NULL(b->rng);
    ASSERT_NOT_NULL(b->outcome);
    ASSERT_NOT_NULL(b->body);
    ASSERT_NOT_NULL(b->refs);

    /* fighter i belongs to slot i / 2, side i % 2 */
    for (i = 0; i < b->count * 2; i++) {
        ASSERT_EQ(b->refs[i].slot, i / 2);
        ASSERT_EQ(b->refs[i].side, i % 2);
    }
    for (i = 0; i < b->count; i++)
        ASSERT_EQ(b->clock[i].phase, MB_PHASE_EMPTY);

    mb_world_destroy(w);
}

TEST(a_started_match_steps_and_finishes) {
    MbPairing q[1];
    MbWorld *w = mb_world_create(&g_rules, 1);
    MbBatch *b;
    int64_t ticks = 0;
    const MbResult *res;
    int n = 0, i;

    ASSERT_NOT_NULL(w);
    ASSERT_EQ(build_queue(q, 1, 2, 1), 1);
    ASSERT(mb_world_set_queue(w, q, 1));

    ASSERT_EQ(mb_world_fill(w), 1);
    b = mb_world_batch(w);
    ASSERT_EQ(b->clock[0].phase, MB_PHASE_INTRO);
    ASSERT_EQ(b->clock[0].round, 1);
    ASSERT_EQ(b->vitals[MB_F(0, 0)].hp, g_rules.chars.max_health[q[0].char0]);
    ASSERT_EQ(b->fsm[MB_F(0, 1)].facing, -1);
    /* the entrant's bot survives the round reset */
    ASSERT_EQ(b->brain[MB_F(0, 0)].bot_id, q[0].bot0);

    /* the intro counts down, then the fight phase opens */
    mb_world_tick(w);
    ASSERT_EQ(b->clock[0].frame, 1);
    ASSERT_EQ(b->clock[0].phase_t, g_rules.intro_frames - 1);
    ASSERT_EQ(b->clock[0].active, 0);
    for (i = 0; i < g_rules.intro_frames; i++) mb_world_tick(w);
    ASSERT_EQ(b->clock[0].phase, MB_PHASE_FIGHT);

    ASSERT(mb_world_run(w, 0, &ticks));
    res = mb_world_results(w, &n);
    ASSERT_EQ(n, 1);
    ASSERT(res[0].rounds >= 2);
    ASSERT(res[0].rounds <= g_rules.max_rounds_per_match);
    ASSERT_EQ(res[0].capped, 0);
    ASSERT(res[0].frames > 0);
    mb_world_destroy(w);
}

/* With the real character data a match is a FIGHT: fighters damage each
 * other, so rounds end in KOs rather than only on the watch. */
TEST(real_matches_are_not_trivial) {
    MbPairing q[256];
    MbWorld *w;
    const MbResult *res;
    int n = build_queue(q, 256, 5, 4), i, count = 0;
    int ko_rounds = 0, wins0 = 0, wins1 = 0, drawn = 0, distinct = 0;
    int64_t ticks = 0;
    int32_t seen[256];

    ASSERT(n >= 40);
    w = mb_world_create(&g_rules, 16);
    ASSERT_NOT_NULL(w);
    ASSERT(mb_world_set_queue(w, q, n));
    ASSERT(mb_world_run(w, 0, &ticks));
    res = mb_world_results(w, &count);
    ASSERT_EQ(count, n);

    for (i = 0; i < count; i++) {
        int j, fresh = 1;
        /* every round that did NOT end on the watch ended in a KO */
        ko_rounds += res[i].rounds - res[i].timeouts;
        if (res[i].drawn) drawn++;
        else if (res[i].winner == 0) wins0++;
        else if (res[i].winner == 1) wins1++;
        for (j = 0; j < distinct; j++) if (seen[j] == res[i].frames) fresh = 0;
        if (fresh && distinct < 256) seen[distinct++] = res[i].frames;
    }

    ASSERT(ko_rounds > 0);            /* KOs happen */
    ASSERT(wins0 > 0);                /* both sides win across the sweep */
    ASSERT(wins1 > 0);
    ASSERT(wins0 + wins1 + drawn == count);
    ASSERT(distinct > count / 4);     /* frame counts vary, they are not fixed */
    mb_world_destroy(w);
}

TEST(results_land_in_canonical_order) {
    MbPairing q[32];
    MbWorld *w;
    const MbResult *res;
    int n = build_queue(q, 32, 4, 2), i, count = 0;
    int64_t ticks = 0;

    ASSERT(n > 0);
    w = mb_world_create(&g_rules, 3);   /* fewer slots than matches */
    ASSERT_NOT_NULL(w);
    ASSERT(mb_world_set_queue(w, q, n));
    ASSERT(mb_world_run(w, 0, &ticks));

    res = mb_world_results(w, &count);
    ASSERT_EQ(count, n);
    /* completion order is not result order */
    for (i = 0; i < n; i++) {
        ASSERT_EQ(res[i].entrant0, q[i].entrant0);
        ASSERT_EQ(res[i].entrant1, q[i].entrant1);
        ASSERT_EQ(res[i].seed_index, q[i].seed_index);
    }
    mb_world_destroy(w);
}

TEST(repeat_runs_are_byte_identical) {
    MbPairing q[32];
    int n = build_queue(q, 32, 4, 2);
    int64_t t1 = 0, t2 = 0;
    uint32_t h1, h2;

    h1 = run_queue(q, n, 8, &t1);
    h2 = run_queue(q, n, 8, &t2);
    ASSERT(h1 != 0);
    ASSERT_EQ(h1, h2);
    ASSERT(t1 == t2);
}

/* The permanent concurrency-invariance gate: the batch width is a pure
 * performance knob and cannot change the answer. */
/* ------------------------------------------- perfect-policy playback ---- */

#define FIXTURES SANDBOX "/tests/fixtures"

/* The hand-built fixture at tests/fixtures/policy-tiny is small enough that
 * every derived number can be checked by hand: 2 gap buckets, 1 back bucket,
 * no cooldown moves (so c0 == c1 == 1 and rows == 2), fq 2, stunQMax 2, one
 * modelled foe move of 2 ticks (foeStates == 5), 5 actions. */
static int load_tiny(MbPerfectSet *set, const char *dir) {
    mb_perfect_init(set);
    return mb_perfect_load_pair(set, &g_rules, dir, mb_rules_char_id("jacco"),
                                mb_rules_char_id("brock"));
}

TEST(perfect_policy_loads_and_derives_its_strides) {
    MbPerfectSet set;
    const MbPolicy *p;
    ASSERT(load_tiny(&set, FIXTURES "/policy-tiny"));
    p = MB_POLICY_AT(&set, mb_rules_char_id("jacco"), mb_rules_char_id("brock"));
    ASSERT(p->present);
    ASSERT_EQ(p->gap_step, 4);
    ASSERT_EQ(p->gap_buckets, 2);
    ASSERT_EQ(p->back_step, 4);
    ASSERT_EQ(p->back_buckets, 1);
    ASSERT_EQ(p->fq, 2);
    ASSERT_EQ(p->stun_q_max, 2);
    ASSERT_EQ(p->foe_states, 5);
    ASSERT_EQ(p->n_actions, 5);
    /* rows = gapBuckets * BB^2 * c0 * c1 = 2 * 1 * 1 * 1 */
    ASSERT_EQ(p->rows, 2);
    ASSERT_EQ(p->self_cd_count, 0);
    ASSERT_EQ(p->foe_cd_count, 0);

    /* actions resolve to move keys and to the authored hold durations */
    ASSERT_EQ(p->action[0].kind, MB_PACT_MOVE);
    ASSERT_EQ(p->action[0].move_key, MB_MK_LIGHT);
    ASSERT_EQ(p->action[0].hold, g_rules.strat.perfect_hold_move);
    ASSERT_EQ(p->action[1].kind, MB_PACT_WALK_TO);
    ASSERT_EQ(p->action[1].hold, g_rules.strat.perfect_hold_walk);
    ASSERT_EQ(p->action[4].kind, MB_PACT_BLOCK);
    ASSERT_EQ(p->action[4].hold, g_rules.strat.perfect_hold_block);
    ASSERT_EQ(p->walk_to_action, 1);

    /* the foe move list is re-indexed from meta order onto move KEYS */
    ASSERT_EQ(p->foe_mi[MB_MK_LIGHT], 0);
    ASSERT_EQ(p->foe_offset[MB_MK_LIGHT], 0);
    ASSERT_EQ(p->foe_qf[MB_MK_LIGHT], 2);
    ASSERT_EQ(p->foe_mi[MB_MK_HEAVY], -1);      /* unmodelled: reads as free */

    mb_perfect_free(&set);
}

/* bothFree becomes a u32 cumulative distribution normalised per row. The
 * boundaries below are exact: 0.25 * 2^32 = 1073741824, and the cumulative
 * bound of 2^32 saturates rather than wrapping to 0. */
TEST(perfect_cdf_is_exact_and_saturates) {
    MbPerfectSet set;
    const MbPolicy *p;
    const uint32_t *r0, *r1;
    ASSERT(load_tiny(&set, FIXTURES "/policy-tiny"));
    p = MB_POLICY_AT(&set, mb_rules_char_id("jacco"), mb_rules_char_id("brock"));

    r0 = p->cdf;                    /* [0.25, 0.25, 0.25, 0.25, 0] */
    ASSERT_EQ(r0[0], 1073741824u);
    ASSERT_EQ(r0[1], 2147483648u);
    ASSERT_EQ(r0[2], 3221225472u);
    /* the cumulative bound reaches 2^32 at the LAST action with probability,
     * not at the last action: it must saturate, never wrap to 0 */
    ASSERT_EQ(r0[3], 0xFFFFFFFFu);
    ASSERT_EQ(r0[4], 0xFFFFFFFFu);

    r1 = p->cdf + p->n_actions;     /* [0, 0.5, 0, 0.5, 0] */
    ASSERT_EQ(r1[0], 0u);           /* zero probability is never selectable */
    ASSERT_EQ(r1[1], 2147483648u);
    ASSERT_EQ(r1[2], 2147483648u);
    ASSERT_EQ(r1[3], 0xFFFFFFFFu);

    /* vsCommitted keeps the solver's action indices, row-major over
     * (row, foe_state - 1) with stride foeStates - 1 */
    ASSERT_EQ(p->vs_committed[0], 0);
    ASSERT_EQ(p->vs_committed[3], 3);
    ASSERT_EQ(p->vs_committed[4], 4);
    ASSERT_EQ(p->vs_committed[7], 1);

    mb_perfect_free(&set);
}

/* Selection walks the CDF against one raw mulberry32 word. Determinism here
 * means: the same word always yields the same action, and the boundaries sit
 * exactly where the cumulative bounds say. */
TEST(perfect_cdf_selection_is_deterministic) {
    MbPerfectSet set;
    const MbPolicy *p;
    const uint32_t *row;
    int a, k;
    static const uint32_t probe[6] = {
        0u, 1073741823u, 1073741824u, 3221225471u, 3221225472u, 0xFFFFFFFFu
    };
    static const int want[6] = { 0, 0, 1, 2, 3, 4 };

    ASSERT(load_tiny(&set, FIXTURES "/policy-tiny"));
    p = MB_POLICY_AT(&set, mb_rules_char_id("jacco"), mb_rules_char_id("brock"));
    row = p->cdf;
    for (k = 0; k < 6; k++) {
        for (a = 0; a < p->n_actions; a++)
            if (probe[k] < row[a]) break;
        if (a >= p->n_actions) a = p->n_actions - 1;
        ASSERT_EQ(a, want[k]);
    }
    /* the top word is the rounding residue the final bucket absorbs */
    ASSERT_EQ(want[5], p->n_actions - 1);
    mb_perfect_free(&set);
}

/* Every refusal path. A stale encoding, a truncated array, a missing file and
 * a missing directory all fail the load loudly - never a partial read, never
 * a demotion to another strategy. */
TEST(perfect_policy_refuses_missing_and_stale_files) {
    MbPerfectSet set;
    int jacco = mb_rules_char_id("jacco"), brock = mb_rules_char_id("brock");

    printf("\n    [four refusals expected below]\n");

    /* encoding 2 is a dead layout; reading it with encoding-3 index math
     * would silently return garbage actions */
    mb_perfect_init(&set);
    ASSERT_EQ(mb_perfect_load_pair(&set, &g_rules, FIXTURES "/policy-stale",
                                   jacco, brock), 0);
    ASSERT_EQ(mb_perfect_has_pair(&set, jacco, brock), 0);
    mb_perfect_free(&set);

    /* bothFree shorter than the meta strides require */
    mb_perfect_init(&set);
    ASSERT_EQ(mb_perfect_load_pair(&set, &g_rules, FIXTURES "/policy-short",
                                   jacco, brock), 0);
    mb_perfect_free(&set);

    /* the directory exists but this pair was never solved */
    mb_perfect_init(&set);
    ASSERT_EQ(mb_perfect_load_pair(&set, &g_rules, FIXTURES "/policy-tiny",
                                   brock, jacco), 0);
    mb_perfect_free(&set);

    /* no policy directory at all */
    mb_perfect_init(&set);
    ASSERT_EQ(mb_perfect_load_pair(&set, &g_rules, FIXTURES "/policy-nowhere",
                                   jacco, brock), 0);
    mb_perfect_free(&set);
}

/* A queue whose entrant can roll `perfect` without that ORDERED pair loaded
 * is refused at install, which is what makes the runtime lookup total. */
TEST(perfect_queue_refuses_an_unbacked_pairing) {
    MbPerfectSet set;
    MbWorld *w;
    MbPairing q;
    int jacco = mb_rules_char_id("jacco"), brock = mb_rules_char_id("brock");

    ASSERT(load_tiny(&set, FIXTURES "/policy-tiny"));
    w = mb_world_create(&g_rules, 4);
    ASSERT(w != NULL);
    mb_world_set_perfect(w, &set);

    memset(&q, 0, sizeof(q));
    q.char0 = jacco; q.char1 = brock;
    q.bot0 = mb_rules_bot_id("perfect");
    q.bot1 = mb_rules_bot_id("house");
    q.seed_index = 1;
    q.seed = mb_seed_for("jacco:perfect", "brock:house", 1);
    ASSERT(mb_world_set_queue(w, &q, 1));

    printf("\n    [one refusal expected below]\n");
    /* the mirror orientation needs perfect-brock-vs-jacco, which is absent */
    q.char0 = brock; q.char1 = jacco;
    q.bot0 = mb_rules_bot_id("perfect");
    q.bot1 = mb_rules_bot_id("house");
    ASSERT_EQ(mb_world_set_queue(w, &q, 1), 0);

    mb_world_destroy(w);
    mb_perfect_free(&set);
}

/* The bucketing contract, asserted directly against hand-placed fighters.
 * These quantized values INDEX the policy table, so a one-unit difference
 * selects a different action - they are checked here rather than only being
 * observed through a whole match. */
TEST(perfect_bucketing_is_exact) {
    MbPerfectSet set;
    const MbPolicy *p;
    MbBatch b;
    MbBody body[2];
    MbRefs refs[2];
    MbFsm fsm[2];
    MbMoveSlot slot[2];
    MbCooldowns cd[2];
    mb_fp hw0, hw1;

    ASSERT(load_tiny(&set, FIXTURES "/policy-tiny"));
    p = MB_POLICY_AT(&set, mb_rules_char_id("jacco"), mb_rules_char_id("brock"));

    memset(&b, 0, sizeof(b));
    memset(body, 0, sizeof(body));
    memset(refs, 0, sizeof(refs));
    memset(fsm, 0, sizeof(fsm));
    memset(slot, 0, sizeof(slot));
    memset(cd, 0, sizeof(cd));
    b.count = 1;
    b.rules = &g_rules;
    b.perfect = &set;
    b.body = body; b.refs = refs; b.fsm = fsm; b.move_slot = slot; b.cd = cd;
    refs[0].char_id = mb_rules_char_id("jacco");
    refs[1].char_id = mb_rules_char_id("brock");
    hw0 = g_rules.chars.c[refs[0].char_id].hurt_w;
    hw1 = g_rules.chars.c[refs[1].char_id].hurt_w;

    /* gq = clamp(floor((gap2 + gapStep*2^16) / (gapStep*2^17)), 0, 1), with
     * gap2 = 2*|dx| - (w0 + w1). Fully overlapped: gap2 < 0, so bucket 0. */
    body[0].x = mb_from_int(100);
    body[1].x = mb_from_int(100);
    ASSERT_EQ(mb_perfect_gap_bucket(&b, 0, 0, p), 0);

    /* a gap of exactly gapStep/2 = 2px is the round-half-up boundary: it is
     * the first gap that lands in bucket 1 */
    body[1].x = body[0].x + (hw0 + hw1) / 2 + mb_from_int(2);
    ASSERT_EQ(mb_perfect_gap_bucket(&b, 0, 0, p), 1);
    body[1].x -= 1;                              /* one Q16.16 unit under */
    ASSERT_EQ(mb_perfect_gap_bucket(&b, 0, 0, p), 0);

    /* far apart clamps to the top bucket, from either side */
    body[1].x = mb_from_int(300);
    ASSERT_EQ(mb_perfect_gap_bucket(&b, 0, 0, p), 1);
    ASSERT_EQ(mb_perfect_gap_bucket(&b, 0, 1, p), 1);

    /* backBuckets is 1 here, so every retreat room saturates into bucket 0
     * and the packed rq is 0 - row is then the gap bucket alone */
    ASSERT_EQ(mb_perfect_back_bucket(&b, 0, 1, p), 0);
    ASSERT_EQ(mb_perfect_row(&b, 0, 0, p), 1);
    body[1].x = body[0].x;
    ASSERT_EQ(mb_perfect_row(&b, 0, 0, p), 0);

    /* side state: free / stun quantized by fq / committed move ticks */
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 0);
    fsm[1].state = MB_ST_STUN;
    fsm[1].stun_t = 1;
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 1);   /* ceil(1/2)-1 = 0 */
    fsm[1].stun_t = 3;
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 2);   /* ceil(3/2)-1 = 1 */
    fsm[1].stun_t = 99;                              /* clamps at stunQMax */
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 2);

    fsm[1].state = MB_ST_ATTACK;
    slot[1].move_key = MB_MK_LIGHT;
    fsm[1].t = 0;
    /* 1 + stunQMax + offset + floor(t/fq) */
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 3);
    fsm[1].t = 2;
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 4);
    fsm[1].t = 200;                                  /* clamps at QF - 1 */
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 4);
    /* a move the policy does not model reads as FREE, as the solver assumes */
    slot[1].move_key = MB_MK_HEAVY;
    ASSERT_EQ(mb_perfect_side_state(&b, 1, p), 0);
    /* every committed state stays inside the vsCommitted stride */
    ASSERT(mb_perfect_side_state(&b, 1, p) < p->foe_states);

    mb_perfect_free(&set);
}

/* The batch width stays a pure performance knob with a perfect entrant in
 * the roster: the policy tables are shared read-only, and the one draw per
 * decision comes from the match's own generator. */
TEST(perfect_entrant_is_batch_width_invariant) {
    MbPerfectSet set;
    MbPairing q[2];
    MbWorld *w;
    uint32_t h[4];
    static const int widths[4] = { 1, 2, 4, 16 };
    int64_t t = 0;
    int jacco = mb_rules_char_id("jacco"), brock = mb_rules_char_id("brock");
    int k;

    mb_perfect_init(&set);
    /* the real solved policies, both orientations of the pair */
    if (!mb_perfect_load_pair(&set, &g_rules, PERFECT_DIR, jacco, brock) ||
        !mb_perfect_load_pair(&set, &g_rules, PERFECT_DIR, brock, jacco)) {
        printf("\n    [no solved policies at %s - skipped] ", PERFECT_DIR);
        mb_perfect_free(&set);
        return;
    }

    memset(q, 0, sizeof(q));
    q[0].char0 = jacco; q[0].char1 = brock;
    q[0].bot0 = mb_rules_bot_id("perfect");
    q[0].bot1 = mb_rules_bot_id("house");
    q[0].seed_index = 1;
    q[0].seed = mb_seed_for("jacco:perfect", "brock:house", 1);
    /* the mirror orientation, so both sides run a perfect entrant */
    q[1].char0 = brock; q[1].char1 = jacco;
    q[1].bot0 = mb_rules_bot_id("house");
    q[1].bot1 = mb_rules_bot_id("perfect");
    q[1].seed_index = 2;
    q[1].seed = mb_seed_for("brock:house", "jacco:perfect", 2);

    for (k = 0; k < 4; k++) {
        w = mb_world_create(&g_rules, widths[k]);
        ASSERT(w != NULL);
        mb_world_set_perfect(w, &set);
        ASSERT(mb_world_set_queue(w, q, 2));
        ASSERT(mb_world_run(w, 0, &t));
        h[k] = mb_world_result_hash(w);
        mb_world_destroy(w);
    }
    ASSERT(h[0] != 0);
    ASSERT_EQ(h[0], h[1]);
    ASSERT_EQ(h[0], h[2]);
    ASSERT_EQ(h[0], h[3]);
    mb_perfect_free(&set);
}

TEST(batch_width_does_not_change_results) {
    MbPairing q[64];
    int n = build_queue(q, 64, 5, 2);
    int64_t t = 0;
    uint32_t h1 = run_queue(q, n, 1, &t);
    uint32_t h4 = run_queue(q, n, 4, &t);
    uint32_t h16 = run_queue(q, n, 16, &t);
    uint32_t h64 = run_queue(q, n, 64, &t);

    ASSERT(h1 != 0);
    ASSERT_EQ(h1, h4);
    ASSERT_EQ(h1, h16);
    ASSERT_EQ(h1, h64);
}

/* ------------------------------------------- stage 4: multi-world threads */

/* Runs the whole queue through the pool and hashes the merged canonical
 * result table. Thread count and partition are the only things that vary. */
static uint32_t run_pool(const MbPairing *q, int n, int threads, int batch,
                         MbPartition part, MbPoolStats *st) {
    MbPoolConfig cfg;
    MbPoolStats stats;
    MbResult *res = (MbResult *)calloc((size_t)n, sizeof(MbResult));
    uint32_t h;
    if (!res) return 0;
    memset(&cfg, 0, sizeof(cfg));
    cfg.threads = threads;
    cfg.batch = batch;
    cfg.partition = part;
    cfg.max_ticks = 0;
    memset(&stats, 0, sizeof(stats));
    if (!mb_pool_run(&g_rules, NULL, q, n, &cfg, res, &stats)) {
        free(res);
        return 0;
    }
    h = mb_result_hash(res, n);
    free(res);
    if (st) *st = stats;
    return stats.finished ? h : 0;
}

TEST(thread_count_does_not_change_results) {
    MbPairing q[64];
    int n = build_queue(q, 64, 5, 2);
    MbPoolStats s1, s4, s8;
    uint32_t h1 = run_pool(q, n, 1, 8, MB_PARTITION_ROUND_ROBIN, &s1);
    uint32_t h4 = run_pool(q, n, 4, 8, MB_PARTITION_ROUND_ROBIN, &s4);
    uint32_t h8 = run_pool(q, n, 8, 8, MB_PARTITION_ROUND_ROBIN, &s8);

    ASSERT(h1 != 0);
    ASSERT_EQ(h1, h4);
    ASSERT_EQ(h1, h8);
    ASSERT_EQ(s1.matches, n);
    ASSERT_EQ(s4.worlds, 4);
    ASSERT_EQ(s8.worlds, 8);
    /* the total frame work is invariant; only its distribution changes */
    ASSERT(s4.ticks <= s1.ticks);
}

/* --threads 1 must be EXACTLY the pre-S4 single-world path: same results,
 * same tick count, no thread created. */
TEST(one_thread_is_the_old_single_world_path) {
    MbPairing q[64];
    int n = build_queue(q, 64, 5, 2);
    int64_t t_old = 0;
    uint32_t h_old = run_queue(q, n, 8, &t_old);
    MbPoolStats s;
    uint32_t h_pool = run_pool(q, n, 1, 8, MB_PARTITION_ROUND_ROBIN, &s);

    ASSERT(h_old != 0);
    ASSERT_EQ(h_old, h_pool);
    ASSERT(t_old == s.ticks);
    ASSERT_EQ(s.worlds, 1);
}

TEST(partition_does_not_change_results) {
    MbPairing q[64];
    int n = build_queue(q, 64, 5, 2);
    uint32_t rr = run_pool(q, n, 6, 8, MB_PARTITION_ROUND_ROBIN, NULL);
    uint32_t bl = run_pool(q, n, 6, 8, MB_PARTITION_BLOCK, NULL);
    /* and a thread count that does not divide the queue evenly */
    uint32_t rr7 = run_pool(q, n, 7, 3, MB_PARTITION_ROUND_ROBIN, NULL);
    uint32_t bl7 = run_pool(q, n, 7, 3, MB_PARTITION_BLOCK, NULL);

    ASSERT(rr != 0);
    ASSERT_EQ(rr, bl);
    ASSERT_EQ(rr, rr7);
    ASSERT_EQ(rr, bl7);
}

/* Threads and batch width are independent knobs and neither is allowed to
 * touch the answer, including in combination. */
TEST(threads_and_batch_width_are_independent) {
    MbPairing q[64];
    int n = build_queue(q, 64, 5, 2);
    uint32_t base = run_pool(q, n, 1, 1, MB_PARTITION_ROUND_ROBIN, NULL);
    ASSERT(base != 0);
    ASSERT_EQ(base, run_pool(q, n, 3, 1, MB_PARTITION_ROUND_ROBIN, NULL));
    ASSERT_EQ(base, run_pool(q, n, 3, 64, MB_PARTITION_ROUND_ROBIN, NULL));
    ASSERT_EQ(base, run_pool(q, n, 8, 16, MB_PARTITION_BLOCK, NULL));
}

/* ------------------------------------------------------- determinism soak */

/* The binary itself, not the library: byte-identical stdout for the same
 * command line, three times over. Skips when the executable is not where a
 * standard build puts it (ctest runs from the project root). */
static const char *find_mb_sim(void) {
    static const char *candidates[] = {
        "build/local/Debug/mb_sim.exe",
        "build/local/Release/mb_sim.exe",
        "build/local/mb_sim",
        "build/local/mb_sim.exe",
        NULL
    };
    static char path[260];
    int i;
    for (i = 0; candidates[i]; i++) {
        FILE *f = fopen(candidates[i], "rb");
        if (f) {
            fclose(f);
            snprintf(path, sizeof(path), "%s", candidates[i]);
#ifdef _WIN32
            /* cmd.exe does not accept a quoted forward-slash program path */
            {
                char *p;
                for (p = path; *p; p++) if (*p == '/') *p = '\\';
            }
#endif
            return path;
        }
    }
    return NULL;
}

static int capture(const char *cmd, char *out, size_t cap) {
    FILE *p;
    size_t n;
#ifdef _WIN32
    p = _popen(cmd, "r");
#else
    p = popen(cmd, "r");
#endif
    if (!p) return 0;
    n = fread(out, 1, cap - 1, p);
    out[n] = 0;
#ifdef _WIN32
    _pclose(p);
#else
    pclose(p);
#endif
    return (int)n;
}

TEST(the_binary_is_byte_identical_across_repeat_runs) {
    const char *exe = find_mb_sim();
    static char a[65536], b[65536], c[65536];
    char cmd[512];

    if (!exe) {
        printf("    (SKIP: mb_sim not built where the test looks)\n");
        return;
    }
    snprintf(cmd, sizeof(cmd),
             "\"%s\" --entrants 4 --seeds 2 --threads 4 --batch 8 2>&1", exe);
    ASSERT(capture(cmd, a, sizeof(a)) > 0);
    ASSERT(capture(cmd, b, sizeof(b)) > 0);
    ASSERT(capture(cmd, c, sizeof(c)) > 0);
    ASSERT_STR_EQ(a, b);
    ASSERT_STR_EQ(a, c);
    ASSERT(strstr(a, "hash=") != NULL);
}

/* The same gate at the CLI: the hash= token cannot move with --threads. */
TEST(the_binary_hash_is_thread_count_invariant) {
    const char *exe = find_mb_sim();
    static char buf[65536];
    char cmd[512], hashes[3][32];
    const int tc[3] = { 1, 4, 8 };
    int i;

    if (!exe) {
        printf("    (SKIP: mb_sim not built where the test looks)\n");
        return;
    }
    for (i = 0; i < 3; i++) {
        const char *h;
        snprintf(cmd, sizeof(cmd),
                 "\"%s\" --entrants 4 --seeds 2 --threads %d --quiet 2>&1",
                 exe, tc[i]);
        ASSERT(capture(cmd, buf, sizeof(buf)) > 0);
        h = strstr(buf, "hash=");
        ASSERT_NOT_NULL((void *)h);
        snprintf(hashes[i], sizeof(hashes[i]), "%s", h);
    }
    ASSERT_STR_EQ(hashes[0], hashes[1]);
    ASSERT_STR_EQ(hashes[0], hashes[2]);
}

int main(void) {
    TEST_SUITE("monkey-baiting simulator (stage 2)");

    g_rules_ok = mb_rules_load(&g_rules, SANDBOX);
    if (!g_rules_ok) {
        printf("  rules failed to load - run from the project root\n");
        return 1;
    }

    RUN(rules_load_from_yaml);
    RUN(the_js_literals_are_now_authored_data);
    RUN(rules_load_refuses_a_missing_file);
    RUN(fixed_point_helpers);
    RUN(rng_matches_the_js_reference);
    RUN(c_schema_matches_component_yaml);
    RUN(component_yaml_declares_no_field_the_c_schema_lacks);
    RUN(character_tables_carry_the_real_data);
    RUN(launch_angles_are_precomputed);
    RUN(data_fits_the_compile_time_caps);
    RUN(bot_tables_load_and_validate);
    RUN(entrant_identity_resolves_and_refuses);
    RUN(accumulating_division_is_exact_after_n_frames);
    RUN(world_builds_and_registers_components);
    RUN(a_started_match_steps_and_finishes);
    RUN(real_matches_are_not_trivial);
    RUN(results_land_in_canonical_order);
    RUN(repeat_runs_are_byte_identical);
    RUN(batch_width_does_not_change_results);
    RUN(perfect_policy_loads_and_derives_its_strides);
    RUN(perfect_cdf_is_exact_and_saturates);
    RUN(perfect_cdf_selection_is_deterministic);
    RUN(perfect_policy_refuses_missing_and_stale_files);
    RUN(perfect_queue_refuses_an_unbacked_pairing);
    RUN(perfect_bucketing_is_exact);
    RUN(perfect_entrant_is_batch_width_invariant);
    RUN(thread_count_does_not_change_results);
    RUN(one_thread_is_the_old_single_world_path);
    RUN(partition_does_not_change_results);
    RUN(threads_and_batch_width_are_independent);
    RUN(the_binary_is_byte_identical_across_repeat_runs);
    RUN(the_binary_hash_is_thread_count_invariant);

    TEST_RESULTS();
}
ï»¿/* MONKEY BAITING - the WASM export surface, tested NATIVELY (stage S7).
 *
 * clients/wasm/wasm_main.c is compiled into this binary with no Emscripten in
 * sight, so the surface the browser calls is checked by ctest on any box. The
 * point is not that the exports return "something": it is that
 *
 *   1. the exports are the SAME game - a match played entirely through
 *      wasm_start_match / wasm_tick produces the result row mb_world_run
 *      produces for that pairing and seed (the determinism spot-check, and
 *      the C half of the S7 cross-target gate, architecture spec 6.2);
 *   2. the human seam actually overrides the bot and is inert when unclaimed,
 *      which is what lets the same eleven systems serve both a tournament and
 *      a player;
 *   3. every accessor is total - callable before init, after free, and with
 *      an out-of-range index, without crashing and without inventing state.
 *
 * The shell may not compute gameplay, so every number it draws has to be
 * available here. A test that a needed field is MISSING is a test that the
 * shell would have had to compute it. */
#include "test.h"

#include "mb_engine.h"
#include "mb_rules.h"
#include "mb_step.h"
#include "mb_types.h"
#include "mb_world.h"

#include <stdio.h>
#include <string.h>

/* The export surface under test. Declared here rather than in a header
 * because the exports are an ABI for JavaScript, not a C API anything else
 * links: if a signature drifts, this file must be updated deliberately. */
int  wasm_init(void);
int  wasm_start_match(const char *c0, const char *b0,
                      const char *c1, const char *b1, int seed_index);
int  wasm_tick(void);
void wasm_free(void);

void wasm_set_human(int side_mask);
int  wasm_get_human(void);
void wasm_set_input(int side, int bits);
int  wasm_in_left(void);
int  wasm_in_right(void);
int  wasm_in_block(void);
int  wasm_in_light(void);

int wasm_fp_one(void);
int wasm_ring_left(void);
int wasm_ring_right(void);
int wasm_ring_center(void);
