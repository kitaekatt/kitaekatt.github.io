óBó(ô,6ô*ð␀÷'2ð␀'2ó␀ð'2óTð0␀÷$ð␀$ó␀ð$ó0ó$!ô0Cóf1ó1Gðr␀DHð0Ø!ð0Ø+@ð0à$ó0ófKð
␀÷ð␀ó␀ðô<óJ!ôHFðR␀ˆzÒØ€C‡HH‰T‹VÕð␀r␀␀␀#!/usr/bin/env python3
"""mb_driver - the Python driver for the monkey-baiting tournament simulator.

Architecture stage S1 (web/monkey-baiting/docs/specs/
tournament-simulator-architecture.md): the thing that invokes mb_sim with a
pinned, explicit configuration, parses its canonical result rows, and writes a
run record. It is a DRIVER, not a scorer - it counts wins, losses, draws,
timeouts and finishers and stops there. Scoring, grammar and search are S5,
which imports this module as a library.

Three seams, deliberately separate so S5 can use them independently:

    build_argv()     invocation builder  - the pinned command line
    run_sim()        invoke + parse      - one SimOutput, or a typed failure
    build_record()   record writer       - the archived JSON run record

Library use (S5):

    from mb_driver import RunConfig, run_tournament
    run = run_tournament(RunConfig(roster=["jacco:house", "brock:chaos"],
                                   seeds=4))
    run.record["oracle"]["hash"]     # the determinism oracle
    run.record["aggregate"]          # counts only, no scoring semantics

CLI use:

    python3 sandboxes/monkey-baiting/tools/mb_driver.py \\
        --roster "jacco:house,brock:chaos" --seeds 4 --out run.json

Run it from the project root: mb_sim resolves ./sandboxes/ relative to cwd.

THE ORACLE is the result rows plus hash= ONLY. `ticks` is recorded but is
explicitly not part of it: it is the longest world's critical path and moves
with --threads and --partition by design (sandboxes/monkey-baiting/CLAUDE.md,
"Threading"). --verify compares rows and hash, never ticks.

NO SILENT FALLBACKS (root CLAUDE.md decision 12). A missing binary, a refusal
(exit 2), a crash, a sim_version disagreement, or a result table that does not
match the canonical queue this driver expected is an error with a message, not
a degraded run.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

RECORD_SCHEMA = "mb-run-record/1"

# Thread policy (binding contract from the S4 build, recorded in
# sandboxes/monkey-baiting/CLAUDE.md "Threading"): pass --threads EXPLICITLY,
# always - the binary's own default is machine-dependent and must never be the
# thing that decides a run's configuration. min(cores, 20) is the measured
# winner at 2520 matches; below ~1500 matches there are too few matches per
# world for that to pay and 8 wins.
THREADS_CAP = 20
SMALL_QUEUE_MATCHES = 1500
SMALL_QUEUE_THREADS = 8
DEFAULT_BATCH = 1
DEFAULT_PARTITION = "round-robin"

DEFAULT_SANDBOX = Path("sandboxes/monkey-baiting")
BINARY_CANDIDATES = (
    Path("build/local/Release/mb_sim.exe"),
    Path("build/local/Debug/mb_sim.exe"),
    Path("build/local/mb_sim"),
    Path("build/local/mb_sim.exe"),
)
BUILD_HINT = (
    "build it first:  cmake --build build/local --config Release "
    "--target mb_sim   (see CLAUDE.md 'Build & Test')"
)


# --------------------------------------------------------------------------
# failures - each one distinct, none of them silent
# --------------------------------------------------------------------------

class DriverError(Exception):
    """Base for every failure this driver surfaces."""


class BinaryMissing(DriverError):
    """mb_sim is not where a standard build puts it."""


class SimRefusal(DriverError):
    """mb_sim exited 2: a deliberate hard stop, not a crash.

    A malformed or unknown entrant id, a perfect-capable bot with no policy
    set, a queue needing an unbacked ordered pair, a bad flag. `reason` is the
    stderr line that caused it.
    """

    def __init__(self, reason: str, stderr: str, argv: list[str]) -> None:
        super().__init__(f"mb_sim refused (exit 2): {reason}")
        self.reason = reason
        self.stderr = stderr
        self.argv = argv


class SimCrash(DriverError):
    """mb_sim exited nonzero for anything other than a refusal."""

    def __init__(self, code: int, stderr: str, argv: list[str]) -> None:
        super().__init__(f"mb_sim failed (exit {code}): {stderr.strip()}")
        self.code = code
        self.stderr = stderr
        self.argv = argv


class SimOutputError(DriverError):
    """mb_sim succeeded but its output is not what this driver expects."""


class VerifyMismatch(DriverError):
    """Two identical invocations produced different rows or hash."""


# --------------------------------------------------------------------------
# roster loading - a plain id list, or a small YAML
# --------------------------------------------------------------------------

def _yaml_module() -> Any | None:
    try:
        import yaml  # type: ignore
    except ImportError:
        return None
    return yaml


def parse_roster_text(text: str, source: str) -> tuple[list[str], dict[str, Any]]:
    """Parses a roster document. Returns (entrant ids, extra settings).

    Two accepted shapes:

        - jacco:house            a plain list of entrant ids (always supported)
        - brock:chaos

        roster:                  a mapping, which may also carry seeds/perfect
          - jacco:house
        seeds: 4

    The mapping form needs PyYAML. STDLIB ONLY is the rule here, so when PyYAML
    is not importable the mapping form is REFUSED with that reason rather than
    half-parsed - the plain list stays available and is enough for S1.
    """
    yaml = _yaml_module()
    if yaml is not None:
        doc = yaml.safe_load(text)
        return _roster_from_doc(doc, source)

    entrants: list[str] = []
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if not line.startswith("- "):
            raise DriverError(
                f"{source}:{lineno}: PyYAML is not importable, so only the "
                f"plain-list roster form ('- <char>:<bot>' per line) is "
                f"accepted; got {line!r}"
            )
        entrants.append(line[2:].strip())
    if not entrants:
        raise DriverError(f"{source}: no entrants")
    return entrants, {}


def _roster_from_doc(doc: Any, source: str) -> tuple[list[str], dict[str, Any]]:
    settings: dict[str, Any] = {}
    if isinstance(doc, list):
        raw = doc
    elif isinstance(doc, dict):
        if "roster" not in doc:
            raise DriverError(f"{source}: mapping form needs a 'roster:' key")
        raw = doc["roster"]
        for key in ("seeds", "perfect", "sandbox", "batch", "partition"):
            if key in doc:
                settings[key] = doc[key]
        unknown = set(doc) - {"roster", "seeds", "perfect", "sandbox",
                              "batch", "partition"}
        if unknown:
            raise DriverError(
                f"{source}: unknown keys {sorted(unknown)}")
    else:
        raise DriverError(f"{source}: expected a list or a mapping")
    if not isinstance(raw, list) or not raw:
        raise DriverError(f"{source}: roster must be a non-empty list")
    entrants = [str(e).strip() for e in raw]
    return entrants, settings


def load_roster(spec: str) -> tuple[list[str], dict[str, Any]]:
    """Accepts a comma-separated id list or a path to a roster file."""
    path = Path(spec)
    if path.suffix in (".yaml", ".yml", ".txt") or path.exists():
        if not path.exists():
            raise DriverError(f"roster file not found: {path}")
        return parse_roster_text(path.read_text(encoding="ascii"), str(path))
    entrants = [tok.strip() for tok in spec.split(",") if tok.strip()]
    if not entrants:
        raise DriverError("empty roster")
    return entrants, {}


def validate_roster(entrants: list[str]) -> None:
    """Shape check only. The authority on what resolves is mb_sim itself
    (mb_rules_resolve_entrant), which refuses loudly - this just catches a
    typo before spending a process."""
    if len(entrants) < 2:
        raise DriverError(
            f"the field needs at least 2 entrants (got {len(entrants)})")
    if len(set(entrants)) != len(entrants):
        dupes = sorted({e for e in entrants if entrants.count(e) > 1})
        raise DriverError(f"duplicate entrants in the roster: {dupes}")
    for e in entrants:
        if e.count(":") != 1 or not all(e.split(":")):
            raise DriverError(
                f"entrant id must be '<char>:<bot>' (got {e!r})")


# --------------------------------------------------------------------------
# the canonical match queue - this driver's own expectation
# --------------------------------------------------------------------------

def canonical_queue(entrants: list[str], seeds: int) -> list[tuple[str, str, int]]:
    """The (entrant0, entrant1, seed_index) tuples mb_sim must produce, in
    order. Mirrors main.c's enumeration exactly: every unordered pair i<j, and
    for each, seed indices 1..seeds with the sides swapping on even seeds.
    Computed independently so a queue-construction change in C shows up as a
    mismatch here instead of silently re-keying a corpus."""
    if seeds < 1:
        raise DriverError(f"--seeds must be >= 1 (got {seeds})")
    out: list[tuple[str, str, int]] = []
    n = len(entrants)
    for i in range(n):
        for j in range(i + 1, n):
            for s in range(1, seeds + 1):
                a, b = (i, j) if s % 2 == 1 else (j, i)
                out.append((entrants[a], entrants[b], s))
    return out


# --------------------------------------------------------------------------
# configuration and the invocation builder
# --------------------------------------------------------------------------

def resolve_threads(queue_len: int, override: int | None = None) -> dict[str, Any]:
    """The auto thread policy, recorded rather than assumed. Always yields an
    explicit number - the binary's machine-dependent default is never used."""
    cores = os.cpu_count() or 1
    if override is not None:
        if override < 1:
            raise DriverError(f"--threads must be >= 1 (got {override})")
        return {"mode": "override", "cores": cores, "chosen": override,
                "queue_matches": queue_len,
                "rule": "explicit --threads overrides the auto policy"}
    if queue_len < SMALL_QUEUE_MATCHES:
        chosen = min(SMALL_QUEUE_THREADS, cores)
        rule = (f"queue < {SMALL_QUEUE_MATCHES} matches -> "
                f"min({SMALL_QUEUE_THREADS}, cores)")
    else:
        chosen = min(THREADS_CAP, cores)
        rule = f"min(cores, {THREADS_CAP})"
    return {"mode": "auto", "cores": cores, "chosen": chosen,
            "queue_matches": queue_len, "rule": rule}


def find_binary(explicit: Path | None = None) -> Path:
    if explicit is not None:
        if not explicit.exists():
            raise BinaryMissing(f"mb_sim not found at {explicit}; {BUILD_HINT}")
        return explicit
    for cand in BINARY_CANDIDATES:
        if cand.exists():
            return cand
    raise BinaryMissing(
        "mb_sim not found in "
        + ", ".join(str(c) for c in BINARY_CANDIDATES)
        + "; " + BUILD_HINT)


@dataclass
class RunConfig:
    """Everything that decides what mb_sim does. Every field ends up in the
    run record, because a parameter that could ever affect results must be
    archived with the results (architecture spec section 7.6 item 5)."""

    roster: list[str]
    seeds: int = 4
    sandbox: Path = DEFAULT_SANDBOX
    perfect: Path | None = None
    threads: int | None = None          # None = the auto policy
    batch: int = DEFAULT_BATCH
    partition: str = DEFAULT_PARTITION
    max_ticks: int = 0                  # 0 = no cap
    binary: Path | None = None
    roster_source: str = "inline"
    label: str = ""
    _thread_policy: dict[str, Any] = field(default_factory=dict, repr=False)

    def __post_init__(self) -> None:
        self.roster = [str(e) for e in self.roster]
        validate_roster(self.roster)
        self.sandbox = Path(self.sandbox)
        if self.perfect is not None:
            self.perfect = Path(self.perfect)
        if self.batch < 1:
            raise DriverError(f"--batch must be >= 1 (got {self.batch})")
        if self.partition not in ("round-robin", "block"):
            raise DriverError(
                f"--partition takes round-robin or block (got "
                f"{self.partition!r})")
        self.queue = canonical_queue(self.roster, self.seeds)
        self._thread_policy = resolve_threads(len(self.queue), self.threads)

    @property
    def thread_policy(self) -> dict[str, Any]:
        return dict(self._thread_policy)

    @property
    def resolved_threads(self) -> int:
        return int(self._thread_policy["chosen"])


def build_argv(cfg: RunConfig, binary: Path) -> list[str]:
    """The pinned command line. Everything explicit: no flag that could move
    a number is left to a default the binary happens to have on this box."""
    argv = [
        str(binary),
        "--sandbox", str(cfg.sandbox),
        "--field", ",".join(cfg.roster),
        "--seeds", str(cfg.seeds),
        "--batch", str(cfg.batch),
        "--threads", str(cfg.resolved_threads),
        "--partition", cfg.partition,
        "--json",
    ]
    if cfg.perfect is not None:
        argv += ["--perfect", str(cfg.perfect)]
    if cfg.max_ticks:
        argv += ["--max-ticks", str(cfg.max_ticks)]
    return argv


# --------------------------------------------------------------------------
# invoke + parse
# --------------------------------------------------------------------------

@dataclass
class SimOutput:
    """One parsed mb_sim --json run."""

    sim_version: str
    entrants: list[str]
    seeds: int
    batch: int
    threads: int
    partition: str
    threads_requested: int
    matches: int
    ticks: int          # NOT part of the oracle
    finished: int
    hash: str
    rows: list[dict[str, Any]]
    argv: list[str]
    wall_ms: float
    stderr: str

    def oracle(self) -> tuple[str, list[dict[str, Any]]]:
        """The determinism oracle: hash and rows, never ticks."""
        return self.hash, self.rows


def parse_sim_json(stdout: str, argv: list[str]) -> dict[str, Any]:
    text = stdout.strip()
    if not text:
        raise SimOutputError(
            f"mb_sim --json produced no stdout: {' '.join(argv)}")
    try:
        doc = json.loads(text)
    except json.JSONDecodeError as exc:
        raise SimOutputError(
            f"mb_sim --json output is not JSON ({exc}): {text[:200]!r}") from exc
    required = ("sim_version", "entrants", "seeds", "batch", "threads",
                "partition", "matches", "ticks", "finished", "hash", "results")
    missing = [k for k in required if k not in doc]
    if missing:
        raise SimOutputError(f"mb_sim --json output is missing {missing}")
    return doc


def binary_version(binary: Path) -> str:
    """The sim_version stamp, straight from the binary. Its single source is
    MB_SIM_VERSION in systems/native/mb_types.h."""
    proc = subprocess.run([str(binary), "--version"], capture_output=True,
                          text=True)
    if proc.returncode != 0:
        raise SimCrash(proc.returncode, proc.stderr,
                       [str(binary), "--version"])
    line = proc.stdout.strip()
    if not line.startswith("sim_version="):
        raise SimOutputError(
            f"mb_sim --version printed {line!r}, expected sim_version=<v>")
    return line.split("=", 1)[1]


def run_sim(cfg: RunConfig, binary: Path | None = None) -> SimOutput:
    """Invokes mb_sim once and parses it. Raises SimRefusal (exit 2),
    SimCrash (any other nonzero), BinaryMissing, or SimOutputError."""
    exe = binary if binary is not None else find_binary(cfg.binary)
    argv = build_argv(cfg, exe)
    t0 = time.perf_counter()
    proc = subprocess.run(argv, capture_output=True, text=True)
    wall_ms = (time.perf_counter() - t0) * 1000.0

    if proc.returncode == 2:
        raise SimRefusal(_last_line(proc.stderr), proc.stderr, argv)
    if proc.returncode != 0:
        raise SimCrash(proc.returncode, proc.stderr, argv)

    doc = parse_sim_json(proc.stdout, argv)
    rows = doc["results"]
    entrants = list(doc["entrants"])

    if entrants != cfg.roster:
        raise SimOutputError(
            f"mb_sim reported a different field than requested: "
            f"{entrants} != {cfg.roster}")
    # mb_sim creates at most one world per queued match, so a tiny queue can
    # legitimately use fewer worlds than were pinned. More is never legitimate.
    if doc["threads"] > cfg.resolved_threads:
        raise SimOutputError(
            f"mb_sim ran {doc['threads']} worlds, {cfg.resolved_threads} "
            f"were pinned")
    if not doc["finished"]:
        raise SimOutputError(
            "mb_sim did not finish every match (--max-ticks reached?)")

    named = [(entrants[r["entrant0"]], entrants[r["entrant1"]],
              r["seed_index"]) for r in rows]
    if named != cfg.queue:
        raise SimOutputError(
            f"mb_sim's result table does not match the canonical queue this "
            f"driver expected ({len(named)} rows vs {len(cfg.queue)}); the "
            f"queue construction has diverged")

    return SimOutput(
        sim_version=str(doc["sim_version"]), entrants=entrants,
        seeds=int(doc["seeds"]), batch=int(doc["batch"]),
        threads=int(doc["threads"]),
        threads_requested=cfg.resolved_threads,
        partition=str(doc["partition"]),
        matches=int(doc["matches"]), ticks=int(doc["ticks"]),
        finished=int(doc["finished"]), hash=str(doc["hash"]),
        rows=rows, argv=argv, wall_ms=wall_ms, stderr=proc.stderr)


def _last_line(text: str) -> str:
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    return lines[-1] if lines else "(no stderr)"


# --------------------------------------------------------------------------
# aggregation - COUNTS ONLY. No scoring semantics live here (that is S5).
# --------------------------------------------------------------------------

def aggregate(sim: SimOutput) -> dict[str, Any]:
    entrants = sim.entrants
    per = {e: {"wins": 0, "losses": 0, "draws": 0, "matches": 0}
           for e in entrants}
    h2h: dict[str, dict[str, int]] = {}
    totals = {"matches": 0, "draws": 0, "timeouts": 0, "finishers": 0,
              "capped": 0, "ko_matches": 0, "tie_rounds": 0, "frames": 0}

    for row in sim.rows:
        e0 = entrants[row["entrant0"]]
        e1 = entrants[row["entrant1"]]
        totals["matches"] += 1
        totals["timeouts"] += row["timeouts"]
        totals["finishers"] += row["finishers"]
        totals["capped"] += row["capped"]
        totals["tie_rounds"] += row["tie_rounds"]
        totals["frames"] += row["frames"]
        # a round decided by anything but the watch was a KO (mb_sim --stats)
        if row["timeouts"] < row["rounds"]:
            totals["ko_matches"] += 1

        per[e0]["matches"] += 1
        per[e1]["matches"] += 1
        # head-to-head is keyed on the unordered pairing in roster order, so
        # both orientations of a pairing land in one bucket
        i0, i1 = entrants.index(e0), entrants.index(e1)
        lo, hi = (e0, e1) if i0 < i1 else (e1, e0)
        key = f"{lo} vs {hi}"
        cell = h2h.setdefault(key, {"matches": 0, f"{lo} wins": 0,
                                    f"{hi} wins": 0, "draws": 0})
        cell["matches"] += 1

        if row["drawn"]:
            totals["draws"] += 1
            per[e0]["draws"] += 1
            per[e1]["draws"] += 1
            cell["draws"] += 1
        elif row["winner"] == 0:
            per[e0]["wins"] += 1
            per[e1]["losses"] += 1
            cell[f"{e0} wins"] += 1
        elif row["winner"] == 1:
            per[e1]["wins"] += 1
            per[e0]["losses"] += 1
            cell[f"{e1} wins"] += 1
        else:
            raise SimOutputError(
                f"result row has no winner and is not drawn: {row}")

    return {"per_entrant": per, "head_to_head": h2h, "totals": totals}


# --------------------------------------------------------------------------
# the run record
# --------------------------------------------------------------------------

def build_record(cfg: RunConfig, sim: SimOutput, binary: Path,
                 sim_version: str, verify: dict[str, Any] | None = None,
                 ) -> dict[str, Any]:
    stat = binary.stat()
    return {
        "schema": RECORD_SCHEMA,
        "label": cfg.label,
        "created_utc": datetime.now(timezone.utc).isoformat(
            timespec="seconds"),
        # THE ORACLE (architecture spec 1.4 ruling 5(a)). Results produced
        # under different sim_versions are not comparable.
        "sim_version": sim_version,
        "binary": {
            "path": str(binary),
            "mtime_utc": datetime.fromtimestamp(
                stat.st_mtime, timezone.utc).isoformat(timespec="seconds"),
            "size_bytes": stat.st_size,
        },
        "config": {
            "roster": cfg.roster,
            "roster_source": cfg.roster_source,
            "seeds": cfg.seeds,
            "sandbox": str(cfg.sandbox),
            "perfect": str(cfg.perfect) if cfg.perfect else None,
            "threads": sim.threads_requested,
            "threads_used": sim.threads,
            "batch": sim.batch,
            "partition": sim.partition,
            "max_ticks": cfg.max_ticks,
            "argv": sim.argv,
            "cwd": str(Path.cwd()),
        },
        "thread_policy": cfg.thread_policy,
        "queue": {
            "matches": sim.matches,
            "expected_matches": len(cfg.queue),
            "pairings": len(cfg.roster) * (len(cfg.roster) - 1) // 2,
        },
        # rows + hash ARE the oracle; ticks is the critical path and is not.
        "oracle": {"hash": sim.hash, "rows": sim.rows},
        "non_oracle": {
            "ticks": sim.ticks,
            "wall_ms": round(sim.wall_ms, 3),
            "note": "ticks moves with --threads/--partition by design",
        },
        "finished": sim.finished,
        "aggregate": aggregate(sim),
        "verify": verify,
    }


def write_record(path: Path, record: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(record, indent=2) + "\n", encoding="ascii")


@dataclass
class DriverRun:
    sim: SimOutput
    record: dict[str, Any]
    binary: Path


def run_tournament(cfg: RunConfig, verify: bool = False) -> DriverRun:
    """One tournament, end to end: invoke, parse, aggregate, build the record.
    This is the entry point S5 imports."""
    binary = find_binary(cfg.binary)
    sim_version = binary_version(binary)
    sim = run_sim(cfg, binary)
    if sim.sim_version != sim_version:
        raise SimOutputError(
            f"sim_version disagreement: --version says {sim_version!r}, "
            f"--json says {sim.sim_version!r}")

    verify_block: dict[str, Any] | None = None
    if verify:
        second = run_sim(cfg, binary)
        same_hash = second.hash == sim.hash
        same_rows = second.rows == sim.rows
        verify_block = {
            "mode": "repeat-invocation",
            "compared": "rows + hash (ticks excluded by contract)",
            "first_hash": sim.hash,
            "second_hash": second.hash,
            "identical": bool(same_hash and same_rows),
            "ticks": [sim.ticks, second.ticks],
        }
        if not (same_hash and same_rows):
            raise VerifyMismatch(
                f"determinism check FAILED: hash {sim.hash} vs {second.hash}, "
                f"rows {'match' if same_rows else 'differ'}")

    record = build_record(cfg, sim, binary, sim_version, verify_block)
    return DriverRun(sim=sim, record=record, binary=binary)


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def format_summary(record: dict[str, Any]) -> str:
    cfg = record["config"]
    agg = record["aggregate"]
    tot = agg["totals"]
    out: list[str] = []
    out.append(f"sim_version={record['sim_version']} "
               f"matches={record['queue']['matches']} "
               f"threads={cfg['threads']} batch={cfg['batch']} "
               f"partition={cfg['partition']} "
               f"hash={record['oracle']['hash']}")
    out.append(f"thread_policy: {record['thread_policy']['mode']} "
               f"({record['thread_policy']['rule']}, cores="
               f"{record['thread_policy']['cores']}) -> "
               f"{record['thread_policy']['chosen']}")
    out.append("")
    out.append(f"  {'entrant':<24} {'W':>5} {'L':>5} {'D':>5} {'matches':>8}")
    for name, rec in agg["per_entrant"].items():
        out.append(f"  {name:<24} {rec['wins']:>5} {rec['losses']:>5} "
                   f"{rec['draws']:>5} {rec['matches']:>8}")
    out.append("")
    out.append("  head-to-head")
    for key, cell in agg["head_to_head"].items():
        parts = ", ".join(f"{k}={v}" for k, v in cell.items())
        out.append(f"    {key:<44} {parts}")
    out.append("")
    out.append(f"  draws={tot['draws']} timeouts={tot['timeouts']} "
               f"finishers={tot['finishers']} capped={tot['capped']} "
               f"ko_matches={tot['ko_matches']}")
    if record.get("verify"):
        v = record["verify"]
        out.append(f"  verify: identical={v['identical']} "
                   f"({v['first_hash']} == {v['second_hash']}, "
                   f"ticks {v['ticks'][0]}/{v['ticks'][1]})")
    return "\n".join(out)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="mb_driver.py",
        description="Drive the monkey-baiting tournament simulator (mb_sim) "
                    "and write a run record.")
    ap.add_argument("--roster", required=True,
                    help="comma-separated entrant ids ('<char>:<bot>,...') "
                         "or a path to a roster YAML / plain list")
    ap.add_argument("--seeds", type=int, default=4,
                    help="matches per pairing (default 4)")
    ap.add_argument("--sandbox", type=Path, default=DEFAULT_SANDBOX)
    ap.add_argument("--perfect", type=Path, default=None,
                    help="solved-policy directory, for perfect-capable bots")
    ap.add_argument("--threads", type=int, default=None,
                    help="override the auto thread policy "
                         f"(default: min(cores, {THREADS_CAP}), "
                         f"{SMALL_QUEUE_THREADS} below "
                         f"{SMALL_QUEUE_MATCHES} matches)")
    ap.add_argument("--batch", type=int, default=DEFAULT_BATCH)
    ap.add_argument("--partition", choices=("round-robin", "block"),
                    default=DEFAULT_PARTITION)
    ap.add_argument("--max-ticks", type=int, default=0)
    ap.add_argument("--binary", type=Path, default=None,
                    help="mb_sim path (default: the standard build outputs)")
    ap.add_argument("--label", default="", help="free-text run label")
    ap.add_argument("--out", type=Path, default=None,
                    help="write the run record JSON here")
    ap.add_argument("--verify", action="store_true",
                    help="run the same invocation twice and require identical "
                         "rows + hash (ticks excluded)")
    args = ap.parse_args(argv)

    try:
        roster, settings = load_roster(args.roster)
        cfg = RunConfig(
            roster=roster,
            seeds=int(settings.get("seeds", args.seeds)),
            sandbox=Path(settings.get("sandbox", args.sandbox)),
            perfect=(Path(settings["perfect"]) if settings.get("perfect")
                     else args.perfect),
            threads=args.threads,
            batch=int(settings.get("batch", args.batch)),
            partition=str(settings.get("partition", args.partition)),
            max_ticks=args.max_ticks,
            binary=args.binary,
            roster_source=args.roster,
            label=args.label,
        )
        run = run_tournament(cfg, verify=args.verify)
    except SimRefusal as exc:
        print(f"mb_driver: REFUSAL (mb_sim exit 2) - {exc.reason}",
              file=sys.stderr)
        print(f"  command: {' '.join(exc.argv)}", file=sys.stderr)
        return 2
    except SimCrash as exc:
        print(f"mb_driver: mb_sim CRASHED (exit {exc.code})", file=sys.stderr)
        print(f"  command: {' '.join(exc.argv)}", file=sys.stderr)
        print(exc.stderr.rstrip(), file=sys.stderr)
        return 3
    except VerifyMismatch as exc:
        print(f"mb_driver: {exc}", file=sys.stderr)
        return 4
    except DriverError as exc:
        print(f"mb_driver: {exc}", file=sys.stderr)
        return 1

    print(format_summary(run.record))
    if args.out:
        write_record(args.out, run.record)
        print(f"\nrun record -> {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""mb_loop -- the monkey-baiting balance loop, in Python.

Architecture stage S5 (`web/monkey-baiting/docs/specs/
tournament-simulator-architecture.md`, ruling 2): the tournament runner
orchestration, grammar scorer, patch emitter, loop runner/search and archive,
ported from the retired node tooling onto the C simulator (via
`tools/mb_driver.py`) and the Python solver.

Design contract: `web/monkey-baiting/docs/balance-loop.md`.

Modules, bottom up:

    yamlio      minimal YAML reader/writer (no PyYAML on this fleet)
    data        canonical data loading, overlay merge, path resolution
    framedata   static frame analysis (envelopes, dominance) -- no simulation
    tournament  roster + mb_sim + the grammar-shaped report
    grammar     grammar validation, detection, the balance score
    patch       pins, the legal-patch verifier, overlay writing
    emit        the seeded candidate emitter
    solve       model export, per-pair hash gate, solve orchestration
    archive     the equal-height run archive (writer/reader/verify/rescore)
    search      the depth-first accept/reject loop and the patience driver
    runner      the runner that wires all of the above
    cli         `python -m mb_loop ...`

LOWER IS BETTER: the balance score is a sum of weight x detected signals, zero
when every band holds. A candidate is accepted only on STRICT improvement.
"""

__all__ = ["yamlio", "data", "framedata", "tournament", "grammar", "patch",
           "emit", "solve", "archive", "search", "runner"]

SCHEMA_RUN = "mb-run/2"
SCHEMA_SCORE = "mb-score/2"
SCHEMA_STACK = "mb-stack/2"
SCHEMA_PATCH = "mb-patch/2"
SCHEMA_ARCHIVE = "mb-archive/1"
"""`python3 -m mb_loop` entry point. See cli.py."""
import sys

from .cli import main

if __name__ == "__main__":
    sys.exit(main())
