/* MONKEY BAITING - the CPU-vs-CUDA determinism gate (architecture stage S8).
 *
 * The acceptance criterion for S8 (spec section 8, S8 row; section 6.2) is
 * that the CUDA compile target of the step functions and the CPU build
 * produce BYTE-IDENTICAL result summaries: the full per-match result rows
 * (winner, frames, rounds, tieRounds, timeouts, capped, drawn - and here also
 * the harvested rng_state, which is stricter) in canonical order, and the
 * same FNV-1a result hash. This is a CPU-vs-CUDA check, never a JS
 * comparison (ruling 7).
 *
 * Everything here runs BOTH backends over ONE queue in ONE process, so there
 * is no file, no parsing and no reformatting between the two answers - the
 * MbResult arrays are compared field by field.
 *
 * The whole suite SKIPS when no CUDA device is present, which is also what a
 * build with no CUDA toolkit reports (sim/mb_cuda_none.c). A GPU box that
 * fails to build the backend never reaches here: the build fails. */
#include "test.h"

#include "mb_world.h"
#include "mb_rules.h"
#include "mb_perfect.h"
#include "mb_pool.h"
#include "mb_cuda.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SANDBOX  "sandboxes/monkey-baiting"
#define FIXTURES SANDBOX "/tests/fixtures"

static MbRules g_rules;
static int g_rules_ok = 0;
static int g_have_cuda = 0;

/* --------------------------------------------------------------- helpers */

/* The same canonical enumeration mb_sim does: every pairing over the field,
 * `seeds` matches each, sides swapping on odd seeds. */
static int build_queue(MbPairing *q, int cap, const int *chars, const int *bots,
                       char ids[][48], int n_ent, int seeds) {
    int i, j, s, k = 0;
    for (i = 0; i < n_ent; i++) {
        for (j = i + 1; j < n_ent; j++) {
            for (s = 1; s <= seeds && k < cap; s++) {
                int a = (s % 2 == 1) ? i : j;
                int b = (s % 2 == 1) ? j : i;
                q[k].entrant0 = a;
                q[k].entrant1 = b;
                q[k].char0 = chars[a];
                q[k].char1 = chars[b];
                q[k].bot0 = bots[a];
                q[k].bot1 = bots[b];
                q[k].seed_index = s;
                q[k].seed = mb_seed_for(ids[a], ids[b], s);
                k++;
            }
        }
    }
    return k;
}

static void init_results(MbResult *r, int n) {
    int i;
    memset(r, 0, sizeof(MbResult) * (size_t)n);
    for (i = 0; i < n; i++) r[i].winner = -2;    /* not yet played */
}

static int run_cpu(const MbPerfectSet *set, const MbPairing *q, int n,
                   MbResult *out, int threads, int batch) {
    MbPoolConfig cfg;
    MbPoolStats st;
    memset(&cfg, 0, sizeof(cfg));
    memset(&st, 0, sizeof(st));
    cfg.threads = threads;
    cfg.batch = batch;
    cfg.partition = MB_PARTITION_ROUND_ROBIN;
    init_results(out, n);
    if (!mb_pool_run(&g_rules, set, q, n, &cfg, out, &st)) return 0;
    return st.finished;
}

static int run_cuda(const MbPerfectSet *set, const MbPairing *q, int n,
                    MbResult *out, int width, int frames) {
    MbCudaConfig cfg;
    MbCudaStats st;
    memset(&cfg, 0, sizeof(cfg));
    memset(&st, 0, sizeof(st));
    cfg.width = width;
    cfg.frames_per_launch = frames;
    init_results(out, n);
    if (!mb_cuda_run(&g_rules, set, q, n, &cfg, out, &st)) return 0;
    return st.finished;
}

/* The gate itself, as one predicate: every row, every field, then the hash.
 * Prints the first divergence, because "a row moved" is a bug to find, never
 * a baseline to re-cut (mb_types.h's sim_version bump rule). */
static int rows_identical(const MbResult *a, const MbResult *b, int n) {
    int i;
    for (i = 0; i < n; i++) {
        if (a[i].entrant0 == b[i].entrant0 && a[i].entrant1 == b[i].entrant1 &&
            a[i].seed_index == b[i].seed_index && a[i].winner == b[i].winner &&
            a[i].frames == b[i].frames && a[i].rounds == b[i].rounds &&
            a[i].tie_rounds == b[i].tie_rounds &&
            a[i].timeouts == b[i].timeouts &&
            a[i].finishers == b[i].finishers && a[i].capped == b[i].capped &&
            a[i].drawn == b[i].drawn && a[i].rng_state == b[i].rng_state)
            continue;
        printf("\n    row %d diverged:\n"
               "      cpu  winner=%d frames=%d rounds=%d ties=%d timeouts=%d "
               "fin=%d capped=%d drawn=%d rng=%u\n"
               "      cuda winner=%d frames=%d rounds=%d ties=%d timeouts=%d "
               "fin=%d capped=%d drawn=%d rng=%u\n", i,
               a[i].winner, a[i].frames, a[i].rounds, a[i].tie_rounds,
               a[i].timeouts, a[i].finishers, a[i].capped, a[i].drawn,
               a[i].rng_state,
               b[i].winner, b[i].frames, b[i].rounds, b[i].tie_rounds,
               b[i].timeouts, b[i].finishers, b[i].capped, b[i].drawn,
               b[i].rng_state);
        return 0;
    }
    return mb_result_hash(a, n) == mb_result_hash(b, n);
}

/* A field of the first `n_ent` roster characters on one bot. */
static int field_of(const char *bot, int n_ent, int *chars, int *bots,
                    char ids[][48]) {
    int i, b = mb_rules_bot_id(bot);
    if (b < 0) return 0;
    if (n_ent > g_rules.chars.count) n_ent = g_rules.chars.count;
    for (i = 0; i < n_ent; i++) {
        chars[i] = i;
        bots[i] = b;
        snprintf(ids[i], 48, "%s:%s", mb_rules_char_name(i), bot);
    }
    return n_ent;
}

/* ----------------------------------------------------------------- tests */

#define MAXQ 512
#define MAXE 16

/* THE GATE. One field, one queue, both backends, identical rows and hash. */
TEST(cuda_matches_the_cpu_row_for_row) {
    MbPairing q[MAXQ];
    MbResult cpu[MAXQ], gpu[MAXQ];
    int chars[MAXE], bots[MAXE];
    char ids[MAXE][48];
    int n_ent, n;

    n_ent = field_of("house", 5, chars, bots, ids);
    ASSERT(n_ent >= 3);
    n = build_queue(q, MAXQ, chars, bots, ids, n_ent, 4);
    ASSERT(n > 0);

    ASSERT(run_cpu(NULL, q, n, cpu, 4, 1));
    ASSERT(run_cuda(NULL, q, n, gpu, n, 64));
    ASSERT(rows_identical(cpu, gpu, n));
}

/* Mixed bots exercise every strategy branch (and therefore every draw site)
 * on the device, not just the tuned house AI. */
TEST(cuda_matches_the_cpu_over_mixed_bots) {
    MbPairing q[MAXQ];
    MbResult cpu[MAXQ], gpu[MAXQ];
    int chars[MAXE], bots[MAXE];
    char ids[MAXE][48];
    const char *bot_ids[3] = { "house", "chaos", "dummy" };
    int n_ent = 0, n, c, k;

    for (c = 0; c < g_rules.chars.count && n_ent < MAXE; c++) {
        for (k = 0; k < 3 && n_ent < MAXE; k++) {
            int b = mb_rules_bot_id(bot_ids[k]);
            ASSERT(b >= 0);
            chars[n_ent] = c;
            bots[n_ent] = b;
            snprintf(ids[n_ent], 48, "%s:%s", mb_rules_char_name(c), bot_ids[k]);
            n_ent++;
        }
    }
    ASSERT(n_ent >= 6);
    n = build_queue(q, MAXQ, chars, bots, ids, n_ent, 2);
    ASSERT(n > 0);

    ASSERT(run_cpu(NULL, q, n, cpu, 8, 1));
    ASSERT(run_cuda(NULL, q, n, gpu, n, 64));
    ASSERT(rows_identical(cpu, gpu, n));
}

/* LAUNCH-WIDTH INVARIANCE (spec section 7.6 item 4, in the CUDA parameter).
 * W is the kernel launch width, so a width that changes a row would mean the
 * lanes are not independent. Widths that do and do not divide the queue. */
TEST(cuda_hash_does_not_move_with_the_launch_width) {
    MbPairing q[MAXQ];
    MbResult ref[MAXQ], gpu[MAXQ];
    int chars[MAXE], bots[MAXE];
    char ids[MAXE][48];
    int widths[5] = { 1, 7, 32, 128, MAXQ };
    int n_ent, n, i;

    n_ent = field_of("chaos", 4, chars, bots, ids);
    ASSERT(n_ent >= 3);
    n = build_queue(q, MAXQ, chars, bots, ids, n_ent, 2);
    ASSERT(n > 0);

    ASSERT(run_cuda(NULL, q, n, ref, n, 64));
    for (i = 0; i < 5; i++) {
        int w = widths[i] > n ? n : widths[i];
        ASSERT(run_cuda(NULL, q, n, gpu, w, 64));
        ASSERT(rows_identical(ref, gpu, n));
    }
}

/* Frames per launch is the launch-overhead knob. It batches whole frames
 * inside one kernel, so it must be as inert as the width. */
TEST(cuda_hash_does_not_move_with_frames_per_launch) {
    MbPairing q[MAXQ];
    MbResult ref[MAXQ], gpu[MAXQ];
    int chars[MAXE], bots[MAXE];
    char ids[MAXE][48];
    int frames[4] = { 1, 3, 64, 1024 };
    int n_ent, n, i;

    n_ent = field_of("house", 4, chars, bots, ids);
    ASSERT(n_ent >= 3);
    n = build_queue(q, MAXQ, chars, bots, ids, n_ent, 2);
    ASSERT(n > 0);

    ASSERT(run_cuda(NULL, q, n, ref, n, 64));
    for (i = 0; i < 4; i++) {
        ASSERT(run_cuda(NULL, q, n, gpu, n, frames[i]));
        ASSERT(rows_identical(ref, gpu, n));
    }
}

/* REPEAT INVARIANCE. The same CUDA command twice is byte-identical - the
 * device-side scheduler claims queue entries with an atomic, so slot
 * assignment is not fixed between runs, and the answer still must not be. */
TEST(cuda_repeats_itself_exactly) {
    MbPairing q[MAXQ];
    MbResult a[MAXQ], b[MAXQ];
    int chars[MAXE], bots[MAXE];
    char ids[MAXE][48];
    int n_ent, n;

    n_ent = field_of("house", 5, chars, bots, ids);
    ASSERT(n_ent >= 3);
    n = build_queue(q, MAXQ, chars, bots, ids, n_ent, 2);
    ASSERT(n > 0);

    ASSERT(run_cuda(NULL, q, n, a, 16, 64));
    ASSERT(run_cuda(NULL, q, n, b, 16, 64));
    ASSERT(rows_identical(a, b, n));
}

/* The perfect-policy tables are the one genuinely cache-hostile read in the
 * frame (spec section 7.2) and the one shared structure with pointers in it,
 * so the device copy is where an upload bug would show. The checked-in tiny
 * fixture makes this runnable on any box with a GPU. */
TEST(cuda_matches_the_cpu_with_a_perfect_entrant) {
    MbPerfectSet set;
    MbPairing q[8];
    MbResult cpu[8], gpu[8];
    int jacco = mb_rules_char_id("jacco"), brock = mb_rules_char_id("brock");
    int i, n = 0;

    mb_perfect_init(&set);
    ASSERT(mb_perfect_load_pair(&set, &g_rules, FIXTURES "/policy-tiny",
                                jacco, brock));

    /* Only jacco can roll `perfect` here: perfect-brock-vs-jacco is not in
     * the fixture, and the queue installer would refuse the mirror. */
    for (i = 1; i <= 4; i++) {
        q[n].entrant0 = 0; q[n].entrant1 = 1;
        q[n].char0 = jacco; q[n].char1 = brock;
        q[n].bot0 = mb_rules_bot_id("perfect");
        q[n].bot1 = mb_rules_bot_id("house");
        q[n].seed_index = i;
        q[n].seed = mb_seed_for("jacco:perfect", "brock:house", i);
        n++;
    }

    ASSERT(run_cpu(&set, q, n, cpu, 1, 1));
    ASSERT(run_cuda(&set, q, n, gpu, n, 64));
    ASSERT(rows_identical(cpu, gpu, n));
    /* and the policy is actually being read: a perfect entrant that never
     * consulted its table would tie the house bot's own result exactly */
    ASSERT(cpu[0].frames > 0);

    mb_perfect_free(&set);
}

int main(void) {
    printf("\n=== monkey-baiting: CPU vs CUDA (stage S8) ===\n");

    g_rules_ok = mb_rules_load(&g_rules, SANDBOX);
    if (!g_rules_ok) {
        printf("  (SKIP: run from the project root - %s not readable)\n", SANDBOX);
        return 0;
    }
    g_have_cuda = mb_cuda_available();
    if (!g_have_cuda) {
        printf("  (SKIP: %s)\n", mb_cuda_unavailable_reason());
        return 0;
    }

    TEST_SUITE("the acceptance gate");
    RUN(cuda_matches_the_cpu_row_for_row);
    RUN(cuda_matches_the_cpu_over_mixed_bots);
    RUN(cuda_matches_the_cpu_with_a_perfect_entrant);

    TEST_SUITE("invariance");
    RUN(cuda_hash_does_not_move_with_the_launch_width);
    RUN(cuda_hash_does_not_move_with_frames_per_launch);
    RUN(cuda_repeats_itself_exactly);

    TEST_RESULTS();
}
#!/usr/bin/env python3
"""test_mb_driver - the Python driver for mb_sim (architecture stage S1).

Covers the four things the driver is responsible for: the run-record schema,
hash stability across two identical invocations (the determinism oracle: rows
and hash, never ticks), the refusal path being distinct from a crash, and the
auto thread policy being both applied and recorded.

Run from the project root:
    python3 sandboxes/monkey-baiting/tests/test_mb_driver.py

SKIPs (exit 0) when mb_sim is not where a standard build puts it, the same way
test_mb_sim.c's binary-driving cases do.
"""

from __future__ import annotations

import importlib.util
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent.parent.parent
SPEC = importlib.util.spec_from_file_location(
    "mb_driver", ROOT / "sandboxes" / "monkey-baiting" / "tools" / "mb_driver.py")
assert SPEC and SPEC.loader
mb_driver = importlib.util.module_from_spec(SPEC)
# dataclasses resolves annotations through sys.modules[cls.__module__], so a
# hand-loaded module has to be registered before it is executed.
sys.modules["mb_driver"] = mb_driver
SPEC.loader.exec_module(mb_driver)

# A tiny field: 3 entrants x 2 seeds = 6 matches, seconds at most.
ROSTER = ["jacco:house", "brock:chaos", "billy:dummy"]
SEEDS = 2

PASS = 0
FAIL = 0
BINARY: Path | None = None


def check(label: str, cond: bool, detail: str = "") -> None:
    global PASS, FAIL
    print(f"  {'PASS' if cond else 'FAIL'}  {label}"
          + (f"  [{detail}]" if detail and not cond else ""))
    if cond:
        PASS += 1
    else:
        FAIL += 1


def cfg(**kw: Any) -> Any:
    args: dict[str, Any] = dict(roster=list(ROSTER), seeds=SEEDS,
                                binary=BINARY)
    args.update(kw)
    return mb_driver.RunConfig(**args)


def test_canonical_queue() -> None:
    print("canonical queue")
    q = mb_driver.canonical_queue(ROSTER, SEEDS)
    check("6 matches for 3 entrants x 2 seeds", len(q) == 6, str(len(q)))
    check("pairing-major, seed 1 unswapped",
          q[0] == ("jacco:house", "brock:chaos", 1), str(q[0]))
    check("sides swap on even seeds",
          q[1] == ("brock:chaos", "jacco:house", 2), str(q[1]))


def test_thread_policy() -> None:
    print("thread policy")
    cores = os.cpu_count() or 1
    small = mb_driver.resolve_threads(6)
    check("small queue drops to 8",
          small["chosen"] == min(8, cores) and small["mode"] == "auto",
          str(small))
    big = mb_driver.resolve_threads(2520)
    check("full queue uses min(cores, 20)",
          big["chosen"] == min(20, cores), str(big))
    over = mb_driver.resolve_threads(2520, override=3)
    check("explicit --threads overrides",
          over["chosen"] == 3 and over["mode"] == "override", str(over))
    check("boundary: 1499 is small",
          mb_driver.resolve_threads(1499)["chosen"] == min(8, cores))
    check("boundary: 1500 is not",
          mb_driver.resolve_threads(1500)["chosen"] == min(20, cores))


def test_roster_parsing() -> None:
    print("roster parsing")
    ids, extra = mb_driver.load_roster("jacco:house,brock:chaos")
    check("inline list", ids == ["jacco:house", "brock:chaos"] and not extra)

    tmp = Path(tempfile.mkdtemp(prefix="mb-driver-test-"))
    plain = tmp / "roster.yaml"
    plain.write_text("# a field\n- jacco:house\n- brock:chaos\n",
                     encoding="ascii")
    ids, _ = mb_driver.load_roster(str(plain))
    check("plain-list roster file",
          ids == ["jacco:house", "brock:chaos"], str(ids))

    mapping = tmp / "mapping.yaml"
    mapping.write_text("roster:\n  - jacco:house\n  - brock:chaos\nseeds: 2\n",
                       encoding="ascii")
    try:
        import yaml  # noqa: F401
        have_yaml = True
    except ImportError:
        have_yaml = False
    if have_yaml:
        ids, extra = mb_driver.load_roster(str(mapping))
        check("mapping roster file (PyYAML present)",
              ids == ["jacco:house", "brock:chaos"] and extra["seeds"] == 2,
              f"{ids} {extra}")
    else:
        try:
            mb_driver.load_roster(str(mapping))
            check("mapping form refused without PyYAML", False, "no raise")
        except mb_driver.DriverError as exc:
            check("mapping form refused without PyYAML",
                  "PyYAML" in str(exc), str(exc))

    for bad, why in (("solo:bot", "one entrant"),
                     ("jacco:house,jacco:house", "duplicate"),
                     ("jacco,brock:chaos", "malformed id")):
        try:
            mb_driver.RunConfig(roster=bad.split(","), seeds=1)
            check(f"refuses {why}", False, "no raise")
        except mb_driver.DriverError:
            check(f"refuses {why}", True)


def test_argv_pinning(binary: Path) -> None:
    print("invocation builder")
    c = cfg()
    argv = mb_driver.build_argv(c, binary)
    for flag in ("--threads", "--batch", "--partition", "--seeds", "--field",
                 "--sandbox", "--json"):
        check(f"{flag} passed explicitly", flag in argv)
    check("--threads value is the resolved policy, never the binary default",
          argv[argv.index("--threads") + 1] == str(c.resolved_threads))
    check("--perfect omitted when unused", "--perfect" not in argv)
    check("--perfect passed when set",
          "--perfect" in mb_driver.build_argv(
              cfg(perfect=Path("policies")), binary))


def test_record_and_determinism(binary: Path) -> Any:
    print("run record + determinism")
    run = mb_driver.run_tournament(cfg(label="unit-test"), verify=True)
    rec = run.record

    for key in ("schema", "label", "created_utc", "sim_version", "binary",
                "config", "thread_policy", "queue", "oracle", "non_oracle",
                "finished", "aggregate", "verify"):
        check(f"record has {key}", key in rec)
    check("schema stamp", rec["schema"] == mb_driver.RECORD_SCHEMA)
    check("sim_version present and non-empty", bool(rec["sim_version"]))
    check("binary path + mtime recorded",
          rec["binary"]["path"] and rec["binary"]["mtime_utc"]
          and rec["binary"]["size_bytes"] > 0)
    conf = rec["config"]
    for key in ("roster", "seeds", "sandbox", "perfect", "threads", "batch",
                "partition", "max_ticks", "argv", "cwd", "roster_source"):
        check(f"config records {key}", key in conf)
    check("config roster is the field", conf["roster"] == ROSTER)
    check("oracle is hash + rows",
          set(rec["oracle"]) == {"hash", "rows"}, str(set(rec["oracle"])))
    check("6 canonical rows", len(rec["oracle"]["rows"]) == 6)
    check("ticks lives outside the oracle",
          "ticks" in rec["non_oracle"] and "ticks" not in rec["oracle"])

    # thread auto-policy: applied AND recorded
    pol = rec["thread_policy"]
    check("thread policy recorded as auto", pol["mode"] == "auto", str(pol))
    check("thread policy dropped to 8 for a 6-match queue",
          pol["chosen"] == min(8, os.cpu_count() or 1), str(pol))
    check("thread policy states its rule and the core count",
          "1500" in pol["rule"] and pol["cores"] >= 1, str(pol))
    check("recorded threads == the pinned number", conf["threads"] == pol["chosen"])

    # hash stability across two runs (--verify did one pair; do an independent
    # second driver run to prove it holds across processes too)
    check("verify block says identical", rec["verify"]["identical"] is True)
    check("verify compared rows + hash, not ticks",
          "ticks excluded" in rec["verify"]["compared"])
    again = mb_driver.run_tournament(cfg())
    check("hash stable across separate driver runs",
          again.record["oracle"]["hash"] == rec["oracle"]["hash"],
          f"{again.record['oracle']['hash']} vs {rec['oracle']['hash']}")
    check("rows stable across separate driver runs",
          again.record["oracle"]["rows"] == rec["oracle"]["rows"])

    # aggregate: counts only
    agg = rec["aggregate"]
    check("per-entrant W/L/D for every entrant",
          set(agg["per_entrant"]) == set(ROSTER))
    tot = sum(e["wins"] + e["losses"] + e["draws"]
              for e in agg["per_entrant"].values())
    check("every match counted exactly twice (once per side)", tot == 12,
          str(tot))
    check("head-to-head has one bucket per pairing",
          len(agg["head_to_head"]) == 3, str(len(agg["head_to_head"])))
    for key in ("draws", "timeouts", "finishers", "capped", "ko_matches"):
        check(f"totals record {key}", key in agg["totals"])

    # the record must be JSON-serialisable as written
    tmp = Path(tempfile.mkdtemp(prefix="mb-driver-rec-")) / "run.json"
    mb_driver.write_record(tmp, rec)
    check("record round-trips through JSON",
          json.loads(tmp.read_text(encoding="ascii"))["oracle"]["hash"]
          == rec["oracle"]["hash"])
    return rec


def test_refusal(binary: Path) -> None:
    print("failure surfacing")
    # A perfect-capable entrant pointed at a bogus policy directory: mb_sim
    # exits 2 deliberately (refusal, never demotion). That must arrive as a
    # SimRefusal carrying the stderr line, not as a crash and never as a
    # silently degraded run.
    try:
        mb_driver.run_tournament(
            cfg(roster=["jacco:perfect", "brock:chaos"], seeds=1,
                perfect=Path("no-such-policy-dir")))
        check("bogus --perfect dir refuses", False, "no raise")
    except mb_driver.SimRefusal as exc:
        check("bogus --perfect dir raises SimRefusal", True)
        check("refusal carries the causing stderr line",
              "perfect policy" in exc.reason, exc.reason)
        check("refusal is not a SimCrash",
              not isinstance(exc, mb_driver.SimCrash))
    except mb_driver.DriverError as exc:
        check("bogus --perfect dir raises SimRefusal", False, repr(exc))

    # Same shape at the CLI: exit code 2 is reserved for refusal.
    proc = subprocess.run(
        [sys.executable,
         str(ROOT / "sandboxes/monkey-baiting/tools/mb_driver.py"),
         "--roster", "jacco:perfect,brock:chaos", "--seeds", "1",
         "--perfect", "no-such-policy-dir", "--binary", str(binary)],
        capture_output=True, text=True, cwd=ROOT)
    check("CLI exits 2 on refusal", proc.returncode == 2, str(proc.returncode))
    check("CLI labels it a refusal", "REFUSAL" in proc.stderr, proc.stderr[:200])

    # A perfect-capable entrant with no --perfect at all is also a refusal
    # (mb_rules_resolve_entrant), one stage earlier.
    try:
        mb_driver.run_tournament(cfg(roster=["jacco:perfect", "brock:chaos"],
                                     seeds=1))
        check("perfect entrant without policies refuses", False, "no raise")
    except mb_driver.SimRefusal:
        check("perfect entrant without policies refuses", True)

    # A missing binary is its own message, pointing at the build.
    try:
        mb_driver.find_binary(Path("build/local/definitely-not-here.exe"))
        check("missing binary raises BinaryMissing", False, "no raise")
    except mb_driver.BinaryMissing as exc:
        check("missing binary raises BinaryMissing", True)
        check("missing-binary message points at the cmake build",
              "cmake --build" in str(exc), str(exc))


def main() -> int:
    os.chdir(ROOT)
    # ctest passes $<TARGET_FILE:mb_sim> so the test drives the configuration
    # that was just built; standalone runs fall back to discovery.
    explicit = Path(sys.argv[1]) if len(sys.argv) > 1 else None
    try:
        binary = mb_driver.find_binary(explicit)
    except mb_driver.BinaryMissing as exc:
        print(f"SKIP test_mb_driver: {exc}")
        return 0
    global BINARY
    BINARY = binary
    print(f"test_mb_driver  (binary: {binary})")

    test_canonical_queue()
    test_thread_policy()
    test_roster_parsing()
    test_argv_pinning(binary)
    test_record_and_determinism(binary)
    test_refusal(binary)

    print(f"\n{PASS} passed, {FAIL} failed")
    return 1 if FAIL else 0


if __name__ == "__main__":
    sys.exit(main())
/* MONKEY BAITING - engine hosting tests (architecture stage S6).
 *
 * The point of this suite is ONE invariant: hosting the game inside the
 * engine must not fork its behaviour. The same pairing, the same seed, the
 * same sim_version -> the same result row, whether it is stepped by mb_sim's
 * mb_world_run or by eleven native systems under POST /api/sim/turn. If a row
 * moves here, something is wrong (../CLAUDE.md, "sim_version - the oracle
 * stamp": engine integration is not a reason to bump it).
 *
 * Also covers the standard sandbox lifecycle (sandbox/select -> app/start ->
 * sim/turn), frame-as-turn alignment, the REST-visible entity surface, and
 * the MbSpawnRequest injection path that tools/inject.py drives. */
#include "test.h"

#include "engine/engine.h"
#include "engine/simulation.h"
#include "engine/app.h"
#include "engine/templates.h"
#include "engine/components.h"

#include "mb_engine.h"
#include "mb_rules.h"
#include "mb_world.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SANDBOX "sandboxes/monkey-baiting"

/* The match app.yaml's `engine:` block queues at app start. Kept in step with
 * that file by hand: the whole test is a comparison against it. */
#define CFG_ENTRANT0 "jacco:house"
#define CFG_ENTRANT1 "brock:chaos"
#define CFG_SEED_INDEX 0

/* ------------------------------------------------------------- helpers */

static Engine *start_engine(const char *config) {
    Engine *e = engine_init(NULL);
    AppStartResult asr;
    if (!e) return NULL;
    if (!engine_sandbox_select(e, "monkey-baiting")) {
        engine_fini(e);
        return NULL;
    }
    if (!engine_app_start(e, config, &asr)) {
        engine_fini(e);
        return NULL;
    }
    return e;
}

static void turn(Engine *e) {
    TurnResult tr;
    engine_sim_turn(e, &tr);
    engine_turn_result_free(&tr);
}

/* The same pairing mb_engine builds from app.yaml, built here by the same
 * two rules: mb_rules_resolve_entrant for the indices, mb_seed_for for the
 * seed. Entrant indices are first-appearance order, so 0 and 1. */
static int pairing_for(const MbRules *rules, const char *id0, const char *id1,
                       int seed_index, MbPairing *out) {
    int c0, b0, c1, b1;
    if (!mb_rules_resolve_entrant(rules, id0, 0, &c0, &b0)) return 0;
    if (!mb_rules_resolve_entrant(rules, id1, 0, &c1, &b1)) return 0;
    memset(out, 0, sizeof(*out));
    out->entrant0 = 0;
    out->entrant1 = 1;
    out->char0 = c0;
    out->char1 = c1;
    out->bot0 = b0;
    out->bot1 = b1;
    out->seed_index = seed_index;
    out->seed = mb_seed_for(id0, id1, seed_index);
    return 1;
}

static void assert_rows_equal(const MbResult *a, const MbResult *b) {
    ASSERT_EQ(a->entrant0, b->entrant0);
    ASSERT_EQ(a->entrant1, b->entrant1);
    ASSERT_EQ(a->seed_index, b->seed_index);
    ASSERT_EQ(a->winner, b->winner);
    ASSERT_EQ(a->frames, b->frames);
    ASSERT_EQ(a->rounds, b->rounds);
    ASSERT_EQ(a->tie_rounds, b->tie_rounds);
    ASSERT_EQ(a->timeouts, b->timeouts);
    ASSERT_EQ(a->finishers, b->finishers);
    ASSERT_EQ(a->capped, b->capped);
    ASSERT_EQ(a->drawn, b->drawn);
    ASSERT_EQ((int)a->rng_state, (int)b->rng_state);
}

/* Steps turns until the hosted world has harvested `want` matches. Returns
 * the number of turns taken, or -1 if it never happened. A match is bounded
 * by the rules (rounds.max_rounds_per_match x rounds.time_seconds), so the
 * cap here only has to be larger than that. */
static int run_until_harvested(Engine *e, int want, int max_turns) {
    int t;
    for (t = 1; t <= max_turns; t++) {
        turn(e);
        if (mb_engine_harvested(e) >= want) return t;
    }
    return -1;
}

/* ------------------------------------------------------------ lifecycle */

TEST(select_then_start_builds_a_hosted_world) {
    Engine *e = start_engine(NULL);
    MbWorld *w;
    int n = 0;
    const ecs_entity_t *ents;

    ASSERT_NOT_NULL(e);
    w = mb_engine_world(e);
    ASSERT_NOT_NULL(w);

    /* app.yaml engine.batch is 1: one match slot, two fighters. */
    ents = mb_world_entities(w, &n);
    ASSERT_NOT_NULL(ents);
    ASSERT_EQ(n, 3);

    /* app/start deals the first match, so a turn is already frame 1 of a
     * fight rather than an empty tick. */
    ASSERT_EQ(mb_world_pending(w), 1);
    ASSERT_EQ(mb_engine_harvested(e), 0);

    engine_fini(e);
}

TEST(the_slots_are_first_class_engine_entities) {
    Engine *e = start_engine(NULL);
    EntityList list;
    int i, saw_match = 0, saw_f0 = 0, saw_f1 = 0;

    ASSERT_NOT_NULL(e);

    /* GET /api/entities is engine_entity_list, which sees UserEntity only.
     * The match must be in it, or the REST surface shows an empty world. */
    list = engine_entity_list(e);
    for (i = 0; i < list.count; i++) {
        if (!list.items[i].name) continue;
        if (strcmp(list.items[i].name, "MbMatch0") == 0) saw_match = 1;
        if (strcmp(list.items[i].name, "MbFighter0_0") == 0) saw_f0 = 1;
        if (strcmp(list.items[i].name, "MbFighter0_1") == 0) saw_f1 = 1;
    }
    engine_entity_list_free(&list);
    ASSERT(saw_match);
    ASSERT(saw_f0);
    ASSERT(saw_f1);

    /* And their components are readable through the ordinary Flecs API, which
     * is what the generic /api/entities/:id handler and tools/inspect.py use. */
    {
        ecs_entity_t body = ecs_lookup(e->world, "MbBody");
        ecs_entity_t f0 = ecs_lookup(e->world, "MbFighter0_0");
        ASSERT(body != 0);
        ASSERT(f0 != 0);
        ASSERT_NOT_NULL(ecs_get_id(e->world, f0, body));
    }
    engine_fini(e);
}

TEST(a_turn_is_a_frame) {
    Engine *e = start_engine(NULL);
    MbWorld *w;
    const MbClock *clock;
    ecs_entity_t clock_comp, slot;
    int32_t t_before, t_after;

    ASSERT_NOT_NULL(e);
    w = mb_engine_world(e);
    ASSERT_NOT_NULL(w);

    clock_comp = ecs_lookup(e->world, "MbClock");
    slot = ecs_lookup(e->world, "MbMatch0");
    ASSERT(clock_comp != 0);
    ASSERT(slot != 0);

    clock = (const MbClock *)ecs_get_id(e->world, slot, clock_comp);
    ASSERT_NOT_NULL(clock);
    t_before = clock->frame;
    turn(e);
    clock = (const MbClock *)ecs_get_id(e->world, slot, clock_comp);
    t_after = clock->frame;
    ASSERT_EQ(t_after - t_before, 1);

    /* Ten more turns, ten more frames. */
    {
        int i;
        for (i = 0; i < 10; i++) turn(e);
    }
    clock = (const MbClock *)ecs_get_id(e->world, slot, clock_comp);
    ASSERT_EQ(clock->frame - t_before, 11);
    ASSERT_EQ(e->turn_counter, 11);

    engine_fini(e);
}

/* ------------------------------------------------- the hosting invariant */

/* THE gate of this stage. Same pairing, same seed, same rules; one run
 * stepped by mb_sim's own loop, one by the engine's turn pipeline. Every
 * field of the result row, and the result hash that is mb_sim's oracle, must
 * agree. */
TEST(an_engine_hosted_match_is_the_mb_sim_row) {
    MbRules rules;
    MbWorld *sim;
    MbPairing p;
    MbResult expect;
    const MbResult *rows;
    int count = 0, turns;
    uint32_t sim_hash;
    int64_t sim_ticks = 0;
    Engine *e;

    ASSERT(mb_rules_load(&rules, SANDBOX));
    ASSERT(pairing_for(&rules, CFG_ENTRANT0, CFG_ENTRANT1, CFG_SEED_INDEX, &p));

    /* Path A: the tournament simulator's own path. */
    sim = mb_world_create(&rules, 1);
    ASSERT_NOT_NULL(sim);
    ASSERT(mb_world_set_queue(sim, &p, 1));
    ASSERT(mb_world_run(sim, 0, &sim_ticks));
    rows = mb_world_results(sim, &count);
    ASSERT_EQ(count, 1);
    expect = rows[0];
    sim_hash = mb_world_result_hash(sim);
    mb_world_destroy(sim);

    /* The match must actually have been played, or this proves nothing. */
    ASSERT(expect.winner != -2);
    ASSERT(expect.frames > 0);

    /* Path B: eleven native systems under the engine's turn loop. */
    e = start_engine(NULL);
    ASSERT_NOT_NULL(e);
    turns = run_until_harvested(e, 1, 200000);
    ASSERT(turns > 0);

    rows = mb_world_results(mb_engine_world(e), &count);
    ASSERT_EQ(count, 1);
    assert_rows_equal(&rows[0], &expect);
    ASSERT_EQ((int)mb_world_result_hash(mb_engine_world(e)), (int)sim_hash);

    /* Frame = turn, all the way through: the engine needed exactly as many
     * turns as mb_world_run needed ticks. */
    ASSERT_EQ(turns, (int)sim_ticks);

    engine_fini(e);
}

TEST(hosting_is_deterministic_across_two_engines) {
    Engine *a = start_engine(NULL);
    Engine *b = start_engine(NULL);
    int i;
    uint32_t ha, hb;

    ASSERT_NOT_NULL(a);
    ASSERT_NOT_NULL(b);
    for (i = 0; i < 600; i++) { turn(a); turn(b); }

    /* Mid-match: no result row exists yet, so hash the live state instead -
     * the fighters' bodies and vitals, which is what a divergence would move
     * first. */
    {
        ecs_entity_t body = ecs_lookup(a->world, "MbBody");
        ecs_entity_t vit = ecs_lookup(a->world, "MbVitals");
        ecs_entity_t fa = ecs_lookup(a->world, "MbFighter0_0");
        ecs_entity_t fb = ecs_lookup(b->world, "MbFighter0_0");
        const MbBody *ba = (const MbBody *)ecs_get_id(a->world, fa, body);
        const MbBody *bb = (const MbBody *)ecs_get_id(b->world, fb, body);
        const MbVitals *va = (const MbVitals *)ecs_get_id(a->world, fa, vit);
        const MbVitals *vb = (const MbVitals *)ecs_get_id(b->world, fb, vit);
        ASSERT_NOT_NULL(ba); ASSERT_NOT_NULL(bb);
        ASSERT_NOT_NULL(va); ASSERT_NOT_NULL(vb);
        ASSERT_EQ((int)ba->x, (int)bb->x);
        ASSERT_EQ((int)ba->y, (int)bb->y);
        ASSERT_EQ((int)va->hp, (int)vb->hp);
    }

    /* And to the end: the harvested rows and the hash agree. */
    ASSERT(run_until_harvested(a, 1, 200000) > 0);
    ASSERT(run_until_harvested(b, 1, 200000) > 0);
    ha = mb_world_result_hash(mb_engine_world(a));
    hb = mb_world_result_hash(mb_engine_world(b));
    ASSERT_EQ((int)ha, (int)hb);

    engine_fini(a);
    engine_fini(b);
}

/* ------------------------------------------------------ named configs */

TEST(a_named_config_selects_its_own_match) {
    Engine *e = start_engine("quad");
    MbWorld *w;
    int n = 0;

    ASSERT_NOT_NULL(e);
    w = mb_engine_world(e);
    ASSERT_NOT_NULL(w);
    /* engine.configs.quad declares batch 4 -> 4 slots + 8 fighters. */
    mb_world_entities(w, &n);
    ASSERT_EQ(n, 12);

    engine_fini(e);
}

TEST(an_unknown_config_refuses_rather_than_defaulting) {
    Engine *e = engine_init(NULL);
    AppStartResult asr;

    ASSERT_NOT_NULL(e);
    ASSERT(engine_sandbox_select(e, "monkey-baiting"));
    /* engine.configs.nope does not exist. app/start still succeeds - it is
     * the engine's, not the sandbox's - but no host is installed and no
     * system will step anything (root CLAUDE.md decision 12). */
    engine_app_start(e, "nope", &asr);
    ASSERT_NULL(mb_engine_world(e));

    engine_fini(e);
}

/* ------------------------------------------------------- the injection */

/* The repo's ECS interaction pattern: what tools/inject.py writes over REST
 * is exactly this component, and the engine picks it up on the next turn. */
static ecs_entity_t inject_match(Engine *e, const char *name,
                                 const char *char0, const char *bot0,
                                 const char *char1, const char *bot1,
                                 int seed_index) {
    ecs_entity_t comp = ecs_lookup(e->world, "MbSpawnRequest");
    ecs_entity_t ent = engine_entity_create(e, name);
    char **fields;
    if (!comp || !ent) return 0;
    ecs_add_id(e->world, ent, comp);
    fields = (char **)ecs_get_mut_id(e->world, ent, comp);
    fields[0] = ecs_os_strdup(char0);
    fields[1] = ecs_os_strdup(bot0);
    fields[2] = ecs_os_strdup(char1);
    fields[3] = ecs_os_strdup(bot1);
    *(int32_t *)((char *)fields + 4 * sizeof(char *)) = seed_index;
    ecs_modified_id(e->world, ent, comp);
    return ent;
}

/* The CLI recipe, end to end, through the two engine entry points the REST
 * handlers call:
 *
 *   python3 tools/inject.py --template MbMatchRequest
 *   python3 tools/inject.py --entity MbMatchRequest_1 --set \
 *     'MbSpawnRequest: {char0: "billy", bot0: "house", char1: "puss", bot1: "chaos", seed_index: 3}'
 *
 * Two steps rather than one because POST /api/entities/spawn/:template hands
 * its raw JSON body to engine_entity_spawn's override parser, which reads YAML
 * only - PUT /api/entities/:id (entities_put_handler) is the path that parses
 * JSON components. That is a generic engine limitation, not a monkey-baiting
 * one; the second call is where the values actually land. */
TEST(the_request_template_spawns_and_takes_values) {
    Engine *e = start_engine(NULL);
    ecs_entity_t spawned;

    ASSERT_NOT_NULL(e);
    spawned = engine_entity_spawn(e, "MbMatchRequest", NULL);
    ASSERT(spawned != 0);

    /* Exactly what entities_put_handler does per component. */
    ASSERT(engine_entity_add_component(
        e, spawned, "MbSpawnRequest",
        "{\"char0\":\"billy\",\"bot0\":\"house\",\"char1\":\"puss\","
        "\"bot1\":\"chaos\",\"seed_index\":3}"));

    /* The values arrived, in the shape the REST GET reports them. */
    {
        char *got = engine_entity_get_component(e, spawned, "MbSpawnRequest");
        ASSERT_NOT_NULL(got);
        ASSERT_NOT_NULL(strstr(got, "seed_index: 3"));
        ASSERT_NOT_NULL(strstr(got, "char0: \"billy\""));
        free(got);
    }

    turn(e);
    {
        int count = 0;
        const MbResult *rows = mb_world_results(mb_engine_world(e), &count);
        /* Queued: a second result row exists, still unplayed. Its identity
         * columns are written at harvest, not at admission. */
        ASSERT_EQ(count, 2);
        ASSERT_EQ(rows[1].winner, -2);
    }
    engine_fini(e);
}

TEST(an_injected_spawn_request_queues_a_match) {
    Engine *e = start_engine(NULL);
    MbWorld *w;
    const MbResult *rows;
    int count = 0;

    ASSERT_NOT_NULL(e);
    w = mb_engine_world(e);
    ASSERT_NOT_NULL(w);
    ASSERT(ecs_lookup(e->world, "MbSpawnRequest") != 0);

    mb_world_results(w, &count);
    ASSERT_EQ(count, 1);   /* only the app.yaml match so far */

    ASSERT(inject_match(e, "inject1", "billy", "house", "puss", "chaos", 3) != 0);
    turn(e);   /* match_harvest drains it */

    rows = mb_world_results(w, &count);
    ASSERT_EQ(count, 2);
    /* Queued, not yet played, and behind the running match (batch is 1). */
    ASSERT_EQ(rows[1].winner, -2);
    /* The request entity is consumed. */
    ASSERT_EQ((int)ecs_lookup(e->world, "inject1"), 0);

    /* Both matches eventually play out, in canonical queue order. */
    ASSERT(run_until_harvested(e, 2, 400000) > 0);
    rows = mb_world_results(w, &count);
    ASSERT_EQ(count, 2);
    ASSERT(rows[0].winner != -2);
    ASSERT(rows[1].winner != -2);
    /* Entrant indices are first-appearance order: the injected pair is the
     * third and fourth distinct entrants seen. */
    ASSERT_EQ(rows[1].entrant0, 2);
    ASSERT_EQ(rows[1].entrant1, 3);
    ASSERT_EQ(rows[1].seed_index, 3);

    engine_fini(e);
}

TEST(an_injected_match_is_also_the_mb_sim_row) {
    MbRules rules;
    MbWorld *sim;
    MbPairing p;
    MbResult expect;
    const MbResult *rows;
    int count = 0;
    Engine *e;

    ASSERT(mb_rules_load(&rules, SANDBOX));
    ASSERT(pairing_for(&rules, "billy:house", "puss:chaos", 3, &p));
    /* mb_sim would see this pair as entrants 0 and 1 of its field; injected
     * into a host that has already interned two, they are 2 and 3. The row's
     * identity columns differ by construction, everything the SIMULATION
     * produces must not. */
    sim = mb_world_create(&rules, 1);
    ASSERT_NOT_NULL(sim);
    ASSERT(mb_world_set_queue(sim, &p, 1));
    ASSERT(mb_world_run(sim, 0, NULL));
    rows = mb_world_results(sim, &count);
    ASSERT_EQ(count, 1);
    expect = rows[0];
    mb_world_destroy(sim);
    ASSERT(expect.winner != -2);

    e = start_engine(NULL);
    ASSERT_NOT_NULL(e);
    ASSERT(inject_match(e, "inject1", "billy", "house", "puss", "chaos", 3) != 0);
    ASSERT(run_until_harvested(e, 2, 400000) > 0);
    rows = mb_world_results(mb_engine_world(e), &count);
    ASSERT_EQ(count, 2);

    ASSERT_EQ(rows[1].winner, expect.winner);
    ASSERT_EQ(rows[1].frames, expect.frames);
    ASSERT_EQ(rows[1].rounds, expect.rounds);
    ASSERT_EQ(rows[1].tie_rounds, expect.tie_rounds);
    ASSERT_EQ(rows[1].timeouts, expect.timeouts);
    ASSERT_EQ(rows[1].finishers, expect.finishers);
    ASSERT_EQ(rows[1].capped, expect.capped);
    ASSERT_EQ(rows[1].drawn, expect.drawn);
    ASSERT_EQ((int)rows[1].rng_state, (int)expect.rng_state);

    engine_fini(e);
}

TEST(a_bad_injection_refuses_and_is_consumed) {
    Engine *e = start_engine(NULL);
    int count = 0;

    ASSERT_NOT_NULL(e);
    /* "nosuchchar" is not on the roster: mb_rules_resolve_entrant refuses it
     * loudly and nothing is queued. */
    ASSERT(inject_match(e, "bad1", "nosuchchar", "house", "puss", "chaos", 0) != 0);
    turn(e);
    mb_world_results(mb_engine_world(e), &count);
    ASSERT_EQ(count, 1);
    ASSERT_EQ((int)ecs_lookup(e->world, "bad1"), 0);

    engine_fini(e);
}

/* --------------------------------------------------------------- restart */

TEST(a_second_app_start_rebuilds_the_batch) {
    Engine *e = start_engine(NULL);
    AppStartResult asr;
    MbWorld *second;
    ecs_entity_t clock_comp;
    const MbClock *clock;
    int i, count = 0;

    ASSERT_NOT_NULL(e);
    ASSERT_NOT_NULL(mb_engine_world(e));
    for (i = 0; i < 50; i++) turn(e);

    ASSERT(engine_app_start(e, NULL, &asr));
    second = mb_engine_world(e);
    ASSERT_NOT_NULL(second);
    ASSERT_EQ(mb_engine_harvested(e), 0);
    mb_world_results(second, &count);
    ASSERT_EQ(count, 1);

    /* A fresh batch, not the old one carried over: the match is back at
     * frame 0 even though 50 turns were stepped before the restart. */
    clock_comp = ecs_lookup(e->world, "MbClock");
    clock = (const MbClock *)ecs_get_id(e->world,
                                       ecs_lookup(e->world, "MbMatch0"), clock_comp);
    ASSERT_NOT_NULL(clock);
    ASSERT_EQ(clock->frame, 0);

    /* Exactly one match's worth of entities, not two: the old batch's
     * entities were deleted with it. */
    {
        EntityList list = engine_entity_list(e);
        int slots = 0;
        for (i = 0; i < list.count; i++)
            if (list.items[i].name && strncmp(list.items[i].name, "MbMatch", 7) == 0)
                slots++;
        engine_entity_list_free(&list);
        ASSERT_EQ(slots, 1);
    }
    engine_fini(e);
}

int main(void) {
    TEST_SUITE("monkey-baiting engine hosting (stage S6)");

    RUN(select_then_start_builds_a_hosted_world);
    RUN(the_slots_are_first_class_engine_entities);
    RUN(a_turn_is_a_frame);
    RUN(an_engine_hosted_match_is_the_mb_sim_row);
    RUN(hosting_is_deterministic_across_two_engines);
    RUN(a_named_config_selects_its_own_match);
    RUN(an_unknown_config_refuses_rather_than_defaulting);
    RUN(the_request_template_spawns_and_takes_values);
    RUN(an_injected_spawn_request_queues_a_match);
    RUN(an_injected_match_is_also_the_mb_sim_row);
    RUN(a_bad_injection_refuses_and_is_consumed);
    RUN(a_second_app_start_rebuilds_the_batch);

    TEST_RESULTS();
}
#!/usr/bin/env python3
"""Unit tests for mb_loop, the Python balance loop (architecture stage S5).

Stdlib only, no pip dependencies -- the same rule mb_driver follows. ctest
registers this as `test_mb_loop` and passes the freshly built mb_sim path in
`MB_SIM`; the handful of tests that actually drive the binary SKIP when it is
absent, so a source-only checkout still runs the rest.

Coverage, in the order the modules stack:

    yamlio      the parser's subset, its refusals, round-tripping, and a
                cross-check against PyYAML when PyYAML happens to be importable
    data        canonical load, overlay merge, path resolution, frame budget
    framedata   envelope violations and dominance over the real data
    tournament  roster resolution, aggregation, the issue vocabulary
    grammar     validation, every detector, and SCORING DETERMINISM
    patch       pins, the legal-patch verifier, overlay writing, apply
    emit        seeded emission: same seed -> byte-identical candidates
    solve       the per-pair model-hash gate
    archive     write/read/verify/rescore round trip

Run directly:  python3 sandboxes/monkey-baiting/tests/test_mb_loop.py
"""

from __future__ import annotations

import copy
import json
import os
import shutil
import sys
import tempfile
import traceback
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
SANDBOX = HERE.parent
ROOT = SANDBOX.parent.parent
sys.path.insert(0, str(SANDBOX / "tools"))

from mb_loop import archive, data as D, emit, framedata as F  # noqa: E402
from mb_loop import grammar as G, patch as P, solve as S      # noqa: E402
from mb_loop import tournament as T, yamlio                    # noqa: E402

GRAMMAR = SANDBOX / "data" / "balance-grammar.yaml"
PINS = SANDBOX / "data" / "balance-pins.yaml"
LEDGER = ROOT / "web" / "monkey-baiting" / "docs" / "balance.md"


def _mb_sim() -> Path | None:
    env = os.environ.get("MB_SIM")
    if env and Path(env).exists():
        return Path(env)
    for cand in ("build/local/Release/mb_sim.exe", "build/local/Debug/mb_sim.exe",
                 "build/local/mb_sim", "build/local/mb_sim.exe"):
        p = ROOT / cand
        if p.exists():
            return p
    return None


MB_SIM = _mb_sim()


class TestYamlIO(unittest.TestCase):
    def test_scalars_and_types(self) -> None:
        doc = yamlio.parse(
            "i: 3\nf: 1.5\nneg: -5.2\nexp: 1e3\nt: true\nfa: false\n"
            "n: null\ntil: ~\ns: hello world\nq: \"a: b\"\n")
        self.assertEqual(doc["i"], 3)
        self.assertIsInstance(doc["i"], int)
        self.assertEqual(doc["f"], 1.5)
        self.assertEqual(doc["neg"], -5.2)
        self.assertEqual(doc["exp"], 1000.0)
        self.assertIs(doc["t"], True)
        self.assertIs(doc["fa"], False)
        self.assertIsNone(doc["n"])
        self.assertIsNone(doc["til"])
        self.assertEqual(doc["s"], "hello world")
        self.assertEqual(doc["q"], "a: b")

    def test_apostrophe_in_plain_scalar_is_not_a_quote(self) -> None:
        # the failure mode this parser was actually bitten by: puss.yaml's
        # "THE CHAMPION'S BITCH" and comments like "Tom Cribb's dog"
        doc = yamlio.parse("name: THE CHAMPION'S BITCH   # Tom Cribb's dog\n")
        self.assertEqual(doc["name"], "THE CHAMPION'S BITCH")

    def test_hash_inside_quotes_and_colour_literal(self) -> None:
        doc = yamlio.parse('fur: "#7A6A55"   # a comment\nx: 1\n')
        self.assertEqual(doc["fur"], "#7A6A55")
        self.assertEqual(doc["x"], 1)

    def test_flow_collections(self) -> None:
        doc = yamlio.parse("hurtbox: {w: 24, h: 22}\narmor: [2, 18]\n"
                           "nested: {a: [1, 2], b: {c: 3}}\n")
        self.assertEqual(doc["hurtbox"], {"w": 24, "h": 22})
        self.assertEqual(doc["armor"], [2, 18])
        self.assertEqual(doc["nested"], {"a": [1, 2], "b": {"c": 3}})

    def test_block_sequence_of_maps(self) -> None:
        doc = yamlio.parse("pins:\n  - id: a\n    path: x\n  - id: b\n    path: y\n")
        self.assertEqual(doc["pins"], [{"id": "a", "path": "x"},
                                       {"id": "b", "path": "y"}])

    def test_folded_scalar(self) -> None:
        doc = yamlio.parse("summary: >\n  one two\n  three\nnext: 1\n")
        self.assertEqual(doc["summary"], "one two three\n")
        self.assertEqual(doc["next"], 1)

    def test_refusals_are_loud(self) -> None:
        for bad, why in [("a:\n\tb: 1\n", "tab"),
                         ("a: {b: 1\n", "unclosed flow"),
                         ("a: 1\na: 2\n", "duplicate key"),
                         ('a: "unterminated\n', "unterminated quote")]:
            with self.assertRaises(yamlio.YamlError, msg=why):
                yamlio.parse(bad, "<test>")

    def test_writer_round_trips(self) -> None:
        tree = {"moves": {"heavy": {"damage": 12, "armor_frames": [2, 18],
                                    "ratio": 0.5}}}
        self.assertEqual(yamlio.parse(yamlio.dumps(tree)), tree)

    def test_all_canonical_files_parse(self) -> None:
        for path in sorted((SANDBOX / "data").rglob("*.yaml")):
            self.assertIsInstance(yamlio.load(path), dict, str(path))
        self.assertIsInstance(yamlio.load(SANDBOX / "app.yaml"), dict)

    def test_agrees_with_pyyaml_when_available(self) -> None:
        """DRIFT GUARD. PyYAML is not on this fleet, which is why yamlio
        exists; if it ever arrives, disagreement must be a test failure."""
        try:
            import yaml  # type: ignore
        except ImportError:
            self.skipTest("PyYAML not importable (the reason yamlio exists)")
        for path in sorted((SANDBOX / "data").rglob("*.yaml")) + [SANDBOX / "app.yaml"]:
            text = path.read_text(encoding="utf-8")
            self.assertEqual(yamlio.parse(text, str(path)), yaml.safe_load(text),
                             f"yamlio disagrees with PyYAML on {path}")


class TestData(unittest.TestCase):
    def setUp(self) -> None:
        self.d = D.load_data(SANDBOX)

    def test_canonical_load(self) -> None:
        self.assertEqual(self.d.character_ids,
                         ["jacco", "brock", "billy", "puss", "aistrop"])
        self.assertIn("light", self.d.characters["jacco"]["moves"])
        self.assertIn("classes", self.d.balance)
        self.assertIn("table", self.d.bots)

    def test_qualified_path(self) -> None:
        self.assertEqual(
            D.qualified_path("data/characters/jacco.yaml", "moves.heavy.damage"),
            "characters.jacco.moves.heavy.damage")
        self.assertEqual(D.qualified_path("data/strategies.yaml", "default.x"),
                         "strategies.default.x")
        self.assertEqual(D.qualified_path("data/balance.yaml", "classes.heavy.damage_total"),
                         "balance.classes.heavy.damage_total")

    def test_resolve_and_set(self) -> None:
        root = self.d.as_root()
        found, value = D.resolve_path(root, "characters.jacco.moves.heavy.damage")
        self.assertTrue(found)
        self.assertEqual(value, 14)
        self.assertEqual(D.resolve_path(root, "characters.nope.x"), (False, None))
        clone = D.set_at_path(root, "characters.jacco.moves.heavy.damage", 11)
        self.assertEqual(clone["characters"]["jacco"]["moves"]["heavy"]["damage"], 11)
        self.assertEqual(root["characters"]["jacco"]["moves"]["heavy"]["damage"], 14)

    def test_overlay_merge(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            over = Path(tmp) / "cand"
            yamlio.dump(over / "data" / "characters" / "jacco.yaml",
                        {"moves": {"heavy": {"damage": 9}}})
            merged = D.load_data(SANDBOX, [over])
            self.assertEqual(merged.characters["jacco"]["moves"]["heavy"]["damage"], 9)
            # a sibling key of the merged leaf must survive the merge
            self.assertEqual(merged.characters["jacco"]["moves"]["heavy"]["hitstun"],
                             self.d.characters["jacco"]["moves"]["heavy"]["hitstun"])

    def test_frame_budget_is_derived_not_guessed(self) -> None:
        r = self.d.rules
        want = int(r["rounds"]["max_rounds_per_match"] *
                   (r["rounds"]["time_seconds"] * r["logic_hz"]
                    + r["rounds"]["intro_frames"] + r["rounds"]["end_frames"]
                    + r["combat"]["ko_slowmo_frames"]
                    + r["finisher"]["cinematic_frames"])) + 600
        self.assertEqual(D.frame_budget(r), want)


class TestFramedata(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.d = D.load_data(SANDBOX)
        cls.json = F.framedata_json(F.analyze(cls.d))

    def test_every_move_analysed(self) -> None:
        want = sum(len(self.d.characters[c]["moves"]) for c in self.d.character_ids)
        self.assertEqual(len(self.json["moves"]), want)

    def test_envelope_violation_wording(self) -> None:
        """The verifier compares violations by FIELD parsed out of this string
        and the emitter's flagged-param picker reads the same prefix, so the
        `<field>=<value> < <bound>` shape is contract, not cosmetics."""
        viol = [v for mv in self.json["moves"] for v in mv["envelopeViolations"]]
        self.assertTrue(viol, "the base data is expected to have violations")
        for v in viol:
            if "=" in v:
                field = v.split("=", 1)[0]
                self.assertIn(field, F._ENVELOPE_CHECKS)

    def test_dominance_is_a_fraction(self) -> None:
        for mv in self.json["moves"]:
            self.assertGreaterEqual(mv["dominance"], 0.0)
            self.assertLessEqual(mv["dominance"], 1.0)

    def test_deterministic(self) -> None:
        again = F.framedata_json(F.analyze(D.load_data(SANDBOX)))
        self.assertEqual(json.dumps(again, sort_keys=True),
                         json.dumps(self.json, sort_keys=True))


class TestRoster(unittest.TestCase):
    def setUp(self) -> None:
        self.d = D.load_data(SANDBOX)

    def test_no_perfect_roster_shape(self) -> None:
        r = T.build_roster(self.d, "no-perfect")
        moves = sum(len(self.d.characters[c]["moves"]) for c in self.d.character_ids)
        self.assertEqual(len(r), len(self.d.character_ids) * 3 + moves)
        self.assertEqual(len({e.sim_id for e in r}), len(r))
        self.assertEqual(len({e.id for e in r}), len(r))

    def test_labels_are_grammar_visible(self) -> None:
        r = T.build_roster(self.d, "no-perfect")
        labels = {e.label for e in r}
        self.assertIn("default", labels)
        self.assertIn("random", labels)
        self.assertIn("passive", labels)
        self.assertTrue(any(l.startswith("spam-") for l in labels))
        self.assertEqual(next(e for e in r if e.label == "default").bot, "house")

    def test_full_roster_adds_perfect(self) -> None:
        full = T.build_roster(self.d, "full")
        base = T.build_roster(self.d, "no-perfect")
        self.assertEqual(len(full), len(base) + len(self.d.character_ids))

    def test_spam_entrants_only_for_authored_moves(self) -> None:
        r = T.build_roster(self.d, "no-perfect")
        for e in r:
            if e.label.startswith("spam-"):
                key = e.label[len("spam-"):]
                self.assertIn(key, self.d.characters[e.char]["moves"])

    def test_unknown_mode_refused(self) -> None:
        with self.assertRaises(T.RosterError):
            T.build_roster(self.d, "nope")


class TestTournamentAggregation(unittest.TestCase):
    """Aggregation over synthesised rows -- no binary needed."""

    def setUp(self) -> None:
        self.d = D.load_data(SANDBOX)
        self.entrants = [T.Entrant("jacco", "house", "default"),
                         T.Entrant("brock", "house", "default"),
                         T.Entrant("jacco", "spam-heavy", "spam-heavy")]

    def _run(self, rows: list[dict]) -> T.TournamentResult:
        class FakeRun:
            record = {"oracle": {"rows": rows, "hash": "deadbeef"},
                      "sim_version": "mb-1",
                      "binary": {"path": "x", "mtime_utc": "", "size_bytes": 0},
                      "config": {"threads": 8, "threads_used": 8, "batch": 1,
                                 "partition": "round-robin", "perfect": None,
                                 "argv": []},
                      "non_oracle": {"wall_ms": 1.0}}
        return T.aggregate(self.d, self.entrants, FakeRun(), seeds=1)

    @staticmethod
    def _row(e0: int, e1: int, seed: int, winner: int, **kw) -> dict:
        row = {"entrant0": e0, "entrant1": e1, "seed_index": seed,
               "winner": winner, "frames": 100, "rounds": 2, "tie_rounds": 0,
               "timeouts": 0, "finishers": 0, "capped": 0, "drawn": 0}
        row.update(kw)
        return row

    def test_win_loss_and_head_to_head(self) -> None:
        res = self._run([self._row(0, 1, 1, 0), self._row(1, 0, 2, 0)])
        self.assertEqual(res.stats["jacco/default"]["wins"], 1)
        self.assertEqual(res.stats["brock/default"]["wins"], 1)
        self.assertEqual(res.head["jacco/default"]["brock/default"],
                         {"w": 1, "n": 2})

    def test_draw_and_cap_both_count_as_no_decision(self) -> None:
        res = self._run([self._row(0, 1, 1, -1, drawn=1),
                         self._row(0, 1, 2, -1, capped=1)])
        self.assertEqual(res.stats["jacco/default"]["draws"], 2)
        self.assertEqual(res.stats["jacco/default"]["capped"], 1)
        self.assertEqual(len(res.drawn_matches), 1)
        self.assertEqual(len(res.capped_matches), 1)
        self.assertTrue(any(i.startswith("FRAME CAP:") for i in res.issues))

    def test_degenerate_issue_fires(self) -> None:
        res = self._run([self._row(0, 2, 1, 1), self._row(2, 0, 2, 0)])
        self.assertTrue(any(i.startswith("DEGENERATE: jacco/spam-heavy")
                            for i in res.issues), res.issues)

    def test_timeout_issue_band(self) -> None:
        res = self._run([self._row(0, 1, 1, 0, rounds=4, timeouts=3)])
        self.assertTrue(any(i.startswith("TIMEOUTS:") for i in res.issues))

    def test_round_half_up_matches_js(self) -> None:
        self.assertEqual(T.round_half_up(0.5), 1)
        self.assertEqual(T.round_half_up(1.5), 2)
        self.assertEqual(T.round_half_up(2.5), 3)
        self.assertEqual(T.round_half_up(-0.5), 0)


class TestGrammar(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.G = G.load_grammar(GRAMMAR)
        cls.md = LEDGER.read_text(encoding="utf-8")

    def test_canonical_grammar_validates(self) -> None:
        errors: list[str] = []
        ids = G.validate_grammar(self.G, G.findings_dates(self.md), errors)
        self.assertEqual(errors, [])
        self.assertEqual(len(ids["situations"]), 13)
        self.assertEqual(len(ids["strategies"]), 13)

    def test_ledger_citations_resolve(self) -> None:
        errors: list[str] = []
        ids = G.validate_grammar(self.G, None, errors)
        lerrors: list[str] = []
        L = G.validate_ledger(self.md, ids, lerrors)
        self.assertEqual(lerrors, [])
        self.assertGreater(L["entries"], 0)

    def test_ledger_without_citation_fails(self) -> None:
        errors: list[str] = []
        ids = G.validate_grammar(self.G, None, errors)
        bad = "## 5. Ledger\n\n### 2026-01-01 -- something\n- no citation here\n\n## 6. x\n"
        lerrors: list[str] = []
        G.validate_ledger(bad, ids, lerrors)
        self.assertTrue(any("no \"strategy: <id>\" citation" in e for e in lerrors))

    def test_unknown_source_is_legal_but_undetectable(self) -> None:
        g = copy.deepcopy(self.G)
        g["situations"][0]["detect"] = [{"source": "moveset-telemetry",
                                         "pattern": {"anything": 1}}]
        errors: list[str] = []
        G.validate_grammar(g, None, errors)
        self.assertEqual(errors, [])
        r = G.detect(g["situations"][0]["detect"][0], {})
        self.assertIn("no detector", r["unavailable"])

    def test_malformed_fields_are_refused(self) -> None:
        cases = [
            ("band", lambda g: g["situations"][0]["detect"][1]["pattern"].update(
                {"band": [55, 45]})),
            ("layer", lambda g: g["strategies"][2]["lever"].update({"layer": "nope"})),
            ("weight", lambda g: g["scoring"]["weights"].update({"not-a-situation": 1})),
            ("patch file", lambda g: g["strategies"][2]["patch"].update(
                {"file": "elsewhere/x.yaml"})),
        ]
        for name, mutate in cases:
            g = copy.deepcopy(self.G)
            mutate(g)
            errors: list[str] = []
            G.validate_grammar(g, None, errors)
            self.assertTrue(errors, f"{name} should have failed validation")

    def test_model_fix_is_weight_zero(self) -> None:
        """Oracle integrity: a model defect gates perfect-derived signals, it is
        never a number the loop can improve by moving character data."""
        self.assertEqual(self.G["scoring"]["weights"]["must-not-lose-failure"], 0)
        self.assertEqual(self.G["scoring"]["weights"]["design-constraint-adoption"], 0)
        for sid in ("model-fix", "design-constraint", "triage-resolution",
                    "inner-solve-first", "timer-standoff", "stalemate-break"):
            st = next(s for s in self.G["strategies"] if s["id"] == sid)
            self.assertIsNone(st["patch"], f"{sid} must never emit a data patch")

    def test_detectors_over_a_synthetic_report(self) -> None:
        report = {
            "entrants": [
                {"id": "a/default", "char": "a", "label": "default"},
                {"id": "b/default", "char": "b", "label": "default"},
                {"id": "a/spam-heavy", "char": "a", "label": "spam-heavy"},
                {"id": "b/spam-heavy", "char": "b", "label": "spam-heavy"},
            ],
            "stats": {"a/default": {"wins": 9, "losses": 1},
                      "b/default": {"wins": 1, "losses": 9},
                      "a/spam-heavy": {"wins": 10, "losses": 0},
                      "b/spam-heavy": {"wins": 0, "losses": 10}},
            "head": {"a/default": {"b/default": {"w": 9, "n": 10},
                                   "a/spam-heavy": {"w": 0, "n": 0},
                                   "b/spam-heavy": {"w": 0, "n": 0}},
                     "b/default": {"a/default": {"w": 1, "n": 10},
                                   "a/spam-heavy": {"w": 0, "n": 0},
                                   "b/spam-heavy": {"w": 0, "n": 0}},
                     "a/spam-heavy": {"b/spam-heavy": {"w": 4, "n": 4},
                                      "a/default": {"w": 0, "n": 0},
                                      "b/default": {"w": 0, "n": 0}},
                     "b/spam-heavy": {"a/spam-heavy": {"w": 0, "n": 4},
                                      "a/default": {"w": 0, "n": 0},
                                      "b/default": {"w": 0, "n": 0}}},
            "issues": ["DEGENERATE: a/spam-heavy beats its own default 100% (4 decided)",
                       "TIMEOUTS: b/default 40% of rounds end on the watch (band <=20%)"],
        }
        ctx = {"report": report, "framedata": None, "board": T.spam_board(report)}
        by_source = {"tournament-issues": {"category": "DEGENERATE"},
                     "spam-parity": {"band": [45, 55], "direction": "above"},
                     "standings-bands": {"metric": "default-matchup", "band": [25, 75]}}
        hits = {src: G.detect({"source": src, "pattern": pat}, ctx)["hits"]
                for src, pat in by_source.items()}
        self.assertEqual(len(hits["tournament-issues"]), 1)
        self.assertEqual(hits["spam-parity"],
                         ["a/spam-heavy spam parity 100% (beats 100% of 1 other spam bots)"])
        self.assertEqual(len(hits["standings-bands"]), 1)

    def test_framedata_envelope_detector(self) -> None:
        d = D.load_data(SANDBOX)
        fj = F.framedata_json(F.analyze(d))
        r = G.detect({"source": "framedata-envelope",
                      "pattern": {"min_violations": 1, "field": "any"}},
                     {"framedata": fj})
        self.assertTrue(r["hits"])

    def test_scoring_determinism(self) -> None:
        """Same inputs -> identical score, twice, from independent loads."""
        d = D.load_data(SANDBOX)
        fj = F.framedata_json(F.analyze(d))
        report = {"entrants": [], "stats": {}, "head": {}, "issues": []}
        ctx = {"report": report, "framedata": fj, "board": []}
        a = G.analyze(G.load_grammar(GRAMMAR), ctx)
        b = G.analyze(G.load_grammar(GRAMMAR), dict(ctx))
        self.assertEqual(a["score"], b["score"])
        self.assertEqual(json.dumps(G.per_situation(a), sort_keys=True),
                         json.dumps(G.per_situation(b), sort_keys=True))

    def test_manual_and_unavailable_are_not_scored(self) -> None:
        A = G.analyze(self.G, {"report": None, "framedata": None, "board": []})
        for s in A["situations"]:
            if s["manual"] or s["unavailable"]:
                self.assertIsNone(s["subscore"], s["id"])


class TestPatchVerifier(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.d = D.load_data(SANDBOX)
        cls.pins = P.load_pins(PINS)

    def _patch(self, **kw) -> dict:
        edit = {"file": "data/characters/jacco.yaml", "path": "moves.heavy.damage",
                "before": 14, "after": 13, "envelope": [8, 16], "direction": "toward-envelope"}
        edit.update(kw.pop("edit", {}))
        p = {"schema": "mb-patch/2", "id": "p-0001", "grammar_version": 3,
             "situation": "degenerate-spam-dominance", "strategy": "single-button-value",
             "signal": "x", "layer": "move-param", "edits": [edit],
             "solver_relevant": True,
             "rng": {"seed": 1, "stream": "s", "draws": [0.1]},
             "emitted_at": "2026-07-30T00:00:00Z",
             "lineage": {"parent_round": None, "height": None, "lineage_id": None}}
        p.update(kw)
        return p

    def test_pins_load(self) -> None:
        self.assertEqual(self.pins["version"], 1)
        self.assertEqual(len(self.pins["pins"]), 47)

    def test_a_legal_patch_passes(self) -> None:
        self.assertEqual(P.verify(self._patch(), self.d, self.pins), [])

    def test_pinned_location_is_rejected(self) -> None:
        p = self._patch(edit={"path": "max_health", "before": 100, "after": 105,
                              "envelope": None})
        reasons = P.verify(p, self.d, self.pins)
        self.assertTrue(any(r.startswith("pinned:") for r in reasons), reasons)

    def test_pin_matches_descendants_and_wildcard(self) -> None:
        edit = {"file": "data/characters/jacco.yaml", "path": "moves.heavy.damage"}
        self.assertTrue(P.pin_matches(edit, {"file": "data/characters/jacco.yaml",
                                             "path": "*"}))
        self.assertTrue(P.pin_matches(edit, {"file": "data/characters/jacco.yaml",
                                             "path": "moves.heavy"}))
        self.assertFalse(P.pin_matches(edit, {"file": "data/characters/jacco.yaml",
                                              "path": "moves.light"}))
        self.assertFalse(P.pin_matches(edit, {"file": "data/characters/brock.yaml",
                                              "path": "*"}))

    def test_new_envelope_violation_is_rejected(self) -> None:
        p = self._patch(edit={"after": 99})
        reasons = P.verify(p, self.d, self.pins)
        self.assertTrue(any(r.startswith("envelope:") for r in reasons), reasons)

    def test_preexisting_violation_is_tolerated_when_the_field_still_violates(self) -> None:
        """brock/heavy already violates startup_frames; moving it within the
        violation must not be reported as a NEW violation."""
        p = self._patch(edit={"file": "data/characters/brock.yaml",
                              "path": "moves.heavy.startup_frames",
                              "before": 6, "after": 7, "envelope": [10, 36]})
        reasons = [r for r in P.verify(p, self.d, self.pins) if r.startswith("envelope:")]
        self.assertEqual(reasons, [])

    def test_schema_failures(self) -> None:
        cases = {
            "unknown file": {"file": "data/nope.yaml"},
            "missing leaf": {"path": "moves.heavy.not_a_field"},
            "map leaf": {"path": "moves.heavy.hitbox", "before": {}, "after": {"x": 1}},
            "no-op": {"after": 14},
            "type change": {"after": "13"},
        }
        for name, mutation in cases.items():
            reasons = P.verify(self._patch(edit=mutation), self.d, self.pins)
            self.assertTrue(any(r.startswith("schema:") for r in reasons),
                            f"{name}: {reasons}")

    def test_layer_restriction(self) -> None:
        reasons = P.verify(self._patch(layer="class-envelope"), self.d, self.pins)
        self.assertTrue(any(r.startswith("layer:") for r in reasons))

    def test_solver_relevant_rule(self) -> None:
        self.assertTrue(P.solver_relevant([{"file": "data/characters/jacco.yaml"}]))
        for f in ("data/strategies.yaml", "data/bots.yaml", "data/balance.yaml"):
            self.assertFalse(P.solver_relevant([{"file": f}]), f)

    def test_manifest_schema(self) -> None:
        self.assertEqual(P.validate_manifest_schema(self._patch()), [])
        bad = self._patch()
        del bad["rng"]
        self.assertTrue(P.validate_manifest_schema(bad))

    def test_overlay_tree_and_file(self) -> None:
        tree = P.build_overlay_tree("data/characters/jacco.yaml",
                                    "moves.heavy.damage", 13)
        self.assertEqual(tree, {"moves": {"heavy": {"damage": 13}}})
        self.assertEqual(P.build_overlay_tree("data/strategies.yaml",
                                              "passive.params.block_chance", 0.4),
                         {"strategies": {"passive": {"params": {"block_chance": 0.4}}}})

    def test_replace_leaf_preserves_comments_and_indent(self) -> None:
        text = "moves:\n  heavy:\n    damage: 14          # a comment\n"
        out = P.replace_leaf(text, "moves.heavy.damage", 11)
        self.assertIsNone(out.get("error"))
        self.assertEqual(out["text"],
                         "moves:\n  heavy:\n    damage: 11          # a comment\n")

    def test_replace_leaf_refuses_a_non_scalar_line(self) -> None:
        text = "moves:\n  heavy:\n    hitbox: {x: 1}\n"
        self.assertIn("error", P.replace_leaf(text, "moves.heavy.hitbox", 5))
        self.assertIn("error", P.replace_leaf(text, "moves.heavy.nope", 5))


class TestEmitter(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.d = D.load_data(SANDBOX)
        cls.G = G.load_grammar(GRAMMAR)
        cls.pins = P.load_pins(PINS)
        cls.framedata = F.framedata_json(F.analyze(cls.d))
        cls.report = _synthetic_report()

    def _emit(self, seed: int, out: Path, count: int = 4):
        return emit.emit_candidates(
            grammar=self.G, data=self.d, pins=self.pins, report=self.report,
            framedata=self.framedata, seed=seed, out_dir=out, count=count)

    def test_same_seed_is_byte_identical(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            a = self._emit(7, Path(tmp) / "a")
            b = self._emit(7, Path(tmp) / "b")
            self.assertTrue(a.patches, "expected the synthetic report to emit")
            self.assertEqual(_strip_volatile(a.patches), _strip_volatile(b.patches))
            self.assertEqual(_tree_bytes(Path(tmp) / "a"), _tree_bytes(Path(tmp) / "b"))

    def test_different_seed_differs(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            a = self._emit(7, Path(tmp) / "a")
            b = self._emit(8, Path(tmp) / "b")
            self.assertNotEqual(_strip_volatile(a.patches), _strip_volatile(b.patches))

    def test_every_emitted_candidate_is_legal(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            r = self._emit(11, Path(tmp) / "a", count=8)
            for p in r.patches:
                self.assertEqual(P.verify(p, self.d, self.pins), [], p["id"])
                self.assertEqual(P.validate_manifest_schema(p), [])

    def test_rng_draws_are_recorded(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            r = self._emit(3, Path(tmp) / "a")
            for p in r.patches:
                self.assertIsInstance(p["rng"]["draws"], list)
                self.assertEqual(p["rng"]["seed"], 3)

    def test_pinned_targets_are_never_emitted(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            r = self._emit(5, Path(tmp) / "a", count=12)
            for p in r.patches:
                for e in p["edits"]:
                    for pin in self.pins["pins"]:
                        self.assertFalse(P.pin_matches(e, pin),
                                         f"{p['id']} hit pin {pin['id']}")

    def test_mulberry32_matches_the_reference_stream(self) -> None:
        """The emitter's RNG is the same mulberry32 the simulator and solver
        use; a stream change silently re-keys every archived candidate."""
        rng = emit.mulberry32(emit.fnv1a("mb-loop"))
        draws = [round(rng(), 12) for _ in range(3)]
        self.assertEqual(len(draws), 3)
        rng2 = emit.mulberry32(emit.fnv1a("mb-loop"))
        self.assertEqual([round(rng2(), 12) for _ in range(3)], draws)
        self.assertNotEqual(draws[0], draws[1])
        self.assertTrue(all(0.0 <= d < 1.0 for d in draws))


class TestSolveGate(unittest.TestCase):
    def test_changed_pairs_needs_both_hash_and_version(self) -> None:
        now = {"a-vs-b": "1", "b-vs-c": "2"}
        self.assertEqual(S.changed_pairs(now, None, "v", None),
                         ["a-vs-b", "b-vs-c"])
        self.assertEqual(S.changed_pairs(now, now, "v", "v"), [])
        self.assertEqual(S.changed_pairs(now, {"a-vs-b": "9", "b-vs-c": "2"}, "v", "v"),
                         ["a-vs-b"])
        # a different solver version invalidates every pair, however unchanged
        self.assertEqual(S.changed_pairs(now, now, "v2", "v"), ["a-vs-b", "b-vs-c"])
        self.assertEqual(S.changed_pairs(now, now, None, None), ["a-vs-b", "b-vs-c"])

    def test_pair_key_and_pairs_of(self) -> None:
        self.assertEqual(S.pair_key("a", "b"), "a-vs-b")
        self.assertEqual(S.pairs_of(["a", "b"]),
                         [("a", "a"), ("a", "b"), ("b", "b")])

    def test_model_sha_of_dir(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            d = Path(tmp)
            (d / "model-a-vs-b.arr.bin").write_bytes(b"\x01\x02")
            manifest = {"arrays": {"arr": {"file": "model-a-vs-b.arr.bin",
                                           "dtype": "Int32Array", "length": 1}}}
            (d / "model-a-vs-b.json").write_text(json.dumps(manifest))
            first = S.model_sha_from_dir(d, "a-vs-b")
            self.assertEqual(len(first), 64)
            self.assertEqual(S.model_sha_from_dir(d, "a-vs-b"), first)
            (d / "model-a-vs-b.arr.bin").write_bytes(b"\x01\x03")
            self.assertNotEqual(S.model_sha_from_dir(d, "a-vs-b"), first)

    def test_backend_profiles_are_cold(self) -> None:
        for name, prof in S.SOLVE_PROFILES.items():
            if prof is None:
                continue
            self.assertIn("gap_step", prof)
            self.assertIn("fq", prof)
        argv = S.solve_argv("py", Path("m"), Path("p"), "coarse", ["a-vs-b"],
                            backend="numpy")
        self.assertNotIn("--resume", argv)
        self.assertIn("--pairs", argv)


class TestArchive(unittest.TestCase):
    def test_write_read_verify_rescore(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            out = Path(tmp) / "run-1"
            h = archive.open_run(out, _run_meta())
            base_score = _score_obj(10, None, None, "base", 0, None)
            archive.write_base(h, {"tournament": _tiny_report(), "framedata": {"moves": [], "pairs": []},
                                   "score": base_score, "overlay_dirs": []})
            ref = archive.write_round(h, {
                "patch": {"schema": "mb-patch/2", "id": "p-0001", "strategy": "s",
                          "edits": [{"file": "f", "path": "p", "before": 1, "after": 2}]},
                "patch_dir": None,
                "tournament": _tiny_report(), "framedata": {"moves": [], "pairs": []},
                "score": _score_obj(8, 10, -2, "accept", 1, None)})
            archive.finalize(h, {
                "stack": {"schema": "mb-stack/2", "grammar_version": 3,
                          "heights": [{"height": 0, "round": None, "score": 10,
                                       "patch": None, "strategy": None},
                                      {"height": 1, "round": ref, "score": 8,
                                       "patch": "p-0001", "strategy": "s"}],
                          "accepted": [ref], "final_score": 8, "applied": False},
                "ledger": "### x\n- strategy: s\n", "status": "complete"})

            self.assertEqual(archive.verify(out), [])
            read = archive.read_run(out)
            self.assertEqual(read["run"]["status"], "complete")
            self.assertEqual(len(read["rounds"]), 1)
            self.assertEqual(read["stack"]["final_score"], 8)

            r = archive.rescore(out, GRAMMAR)
            self.assertEqual(r["base"]["new_score"], r["rounds"][0]["new_parent_score"])

    def test_verify_catches_a_bad_accept(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            out = Path(tmp) / "run-2"
            h = archive.open_run(out, _run_meta())
            archive.write_base(h, {"tournament": _tiny_report(),
                                   "framedata": {"moves": [], "pairs": []},
                                   "score": _score_obj(10, None, None, "base", 0, None),
                                   "overlay_dirs": []})
            archive.write_round(h, {
                "patch": {"schema": "mb-patch/2", "id": "p-0001", "strategy": "s",
                          "edits": []},
                "patch_dir": None,
                "tournament": _tiny_report(), "framedata": {"moves": [], "pairs": []},
                "score": _score_obj(10, 10, 0, "accept", 1, None)})
            archive.finalize(h, {"stack": {"schema": "mb-stack/2", "heights": [],
                                           "accepted": [], "final_score": 10,
                                           "applied": False, "grammar_version": 3},
                                 "ledger": "", "status": "complete"})
            failures = archive.verify(out)
            self.assertTrue(any("strict improvement" in f for f in failures), failures)

    def test_equal_height_archive(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            arch = archive.HeightArchive(Path(tmp) / "archive.json")
            self.assertTrue(arch.better_than(1, 10))
            arch.record(1, 10, "run-a", "0001")
            self.assertFalse(arch.better_than(1, 10))   # equal never survives
            self.assertFalse(arch.better_than(1, 11))
            self.assertTrue(arch.better_than(1, 9))
            arch.record(1, 9, "run-b", "0002")
            arch.save()
            again = archive.HeightArchive(Path(tmp) / "archive.json")
            self.assertEqual(again.best_at(1)["score"], 9)
            self.assertEqual(again.best_at(1)["run_id"], "run-b")


class TestStaging(unittest.TestCase):
    """The bug this module exists to prevent: mb_sim reads the sandbox from
    DISK, so a candidate that is only merged in memory gets scored against the
    committed data and every round comes back score-neutral."""

    def test_stage_is_complete_and_edited(self) -> None:
        from mb_loop import stage
        with tempfile.TemporaryDirectory() as tmp:
            dest = Path(tmp) / "stage"
            edits = [{"file": "data/characters/jacco.yaml",
                      "path": "moves.heavy.damage", "before": 14, "after": 7}]
            stage.stage_sandbox(SANDBOX, edits, dest)
            # everything mb_sim's rules loader opens must be there
            for rel in ("app.yaml", "data/strategies.yaml", "data/bots.yaml",
                        "data/characters/jacco.yaml", "data/roster.yaml"):
                self.assertTrue((dest / rel).exists(), rel)
            staged = D.load_data(dest)
            self.assertEqual(staged.characters["jacco"]["moves"]["heavy"]["damage"], 7)
            # ... and the canonical data is untouched
            self.assertEqual(
                D.load_data(SANDBOX).characters["jacco"]["moves"]["heavy"]["damage"], 14)

    def test_stage_preserves_comments(self) -> None:
        from mb_loop import stage
        with tempfile.TemporaryDirectory() as tmp:
            dest = Path(tmp) / "stage"
            stage.stage_sandbox(SANDBOX, [{"file": "data/characters/jacco.yaml",
                                           "path": "moves.heavy.damage",
                                           "before": 14, "after": 7}], dest)
            text = (dest / "data" / "characters" / "jacco.yaml").read_text(
                encoding="utf-8")
            self.assertIn("# light: takes bigger knockback", text)
            self.assertIn("damage: 7", text)

    def test_stage_refuses_an_unappliable_edit(self) -> None:
        from mb_loop import stage
        with tempfile.TemporaryDirectory() as tmp:
            with self.assertRaises(stage.StageError):
                stage.stage_sandbox(SANDBOX, [{"file": "data/characters/jacco.yaml",
                                               "path": "moves.heavy.hitbox",
                                               "before": 1, "after": 2}],
                                    Path(tmp) / "stage")

    def test_stage_replaces_a_stale_directory(self) -> None:
        from mb_loop import stage
        with tempfile.TemporaryDirectory() as tmp:
            dest = Path(tmp) / "stage"
            stage.stage_sandbox(SANDBOX, [], dest)
            (dest / "STALE").write_text("x", encoding="ascii")
            stage.stage_sandbox(SANDBOX, [], dest)
            self.assertFalse((dest / "STALE").exists())


class TestComparability(unittest.TestCase):
    def test_key_covers_every_gate(self) -> None:
        run = {"sim": {"sim_version": "mb-1"},
               "grammar": {"version": 3, "sha": "g"},
               "pins": {"sha": "p"},
               "roster": {"mode": "full", "entrant_count": 36},
               "knobs": {"eval_seeds": 4},
               "solve": {"profile": "coarse", "solver_version": "3-cuda-cast",
                         "solver_backend": {"device": "cuda"}}}
        key = archive.comparability_key(run)
        for field_name in ("sim_version", "grammar_version", "pins_sha",
                           "roster_mode", "eval_seeds", "solver_version",
                           "solver_backend"):
            self.assertIn(field_name, key)
        self.assertEqual(key["sim_version"], "mb-1")
        self.assertEqual(key["solver_version"], "3-cuda-cast")

    def test_incomparable_archive_is_not_consulted(self) -> None:
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "archive.json"
            a = archive.HeightArchive(path, key={"sim_version": "mb-1"})
            a.record(1, 5, "run-a", "0001")
            a.save()
            b = archive.HeightArchive(path, key={"sim_version": "mb-2"})
            self.assertIsNone(b.best_at(1))
            self.assertTrue(b.better_than(1, 99),
                            "a champion under another sim_version must not prune")


class TestSearchLoop(unittest.TestCase):
    """The control flow, against a stubbed evaluator -- no simulation."""

    def setUp(self) -> None:
        from mb_loop import search
        self.search = search

    def _run(self, scores: list[float], knobs: dict, per_depth: int = 2):
        seq = list(scores)
        log: list[str] = []
        state_log: list[tuple[int, str]] = []

        def emit_fn(state):
            return [{"id": f"d{state.depth}v{state.visit}c{i}"} for i in range(per_depth)]

        def evaluate(cand, state):
            state_log.append((state.depth, cand["id"]))
            return {"score": seq.pop(0) if seq else 99.0}

        def record(cand, state, score, verdict, delta):
            log.append(f"{verdict}@{state.depth}")
            return f"{len(log):04d}"

        return self.search.search_loop(
            knobs, base_score=10.0,
            io=self.search.SearchIO(emit=emit_fn, evaluate=evaluate, record=record),
        ), log, state_log

    def test_strict_improvement_only(self) -> None:
        knobs = {"failure_budget": 1, "max_depth": 1, "candidates_per_depth": 2,
                 "run_patience": 5, "eval_seeds": 1}
        r, log, _ = self._run([10.0], knobs)     # equal -> reject
        self.assertEqual(log[0], "reject@0")

    def test_accept_descends(self) -> None:
        knobs = {"failure_budget": 3, "max_depth": 2, "candidates_per_depth": 2,
                 "run_patience": 5, "eval_seeds": 1}
        r, log, states = self._run([9.0, 8.0], knobs)
        self.assertEqual(log[:2], ["accept@0", "accept@1"])
        self.assertEqual(r.end_reason, "max_depth 2 reached")
        self.assertEqual([h.score for h in r.heights], [10.0, 9.0, 8.0])

    def test_failure_budget_backs_out(self) -> None:
        knobs = {"failure_budget": 2, "max_depth": 8, "candidates_per_depth": 3,
                 "run_patience": 5, "eval_seeds": 1}
        r, log, _ = self._run([9.0, 20.0, 20.0], knobs)
        self.assertIn("backout", [e["kind"] for e in r.events])
        self.assertEqual([h.height for h in r.heights], [0])

    def test_depth_zero_backout_ends_the_run(self) -> None:
        knobs = {"failure_budget": 1, "max_depth": 8, "candidates_per_depth": 2,
                 "run_patience": 5, "eval_seeds": 1}
        r, _, _ = self._run([20.0], knobs)
        self.assertIn("at depth 0", r.end_reason)

    def test_round_cap_is_bounded(self) -> None:
        knobs = {"failure_budget": 99, "max_depth": 0, "candidates_per_depth": 2,
                 "run_patience": 5, "eval_seeds": 1}
        r, _, _ = self._run([], knobs)
        self.assertLessEqual(r.rounds, r.round_cap)

    def test_visit_counter_advances_rng_stream(self) -> None:
        knobs = {"failure_budget": 1, "max_depth": 8, "candidates_per_depth": 1,
                 "run_patience": 5, "eval_seeds": 1}
        r, log, states = self._run([9.0, 20.0, 9.5], knobs, per_depth=1)
        # accept to depth 1, fail there, back out to depth 0 with visit 1
        self.assertTrue(any(cid.startswith("d0v1") for _, cid in states), states)


@unittest.skipIf(MB_SIM is None, "mb_sim binary not built")
class TestAgainstTheSimulator(unittest.TestCase):
    """The few tests that actually drive the C simulator."""

    @classmethod
    def setUpClass(cls) -> None:
        cls.d = D.load_data(SANDBOX)
        cls.roster = T.build_roster(cls.d, "no-perfect")[:6]

    def test_tournament_runs_and_is_repeatable(self) -> None:
        a = T.run_tournament(self.d, self.roster, seeds=2, binary=MB_SIM)
        b = T.run_tournament(self.d, self.roster, seeds=2, binary=MB_SIM)
        self.assertEqual(a.record["oracle"]["hash"], b.record["oracle"]["hash"])
        self.assertEqual(T.tournament_json(a), T.tournament_json(b))

    def test_scoring_is_deterministic_end_to_end(self) -> None:
        Gr = G.load_grammar(GRAMMAR)
        fj = F.framedata_json(F.analyze(self.d))
        scores = []
        for _ in range(2):
            res = T.run_tournament(self.d, self.roster, seeds=2, binary=MB_SIM)
            tj = T.tournament_json(res)
            scores.append(G.analyze(Gr, {"report": tj, "framedata": fj,
                                         "board": T.spam_board(tj)})["score"])
        self.assertEqual(scores[0], scores[1])

    def test_sim_version_is_stamped(self) -> None:
        res = T.run_tournament(self.d, self.roster, seeds=1, binary=MB_SIM)
        self.assertTrue(res.record["sim_version"])
        self.assertEqual(T.tournament_json(res)["sim"]["sim_version"],
                         res.record["sim_version"])


