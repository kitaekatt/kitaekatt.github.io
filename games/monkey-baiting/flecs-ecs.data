# MONKEY BAITING -- balance class envelopes (analysis targets, NOT runtime
# tuning). Every move belongs to a class -- its moveset slot (light / heavy /
# special) or "extra" for additional input-mapped moves (e.g. Aistrop's
# STAKES DOWN). The envelope is the min/max box a move's parameters should
# live in while it is tuned toward the spam-parity target (~50% of the other
# spam bots beaten head-to-head). Parity of OUTCOME, not homogeneity of
# NUMBERS: two 50% moves should get there by different shapes (reach vs speed
# vs armor vs damage). framedata.js reports each move's position in its
# envelope and flags out-of-envelope values.
#
# damage_total = damage x hits (multi-hit) or the full grab/hold damage.
# cancel_allowed / cancel_window_max: which classes may carry a `cancel:`
# block (the dormant animation-cancel mechanic) and the longest window
# a tuning pass may give them.
#
# CANONICAL LOCATION (2026-07-30, architecture S5 data single-sourcing): moved
# here from `web/monkey-baiting/data/balance.yaml`. Only the analysis layer
# ever read it (never the shipped game's runtime), so the move is complete:
# `web/monkey-baiting/data.js` no longer loads it.

classes:
  light:
    startup_frames: [4, 10]
    active_frames: [2, 6]
    recovery_frames: [6, 14]
    damage_total: [3, 7]
    base_knockback: [0.8, 1.6]
    hitstun: [10, 18]
    cooldown: [0, 0]
    cancel_allowed: true
    cancel_window_max: 8

  heavy:
    startup_frames: [10, 36]
    active_frames: [4, 60]
    recovery_frames: [10, 26]
    damage_total: [8, 16]
    base_knockback: [0.0, 3.0]
    hitstun: [12, 36]
    cooldown: [0, 360]
    cancel_allowed: false
    cancel_window_max: 0

  special:
    startup_frames: [6, 26]
    active_frames: [1, 50]
    recovery_frames: [16, 36]
    damage_total: [0, 18]
    base_knockback: [0.0, 3.2]
    hitstun: [0, 30]
    cooldown: [90, 560]
    cancel_allowed: true
    cancel_window_max: 12

  extra:
    startup_frames: [8, 40]
    active_frames: [2, 160]
    recovery_frames: [12, 30]
    damage_total: [0, 12]
    base_knockback: [0.0, 2.0]
    hitstun: [0, 20]
    cooldown: [240, 720]
    cancel_allowed: false
    cancel_window_max: 0
# MONKEY BAITING -- BOTS: pure data over the strategies.
#
# Ported from web/monkey-baiting/data/bots.yaml. A bot is a table of
# {strategy: weight} entries. An entry may carry a proximity gate:
#   spam-heavy: {weight: 5, within: reach}    # or a numeric gap; beyond: N
# meaning that component only decides when in range ("so the spam bot doesn't
# spam the air"). Gated entries are filtered per decision; if nothing is
# eligible the heaviest UNGATED entry decides -- every bot must have at least
# one ungated entry (validated at load, fails loud).
#
# WEIGHTS ARE POSITIVE INTEGERS. The JS reference multiplied a float RNG draw
# by a float total; the C port draws a uniform integer in [0, sum(weights))
# and walks the prefix sums, which is exact and platform-independent. A
# non-integer or non-positive weight is a load error, not a rounding.
#
# spam-<move> resolves per character against that character's move keys
# (light / heavy / special / stakes_down); a bot referencing a move the
# character does not author is a load error for that entrant.
#
# `perfect` plays a solved policy per ORDERED character pair. A bot that can
# roll it resolves ONLY when every policy file its pairings need is present
# and valid (mb_sim --perfect DIR); otherwise the entrant is refused loudly,
# never demoted to another strategy.

bots:
  hold_frames: 10            # frames a rolled component decides for

  table:
    house:                   # the shipped opponent AI
      default: 1

    # difficulty ladder -- tuning difficulty = editing these numbers
    gentle:                  # EASY done right: correct play, rarely
      passive: 7
      perfect: 3
    novice:
      random: 7
      default: 3
    journeyman:
      default: 7
      random: 3
    champion:
      perfect: 8
      random: 2

    # measurement bots: pure single strategies, no roll
    dummy:
      passive: 1
    chaos:
      random: 1
    perfect:                 # the solved policy, unmixed: the scoring yardstick
      perfect: 1

    # ---- the spam board (added 2026-07-30 for the Python balance loop) ----
    # One pure spam bot per MOVE KEY. The balance grammar's primary per-ability
    # tuning target is the spam-parity scoreboard -- "each ability's spam bot
    # beats ~50% of the other spam bots" -- and four of its twelve situations
    # (degenerate-spam-dominance, class-wide-band-violation,
    # static-realized-disagreement, spam-pressure-foreign-default) read that
    # board, so the scored roster needs these entrants to exist.
    #
    # `spam-<move>` resolves per character: an entrant naming a move its
    # character does not author is REFUSED at load (mb_rules_resolve_entrant),
    # so the loop enumerates these against each character's authored moveset
    # (data/roster.yaml, per_move) rather than crossing them blindly.
    #
    # sim_version is NOT bumped for this: entrants are identified by name and
    # appending a bot cannot move a row of any existing entrant's results
    # (../CLAUDE.md, "Entrant identity": append, never reorder or rename).
    spam-light:
      spam-light: 1
    spam-heavy:
      spam-heavy: 1
    spam-special:
      spam-special: 1
    spam-stakes_down:
      spam-stakes_down: 1
# CHARLES AISTROP — Fight 4, final boss. Human, proprietor of the Westminster Pit.
# Speed 4 / Power 6 / Reach 10 / Control 10. Beating him is beating an environment.
id: aistrop
name: CHARLES AISTROP
max_health: 100
walk_speed: 0.85
jump_velocity: -3.0
gravity: 0.32
weight: 1.3
grip_resistance: 5
hurtbox: {w: 18, h: 40}     # the only upright silhouette in the game; the player looks UP

palette:
  coat: "#243B2E"
  cream: "#E6DFC8"
  black: "#141312"
  gold: "#C9A227"
  chain: "#4A4E52"

mechanics:
  finisher_move: heavy       # TAKE UP THE SLACK — he collects
  holds_chain: true          # Jacco's chain is in this man's left hand
  pays_crowd: true           # pays out of the purse mid-fight, without looking
  the_cross:                 # the cheat, once per match, at low health
    trigger_health: 0.35
    window_seconds: 8.0      # the fix only holds if Jacco accepts it
    drain_per_second: 5.0    # Jacco's own health drains as though ruled against
    min_health: 1
    break_bonus_damage: 14   # broken by landing WINDPIPE inside the window
    break_stagger_frames: 70

ai:
  aggression: 0.65
  poke_range: 62             # the cane keeps everything at arm's length
  block_chance: 0.2
  retreat_chance: 0.3        # he does not have to fight; he has never had to fight
  special_min_range: 40
  special_max_range: 240
  jump_chance: 0.0
  keep_range: 58             # preferred spacing
  stakes_down_health: 0.6    # below this he may simply step out of the ring

moves:
  light:
    name: The Cane
    type: strike
    startup_frames: 9
    active_frames: 5
    recovery_frames: 12
    damage: 4                # he is not trying to kill Jacco; that would be waste
    base_knockback: 1.0
    knockback_growth: 0.3
    launch_angle: 5
    hitstun: 15              # contemptuous tap: low damage, high stagger
    blockstun: 12
    pushback_hit: 10
    pushback_block: 8
    hitbox: {x: 14, y: -26, w: 28, h: 8}   # long reach
    hit_freeze: 4
    shake: 0
    sound: cane
    cooldown: 0
  heavy:
    name: TAKE UP THE SLACK
    type: chain_yank
    startup_frames: 34       # he hauls the chain; the only counter is to be airborne
    active_frames: 4
    recovery_frames: 22
    damage: 8
    base_knockback: 0
    knockback_growth: 0
    launch_angle: 0
    hitstun: 34
    blockstun: 0
    pushback_hit: 0
    pushback_block: 0
    hitbox: {x: 0, y: 0, w: 0, h: 0}       # positional, not a box: grounded = caught
    hit_freeze: 6
    shake: 4
    sound: chain
    cooldown: 320
    unblockable: true
    yank_speed: 9            # Jacco is dragged to Aistrop's feet regardless of position
  special:
    name: MOPUSSES
    type: hazard_coins
    startup_frames: 18
    active_frames: 2
    recovery_frames: 26
    damage: 0
    base_knockback: 0
    knockback_growth: 0
    launch_angle: 0
    hitstun: 0
    blockstun: 0
    pushback_hit: 0
    pushback_block: 0
    hitbox: {x: 0, y: 0, w: 0, h: 0}
    hit_freeze: 0
    shake: 2
    sound: coins
    cooldown: 520
    coins_duration: 220      # the gallery surges; hands come down into the ring
    coins_zones: 3
    coins_zone_width: 46
    coins_chip_dps: 5
  stakes_down:
    name: STAKES DOWN
    type: retreat
    input: jump              # player-Aistrop: jump button steps out of the ring instead of jumping
    startup_frames: 12
    active_frames: 150       # he steps back out of the ring and lets the crowd throw things
    recovery_frames: 18
    damage: 4                # per thrown object that lands
    base_knockback: 1.2
    knockback_growth: 0.3
    launch_angle: 60
    hitstun: 14
    blockstun: 8
    pushback_hit: 5
    pushback_block: 3
    hitbox: {x: 0, y: 0, w: 0, h: 0}
    hit_freeze: 3
    shake: 1
    sound: thud
    cooldown: 640
    projectile_interval: 32
