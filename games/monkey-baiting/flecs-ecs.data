9€ôG	ô␀Gð␀ˆ"*‰*]Ó
#€ØˆBJ‰JÐDÓE€	óó0ð2␀€óHó!óJLó@Aó*ó ð␀ˆ"*‰*Ð2Ó
3€÷ñ␀ó09óD&ó óF2ð
/Ø"ð/Ø,/ð/Ø48ó/ó:ô$ó(Dð␀ˆbj‰jÐ8Ó9€ó$óó&óó62ô2r␀␀␀"""The run archive and the equal-height champion archive.

On-disk layout (a FRESH format -- `mb-run/2` etc.; no compatibility with the
node stack's archives is claimed or wanted, ruling 7):

    <runs-root>/
      archive.json                 the equal-height champion archive, shared
                                   by every run under this root
      <run-id>/
        run.json                   mb-run/2: identity, knobs, roster, solve,
                                   sim, events, base/best score
        grammar.yaml               the grammar this run was scored under
        pins.yaml                  the pin set that constrained it
        base/
          tournament.json          detector input, re-scorable
          framedata.json           detector input, re-scorable
          score.json               mb-score/2, verdict "base"
          overlay/data/...         the overlay stack the base already carried
        rounds/NNNN/
          candidate.json           mb-patch/2, verbatim
          patch/data/...           the candidate's overlay files
          tournament.json
          framedata.json
          score.json               mb-score/2 with the lineage block
        final/
          stack.json               mb-stack/2: heights, accepted, final score
          data/...                 the merged overlay of the accepted stack
          ledger.md                one tuning-ledger entry per accepted patch

Writes are atomic per file (write temp, rename), so an interrupted run leaves
a readable archive with status "running".

RE-SCORING is a first-class operation: the grammar is versioned and a patch
accepted under v3 may be rejected under v4, so lineages are recomputed rather
than grandfathered. `rescore()` re-runs the analysis over each round's STORED
detector inputs -- no matches, no solves, and it never writes.

THE EQUAL-HEIGHT ARCHIVE (`docs/balance-loop.md` section 4) is the pruning
rule: a lineage's height-N stack survives only if it OUTPERFORMS the best
archived height-N stack. Equal never survives -- the same strict-improvement
rule the round loop uses.

COMPARABILITY IS NOT ASSUMED. Two scores may be compared only when their
sim_version, grammar version, roster, seeds, solver version and solver backend
agree; the archive records that tuple per height and refuses to compare across
it rather than silently ranking incomparable numbers.
"""

from __future__ import annotations

import hashlib
import json
import shutil
from pathlib import Path
from typing import Any

from . import SCHEMA_PATCH, SCHEMA_RUN, SCHEMA_SCORE, SCHEMA_STACK
from .grammar import analyze, load_grammar, validate_grammar

__all__ = ["ArchiveError", "content_hash", "open_run", "flush", "write_base",
           "write_round", "add_event", "set_best", "finalize", "read_run",
           "verify", "rescore", "replayable_status", "HeightArchive",
           "comparability_key"]


class ArchiveError(Exception):
    """A run that cannot be opened at all."""


def content_hash(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:32]


def _write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8", newline="\n")
    tmp.replace(path)


def _write_json(path: Path, obj: Any) -> None:
    _write_atomic(path, json.dumps(obj, indent=2, sort_keys=False) + "\n")


def _copy_tree(src: Path, dest: Path) -> None:
    src = Path(src)
    if not src.exists():
        return
    dest.mkdir(parents=True, exist_ok=True)
    for item in sorted(src.iterdir()):
        target = dest / item.name
        if item.is_dir():
            _copy_tree(item, target)
        else:
            _write_atomic(target, item.read_text(encoding="utf-8"))


class RunHandle:
    def __init__(self, directory: Path, run: dict[str, Any]) -> None:
        self.dir = Path(directory)
        self.run = run
        self.next_round = 1


# --------------------------------------------------------------------------
# writer
# --------------------------------------------------------------------------

def open_run(directory: Path, meta: dict[str, Any]) -> RunHandle:
    """`meta` carries every identity field the runner resolved. Nothing is
    invented here."""
    directory = Path(directory)
    directory.mkdir(parents=True, exist_ok=True)
    run = {
        "schema": SCHEMA_RUN,
        "run_id": meta["run_id"],
        "started_at": meta["started_at"],
        "finished_at": None,
        "status": "running",
        "seed": meta["seed"],
        "knobs": meta["knobs"],
        "grammar": meta["grammar"],
        "pins": meta["pins"],
        "roster": meta["roster"],
        "match_rules": meta["match_rules"],
        # THE ORACLE (architecture ruling 5(a)): results under different
        # sim_versions are never compared and never scored against each other.
        "sim": meta["sim"],
        "solve": meta["solve"],
        "code": meta["code"],
        "base_score": None,
        "best_score": None,
        "round_cap": None,
        "events": [],
    }
    h = RunHandle(directory, run)
    if meta.get("grammar_text"):
        _write_atomic(directory / "grammar.yaml", meta["grammar_text"])
    if meta.get("pins_text"):
        _write_atomic(directory / "pins.yaml", meta["pins_text"])
    flush(h)
    return h


def flush(h: RunHandle) -> None:
    _write_json(h.dir / "run.json", h.run)


def write_base(h: RunHandle, o: dict[str, Any]) -> None:
    base = h.dir / "base"
    for d in o.get("overlay_dirs") or []:
        _copy_tree(Path(d) / "data", base / "overlay" / "data")
    _write_json(base / "tournament.json", o["tournament"])
    _write_json(base / "framedata.json", o["framedata"])
    _write_json(base / "score.json", o["score"])
    h.run["base_score"] = o["score"]["score"]
    h.run["best_score"] = o["score"]["score"]
    flush(h)


def write_round(h: RunHandle, o: dict[str, Any]) -> str:
    rid = f"{h.next_round:04d}"
    h.next_round += 1
    directory = h.dir / "rounds" / rid
    directory.mkdir(parents=True, exist_ok=True)
    _write_json(directory / "candidate.json", o["patch"])
    if o.get("patch_dir"):
        _copy_tree(Path(o["patch_dir"]) / "data", directory / "patch" / "data")
    _write_json(directory / "tournament.json", o["tournament"])
    _write_json(directory / "framedata.json", o["framedata"])
    o["score"]["round"] = rid
    _write_json(directory / "score.json", o["score"])
    return rid


def add_event(h: RunHandle, event: dict[str, Any]) -> None:
    h.run["events"].append(event)
    flush(h)


def set_best(h: RunHandle, score: float) -> None:
    h.run["best_score"] = score
    flush(h)


def finalize(h: RunHandle, o: dict[str, Any]) -> dict[str, Any]:
    fin = h.dir / "final"
    fin.mkdir(parents=True, exist_ok=True)
    _write_json(fin / "stack.json", o["stack"])
    writer = o.get("merged_overlay_writer")
    if callable(writer):
        writer(fin / "data")
    _write_atomic(fin / "ledger.md", o.get("ledger") or "")
    h.run["status"] = o.get("status", "complete")
    h.run["finished_at"] = o.get("finished_at") or h.run["finished_at"]
    flush(h)
    return h.run


# --------------------------------------------------------------------------
# reader
# --------------------------------------------------------------------------

def _read_json(path: Path) -> Any:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def _try_read_json(path: Path) -> dict[str, Any]:
    path = Path(path)
    if not path.exists():
        return {"ok": False, "error": "missing"}
    try:
        return {"ok": True, "value": _read_json(path)}
    except ValueError as exc:
        return {"ok": False, "error": str(exc)}


def list_round_ids(directory: Path) -> list[str]:
    rounds = Path(directory) / "rounds"
    if not rounds.exists():
        return []
    return sorted(p.name for p in rounds.iterdir() if p.is_dir())


def read_run(directory: Path) -> dict[str, Any]:
    directory = Path(directory)
    run = _read_json(directory / "run.json")
    base = None
    base_dir = directory / "base"
    if base_dir.exists():
        base = {"has_tournament": (base_dir / "tournament.json").exists(),
                "has_framedata": (base_dir / "framedata.json").exists()}
        if (base_dir / "score.json").exists():
            base["score"] = _read_json(base_dir / "score.json")
    rounds = []
    for rid in list_round_ids(directory):
        rd = directory / "rounds" / rid
        entry: dict[str, Any] = {
            "id": rid, "dir": str(rd),
            "has_tournament": (rd / "tournament.json").exists(),
            "has_framedata": (rd / "framedata.json").exists(),
        }
        if (rd / "candidate.json").exists():
            entry["candidate"] = _read_json(rd / "candidate.json")
        if (rd / "score.json").exists():
            entry["score"] = _read_json(rd / "score.json")
        rounds.append(entry)
    stack = None
    if (directory / "final" / "stack.json").exists():
        stack = _read_json(directory / "final" / "stack.json")
    return {"run": run, "base": base, "rounds": rounds, "stack": stack}


def replayable_status(run: dict[str, Any]) -> dict[str, Any]:
    """Informational, never a failure: a dirty tree can still be RE-SCORED,
    only re-simulation is unsound."""
    reasons: list[str] = []
    code = run.get("code") or {}
    if code.get("git_dirty") is True:
        reasons.append("git_dirty is true")
    if not (run.get("sim") or {}).get("sim_version"):
        reasons.append("sim_version is absent")
    return {"replayable": not reasons, "reason": "; ".join(reasons) or None}


# --------------------------------------------------------------------------
# verify
# --------------------------------------------------------------------------

def verify(directory: Path) -> list[str]:
    """[] when clean, else every integrity failure. Never throws on a corrupt
    or half-written archive -- it is DESCRIBED, not crashed on."""
    directory = Path(directory)
    failures: list[str] = []

    def fail(msg: str) -> None:
        failures.append(msg)

    got = _try_read_json(directory / "run.json")
    if not got["ok"]:
        fail("run.json " + ("is missing" if got["error"] == "missing"
                            else "does not parse: " + got["error"]))
        return failures
    run = got["value"]

    if run.get("schema") != SCHEMA_RUN:
        fail(f'run.json: wrong schema "{run.get("schema")}" (want {SCHEMA_RUN})')
    if run.get("status") == "running":
        fail('run.json: status is "running" -- the run is incomplete')
    elif run.get("status") not in ("complete", "failed"):
        fail(f'run.json: unknown status "{run.get("status")}"')
    if not (run.get("sim") or {}).get("sim_version"):
        fail("run.json: no sim.sim_version -- the score has no oracle stamp")

    for name, key in (("grammar.yaml", "grammar"), ("pins.yaml", "pins")):
        meta = run.get(key) or {}
        if not meta.get("sha"):
            continue
        path = directory / name
        if not path.exists():
            fail(f"missing {name} (referenced by run.json.{key}.sha)")
        elif content_hash(path.read_text(encoding="utf-8")) != meta["sha"]:
            fail(f"{name} content hash does not match run.json.{key}.sha")

    base_dir = directory / "base"
    for f in ("tournament.json", "framedata.json", "score.json"):
        got = _try_read_json(base_dir / f)
        if not got["ok"]:
            fail(f"base/{f} " + ("is missing" if got["error"] == "missing"
                                 else "does not parse: " + got["error"]))
    got = _try_read_json(base_dir / "score.json")
    if got["ok"] and got["value"].get("schema") != SCHEMA_SCORE:
        fail(f"base/score.json: wrong schema (want {SCHEMA_SCORE})")

    round_ids = list_round_ids(directory)
    for rid in round_ids:
        rd = directory / "rounds" / rid
        rel = f"rounds/{rid}"
        got = _try_read_json(rd / "candidate.json")
        if not got["ok"]:
            fail(f"{rel}/candidate.json " + ("is missing" if got["error"] == "missing"
                                             else "does not parse"))
        elif got["value"].get("schema") != SCHEMA_PATCH:
            fail(f"{rel}/candidate.json: wrong schema (want {SCHEMA_PATCH})")
        for f in ("tournament.json", "framedata.json"):
            if not _try_read_json(rd / f)["ok"]:
                fail(f"{rel}/{f} is missing or does not parse")
        got = _try_read_json(rd / "score.json")
        if not got["ok"]:
            fail(f"{rel}/score.json is missing or does not parse")
            continue
        score = got["value"]
        if score.get("schema") != SCHEMA_SCORE:
            fail(f"{rel}/score.json: wrong schema (want {SCHEMA_SCORE})")
            continue
        lineage = score.get("lineage") or {}
        for k in ("height", "parent_round", "lineage_id", "rng_stream",
                  "champion_at_height", "pruned_reason", "solver_version",
                  "solver_backend", "model_sha", "resolved_pairs"):
            if k not in lineage:
                fail(f'{rel}/score.json: lineage missing reserved field "{k}"')
        if isinstance(score.get("score"), (int, float)) and \
                isinstance(score.get("parent_score"), (int, float)):
            want = score["score"] - score["parent_score"]
            if score.get("delta") != want:
                fail(f'{rel}/score.json: delta ({score.get("delta")}) != '
                     f"score - parent_score ({want})")
        if score.get("verdict") == "accept" and not (score.get("delta", 0) < 0):
            fail(f'{rel}/score.json: verdict "accept" but delta '
                 f'{score.get("delta")} is not a strict improvement')

    if run.get("status") == "complete":
        got = _try_read_json(directory / "final" / "stack.json")
        if not got["ok"]:
            fail("missing or unparseable final/stack.json (status is complete)")
        else:
            stack = got["value"]
            if stack.get("schema") != SCHEMA_STACK:
                fail(f"final/stack.json: wrong schema (want {SCHEMA_STACK})")
            else:
                for i, hh in enumerate(stack.get("heights") or []):
                    if hh.get("height") != i:
                        fail(f"final/stack.json: heights not contiguous at index {i}")
                for rid in stack.get("accepted") or []:
                    if rid not in round_ids:
                        fail(f'final/stack.json: accepted round "{rid}" has no '
                             f"rounds/{rid} directory")
    return failures


# --------------------------------------------------------------------------
# rescore
# --------------------------------------------------------------------------

def rescore(directory: Path, grammar_file: Path) -> dict[str, Any]:
    """Re-runs the analysis over the STORED detector inputs under a different
    grammar, recomputing delta and verdict against the RESCORED parent -- the
    same chaining the runner used. Reads only."""
    directory = Path(directory)
    text = Path(grammar_file).read_text(encoding="utf-8")
    G = load_grammar(grammar_file)
    errors: list[str] = []
    validate_grammar(G, None, errors)
    if errors:
        raise ArchiveError(f"rescore: invalid grammar {grammar_file}: "
                           + "; ".join(errors))

    from .tournament import spam_board

    def one(tournament: dict[str, Any], framedata: dict[str, Any]) -> dict[str, Any]:
        return analyze(G, {"report": tournament, "framedata": framedata,
                           "board": spam_board(tournament)})

    base_dir = directory / "base"
    base_a = one(_read_json(base_dir / "tournament.json"),
                 _read_json(base_dir / "framedata.json"))
    base_old = _read_json(base_dir / "score.json")

    new_scores: dict[str, float] = {}
    rounds: list[dict[str, Any]] = []
    for rid in list_round_ids(directory):
        rd = directory / "rounds" / rid
        A = one(_read_json(rd / "tournament.json"), _read_json(rd / "framedata.json"))
        old = _read_json(rd / "score.json")
        parent = (old.get("lineage") or {}).get("parent_round")
        new_parent = new_scores[parent] if parent else base_a["score"]
        new_delta = A["score"] - new_parent
        new_verdict = "accept" if new_delta < 0 else "reject"
        new_scores[rid] = A["score"]
        rounds.append({
            "round": rid, "old_score": old["score"], "new_score": A["score"],
            "old_parent_score": old.get("parent_score"),
            "new_parent_score": new_parent,
            "old_delta": old.get("delta"), "new_delta": new_delta,
            "old_verdict": old.get("verdict"), "new_verdict": new_verdict,
            "revoked": old.get("verdict") == "accept" and new_verdict != "accept",
        })

    return {
        "grammar_from": _read_json(directory / "run.json").get("grammar"),
        "grammar_to": {"file": str(grammar_file), "version": G["version"],
                       "sha": content_hash(text)},
        "base": {"old_score": base_old["score"], "new_score": base_a["score"]},
        "rounds": rounds,
        "revoked": sum(1 for r in rounds if r["revoked"]),
    }


# --------------------------------------------------------------------------
# the equal-height champion archive
# --------------------------------------------------------------------------

def comparability_key(run: dict[str, Any]) -> dict[str, Any]:
    """The tuple two scores must share to be comparable at all.

    `docs/balance-loop.md`: two stacks are comparable only when their match
    conditions are identical -- and, as amended, only within one solver
    version/backend tuple. sim_version joins them as the simulator oracle."""
    solve = run.get("solve") or {}
    roster = run.get("roster") or {}
    return {
        "sim_version": (run.get("sim") or {}).get("sim_version"),
        "grammar_version": (run.get("grammar") or {}).get("version"),
        "grammar_sha": (run.get("grammar") or {}).get("sha"),
        "pins_sha": (run.get("pins") or {}).get("sha"),
        "roster_mode": roster.get("mode"),
        "entrants": roster.get("entrant_count"),
        "eval_seeds": (run.get("knobs") or {}).get("eval_seeds"),
        "solve_profile": solve.get("profile"),
        "solver_version": solve.get("solver_version"),
        "solver_backend": solve.get("solver_backend"),
    }


class HeightArchive:
    """Best known stack AT EACH HEIGHT, per comparability tuple.

    The pruning rule (`docs/balance-loop.md` section 4): a new lineage's
    height-N stack survives only if it OUTPERFORMS the archived champion at
    that height. Equal is not good enough -- the same strict rule the round
    loop applies, so a plateau cannot be wandered across at either level."""

    def __init__(self, path: Path | None = None,
                 key: dict[str, Any] | None = None) -> None:
        self.path = Path(path) if path else None
        self.key = key
        self.entries: dict[str, dict[str, Any]] = {}
        if self.path and self.path.exists():
            doc = json.loads(self.path.read_text(encoding="utf-8"))
            self.entries = doc.get("heights", {})
            if key is None:
                self.key = doc.get("comparability")

    def _comparable(self, entry: dict[str, Any]) -> bool:
        if self.key is None or entry.get("comparability") is None:
            return True
        return entry["comparability"] == self.key

    def best_at(self, height: int) -> dict[str, Any] | None:
        entry = self.entries.get(str(height))
        if entry is None or not self._comparable(entry):
            return None
        return entry

    def better_than(self, height: int, score: float) -> bool:
        best = self.best_at(height)
        return best is None or score < best["score"]

    def record(self, height: int, score: float, run_id: str,
               round_ref: str | None) -> None:
        self.entries[str(height)] = {
            "height": height, "score": score, "run_id": run_id,
            "round": round_ref, "comparability": self.key,
        }

    def save(self) -> None:
        if self.path is None:
            return
        _write_json(self.path, {"schema": "mb-archive/1",
                                "comparability": self.key,
                                "heights": self.entries})
"""`python3 -m mb_loop <command>` -- the balance loop's command line.

    score      run one tournament, detect situations, print the balance score
    emit       emit candidate patches from a scored state, without running them
    run        one accept/reject run (depth-first, archived)
    search     RNG-varied runs until run_patience is exhausted
    archive    list | show | verify | rescore a stored run

Every command takes `--sandbox` (default `sandboxes/monkey-baiting`) and is run
from the project root, because `mb_sim` resolves `./sandboxes/` relative to the
working directory.

NO SILENT FALLBACKS: an unknown flag, a missing binary, a failed solve or a
grammar that does not validate is an error with a message and a distinct exit
code, never a degraded run.

Exit codes:  0 ok   1 hard failure   2 bad usage
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from . import archive, emit, framedata as F, grammar as G, patch as P
from . import runner, search as SEARCH, tournament as TOURN
from .data import load_data

DEFAULT_SANDBOX = Path("sandboxes/monkey-baiting")


def _common(ap: argparse.ArgumentParser) -> None:
    ap.add_argument("--sandbox", type=Path, default=DEFAULT_SANDBOX)
    ap.add_argument("--root", type=Path, default=Path("."),
                    help="project root (default: the working directory)")
    ap.add_argument("--grammar", type=Path, default=None)
    ap.add_argument("--pins", type=Path, default=None)
    ap.add_argument("--overlay", type=Path, action="append", default=[],
                    help="an already-accepted patch directory, repeatable")


def _eval_flags(ap: argparse.ArgumentParser) -> None:
    ap.add_argument("--roster", choices=("no-perfect", "full"), default="no-perfect")
    ap.add_argument("--seeds", type=int, default=SEARCH.KNOB_DEFAULTS["eval_seeds"])
    ap.add_argument("--perfect", type=Path, default=None,
                    help="solved-policy directory (required by --roster full)")
    ap.add_argument("--threads", type=int, default=None)
    ap.add_argument("--binary", type=Path, default=None)


def _knob_flags(ap: argparse.ArgumentParser) -> None:
    d = SEARCH.KNOB_DEFAULTS
    ap.add_argument("--failure-budget", type=int, default=d["failure_budget"])
    ap.add_argument("--run-patience", type=int, default=d["run_patience"])
    ap.add_argument("--max-depth", type=int, default=d["max_depth"])
    ap.add_argument("--candidates-per-depth", type=int,
                    default=d["candidates_per_depth"])


def _solve_flags(ap: argparse.ArgumentParser) -> None:
    ap.add_argument("--solve-profile", choices=("skip", "coarse", "cold"),
                    default="skip")
    ap.add_argument("--backend", choices=("cuda", "numpy"), default="cuda")
    ap.add_argument("--python", default=None, help="solver interpreter")
    ap.add_argument("--node", default="node", help="node for the model exporter")
    ap.add_argument("--canary", choices=("on", "off"), default="on",
                    help="the CUDA solver's reproducibility gate; off is only "
                         "legitimate when the score is not being archived")
    ap.add_argument("--model-gate", choices=("on", "off"), default="on")
    ap.add_argument("--keep-policies", action="store_true")


def _sampling_flags(ap: argparse.ArgumentParser) -> None:
    # How far a sample may travel: a fraction of the class envelope's width
    # (or of the value itself, for a field with no envelope). Bigger steps
    # explore faster and reject more; both are recorded in run.json.
    ap.add_argument("--max-step", type=float, default=0.25)
    ap.add_argument("--magnitude-frac", type=float, default=0.15)


def _opts_from(args: argparse.Namespace) -> runner.RunOptions:
    knobs = dict(SEARCH.KNOB_DEFAULTS)
    for name in SEARCH.KNOBS:
        flag = name if name != "eval_seeds" else "seeds"
        if hasattr(args, flag):
            knobs[name] = getattr(args, flag)
    return runner.RunOptions(
        sandbox=args.sandbox, root=args.root, seed=getattr(args, "seed", 1),
        out=getattr(args, "out", None), runs_root=getattr(args, "runs_root", None),
        grammar=args.grammar, pins=args.pins, overlays=list(args.overlay),
        knobs=knobs, roster_mode=args.roster, perfect=args.perfect,
        solve_profile=getattr(args, "solve_profile", "skip"),
        backend=getattr(args, "backend", "cuda"),
        python=getattr(args, "python", None), node=getattr(args, "node", "node"),
        canary=getattr(args, "canary", "on") == "on",
        model_gate=getattr(args, "model_gate", "on") == "on",
        threads=args.threads, binary=args.binary,
        max_step=getattr(args, "max_step", 0.25),
        magnitude_frac=getattr(args, "magnitude_frac", 0.15),
        keep_policies=getattr(args, "keep_policies", False),
        apply=getattr(args, "apply", False), ledger=getattr(args, "ledger", None),
        quiet=getattr(args, "quiet", False),
        pin_clock=getattr(args, "pin_clock", None))


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def cmd_score(args: argparse.Namespace) -> int:
    data = load_data(args.sandbox, args.overlay)
    grammar_path = args.grammar or (args.sandbox / "data" / "balance-grammar.yaml")
    grammar = G.load_grammar(grammar_path)
    errors: list[str] = []
    ids = G.validate_grammar(grammar, None, errors)
    if errors:
        for e in errors:
            print("FAIL " + e, file=sys.stderr)
        return 1
    if args.ledger:
        md = Path(args.ledger).read_text(encoding="utf-8")
        lerrors: list[str] = []
        L = G.validate_ledger(md, ids, lerrors)
        for e in lerrors:
            print("FAIL " + e, file=sys.stderr)
        if lerrors:
            return 1
        print(f"ledger: {L['entries']} entries, {len(L['citations'])} citations, "
              f"all resolve")

    roster = TOURN.build_roster(data, args.roster)
    res = TOURN.run_tournament(data, roster, seeds=args.seeds,
                               perfect_dir=args.perfect, threads=args.threads,
                               binary=args.binary, verify=args.verify)
    tj = TOURN.tournament_json(res)
    fj = F.framedata_json(F.analyze(data))
    A = G.analyze(grammar, {"report": tj, "framedata": fj,
                            "board": TOURN.spam_board(tj)})

    print(f"MONKEY BAITING -- BALANCE SCORE   grammar v{A['version']}   "
          f"sim {tj['sim']['sim_version']}   hash {tj['sim']['hash']}")
    print(f"roster {args.roster}: {len(roster)} entrants, {res.matches} matches, "
          f"{args.seeds} seeds, {res.wall_ms:.0f} ms")
    print()
    print(f"  {'SITUATION':<32}{'SIGNALS':>9}{'WT':>5}{'SCORE':>7}  STRATEGIES")
    for s in A["situations"]:
        sig = (str(s["signals"]) if s["signals"]
               else "manual" if s["manual"] and not s["unavailable"]
               else "n/a" if s["unavailable"] else "-")
        sub = s["subscore"] if s["subscore"] is not None else "."
        strat = ", ".join(s["strategies"]) or "** PLAYBOOK GAP **"
        print(f"  {s['id']:<32}{sig:>9}{s['weight']:>5}{str(sub):>7}  "
              f"{strat if s['signals'] else '(clear)' if sig == '-' else strat}")
    print(f"  BALANCE SCORE: {A['score']}   -- lower is better, 0 = every band "
          f"holds; {A['scored']}/{len(A['situations'])} scorable")
    if args.json:
        Path(args.json).write_text(json.dumps(
            {"score": A["score"], "grammar_version": A["version"],
             "per_situation": G.per_situation(A), "tournament": tj,
             "framedata": fj}, indent=2) + "\n", encoding="ascii")
        print(f"\nwrote {args.json}")
    return 0


def cmd_emit(args: argparse.Namespace) -> int:
    data = load_data(args.sandbox, args.overlay)
    grammar = G.load_grammar(args.grammar or
                             (args.sandbox / "data" / "balance-grammar.yaml"))
    pins = P.load_pins(args.pins or (args.sandbox / "data" / "balance-pins.yaml"))
    report = json.loads(Path(args.report).read_text(encoding="utf-8"))
    fj = (json.loads(Path(args.framedata).read_text(encoding="utf-8"))
          if args.framedata else F.framedata_json(F.analyze(data)))
    r = emit.emit_candidates(grammar=grammar, data=data, pins=pins, report=report,
                             framedata=fj, seed=args.seed, out_dir=args.out,
                             count=args.count, max_step=args.max_step,
                             magnitude_frac=args.magnitude_frac)
    for line in r.log:
        print(line)
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    opts = _opts_from(args)
    # A single run contributes to the equal-height archive like any other: the
    # archive is keyed on the runs root, not on a search invocation, so
    # `run` and `search` compete on the same board.
    runs_root = Path(opts.runs_root) if opts.runs_root else (opts.sandbox / "runs")
    runs_root.mkdir(parents=True, exist_ok=True)
    heights = archive.HeightArchive(runs_root / "archive.json")
    outcome = runner.run_once(opts, heights)
    return outcome.exit_code


def cmd_search(args: argparse.Namespace) -> int:
    r = runner.run_search(_opts_from(args))
    return int(r.get("exit_code", 0))


def cmd_archive(args: argparse.Namespace) -> int:
    if args.action == "list":
        root = args.runs_root or (args.sandbox / "runs")
        if not Path(root).exists():
            print(f"(no runs under {root})")
            return 0
        print(f"{'RUN':<34}{'GRAMMAR':<9}{'STATUS':<11}{'BASE':>7}{'BEST':>7}  KNOBS")
        for d in sorted(Path(root).iterdir()):
            if not (d / "run.json").exists():
                continue
            run = json.loads((d / "run.json").read_text(encoding="utf-8"))
            knobs = " ".join(f"{k}={v}" for k, v in (run.get("knobs") or {}).items())
            print(f"{run.get('run_id', d.name):<34}"
                  f"{'v' + str((run.get('grammar') or {}).get('version')):<9}"
                  f"{run.get('status', '?'):<11}{run.get('base_score'):>7}"
                  f"{run.get('best_score'):>7}  {knobs}")
        return 0
    directory = Path(args.run)
    if args.action == "verify":
        failures = archive.verify(directory)
        for f in failures:
            print("FAIL  " + f)
        run = json.loads((directory / "run.json").read_text(encoding="utf-8"))
        rp = archive.replayable_status(run)
        print(f"replayable: {rp['replayable']}"
              + (f"  ({rp['reason']})" if rp["reason"] else ""))
        if failures:
            print(f"\n{len(failures)} FAILURE(S)")
            return 1
        print("verify: ok")
        return 0
    if args.action == "show":
        doc = archive.read_run(directory)
        if args.json:
            print(json.dumps(doc, indent=2))
            return 0
        run = doc["run"]
        print(f"run {run['run_id']}   grammar v{(run.get('grammar') or {}).get('version')}"
              f"   sim {(run.get('sim') or {}).get('sim_version')}"
              f"   status {run['status']}   base {run['base_score']}"
              f"   best {run['best_score']}")
        print()
        print(f"{'ROUND':<7}{'HEIGHT':>8}  {'STRATEGY':<26}{'DELTA':>8}  VERDICT")
        for r in doc["rounds"]:
            sc = r.get("score") or {}
            cand = r.get("candidate") or {}
            print(f"{r['id']:<7}{(sc.get('lineage') or {}).get('height', '?'):>8}  "
                  f"{cand.get('strategy', '?'):<26}{sc.get('delta', '?'):>8}  "
                  f"{sc.get('verdict', '?')}")
        return 0
    if args.action == "rescore":
        if not args.grammar:
            print("rescore: --grammar FILE is required", file=sys.stderr)
            return 2
        r = archive.rescore(directory, args.grammar)
        print(f"rescore {directory} under {args.grammar} "
              f"(grammar v{r['grammar_to']['version']})")
        print(f"  base: {r['base']['old_score']} -> {r['base']['new_score']}")
        for x in r["rounds"]:
            print(f"  round {x['round']}: {x['old_score']} -> {x['new_score']}   "
                  f"{x['old_verdict']} -> {x['new_verdict']}"
                  + ("   ** REVOKED **" if x["revoked"] else ""))
        print(f"  {r['revoked']} acceptance(s) revoked")
        return 0
    print(f"archive: unknown action {args.action}", file=sys.stderr)
    return 2


# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="mb_loop", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    p = sub.add_parser("score", help="score one state")
    _common(p)
    _eval_flags(p)
    p.add_argument("--ledger", type=Path, default=None,
                   help="validate ledger citations against the grammar")
    p.add_argument("--json", type=Path, default=None)
    p.add_argument("--verify", action="store_true",
                   help="run the tournament twice and require identical rows+hash")
    p.set_defaults(func=cmd_score)

    p = sub.add_parser("emit", help="emit candidate patches from a stored report")
    _common(p)
    p.add_argument("--report", type=Path, required=True)
    p.add_argument("--framedata", type=Path, default=None)
    _sampling_flags(p)
    p.add_argument("--seed", type=int, required=True)
    p.add_argument("--out", type=Path, required=True)
    p.add_argument("--count", type=int, default=6)
    p.set_defaults(func=cmd_emit)

    p = sub.add_parser("run", help="one accept/reject run")
    _common(p)
    _eval_flags(p)
    _knob_flags(p)
    _solve_flags(p)
    _sampling_flags(p)
    p.add_argument("--seed", type=int, required=True)
    p.add_argument("--out", type=Path, default=None)
    p.add_argument("--runs-root", type=Path, default=None)
    p.add_argument("--apply", action="store_true",
                   help="write the accepted stack back into the canonical data")
    p.add_argument("--ledger", type=Path, default=None)
    p.add_argument("--pin-clock", default=None, metavar="ISO8601",
                   help="pin every wall-clock stamp in the archive to this "
                        "value, so two runs of the same inputs produce "
                        "byte-identical artifacts (the reproducibility gate)")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("search", help="RNG-varied runs until run_patience")
    _common(p)
    _eval_flags(p)
    _knob_flags(p)
    _solve_flags(p)
    _sampling_flags(p)
    p.add_argument("--seed", type=int, required=True)
    p.add_argument("--out", type=Path, default=None)
    p.add_argument("--runs-root", type=Path, default=None)
    p.add_argument("--pin-clock", default=None, metavar="ISO8601",
                   help="pin every wall-clock stamp in the archive")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("archive", help="inspect a stored run")
    p.add_argument("action", choices=("list", "show", "verify", "rescore"))
    p.add_argument("run", nargs="?", default=None)
    p.add_argument("--sandbox", type=Path, default=DEFAULT_SANDBOX)
    p.add_argument("--runs-root", type=Path, default=None)
    p.add_argument("--grammar", type=Path, default=None)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_archive)
    return ap


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if getattr(args, "roster", None) == "full" and not getattr(args, "perfect", None) \
            and getattr(args, "solve_profile", "skip") == "skip":
        print("--roster full needs --perfect DIR (or a --solve-profile that "
              "re-solves the base state)", file=sys.stderr)
        return 2
    try:
        return args.func(args)
    except Exception as exc:      # noqa: BLE001 -- typed, printed, never silent
        print(f"mb_loop: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
"""Canonical monkey-baiting data: loading, overlay merging, path resolution.

THE SINGLE SOURCE is `sandboxes/monkey-baiting/data/` plus the sandbox's
`app.yaml` (the S2 port's reconciled home for what the JS reference kept in
`tuning.yaml` / `structure.yaml`). Nothing here ever reads
`web/monkey-baiting/data/`, which is a frozen shipped snapshot (see that
directory's README.md).

The shaped object this module returns mirrors what the retired
`web/monkey-baiting/data.js` produced, because the grammar's patch templates
address parameters through it: `data.characters.<cid>...`,
`data.strategies.<name>...`, `data.balance.classes...`. That correspondence is
the contract `qualified_path()` implements, not an accident.

A patch NEVER edits data on disk during a run. The runner loads the base data
and deep-merges the overlay stack in memory; `data/` is written only by an
explicit apply (`apply.py`).
"""

from __future__ import annotations

import copy
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

from . import yamlio

__all__ = [
    "DataError", "Data", "PATCHABLE_FILES", "load_data", "load_rules",
    "qualified_path", "resolve_path", "set_at_path", "deep_merge_into",
    "frame_budget", "sandbox_data_dir",
]


class DataError(Exception):
    """A missing or malformed canonical data file. Never a silent default."""


# Files a patch may target, named exactly as the grammar's patch templates
# name them ("data/<rel>"). The character list is filled from app.yaml's
# roster at load time, so appending a character needs no change here.
_STATIC_PATCHABLE = ("strategies.yaml", "bots.yaml", "balance.yaml")

# The wrapper key each file's document carries, stripped by the shaped object
# so a template path is written against the content, not the wrapper.
_WRAPPERS = {"strategies.yaml": "strategies", "bots.yaml": "bots"}


def sandbox_data_dir(sandbox: Path) -> Path:
    return Path(sandbox) / "data"


@dataclass
class Data:
    """The shaped canonical state a candidate is proposed against."""

    characters: dict[str, Any]
    character_ids: list[str]
    strategies: dict[str, Any]
    bots: dict[str, Any]
    balance: dict[str, Any]
    rules: dict[str, Any]          # app.yaml, whole document
    sandbox: Path
    files: list[str] = field(default_factory=list)

    def as_root(self) -> dict[str, Any]:
        """The dotted-path resolution root (see `qualified_path`)."""
        return {
            "characters": self.characters,
            "strategies": self.strategies,
            "bots": self.bots,
            "balance": self.balance,
        }


def _require(doc: Any, key: str, source: str) -> Any:
    if not isinstance(doc, dict) or key not in doc:
        raise DataError(f"{source}: missing required key {key!r}")
    return doc[key]


def load_rules(sandbox: Path) -> dict[str, Any]:
    path = Path(sandbox) / "app.yaml"
    if not path.exists():
        raise DataError(f"sandbox app.yaml not found: {path}")
    return yamlio.load(path)


def load_data(sandbox: Path, overlay_dirs: list[Path] | None = None) -> Data:
    """Loads the canonical state, then deep-merges each overlay dir's partial
    YAML on top, oldest first. An overlay dir holds `data/<rel>` files in each
    file's own physical shape (wrapper key included)."""
    sandbox = Path(sandbox)
    ddir = sandbox_data_dir(sandbox)
    rules = load_rules(sandbox)
    ids = _require(rules, "characters", str(sandbox / "app.yaml"))
    if not isinstance(ids, list) or not ids:
        raise DataError(f"{sandbox / 'app.yaml'}: characters must be a non-empty list")

    characters: dict[str, Any] = {}
    for cid in ids:
        path = ddir / "characters" / f"{cid}.yaml"
        if not path.exists():
            raise DataError(f"character file not found: {path}")
        doc = yamlio.load(path)
        if doc.get("id") != cid:
            raise DataError(f"{path}: id {doc.get('id')!r} does not match the "
                            f"app.yaml roster entry {cid!r}")
        characters[cid] = doc

    strategies = _require(yamlio.load(ddir / "strategies.yaml"), "strategies",
                          str(ddir / "strategies.yaml"))
    bots = _require(yamlio.load(ddir / "bots.yaml"), "bots", str(ddir / "bots.yaml"))
    balance = yamlio.load(ddir / "balance.yaml")
    if not isinstance(balance, dict) or "classes" not in balance:
        raise DataError(f"{ddir / 'balance.yaml'}: missing 'classes'")

    files = list(_STATIC_PATCHABLE) + [f"characters/{c}.yaml" for c in ids]
    data = Data(characters=characters, character_ids=list(ids),
                strategies=strategies, bots=bots, balance=balance,
                rules=rules, sandbox=sandbox, files=files)

    for overlay in overlay_dirs or []:
        _apply_overlay(data, Path(overlay))
    return data


def _apply_overlay(data: Data, overlay: Path) -> None:
    for rel in data.files:
        path = overlay / "data" / rel
        if not path.exists():
            continue
        tree = yamlio.load(path)
        if not isinstance(tree, dict):
            raise DataError(f"{path}: overlay must be a mapping")
        wrapper = _WRAPPERS.get(rel)
        sub = tree.get(wrapper) if wrapper else tree
        if sub is None:
            raise DataError(f"{path}: overlay for {rel} has no {wrapper!r} key")
        root = _root_for(data, rel)
        deep_merge_into(root, sub)


def _root_for(data: Data, rel: str) -> dict[str, Any]:
    if rel.startswith("characters/"):
        cid = rel[len("characters/"):-len(".yaml")]
        if cid not in data.characters:
            raise DataError(f"overlay names unknown character {cid!r}")
        return data.characters[cid]
    return {"strategies.yaml": data.strategies, "bots.yaml": data.bots,
            "balance.yaml": data.balance}[rel]


PATCHABLE_FILES = _STATIC_PATCHABLE


# --------------------------------------------------------------------------
# structural helpers
# --------------------------------------------------------------------------

def deep_merge_into(target: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
    """Recursive overlay merge, in place. Maps recurse; scalars and lists are
    replaced wholesale (a list is one leaf)."""
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(target.get(key), dict):
            deep_merge_into(target[key], value)
        else:
            target[key] = copy.deepcopy(value)
    return target


def qualified_path(file: str, path: str) -> str:
    """`file` is "data/<rel>" as recorded on a patch edit; `path` is dotted and
    RELATIVE TO THE FILE. Returns the dotted path against `Data.as_root()`.

    strategies.yaml and bots.yaml wrap their content in a single top-level key
    that the shaped object already strips, so the qualified path drops the
    wrapper too -- which is what makes the grammar's own template slots (e.g.
    "<victim_default_strategy>.<ai_param>") address `data.strategies`."""
    rel = file[len("data/"):] if file.startswith("data/") else file
    if rel.startswith("characters/") and rel.endswith(".yaml"):
        return "characters." + rel[len("characters/"):-len(".yaml")] + "." + path
    return rel[:-len(".yaml")] + "." + path if rel.endswith(".yaml") else rel + "." + path


def resolve_path(root: Any, dotted: str) -> tuple[bool, Any]:
    """(found, value). Never raises: an unresolvable path is a verifier
    finding, not an exception."""
    cur = root
    for seg in dotted.split("."):
        if seg.isdigit():
            if not isinstance(cur, list):
                return False, None
            idx = int(seg)
            if idx < 0 or idx >= len(cur):
                return False, None
            cur = cur[idx]
            continue
        if not isinstance(cur, dict) or seg not in cur:
            return False, None
        cur = cur[seg]
    return True, cur


def set_at_path(root: Any, dotted: str, value: Any) -> Any:
    """Deep-copies `root` and sets the leaf at `dotted`. Used for the envelope
    re-check; never touches disk."""
    clone = copy.deepcopy(root)
    cur = clone
    segs = dotted.split(".")
    for seg in segs[:-1]:
        cur = cur[int(seg)] if seg.isdigit() else cur[seg]
    last = segs[-1]
    if last.isdigit():
        cur[int(last)] = value
    else:
        cur[last] = value
    return clone


# --------------------------------------------------------------------------
# derived match parameters
# --------------------------------------------------------------------------

def frame_budget(rules: dict[str, Any]) -> int:
    """The per-match frame cap, derived from the round rules rather than
    guessed: every round can run the full watch and a match can run to the
    round cap. Ported from `test/tournament.js` frameBudget(), reading the
    S2-reconciled app.yaml keys."""
    rounds = _require(rules, "rounds", "app.yaml")
    combat = _require(rules, "combat", "app.yaml")
    finisher = _require(rules, "finisher", "app.yaml")
    hz = _require(rules, "logic_hz", "app.yaml")
    per_round = (rounds["time_seconds"] * hz + rounds["intro_frames"]
                 + rounds["end_frames"] + combat["ko_slowmo_frames"]
                 + finisher["cinematic_frames"])
    return int(rounds["max_rounds_per_match"] * per_round) + 600
"""The seeded patch emitter -- turns detected situations into candidate patches.

A port of `web/monkey-baiting/test/loop-emit.js` (spec:
`web/monkey-baiting/docs/specs/loop-emitter.md`), retargeted at the canonical
sandbox data.

EXPLORATION, NOT PRESCRIPTION (`docs/balance-loop.md` section 1b): the emitter
samples the space; the measured accept/reject does the selecting. A strategy
here is a SEARCH-SPACE RESTRICTION -- which parameter, in which direction, in
which situation -- not an instruction about how much to move it.

THE GRAMMAR'S TEMPLATES ARE THE TEMPLATE. `patch.file` / `patch.path` from
`data/balance-grammar.yaml` are substituted, never bypassed by a hardcoded
target. Slot filling only derives the VALUES (`<char>`, `<move>`,
`<flagged_param>`, ...) from the matched signal text and the framedata. A
template naming a slot this emitter cannot derive is left literal so the
legal-patch verifier rejects it, rather than being silently redirected -- that
is what lets a future grammar-version search actually change what gets
emitted.

DETERMINISM. There is no unseeded randomness anywhere in the loop. All
sampling goes through mulberry32 seeded as fnv1a(f"{seed}|{stream}"), the same
generator the simulator and solver use, so a (seed, depth, visit, candidate)
tuple reproduces a candidate byte for byte.

Only `move-param` and `ai-param` layers are emitted. `class-envelope` is
deferred by spec decision; every analysis-only strategy (`patch: null`) is
skipped with a printed reason, never guessed at.
"""

from __future__ import annotations

import re
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable

from . import patch as P
from .data import Data, qualified_path, resolve_path
from .grammar import analyze as grammar_analyze

__all__ = ["mulberry32", "fnv1a", "EmitResult", "emit_candidates",
           "sample_value", "direction_sign", "substitute_template",
           "STRATEGY_CONFIG"]


# --------------------------------------------------------------------------
# the seeded RNG -- the same mulberry32/FNV-1a pair as mb_rng.h and solver.js
# --------------------------------------------------------------------------

_U32 = 0xFFFFFFFF


def _imul(a: int, b: int) -> int:
    """Math.imul: the low 32 bits of a 32-bit multiply. Sign is irrelevant --
    the low 32 bits are the same either way -- so everything here stays
    unsigned and the bit patterns match the reference exactly."""
    return ((a & _U32) * (b & _U32)) & _U32


def fnv1a(text: str) -> int:
    """FNV-1a over UTF-16 code units, matching the reference's charCodeAt loop.
    Every stream name the loop builds is ASCII, where that is also byte-wise
    FNV-1a and therefore the same function `mb_rng.h` implements in C."""
    h = 2166136261
    for ch in text:
        h = _imul(h ^ ord(ch), 16777619)
    return h & _U32


def mulberry32(seed: int) -> Callable[[], float]:
    """The generator the simulator, the solver and this emitter all share.
    Changing it silently re-keys every archived candidate, so it is a versioned
    contract, not an implementation detail."""
    state = seed & _U32

    def draw() -> float:
        nonlocal state
        state = (state + 0x6D2B79F5) & _U32
        a = state
        t = _imul(a ^ (a >> 15), 1 | a)
        t = ((t + _imul(t ^ (t >> 7), 61 | t)) & _U32) ^ t
        return ((t ^ (t >> 14)) & _U32) / 4294967296.0

    return draw


# --------------------------------------------------------------------------
# slot filling
# --------------------------------------------------------------------------

# Per strategy: which template slot holds the move, which holds the tuned
# field, how that field is picked, and (for realized-value) which number in
# the signal text is the "measured" value toward-parity compares to a band
# midpoint. `matchup-counterplay` is deliberately absent: its pairing-specific
# interaction terms are not derivable from the data available here, so it is
# skipped with a printed reason rather than guessed at.
STRATEGY_CONFIG: dict[str, dict[str, Any]] = {
    "single-button-value": {"move_slot": "move", "param_slot": "flagged_param",
                            "picker": "flagged"},
    "realized-value": {"move_slot": "move", "param_slot": "dominance_driver_param",
                       "picker": "flagged", "measured": "spam_parity"},
    "power-budget": {"move_slot": "top_dominance_move", "param_slot": "param",
                     "picker": "dominant", "char_only": True},
    "engagement": {"move_slot": "move", "param_slot": "engagement_param",
                   "picker": "dominant", "char_only": True},
}

AI_PARAM_CHOICE = "block_chance"

_SLOT_RE = re.compile(r"<([a-zA-Z_]+)>")


def substitute_template(template: str, slots: dict[str, Any]) -> tuple[str, str | None]:
    """Returns (text, missing). A slot with no value is left LITERAL so the
    legal-patch check rejects it, instead of being dropped or redirected."""
    missing: str | None = None

    def repl(m: re.Match[str]) -> str:
        nonlocal missing
        name = m.group(1)
        if name not in slots or slots[name] is None:
            if missing is None:
                missing = name
            return f"<{name}>"
        return str(slots[name])

    return _SLOT_RE.sub(repl, template), missing


def _extract_char_move(text: str) -> tuple[str, str] | None:
    m = re.search(r"([A-Za-z][A-Za-z0-9_]*)/spam-([A-Za-z][A-Za-z0-9_]*)", text)
    if m:
        return m.group(1), m.group(2)
    m = re.search(r"([A-Za-z][A-Za-z0-9_]*)/([A-Za-z][A-Za-z0-9_]*)\s+static dominance", text)
    if m:
        return m.group(1), m.group(2)
    m = re.search(r"([A-Za-z][A-Za-z0-9_]*)/([A-Za-z][A-Za-z0-9_]*)\s*\[", text)
    if m:
        return m.group(1), m.group(2)
    return None


def _extract_char(text: str) -> str | None:
    m = re.search(r"(?:CHARACTER|TIMEOUTS):\s*([A-Za-z][A-Za-z0-9_]*)", text)
    if m:
        return m.group(1)
    m = re.match(r"^([A-Za-z][A-Za-z0-9_]*)/", re.sub(r"^[a-z-]+:\s*", "", text))
    return m.group(1) if m else None


def _extract_victim(text: str) -> str | None:
    m = re.search(r"beats\s+([A-Za-z][A-Za-z0-9_]*)/default", text)
    return m.group(1) if m else None


def _extract_spam_parity_pct(text: str) -> int | None:
    m = re.search(r"spam parity (\d+)%", text)
    return int(m.group(1)) if m else None


def _top_dominance_move(framedata: dict[str, Any], cid: str) -> dict[str, Any] | None:
    moves = [m for m in framedata["moves"] if m["id"].startswith(cid + "/")]
    if not moves:
        return None
    return sorted(moves, key=lambda m: -(m.get("dominance") or 0.0))[0]


def _pick_flagged_param(framedata: dict[str, Any], char: str,
                        move: str) -> dict[str, str] | None:
    rec = next((m for m in framedata["moves"] if m["id"] == f"{char}/{move}"), None)
    if not rec or not rec.get("envelopeViolations"):
        return None
    m = re.match(r"^([a-zA-Z_]+)\s*=", rec["envelopeViolations"][0])
    if not m:
        return None
    env_field = m.group(1)
    yaml_field = P.REVERSE_FIELD_MAP.get(env_field)
    if not yaml_field:
        return None
    return {"field": yaml_field, "cls": rec["cls"], "envelope_field": env_field}


def _pick_dominant_param(data: Data, framedata: dict[str, Any], char: str,
                         move: str) -> dict[str, str] | None:
    """Fallback picker: the field furthest (relatively) from its class-band
    centre. Used when the target move has no recorded envelope violation --
    `power-budget` and `engagement` name a CHARACTER, not a flagged param."""
    got = _pick_flagged_param(framedata, char, move)
    if got:
        return got
    rec = next((m for m in framedata["moves"] if m["id"] == f"{char}/{move}"), None)
    if not rec:
        return None
    band_set = data.balance["classes"][rec["cls"]]
    best = None
    best_score = float("-inf")
    root = data.as_root()
    for env_field in P.ENVELOPE_FIELDS:
        yaml_field = P.REVERSE_FIELD_MAP[env_field]
        band = band_set.get(env_field)
        if not band:
            continue
        found, value = resolve_path(root, qualified_path(
            f"data/characters/{char}.yaml", f"moves.{move}.{yaml_field}"))
        if not found or not isinstance(value, (int, float)) or isinstance(value, bool):
            continue
        mid = (band[0] + band[1]) / 2
        half = (band[1] - band[0]) / 2 or 1
        score = abs(value - mid) / half
        if score > best_score:
            best_score = score
            best = {"field": yaml_field, "cls": rec["cls"], "envelope_field": env_field}
    return best


@dataclass
class _Candidate:
    file: str
    path: str
    unresolved: str | None
    hit_text: str
    slots: dict[str, Any]
    char: str | None = None
    move: str | None = None
    cls: str | None = None
    envelope_field: str | None = None
    situ_band: list[float] | None = None
    measured: int | None = None
    target: str | None = None


def _fill_slots(st: dict[str, Any], situ: dict[str, Any], framedata: dict[str, Any],
                data: Data) -> list[_Candidate]:
    cfg = STRATEGY_CONFIG.get(st["id"])
    if not cfg:
        return []
    situ_band = None
    for d in situ.get("detect", []):
        if isinstance(d.get("pattern"), dict) and d["pattern"].get("band"):
            situ_band = d["pattern"]["band"]
            break

    out: list[_Candidate] = []
    seen: set[str] = set()
    for hit in situ["hits"]:
        if cfg.get("char_only"):
            char = _extract_char(hit)
            if not char:
                continue
            top = _top_dominance_move(framedata, char)
            if not top:
                continue
            move = top["id"].split("/")[1]
        else:
            cm = _extract_char_move(hit)
            if not cm:
                continue
            char, move = cm

        param = (_pick_flagged_param(framedata, char, move)
                 if cfg["picker"] == "flagged"
                 else _pick_dominant_param(data, framedata, char, move))
        if not param:
            continue
        target = f"{char}/{move}/{param['field']}"
        if target in seen:
            continue
        seen.add(target)

        slots = {"char": char, cfg["move_slot"]: move, cfg["param_slot"]: param["field"]}
        file_text, file_missing = substitute_template(st["patch"]["file"], slots)
        path_text, path_missing = substitute_template(st["patch"]["path"], slots)
        out.append(_Candidate(
            file=file_text, path=path_text,
            unresolved=file_missing or path_missing,
            hit_text=hit, slots=slots, char=char, move=move, cls=param["cls"],
            envelope_field=param["envelope_field"], situ_band=situ_band,
            measured=(_extract_spam_parity_pct(hit)
                      if cfg.get("measured") == "spam_parity" else None),
            target=target))
    return out


def _fill_slots_defense_gap(st: dict[str, Any], situ: dict[str, Any]) -> list[_Candidate]:
    """`defense-gap` is the one ai-param strategy. Its template targets
    `data/strategies.yaml`, which under the ported schema holds the primitive
    strategies' own params -- so the slot is filled faithfully per the grammar
    and the verifier's schema check is what accepts or rejects it. Nothing is
    silently redirected to the character `ai:` block."""
    out: list[_Candidate] = []
    seen: set[str] = set()
    for hit in situ["hits"]:
        victim = _extract_victim(hit)
        if not victim:
            continue
        target = f"{victim}/{AI_PARAM_CHOICE}"
        if target in seen:
            continue
        seen.add(target)
        slots = {"victim_default_strategy": "passive.params",
                 "ai_param": AI_PARAM_CHOICE}
        file_text, file_missing = substitute_template(st["patch"]["file"], slots)
        path_text, path_missing = substitute_template(st["patch"]["path"], slots)
        out.append(_Candidate(file=file_text, path=path_text,
                              unresolved=file_missing or path_missing,
                              hit_text=hit, slots=slots, char=victim, target=target))
    return out


# --------------------------------------------------------------------------
# direction and magnitude sampling
# --------------------------------------------------------------------------

def direction_sign(direction: str, before: float, env_band: list[float] | None,
                   situ_band: list[float] | None,
                   measured: int | None) -> int | None:
    if direction == "raise":
        return 1
    if direction == "lower":
        return -1
    if direction == "toward-envelope":
        if not env_band:
            return None
        return 1 if before <= (env_band[0] + env_band[1]) / 2 else -1
    if direction == "toward-parity":
        if situ_band and measured is not None:
            return -1 if measured > (situ_band[0] + situ_band[1]) / 2 else 1
        if env_band:
            return 1 if before <= (env_band[0] + env_band[1]) / 2 else -1
        return None
    return None


def _normalize(value: float, ref: Any) -> Any:
    if isinstance(ref, int) and not isinstance(ref, bool):
        import math
        return int(math.floor(value + 0.5))
    return round(value, 3)


def sample_value(rng: Callable[[], float], before: Any, direction: str,
                 env_band: list[float] | None, situ_band: list[float] | None,
                 measured: int | None, max_step: float,
                 magnitude_frac: float) -> dict[str, Any]:
    """{value, draws, used_direction} or {failed, draws, reason}.

    Up to 16 draws: a sample that lands on the current value, or outside the
    class envelope, is discarded and re-drawn. Every draw taken is recorded on
    the patch, so a candidate is replayable from its manifest alone."""
    if direction == "clamp-to-envelope":
        if not env_band:
            return {"failed": True, "draws": [],
                    "reason": "clamp-to-envelope requires an envelope"}
        edge = (env_band[0] if before < env_band[0]
                else env_band[1] if before > env_band[1] else None)
        if edge is None:
            return {"failed": True, "draws": [],
                    "reason": "value does not violate its envelope"}
        return {"value": _normalize(edge, before), "draws": [],
                "used_direction": "clamp-to-envelope"}

    used_direction = direction
    sign = direction_sign(direction, before, env_band, situ_band, measured)
    if direction == "toward-parity" and not (situ_band and measured is not None):
        used_direction = "toward-envelope" if env_band else "toward-parity"
    if sign is None:
        sign = 1        # documented fallback: an undecidable direction raises

    span = (env_band[1] - env_band[0]) if env_band else \
        (magnitude_frac * abs(before) or magnitude_frac)
    draws: list[float] = []
    for _ in range(16):
        r = rng()
        draws.append(r)
        v = _normalize(before + r * max_step * span * sign, before)
        if v == before:
            continue
        if env_band and (v < env_band[0] or v > env_band[1]):
            continue
        return {"value": v, "draws": draws, "used_direction": used_direction}
    return {"failed": True, "draws": draws,
            "reason": "exhausted 16 draws without a legal value"}


# --------------------------------------------------------------------------
# emission
# --------------------------------------------------------------------------

@dataclass
class EmitResult:
    patches: list[dict[str, Any]] = field(default_factory=list)
    dirs: list[Path] = field(default_factory=list)
    counts: dict[str, int] = field(default_factory=dict)
    log: list[str] = field(default_factory=list)


def emit_candidates(*, grammar: dict[str, Any], data: Data, pins: dict[str, Any],
                    report: dict[str, Any], framedata: dict[str, Any], seed: int,
                    out_dir: Path, count: int, max_step: float = 0.25,
                    magnitude_frac: float = 0.15,
                    board: list[dict[str, Any]] | None = None,
                    emitted_at: str | None = None) -> EmitResult:
    """Emits up to `count` legal candidate patch directories under `out_dir`.

    Situations are visited in descending weight x signals (ties by grammar
    order), which is the playbook's "highest-priority situation with an
    applicable strategy". Zero candidates is a legitimate outcome, reported
    with the reasons."""
    out_dir = Path(out_dir)
    from .tournament import spam_board
    ctx = {"report": report, "framedata": framedata,
           "board": board if board is not None else spam_board(report)}
    A = grammar_analyze(grammar, ctx)

    order = sorted(enumerate(A["situations"]),
                   key=lambda kv: (-(kv[1]["weight"] * kv[1]["signals"]), kv[0]))
    by_id = {s["id"]: s for s in grammar["strategies"]}

    result = EmitResult(counts={"pinned": 0, "envelope": 0, "schema": 0,
                                "layer": 0, "unfillable": 0})
    stamp = emitted_at or datetime.now(timezone.utc).isoformat(timespec="seconds")

    def log(line: str) -> None:
        result.log.append(line)

    for _, situ in order:
        if len(result.patches) >= count:
            break
        if not situ["signals"]:
            continue
        for strat_id in situ["strategies"]:
            if len(result.patches) >= count:
                break
            st = by_id.get(strat_id)
            if not st or not st.get("patch"):
                continue
            if st["patch"]["layer"] not in P.EMITTABLE_LAYERS:
                log(f'skip {strat_id} ({situ["id"]}): layer '
                    f'"{st["patch"]["layer"]}" is not emitted '
                    f"(class-envelope deferred by spec)")
                continue

            candidates = (_fill_slots_defense_gap(st, situ) if strat_id == "defense-gap"
                          else _fill_slots(st, situ, framedata, data))
            if not candidates:
                log(f'skip {strat_id} ({situ["id"]}): could not fill the patch '
                    f"template slots from the signal(s)")
                result.counts["unfillable"] += 1
                continue

            for cand in candidates:
                if len(result.patches) >= count:
                    break
                p = _emit_one(cand, st, situ, data, pins, seed, out_dir,
                              len(result.patches) + 1, grammar["version"],
                              max_step, magnitude_frac, stamp, result, log)
                if p is not None:
                    result.patches.append(p[0])
                    result.dirs.append(p[1])

    log(f"{len(result.patches)} candidate(s) emitted to {out_dir}; rejected: "
        + ", ".join(f"{v} {k}" for k, v in result.counts.items()))
    return result


def _emit_one(cand: _Candidate, st: dict[str, Any], situ: dict[str, Any],
              data: Data, pins: dict[str, Any], seed: int, out_dir: Path, n: int,
              grammar_version: int, max_step: float, magnitude_frac: float,
              stamp: str, result: EmitResult,
              log: Callable[[str], None]) -> tuple[dict[str, Any], Path] | None:
    if cand.unresolved:
        result.counts["schema"] += 1
        log(f'INVALID: schema -- {st["id"]} ({situ["id"]}) template has no value '
            f"for slot <{cand.unresolved}>")
        return None

    ed_loc = {"file": cand.file, "path": cand.path}
    pin_hit = next((p for p in pins.get("pins", []) if P.pin_matches(ed_loc, p)), None)
    if pin_hit:
        result.counts["pinned"] += 1
        log(f'REJECTED (pinned "{pin_hit["id"]}"): {cand.file} {cand.path}')
        return None

    found, before = resolve_path(data.as_root(), qualified_path(cand.file, cand.path))
    if not found or not isinstance(before, (int, float)) or isinstance(before, bool):
        result.counts["schema"] += 1
        log(f"INVALID: schema -- {cand.file} {cand.path} does not resolve to an "
            f"existing numeric leaf")
        return None

    env_band = None
    if st["id"] != "defense-gap" and cand.envelope_field:
        env_band = data.balance["classes"].get(cand.cls, {}).get(cand.envelope_field)

    target = cand.target or f"{cand.char}/{cand.path}"
    stream = f"emit:{target}:{n:04d}"
    rng = mulberry32(fnv1a(f"{seed}|{stream}"))
    sampled = sample_value(rng, before, st["patch"]["direction"], env_band,
                           cand.situ_band, cand.measured, max_step, magnitude_frac)
    if sampled.get("failed"):
        result.counts["envelope"] += 1
        log(f'INVALID: envelope -- {cand.file} {cand.path} ({sampled["reason"]})')
        return None

    edit: dict[str, Any] = {
        "file": cand.file, "path": cand.path, "before": before,
        "after": sampled["value"], "envelope": env_band,
        "direction": sampled["used_direction"],
    }
    if st["id"] != "defense-gap":
        edit["class"] = cand.cls

    patch_obj = {
        "schema": P.SCHEMA,
        "id": f"p-{n:04d}",
        "grammar_version": grammar_version,
        "situation": situ["id"],
        "strategy": st["id"],
        "signal": cand.hit_text,
        "layer": st["patch"]["layer"],
        "edits": [edit],
        "solver_relevant": P.solver_relevant([edit]),
        "rng": {"seed": seed, "stream": stream, "draws": sampled["draws"]},
        "emitted_at": stamp,
        "lineage": {"parent_round": None, "height": None, "lineage_id": None},
    }

    reasons = P.verify(patch_obj, data, pins)
    if reasons:
        if any(r.startswith("pinned:") for r in reasons):
            result.counts["pinned"] += 1
        elif any(r.startswith("envelope:") for r in reasons):
            result.counts["envelope"] += 1
        elif any(r.startswith("layer:") for r in reasons):
            result.counts["layer"] += 1
        else:
            result.counts["schema"] += 1
        log("INVALID: " + "; ".join(reasons))
        return None

    patch_dir = out_dir / patch_obj["id"]
    patch_dir.mkdir(parents=True, exist_ok=True)
    import json
    (patch_dir / "patch.json").write_text(
        json.dumps(patch_obj, indent=2) + "\n", encoding="ascii")
    P.write_overlay_file(patch_dir, edit["file"],
                         P.build_overlay_tree(edit["file"], edit["path"], edit["after"]))
    log(f'EMITTED {patch_obj["id"]}: {st["id"]} ({situ["id"]}) {edit["file"]} '
        f'{edit["path"]} {edit["before"]} -> {edit["after"]}')
    return patch_obj, patch_dir
"""Static frame-data analysis -- pure math over the canonical move YAML.

A 1:1 port of `web/monkey-baiting/test/framedata.js` (read-only reference per
ruling 7(c)). It simulates nothing: it is arithmetic over authored numbers, so
it does not depend on `sim_version` and does not need the C simulator. Two of
its outputs are load-bearing for the loop:

  - `envelopeViolations` per move (against `data/balance.yaml` class boxes) --
    the legal-patch verifier's envelope check and the emitter's flagged-param
    picker both read it;
  - `dominance` per move (share of the pairwise offset x distance space won)
    -- the emitter's fallback param picker and the `power-budget` /
    `engagement` strategies pick their target move by it.

MECHANICS MODELLED, and the deliberate approximations, are unchanged from the
reference's header: startup/active/recovery commitment, reach from hitbox and
hurtbox geometry, move_forward and leap displacement, multi-hit, armour,
stances, grabs (grip resistance during the ripple window), chain yank,
blockstun vs hitstun. Pushback/knockback separation, hazard and retreat moves,
hit_freeze and AI movement are skipped, as documented there.

Output shape matches `test/framedata.js --json` because the grammar consumes
it as `ctx.framedata` and the archive stores it as a re-scorable detector
input.
"""

from __future__ import annotations

import math
from typing import Any

from .data import Data

__all__ = ["ZONE_TYPES", "move_class", "analyze", "framedata_json"]

ZONE_TYPES = ("hazard_rats", "hazard_coins", "retreat")

_ENVELOPE_CHECKS = ("startup_frames", "active_frames", "recovery_frames",
                    "damage_total", "base_knockback", "hitstun", "cooldown")


def move_class(key: str) -> str:
    return key if key in ("light", "heavy", "special") else "extra"


class Move:
    """One analysed move. Attribute names follow the reference so the JSON
    shape and the emitter's field lookups stay recognisable."""

    __slots__ = ("char", "key", "id", "cls", "m", "hits", "total", "dmg_total",
                 "reach", "last_hit_at", "on_hit", "on_block", "plus_on_block",
                 "dpf", "exposure", "reward_risk", "grip", "ripple", "hurt_w",
                 "punishers", "dominance", "block_line", "envelope_violations",
                 "moves_by_char")

    def __init__(self, **kw: Any) -> None:
        for k, v in kw.items():
            setattr(self, k, v)
        self.punishers: list[dict[str, Any]] = []
        self.dominance = 0.0
        self.block_line = ""
        self.envelope_violations: list[str] = []
        self.moves_by_char: dict[str, Move] = {}


def _build_moves(data: Data) -> list[Move]:
    out: list[Move] = []
    for cid in data.character_ids:
        chr_ = data.characters[cid]
        for key, m in chr_["moves"].items():
            hits = m.get("hits", 1)
            total = m["startup_frames"] + m["active_frames"] + m["recovery_frames"]
            dmg_total = m["damage"] if m["type"] == "grab" else m["damage"] * hits
            if m["type"] in ZONE_TYPES:
                reach = 0.0
            elif m["type"] == "chain_yank":
                reach = 400.0
            else:
                leap = abs(m["leap"]["vx"]) * m["active_frames"] if m.get("leap") else 0.0
                reach = max(2.0, m["hitbox"]["x"] + m["hitbox"]["w"]
                            - chr_["hurtbox"]["w"] / 2 + leap)
            last_hit_at = m["startup_frames"] + (hits - 1) * m.get("hit_interval", 0)
            remaining = total - last_hit_at - 1
            if m["type"] == "stance" or m["type"] in ZONE_TYPES:
                on_hit = None
            elif m["type"] == "grab":
                on_hit = m["hitstun"]
            else:
                on_hit = m["hitstun"] - remaining
            if (m.get("unblockable") or m["type"] == "grab" or m["type"] == "stance"
                    or m["type"] in ZONE_TYPES):
                on_block = None
            else:
                on_block = m["blockstun"] - remaining
            mechanics = chr_.get("mechanics") or {}
            out.append(Move(
                char=cid, key=key, id=f"{cid}/{key}", cls=move_class(key), m=m,
                hits=hits, total=total, dmg_total=dmg_total,
                reach=int(round(reach)), last_hit_at=last_hit_at,
                on_hit=on_hit, on_block=on_block,
                plus_on_block=on_block is not None and on_block > 0,
                dpf=dmg_total / total,
                exposure=m["recovery_frames"],
                reward_risk=(dmg_total / m["recovery_frames"]
                             if m["recovery_frames"] > 0 else dmg_total),
                grip=chr_["grip_resistance"],
                ripple=mechanics.get("ripple_frames", 0) or 0,
                hurt_w=chr_["hurtbox"]["w"]))
    return out


def _punishability(moves: list[Move]) -> None:
    for mv in moves:
        window = None if mv.on_block is None else -mv.on_block
        mv.punishers = []
        if window is None or window <= 0:
            continue
        for p in moves:
            if p.char == mv.char:
                continue
            if p.m["type"] in ZONE_TYPES or p.m["type"] == "stance":
                continue
            margin = window - p.m["startup_frames"]
            if margin >= 0:
                mv.punishers.append({"id": p.id, "margin": margin})
        mv.punishers.sort(key=lambda x: -x["margin"])


# --------------------------------------------------------------------------
# the pairwise exchange solver
# --------------------------------------------------------------------------

def _plans(mv: Move) -> list[list[dict[str, Any]]]:
    base = [{"mv": mv, "at": 0, "until": None}]
    out = [base]
    cancel = mv.m.get("cancel")
    if cancel and cancel.get("into"):
        c = cancel["window"][0]
        target = mv.moves_by_char.get(cancel["into"][0])
        if target is not None:
            out.append([{"mv": mv, "at": 0, "until": c},
                        {"mv": target, "at": c, "until": None}])
    return out


def _seg_at(plan: list[dict[str, Any]], t: int) -> dict[str, Any] | None:
    for i in range(len(plan) - 1, -1, -1):
        s = plan[i]
        if t >= s["at"] and (s["until"] is None or t < s["until"] or i == len(plan) - 1):
            return {"mv": s["mv"], "lt": t - s["at"]}
    return None


def _phase_of(mv: Move, lt: int) -> str:
    m = mv.m
    if lt < 0:
        return "pre"
    if lt < m["startup_frames"]:
        return "wind"
    if lt < m["startup_frames"] + m["active_frames"]:
        return "act"
    if lt < mv.total:
        return "rec"
    return "done"


def _connects(s, phase, gap, used, foe_seg, foe_phase) -> bool:
    if s is None or phase != "act":
        return False
    m = s["mv"].m
    if m["type"] in ZONE_TYPES or m["type"] == "stance":
        return False
    if m["type"] == "chain_yank":
        airborne = foe_seg is not None and foe_seg["mv"].m.get("leap") and foe_phase == "act"
        if used.get("y"):
            return False
        used["y"] = True
        return not airborne
    if gap > s["mv"].reach:
        return False
    hits = m.get("hits", 1)
    idx = int((s["lt"] - m["startup_frames"]) // m["hit_interval"]) if hits > 1 else 0
    if idx >= hits:
        return False
    key = f"h{idx}"
    if used.get(key):
        return False
    if (m["type"] == "grab" and foe_seg is not None
            and foe_seg["mv"].grip >= 9 and foe_seg["mv"].ripple > 0):
        fm = foe_seg["mv"].m
        if foe_phase == "wind" and foe_seg["lt"] >= fm["startup_frames"] - foe_seg["mv"].ripple:
            used[key] = True
            return False
    used[key] = True
    return True


def _apply_hit(att, deff, def_phase) -> str | None:
    """'A' when the attacker's hit stuns, 'B' when the defender wins anyway
    (stance return), None when armoured through."""
    if deff is None:
        return "A"
    dm = deff["mv"].m
    if att["mv"].m["type"] in ("grab", "chain_yank"):
        return "A"
    if dm["type"] == "stance" and def_phase == "act":
        return "B"
    armor = dm.get("armor_frames")
    if armor and armor[0] <= deff["lt"] <= armor[1]:
        return None
    if "armor_if_health_above" in dm and def_phase == "act":
        return None
    return "A"


def _resolve_cell(plan_a, plan_b, offset: int, dist: float) -> str:
    adv_a = 0.0
    adv_b = 0.0
    used_a: dict[str, bool] = {}
    used_b: dict[str, bool] = {}
    end = 0
    for s in plan_a:
        end = max(end, s["at"] + s["mv"].total)
    for s in plan_b:
        end = max(end, offset + s["at"] + s["mv"].total)
    end += 1

    for t in range(end):
        sa = _seg_at(plan_a, t)
        sb = _seg_at(plan_b, t - offset)
        pa = _phase_of(sa["mv"], sa["lt"]) if sa else "done"
        pb = _phase_of(sb["mv"], sb["lt"]) if sb else "done"
        if sa and pa == "act":
            m = sa["mv"].m
            adv_a += (m.get("move_forward") or 0) + (abs(m["leap"]["vx"]) if m.get("leap") else 0)
        if sb and pb == "act":
            m = sb["mv"].m
            adv_b += (m.get("move_forward") or 0) + (abs(m["leap"]["vx"]) if m.get("leap") else 0)
        gap = dist - adv_a - adv_b

        hit_a = _connects(sa, pa, gap, used_a, sb, pb)
        hit_b = _connects(sb, pb, gap, used_b, sa, pa)
        if hit_a and hit_b:
            return "trade"
        if hit_a:
            r = _apply_hit(sa, sb, pb)
            if r:
                return r
        if hit_b:
            r2 = _apply_hit(sb, sa, pa)
            if r2:
                return "B" if r2 == "A" else "A"
    return "none"


def _solve_pairs(moves: list[Move], offsets: int = 30) -> list[dict[str, Any]]:
    off_max, off_step = offsets, 3
    by_char: dict[str, dict[str, Move]] = {}
    for mv in moves:
        by_char.setdefault(mv.char, {})[mv.key] = mv
    for mv in moves:
        mv.moves_by_char = by_char[mv.char]

    pairs: list[dict[str, Any]] = []
    plans_cache = {mv.id: _plans(mv) for mv in moves}
    for a in moves:
        for b in moves:
            if a is b or a.char == b.char:
                continue
            rs = [r for r in (a.reach, b.reach) if 0 < r < 400]
            base = rs if rs else [20]
            dists: list[float] = []
            for r in base:
                dists.append(max(2.0, r * 0.5))
                dists.append(max(4.0, r * 0.95))
            dists.append(max(base) * 1.3)
            seen: list[float] = []
            for d in dists:
                if d not in seen:
                    seen.append(d)
            dists = sorted(seen)

            w = l = tr = no = cells = 0
            plans_a, plans_b = plans_cache[a.id], plans_cache[b.id]
            for o in range(-off_max, off_max + 1, off_step):
                for d in dists:
                    cells += 1
                    best = None
                    for pa in plans_a:
                        worst = None
                        for pb in plans_b:
                            r = _resolve_cell(pa, pb, o, d)
                            score = 2 if r == "A" else 1 if r == "trade" else 0.8 if r == "none" else 0
                            if worst is None or score < worst[1]:
                                worst = (r, score)
                        if best is None or worst[1] > best[1]:
                            best = worst
                    if best[0] == "A":
                        w += 1
                    elif best[0] == "B":
                        l += 1
                    elif best[0] == "trade":
                        tr += 1
                    else:
                        no += 1
            pairs.append({"a": a.id, "b": b.id, "cells": cells,
                          "aWin": w, "bWin": l, "trade": tr, "none": no})

    by_a: dict[str, tuple[float, int]] = {}
    for p in pairs:
        w, n = by_a.get(p["a"], (0.0, 0))
        by_a[p["a"]] = (w + p["aWin"] + p["trade"] * 0.5, n + p["cells"])
    for mv in moves:
        w, n = by_a.get(mv.id, (0.0, 0))
        mv.dominance = (w / n) if n else 0.0
    return pairs


def _vs_block(mv: Move) -> str:
    m = mv.m
    if m["type"] in ZONE_TYPES or m["type"] == "stance":
        return "no-threat"
    if m["type"] in ("grab", "chain_yank") or m.get("unblockable"):
        return "BEATS BLOCK"
    if mv.plus_on_block:
        return f"PLUS ON BLOCK (+{mv.on_block})"
    if not mv.punishers:
        return f"safe ({mv.on_block})"
    return (f"punishable ({mv.on_block}, by {len(mv.punishers)} moves, worst +"
            f"{mv.punishers[0]['margin']}f: {mv.punishers[0]['id']})")


def _envelope(data: Data, mv: Move) -> list[str]:
    cls = data.balance["classes"][mv.cls]
    checks = {
        "startup_frames": mv.m["startup_frames"],
        "active_frames": mv.m["active_frames"],
        "recovery_frames": mv.m["recovery_frames"],
        "damage_total": mv.dmg_total,
        "base_knockback": mv.m["base_knockback"],
        "hitstun": mv.m["hitstun"],
        "cooldown": mv.m["cooldown"],
    }
    viol: list[str] = []
    for field_name in _ENVELOPE_CHECKS:
        v = checks[field_name]
        band = cls[field_name]
        if v < band[0]:
            viol.append(f"{field_name}={_num(v)} < {_num(band[0])}")
        if v > band[1]:
            viol.append(f"{field_name}={_num(v)} > {_num(band[1])}")
    cancel = mv.m.get("cancel")
    if cancel and not cls["cancel_allowed"]:
        viol.append(f"cancel not allowed for class {mv.cls}")
    if cancel and (cancel["window"][1] - cancel["window"][0]) > cls["cancel_window_max"]:
        viol.append(f"cancel window > {_num(cls['cancel_window_max'])}")
    return viol


def _num(v: Any) -> str:
    """JS number formatting: integral floats print without a decimal point, so
    a ported violation string is comparable with the reference's."""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, float):
        if math.isfinite(v) and v == int(v):
            return str(int(v))
        return repr(round(v, 10)).rstrip("0").rstrip(".") if "." in repr(v) else str(v)
    return str(v)


def analyze(data: Data, offsets: int = 30) -> dict[str, Any]:
    moves = _build_moves(data)
    _punishability(moves)
    pairs = _solve_pairs(moves, offsets)
    for mv in moves:
        mv.block_line = _vs_block(mv)
        mv.envelope_violations = _envelope(data, mv)
    return {"moves": moves, "pairs": pairs}


def framedata_json(result: dict[str, Any]) -> dict[str, Any]:
    """The archived / grammar-visible form, shape-identical to what
    `test/framedata.js --json` wrote."""
    return {
        "moves": [{
            "id": mv.id, "cls": mv.cls,
            "startup": mv.m["startup_frames"], "active": mv.m["active_frames"],
            "recovery": mv.m["recovery_frames"], "damage_total": mv.dmg_total,
            "dpf": mv.dpf, "reach": mv.reach, "onHit": mv.on_hit,
            "onBlock": mv.on_block, "plusOnBlock": mv.plus_on_block,
            "dominance": mv.dominance, "vsBlock": mv.block_line,
            "punishers": mv.punishers,
            "envelopeViolations": mv.envelope_violations,
        } for mv in result["moves"]],
        "pairs": result["pairs"],
    }
"""The balance grammar: validator, detectors, and the scalar balance score.

A port of `web/monkey-baiting/test/grammar.js` (read-only reference, ruling
7(c)) onto the canonical grammar at `data/balance-grammar.yaml`.

Three jobs, unchanged in substance:

  1. VALIDATE the grammar -- unique ids, situation refs resolve, known detect
     sources carry the right pattern fields, known lever layers, patch
     templates, scoring weights, evidence dates that exist in the findings
     log, compound members that resolve. `detect.source` is an OPEN ENUM: an
     unknown source is legal and simply has no detector yet.
  2. DETECT situations from a tournament report and a framedata pass, and
     reduce them to the BALANCE SCORE -- sum of weight x signal count over the
     scorable situations. LOWER IS BETTER; zero means every band holds.
  3. VALIDATE the tuning ledger -- every entry cites a strategy or compound id
     that exists in the grammar.

RE-BASELINED, NOT PARITY-CHECKED. The scores this produces come from the C
simulator under its own `sim_version` oracle. They are not comparable with any
number the JS stack produced and no attempt is made to reproduce one
(architecture rulings 3, 5(a), 7). What IS preserved is the mapping from
detected situation to weight, so the score still measures what the playbook
reacts to.

MUCH OF GRAMMAR V3 DERIVES FROM OUTCOME AGGREGATES ALONE -- which is why this
port needed no new simulator telemetry. Of the twelve situations, nine are fed
by `tournament-issues` / `spam-parity` / `standings-bands` (win/loss/draw
counts, round and timeout totals, capped matches: every one of them already a
column of an `mb_sim --json` result row), one by `framedata-envelope` (static
math over the YAML, no simulation at all), and the remaining two are manual
by design. No per-match event stream is required, so `mb_sim` is unchanged and
`sim_version` stays `mb-1`.
"""

from __future__ import annotations

import re
from pathlib import Path
from typing import Any

from . import yamlio
from .tournament import round_half_up, spam_board

__all__ = ["GrammarError", "load_grammar", "validate_grammar", "detect",
           "analyze", "per_situation", "findings_dates", "validate_ledger",
           "SOURCES", "LAYERS"]


class GrammarError(Exception):
    """A grammar file that cannot be loaded at all."""


# source -> {required pattern keys, optional pattern keys, manual}
SOURCES: dict[str, dict[str, Any]] = {
    "tournament-issues": {"required": ["category"], "optional": ["match"]},
    "spam-parity": {"required": ["band", "direction"],
                    "optional": ["requires", "top_dominance"]},
    "standings-bands": {"required": ["metric", "band"], "optional": ["label_prefix"]},
    "framedata-envelope": {"required": ["min_violations", "field"], "optional": []},
    "solver-matrix": {"required": ["manual", "rule"], "optional": [], "manual": True},
    "solver-convergence": {"required": ["manual", "rule"], "optional": [], "manual": True},
}

LAYERS = ["move-param", "class-envelope", "model-mechanics", "solver-params",
          "objective", "no-tune", "ai-param", "match-rules"]
DIRECTIONS = ["above", "below", "outside"]
METRICS = ["bot-label-aggregate", "perfect-matchup", "default-matchup"]
PATCH_DIRECTIONS = ["raise", "lower", "toward-envelope", "toward-parity",
                    "clamp-to-envelope"]
PATCH_FIELDS = ["layer", "file", "path", "direction", "format"]


def load_grammar(path: Path) -> dict[str, Any]:
    doc = yamlio.load(Path(path))
    if not isinstance(doc, dict):
        raise GrammarError(f"{path}: grammar document is not a map")
    return doc


# --------------------------------------------------------------------------
# validation
# --------------------------------------------------------------------------

def _is_str(v: Any) -> bool:
    return isinstance(v, str) and v.strip() != ""


def validate_grammar(G: dict[str, Any], findings: list[str] | None,
                     errors: list[str]) -> dict[str, Any]:
    """Appends every problem to `errors` and returns the resolved id tables.
    No silent fallbacks: a malformed field is an error, not a default."""
    def err(msg: str) -> None:
        errors.append(msg)

    if not isinstance(G, dict):
        err("grammar: document is not a map")
        return {}
    if not isinstance(G.get("version"), int) or isinstance(G.get("version"), bool):
        err('grammar: missing numeric "version"')
    for key in ("situations", "strategies", "compounds"):
        if not isinstance(G.get(key), list):
            err(f'grammar: "{key}" must be a list (compounds may be [])')
    if errors:
        return {}

    sit_ids: dict[str, dict[str, bool]] = {}
    str_ids: dict[str, bool] = {}
    cmp_ids: dict[str, bool] = {}

    for i, s in enumerate(G["situations"]):
        at = f"situations[{i}]"
        if not isinstance(s, dict) or not _is_str(s.get("id")):
            err(f"{at}: missing id")
            continue
        at = f"situation {s['id']}"
        if s["id"] in sit_ids:
            err(f"{at}: duplicate id")
        sit_ids[s["id"]] = {"used": False}
        if not _is_str(s.get("summary")):
            err(f"{at}: missing summary")
        detects = s.get("detect")
        if not isinstance(detects, list) or not detects:
            err(f"{at}: detect must be a non-empty list")
            continue
        for j, d in enumerate(detects):
            dat = f"{at}.detect[{j}]"
            if not isinstance(d, dict) or not _is_str(d.get("source")):
                err(f"{dat}: missing source")
                continue
            if not isinstance(d.get("pattern"), dict):
                err(f"{dat}: missing pattern map")
                continue
            spec = SOURCES.get(d["source"])
            if spec is None:
                continue  # open enum: unknown source, no detector yet
            pattern = d["pattern"]
            for f in spec["required"]:
                if f not in pattern:
                    err(f'{dat}: pattern missing required field "{f}" for '
                        f'source {d["source"]}')
            for f in pattern:
                if f not in spec["required"] and f not in spec["optional"]:
                    err(f'{dat}: pattern has unknown field "{f}" for source '
                        f'{d["source"]}')
            if "band" in pattern:
                b = pattern["band"]
                if (not isinstance(b, list) or len(b) != 2
                        or not all(isinstance(x, (int, float)) and not isinstance(x, bool)
                                   for x in b) or b[0] > b[1]):
                    err(f"{dat}: band must be [low, high] numbers")
            if "direction" in pattern and pattern["direction"] not in DIRECTIONS:
                err(f"{dat}: direction must be one of {'|'.join(DIRECTIONS)}")
            if "metric" in pattern and pattern["metric"] not in METRICS:
                err(f"{dat}: metric must be one of {'|'.join(METRICS)}")
            if "min_violations" in pattern and not isinstance(
                    pattern["min_violations"], int):
                err(f"{dat}: min_violations must be a number")

    for i, s in enumerate(G["strategies"]):
        at = f"strategies[{i}]"
        if not isinstance(s, dict) or not _is_str(s.get("id")):
            err(f"{at}: missing id")
            continue
        at = f"strategy {s['id']}"
        if s["id"] in str_ids:
            err(f"{at}: duplicate id")
        str_ids[s["id"]] = True
        if not _is_str(s.get("situation")):
            err(f"{at}: missing situation ref")
        elif s["situation"] not in sit_ids:
            err(f'{at}: situation "{s["situation"]}" does not exist')
        else:
            sit_ids[s["situation"]]["used"] = True
        lever = s.get("lever")
        if not isinstance(lever, dict):
            err(f"{at}: missing lever map")
        else:
            if lever.get("layer") not in LAYERS:
                err(f'{at}: lever.layer "{lever.get("layer")}" not one of '
                    f'{"|".join(LAYERS)}')
            if not _is_str(lever.get("change")):
                err(f"{at}: missing lever.change")
        if not _is_str(s.get("rationale")):
            err(f"{at}: missing rationale")
        patch = s.get("patch")
        if patch is not None:
            if not isinstance(patch, dict):
                err(f"{at}: patch must be a map or null")
            else:
                for f in ("layer", "file", "path", "direction"):
                    if not _is_str(patch.get(f)):
                        err(f'{at}: patch missing "{f}"')
                for f in patch:
                    if f not in PATCH_FIELDS:
                        err(f'{at}: patch has unknown field "{f}"')
                if patch.get("layer") and patch["layer"] not in LAYERS:
                    err(f'{at}: patch.layer "{patch["layer"]}" not one of '
                        f'{"|".join(LAYERS)}')
                if patch.get("direction") and patch["direction"] not in PATCH_DIRECTIONS:
                    err(f'{at}: patch.direction "{patch["direction"]}" not one '
                        f'of {"|".join(PATCH_DIRECTIONS)}')
                if patch.get("file") and not str(patch["file"]).startswith("data/"):
                    err(f"{at}: patch.file must be a data/ YAML path")
        evidence = s.get("evidence")
        if not isinstance(evidence, list) or not evidence:
            err(f"{at}: evidence must be a non-empty list of findings-log dates")
        else:
            for d in evidence:
                if not re.match(r"^\d{4}-\d{2}-\d{2}$", str(d)):
                    err(f'{at}: evidence "{d}" is not a YYYY-MM-DD date')
                elif findings is not None and str(d) not in findings:
                    err(f"{at}: evidence date {d} has no entry in the findings log")

    for i, c in enumerate(G["compounds"]):
        at = f"compounds[{i}]"
        if not isinstance(c, dict) or not _is_str(c.get("id")):
            err(f"{at}: missing id")
            continue
        at = f"compound {c['id']}"
        if c["id"] in cmp_ids or c["id"] in str_ids:
            err(f"{at}: id collides with another strategy/compound id")
        cmp_ids[c["id"]] = True
        if not _is_str(c.get("case")):
            err(f"{at}: missing case")
        members = c.get("members")
        if not isinstance(members, list) or len(members) < 2:
            err(f"{at}: members must list at least 2 strategy ids in order")
        else:
            for m in members:
                if m not in str_ids:
                    err(f'{at}: member "{m}" is not a strategy id')

    scoring = G.get("scoring")
    if not isinstance(scoring, dict):
        err('grammar: missing "scoring" map')
    else:
        if not isinstance(scoring.get("default_weight"), (int, float)) or \
                isinstance(scoring.get("default_weight"), bool):
            err("scoring: default_weight must be a number")
        weights = scoring.get("weights")
        if weights is not None:
            if not isinstance(weights, dict):
                err("scoring: weights must be a map of situation id -> number")
            else:
                for k, v in weights.items():
                    if k not in sit_ids:
                        err(f'scoring: weight for "{k}" is not a situation id')
                    if not isinstance(v, (int, float)) or isinstance(v, bool):
                        err(f'scoring: weight for "{k}" is not a number')

    return {"situations": sit_ids, "strategies": str_ids, "compounds": cmp_ids}


# --------------------------------------------------------------------------
# detection
# --------------------------------------------------------------------------

def _out_of_band(v: float, band: list[float], direction: str) -> bool:
    if direction == "above":
        return v > band[1]
    if direction == "below":
        return v < band[0]
    return v < band[0] or v > band[1]


def _pct(w: float, n: float) -> int | None:
    return None if not n else round_half_up(100 * w / n)


def detect(entry: dict[str, Any], ctx: dict[str, Any]) -> dict[str, Any]:
    """One detect[] entry against the context. Returns
    {hits: [...]} or {manual: True} or {unavailable: reason}."""
    p = entry["pattern"]
    spec = SOURCES.get(entry["source"])
    if spec is None:
        return {"unavailable": f'no detector for source "{entry["source"]}"', "hits": []}
    if spec.get("manual"):
        return {"manual": True, "hits": []}

    report = ctx.get("report")
    framedata = ctx.get("framedata")

    if entry["source"] == "tournament-issues":
        if not report:
            return {"unavailable": "no report", "hits": []}
        pre = p["category"] + ":"
        return {"hits": [s for s in report["issues"]
                         if s.startswith(pre) and (not p.get("match") or p["match"] in s)]}

    if entry["source"] == "spam-parity":
        if not report:
            return {"unavailable": "no report", "hits": []}
        board = ctx.get("board") or spam_board(report)
        if p.get("requires") == "framedata":
            if not framedata:
                return {"unavailable": "no framedata", "hits": []}
            top = sorted(framedata["moves"], key=lambda m: -(m.get("dominance") or 0.0))
            top = top[:p["top_dominance"]]
            hits: list[str] = []
            for mv in top:
                parts = str(mv["id"]).split("/")
                wanted = f"{parts[0]}/spam-{parts[1]}"
                for r in board:
                    if r["id"] != wanted:
                        continue
                    if _out_of_band(r["frac"], p["band"], p["direction"]):
                        hits.append(
                            f"{mv['id']} static dominance "
                            f"{round_half_up(mv['dominance'] * 100)}% "
                            f"(top {p['top_dominance']}) but spam parity {r['frac']}%")
            return {"hits": hits}
        return {"hits": [
            f"{r['id']} spam parity {r['frac']}% (beats {r['frac']}% of "
            f"{r['others']} other spam bots)"
            for r in board if _out_of_band(r["frac"], p["band"], p["direction"])]}

    if entry["source"] == "standings-bands":
        if not report:
            return {"unavailable": "no report", "hits": []}
        out: list[str] = []
        if p["metric"] == "bot-label-aggregate":
            labels: list[str] = []
            for e in report["entrants"]:
                if p.get("label_prefix") and not e["label"].startswith(p["label_prefix"]):
                    continue
                if e["label"] not in labels:
                    labels.append(e["label"])
            for lb in labels:
                w = n = 0
                for e in report["entrants"]:
                    if e["label"] != lb:
                        continue
                    s = report["stats"][e["id"]]
                    w += s["wins"]
                    n += s["wins"] + s["losses"]
                v = _pct(w, n)
                if v is not None and _out_of_band(v, p["band"], "outside"):
                    out.append(f'bot class "{lb}" pooled {v}% across all '
                               f'characters (band {p["band"][0]}-{p["band"][1]})')
            return {"hits": out}
        label = "perfect" if p["metric"] == "perfect-matchup" else "default"
        es = [e for e in report["entrants"] if e["label"] == label]
        head = report["head"]
        for a in es:
            for b in es:
                if a["char"] >= b["char"]:
                    continue
                w = head[a["id"]][b["id"]]["w"]
                l = head[b["id"]][a["id"]]["w"]
                if w + l == 0:
                    continue
                v = _pct(w, w + l)
                if _out_of_band(v, p["band"], "outside"):
                    out.append(f'{a["id"]} vs {b["id"]} = {v}/{100 - v} '
                               f'(band {p["band"][0]}-{p["band"][1]})')
        return {"hits": out}

    if entry["source"] == "framedata-envelope":
        if not framedata:
            return {"unavailable": "no framedata", "hits": []}
        fh: list[str] = []
        for mv in framedata["moves"]:
            v = mv.get("envelopeViolations") or []
            if p["field"] != "any":
                v = [s for s in v if str(s).startswith(p["field"])]
            if len(v) >= p["min_violations"]:
                fh.append(f"{mv['id']} [{mv['cls']}] " + "; ".join(v))
        return {"hits": fh}

    raise GrammarError(f"no detector for source {entry['source']}")


def analyze(G: dict[str, Any], ctx: dict[str, Any]) -> dict[str, Any]:
    """Pure function of grammar + context: no I/O, no printing.

    `subscore` is None when a situation is manual or its inputs were
    unavailable this run (reported, never silently scored), else
    hits x weight -- zero when the situation is fully checked and clear."""
    by_situation: dict[str, list[str]] = {}
    for s in G["strategies"]:
        by_situation.setdefault(s["situation"], []).append(s["id"])

    weights = (G["scoring"].get("weights") or {})
    default_weight = G["scoring"]["default_weight"]

    score = 0
    scored = 0
    situations: list[dict[str, Any]] = []
    for s in G["situations"]:
        hits: list[str] = []
        manual = False
        unavailable: list[str] = []
        for d in s["detect"]:
            r = detect(d, ctx)
            if r.get("manual"):
                manual = True
                continue
            if r.get("unavailable"):
                unavailable.append(f"{d['source']} ({r['unavailable']})")
                continue
            for h in r["hits"]:
                hits.append(f"{d['source']}: {h}")
        wt = weights[s["id"]] if isinstance(weights.get(s["id"]), (int, float)) \
            and not isinstance(weights.get(s["id"]), bool) else default_weight
        sub = len(hits) * wt
        counted = bool(hits) or (not manual and not unavailable)
        if counted:
            score += sub
            scored += 1
        situations.append({
            "id": s["id"], "signals": len(hits), "hits": hits, "weight": wt,
            "subscore": sub if counted else None,
            "strategies": by_situation.get(s["id"], []),
            "manual": manual, "unavailable": unavailable,
            "detect": s["detect"],
        })
    return {"version": G["version"], "score": score, "scored": scored,
            "situations": situations}


def per_situation(A: dict[str, Any]) -> list[dict[str, Any]]:
    """The archived per-situation breakdown: only situations that fired."""
    return [{"id": s["id"], "signals": s["signals"], "weight": s["weight"],
             "subscore": s["subscore"], "hits": s["hits"]}
            for s in A["situations"] if s["signals"] > 0]


# --------------------------------------------------------------------------
# the tuning ledger
# --------------------------------------------------------------------------

def _slice_section(md: str, n: int) -> str | None:
    m = re.search(rf"^## {n}\.[^\n]*$", md, re.M)
    if not m:
        return None
    rest = md[m.end():]
    nxt = re.search(r"^## \d", rest, re.M)
    return rest[:nxt.start()] if nxt else rest


def findings_dates(md: str) -> list[str] | None:
    sec = _slice_section(md, 4)
    if sec is None:
        return None
    dates: list[str] = []
    for m in re.finditer(r"^### (\d{4}-\d{2}-\d{2})", sec, re.M):
        if m.group(1) not in dates:
            dates.append(m.group(1))
    return dates


def validate_ledger(md: str, ids: dict[str, Any],
                    errors: list[str]) -> dict[str, Any]:
    """Every ledger entry must cite a `strategy: <id>` that exists in the
    grammar. An empty ledger passes."""
    sec = _slice_section(md, 5)
    if sec is None:
        errors.append("ledger: the ledger document has no section 5")
        return {"entries": 0, "citations": []}
    entries = [(m.group(1), m.start()) for m in re.finditer(r"^### (.+)$", sec, re.M)]
    citations: list[dict[str, str]] = []
    for i, (title, at) in enumerate(entries):
        end = entries[i + 1][1] if i + 1 < len(entries) else len(sec)
        body = sec[at:end]
        found = re.findall(r"(?:^|\s)strategy:\s*([A-Za-z0-9_-]+)", body)
        if not found:
            errors.append(f'ledger entry "{title}": no "strategy: <id>" citation '
                          f"(playbook citation is REQUIRED)")
        for sid in found:
            citations.append({"entry": title, "id": sid})
            if sid not in ids["strategies"] and sid not in ids["compounds"]:
                errors.append(f'ledger entry "{title}" cites "{sid}" which is '
                              f"not a strategy or compound in the grammar")
    return {"entries": len(entries), "citations": citations}
"""The patch artifact, the pins file, and the LEGAL-PATCH VERIFIER.

A port of `web/monkey-baiting/test/patch.js`. Pure functions and data: nothing
here writes into `data/` except `apply_edits()`, which is reached only through
an explicit `--apply`.

TWO CONSTRAINT LAYERS compose, per `docs/balance-loop.md` section 5:

  - PINS say a parameter may not move AT ALL. Human-authored (playtesting and
    design judgement), never written by the loop. `data/balance-pins.yaml`,
    47 active entries. A patch touching a pinned location is invalid
    regardless of score, and the pin set is part of a trial's identity.
  - CLASS ENVELOPES say HOW FAR a parameter may move. `data/balance.yaml`,
    checked through the static frame analysis so the check sees the DERIVED
    quantities (damage_total = damage x hits) rather than the raw field.

The envelope check compares by (move, FIELD), not by the exact violation
string: a value that already violated its envelope and moves while still
violating the same field is tolerated. Only a field that did not violate
before and does after is a NEW violation, and only that rejects.

Patch schema is `mb-patch/2`. The bump from the node stack's `mb-patch/1` is
deliberate and total -- no archive compatibility is claimed or wanted (ruling
7) -- and it carries the fields the new substrate needs (`solver_backend` on
the lineage, `sim_version` on the run).
"""

from __future__ import annotations

import copy
import json
import re
from pathlib import Path
from typing import Any

from . import yamlio
from .data import Data, qualified_path, resolve_path, set_at_path
from .framedata import analyze as framedata_analyze

__all__ = [
    "PatchError", "SCHEMA", "load_pins", "pin_matches", "verify",
    "validate_manifest_schema", "solver_relevant", "build_overlay_tree",
    "write_overlay_file", "REVERSE_FIELD_MAP", "ENVELOPE_FIELDS",
    "move_class_of", "replace_leaf", "apply_edits", "scalar_token",
    "edit_title", "ledger_entry", "append_ledger",
]

SCHEMA = "mb-patch/2"


class PatchError(Exception):
    """A pins file that cannot be loaded. Verifier findings are returned, not
    raised -- a rejected candidate is data, not an exception."""


# data/balance.yaml class fields <-> the raw YAML field an edit writes. Only
# "damage" needs translating (damage_total = damage x hits). A raw field with
# no envelope (blockstun, AI params) falls back to magnitude sampling.
REVERSE_FIELD_MAP = {
    "damage_total": "damage",
    "startup_frames": "startup_frames",
    "active_frames": "active_frames",
    "recovery_frames": "recovery_frames",
    "base_knockback": "base_knockback",
    "hitstun": "hitstun",
    "cooldown": "cooldown",
}
ENVELOPE_FIELDS = list(REVERSE_FIELD_MAP)

PIN_FIELDS = ("id", "reason", "file", "path")

REQUIRED_TOP = ("schema", "id", "grammar_version", "situation", "strategy",
                "signal", "layer", "edits", "solver_relevant", "rng",
                "emitted_at", "lineage")

EMITTABLE_LAYERS = ("move-param", "ai-param")


def move_class_of(key: str) -> str:
    return key if key in ("light", "heavy", "special") else "extra"


# --------------------------------------------------------------------------
# pins
# --------------------------------------------------------------------------

def load_pins(path: Path | None) -> dict[str, Any]:
    """Loads and validates the pins file. A missing file is an empty pin set
    ONLY when no path was asked for; a named file that is absent is an error."""
    if path is None:
        return {"version": 1, "pins": []}
    path = Path(path)
    if not path.exists():
        raise PatchError(f"pins file not found: {path}")
    doc = yamlio.load(path)
    errors: list[str] = []
    if not isinstance(doc, dict):
        raise PatchError(f"{path}: pins document is not a map")
    if not isinstance(doc.get("version"), int):
        errors.append('pins: missing numeric "version"')
    if not isinstance(doc.get("pins"), list):
        errors.append('pins: "pins" must be a list')
    else:
        for i, p in enumerate(doc["pins"]):
            at = f"pins[{i}]"
            if not isinstance(p, dict):
                errors.append(f"{at}: must be a map")
                continue
            for f in PIN_FIELDS:
                if not isinstance(p.get(f), str) or not p[f]:
                    errors.append(f'{at}: missing required field "{f}"')
            for f in p:
                if f not in PIN_FIELDS:
                    errors.append(f'{at}: unknown field "{f}"')
    if errors:
        raise PatchError(f"INVALID PINS ({path}):\n" + "\n".join(errors))
    return doc


def pin_matches(edit: dict[str, Any], pin: dict[str, Any]) -> bool:
    """A pin blocks an edit when the file matches AND the pin path is "*", is
    the edit path, or is a dotted ancestor of it."""
    if edit["file"] != pin["file"]:
        return False
    if pin["path"] == "*":
        return True
    if edit["path"] == pin["path"]:
        return True
    return edit["path"].startswith(pin["path"] + ".")


# --------------------------------------------------------------------------
# manifest schema
# --------------------------------------------------------------------------

def validate_manifest_schema(patch: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    if not isinstance(patch, dict):
        return ["manifest is not an object"]
    for f in REQUIRED_TOP:
        if f not in patch:
            errors.append(f'missing field "{f}"')
    if patch.get("schema") != SCHEMA:
        errors.append(f'schema must be "{SCHEMA}"')
    edits = patch.get("edits")
    if not isinstance(edits, list) or not edits:
        errors.append("edits must be a non-empty list")
    else:
        for i, e in enumerate(edits):
            at = f"edits[{i}]"
            for f in ("file", "path", "before", "after"):
                if f not in e:
                    errors.append(f'{at}: missing "{f}"')
            if "before" in e and "after" in e and e["before"] == e["after"]:
                errors.append(f"{at}: after == before (no-op patch)")
    rng = patch.get("rng")
    if not isinstance(rng, dict) or "seed" not in rng or not rng.get("stream") \
            or not isinstance(rng.get("draws"), list):
        errors.append("rng must be {seed, stream, draws: []}")
    return errors


# --------------------------------------------------------------------------
# the solver_relevant rule
# --------------------------------------------------------------------------

_CHARACTER_FILE = re.compile(r"^data/characters/[^/]+\.yaml$")


def solver_relevant(edits: list[dict[str, Any]]) -> bool:
    """True iff any edit can move a SOLVED POLICY.

    The solver model reads the character records and the ring/chip constants.
    Of the canonical patchable files only `data/characters/*.yaml` is in that
    set -- `strategies.yaml`, `bots.yaml` and `balance.yaml` are not read by
    the model at all -- so this is the whole rule. It is a sound SUPERSET: it
    never skips a state whose model moved, and the per-pair model-hash gate
    (solve.py) is the exact criterion applied inside the solve itself."""
    return any(_CHARACTER_FILE.match(e["file"]) for e in edits)


# --------------------------------------------------------------------------
# the verifier
# --------------------------------------------------------------------------

_VIOL_FIELD = re.compile(r"^([a-zA-Z_]+)\s*=")


def _violated_fields(violations: list[str]) -> list[str]:
    out = []
    for v in violations:
        m = _VIOL_FIELD.match(v)
        out.append(m.group(1) if m else v)
    return out


def verify(patch: dict[str, Any], data: Data,
           pins: dict[str, Any] | None) -> list[str]:
    """[] when the candidate is legal, else every reason it is not.

    `data` is the CURRENT (already overlay-merged) state the candidate is
    proposed against, never the pristine base."""
    reasons: list[str] = []
    edits = patch.get("edits")
    if not isinstance(edits, list) or not edits:
        return ["schema: edits must be a non-empty list"]
    if patch.get("layer") not in EMITTABLE_LAYERS:
        reasons.append(f'layer: "{patch.get("layer")}" is not one of '
                       f'{"|".join(EMITTABLE_LAYERS)}')

    pin_list = (pins or {}).get("pins", [])
    root = data.as_root()
    edits_ok: list[dict[str, Any]] = []

    for e in edits:
        for p in pin_list:
            if pin_matches(e, p):
                reasons.append(f'pinned: {e["file"]} {e["path"]} matches pin '
                               f'"{p["id"]}"')

        rel = e["file"][len("data/"):] if e["file"].startswith("data/") else None
        if rel is None or rel not in data.files:
            reasons.append(f'schema: target file "{e["file"]}" is not a '
                           f"canonical patchable data file")
            continue
        qp = qualified_path(e["file"], e["path"])
        found, value = resolve_path(root, qp)
        if not found:
            reasons.append(f'schema: path "{e["path"]}" in {e["file"]} does not '
                           f"resolve to an existing leaf")
            continue
        if isinstance(value, dict):
            reasons.append(f'schema: path "{e["path"]}" in {e["file"]} resolves '
                           f"to a non-scalar (map) leaf")
            continue
        if isinstance(value, list) and not all(
                isinstance(v, (int, float)) and not isinstance(v, bool) for v in value):
            reasons.append(f'schema: path "{e["path"]}" in {e["file"]} resolves '
                           f"to a non-numeric list leaf")
            continue
        if not _same_json_type(e["before"], e["after"]):
            reasons.append(f"schema: after is not the same JSON type as before "
                           f'for {e["file"]} {e["path"]}')
            continue
        if e["after"] == e["before"]:
            reasons.append(f'schema: after == before for {e["file"]} {e["path"]} '
                           f"(no-op patch)")
            continue
        edits_ok.append(e)

    if edits_ok:
        before_analysis = framedata_analyze(data)
        before_viol = {mv.id: _violated_fields(mv.envelope_violations)
                       for mv in before_analysis["moves"]}

        after_data = copy.deepcopy(data)
        after_root = after_data.as_root()
        for e in edits_ok:
            _assign(after_root, qualified_path(e["file"], e["path"]), e["after"])
        after_analysis = framedata_analyze(after_data)
        for mv in after_analysis["moves"]:
            prev = before_viol.get(mv.id, [])
            fields = _violated_fields(mv.envelope_violations)
            for i, v in enumerate(mv.envelope_violations):
                if fields[i] not in prev:
                    reasons.append(f"envelope: {mv.id} would newly violate its "
                                   f"class envelope ({v})")

    return reasons


def _same_json_type(before: Any, after: Any) -> bool:
    if isinstance(before, list) != isinstance(after, list):
        return False
    if isinstance(before, list):
        return (len(before) == len(after)
                and all(_json_kind(x) == _json_kind(y) for x, y in zip(before, after)))
    return _json_kind(before) == _json_kind(after)


def _json_kind(v: Any) -> str:
    if isinstance(v, bool):
        return "boolean"
    if isinstance(v, (int, float)):
        return "number"      # JS has one number type; an int->float edit is legal
    if v is None:
        return "null"
    return type(v).__name__


def _assign(root: Any, dotted: str, value: Any) -> None:
    segs = dotted.split(".")
    cur = root
    for seg in segs[:-1]:
        cur = cur[int(seg)] if seg.isdigit() else cur[seg]
    last = segs[-1]
    if last.isdigit():
        cur[int(last)] = value
    else:
        cur[last] = value


# --------------------------------------------------------------------------
# overlay writing
# --------------------------------------------------------------------------

_WRAPPERS = {"strategies.yaml": "strategies", "bots.yaml": "bots"}


def build_overlay_tree(file: str, edit_path: str, value: Any) -> dict[str, Any]:
    """The nested overlay tree for one edit, in the FILE's own physical shape
    (wrapper key included), which is what `Data.load_data(overlay_dirs=...)`
    merges back."""
    rel = file[len("data/"):] if file.startswith("data/") else file
    node: Any = value
    for seg in reversed(edit_path.split(".")):
        node = {seg: node}
    wrapper = _WRAPPERS.get(rel)
    if wrapper:
        node = {wrapper: node}
    return node


def write_overlay_file(patch_dir: Path, file: str, tree: dict[str, Any]) -> Path:
    rel = file[len("data/"):] if file.startswith("data/") else file
    dest = Path(patch_dir) / "data" / rel
    yamlio.dump(dest, tree)
    return dest


# --------------------------------------------------------------------------
# textual leaf replacement -- the --apply write-back
# --------------------------------------------------------------------------

def scalar_token(v: Any) -> str:
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        if v == int(v):
            return str(int(v)) if float(v).is_integer() and _looks_integral(v) else repr(v)
        return f"{round(v, 6):.6f}".rstrip("0").rstrip(".")
    return str(v)


def _looks_integral(v: float) -> bool:
    return float(v).is_integer()


_LEAF_RE = re.compile(r"^(\s*)([A-Za-z0-9_][A-Za-z0-9_-]*):(\s*)(.*)$")


def replace_leaf(text: str, dotted: str, value: Any) -> dict[str, Any]:
    """Replaces ONLY the scalar token at the dotted path, preserving
    indentation and any trailing comment.

    The canonical YAML carries comments and this project has no full
    serialiser, so re-emitting a whole document is forbidden. A path that is
    not a literal scalar line is an error and the caller aborts the whole
    apply -- never a partial write, never a silent skip."""
    lines = text.split("\n")
    want = dotted.split(".")
    stack: list[tuple[int, str]] = []
    for i, line in enumerate(lines):
        if not line.strip() or re.match(r"^\s*#", line):
            continue
        indent = len(line) - len(line.lstrip())
        while stack and stack[-1][0] >= indent:
            stack.pop()
        if re.match(r"^\s*-", line):
            stack.append((indent, "-"))
            continue
        m = _LEAF_RE.match(line)
        if not m:
            stack.append((indent, "-"))
            continue
        stack.append((indent, m.group(2)))
        here = [k for _, k in stack]
        if here != want:
            continue
        rest = m.group(4)
        vm = re.match(r"^([^#]*?)(\s*(?:#.*)?)$", rest)
        scalar = vm.group(1)
        if scalar == "" or scalar[:1] in "[{":
            return {"error": f'path "{dotted}" is not a literal scalar line '
                             f"(line {i + 1})"}
        lines[i] = m.group(1) + m.group(2) + ":" + m.group(3) + scalar_token(value) + vm.group(2)
        return {"text": "\n".join(lines)}
    return {"error": f'path "{dotted}" was not found as a literal scalar line'}


def apply_edits(sandbox: Path, edits: list[dict[str, Any]],
                data_dir: Path | None = None) -> dict[str, Any]:
    """Two passes: resolve every edit, THEN write. No partial writes.

    `data_dir` overrides `<sandbox>/data` so the solve staging path can reuse
    exactly this code -- one definition of what an applied edit produces."""
    base = Path(data_dir) if data_dir is not None else Path(sandbox) / "data"
    by_file: dict[str, dict[str, Any]] = {}
    errors: list[str] = []
    for e in edits:
        rel = e["file"][len("data/"):] if e["file"].startswith("data/") else e["file"]
        abs_path = base / rel
        if e["file"] not in by_file:
            if not abs_path.exists():
                errors.append(f'apply: no such file {e["file"]}')
                continue
            by_file[e["file"]] = {"path": abs_path,
                                  "text": abs_path.read_text(encoding="utf-8")}
        res = replace_leaf(by_file[e["file"]]["text"], e["path"], e["after"])
        if "error" in res:
            errors.append(f'apply: {e["file"]}: {res["error"]}')
            continue
        by_file[e["file"]]["text"] = res["text"]
    if errors:
        return {"errors": errors, "written": []}
    written: list[str] = []
    for f, rec in by_file.items():
        rec["path"].write_text(rec["text"], encoding="utf-8", newline="")
        written.append(f)
    return {"errors": [], "written": written}


# --------------------------------------------------------------------------
# the tuning ledger entry
# --------------------------------------------------------------------------

def edit_title(edit: dict[str, Any]) -> str:
    m = re.match(r"^data/characters/([^/.]+)\.yaml$", edit["file"])
    mv = re.match(r"^moves\.([A-Za-z0-9_]+)\.", edit["path"])
    if m and mv:
        return f"{m.group(1)}/{mv.group(1)}"
    if m:
        return f'{m.group(1)} ({edit["path"]})'
    return f'{edit["file"][len("data/"):]} ({edit["path"]})'


def ledger_entry(o: dict[str, Any]) -> str:
    """The `strategy: <id>` line is what `grammar.validate_ledger` checks; the
    before/after score line is required by `docs/balance-loop.md` section 5."""
    lines = [f'### {o["date"]} -- {edit_title(o["patch"]["edits"][0])}',
             f'- strategy: {o["patch"]["strategy"]}']
    for e in o["patch"]["edits"]:
        env = (f' ({e.get("class") or "class"} envelope {e["envelope"][0]}-'
               f'{e["envelope"][1]})' if e.get("envelope")
               else " (no class envelope for this field)")
        lines.append(f'- {e["path"]} {scalar_token(e["before"])} -> '
                     f'{scalar_token(e["after"])}{env}')
    lines.append(f'- balance score {o["parent_score"]} -> {o["score"]} '
                 f'(grammar v{o["grammar_version"]}, sim {o["sim_version"]}, '
                 f'seeds {o["eval_seeds"]}, run {o["run_id"]})')
    return "\n".join(lines)


def append_ledger(md: str, entry_text: str) -> dict[str, Any]:
    m = re.search(r"^## 5\.[^\n]*$", md, re.M)
    if not m:
        return {"error": "ledger: document has no section 5"}
    after = m.end()
    rest = md[after:]
    nxt = re.search(r"^## \d", rest, re.M)
    insert_at = after + nxt.start() if nxt else len(md)
    head = re.sub(r"\s*$", "\n", md[:insert_at])
    return {"text": head + "\n" + entry_text + "\n\n" + md[insert_at:]}
"""The balance loop runner: one run, or a patience-driven search of runs.

    state_N + grammar_vG
      -> run the tournament (mb_sim, fixed seeds, pinned config)
      -> detect situations, compute score(state_N)
      -> emit candidate patches from the highest-priority situations
      -> state_N+1 = state_N + patch  (as an OVERLAY, never a write)
      -> re-run, re-score
      -> ACCEPT on strict improvement; else REJECT and take the next candidate

HARD RULE: `data/` is never edited during a run. Every evaluation loads the
canonical data plus the overlay stack in memory; the canonical files are
written only by an explicit `--apply` at the end, through the same textual
leaf replacement the solve staging uses.

RESOLUTION PURITY. When candidates get re-solved, the BASE is re-solved too,
at the same profile, once at run start -- a supplied policy directory's
resolution is unknown, and a comparison is sound only when every state in it
was solved the same way. At profile `skip` nothing is re-solved anywhere, so
the comparison stays symmetric the other way.
"""

from __future__ import annotations

import json
import shutil
import subprocess
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable

from . import SCHEMA_STACK
from . import archive, emit, framedata as F, grammar as G, patch as P
from . import search as SEARCH, solve as SOLVE, stage as STAGE
from . import tournament as TOURN, yamlio
from .data import Data, load_data
from .search import KNOB_DEFAULTS, SearchIO, SearchState

__all__ = ["RunOptions", "RunOutcome", "run_once", "run_search", "default_python"]


@dataclass
class RunOptions:
    sandbox: Path
    root: Path
    seed: int = 1
    out: Path | None = None
    runs_root: Path | None = None
    grammar: Path | None = None
    pins: Path | None = None
    overlays: list[Path] = field(default_factory=list)
    knobs: dict[str, Any] = field(default_factory=lambda: dict(KNOB_DEFAULTS))
    roster_mode: str = "no-perfect"
    perfect: Path | None = None
    solve_profile: str = "skip"
    backend: str = "cuda"
    python: str | None = None
    node: str = "node"
    canary: bool = True
    model_gate: bool = True
    threads: int | None = None
    binary: Path | None = None
    max_step: float = 0.25
    magnitude_frac: float = 0.15
    keep_policies: bool = False
    apply: bool = False
    ledger: Path | None = None
    quiet: bool = False
    # REPRODUCIBILITY GATE. With pin_clock set, every wall-clock stamp the
    # archive carries -- the run id, started_at, finished_at, and each patch's
    # emitted_at -- takes this value instead of the real time, which makes the
    # archive a pure function of its inputs and lets two runs be compared BYTE
    # FOR BYTE. It changes nothing else: no score, no seed, no ordering.
    pin_clock: str | None = None


@dataclass
class RunOutcome:
    exit_code: int
    run_id: str = ""
    directory: Path | None = None
    base_score: float | None = None
    final_score: float | None = None
    heights: list[dict[str, Any]] = field(default_factory=list)
    accepted: list[str] = field(default_factory=list)
    rounds: int = 0
    end_reason: str = ""
    timings: dict[str, float] = field(default_factory=dict)
    failure: str | None = None
    # whether this run beat the equal-height archive anywhere. Tracked as
    # ACCEPTS HAPPEN, not from the surviving stack: a height-N state that beat
    # the archived champion is a champion even if a later backout unwound it.
    improved_archive: bool = False


def default_python(root: Path) -> str:
    win = Path(root) / "web" / "monkey-baiting" / "solver" / "venv" / "Scripts" / "python.exe"
    nix = Path(root) / "web" / "monkey-baiting" / "solver" / "venv" / "bin" / "python"
    if win.exists():
        return str(win)
    if nix.exists():
        return str(nix)
    return "python3"


def _utc_stamp(dt: datetime) -> str:
    return dt.strftime("%Y%m%dT%H%M%SZ")


def _git_info(root: Path) -> dict[str, Any]:
    def git(args: list[str]) -> str | None:
        try:
            out = subprocess.run(["git"] + args, cwd=str(root),
                                 capture_output=True, text=True)
            return out.stdout.strip() if out.returncode == 0 else None
        except OSError:
            return None
    commit = git(["rev-parse", "--short", "HEAD"])
    status = git(["status", "--porcelain"])
    return {"git_commit": commit,
            "git_dirty": None if status is None else status != ""}


# --------------------------------------------------------------------------
# one scored state
# --------------------------------------------------------------------------

@dataclass
class ScoredState:
    tournament: dict[str, Any]
    framedata: dict[str, Any]
    analysis: dict[str, Any]
    score: float
    entrants: int
    sim_version: str
    sim_hash: str
    wall_ms: float


def _score_state(opts: RunOptions, grammar: dict[str, Any], data: Data,
                 roster: list[TOURN.Entrant], perfect_dir: Path | None,
                 framedata_json: dict[str, Any],
                 sandbox_dir: Path | None = None) -> ScoredState:
    """`sandbox_dir` is what mb_sim is pointed at: the STAGED candidate state,
    not the committed sandbox. `data` is the same state in memory, for the
    static analysis and the roster."""
    res = TOURN.run_tournament(data, roster, seeds=opts.knobs["eval_seeds"],
                               perfect_dir=perfect_dir, threads=opts.threads,
                               binary=opts.binary, sandbox_dir=sandbox_dir)
    tj = TOURN.tournament_json(res)
    ctx = {"report": tj, "framedata": framedata_json,
           "board": TOURN.spam_board(tj)}
    A = G.analyze(grammar, ctx)
    return ScoredState(tournament=tj, framedata=framedata_json, analysis=A,
                       score=A["score"], entrants=len(roster),
                       sim_version=res.record["sim_version"],
                       sim_hash=res.record["oracle"]["hash"],
                       wall_ms=res.wall_ms)


# --------------------------------------------------------------------------
# one run
# --------------------------------------------------------------------------

def run_once(opts: RunOptions, height_archive: archive.HeightArchive | None = None,
             log: Callable[[str], None] | None = None) -> RunOutcome:
    log = log or (lambda line: print(line))
    root = Path(opts.root)
    sandbox = Path(opts.sandbox)
    grammar_path = opts.grammar or (sandbox / "data" / "balance-grammar.yaml")
    pins_path = opts.pins or (sandbox / "data" / "balance-pins.yaml")

    grammar_text = Path(grammar_path).read_text(encoding="utf-8")
    grammar = G.load_grammar(grammar_path)
    errors: list[str] = []
    G.validate_grammar(grammar, None, errors)
    if errors:
        for e in errors:
            log(f"  FAIL {e}")
        return RunOutcome(exit_code=1, failure="invalid grammar")
    pins = P.load_pins(pins_path)
    pins_text = Path(pins_path).read_text(encoding="utf-8")

    started = datetime.now(timezone.utc)
    started_iso = opts.pin_clock or started.isoformat(timespec="seconds")
    stamp = _utc_stamp(datetime.fromisoformat(opts.pin_clock)) if opts.pin_clock \
        else _utc_stamp(started)
    run_id = f"run-{opts.seed}-{stamp}"
    runs_root = Path(opts.runs_root) if opts.runs_root else (sandbox / "runs")
    out_dir = Path(opts.out) if opts.out else runs_root / run_id

    data0 = load_data(sandbox, opts.overlays)
    roster = TOURN.build_roster(data0, opts.roster_mode)
    framedata0 = F.framedata_json(F.analyze(data0))

    need_base_solve = SOLVE.base_resolve_needed(opts.roster_mode, opts.solve_profile)
    python = opts.python or default_python(root)

    for line in SEARCH.knob_table(opts.knobs):
        log(line)
    log(f"  seed {opts.seed}   grammar v{grammar['version']}   pins "
        f"{len(pins['pins'])}   roster {opts.roster_mode} ({len(roster)} entrants)"
        f"   solve-profile {opts.solve_profile}"
        + (f" backend {opts.backend}" if opts.solve_profile != "skip" else ""))
    log(f"  out {out_dir}")

    timings = {"tournament_ms": 0.0, "score_ms": 0.0, "export_ms": 0.0,
               "solve_ms": 0.0, "framedata_ms": 0.0}

    # ---- base state ------------------------------------------------------
    base_solve: SOLVE.SolveOutcome | None = None
    base_source = SOLVE.PolicySource(directory=opts.perfect)
    # The base state is the canonical data plus whatever --overlay stack the
    # run was started from, so it is staged too -- the simulator must never be
    # pointed at the committed sandbox when the run carries overlays.
    base_edits: list[dict[str, Any]] = []
    for d in opts.overlays:
        manifest = Path(d) / "patch.json"
        if manifest.exists():
            base_edits.extend(json.loads(manifest.read_text(encoding="utf-8"))["edits"])
    base_stage = STAGE.stage_sandbox(sandbox, base_edits, out_dir / "stage" / "base")
    if need_base_solve:
        log(f"base solve: cold re-solve of the base state "
            f"({opts.solve_profile}, {opts.backend})")
        base_solve = SOLVE.cold_solve(
            root=root, sandbox=sandbox, data=data0, data_dir=base_stage / "data",
            work_dir=out_dir / "base" / "solve", profile=opts.solve_profile,
            backend=opts.backend, python=python, reuse=None,
            model_gate=opts.model_gate, node=opts.node, canary=opts.canary,
            quiet=opts.quiet)
        for line in base_solve.log:
            log("  " + line)
        timings["export_ms"] += base_solve.export_ms
        timings["solve_ms"] += base_solve.solve_ms
        base_source = SOLVE.PolicySource(directory=base_solve.policy_dir,
                                         shas=base_solve.model_shas)

    s0 = _score_state(opts, grammar, data0, roster, base_source.directory,
                      framedata0, sandbox_dir=base_stage)
    timings["tournament_ms"] += s0.wall_ms

    solve_block: dict[str, Any] = {
        "profile": opts.solve_profile,
        "backend": opts.backend if opts.solve_profile != "skip" else None,
        "cold": True,
        "model_gate": opts.model_gate,
        "gap_step": (SOLVE.SOLVE_PROFILES.get(opts.solve_profile) or {}).get("gap_step"),
        "fq": (SOLVE.SOLVE_PROFILES.get(opts.solve_profile) or {}).get("fq"),
        "python": python,
        "node_version": base_solve.node_version if base_solve else None,
        "solver_version": base_solve.solver_version if base_solve else None,
        "solver_backend": base_solve.solver_backend if base_solve else None,
        "base_resolve": need_base_solve,
        "base_policy_dir": str(base_source.directory) if base_source.directory else None,
        "base_policy_sha": base_solve.policy_sha if base_solve
        else SOLVE.policy_sha(opts.perfect),
        "base_model_sha": base_solve.model_shas if base_solve else None,
        "canary": opts.canary if opts.backend == "cuda" else None,
    }

    handle = archive.open_run(out_dir, {
        "run_id": run_id, "started_at": started_iso, "seed": opts.seed,
        "knobs": dict(opts.knobs),
        "grammar": {"version": grammar["version"],
                    "file": str(Path(grammar_path).relative_to(root))
                    if _under(root, grammar_path) else str(grammar_path),
                    "sha": archive.content_hash(grammar_text)},
        "pins": {"file": str(pins_path), "sha": archive.content_hash(pins_text),
                 "count": len(pins["pins"])},
        "roster": {"mode": opts.roster_mode, "entrant_count": len(roster),
                   "entrants": [e.sim_id for e in roster],
                   "perfect_dir": str(opts.perfect) if opts.perfect else None},
        "match_rules": {"seeds": opts.knobs["eval_seeds"],
                        "max_frames": s0.tournament["maxFrames"],
                        "arena": "neutral",
                        "wins_to_take_match": data0.rules["rounds"]["wins_to_take_match"],
                        "max_rounds_per_match": data0.rules["rounds"]["max_rounds_per_match"]},
        "sim": {"sim_version": s0.sim_version, "base_hash": s0.sim_hash,
                "driver": "tools/mb_driver.py",
                "threads": opts.threads, "binary": str(opts.binary) if opts.binary else None},
        "solve": solve_block,
        "code": _git_info(root),
        "grammar_text": grammar_text, "pins_text": pins_text,
    })

    archive.write_base(handle, {
        "overlay_dirs": opts.overlays,
        "tournament": s0.tournament, "framedata": s0.framedata,
        "score": _score_obj(grammar, s0, score=s0.score, baseline=s0.score,
                            parent=None, delta=None, verdict="base", height=0,
                            parent_round=None, lineage_id=run_id, stream=None,
                            solve=None),
    })
    log(f"base score {s0.score} ({len(roster)} entrants, "
        f"{opts.knobs['eval_seeds']} seeds, sim {s0.sim_version} "
        f"hash {s0.sim_hash})")
    if height_archive is not None:
        # Champions are only comparable within one (sim_version, grammar,
        # pins, roster, seeds, solver) tuple; set it before the first
        # comparison so an incomparable archive is never consulted.
        height_archive.key = archive.comparability_key(handle.run)

    # ---- the search ------------------------------------------------------
    best_score = s0.score
    improved_archive = False

    def overlays_for(state: SearchState) -> list[Path]:
        return list(opts.overlays) + [c["dir"] for c in state.stack]

    def edits_for(state: SearchState, extra: dict[str, Any] | None = None) -> list[dict]:
        out: list[dict[str, Any]] = []
        for c in state.stack:
            out.extend(c["patch"]["edits"])
        if extra:
            out.extend(extra["patch"]["edits"])
        return out

    def policy_source(state: SearchState) -> SOLVE.PolicySource:
        for c in reversed(state.stack):
            if c.get("solve"):
                return SOLVE.PolicySource(directory=c["solve"].policy_dir,
                                          shas=c["solve"].model_shas)
        return base_source

    def do_emit(state: SearchState) -> list[dict[str, Any]]:
        parent_dir = (out_dir / "rounds" / state.parent_ref) if state.parent_ref \
            else (out_dir / "base")
        report = json.loads((parent_dir / "tournament.json").read_text(encoding="utf-8"))
        fd = json.loads((parent_dir / "framedata.json").read_text(encoding="utf-8"))
        stream = f"run:{opts.seed}:d{state.depth}:v{state.visit}"
        emit_seed = emit.fnv1a(f"{opts.seed}|{stream}")
        emit_dir = out_dir / "emit" / f"d{state.depth}-v{state.visit}"
        data_here = load_data(sandbox, overlays_for(state))
        r = emit.emit_candidates(
            grammar=grammar, data=data_here, pins=pins, report=report,
            framedata=fd, seed=emit_seed, out_dir=emit_dir,
            count=opts.knobs["candidates_per_depth"], max_step=opts.max_step,
            magnitude_frac=opts.magnitude_frac, emitted_at=opts.pin_clock)
        if not opts.quiet:
            for line in r.log:
                log("    emit| " + line)
        return [{"patch": p, "dir": d,
                 "stream": f"run:{opts.seed}:d{state.depth}:c{i + 1}",
                 "solve": None, "scored": None, "stage": None}
                for i, (p, d) in enumerate(zip(r.patches, r.dirs))]

    def do_evaluate(cand: dict[str, Any], state: SearchState) -> dict[str, Any]:
        e0 = cand["patch"]["edits"][0]
        log(f'round: depth {state.depth} {cand["patch"]["id"]} '
            f'{cand["patch"]["strategy"]} {e0["file"]} {e0["path"]} '
            f'{e0["before"]} -> {e0["after"]}')
        decision = SOLVE.solve_decision(cand["patch"], opts.roster_mode,
                                        opts.solve_profile)
        log("  " + decision["log"])
        data_here = load_data(sandbox, overlays_for(state) + [cand["dir"]])
        # MATERIALISE the candidate: mb_sim and the model exporter both read
        # from disk, so without this the simulator would score the committed
        # data and every candidate would come back score-neutral.
        # Candidate ids restart at p-0001 in every emit batch, so a scratch
        # directory keyed on the id alone COLLIDES across depths and visits --
        # and a collision means writing a solve into the directory that is
        # also its own reuse source. Key on the full (depth, visit, id).
        slot = "d%d-v%d-%s" % (state.depth, state.visit, cand["patch"]["id"])
        staged = STAGE.stage_sandbox(sandbox, edits_for(state, cand),
                                     out_dir / "stage" / slot)
        cand["stage"] = staged
        perfect_dir = policy_source(state).directory
        if decision["action"] == "solve":
            try:
                outcome = SOLVE.cold_solve(
                    root=root, sandbox=sandbox, data=data_here,
                    data_dir=staged / "data",
                    work_dir=out_dir / "solve" / slot,
                    profile=opts.solve_profile, backend=opts.backend,
                    python=python, reuse=policy_source(state),
                    model_gate=opts.model_gate, node=opts.node,
                    canary=opts.canary, quiet=opts.quiet)
            except SOLVE.SolveError as exc:
                return {"abort": str(exc)}
            for line in outcome.log:
                log("  " + line)
            timings["export_ms"] += outcome.export_ms
            timings["solve_ms"] += outcome.solve_ms
            cand["solve"] = outcome
            perfect_dir = outcome.policy_dir
        fd = F.framedata_json(F.analyze(data_here))
        scored = _score_state(opts, grammar, data_here, roster, perfect_dir, fd,
                              sandbox_dir=staged)
        timings["tournament_ms"] += scored.wall_ms
        cand["scored"] = scored
        return {"score": scored.score}

    def do_record(cand: dict[str, Any], state: SearchState, score: float,
                  verdict: str, delta: float) -> str:
        nonlocal best_score, improved_archive
        scored: ScoredState = cand["scored"]
        ref = archive.write_round(handle, {
            "patch": cand["patch"], "patch_dir": cand["dir"],
            "tournament": scored.tournament, "framedata": scored.framedata,
            "score": _score_obj(grammar, scored, score=score,
                                baseline=s0.score, parent=state.parent_score,
                                delta=delta, verdict=verdict,
                                height=state.depth + 1,
                                parent_round=state.parent_ref,
                                lineage_id=run_id, stream=cand["stream"],
                                solve=cand.get("solve")),
        })
        log(f"  {verdict.upper()} round {ref}: score {score} vs parent "
            f"{state.parent_score} (delta {delta:+g})")
        if verdict == "reject" and cand.get("solve") and not opts.keep_policies:
            shutil.rmtree(Path(cand["solve"].policy_dir).parent, ignore_errors=True)
            cand["solve"] = None
        if verdict == "accept":
            # EQUAL-HEIGHT ARCHIVE (docs/balance-loop.md section 4): offer the
            # champion at this height the moment it is accepted. A later
            # backout removes the patch from THIS lineage's stack; it does not
            # un-discover that a height-N state scored what it scored.
            height_here = state.depth + 1
            if height_archive is not None and \
                    height_archive.better_than(height_here, score):
                height_archive.record(height_here, score, run_id, ref)
                improved_archive = True
        if verdict == "accept" and score < best_score:
            best_score = score
            archive.set_best(handle, best_score)
        cand["scored"] = None      # the merged report is large; do not retain it
        return ref

    result = SEARCH.search_loop(
        opts.knobs, s0.score,
        SearchIO(emit=do_emit, evaluate=do_evaluate, record=do_record,
                 event=lambda ev: archive.add_event(handle, ev), log=log))

    handle.run["round_cap"] = result.round_cap
    archive.flush(handle)

    heights = [{"height": h.height, "round": h.ref, "score": h.score,
                "patch": h.candidate["patch"]["id"] if h.candidate else None,
                "strategy": h.candidate["patch"]["strategy"] if h.candidate else None}
               for h in result.heights]

    if result.aborted:
        handle.run["status"] = "failed"
        archive.flush(handle)
        log("HARD FAILURE: " + result.aborted)
        return RunOutcome(exit_code=1, run_id=run_id, directory=out_dir,
                          failure=result.aborted, timings=timings)

    ledger_text = _build_ledger(result, grammar, opts, run_id, started_iso[:10],
                                s0.sim_version)
    stack_json = {"schema": SCHEMA_STACK,
                  "grammar_version": grammar["version"],
                  "sim_version": s0.sim_version,
                  "comparability": archive.comparability_key(handle.run),
                  "heights": heights,
                  "accepted": list(result.accepted),
                  "final_score": heights[-1]["score"],
                  "applied": False}

    apply_error = None
    if opts.apply:
        apply_error = _do_apply(result, opts, sandbox, ledger_text, log)
        stack_json["applied"] = apply_error is None

    merged_dirs = list(opts.overlays) + [c["dir"] for c in result.stack]
    archive.finalize(handle, {
        "stack": stack_json,
        "merged_overlay_writer": lambda dest: _write_merged(dest, merged_dirs,
                                                            data0.files),
        "ledger": ledger_text,
        "status": "failed" if apply_error else "complete",
        "finished_at": opts.pin_clock
        or datetime.now(timezone.utc).isoformat(timespec="seconds"),
    })

    if height_archive is not None:
        height_archive.key = archive.comparability_key(handle.run)
        height_archive.save()

    log("")
    log(f"RUN {run_id} {'FAILED' if apply_error else 'complete'}: base "
        f"{s0.score} -> final {stack_json['final_score']} over {result.rounds} "
        f"round(s), {len(result.accepted)} accepted ({result.end_reason})")
    log(f"  cost: tournament {timings['tournament_ms'] / 1000:.1f}s, export "
        f"{timings['export_ms'] / 1000:.1f}s, solve "
        f"{timings['solve_ms'] / 1000:.1f}s")
    log(f"archive: {out_dir}")
    if apply_error:
        log("APPLY FAILED: " + apply_error)
        return RunOutcome(exit_code=1, run_id=run_id, directory=out_dir,
                          failure=apply_error, timings=timings)

    return RunOutcome(exit_code=0, run_id=run_id, directory=out_dir,
                      base_score=s0.score, final_score=stack_json["final_score"],
                      heights=heights, accepted=list(result.accepted),
                      rounds=result.rounds, end_reason=result.end_reason,
                      timings=timings, improved_archive=improved_archive)


def _under(root: Path, path: Path) -> bool:
    try:
        Path(path).relative_to(root)
        return True
    except ValueError:
        return False


def _score_obj(grammar: dict[str, Any], scored: ScoredState, *, score: float,
               baseline: float, parent: float | None, delta: float | None,
               verdict: str, height: int, parent_round: str | None,
               lineage_id: str, stream: str | None,
               solve: SOLVE.SolveOutcome | None) -> dict[str, Any]:
    return {
        "schema": "mb-score/2",
        "round": None,
        "grammar_version": grammar["version"],
        "sim_version": scored.sim_version,
        "sim_hash": scored.sim_hash,
        "score": score,
        "baseline_score": baseline,
        "parent_score": parent,
        "delta": delta,
        "verdict": verdict,
        "per_situation": G.per_situation(scored.analysis),
        "inputs": {"tournament": "tournament.json", "framedata": "framedata.json"},
        "lineage": {
            "height": height, "parent_round": parent_round,
            "lineage_id": lineage_id, "rng_stream": stream,
            "champion_at_height": None, "pruned_reason": None, "demoted": None,
            # the comparability half of the record: a score means nothing
            # without the trajectory that produced its policies
            "policy_sha": solve.policy_sha if solve else None,
            "model_sha": solve.model_shas if solve else None,
            "resolved_pairs": solve.resolved_pairs if solve else None,
            "reused_pairs": solve.reused_pairs if solve else None,
            "solver_version": solve.solver_version if solve else None,
            "solver_backend": solve.solver_backend if solve else None,
            "node_version": solve.node_version if solve else None,
        },
    }


def _build_ledger(result: SEARCH.SearchResult, grammar: dict[str, Any],
                  opts: RunOptions, run_id: str, date: str,
                  sim_version: str) -> str:
    entries = []
    for i, cand in enumerate(result.stack):
        entries.append(P.ledger_entry({
            "date": date, "patch": cand["patch"],
            "parent_score": result.heights[i].score,
            "score": result.heights[i + 1].score,
            "grammar_version": grammar["version"], "sim_version": sim_version,
            "eval_seeds": opts.knobs["eval_seeds"], "run_id": run_id}))
    return "\n\n".join(entries)


def _write_merged(dest: Path, dirs: list[Path], files: list[str]) -> None:
    from .data import deep_merge_into
    merged: dict[str, dict[str, Any]] = {}
    for d in dirs:
        for rel in files:
            path = Path(d) / "data" / rel
            if not path.exists():
                continue
            tree = yamlio.load(path)
            if not isinstance(tree, dict):
                continue
            deep_merge_into(merged.setdefault(rel, {}), tree)
    for rel, tree in merged.items():
        yamlio.dump(Path(dest) / rel, tree)


def _do_apply(result: SEARCH.SearchResult, opts: RunOptions, sandbox: Path,
              ledger_text: str, log: Callable[[str], None]) -> str | None:
    if not result.stack:
        log("apply: nothing accepted, data/ untouched")
        return None
    edits: list[dict[str, Any]] = []
    for cand in result.stack:
        edits.extend(cand["patch"]["edits"])
    res = P.apply_edits(sandbox, edits)
    if res["errors"]:
        return "; ".join(res["errors"])
    log("apply: wrote " + ", ".join(res["written"]))
    if opts.ledger:
        md = Path(opts.ledger).read_text(encoding="utf-8")
        appended = P.append_ledger(md, ledger_text)
        if "error" in appended:
            return appended["error"]
        Path(opts.ledger).write_text(appended["text"], encoding="utf-8", newline="")
        log(f"apply: appended {len(result.stack)} ledger entry/entries to "
            f"{opts.ledger} section 5")
    return None


# --------------------------------------------------------------------------
# the multi-run search
# --------------------------------------------------------------------------

def run_search(opts: RunOptions,
               log: Callable[[str], None] | None = None) -> dict[str, Any]:
    log = log or (lambda line: print(line))
    runs_root = Path(opts.runs_root) if opts.runs_root else (Path(opts.sandbox) / "runs")
    runs_root.mkdir(parents=True, exist_ok=True)
    height_archive = archive.HeightArchive(runs_root / "archive.json")

    def one(n: int) -> RunOutcome:
        sub = RunOptions(**{**opts.__dict__})
        sub.seed = opts.seed + n
        sub.out = (Path(opts.out) / f"run-{sub.seed}") if opts.out else None
        log(f"=== search run {n + 1} (seed {sub.seed}) ===")
        return run_once(sub, height_archive, log)

    return SEARCH.patience_driver(opts.knobs["run_patience"], height_archive,
                                  one, log)
"""The depth-first accept/reject search, and the across-runs patience driver.

`docs/balance-loop.md` sections 2 and 1b, with every expensive operation
behind the `SearchIO` seam so the control flow can be exercised against a
stubbed evaluator.

WITHIN A RUN -- depth first. Push accepted patches deeper while candidates
keep beating their parent; on `failure_budget` consecutive failures at a
depth, BACK OUT one tier (undo the accepted patch) and continue exploring from
the shallower state with a fresh RNG stream (the visit counter advances, which
is what makes the re-emission different).

ACROSS RUNS -- keep launching RNG-varied runs; stop after `run_patience`
consecutive runs that fail to improve the archive at ANY height.

STRICT IMPROVEMENT. `score < parent_score` accepts; equal REJECTS. A patch
must pay for itself or a different change is selected -- which is what keeps
the loop from wandering across plateaus.

TERMINATION GUARD. The rule above can ping-pong forever (accept, back out,
accept a different patch at the same score), so a round cap derived from the
knobs bounds every run and is recorded in `run.json.round_cap`.

NO UNSEEDED RANDOMNESS lives here -- or anywhere else in the loop. There is no
randomness in this module at all.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Callable

__all__ = ["KNOBS", "KNOB_DEFAULTS", "SearchState", "SearchIO", "SearchResult",
           "Height", "search_loop", "patience_driver", "knob_table"]

# The five knob names are SHARED verbatim with the emitter, the archive and
# run.json.knobs. A trial's identity includes its knob settings: two searches
# with different knobs are different experiments.
KNOBS = ("failure_budget", "run_patience", "max_depth", "candidates_per_depth",
         "eval_seeds")
KNOB_DEFAULTS = {"failure_budget": 3, "run_patience": 5, "max_depth": 8,
                 "candidates_per_depth": 6, "eval_seeds": 4}


def knob_table(knobs: dict[str, Any]) -> list[str]:
    lines = ["KNOBS (recorded in run.json.knobs)"]
    for name in KNOBS:
        mark = "(default)" if knobs[name] == KNOB_DEFAULTS[name] else "(set)"
        lines.append(f"  {name:<21}{knobs[name]}  {mark}")
    return lines


@dataclass
class SearchState:
    depth: int
    visit: int
    parent_score: float
    parent_ref: str | None
    stack: list[Any] = field(default_factory=list)


@dataclass
class Height:
    height: int
    ref: str | None
    score: float
    candidate: Any = None


@dataclass
class SearchIO:
    """The seam. Each callable is the expensive thing the runner supplies:

        emit(state)                        -> [candidate]
        evaluate(cand, state)              -> {"score": x} | {"abort": reason}
        record(cand, state, score, verdict, delta) -> round ref
        confirm(cand, state, score)        -> bool (optional; False demotes)
        event(ev) / log(line)              -> None (optional)
    """
    emit: Callable[[SearchState], list[Any]]
    evaluate: Callable[[Any, SearchState], dict[str, Any]]
    record: Callable[[Any, SearchState, float, str, float], str]
    confirm: Callable[[Any, SearchState, float], bool] | None = None
    event: Callable[[dict[str, Any]], None] | None = None
    log: Callable[[str], None] | None = None


@dataclass
class SearchResult:
    heights: list[Height]
    accepted: list[str]
    stack: list[Any]
    events: list[dict[str, Any]]
    end_reason: str
    rounds: int
    aborted: str | None
    round_cap: int


def search_loop(knobs: dict[str, Any], base_score: float,
                io: SearchIO) -> SearchResult:
    heights = [Height(height=0, ref=None, score=base_score)]
    accepted: list[str] = []
    stack: list[Any] = []
    events: list[dict[str, Any]] = []
    visit: dict[int, int] = {}
    depth = 0
    fails = 0
    rounds = 0
    pending: dict[str, Any] | None = None
    ended = False
    end_reason = "complete"
    aborted: str | None = None

    max_depth = knobs["max_depth"]
    round_cap = (knobs["candidates_per_depth"] * (max_depth if max_depth > 0 else 16)
                 * (knobs["failure_budget"] + 1) + knobs["candidates_per_depth"])

    def log(line: str) -> None:
        if io.log:
            io.log(line)

    def event(ev: dict[str, Any]) -> None:
        events.append(ev)
        if io.event:
            io.event(ev)

    def state_now() -> SearchState:
        return SearchState(depth=depth, visit=visit.get(depth, 0),
                           parent_score=heights[depth].score,
                           parent_ref=heights[depth].ref, stack=list(stack))

    def end_run(kind: str, reason: str) -> None:
        nonlocal ended, end_reason
        ended = True
        end_reason = reason
        event({"at": None, "kind": kind, "depth": depth, "reason": reason})
        log("end: " + reason)

    def abandon_depth(reason: str) -> None:
        nonlocal depth, fails, pending
        if depth == 0:
            end_run("end", reason + " at depth 0")
            return
        was = depth
        stack.pop()
        accepted.pop()
        heights.pop()
        depth -= 1
        fails = 0
        pending = None
        visit[depth] = visit.get(depth, 0) + 1
        event({"at": None, "kind": "backout", "from_depth": was,
               "to_depth": depth, "reason": reason})
        log(f"backout: depth {was} -> {depth} ({reason})")

    while not ended:
        if rounds >= round_cap:
            end_run("end", f"round cap ({round_cap}) reached")
            break
        if pending is None:
            emitted = io.emit(state_now()) or []
            visit.setdefault(depth, 0)
            pending = {"list": emitted, "idx": 0}
        if not pending["list"]:
            end_run("exhausted",
                    f"exhausted: the emitter produced no candidate at depth {depth}")
            break
        if pending["idx"] >= len(pending["list"]):
            abandon_depth("candidates_per_depth exhausted")
            pending = None if not ended else pending
            continue
        cand = pending["list"][pending["idx"]]
        pending["idx"] += 1
        state = state_now()
        rounds += 1

        outcome = io.evaluate(cand, state)
        if outcome.get("abort"):
            ended = True
            aborted = outcome["abort"]
            end_reason = "aborted: " + aborted
            break
        score = outcome["score"]
        verdict = "accept" if score < state.parent_score else "reject"
        if verdict == "accept" and io.confirm is not None:
            if not io.confirm(cand, state, score):
                verdict = "reject"
        delta = score - state.parent_score
        ref = io.record(cand, state, score, verdict, delta)
        event({"at": ref, "kind": verdict, "depth": depth, "delta": delta})

        if verdict == "accept":
            stack.append(cand)
            accepted.append(ref)
            depth += 1
            fails = 0
            pending = None
            heights.append(Height(height=depth, ref=ref, score=score, candidate=cand))
            if max_depth > 0 and depth >= max_depth:
                end_run("end", f"max_depth {max_depth} reached")
        else:
            fails += 1
            if fails >= knobs["failure_budget"]:
                abandon_depth(f'failure_budget {knobs["failure_budget"]} exhausted')

    return SearchResult(heights=heights, accepted=accepted, stack=stack,
                        events=events, end_reason=end_reason, rounds=rounds,
                        aborted=aborted, round_cap=round_cap)


def patience_driver(run_patience: int, archive: Any,
                    run_fn: Callable[[int], Any],
                    log: Callable[[str], None] | None = None) -> dict[str, Any]:
    """Launch RNG-varied runs until `run_patience` consecutive ones improve
    nothing in the equal-height archive. `archive` needs `better_than(height,
    score)` and `record(height, score, run_id, ref)`."""
    runs: list[Any] = []
    misses = 0
    n = 0
    while True:
        r = run_fn(n)
        if r is None or getattr(r, "exit_code", 0):
            return {"exit_code": getattr(r, "exit_code", 1), "runs": runs,
                    "misses": misses}
        runs.append(r)
        # The run itself offers each accepted state to the archive as it is
        # discovered (runner.run_once), so by the time we get here the archive
        # is already up to date and the run reports whether it beat anything.
        improved = bool(getattr(r, "improved_archive", False))
        misses = 0 if improved else misses + 1
        n += 1
        if log:
            log(f"search: run {r.run_id} "
                f"{'IMPROVED the archive' if improved else 'improved nothing'} "
                f"({misses}/{run_patience} consecutive non-improving)")
        if misses >= run_patience:
            if log:
                log(f"search: stopping -- run_patience {run_patience} "
                    f"consecutive runs improved nothing")
            return {"exit_code": 0, "runs": runs, "misses": misses,
                    "archive": archive.entries}
"""Solve orchestration: stage -> export -> per-pair hash gate -> solve.

The perfect entrants are the scoring yardstick, and a perfect policy is only
valid for the tuning it was solved against -- so a candidate that moves
character data must be re-solved before it can be scored. This module owns
that, and owns the machinery that keeps it affordable.

FOUR STEPS PER CANDIDATE

  1. STAGE. A candidate state is the canonical data plus the accepted-overlay
     stack. Its character files are materialised into a scratch directory by
     the same textual leaf replacement `--apply` uses, so the staged bytes come
     from one code path and never from a re-serialiser.
  2. EXPORT. `node test/solver-export.js` builds the discretized model per
     matchup, pointed at the staged directory through MB_DATA_DIR. This is the
     one sanctioned node tool left (ruling 7(c) permits it: it is the model
     exporter, not a compatibility bridge) and it goes away when a C exporter
     lands. `node --version` is recorded, because export bytes are
     deterministic within one machine + node version and that is the
     comparability scope of every `model_sha` in the archive.
  3. GATE (tier A of `docs/specs/solver-efficiency.md`). The solver consumes
     the EXPORTED MODEL, not the YAML, so the exact re-solve criterion is "did
     this pair's exported model change?". Every pair is exported (the export IS
     the hash input); only pairs whose SHA-256 differs from the reuse source
     are solved, and the rest are copied. A single-character edit typically
     moves 5 of 15 pair models; an edit absorbed by discretization moves none.
     The gate is model_sha AND solver_version AND solver_backend: a policy
     produced by a different solve trajectory or a different backend is not
     interchangeable however unchanged its model bytes are, and an unknown
     value never compares equal, so the gate always fails closed.
  4. SOLVE. Cold, always -- warm starts tie-break differently and may never
     feed a score (`docs/balance-loop.md` section 1b). Backend is recorded per
     pair. CUDA is permitted by the amended cold-solve rule (any backend iff
     the solve is cold, the backend tuple is recorded, and the reproducibility
     gate passed); `solve_cuda.py` runs its canary by default, which IS that
     gate, and a canary mismatch aborts the round rather than producing
     policies.

NEVER MIX PAIR SETS IN ONE ARCHIVE ENTRY: a cast solve's trajectory depends on
which pairs were solved together (`3-cuda-cast`), so the resolved pair list is
recorded on every lineage entry alongside the version.
"""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

from . import patch as P
from .data import Data, load_rules

__all__ = ["SolveError", "SOLVE_PROFILES", "BACKENDS", "pair_key", "pairs_of",
           "model_sha_from_dir", "changed_pairs", "policy_version_of",
           "policy_dir_version", "policy_reusable", "policy_sha",
           "solve_argv", "solver_version", "node_version",
           "export_models", "cold_solve", "SolveOutcome", "PolicySource",
           "assert_tuning_agrees", "solve_decision"]


class SolveError(Exception):
    """Any failure in the export/solve chain. Never degraded, never retried
    with different settings behind the caller's back."""


# Resolution profiles. `skip` re-solves nothing (every state is scored against
# the supplied policies, which keeps the comparison symmetric).
SOLVE_PROFILES: dict[str, dict[str, int] | None] = {
    "skip": None,
    "coarse": {"gap_step": 12, "fq": 6},
    "cold": {"gap_step": 4, "fq": 2},
}

BACKENDS = ("cuda", "numpy")

_WEB = Path("web/monkey-baiting")
_EXPORTER = _WEB / "test" / "solver-export.js"


def pair_key(c0: str, c1: str) -> str:
    return f"{c0}-vs-{c1}"


def pairs_of(ids: list[str]) -> list[tuple[str, str]]:
    """Unordered character pairs including mirrors, in export order."""
    return [(ids[a], ids[b]) for a in range(len(ids)) for b in range(a, len(ids))]


# --------------------------------------------------------------------------
# the canonical-vs-snapshot consistency check
# --------------------------------------------------------------------------

_TUNING_CHECKS = (
    ("ring.left", ("ring", "left")),
    ("ring.right", ("ring", "right")),
    ("ring.center", ("ring", "center")),
    ("combat.block_chip_ratio", ("combat", "block_chip_ratio")),
)


def assert_tuning_agrees(sandbox: Path, root: Path) -> dict[str, Any]:
    """The exporter still reads ring geometry and the block-chip ratio from the
    frozen `web/monkey-baiting/data/tuning.yaml` snapshot, because those values
    have no canonical twin (S2 reconciled them into app.yaml instead). If the
    two ever disagree, the solved model describes a different game than the one
    the simulator scores -- so this is asserted before every export rather than
    left to inspection. Returns the checked values for the run record."""
    from . import yamlio
    tuning_path = Path(root) / _WEB / "data" / "tuning.yaml"
    if not tuning_path.exists():
        raise SolveError(f"the solver export's tuning snapshot is missing: {tuning_path}")
    tuning = yamlio.load(tuning_path)
    rules = load_rules(sandbox)
    checked: dict[str, Any] = {}
    for label, (section, key) in _TUNING_CHECKS:
        a = tuning.get(section, {}).get(key)
        b = rules.get(section, {}).get(key)
        if a is None or b is None:
            raise SolveError(f"tuning consistency: {label} missing "
                             f"({'snapshot' if a is None else 'app.yaml'})")
        if a != b:
            raise SolveError(
                f"tuning consistency FAILED: {label} is {a} in {tuning_path} but "
                f"{b} in {sandbox}/app.yaml. The exported solver model and the C "
                f"simulator would describe different games; reconcile before "
                f"solving.")
        checked[label] = a
    return checked


# --------------------------------------------------------------------------
# staging a candidate state on disk
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# export
# --------------------------------------------------------------------------

def node_version(node: str = "node") -> str:
    try:
        out = subprocess.run([node, "--version"], capture_output=True, text=True)
    except OSError as exc:
        raise SolveError(f"node is not runnable ({node}): {exc}") from exc
    if out.returncode != 0:
        raise SolveError(f"node --version failed: {out.stderr.strip()}")
    return out.stdout.strip()


def export_models(*, root: Path, data_dir: Path, models_dir: Path, profile: str,
                  node: str = "node", quiet: bool = True) -> dict[str, str]:
    """Runs the node exporter over `data_dir` and returns {pair_key: model_sha}.

    Every pair is exported: the export IS the hash input, and the models are
    needed for whichever pairs the gate then selects."""
    flags = SOLVE_PROFILES.get(profile)
    if not flags:
        raise SolveError(f"export: no resolution flags for profile {profile!r}")
    models_dir = Path(models_dir)
    models_dir.mkdir(parents=True, exist_ok=True)
    exporter = Path(root) / _EXPORTER
    if not exporter.exists():
        raise SolveError(f"the model exporter is missing: {exporter}")
    env = dict(os.environ)
    env["MB_DATA_DIR"] = str(Path(data_dir).resolve())
    argv = [node, str(exporter), "--out", str(models_dir),
            "--gap-step", str(flags["gap_step"]), "--fq", str(flags["fq"])]
    proc = subprocess.run(argv, cwd=str(root), env=env, capture_output=True, text=True)
    if proc.returncode != 0:
        raise SolveError(f"model export failed (exit {proc.returncode}):\n"
                         f"  {' '.join(argv)}\n{proc.stderr.strip()}")
    if not quiet and proc.stdout:
        print(proc.stdout.rstrip())
    shas: dict[str, str] = {}
    for manifest in sorted(models_dir.glob("model-*.json")):
        key = manifest.stem[len("model-"):]
        shas[key] = model_sha_from_dir(models_dir, key)
    if not shas:
        raise SolveError(f"model export produced no manifests in {models_dir}")
    return shas


def model_sha_from_dir(models_dir: Path, key: str) -> str:
    """SHA-256 over exactly what solve.py consumes: every array's raw bytes in
    the manifest's fixed order, each tagged with name/dtype/length so a length
    shift can never be absorbed by a neighbour, plus the manifest text. Matches
    `solver-export.js` modelSha() byte for byte."""
    models_dir = Path(models_dir)
    manifest_path = models_dir / f"model-{key}.json"
    manifest_text = manifest_path.read_text(encoding="utf-8")
    manifest = json.loads(manifest_text)
    h = hashlib.sha256()
    for name, meta in manifest["arrays"].items():
        h.update(f"{name}:{meta['dtype']}:{meta['length']}\n".encode())
        h.update((models_dir / meta["file"]).read_bytes())
    h.update(b"manifest\n")
    h.update(manifest_text.encode("utf-8"))
    return h.hexdigest()


# --------------------------------------------------------------------------
# the gate
# --------------------------------------------------------------------------

def changed_pairs(now: dict[str, str], prev: dict[str, str] | None,
                  now_version: str | None, prev_version: str | None) -> list[str]:
    """Which pairs must be re-solved. No source (a base solve, or a supplied
    policy directory of unknown provenance) means every pair: the gate never
    guesses. A differing solver version invalidates the whole cast, and an
    unknown version never compares equal to a known one."""
    keys = sorted(now)
    if not prev:
        return keys
    if now_version is None or prev_version is None or now_version != prev_version:
        return keys
    return [k for k in keys if now[k] != prev[k]]


def policy_version_of(path: Path) -> tuple[str | None, Any]:
    """(solver_version, solver_backend) of a written policy file. (None, None)
    when missing, unparseable, or written by a solver that stamped neither --
    exactly the 'not interchangeable' case."""
    try:
        doc = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, None
    return doc.get("solver_version"), doc.get("solver_backend")


def policy_dir_version(directory: Path | None) -> tuple[str | None, Any]:
    if directory is None or not Path(directory).exists():
        return None, None
    names = sorted(p for p in Path(directory).glob("perfect-*.json"))
    return policy_version_of(names[0]) if names else (None, None)


def policy_reusable(directory: Path | None, files: list[str],
                    version: str | None) -> bool:
    """The SAFETY NET at copy time: every file must exist AND carry the current
    solver version. A missing or stale file re-solves rather than silently
    degrading the archive."""
    if directory is None:
        return False
    for f in files:
        p = Path(directory) / f"perfect-{f}.json"
        if not p.exists():
            return False
        if policy_version_of(p)[0] != version:
            return False
    return True


def policy_sha(directory: Path | None) -> str | None:
    """Content hash of a whole policy directory, so two runs can be compared
    for resolution purity without keeping the policies."""
    if directory is None or not Path(directory).exists():
        return None
    h = hashlib.sha256()
    for p in sorted(Path(directory).glob("perfect-*.json")):
        h.update(p.name.encode())
        h.update(b":")
        h.update(hashlib.sha256(p.read_bytes()).hexdigest().encode())
        h.update(b"|")
    return h.hexdigest()


# --------------------------------------------------------------------------
# the solve itself
# --------------------------------------------------------------------------

def _solver_script(root: Path, backend: str) -> Path:
    name = "solve_cuda.py" if backend == "cuda" else "solve.py"
    path = Path(root) / _WEB / "solver" / name
    if not path.exists():
        raise SolveError(f"solver script missing: {path}")
    return path


def solve_argv(python: str, models_dir: Path, policies_dir: Path, profile: str,
               pairs: list[str] | None, *, backend: str = "cuda",
               root: Path = Path("."), canary: bool = True,
               jobs: int = 1) -> list[str]:
    """The solve command line. COLD ALWAYS: there is no `--resume` anywhere in
    here, by contract."""
    if backend not in BACKENDS:
        raise SolveError(f"unknown backend {backend!r}; have {BACKENDS}")
    if SOLVE_PROFILES.get(profile) is None:
        raise SolveError(f"solve_argv: no flags for profile {profile!r}")
    script = _solver_script(root, backend)
    argv = [python, str(script), "--models", str(models_dir),
            "--out", str(policies_dir),
            "--iters", "2000", "--tol", "0.02", "--fp-rounds", "600"]
    if backend == "numpy":
        argv += ["--backend", "numpy"]
        if jobs > 1:
            argv += ["--jobs", str(jobs)]
    else:
        argv += ["--canary", "on" if canary else "off"]
    if pairs:
        argv += ["--pairs", ",".join(pairs)]
    return argv


_VERSION_CACHE: dict[tuple[str, str], str | None] = {}


def solver_version(python: str, backend: str, root: Path,
                   npairs: int = 2) -> str | None:
    """The solver's own trajectory id. `solve.py` prints it; the CUDA solver
    derives it from dtype and pair count (`3-cuda` vs `3-cuda-cast`), so it is
    read from the module rather than shelled for. None when it cannot be
    determined, which makes every reuse comparison fail closed."""
    key = (python, backend)
    if key in _VERSION_CACHE and backend == "numpy":
        return _VERSION_CACHE[key]
    if backend == "numpy":
        try:
            out = subprocess.run([python, str(_solver_script(root, "numpy")),
                                  "--solver-version"],
                                 cwd=str(root), capture_output=True, text=True)
            v = out.stdout.strip() or None if out.returncode == 0 else None
        except OSError:
            v = None
        _VERSION_CACHE[key] = v
        return v
    # cuda: SOLVER_VERSION_CAST for a multi-pair solve, SOLVER_VERSION_SINGLE
    # for one. fp64 is the default and the only dtype this loop uses.
    src = _solver_script(root, "cuda").read_text(encoding="utf-8")
    single = _const(src, "SOLVER_VERSION_SINGLE")
    cast = _const(src, "SOLVER_VERSION_CAST")
    if single is None or cast is None:
        return None
    return cast if npairs > 1 else single


def _const(src: str, name: str) -> str | None:
    import re
    m = re.search(rf'^{name}\s*=\s*"([^"]+)"', src, re.M)
    return m.group(1) if m else None


@dataclass
class PolicySource:
    """A policy directory and the per-pair model hashes that go with it. They
    must always come from the SAME state: a directory from one ancestor with
    hashes from another would silently reuse a policy for a moved pair."""
    directory: Path | None = None
    shas: dict[str, str] | None = None


@dataclass
class SolveOutcome:
    policy_dir: Path
    model_shas: dict[str, str]
    resolved_pairs: list[str]
    reused_pairs: list[str]
    solver_version: str | None
    solver_backend: Any
    policy_sha: str | None
    node_version: str
    profile: str
    backend: str
    export_ms: float = 0.0
    solve_ms: float = 0.0
    log: list[str] = field(default_factory=list)


def cold_solve(*, root: Path, sandbox: Path, data: Data, data_dir: Path,
               work_dir: Path, profile: str, backend: str, python: str,
               reuse: PolicySource | None = None, model_gate: bool = True,
               node: str = "node", canary: bool = True,
               quiet: bool = True) -> SolveOutcome:
    """Export, gate and solve one ALREADY-STAGED state (see stage.py). Returns
    everything the archive needs to decide later whether two scores are
    comparable."""
    root = Path(root)
    work_dir = Path(work_dir)
    models_dir = work_dir / "models"
    policy_dir = work_dir / "policies"
    staged = Path(data_dir)
    policy_dir.mkdir(parents=True, exist_ok=True)
    log: list[str] = []

    assert_tuning_agrees(sandbox, root)

    t0 = time.perf_counter()
    nv = node_version(node)
    shas = export_models(root=root, data_dir=staged, models_dir=models_dir,
                         profile=profile, node=node, quiet=quiet)
    export_ms = (time.perf_counter() - t0) * 1000.0

    version = solver_version(python, backend, root, npairs=len(shas))
    reuse = reuse or PolicySource()
    prev_version, prev_backend = policy_dir_version(reuse.directory)
    prev_shas = reuse.shas if model_gate else None
    changed = changed_pairs(shas, prev_shas, version, prev_version)

    reused: list[str] = []
    for c0, c1 in pairs_of(data.character_ids):
        key = pair_key(c0, c1)
        if key in changed:
            continue
        files = [pair_key(c0, c1)] + ([pair_key(c1, c0)] if c0 != c1 else [])
        if not policy_reusable(reuse.directory, files, version):
            changed.append(key)
            continue
        for f in files:
            shutil.copy2(Path(reuse.directory) / f"perfect-{f}.json",
                         policy_dir / f"perfect-{f}.json")
        reused.append(key)
    changed.sort()

    log.append(f"model gate: {len(changed)}/{len(shas)} pair(s) changed, "
               f"{len(reused)} policy set(s) reused, export "
               f"{export_ms / 1000.0:.1f}s"
               + ("" if prev_shas else " (no comparable source -- whole cast)"))

    solve_ms = 0.0
    backend_tuple: Any = None
    if changed:
        # a whole-cast solve passes no --pairs at all: identical pair set and
        # order either way, and the solvers filter their own sorted manifests
        want = None if len(changed) == len(shas) else changed
        argv = solve_argv(python, models_dir, policy_dir, profile, want,
                          backend=backend, root=root, canary=canary)
        log.append("solve: " + " ".join(argv))
        t1 = time.perf_counter()
        proc = subprocess.run(argv, cwd=str(root), capture_output=True, text=True)
        solve_ms = (time.perf_counter() - t1) * 1000.0
        if proc.returncode != 0:
            raise SolveError(
                f"solve failed (exit {proc.returncode}, backend {backend}):\n"
                f"  {' '.join(argv)}\n{proc.stdout.strip()}\n{proc.stderr.strip()}")
        if not quiet and proc.stdout:
            print(proc.stdout.rstrip())
        _, backend_tuple = policy_dir_version(policy_dir)
    else:
        log.append("solve: skipped (no pair model changed)")
        backend_tuple = prev_backend

    return SolveOutcome(
        policy_dir=policy_dir, model_shas=shas, resolved_pairs=changed,
        reused_pairs=sorted(reused), solver_version=version,
        solver_backend=backend_tuple, policy_sha=policy_sha(policy_dir),
        node_version=nv, profile=profile, backend=backend,
        export_ms=export_ms, solve_ms=solve_ms, log=log)


def solve_decision(patch_obj: dict[str, Any], roster_mode: str,
                   profile: str) -> dict[str, str]:
    """The FILE-LEVEL pre-filter, before the exact per-pair gate. A sound
    superset: it never skips a state whose model moved, and skipping costs
    nothing (no export, no solve)."""
    if not patch_obj["solver_relevant"]:
        return {"action": "skip", "log": "solve: skipped (not solver-relevant)"}
    if roster_mode != "full":
        return {"action": "skip",
                "log": f"solve: skipped (roster {roster_mode} uses no policies)"}
    if profile == "skip":
        return {"action": "skip",
                "log": "solve: skipped (--solve-profile skip reuses the supplied "
                       "policies for every state)"}
    return {"action": "solve",
            "log": f"solve: cold re-solve ({profile})"}


def base_resolve_needed(roster_mode: str, profile: str) -> bool:
    """RESOLUTION PURITY: a comparison is sound only when every state in it was
    solved at the same profile. When candidates get re-solved, the BASE gets
    re-solved too -- a supplied policy directory's resolution is unknown."""
    return roster_mode == "full" and profile != "skip"
"""Materialising a candidate state on disk.

THE REASON THIS EXISTS. A candidate state is the canonical data plus an
overlay stack, and the loop holds that merged state in memory -- but neither
of the two things that must SEE it can read Python objects:

  - `mb_sim` loads `<sandbox>/app.yaml`, `<sandbox>/data/strategies.yaml`,
    `<sandbox>/data/bots.yaml` and `<sandbox>/data/characters/*.yaml` from
    disk, from whatever `--sandbox` names;
  - `test/solver-export.js` reads the character files from `MB_DATA_DIR`.

So a candidate is staged into a scratch sandbox and BOTH are pointed at it.
Without this the simulator would keep scoring the committed data no matter
what the emitter proposed -- every candidate would come back score-neutral,
which is exactly the failure this module was written to fix.

HOW the staged bytes are produced matters as much as that they exist: the
edits are applied by the same textual leaf replacement `--apply` uses
(`patch.apply_edits`), never by re-serialising a parsed document. One code
path defines what an applied edit looks like, so the state the simulator
scores is the state a later `--apply` would commit -- byte for byte, comments
and formatting intact.
"""

from __future__ import annotations

import shutil
from pathlib import Path
from typing import Any

from . import patch as P

__all__ = ["StageError", "stage_sandbox", "SANDBOX_FILES"]


class StageError(Exception):
    """A candidate state that cannot be materialised. Never staged partially."""


# Everything a staged sandbox must carry: what mb_sim's rules loader reads,
# plus the loop's own authored inputs, so a staged sandbox is a complete,
# self-contained experiment subject.
SANDBOX_FILES = ("app.yaml",)


def stage_sandbox(sandbox: Path, edits: list[dict[str, Any]], dest: Path) -> Path:
    """Writes a complete scratch sandbox at `dest` and returns it.

    `dest` is replaced wholesale, so a stale stage can never be scored by
    accident."""
    sandbox = Path(sandbox)
    dest = Path(dest)
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)

    for name in SANDBOX_FILES:
        src = sandbox / name
        if not src.exists():
            raise StageError(f"cannot stage: {src} is missing")
        shutil.copy2(src, dest / name)
    shutil.copytree(sandbox / "data", dest / "data")

    if edits:
        res = P.apply_edits(dest, edits)
        if res["errors"]:
            raise StageError("staging the candidate state failed: "
                             + "; ".join(res["errors"]))
    return dest
"""Tournament orchestration: build the roster, run mb_sim, aggregate a report.

This is the S5 layer that sits on the S1 driver (`tools/mb_driver.py`). The
driver counts; this module turns those counts into the object the balance
grammar scores -- the same shape `web/monkey-baiting/test/tournament.js --json`
wrote (`entrants`/`stats`/`head`/`issues`/...), because that shape IS the
grammar's detector input and the archive's re-scorable record.

THE SCORES ARE NEW. The simulator is a new oracle (`sim_version`, architecture
ruling 5(a)); numbers produced here are never compared with anything the JS
stack produced. What is preserved from the reference is the AGGREGATION and
the ISSUE VOCABULARY, so the grammar's twelve situations still mean what the
playbook says they mean.

Roster identity lives in `data/roster.yaml`: a (character, bot) pair carries a
grammar LABEL, and the two id forms (`<char>:<bot>` for mb_sim,
`<char>/<label>` for the grammar) are mapped here and nowhere else.
"""

from __future__ import annotations

import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from . import yamlio
from .data import Data, frame_budget

# tools/ is on sys.path when the package is imported through the loop's CLI;
# mb_driver lives beside the package, not inside it (it is the S1 contract).
_TOOLS = Path(__file__).resolve().parent.parent
if str(_TOOLS) not in sys.path:
    sys.path.insert(0, str(_TOOLS))

import mb_driver  # noqa: E402

__all__ = ["RosterError", "Entrant", "build_roster", "TournamentResult",
           "run_tournament", "tournament_json", "spam_board"]


class RosterError(Exception):
    """A roster that cannot be resolved against the canonical data."""


@dataclass(frozen=True)
class Entrant:
    char: str
    bot: str            # data/bots.yaml key -> mb_sim "<char>:<bot>"
    label: str          # grammar-visible label

    @property
    def sim_id(self) -> str:
        return f"{self.char}:{self.bot}"

    @property
    def id(self) -> str:
        return f"{self.char}/{self.label}"


def _load_roster_spec(data: Data) -> dict[str, Any]:
    path = data.sandbox / "data" / "roster.yaml"
    if not path.exists():
        raise RosterError(f"roster spec not found: {path}")
    doc = yamlio.load(path)
    for key in ("version", "entrants", "modes"):
        if key not in doc:
            raise RosterError(f"{path}: missing {key!r}")
    return doc


def build_roster(data: Data, mode: str) -> list[Entrant]:
    """Resolves `data/roster.yaml` mode `mode` against the canonical data.

    Order is (character-major, spec order) and is part of the run's identity:
    mb_sim's canonical match queue is enumerated over this list, so reordering
    it re-keys every result. Append, never reorder."""
    spec = _load_roster_spec(data)
    modes = spec["modes"]
    if mode not in modes:
        raise RosterError(f"unknown roster mode {mode!r}; have {sorted(modes)}")
    wanted = list(modes[mode])
    by_label = {e["label"]: e for e in spec["entrants"]}
    unknown = [w for w in wanted if w not in by_label]
    if unknown:
        raise RosterError(f"roster mode {mode!r} names undeclared entrants {unknown}")

    bot_table = data.bots.get("table")
    if not isinstance(bot_table, dict):
        raise RosterError("data/bots.yaml has no bots.table mapping")

    out: list[Entrant] = []
    for cid in data.character_ids:
        moves = list(data.characters[cid]["moves"])
        for label in wanted:
            entry = by_label[label]
            if entry.get("per_move"):
                for key in moves:
                    bot = f"{entry['bot']}-{key}"
                    if bot not in bot_table:
                        raise RosterError(
                            f"data/bots.yaml has no bot {bot!r}, needed by "
                            f"roster entrant {label!r} for {cid}/{key}")
                    out.append(Entrant(cid, bot, bot))
                continue
            bot = entry["bot"]
            if bot not in bot_table:
                raise RosterError(f"data/bots.yaml has no bot {bot!r}")
            out.append(Entrant(cid, bot, label))
    return out


# --------------------------------------------------------------------------
# running one tournament
# --------------------------------------------------------------------------

@dataclass
class TournamentResult:
    entrants: list[Entrant]
    stats: dict[str, dict[str, int]]
    head: dict[str, dict[str, dict[str, int]]]
    capped_matches: list[str]
    drawn_matches: list[str]
    seeds: int
    max_frames: int
    matches: int
    issues: list[str]
    record: dict[str, Any]        # the mb-run-record/1 from mb_driver
    wall_ms: float


def run_tournament(data: Data, entrants: list[Entrant], *, seeds: int,
                   perfect_dir: Path | None = None,
                   threads: int | None = None,
                   binary: Path | None = None,
                   sandbox_dir: Path | None = None,
                   verify: bool = False) -> TournamentResult:
    """One full round-robin through mb_sim, aggregated into the grammar's shape.

    `sandbox_dir` is the directory mb_sim loads its rules and data from. During
    a loop run that is the STAGED candidate state (see stage.py), not the
    committed sandbox -- `data` is the same state in memory. The two must
    always describe one state; passing one without the other is how a loop
    ends up scoring something it did not propose.

    Every knob mb_driver pins (threads, batch, partition) is pinned there, not
    here; this function owns only what the SCORE depends on."""
    if len(entrants) < 2:
        raise RosterError(f"a tournament needs at least 2 entrants (got {len(entrants)})")
    cfg = mb_driver.RunConfig(
        roster=[e.sim_id for e in entrants],
        seeds=seeds,
        sandbox=Path(sandbox_dir) if sandbox_dir is not None else data.sandbox,
        perfect=perfect_dir,
        threads=threads,
        binary=binary,
        roster_source="mb_loop/roster.yaml",
        label="mb_loop")
    run = mb_driver.run_tournament(cfg, verify=verify)
    return aggregate(data, entrants, run, seeds)


def aggregate(data: Data, entrants: list[Entrant], run: Any,
              seeds: int) -> TournamentResult:
    """Turns mb_sim's canonical result rows into the reference report shape.

    Deliberately NOT reusing mb_driver.aggregate(): that one is the driver's
    own counts (per-entrant W/L/D keyed on the sim id). The grammar needs
    per-LABEL standings, a directed head-to-head matrix, per-entrant round and
    timeout totals, and the capped/drawn match lists -- a different object,
    over the same rows."""
    by_index = list(entrants)
    ids = [e.id for e in entrants]
    stats = {i: {"wins": 0, "losses": 0, "draws": 0, "rounds": 0,
                 "tieRounds": 0, "timeouts": 0, "capped": 0} for i in ids}
    head: dict[str, dict[str, dict[str, int]]] = {
        a: {b: {"w": 0, "n": 0} for b in ids if b != a} for a in ids}
    capped_matches: list[str] = []
    drawn_matches: list[str] = []

    rows = run.record["oracle"]["rows"]
    for row in rows:
        a = by_index[row["entrant0"]]
        b = by_index[row["entrant1"]]
        s = row["seed_index"]
        for side in (a, b):
            stats[side.id]["rounds"] += row["rounds"]
            stats[side.id]["timeouts"] += row["timeouts"]
            stats[side.id]["tieRounds"] += row["tie_rounds"]
        head[a.id][b.id]["n"] += 1
        head[b.id][a.id]["n"] += 1

        capped = bool(row["capped"])
        drawn = bool(row["drawn"])
        if capped or drawn:
            stats[a.id]["draws"] += 1
            stats[b.id]["draws"] += 1
            if capped:
                stats[a.id]["capped"] += 1
                stats[b.id]["capped"] += 1
                capped_matches.append(
                    f"{a.id} vs {b.id} seed {s} ({row['frames']} frames)")
            else:
                drawn_matches.append(
                    f"{a.id} vs {b.id} seed {s} ({row['rounds']} rounds, "
                    f"{row['tie_rounds']} drawn)")
            continue
        if row["winner"] == 0:
            winner, loser = a, b
        elif row["winner"] == 1:
            winner, loser = b, a
        else:
            raise RosterError(f"result row has no winner and is not drawn: {row}")
        stats[winner.id]["wins"] += 1
        stats[loser.id]["losses"] += 1
        head[winner.id][loser.id]["w"] += 1

    result = TournamentResult(
        entrants=by_index, stats=stats, head=head,
        capped_matches=capped_matches, drawn_matches=drawn_matches,
        seeds=seeds, max_frames=frame_budget(data.rules), matches=len(rows),
        issues=[], record=run.record,
        wall_ms=run.record["non_oracle"]["wall_ms"])
    result.issues = build_issues(data, result)
    return result


# --------------------------------------------------------------------------
# the issue vocabulary the grammar's `tournament-issues` detector matches
# --------------------------------------------------------------------------

def _pct(w: int, n: int) -> int | None:
    return None if not n else round_half_up(100 * w / n)


def round_half_up(x: float) -> int:
    """JS Math.round: half goes UP (toward +inf), not to even. Detector bands
    are compared against these integers, so the tie rule is load-bearing."""
    import math
    return int(math.floor(x + 0.5))


def _h2h(T: TournamentResult, a: str, b: str) -> tuple[int, float | None]:
    d = T.head[a][b]["w"] + T.head[b][a]["w"]
    return d, (100.0 * T.head[a][b]["w"] / d if d else None)


def same_type(T: TournamentResult, cid: str, label: str) -> int | None:
    """A character's win rate against the SAME bot type only
    (default-vs-default, perfect-vs-perfect). Acceptance band 45-55."""
    me = next((e for e in T.entrants if e.char == cid and e.label == label), None)
    if me is None:
        return None
    w = n = 0
    for o in T.entrants:
        if o.label != label or o.char == cid:
            continue
        w += T.head[me.id][o.id]["w"]
        n += T.head[me.id][o.id]["w"] + T.head[o.id][me.id]["w"]
    return _pct(w, n)


def build_issues(data: Data, T: TournamentResult) -> list[str]:
    """Ported verbatim in ORDER and WORDING from `test/tournament.js` report():
    the grammar matches on the "<CATEGORY>: " prefix and the emitter parses
    character/move names back out of the text, so both are contract."""
    issues: list[str] = []

    # DEGENERATE: a spam bot beating its own character's default
    for e in T.entrants:
        if not e.label.startswith("spam-"):
            continue
        d_id = f"{e.char}/default"
        if d_id not in T.head.get(e.id, {}):
            continue
        d, p = _h2h(T, e.id, d_id)
        if p is not None and p > 50:
            issues.append(f"DEGENERATE: {e.id} beats its own default "
                          f"{round_half_up(p)}% ({d} decided)")

    # SPAM PRESSURE: a spam bot crushing another character's tuned default
    for e in T.entrants:
        if not e.label.startswith("spam-"):
            continue
        for d_ent in T.entrants:
            if d_ent.label != "default" or d_ent.char == e.char:
                continue
            _, p = _h2h(T, e.id, d_ent.id)
            if p is not None and p >= 75:
                issues.append(f"SPAM PRESSURE: {e.id} beats {d_ent.id} "
                              f"{round_half_up(p)}%")

    # CHARACTER: same-type band, acceptance 45-55, alarm 40-60
    for cid in data.character_ids:
        for label in ("default", "perfect"):
            v = same_type(T, cid, label)
            if v is None or 45 <= v <= 55:
                continue
            band = "ALARM, outside 40-60" if (v < 40 or v > 60) else "outside 45-55 acceptance"
            kind = "default-vs-default" if label == "default" else "perfect-vs-perfect"
            issues.append(f"CHARACTER: {cid} {kind} {v}% ({band})")

    # MATCHUP: default-vs-default pairings outside 25-75
    for a in T.entrants:
        if a.label != "default":
            continue
        for b in T.entrants:
            if b.label != "default" or a.id <= b.id:
                continue
            _, p = _h2h(T, a.id, b.id)
            if p is not None and (p < 25 or p > 75):
                issues.append(f"MATCHUP: {a.char} vs {b.char} (defaults) = "
                              f"{round_half_up(p)}/{round_half_up(100 - p)} "
                              f"(band 25-75%)")

    # TIMEOUTS: more than 20% of an entrant's rounds end on the watch
    for e in T.entrants:
        s = T.stats[e.id]
        if s["rounds"] and s["timeouts"] / s["rounds"] > 0.2:
            issues.append(f"TIMEOUTS: {e.id} "
                          f"{round_half_up(100 * s['timeouts'] / s['rounds'])}% "
                          f"of rounds end on the watch (band <=20%)")

    # FRAME CAP: a match that never resolved
    for cm in T.capped_matches:
        issues.append(f"FRAME CAP: {cm}")

    return issues


# --------------------------------------------------------------------------
# archived / grammar-visible form
# --------------------------------------------------------------------------

def tournament_json(T: TournamentResult) -> dict[str, Any]:
    """Shape-identical to what `test/tournament.js --json` wrote, plus a `sim`
    block: the run is only meaningful under one `sim_version`, and the record's
    oracle hash is what makes a stored tournament checkable."""
    rec = T.record
    return {
        "arena": "neutral",
        "seeds": T.seeds,
        "maxFrames": T.max_frames,
        "matches": T.matches,
        "entrants": [{"id": e.id, "char": e.char, "label": e.label,
                      "sim_id": e.sim_id} for e in T.entrants],
        "stats": T.stats,
        "head": T.head,
        "cappedMatches": T.capped_matches,
        "drawnMatches": T.drawn_matches,
        "issues": T.issues,
        "recordsPath": None,
        "sim": {
            "sim_version": rec["sim_version"],
            "hash": rec["oracle"]["hash"],
            "binary": rec["binary"],
            "threads": rec["config"]["threads"],
            "threads_used": rec["config"]["threads_used"],
            "batch": rec["config"]["batch"],
            "partition": rec["config"]["partition"],
            "perfect": rec["config"]["perfect"],
            "argv": rec["config"]["argv"],
        },
    }


def spam_board(report: dict[str, Any]) -> list[dict[str, Any]]:
    """The spam-parity scoreboard the grammar's `spam-parity` detector reads:
    for each spam bot, the fraction of OTHER spam bots it beats head to head
    (a tied pairing counts a half). Ported from `test/grammar.js` spamBoard()."""
    spam = [e for e in report["entrants"] if e["label"].startswith("spam-")]
    head = report["head"]
    out: list[dict[str, Any]] = []
    for e in spam:
        beaten = 0.0
        others = 0
        for o in spam:
            if o["id"] == e["id"]:
                continue
            w = head[e["id"]][o["id"]]["w"]
            l = head[o["id"]][e["id"]]["w"]
            if w + l == 0:
                continue
            others += 1
            if w > l:
                beaten += 1
            elif w == l:
                beaten += 0.5
        if others:
            out.append({"id": e["id"], "char": e["char"],
                        "move": e["label"][len("spam-"):],
                        "others": others,
                        "frac": round_half_up(100 * beaten / others)})
    return out
"""Minimal YAML reader/writer for the monkey-baiting balance loop.

WHY THIS EXISTS (reported finding, architecture S5): PyYAML is NOT importable
on this machine, in the system interpreter or in the solver venv, and the
project rule is to declare dependencies rather than pip-install them. Rather
than block the loop on a fleet change, this module reads exactly the YAML
subset the monkey-baiting data actually uses -- the same discipline
`systems/native/mb_rules.c` and `web/monkey-baiting/yaml.js` already follow,
and the same reason (a tiny, total, dependency-free reader over data we
author).

It is NOT a general YAML parser and never pretends to be. Anything outside the
supported subset raises `YamlError` naming the file and line. No silent
fallbacks (root CLAUDE.md decision 12).

SUPPORTED SUBSET
  - block mappings, nested by indentation (spaces only, tabs are an error)
  - block sequences (`- item`), of scalars or of mappings
  - single-line flow mappings `{a: 1, b: 2}` and flow sequences `[1, 2]`
  - folded (`>`) and literal (`|`) block scalars
  - `#` comments, at line start or after whitespace, outside quotes
  - scalars: double/single-quoted strings, true/false, null/~, ints, floats
    (incl. leading `-` and exponents), everything else is a plain string

NOT SUPPORTED (each raises): anchors/aliases, tags, multiple documents,
complex keys, multi-line flow collections, `? ` explicit keys, merge keys.

DRIFT GUARD: `tests/test_mb_loop.py` cross-checks this parser against PyYAML
on every canonical data file WHEN PyYAML is importable, so if the dependency
ever does land, disagreement is a test failure rather than a surprise.
"""

from __future__ import annotations

import re
from pathlib import Path
from typing import Any

__all__ = ["YamlError", "parse", "load", "dump", "dumps"]


class YamlError(Exception):
    """A document outside the supported subset, or a malformed one."""


_INT_RE = re.compile(r"^[+-]?\d+$")
_FLOAT_RE = re.compile(r"^[+-]?(\d+\.\d*|\.\d+|\d+)([eE][+-]?\d+)?$")


# --------------------------------------------------------------------------
# scalars
# --------------------------------------------------------------------------

def _unquote(text: str, where: str) -> str:
    quote = text[0]
    if len(text) < 2 or text[-1] != quote:
        raise YamlError(f"{where}: unterminated {quote}-quoted scalar: {text!r}")
    body = text[1:-1]
    if quote == "'":
        return body.replace("''", "'")
    out: list[str] = []
    i = 0
    while i < len(body):
        ch = body[i]
        if ch == "\\":
            i += 1
            if i >= len(body):
                raise YamlError(f"{where}: trailing backslash in {text!r}")
            nxt = body[i]
            out.append({"n": "\n", "t": "\t", "r": "\r", '"': '"',
                        "\\": "\\", "/": "/"}.get(nxt, nxt))
        else:
            out.append(ch)
        i += 1
    return "".join(out)


def _scalar(text: str, where: str) -> Any:
    text = text.strip()
    if text == "":
        return None
    if text[0] in "\"'":
        return _unquote(text, where)
    if text in ("null", "Null", "NULL", "~"):
        return None
    if text in ("true", "True", "TRUE"):
        return True
    if text in ("false", "False", "FALSE"):
        return False
    if _INT_RE.match(text):
        return int(text)
    if _FLOAT_RE.match(text):
        return float(text)
    if text[0] in "&*!":
        raise YamlError(f"{where}: anchors/aliases/tags are not supported: {text!r}")
    return text


# A quote character only OPENS a quoted scalar at a token start. Mid-token it
# is an ordinary character -- the authored data is full of apostrophes in plain
# scalars and comments ("THE CHAMPION'S BITCH", "Tom Cribb's dog"), and reading
# those as string delimiters is the classic way a hand-rolled reader breaks.
_TOKEN_START = " \t:,-[{"


def _opens_quote(line: str, i: int) -> bool:
    return line[i] in "\"'" and (i == 0 or line[i - 1] in _TOKEN_START)


def _strip_comment(line: str, where: str) -> str:
    """Removes a trailing `#` comment. A `#` inside a quoted scalar, or one not
    preceded by whitespace (e.g. a colour literal `#7A6A55`), is part of the
    value."""
    out: list[str] = []
    quote: str | None = None
    i = 0
    while i < len(line):
        ch = line[i]
        if quote is not None:
            out.append(ch)
            if ch == "\\" and quote == '"' and i + 1 < len(line):
                out.append(line[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if _opens_quote(line, i):
            quote = ch
            out.append(ch)
            i += 1
            continue
        if ch == "#" and (i == 0 or line[i - 1] in " \t"):
            break
        out.append(ch)
        i += 1
    if quote is not None:
        raise YamlError(f"{where}: unterminated quote")
    return "".join(out).rstrip()


# --------------------------------------------------------------------------
# flow collections (single line)
# --------------------------------------------------------------------------

def _split_flow(body: str, where: str) -> list[str]:
    parts: list[str] = []
    depth = 0
    quote: str | None = None
    cur: list[str] = []
    for i, ch in enumerate(body):
        if quote is not None:
            cur.append(ch)
            if ch == quote:
                quote = None
            continue
        if _opens_quote(body, i):
            quote = ch
            cur.append(ch)
            continue
        if ch in "{[":
            depth += 1
        elif ch in "}]":
            depth -= 1
        if ch == "," and depth == 0:
            parts.append("".join(cur))
            cur = []
            continue
        cur.append(ch)
    if quote is not None or depth != 0:
        raise YamlError(f"{where}: malformed flow collection")
    tail = "".join(cur).strip()
    if tail or parts:
        parts.append(tail)
    return [p.strip() for p in parts if p.strip() != "" or len(parts) == 1]


def _parse_flow(text: str, where: str) -> Any:
    text = text.strip()
    if text.startswith("{"):
        if not text.endswith("}"):
            raise YamlError(f"{where}: flow mapping must close on one line: {text!r}")
        out: dict[str, Any] = {}
        for part in _split_flow(text[1:-1], where):
            if not part:
                continue
            if ":" not in part:
                raise YamlError(f"{where}: flow mapping entry without ':': {part!r}")
            key, _, val = part.partition(":")
            out[_flow_key(key, where)] = _parse_value(val, where)
        return out
    if text.startswith("["):
        if not text.endswith("]"):
            raise YamlError(f"{where}: flow sequence must close on one line: {text!r}")
        return [_parse_value(p, where) for p in _split_flow(text[1:-1], where) if p != ""]
    raise YamlError(f"{where}: not a flow collection: {text!r}")


def _flow_key(text: str, where: str) -> str:
    key = _scalar(text, where)
    if not isinstance(key, str):
        key = str(key).lower() if isinstance(key, bool) else str(key)
    return key


def _parse_value(text: str, where: str) -> Any:
    text = text.strip()
    if text[:1] in ("{", "["):
        return _parse_flow(text, where)
    return _scalar(text, where)


# --------------------------------------------------------------------------
# block parser
# --------------------------------------------------------------------------

_KEY_RE = re.compile(r"^([^\s:#][^:]*?)\s*:(\s|$)")


class _Lines:
    def __init__(self, text: str, source: str) -> None:
        self.source = source
        self.raw = text.split("\n")
        self.i = 0

    def where(self, index: int | None = None) -> str:
        return f"{self.source}:{(self.i if index is None else index) + 1}"

    def peek(self) -> tuple[int, str] | None:
        """Next content line as (indent, stripped-of-comment text), or None."""
        while self.i < len(self.raw):
            raw = self.raw[self.i]
            if "\t" in raw[: len(raw) - len(raw.lstrip())]:
                raise YamlError(f"{self.where()}: tab in indentation")
            stripped = _strip_comment(raw, self.where())
            if stripped.strip() == "":
                self.i += 1
                continue
            indent = len(stripped) - len(stripped.lstrip(" "))
            return indent, stripped.strip()
        return None


def _block_scalar(lines: _Lines, style: str, parent_indent: int) -> str:
    """Consumes a `>` / `|` block scalar body. Chomping indicators are not
    supported; the result is stripped, which is what every authored use here
    (grammar summaries and rationales) wants."""
    body: list[str] = []
    base: int | None = None
    while lines.i < len(lines.raw):
        raw = lines.raw[lines.i]
        if raw.strip() == "":
            body.append("")
            lines.i += 1
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        if indent <= parent_indent:
            break
        if base is None:
            base = indent
        body.append(raw[base:] if len(raw) > base else "")
        lines.i += 1
    while body and body[-1] == "":
        body.pop()
    if style == "|":
        return "\n".join(body) + "\n" if body else ""
    out: list[str] = []
    for line in body:
        if line == "":
            out.append("\n")
        elif out and out[-1] not in ("", "\n"):
            out.append(" " + line)
        else:
            out.append(line)
    return ("".join(out)).strip() + "\n" if body else ""


def _parse_block(lines: _Lines, indent: int) -> Any:
    head = lines.peek()
    if head is None:
        return None
    if head[0] < indent:
        return None
    if head[1].startswith("- "):
        return _parse_seq(lines, head[0])
    return _parse_map(lines, head[0])


def _parse_seq(lines: _Lines, indent: int) -> list[Any]:
    out: list[Any] = []
    while True:
        head = lines.peek()
        if head is None or head[0] < indent:
            break
        cur_indent, text = head
        if cur_indent > indent:
            raise YamlError(f"{lines.where()}: unexpected indent inside a sequence")
        if text == "-":
            lines.i += 1
            out.append(_parse_block(lines, indent + 1))
            continue
        if not text.startswith("- "):
            break
        item = text[2:].strip()
        item_col = cur_indent + 2
        lines.i += 1
        if item[:1] in ("{", "["):
            out.append(_parse_flow(item, lines.where(lines.i - 1)))
            continue
        m = _KEY_RE.match(item)
        if m:
            # a mapping whose first key sits on the dash line
            entry: dict[str, Any] = {}
            _consume_map_entry(lines, entry, item, item_col, lines.i - 1)
            rest = _parse_map(lines, item_col) if _at_indent(lines, item_col) else {}
            for k, v in rest.items():
                entry[k] = v
            out.append(entry)
            continue
        out.append(_scalar(item, lines.where(lines.i - 1)))
    return out


def _at_indent(lines: _Lines, indent: int) -> bool:
    head = lines.peek()
    return head is not None and head[0] == indent


def _consume_map_entry(lines: _Lines, out: dict[str, Any], text: str,
                       indent: int, lineno: int) -> None:
    where = lines.where(lineno)
    m = _KEY_RE.match(text)
    if not m:
        raise YamlError(f"{where}: expected 'key: value', got {text!r}")
    key = _scalar(m.group(1), where)
    if isinstance(key, bool):
        key = "true" if key else "false"
    key = str(key)
    if key in out:
        raise YamlError(f"{where}: duplicate key {key!r}")
    value_text = text[m.end():].strip() if m.end() <= len(text) else ""
    if value_text in (">", "|", ">-", "|-", ">+", "|+"):
        if value_text[0] not in ">|" or len(value_text) > 1:
            if len(value_text) > 1:
                raise YamlError(f"{where}: chomping indicators are not supported")
        out[key] = _block_scalar(lines, value_text[0], indent)
        return
    if value_text == "":
        nxt = lines.peek()
        if nxt is None or nxt[0] <= indent:
            out[key] = None
            return
        out[key] = _parse_block(lines, nxt[0])
        return
    out[key] = _parse_value(value_text, where)


def _parse_map(lines: _Lines, indent: int) -> dict[str, Any]:
    out: dict[str, Any] = {}
    while True:
        head = lines.peek()
        if head is None or head[0] < indent:
            break
        cur_indent, text = head
        if cur_indent > indent:
            raise YamlError(f"{lines.where()}: unexpected indent in mapping "
                            f"(expected {indent}, got {cur_indent})")
        if text.startswith("- "):
            break
        lineno = lines.i
        lines.i += 1
        _consume_map_entry(lines, out, text, indent, lineno)
    return out


def parse(text: str, source: str = "<string>") -> Any:
    """Parses one YAML document from `text`. `source` names the file in errors."""
    if "\n---" in text or text.lstrip().startswith("---"):
        body = text.lstrip()
        if body.startswith("---"):
            text = body[3:]
        if "\n---" in text:
            raise YamlError(f"{source}: multiple documents are not supported")
    lines = _Lines(text.replace("\r\n", "\n").replace("\r", "\n"), source)
    head = lines.peek()
    if head is None:
        return None
    value = _parse_block(lines, head[0])
    trailing = lines.peek()
    if trailing is not None:
        raise YamlError(f"{lines.where()}: trailing content after the document "
                        f"({trailing[1]!r})")
    return value


def load(path: Path) -> Any:
    """Parses a YAML file. Files are authored UTF-8 (comments carry em-dashes)."""
    return parse(Path(path).read_text(encoding="utf-8"), str(path))


# --------------------------------------------------------------------------
# writer -- the same narrow subset, for patch overlay files
# --------------------------------------------------------------------------

_PLAIN_SAFE = re.compile(r"^[A-Za-z_][A-Za-z0-9_.\- ]*$")


def _needs_quote(s: str) -> bool:
    if s == "":
        return True
    if s.strip() != s:
        return True
    if s.lower() in ("true", "false", "null", "~", "yes", "no", "on", "off"):
        return True
    if _INT_RE.match(s) or _FLOAT_RE.match(s):
        return True
    if any(c in s for c in ":#{}[],&*!|>'\"%@`"):
        return True
    return not _PLAIN_SAFE.match(s)


def _scalar_str(v: Any) -> str:
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        # match the emitter's own normalisation: 6 decimals, no exponent, and
        # integral floats keep a trailing .0 so a type change stays visible
        if v == int(v) and abs(v) < 1e15:
            return f"{int(v)}.0"
        return f"{round(v, 6):.6f}".rstrip("0").rstrip(".")
    s = str(v)
    if _needs_quote(s):
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return s


def _flow_str(v: Any) -> str:
    if isinstance(v, list):
        return "[" + ", ".join(_flow_str(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ", ".join(f"{k}: {_flow_str(x)}" for k, x in v.items()) + "}"
    return _scalar_str(v)


def _write_block(obj: dict[str, Any], indent: int) -> list[str]:
    pad = " " * indent
    lines: list[str] = []
    for key, value in obj.items():
        if isinstance(value, dict):
            if not value:
                lines.append(f"{pad}{key}: {{}}")
                continue
            lines.append(f"{pad}{key}:")
            lines.extend(_write_block(value, indent + 2))
        elif isinstance(value, list):
            if any(isinstance(x, (dict, list)) for x in value):
                lines.append(f"{pad}{key}:")
                for item in value:
                    if isinstance(item, dict):
                        sub = _write_block(item, indent + 2)
                        lines.append(f"{pad}  - " + sub[0].lstrip())
                        lines.extend("  " + s for s in sub[1:])
                    else:
                        lines.append(f"{pad}  - {_scalar_str(item)}")
            else:
                lines.append(f"{pad}{key}: {_flow_str(value)}")
        else:
            lines.append(f"{pad}{key}: {_scalar_str(value)}")
    return lines


def dumps(obj: dict[str, Any]) -> str:
    """Serialises a nested map of scalars / numeric lists (the shape a patch
    overlay leaf can take). Not a general emitter."""
    if not isinstance(obj, dict):
        raise YamlError("dumps: only mappings are serialisable")
    return "\n".join(_write_block(obj, 0)) + "\n"


def dump(path: Path, obj: dict[str, Any]) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(dumps(obj), encoding="ascii")
