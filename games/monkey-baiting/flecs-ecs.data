def _synthetic_report() -> dict:
    """A report shaped like the real one but with hand-placed signals, so the
    emitter tests do not need the simulator and do not move when balance does."""
    d = D.load_data(SANDBOX)
    entrants = []
    for cid in d.character_ids:
        entrants.append({"id": f"{cid}/default", "char": cid, "label": "default"})
        for key in d.characters[cid]["moves"]:
            entrants.append({"id": f"{cid}/spam-{key}", "char": cid,
                             "label": f"spam-{key}"})
    ids = [e["id"] for e in entrants]
    head = {a: {b: {"w": 0, "n": 0} for b in ids if b != a} for a in ids}
    stats = {i: {"wins": 0, "losses": 0, "draws": 0, "rounds": 4, "tieRounds": 0,
                 "timeouts": 0, "capped": 0} for i in ids}
    head["jacco/spam-heavy"]["jacco/default"] = {"w": 4, "n": 4}
    head["jacco/default"]["jacco/spam-heavy"] = {"w": 0, "n": 4}
    return {
        "arena": "neutral", "seeds": 4, "maxFrames": 39700, "matches": 0,
        "entrants": entrants, "stats": stats, "head": head,
        "cappedMatches": [], "drawnMatches": [],
        "issues": [
            "DEGENERATE: jacco/spam-heavy beats its own default 100% (4 decided)",
            "CHARACTER: aistrop default-vs-default 30% (ALARM, outside 40-60)",
            "TIMEOUTS: brock/default 44% of rounds end on the watch (band <=20%)",
            "SPAM PRESSURE: jacco/spam-heavy beats billy/default 100%",
        ],
        "recordsPath": None,
    }


def _strip_volatile(patches: list[dict]) -> str:
    out = []
    for p in patches:
        q = copy.deepcopy(p)
        q.pop("emitted_at", None)
        out.append(q)
    return json.dumps(out, sort_keys=True)


def _tree_bytes(root: Path) -> dict[str, bytes]:
    out: dict[str, bytes] = {}
    for p in sorted(root.rglob("*")):
        if p.is_file():
            raw = p.read_bytes()
            if p.name == "patch.json":
                doc = json.loads(raw)
                doc.pop("emitted_at", None)
                raw = json.dumps(doc, sort_keys=True).encode()
            out[str(p.relative_to(root)).replace("\\", "/")] = raw
    return out


def _run_meta() -> dict:
    grammar_text = GRAMMAR.read_text(encoding="utf-8")
    pins_text = PINS.read_text(encoding="utf-8")
    return {
        "run_id": "run-1", "started_at": "2026-07-30T00:00:00Z", "seed": 1,
        "knobs": {"failure_budget": 3, "run_patience": 5, "max_depth": 8,
                  "candidates_per_depth": 6, "eval_seeds": 4},
        "grammar": {"version": 3, "file": "data/balance-grammar.yaml",
                    "sha": archive.content_hash(grammar_text)},
        "pins": {"file": "data/balance-pins.yaml",
                 "sha": archive.content_hash(pins_text), "count": 47},
        "roster": {"mode": "no-perfect", "entrants": [], "perfect_dir": None},
        "match_rules": {"seeds": 4, "max_frames": 39700, "arena": "neutral"},
        "solve": {"profile": "skip"}, "sim": {"sim_version": "mb-1"},
        "code": {"git_commit": None, "git_dirty": None},
        "grammar_text": grammar_text, "pins_text": pins_text,
    }


def _score_obj(score, parent, delta, verdict, height, parent_round) -> dict:
    return {"schema": "mb-score/2", "round": None, "grammar_version": 3,
            "score": score, "baseline_score": 10, "parent_score": parent,
            "delta": delta, "verdict": verdict, "per_situation": [],
            "inputs": {"tournament": "tournament.json", "framedata": "framedata.json"},
            "lineage": {"height": height, "parent_round": parent_round,
                        "lineage_id": "run-1", "rng_stream": None,
                        "champion_at_height": None, "pruned_reason": None,
                        "demoted": None, "policy_sha": None, "model_sha": None,
                        "resolved_pairs": None, "solver_version": None,
                        "solver_backend": None}}


def _tiny_report() -> dict:
    return {"arena": "neutral", "seeds": 1, "maxFrames": 1, "matches": 0,
            "entrants": [], "stats": {}, "head": {}, "cappedMatches": [],
            "drawnMatches": [], "issues": [], "recordsPath": None}


