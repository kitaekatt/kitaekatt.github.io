# MONKEY BAITING -- the scored roster (balance-loop input, not runtime data).
#
# A tournament entrant is a (character, bot) pair. This file says which bots
# from data/bots.yaml join the scored field and what GRAMMAR LABEL each one
# carries. The label is what data/balance-grammar.yaml's detectors match on
# ("default", "spam-<move>", "random", "passive", "perfect"), so the mapping is
# declared here explicitly rather than being an alias hidden in code.
#
# Two identity forms, one entrant:
#   mb_sim id       "<char>:<bot>"    e.g. jacco:house      (../CLAUDE.md)
#   grammar id      "<char>/<label>"  e.g. jacco/default
#
# per_move: true enumerates one entrant per MOVE KEY the character actually
# authors ("spam-light", "spam-heavy", ...). mb_sim refuses an entrant naming
# a move its character does not author, so the enumeration is driven by the
# character YAML, never by crossing blindly.
#
# needs_policies: true entrants only join when a solved-policy directory is
# supplied (mb_sim --perfect DIR) -- they are refused, never demoted.
#
# A roster change changes what a score MEANS. run.json records the resolved
# entrant list, and scores are comparable only within one roster.

version: 1

entrants:
  - {bot: house,   label: default}
  - {bot: chaos,   label: random}
  - {bot: dummy,   label: passive}
  - {bot: spam,    label: spam, per_move: true}
  - {bot: perfect, label: perfect, needs_policies: true}

# Named fields. `no-perfect` is the cheap field (no solver in the loop at all);
# `full` adds the solved yardstick and makes the run solver-relevant.
modes:
  no-perfect: [default, random, passive, spam]
  full:       [default, random, passive, spam, perfect]
# MONKEY BAITING -- STRATEGIES: the primitive decision methods.
#
# Ported from web/monkey-baiting/data/strategies.yaml. Canonical model: each
# decision method is a STRATEGY; all BOTS are expressed as weight and
# proximity data over the available strategies (data/bots.yaml). Strategies
# are code + params here; bots are pure data there. Only strategies decide
# actions.
#
# SCALING: decimals become Q16.16 at load; the `*_chance` values become u32
# thresholds over 2^32 and are compared against a raw mulberry32 word.
#
# CADENCE (part of the draw contract in ../CLAUDE.md): every strategy has a
# fixed decision cadence in frames. Between decisions the last input is
# replayed with the press bits dropped and the direction/block bits kept.
#   default -- ai.decision_interval_frames from app.yaml (16)
#   spam    -- 1 (per frame; it is pure pressure and must react on cooldown)
#   random  -- params.decision_interval
#   passive -- 1
#   perfect -- 1 (it decides every actionable frame and paces ITSELF through
#              params.hold_*; between held frames it draws nothing)
#
# kinds:
#   default -- the tuned house AI; per-character params live in each
#              character's own `ai:` block (data/characters/*.yaml)
#   spam    -- spam(move): approach until the move can reach, then use ONLY
#              that move on cooldown; never blocks or jumps. Referenced from
#              bot tables as spam-<move> (resolved per character).
#   random  -- uniform among legal actions on a decision tick; seeded
#   passive -- never attacks; block_chance on threat + maintain_distance.
#   perfect -- plays a solved equilibrium policy, one per ORDERED character
#              pair, loaded from a directory given on the command line
#              (mb_sim --perfect DIR; see ../CLAUDE.md, "Perfect-policy
#              playback"). An entrant that can roll this strategy without the
#              pair's policy file present and valid fails the load loudly,
#              never degrading silently to another strategy.

strategies:
  default:
    kind: default

  spam:
    kind: spam
    params:
      reach_margin: 6.0      # press within this many px inside the move's reach
      leap_reach_bonus: 40.0 # extra reach credited to leaping moves (WINDPIPE)
      unranged_reach: 999.0  # hazard/yank/retreat moves press from anywhere

  random:
    kind: random
    params:
      decision_interval: 10  # frames between fresh picks
      move_weight: 0.5       # mass on attacks vs movement/defence

  passive:
    kind: passive
    params:
      block_chance: 0.5      # chance to block when a threat is winding up
      maintain_distance: 60.0 # walk to hold this gap (0 = stand still)
      near_margin: 6.0       # back off when the gap is under distance - this
      far_margin: 20.0       # close in when the gap is over distance + this

  perfect:
    kind: perfect
    params:
      # Frames the chosen action is REPLAYED before the next decision, one
      # class per action kind (an action therefore costs hold + 1 frames).
      # These are the solver's own rollout commitments: the policy was solved
      # under exactly these durations, so changing one here without re-solving
      # makes the played policy answer a different game.
      hold_walk: 5           # walk_to / walk_away
      hold_block: 8
      hold_wait: 2
      hold_move: 0           # a move press commits by entering its own frames
      hold_cd_miss: 2        # walk instead, when a cd flag disagreed
# One of the two fighters in a match slot. All values are Q16.16 or whole
# frames per components/README.md. Character stats (max_health, walk_speed,
# move frame data) are NOT components - they are immutable shared tables
# indexed by MbRefs.char_id, loaded once from the character data.
name: MbFighterUnit
abstract: true
components:
  MbBody:      { x: 0, y: 0, vx: 0, vy: 0 }
  MbVitals:    { hp: 0, damage_mult: 65536, chip_residual: 0 }
  MbFsm:       { state: 0, t: 0, stun_t: 0, dazed_t: 0, invuln_frames: 0, hit_index: -1, facing: 1 }
  MbMoveSlot:  { move_id: -1, move_key: -1, leap_vx: 0, proj_t: 0 }
  MbCooldowns: { cd: [0, 0, 0, 0, 0, 0, 0, 0] }
  MbRetreat:   { dir: 0, t: 0 }
  MbGrab:      { t: 0, move_id: -1, side_foe: -1 }
  MbYank:      { target: 0, speed: 0 }
  MbRefs:      { char_id: -1, entrant_id: -1, slot: -1, side: 0, rounds_won: 0 }
  MbBrain:     { policy_kind: 0, policy_id: -1, hold: 0, plan_action: -1, plan_left: 0, held_input: 0 }
  MbInput:     { bits: 0 }
  MbFighter:   true
# The injectable "start this match" entity. Spawned from the CLI, from a
# browser client, or by any automation; match_harvest consumes it on the next
# turn and appends the match to the hosted queue.
#
#   python3 tools/inject.py --template MbMatchRequest --set \
#     'MbSpawnRequest: {char0: "billy", bot0: "house", char1: "puss", bot1: "chaos", seed_index: 3}'
#
# The defaults below are deliberately empty: a request that names no entrants
# is refused loudly rather than defaulting to some pairing (root CLAUDE.md
# decision 12). Every field must be supplied by whoever injects it.
name: MbMatchRequest
abstract: true
components:
  MbSpawnRequest: { char0: "", bot0: "", char1: "", bot1: "", seed_index: 0 }
# One batch slot. A slot is created once and reused: when its match ends,
# match_harvest writes the result to its canonical index and resets the slot
# in place from the pairing queue. Slots are never created or destroyed
# mid-run, so the batch stays a single archetype with stable columns - the
# same layout a CUDA launch would consume.
name: MbMatchSlot
abstract: true
components:
  MbClock:    { frame: 0, timer: 0, round: 0, phase: 0, phase_t: 0, freeze: 0, slowmo: 0, shake: 0 }
  MbRng:      { state: 0, seed: 0 }
  MbPair:     { entrant0: -1, entrant1: -1, char0: -1, char1: -1, seed_index: 0, result_index: -1 }
  MbCross:    { t: 0, window: 0, cheater: -1, victim: -1 }
  MbFinisher: { window_t: 0, rearm: 0 }
  MbOutcome:  { winner: -1, frames: 0, rounds: 0, tie_rounds: 0, timeouts: 0, finishers: 0 }
  MbHazards:  { count: 0 }
  MbMatch:    true
/* MONKEY BAITING - engine hosting. See mb_engine.h. */
#include "mb_engine.h"
#include "mb_rules.h"
#include "mb_step.h"

#include "engine/systems.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MB_ENGINE_MAX_ENTRANTS 64
#define MB_ENGINE_MAX_REQUESTS 64   /* injections admitted per turn */

/* Entrant identity is the ../CLAUDE.md string "<char_id>:<bot_id>"; the
 * entrant INDEX in a result row is the entrant's position in the field, in
 * first-appearance order. mb_sim enumerates its whole field up front; a host
 * that admits matches one at a time interns them as they arrive, which comes
 * to the same thing for the same sequence of matches. */
typedef struct {
    char id[64];
} MbEntrant;

typedef struct {
    MbWorld *world;
    MbRules rules;
    MbEntrant entrants[MB_ENGINE_MAX_ENTRANTS];
    int entrant_count;
    int harvested;
    int lost;               /* the slot entities were deleted under us */
    /* The interactive seam (mb_engine.h). Per host, never a file static. */
    int human_mask;
    uint32_t human_bits[2];
} MbHost;

/* The MbSpawnRequest component, mirrored in components/MbSpawnRequest.yaml.
 * Field ORDER and types must match that file exactly; the size is checked
 * against the registered type at app start, the same drift guard mb_schema
 * applies to the batch components. */
typedef struct {
    char *char0;
    char *bot0;
    char *char1;
    char *bot1;
    int32_t seed_index;
} MbSpawnRequestC;

/* ------------------------------------------------------------- host slot */

/* No file statics: the host hangs off the world's user context, so it is per
 * world (../CLAUDE.md rule 1). */
static MbHost *mb_host(Engine *engine) {
    if (!engine || !engine->world) return NULL;
    return (MbHost *)ecs_get_ctx(engine->world);
}

static void mb_host_free(void *ptr) {
    /* Called by ecs_fini: the world is being destroyed, so the slot entities
     * must not be touched. */
    MbHost *h = (MbHost *)ptr;
    if (!h) return;
    if (h->world) mb_world_release(h->world);
    free(h);
}

static void mb_host_teardown(Engine *engine) {
    MbHost *h = mb_host(engine);
    if (!h) return;
    ecs_set_ctx(engine->world, NULL, NULL);
    if (h->world) mb_world_destroy(h->world);   /* deletes its own entities */
    free(h);
}

/* Every system's first act. Returns NULL when there is nothing to step. */
static MbHost *mb_host_active(Engine *engine) {
    MbHost *h = mb_host(engine);
    int n = 0;
    const ecs_entity_t *ents;
    if (!h || h->lost) return NULL;

    /* The slot entities are ordinary user entities so a match is visible over
     * REST - which means POST /api/sim/reset deletes them. The bound columns
     * die with them, so refuse to step and say why, once. Rebuilding is
     * POST /api/app/start (root CLAUDE.md "Order of Operations"). */
    ents = mb_world_entities(h->world, &n);
    if (n <= 0 || !ecs_is_alive(engine->world, ents[0])) {
        fprintf(stderr, "monkey-baiting: the match slots were deleted (sim/reset?); "
                        "POST /api/app/start to rebuild\n");
        h->lost = 1;
        return NULL;
    }
    return h;
}

MbWorld *mb_engine_world(Engine *engine) {
    MbHost *h = mb_host(engine);
    return h ? h->world : NULL;
}

int mb_engine_harvested(Engine *engine) {
    MbHost *h = mb_host(engine);
    return h ? h->harvested : 0;
}

/* ------------------------------------------------------------- entrants */

static int mb_entrant_intern(MbHost *h, const char *id) {
    int i;
    for (i = 0; i < h->entrant_count; i++)
        if (strcmp(h->entrants[i].id, id) == 0) return i;
    if (h->entrant_count >= MB_ENGINE_MAX_ENTRANTS) {
        fprintf(stderr, "monkey-baiting: more than %d distinct entrants on one "
                        "hosted world\n", MB_ENGINE_MAX_ENTRANTS);
        return -1;
    }
    if (strlen(id) >= sizeof(h->entrants[0].id)) {
        fprintf(stderr, "monkey-baiting: entrant id '%s' is too long\n", id);
        return -1;
    }
    snprintf(h->entrants[h->entrant_count].id,
             sizeof(h->entrants[0].id), "%s", id);
    return h->entrant_count++;
}

/* Builds the pairing for two entrant id strings, exactly as the tournament
 * does: resolve each id, intern it, and seed from the two ids plus the seed
 * index (../CLAUDE.md, "Entrant identity"). Loud on every refusal. */
static int mb_pairing_from_ids(MbHost *h, const char *id0, const char *id1,
                               int seed_index, MbPairing *out) {
    int c0, b0, c1, b1, e0, e1;
    if (!mb_rules_resolve_entrant(&h->rules, id0, 0, &c0, &b0)) return 0;
    if (!mb_rules_resolve_entrant(&h->rules, id1, 0, &c1, &b1)) return 0;
    e0 = mb_entrant_intern(h, id0);
    e1 = mb_entrant_intern(h, id1);
    if (e0 < 0 || e1 < 0) return 0;

    memset(out, 0, sizeof(*out));
    out->entrant0 = e0;
    out->entrant1 = e1;
    out->char0 = c0;
    out->char1 = c1;
    out->bot0 = b0;
    out->bot1 = b1;
    out->seed_index = seed_index;
    out->seed = mb_seed_for(id0, id1, seed_index);
    return 1;
}

/* --------------------------------------------------------- the systems */

/* Ten shells over the ten sweeps of mb_step_tick, in app.yaml system_order.
 * Each one self-gates through mb_host_active and then steps the whole batch;
 * the per-slot gate on MbClock.active is inside the sweep itself (root
 * CLAUDE.md decision 15). */
#define MB_ENGINE_SYSTEM(sysname, sweep)                       \
    static void sysname(Engine *engine) {                      \
        MbHost *h = mb_host_active(engine);                    \
        if (!h) return;                                        \
        sweep(mb_world_batch(h->world));                       \
    }

MB_ENGINE_SYSTEM(mb_sys_match_phase,   mb_step_match_phase)
MB_ENGINE_SYSTEM(mb_sys_ai_decide,     mb_step_ai_decide)
MB_ENGINE_SYSTEM(mb_sys_step_fighter,  mb_step_fighter)
MB_ENGINE_SYSTEM(mb_sys_step_attack,   mb_step_attack)
MB_ENGINE_SYSTEM(mb_sys_step_hazards,  mb_step_hazards)
MB_ENGINE_SYSTEM(mb_sys_step_cross,    mb_step_cross)
MB_ENGINE_SYSTEM(mb_sys_step_finisher, mb_step_finisher)
MB_ENGINE_SYSTEM(mb_sys_separate,      mb_step_separate)
MB_ENGINE_SYSTEM(mb_sys_announcements, mb_step_announcements)
MB_ENGINE_SYSTEM(mb_sys_round_resolve, mb_step_round_resolve)

/* The one system that is NOT a sweep: it hands a side of slot 0 to a human by
 * overwriting the input ai_decide just wrote, before step_fighter reads it.
 * See mb_engine.h. Inert (and free) when no human side is registered, which is
 * every batch run and every test that compares against mb_sim. */
static void mb_sys_human_input(Engine *engine) {
    MbHost *h = mb_host_active(engine);
    MbBatch *b;
    int side;
    if (!h || !h->human_mask) return;
    b = mb_world_batch(h->world);
    if (!b || b->count < 1) return;
    for (side = 0; side < 2; side++)
        if (h->human_mask & (1 << side))
            b->input[MB_F(0, side)].bits = h->human_bits[side];
}

void mb_engine_set_human(Engine *engine, int side_mask) {
    MbHost *h = mb_host(engine);
    if (!h) return;
    h->human_mask = side_mask & 3;
    if (!(h->human_mask & 1)) h->human_bits[0] = 0;
    if (!(h->human_mask & 2)) h->human_bits[1] = 0;
}

int mb_engine_get_human(Engine *engine) {
    MbHost *h = mb_host(engine);
    return h ? h->human_mask : 0;
}

void mb_engine_set_human_input(Engine *engine, int side, uint32_t bits) {
    MbHost *h = mb_host(engine);
    if (!h || side < 0 || side > 1) return;
    h->human_bits[side] = bits;
}

/* Consumes injected MbSpawnRequest entities into the queue. This is the
 * repo's ECS interaction pattern (root CLAUDE.md): tools/inject.py writes the
 * component over REST, the engine processes it through the normal pipeline on
 * the next turn, and the WASM client will create the identical entity in
 * process. Queue admission is host-side scheduling, which is why it lives in
 * match_harvest and not in a step function. */
static int mb_drain_requests(Engine *engine, MbHost *h) {
    ecs_entity_t comp = ecs_lookup(engine->world, "MbSpawnRequest");
    ecs_entity_t pending[MB_ENGINE_MAX_REQUESTS];
    int n = 0, i, admitted = 0;
    ecs_query_t *q;
    ecs_iter_t it;

    if (!comp) return 0;
    q = ecs_query(engine->world, {
        .terms = {{ .id = comp }},
        .cache_kind = EcsQueryCacheNone
    });
    if (!q) return 0;

    it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (i = 0; i < it.count; i++) {
            if (n >= MB_ENGINE_MAX_REQUESTS) {
                /* Not dropped: the rest are still there next turn. */
                ecs_iter_fini(&it);   /* root CLAUDE.md decision 7 */
                goto drain;
            }
            pending[n++] = it.entities[i];
        }
    }
drain:
    ecs_query_fini(q);

    for (i = 0; i < n; i++) {
        const MbSpawnRequestC *req =
            (const MbSpawnRequestC *)ecs_get_id(engine->world, pending[i], comp);
        MbPairing p;
        char id0[64], id1[64];
        if (!req || !req->char0 || !req->bot0 || !req->char1 || !req->bot1 ||
            !req->char0[0] || !req->bot0[0] || !req->char1[0] || !req->bot1[0]) {
            fprintf(stderr, "monkey-baiting: MbSpawnRequest needs char0, bot0, "
                            "char1 and bot1; ignored\n");
        } else {
            /* The canonical entrant id, composed here and resolved by the one
             * function allowed to (../CLAUDE.md, "Entrant identity"). */
            snprintf(id0, sizeof(id0), "%s:%s", req->char0, req->bot0);
            snprintf(id1, sizeof(id1), "%s:%s", req->char1, req->bot1);
            if (mb_pairing_from_ids(h, id0, id1, req->seed_index, &p))
                if (mb_world_enqueue(h->world, &p)) admitted++;
        }
        /* The request is consumed either way: a refusal has already said what
         * was wrong, and leaving it would repeat that every turn. */
        ecs_delete(engine->world, pending[i]);
    }
    return admitted;
}

/* mb_world_run's tail, one turn at a time: harvest what finished, admit what
 * was injected, refill free slots from the queue. */
static void mb_sys_match_harvest(Engine *engine) {
    MbHost *h = mb_host_active(engine);
    if (!h) return;
    h->harvested += mb_world_harvest(h->world);
    mb_drain_requests(engine, h);
    mb_world_fill(h->world);
}

/* -------------------------------------------------------------- app.yaml */

/* The engine-hosted match, from app.yaml's `engine:` block, or from
 * `engine.configs.<name>` when POST /api/app/start named a config. Every key
 * is required in whichever block is used - no defaults, no falling back to
 * the top-level block from a named one (root CLAUDE.md decision 12). */
typedef struct {
    int batch;
    char entrant0[64];
    char entrant1[64];
    int seed_index;
} MbEngineConfig;

static int mb_cfg_str(const MbYamlDoc *doc, const char *prefix, const char *key,
                      char *out, size_t outsz) {
    char full[MB_YAML_MAX_KEY];
    const char *v;
    snprintf(full, sizeof(full), "%s%s", prefix, key);
    v = mb_yaml_get(doc, full);
    if (!v) {
        fprintf(stderr, "monkey-baiting: app.yaml is missing '%s'\n", full);
        return 0;
    }
    snprintf(out, outsz, "%s", v);
    return 1;
}

static int mb_cfg_int(const MbYamlDoc *doc, const char *prefix, const char *key,
                      int *out) {
    char buf[64];
    if (!mb_cfg_str(doc, prefix, key, buf, sizeof(buf))) return 0;
    *out = atoi(buf);
    return 1;
}

static int mb_engine_config_load(const char *sandbox_dir, const char *config_name,
                                 MbEngineConfig *out) {
    MbYamlDoc doc;
    char path[512];
    char prefix[MB_YAML_MAX_KEY];

    snprintf(path, sizeof(path), "%s/app.yaml", sandbox_dir);
    if (!mb_yaml_read(path, &doc)) return 0;

    if (config_name && config_name[0])
        snprintf(prefix, sizeof(prefix), "engine.configs.%s.", config_name);
    else
        snprintf(prefix, sizeof(prefix), "engine.");

    if (!mb_cfg_int(&doc, prefix, "batch", &out->batch)) return 0;
    if (!mb_cfg_str(&doc, prefix, "entrant0", out->entrant0, sizeof(out->entrant0)))
        return 0;
    if (!mb_cfg_str(&doc, prefix, "entrant1", out->entrant1, sizeof(out->entrant1)))
        return 0;
    if (!mb_cfg_int(&doc, prefix, "seed_index", &out->seed_index)) return 0;
    if (out->batch <= 0) {
        fprintf(stderr, "monkey-baiting: %sbatch must be > 0\n", prefix);
        return 0;
    }
    return 1;
}

/* ----------------------------------------------------------- registration */

/* Makes the batch's entities first-class engine entities so a running match
 * is visible over GET /api/entities and readable by tools/inspect.py. Done
 * BETWEEN attach and bind: every one of these adds moves the entity to
 * another table, and the column bind must be the last structural word. */
static void mb_decorate(Engine *engine, MbWorld *w, int batch) {
    ecs_entity_t user_tag = ecs_lookup(engine->world, "UserEntity");
    ecs_entity_t eid_comp = ecs_lookup(engine->world, "EntityId");
    const ecs_entity_t *ents;
    int n = 0, i;
    char name[64];

    ents = mb_world_entities(w, &n);
    for (i = 0; i < n; i++) {
        if (i < batch) snprintf(name, sizeof(name), "MbMatch%d", i);
        else snprintf(name, sizeof(name), "MbFighter%d_%d",
                      (i - batch) / 2, (i - batch) % 2);
        ecs_set_name(engine->world, ents[i], name);
        if (user_tag) ecs_add_id(engine->world, ents[i], user_tag);
        if (eid_comp) {
            engine->entity_id_counter++;
            ecs_set_id(engine->world, ents[i], eid_comp,
                       sizeof(ecs_i32_t), &engine->entity_id_counter);
        }
    }
}

/* The injection component must be the C struct this file reads, or the field
 * offsets are wrong. Same guard as mb_schema's, applied at app start. */
static int mb_check_spawn_request(Engine *engine) {
    ecs_entity_t comp = ecs_lookup(engine->world, "MbSpawnRequest");
    const ecs_type_info_t *ti;
    if (!comp) {
        fprintf(stderr, "monkey-baiting: MbSpawnRequest is not registered; "
                        "add it to app.yaml templates.components\n");
        return 0;
    }
    ti = ecs_get_type_info(engine->world, comp);
    if (!ti || (size_t)ti->size != sizeof(MbSpawnRequestC)) {
        fprintf(stderr, "monkey-baiting: MbSpawnRequest registered size %d != "
                        "sizeof C struct %d\n",
                ti ? ti->size : -1, (int)sizeof(MbSpawnRequestC));
        return 0;
    }
    return 1;
}

static void mb_register_systems(Engine *engine) {
    /* Legacy (non-pipeline) mode only: order comes from app.yaml
     * system_order, which is the frame order. The pipeline path would need
     * DependsOn edges between eleven systems that all touch the whole batch,
     * which buys nothing - the parallelism this game wants is world-per-core
     * (mb_pool), never in-tick (../CLAUDE.md, "Threading"). */
    engine_system_register_native(engine, "match_phase",   mb_sys_match_phase);
    engine_system_register_native(engine, "ai_decide",     mb_sys_ai_decide);
    engine_system_register_native(engine, "human_input",   mb_sys_human_input);
    engine_system_register_native(engine, "step_fighter",  mb_sys_step_fighter);
    engine_system_register_native(engine, "step_attack",   mb_sys_step_attack);
    engine_system_register_native(engine, "step_hazards",  mb_sys_step_hazards);
    engine_system_register_native(engine, "step_cross",    mb_sys_step_cross);
    engine_system_register_native(engine, "step_finisher", mb_sys_step_finisher);
    engine_system_register_native(engine, "separate",      mb_sys_separate);
    engine_system_register_native(engine, "announcements", mb_sys_announcements);
    engine_system_register_native(engine, "round_resolve", mb_sys_round_resolve);
    engine_system_register_native(engine, "match_harvest", mb_sys_match_harvest);
}

/* The whole build, for a config that is already resolved. Both entry points
 * below are this function plus where the config came from: app/start reads
 * app.yaml, mb_engine_restart is handed a pairing. Returns 1, or 0 with a
 * message already printed and no host installed. */
static int mb_build(Engine *engine, const char *dir, const MbEngineConfig *cfg) {
    MbHost *h;
    MbPairing p;

    h = (MbHost *)calloc(1, sizeof(MbHost));
    if (!h) return 0;

    if (!mb_rules_load(&h->rules, dir)) { free(h); return 0; }

    h->world = mb_world_attach(engine->world, &h->rules, cfg->batch);
    if (!h->world) { free(h); return 0; }
    mb_decorate(engine, h->world, cfg->batch);
    if (!mb_world_attach_bind(h->world)) {
        mb_world_destroy(h->world);
        free(h);
        return 0;
    }

    if (!mb_pairing_from_ids(h, cfg->entrant0, cfg->entrant1, cfg->seed_index, &p) ||
        !mb_world_set_queue(h->world, &p, 1)) {
        mb_world_destroy(h->world);
        free(h);
        return 0;
    }
    /* Deal the first match now, so turn 1 is already frame 1 of a fight
     * rather than an empty tick. mb_world_run fills before its first tick for
     * the same reason, which is what keeps the two paths frame-aligned. */
    mb_world_fill(h->world);

    ecs_set_ctx(engine->world, h, mb_host_free);
    mb_register_systems(engine);
    return 1;
}

/* engine->sandbox_dir carries a trailing slash; the rules loader appends its
 * own separators. */
static void mb_sandbox_dir(Engine *engine, char *out, size_t outsz) {
    size_t len;
    snprintf(out, outsz, "%s", engine->sandbox_dir);
    len = strlen(out);
    while (len > 1 && (out[len - 1] == '/' || out[len - 1] == '\\'))
        out[--len] = '\0';
}

/* Shared preflight for both entry points. */
static int mb_can_build(Engine *engine) {
    if (!engine || !engine->world) return 0;
    if (engine->pipeline_active) {
        fprintf(stderr, "monkey-baiting: the Flecs pipeline is not supported "
                        "(see mb_engine.c); start without --threads\n");
        return 0;
    }
    return mb_check_spawn_request(engine);
}

void monkey_baiting_register_native_systems(Engine *engine) {
    MbEngineConfig cfg;
    char dir[512];

    if (!engine || !engine->world) return;

    /* A second app/start replaces the first: destroy the old batch, entities
     * and all, before building a new one. */
    mb_host_teardown(engine);

    if (!mb_can_build(engine)) return;

    mb_sandbox_dir(engine, dir, sizeof(dir));
    if (!mb_engine_config_load(dir, engine->active_config, &cfg)) return;
    mb_build(engine, dir, &cfg);
}

int mb_engine_restart(Engine *engine, const char *entrant0, const char *entrant1,
                      int seed_index) {
    MbEngineConfig cfg;
    char dir[512];

    if (!entrant0 || !entrant1 || !mb_can_build(engine)) return 0;

    mb_sandbox_dir(engine, dir, sizeof(dir));
    /* The batch width still comes from app.yaml - it is a harness knob, not a
     * client parameter (root CLAUDE.md decision 13). Only the pairing is the
     * caller's. */
    if (!mb_engine_config_load(dir, engine->active_config, &cfg)) return 0;
    snprintf(cfg.entrant0, sizeof(cfg.entrant0), "%s", entrant0);
    snprintf(cfg.entrant1, sizeof(cfg.entrant1), "%s", entrant1);
    cfg.seed_index = seed_index;

    mb_host_teardown(engine);
    return mb_build(engine, dir, &cfg);
}
/* MONKEY BAITING - engine hosting (architecture stage S6).
 *
 * The ONLY file in systems/native/ that knows the engine exists. It is a
 * shell, exactly like sandboxes/<x>/systems/native/systems.c elsewhere in
 * this repo: it registers the eleven frame-order systems of app.yaml as
 * native systems on an Engine, and each one calls the corresponding
 * mb_step_* sweep in mb_step.c. There is one implementation of the rules
 * (../CLAUDE.md, "systems/native - one implementation, three consumers");
 * hosting must not fork behaviour, and test_mb_engine asserts that an
 * engine-hosted match produces the SAME result row as mb_sim.
 *
 * FRAME = TURN. One POST /api/sim/turn advances every live match by exactly
 * one frame, because the eleven systems the engine runs per turn are the ten
 * mb_step_* sweeps of mb_step_tick plus the host-side harvest that
 * mb_world_run does after each tick. The engine's turn counter is therefore
 * the frame counter, at logic_hz frames per second of game time.
 *
 * WHERE THE STATE LIVES. Never in a file static - ../CLAUDE.md rule 1. The
 * whole host hangs off the ecs world's user context (ecs_set_ctx), so it is
 * per world, which is what lets a world-per-core simulator and an engine
 * host coexist in one process. The engine itself does not use that slot.
 *
 * BATCH vs INTERACTIVE. mb_sim runs a whole tournament in one world: a queue
 * of (pairing, seed) matches, batch_width slots, results placed at canonical
 * queue indices. Engine hosting is the same machinery with a small batch (1
 * by default, app.yaml `engine.batch`) and a queue that is fed incrementally
 * instead of up front - the app.yaml `engine:` block seeds the first match
 * and injected MbSpawnRequest entities append more. */
#ifndef MB_ENGINE_H
#define MB_ENGINE_H

#include "engine/engine.h"
#include "mb_world.h"

#ifdef __cplusplus
extern "C" {
#endif

/* Called by engine/src/native_registry.c during engine_app_start. Loads the
 * rules from the selected sandbox, builds the batch on the engine's
 * ModelWorld, queues the match named by app.yaml, and registers the eleven
 * systems. Any failure is loud on stderr and leaves no host installed, so
 * every system then no-ops rather than simulating something undefined. */
void monkey_baiting_register_native_systems(Engine *engine);

/* The hosted batch world, or NULL when nothing is hosted on this engine.
 * mb_world_results / mb_world_result_hash over it are the same oracle
 * mb_sim prints. */
MbWorld *mb_engine_world(Engine *engine);

/* Matches harvested since app start. */
int mb_engine_harvested(Engine *engine);

/* ---- the interactive seam (architecture stage S7, the WASM client) ------
 *
 * A browser client picks its own fight and drives one of the two fighters.
 * Both needs are met here, on the HOST, so that mb_step.c stays exactly the
 * pure simulation it is: nothing below adds a rule, a constant or a draw. */

/* Rebuilds the hosted batch for an explicit pairing instead of app.yaml's
 * `engine:` block - the same teardown-and-build a second app/start does, with
 * the pairing as a parameter rather than a file lookup. The ids are ordinary
 * "<char>:<bot>" entrant ids (../CLAUDE.md, "Entrant identity") and are
 * resolved by the one function allowed to resolve them, so identity and
 * seeding are unchanged. batch_width comes from app.yaml as before.
 *
 * Returns 1, or 0 with a message on stderr and no host installed. */
int mb_engine_restart(Engine *engine, const char *entrant0, const char *entrant1,
                      int seed_index);

/* Hands a side of match slot 0 to a human. `side_mask` is bit 0 for side 0 and
 * bit 1 for side 1; 0 (the default) means both sides are played by their bots
 * and everything below is inert.
 *
 * A human side still runs `ai_decide` - the bot's decision is simply
 * overwritten afterwards by the `human_input` system, which sits between
 * ai_decide and step_fighter in app.yaml's system_order. Keeping ai_decide in
 * the frame costs one wasted decision and keeps the frame order, the system
 * list and the draw contract identical to the batch path, which is what makes
 * "the engine host and mb_sim agree" still checkable. With no human side
 * registered the system reads the mask, finds it empty and returns, so a
 * tournament row cannot move: this is not a sim_version-bumping change. */
void mb_engine_set_human(Engine *engine, int side_mask);
int  mb_engine_get_human(Engine *engine);

/* The button state for one human side, as MB_IN_* bits (mb_types.h). Latched:
 * whatever was set last is what the next frame sees. The client sets it from
 * keyboard/pad state; nothing else reads it. */
void mb_engine_set_human_input(Engine *engine, int side, uint32_t bits);

#ifdef __cplusplus
}
#endif

#endif /* MB_ENGINE_H */
/* MONKEY BAITING - Q16.16 fixed-point primitives.
 *
 * The integer-state contract (components/README.md): no gameplay state is a
 * float, anywhere. This header is the only place the shifts are written.
 *
 * Everything here is header-only, branch-light, allocation-free and calls no
 * libc, so it compiles unchanged as CUDA device code once MB_INLINE becomes
 * __host__ __device__. */
#ifndef MB_FIXED_H
#define MB_FIXED_H

#include <stdint.h>

/* Portability shim for header-inline helpers. A CUDA build defines it to
 * "__host__ __device__ static inline" before including. The out-of-line step
 * functions use MB_FN (mb_step.h) instead. Nothing marked MB_INLINE or MB_FN
 * may call malloc, printf, or any other host-only service. */
#ifndef MB_INLINE
#define MB_INLINE static inline
#endif

#define MB_FP_SHIFT 16
#define MB_FP_ONE   (1 << MB_FP_SHIFT)      /* 65536 */
#define MB_FP_HALF  (MB_FP_ONE / 2)         /* 32768 */

typedef int32_t mb_fp;

MB_INLINE mb_fp mb_from_int(int32_t v)  { return (mb_fp)(v << MB_FP_SHIFT); }
MB_INLINE int32_t mb_to_int(mb_fp v)    { return (int32_t)(v >> MB_FP_SHIFT); }
MB_INLINE int32_t mb_round_to_int(mb_fp v) { return (int32_t)((v + MB_FP_HALF) >> MB_FP_SHIFT); }

MB_INLINE mb_fp mb_mul(mb_fp a, mb_fp b) {
    return (mb_fp)(((int64_t)a * (int64_t)b) >> MB_FP_SHIFT);
}

MB_INLINE mb_fp mb_div(mb_fp a, mb_fp b) {
    /* Callers must not divide by zero; there is no silent fallback here
     * (root CLAUDE.md decision 12) - a zero divisor is a data bug and the
     * loader rejects it before the hot path ever sees it. */
    return (mb_fp)(((int64_t)a << MB_FP_SHIFT) / (int64_t)b);
}

MB_INLINE mb_fp mb_abs(mb_fp a)  { return a < 0 ? -a : a; }
MB_INLINE int32_t mb_sign(mb_fp a) { return a > 0 ? 1 : (a < 0 ? -1 : 0); }
MB_INLINE mb_fp mb_min(mb_fp a, mb_fp b) { return a < b ? a : b; }
MB_INLINE mb_fp mb_max(mb_fp a, mb_fp b) { return a > b ? a : b; }

MB_INLINE mb_fp mb_clamp(mb_fp v, mb_fp lo, mb_fp hi) {
    return v < lo ? lo : (v > hi ? hi : v);
}

/* Exact ratio comparison without dividing: returns -1, 0 or +1 for
 * (a0/m0) vs (a1/m1). This is the timeout health comparison, which decides
 * drawn rounds and must never be done in floating point. */
MB_INLINE int mb_cmp_ratio(int32_t a0, int32_t m0, int32_t a1, int32_t m1) {
    int64_t l = (int64_t)a0 * (int64_t)m1;
    int64_t r = (int64_t)a1 * (int64_t)m0;
    return l < r ? -1 : (l > r ? 1 : 0);
}

#endif /* MB_FIXED_H */
/* MONKEY BAITING - the solved-policy loader. See mb_perfect.h. */
#include "mb_perfect.h"
#include "mb_rules.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Probabilities are parsed to this fixed decimal scale by exact integer
 * arithmetic. The solver rounds its output to 5 decimals, so 9 is generous;
 * anything needing more precision than this fails the load rather than
 * rounding silently. */
#define MB_PROB_SCALE      1000000000ull    /* 1e9 */
#define MB_PROB_SCALE_DIG  9
/* A row's probabilities must sum to about 1. This bound is what keeps the
 * CDF normalisation (cum * 2^32) inside 64 bits; a row summing past it is
 * malformed data, not a rounding artefact. */
#define MB_PROB_ROW_MAX    (2ull * MB_PROB_SCALE)

/* ------------------------------------------------------- stream reading */

typedef struct {
    FILE *f;
    char buf[65536];
    size_t n, i;
    int eof;
    const char *path;
} MbJson;

static int mb_j_getc(MbJson *j) {
    if (j->i >= j->n) {
        if (j->eof) return -1;
        j->n = fread(j->buf, 1, sizeof(j->buf), j->f);
        j->i = 0;
        if (j->n == 0) { j->eof = 1; return -1; }
    }
    return (unsigned char)j->buf[j->i++];
}

static void mb_j_unget(MbJson *j) { if (j->i > 0) j->i--; }

static int mb_j_skip_ws(MbJson *j) {
    int c;
    do { c = mb_j_getc(j); } while (c == ' ' || c == '\t' || c == '\n' || c == '\r');
    return c;
}

static int mb_j_err(MbJson *j, const char *what) {
    fprintf(stderr, "monkey-baiting: %s: %s\n", j->path, what);
    return 0;
}

static int mb_j_expect(MbJson *j, int ch) {
    int c = mb_j_skip_ws(j);
    if (c != ch) {
        char msg[64];
        snprintf(msg, sizeof(msg), "expected '%c', got '%c'", ch,
                 c < 0 ? '?' : c);
        return mb_j_err(j, msg);
    }
    return 1;
}

/* Reads a JSON string (leading quote already consumed or not, per `opened`)
 * into out. Only the escapes the exporter can emit are supported; anything
 * else fails loudly. */
static int mb_j_string(MbJson *j, char *out, size_t cap, int opened) {
    size_t k = 0;
    int c;
    if (!opened && !mb_j_expect(j, '"')) return 0;
    for (;;) {
        c = mb_j_getc(j);
        if (c < 0) return mb_j_err(j, "unterminated string");
        if (c == '"') break;
        if (c == '\\') return mb_j_err(j, "string escapes are not supported");
        if (k + 1 >= cap) return mb_j_err(j, "string too long");
        out[k++] = (char)c;
    }
    out[k] = 0;
    return 1;
}

/* Exact decimal -> value * 1e9, integer arithmetic only. Accepts an optional
 * exponent (Python's json writes 1e-05 for small rounded probabilities).
 * Rejects negatives and anything needing more than 9 decimals. */
static int mb_j_number_q9(MbJson *j, uint64_t *out) {
    uint64_t mant = 0;
    int digits = 0, frac = 0, in_frac = 0, c, expv = 0, expsign = 1, shift;
    c = mb_j_skip_ws(j);
    if (c == '-') return mb_j_err(j, "negative probability");
    if (c == '+') c = mb_j_getc(j);
    for (;;) {
        if (c >= '0' && c <= '9') {
            if (mant > 1000000000000000000ull)
                return mb_j_err(j, "number out of range");
            mant = mant * 10u + (uint64_t)(c - '0');
            digits++;
            if (in_frac) frac++;
        } else if (c == '.' && !in_frac) {
            in_frac = 1;
        } else if (c == 'e' || c == 'E') {
            c = mb_j_getc(j);
            if (c == '-') { expsign = -1; c = mb_j_getc(j); }
            else if (c == '+') { c = mb_j_getc(j); }
            if (c < '0' || c > '9') return mb_j_err(j, "malformed exponent");
            while (c >= '0' && c <= '9') {
                expv = expv * 10 + (c - '0');
                if (expv > 100) return mb_j_err(j, "exponent out of range");
                c = mb_j_getc(j);
            }
            expv *= expsign;
            break;
        } else {
            break;
        }
        c = mb_j_getc(j);
    }
    if (c >= 0) mb_j_unget(j);
    if (!digits) return mb_j_err(j, "expected a number");
    shift = MB_PROB_SCALE_DIG + expv - frac;
    if (shift < 0)
        return mb_j_err(j, "probability needs more than 9 decimals");
    while (shift-- > 0) {
        if (mant > 1000000000000000000ull)
            return mb_j_err(j, "number out of range");
        mant *= 10u;
    }
    *out = mant;
    return 1;
}

static int mb_j_int(MbJson *j, int64_t *out) {
    int64_t v = 0;
    int c, sign = 1, digits = 0;
    c = mb_j_skip_ws(j);
    if (c == '-') { sign = -1; c = mb_j_getc(j); }
    while (c >= '0' && c <= '9') { v = v * 10 + (c - '0'); digits++; c = mb_j_getc(j); }
    if (c >= 0) mb_j_unget(j);
    if (!digits) return mb_j_err(j, "expected an integer");
    *out = v * sign;
    return 1;
}

/* Skips one value of any type (used for meta keys this build does not read,
 * and for top-level keys such as startValue). */
static int mb_j_skip_value(MbJson *j) {
    int c = mb_j_skip_ws(j), depth = 0;
    if (c == '"') {
        char tmp[256];
        return mb_j_string(j, tmp, sizeof(tmp), 1);
    }
    if (c == '[' || c == '{') {
        depth = 1;
        while (depth > 0) {
            c = mb_j_getc(j);
            if (c < 0) return mb_j_err(j, "unterminated value");
            if (c == '"') { char tmp[256]; if (!mb_j_string(j, tmp, sizeof(tmp), 1)) return 0; }
            else if (c == '[' || c == '{') depth++;
            else if (c == ']' || c == '}') depth--;
        }
        return 1;
    }
    /* a bare literal: number, true, false, null */
    while (c >= 0 && c != ',' && c != '}' && c != ']') c = mb_j_getc(j);
    if (c >= 0) mb_j_unget(j);
    return 1;
}

/* ------------------------------------------------------------ meta block */

typedef struct {
    char self[64], foe[64];
    int64_t encoding, gap_step, gap_buckets, fq, stun_q_max;
    int64_t back_step, back_buckets, foe_states, self_states;
    int32_t n_actions;
    char actions[MB_POLICY_MAX_ACTIONS][32];
    int32_t self_move_key[MB_MOVE_KEYS], self_move_count;
    int32_t foe_move_key[MB_MOVE_KEYS], foe_move_count;
    int64_t foe_offsets[MB_MOVE_KEYS], foe_qf[MB_MOVE_KEYS];
    int32_t foe_off_count, foe_qf_count;
    int32_t self_cd_key[MB_MOVE_KEYS], self_cd_count;
    int32_t foe_cd_key[MB_MOVE_KEYS], foe_cd_count;
    int seen_encoding;
} MbMeta;

/* Reads a JSON array of move-key names into keys[]. Every name must be one
 * of this port's canonical move keys; the solver never exports a zone move
 * as a modelled move, so an unknown name is a real disagreement. */
static int mb_j_key_array(MbJson *j, int32_t *keys, int32_t *count,
                          const char *what) {
    int c;
    *count = 0;
    if (!mb_j_expect(j, '[')) return 0;
    c = mb_j_skip_ws(j);
    if (c == ']') return 1;
    mb_j_unget(j);
    for (;;) {
        char name[64];
        int key;
        if (!mb_j_string(j, name, sizeof(name), 0)) return 0;
        key = mb_rules_move_key(name);
        if (key < 0) {
            fprintf(stderr, "monkey-baiting: %s: %s names '%s', which is not a "
                            "move key of this port\n", j->path, what, name);
            return 0;
        }
        if (*count >= MB_MOVE_KEYS) {
            fprintf(stderr, "monkey-baiting: %s: %s lists more than %d moves\n",
                    j->path, what, MB_MOVE_KEYS);
            return 0;
        }
        keys[(*count)++] = key;
        c = mb_j_skip_ws(j);
        if (c == ']') return 1;
        if (c != ',') return mb_j_err(j, "malformed move list");
    }
}

static int mb_j_int_array(MbJson *j, int64_t *out, int32_t *count, int cap,
                          const char *what) {
    int c;
    *count = 0;
    if (!mb_j_expect(j, '[')) return 0;
    c = mb_j_skip_ws(j);
    if (c == ']') return 1;
    mb_j_unget(j);
    for (;;) {
        if (*count >= cap) {
            fprintf(stderr, "monkey-baiting: %s: %s is longer than %d\n",
                    j->path, what, cap);
            return 0;
        }
        if (!mb_j_int(j, &out[*count])) return 0;
        (*count)++;
        c = mb_j_skip_ws(j);
        if (c == ']') return 1;
        if (c != ',') return mb_j_err(j, "malformed integer list");
    }
}

static int mb_j_meta(MbJson *j, MbMeta *mt) {
    int c;
    memset(mt, 0, sizeof(*mt));
    if (!mb_j_expect(j, '{')) return 0;
    for (;;) {
        char key[64];
        c = mb_j_skip_ws(j);
        if (c == '}') return 1;
        if (c == ',') continue;
        if (c != '"') return mb_j_err(j, "malformed meta");
        if (!mb_j_string(j, key, sizeof(key), 1)) return 0;
        if (!mb_j_expect(j, ':')) return 0;

        if (!strcmp(key, "encoding")) {
            if (!mb_j_int(j, &mt->encoding)) return 0;
            mt->seen_encoding = 1;
            /* Checked here, at the first opportunity, so a stale file is
             * reported as a stale file rather than as a length mismatch
             * further down. */
            if (mt->encoding != MB_PERFECT_ENCODING) {
                fprintf(stderr,
                    "monkey-baiting: %s uses perfect state encoding %lld, this "
                    "build reads encoding %d; re-export and re-solve the pair\n",
                    j->path, (long long)mt->encoding, MB_PERFECT_ENCODING);
                return 0;
            }
        }
        else if (!strcmp(key, "self")) { if (!mb_j_string(j, mt->self, sizeof(mt->self), 0)) return 0; }
        else if (!strcmp(key, "foe"))  { if (!mb_j_string(j, mt->foe, sizeof(mt->foe), 0)) return 0; }
        else if (!strcmp(key, "gapStep"))     { if (!mb_j_int(j, &mt->gap_step)) return 0; }
        else if (!strcmp(key, "gapBuckets"))  { if (!mb_j_int(j, &mt->gap_buckets)) return 0; }
        else if (!strcmp(key, "fq"))          { if (!mb_j_int(j, &mt->fq)) return 0; }
        else if (!strcmp(key, "stunQMax"))    { if (!mb_j_int(j, &mt->stun_q_max)) return 0; }
        else if (!strcmp(key, "backStep"))    { if (!mb_j_int(j, &mt->back_step)) return 0; }
        else if (!strcmp(key, "backBuckets")) { if (!mb_j_int(j, &mt->back_buckets)) return 0; }
        else if (!strcmp(key, "foeStates"))   { if (!mb_j_int(j, &mt->foe_states)) return 0; }
        else if (!strcmp(key, "selfStates"))  { if (!mb_j_int(j, &mt->self_states)) return 0; }
        else if (!strcmp(key, "actions")) {
            mt->n_actions = 0;
            if (!mb_j_expect(j, '[')) return 0;
            for (;;) {
                if (mt->n_actions >= MB_POLICY_MAX_ACTIONS)
                    return mb_j_err(j, "more actions than MB_POLICY_MAX_ACTIONS");
                if (!mb_j_string(j, mt->actions[mt->n_actions], 32, 0)) return 0;
                mt->n_actions++;
                c = mb_j_skip_ws(j);
                if (c == ']') break;
                if (c != ',') return mb_j_err(j, "malformed action list");
            }
        }
        else if (!strcmp(key, "selfMoves")) {
            if (!mb_j_key_array(j, mt->self_move_key, &mt->self_move_count, "selfMoves")) return 0;
        }
        else if (!strcmp(key, "foeMoves")) {
            if (!mb_j_key_array(j, mt->foe_move_key, &mt->foe_move_count, "foeMoves")) return 0;
        }
        else if (!strcmp(key, "selfCdMoves")) {
            if (!mb_j_key_array(j, mt->self_cd_key, &mt->self_cd_count, "selfCdMoves")) return 0;
        }
        else if (!strcmp(key, "foeCdMoves")) {
            if (!mb_j_key_array(j, mt->foe_cd_key, &mt->foe_cd_count, "foeCdMoves")) return 0;
        }
        else if (!strcmp(key, "foeMoveOffsets")) {
            if (!mb_j_int_array(j, mt->foe_offsets, &mt->foe_off_count, MB_MOVE_KEYS, "foeMoveOffsets")) return 0;
        }
        else if (!strcmp(key, "foeMoveQF")) {
            if (!mb_j_int_array(j, mt->foe_qf, &mt->foe_qf_count, MB_MOVE_KEYS, "foeMoveQF")) return 0;
        }
        else {
            /* selfMoveOffsets / selfMoveQF / ringWidth / gamma: part of the
             * file, not part of the runtime lookup (the reference computes a
             * self side state and then indexes neither table by it). */
            if (!mb_j_skip_value(j)) return 0;
        }
    }
}

/* --------------------------------------------------------- meta -> policy */

static int mb_action_resolve(MbJson *j, const char *name, MbPolicyAction *out,
                             const MbStrategyParams *sp) {
    out->move_key = -1;
    if (!strncmp(name, "move:", 5)) {
        int key = mb_rules_move_key(name + 5);
        if (key < 0) {
            fprintf(stderr, "monkey-baiting: %s: action '%s' names no move key "
                            "of this port\n", j->path, name);
            return 0;
        }
        out->kind = MB_PACT_MOVE;
        out->move_key = key;
        out->hold = sp->perfect_hold_move;
        return 1;
    }
    if (!strcmp(name, "walk_to"))   { out->kind = MB_PACT_WALK_TO;   out->hold = sp->perfect_hold_walk;  return 1; }
    if (!strcmp(name, "walk_away")) { out->kind = MB_PACT_WALK_AWAY; out->hold = sp->perfect_hold_walk;  return 1; }
    if (!strcmp(name, "wait"))      { out->kind = MB_PACT_WAIT;      out->hold = sp->perfect_hold_wait;  return 1; }
    if (!strcmp(name, "block"))     { out->kind = MB_PACT_BLOCK;     out->hold = sp->perfect_hold_block; return 1; }
    if (!strcmp(name, "jump"))      { out->kind = MB_PACT_JUMP;      out->hold = 0;                      return 1; }
    fprintf(stderr, "monkey-baiting: %s: unknown action '%s'\n", j->path, name);
    return 0;
}

static int mb_meta_to_policy(MbJson *j, const MbMeta *mt, const MbRules *rules,
                             int self_char, int foe_char, MbPolicy *p) {
    int i;

    if (!mt->seen_encoding) return mb_j_err(j, "meta has no encoding");
    if (mt->gap_step <= 0 || mt->gap_buckets <= 0 || mt->back_step <= 0 ||
        mt->back_buckets <= 0 || mt->fq <= 0 || mt->stun_q_max <= 0 ||
        mt->foe_states <= 1 || mt->n_actions <= 0)
        return mb_j_err(j, "meta has a non-positive quantization field");
    if (mt->foe_off_count != mt->foe_move_count ||
        mt->foe_qf_count != mt->foe_move_count)
        return mb_j_err(j, "foeMoveOffsets/foeMoveQF disagree with foeMoves");
    if (strcmp(mt->self, mb_rules_char_name(self_char)) ||
        strcmp(mt->foe, mb_rules_char_name(foe_char))) {
        fprintf(stderr, "monkey-baiting: %s is '%s' vs '%s', not '%s' vs '%s'\n",
                j->path, mt->self, mt->foe, mb_rules_char_name(self_char),
                mb_rules_char_name(foe_char));
        return 0;
    }

    memset(p, 0, sizeof(*p));
    p->self_char = self_char;
    p->foe_char = foe_char;
    p->gap_step = (int32_t)mt->gap_step;
    p->gap_buckets = (int32_t)mt->gap_buckets;
    p->back_step = (int32_t)mt->back_step;
    p->back_buckets = (int32_t)mt->back_buckets;
    p->fq = (int32_t)mt->fq;
    p->stun_q_max = (int32_t)mt->stun_q_max;
    p->foe_states = (int32_t)mt->foe_states;
    p->n_actions = mt->n_actions;

    p->walk_to_action = -1;
    for (i = 0; i < mt->n_actions; i++) {
        if (!mb_action_resolve(j, mt->actions[i], &p->action[i], &rules->strat))
            return 0;
        if (p->action[i].kind == MB_PACT_WALK_TO) p->walk_to_action = i;
    }
    if (p->walk_to_action < 0)
        return mb_j_err(j, "action list has no 'walk_to' (needed by the "
                           "cooldown-disagreement guard)");

    for (i = 0; i < MB_MOVE_KEYS; i++) p->foe_mi[i] = -1;
    for (i = 0; i < mt->foe_move_count; i++) {
        int key = mt->foe_move_key[i];
        if (p->foe_mi[key] >= 0)
            return mb_j_err(j, "foeMoves names a move key twice");
        p->foe_mi[key] = i;
        p->foe_offset[key] = (int32_t)mt->foe_offsets[i];
        p->foe_qf[key] = (int32_t)mt->foe_qf[i];
        if (p->foe_qf[key] <= 0)
            return mb_j_err(j, "foeMoveQF has a non-positive tick count");
    }
    p->self_cd_count = mt->self_cd_count;
    p->foe_cd_count = mt->foe_cd_count;
    for (i = 0; i < mt->self_cd_count; i++) p->self_cd_key[i] = mt->self_cd_key[i];
    for (i = 0; i < mt->foe_cd_count; i++) p->foe_cd_key[i] = mt->foe_cd_key[i];

    {
        int64_t rows = (int64_t)p->gap_buckets * p->back_buckets * p->back_buckets;
        rows *= (int64_t)1 << p->self_cd_count;
        rows *= (int64_t)1 << p->foe_cd_count;
        if (rows <= 0 || rows > 8000000)
            return mb_j_err(j, "state space out of range");
        p->rows = (int32_t)rows;
    }
    return 1;
}

/* ------------------------------------------------------------ array reads */

/* Streams bothFree, converting each row of n_actions probabilities into a
 * u32 cumulative distribution. The row is normalised by its OWN total, so
 * the 5-decimal rounding the solver applies cannot make a row sum to less
 * than one and bias the last action; the residue lands in the final bucket,
 * which is exactly the reference's fall-through. */
static int mb_read_both_free(MbJson *j, MbPolicy *p, uint32_t *cdf) {
    int64_t need = (int64_t)p->rows * p->n_actions, seen = 0;
    uint64_t row[MB_POLICY_MAX_ACTIONS];
    int c, k, r;

    if (!mb_j_expect(j, '[')) return 0;
    for (r = 0; r < p->rows; r++) {
        uint64_t total = 0, cum = 0;
        for (k = 0; k < p->n_actions; k++) {
            if (seen > 0) {
                /* every entry after the first is preceded by a comma; a ']'
                 * here means the array is shorter than the strides need */
                c = mb_j_skip_ws(j);
                if (c != ',') {
                    fprintf(stderr, "monkey-baiting: %s: bothFree has %lld "
                            "entries, the meta strides need %lld\n", j->path,
                            (long long)seen, (long long)need);
                    return 0;
                }
            }
            if (!mb_j_number_q9(j, &row[k])) return 0;
            total += row[k];
            seen++;
        }
        if (total > MB_PROB_ROW_MAX)
            return mb_j_err(j, "a bothFree row sums to far more than 1");
        for (k = 0; k < p->n_actions; k++) {
            uint64_t v;
            if (total == 0) {
                /* An unreachable state: the solver leaves the row at zero.
                 * Every draw then falls through to the last action, exactly
                 * as the reference does. */
                cdf[(size_t)r * p->n_actions + k] = 0;
                continue;
            }
            cum += row[k];
            v = (cum * 4294967296ull) / total;
            /* A cumulative bound of 2^32 does not fit a u32 - and it is
             * reached at the LAST action carrying probability, not only at
             * the last action. Saturating is what makes that action selected
             * for every word below 2^32-1, which is the whole distribution
             * bar one; that single word falls through to action n-1, and is
             * the residue the final bucket absorbs. Truncating instead would
             * wrap to 0 and make the action unreachable. */
            cdf[(size_t)r * p->n_actions + k] =
                v >= 4294967296ull ? 0xFFFFFFFFu : (uint32_t)v;
        }
    }
    (void)need;
    c = mb_j_skip_ws(j);
    if (c != ']')
        return mb_j_err(j, "bothFree is longer than the meta strides allow");
    return 1;
}

static int mb_read_vs_committed(MbJson *j, MbPolicy *p, uint8_t *vc) {
    int64_t need = (int64_t)p->rows * (p->foe_states - 1), seen = 0;
    int c;
    if (!mb_j_expect(j, '[')) return 0;
    c = mb_j_skip_ws(j);
    if (c == ']') return mb_j_err(j, "vsCommitted is empty");
    mb_j_unget(j);
    for (;;) {
        int64_t v;
        if (!mb_j_int(j, &v)) return 0;
        if (v < 0 || v >= p->n_actions) {
            fprintf(stderr, "monkey-baiting: %s: vsCommitted holds action %lld, "
                    "outside 0..%d\n", j->path, (long long)v, p->n_actions - 1);
            return 0;
        }
        if (seen >= need) {
            fprintf(stderr, "monkey-baiting: %s: vsCommitted is longer than the "
                    "%lld entries the meta strides need\n", j->path,
                    (long long)need);
            return 0;
        }
        vc[seen++] = (uint8_t)v;
        c = mb_j_skip_ws(j);
        if (c == ']') break;
        if (c != ',') return mb_j_err(j, "malformed vsCommitted array");
    }
    if (seen != need) {
        fprintf(stderr, "monkey-baiting: %s: vsCommitted has %lld entries, the "
                "meta strides need %lld\n", j->path, (long long)seen,
                (long long)need);
        return 0;
    }
    return 1;
}

/* ------------------------------------------------------------------- API */

void mb_perfect_init(MbPerfectSet *set) { memset(set, 0, sizeof(*set)); }

int mb_perfect_has_pair(const MbPerfectSet *set, int self_char, int foe_char) {
    if (!set || self_char < 0 || foe_char < 0 ||
        self_char >= MB_MAX_CHARS || foe_char >= MB_MAX_CHARS) return 0;
    return MB_POLICY_AT(set, self_char, foe_char)->present;
}

int mb_perfect_bot_rolls(const MbRules *rules, int bot_id) {
    const MbBot *b;
    int i;
    if (bot_id < 0 || bot_id >= rules->bots.count) return 0;
    b = &rules->bots.bot[bot_id];
    for (i = 0; i < b->count; i++)
        if (b->comp[i].kind == MB_POLICY_PERFECT) return 1;
    return 0;
}

void mb_perfect_free(MbPerfectSet *set) {
    int i;
    if (!set) return;
    for (i = 0; i < MB_MAX_CHARS * MB_MAX_CHARS; i++) {
        free(set->p[i].blob);
        set->p[i].blob = NULL;
        set->p[i].present = 0;
    }
    set->count = 0;
}

int mb_perfect_load_pair(MbPerfectSet *set, const MbRules *rules,
                         const char *dir, int self_char, int foe_char) {
    char path[768];
    MbJson j;
    MbMeta *mt = NULL;
    MbPolicy pol;
    MbPolicy *slot;
    unsigned char *blob = NULL;
    size_t cdf_bytes, vc_bytes;
    int ok = 0, saw_meta = 0, saw_bf = 0, saw_vc = 0, c;

    if (self_char < 0 || foe_char < 0 ||
        self_char >= rules->chars.count || foe_char >= rules->chars.count) {
        fprintf(stderr, "monkey-baiting: perfect policy requested for a "
                        "character outside the roster\n");
        return 0;
    }
    if (!dir || !dir[0]) {
        fprintf(stderr, "monkey-baiting: '%s:perfect' needs a policy directory "
                        "(mb_sim --perfect DIR)\n",
                mb_rules_char_name(self_char));
        return 0;
    }
    slot = MB_POLICY_AT(set, self_char, foe_char);
    if (slot->present) return 1;

    snprintf(path, sizeof(path), "%s/perfect-%s-vs-%s.json", dir,
             mb_rules_char_name(self_char), mb_rules_char_name(foe_char));

    memset(&j, 0, sizeof(j));
    j.path = path;
    j.f = fopen(path, "rb");
    if (!j.f) {
        fprintf(stderr, "monkey-baiting: no perfect policy at %s\n", path);
        return 0;
    }
    mt = (MbMeta *)malloc(sizeof(MbMeta));
    if (!mt) { fclose(j.f); return 0; }

    if (!mb_j_expect(&j, '{')) goto done;
    for (;;) {
        char key[64];
        c = mb_j_skip_ws(&j);
        if (c == '}') break;
        if (c == ',') continue;
        if (c != '"') { mb_j_err(&j, "malformed policy object"); goto done; }
        if (!mb_j_string(&j, key, sizeof(key), 1)) goto done;
        if (!mb_j_expect(&j, ':')) goto done;

        if (!strcmp(key, "meta")) {
            if (!mb_j_meta(&j, mt)) goto done;
            if (!mb_meta_to_policy(&j, mt, rules, self_char, foe_char, &pol)) goto done;
            cdf_bytes = (size_t)pol.rows * pol.n_actions * sizeof(uint32_t);
            vc_bytes = (size_t)pol.rows * (size_t)(pol.foe_states - 1);
            /* ONE allocation per pair: the CDF then the best-response table.
             * Shared read-only by every match; nothing is copied per slot. */
            blob = (unsigned char *)malloc(cdf_bytes + vc_bytes);
            if (!blob) {
                fprintf(stderr, "monkey-baiting: out of memory for %s\n", path);
                goto done;
            }
            pol.cdf = (const uint32_t *)blob;
            pol.vs_committed = blob + cdf_bytes;
            pol.blob = blob;
            saw_meta = 1;
        }
        else if (!strcmp(key, "bothFree")) {
            if (!saw_meta) {
                mb_j_err(&j, "bothFree appears before meta; the strides are "
                             "not known yet");
                goto done;
            }
            if (!mb_read_both_free(&j, &pol, (uint32_t *)blob)) goto done;
            saw_bf = 1;
        }
        else if (!strcmp(key, "vsCommitted")) {
            if (!saw_meta) {
                mb_j_err(&j, "vsCommitted appears before meta; the strides are "
                             "not known yet");
                goto done;
            }
            if (!mb_read_vs_committed(&j, &pol, blob + (size_t)pol.rows *
                                      pol.n_actions * sizeof(uint32_t))) goto done;
            saw_vc = 1;
        }
        else {
            /* startValue, solver_version, converged: recorded by the solver,
             * not consumed by playback. */
            if (!mb_j_skip_value(&j)) goto done;
        }
    }
    if (!saw_meta) { mb_j_err(&j, "policy has no meta block"); goto done; }
    if (!saw_bf)   { mb_j_err(&j, "policy has no bothFree array"); goto done; }
    if (!saw_vc)   { mb_j_err(&j, "policy has no vsCommitted array"); goto done; }

    pol.present = 1;
    *slot = pol;
    set->count++;
    blob = NULL;            /* owned by the set now */
    ok = 1;

done:
    if (blob) free(blob);
    free(mt);
    fclose(j.f);
    return ok;
}
/* MONKEY BAITING - the solved-policy loader (host only, never on the hot
 * path).
 *
 * Reads the solver's per-ordered-pair export,
 *
 *     <dir>/perfect-<self>-vs-<foe>.json
 *
 * a `meta` block plus a `bothFree` array of probabilities and a
 * `vsCommitted` array of action indices, into the immutable MbPolicy tables
 * the step functions read. The policy directories live OUTSIDE the repo data
 * dirs (they are large and regenerable), so the path is a CLI argument
 * (`mb_sim --perfect DIR`), never a compiled-in location.
 *
 * Three things happen here that cannot happen on the hot path:
 *
 *   1. `meta.encoding` must be exactly MB_PERFECT_ENCODING. An older layout
 *      read with this index math would return garbage actions silently, so a
 *      mismatch is a hard error naming both versions - never a demotion to
 *      another strategy, and never a best-effort read.
 *   2. `bothFree`'s probabilities become a u32 cumulative distribution
 *      summing to 2^32, consumed against a raw mulberry32 word. The decimals
 *      are parsed by exact integer arithmetic (no strtod, no float anywhere,
 *      matching mb_parse_fp's rule) and each row is normalised by its own
 *      total, so the rounding residue lands in the final bucket exactly as
 *      the reference's fall-through puts it there.
 *   3. Every stride (`n_actions`, the cooldown widths, `foe_states`) is taken
 *      from the file. They differ per matchup; nothing here is a constant.
 *
 * Allocation: ONE block per loaded pair, holding that pair's CDF and best
 * response tables back to back. The set is loaded once, shared read-only by
 * every match in every batch, and freed by mb_perfect_free. */
#ifndef MB_PERFECT_H
#define MB_PERFECT_H

#include "mb_types.h"

#ifdef __cplusplus
extern "C" {
#endif

/* State encoding this build reads: gap bucket + per-side retreat-room (ring
 * wall) bucket + cooldown flags + committed-side ticks. */
#define MB_PERFECT_ENCODING 3

/* Zeroes the set. A zeroed set is valid and means "no policies loaded". */
void mb_perfect_init(MbPerfectSet *set);

/* Loads <dir>/perfect-<self>-vs-<foe>.json for one ORDERED character pair.
 * Idempotent: a pair already present is a no-op. Returns 1 on success, 0
 * with a message on stderr - a missing file, a stale encoding, a malformed
 * number, a stride that disagrees with an array length, an action naming a
 * move key this port does not have, or a missing "walk_to" action all fail
 * the load. Nothing is defaulted (root CLAUDE.md decision 12). */
int mb_perfect_load_pair(MbPerfectSet *set, const MbRules *rules,
                         const char *dir, int self_char, int foe_char);

/* 1 when the ordered pair has a loaded policy. */
int mb_perfect_has_pair(const MbPerfectSet *set, int self_char, int foe_char);

/* 1 when any component of bot_id rolls the perfect strategy. */
int mb_perfect_bot_rolls(const MbRules *rules, int bot_id);

void mb_perfect_free(MbPerfectSet *set);

#ifdef __cplusplus
}
#endif

#endif /* MB_PERFECT_H */
/* MONKEY BAITING - the determinism contract.
 *
 * Exact ports of the two integer functions the JS reference uses
 * (web/monkey-baiting/test/tournament.js): FNV-1a over the match identity
 * string, and mulberry32 as the per-match generator. Both are pure 32-bit
 * integer arithmetic in JS (Math.imul), so they port byte for byte.
 *
 * The contract is stronger than the generator: it is the SEQUENCE OF DRAWS -
 * the same number of draws, in the same order, at the same decision points.
 * Any change to which policy draws when invalidates every archived result.
 *
 * mulberry32 in JS returns state / 2^32 as a double. Here it returns the raw
 * u32 word; probability thresholds are pre-scaled to 2^32 and compared
 * against it. That is exact and keeps floats out of the hot path. */
#ifndef MB_RNG_H
#define MB_RNG_H

#include <stdint.h>
#include "mb_fixed.h"

/* One mulberry32 draw. Advances state, returns the raw 32-bit word. */
MB_INLINE uint32_t mb_rng_next(uint32_t *state) {
    uint32_t a = (*state + 0x6D2B79F5u);
    *state = a;
    uint32_t t = (a ^ (a >> 15)) * (1u | a);
    t = (t + ((t ^ (t >> 7)) * (61u | t))) ^ t;
    return t ^ (t >> 14);
}

/* True with probability threshold / 2^32. Thresholds are precomputed at load
 * from the authored float probabilities; nothing is scaled at runtime. */
MB_INLINE int mb_rng_chance(uint32_t *state, uint32_t threshold_q32) {
    return mb_rng_next(state) < threshold_q32;
}

/* Uniform integer in [0, n) without a modulo bias correction loop (a loop
 * would be data-dependent, which a warp cannot afford). Matches the JS
 * Math.floor(rng() * n) exactly: the high half of the 64-bit product. */
MB_INLINE uint32_t mb_rng_below(uint32_t *state, uint32_t n) {
    return (uint32_t)(((uint64_t)mb_rng_next(state) * (uint64_t)n) >> 32);
}

/* FNV-1a, 32 bit, over a byte string. */
MB_INLINE uint32_t mb_fnv1a(const char *s) {
    uint32_t h = 2166136261u;
    while (*s) {
        h ^= (uint32_t)(unsigned char)(*s++);
        h *= 16777619u;
    }
    return h;
}

#endif /* MB_RNG_H */
/* MONKEY BAITING - YAML reading and the rules loader. Host only; see
 * mb_rules.h. */
#include "mb_rules.h"

#include <yaml.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MB_YAML_MAX_DEPTH 32

/* Host-side character names, indexed by char_id. Not visible to the step
 * functions - they only ever see integer ids. */
static char mb_char_names[MB_MAX_CHARS][32];
static int mb_char_name_count = 0;

/* Host-side bot names, indexed by bot_id, in first-appearance order in
 * data/bots.yaml. Same rule: the step functions never see a string. */
static char mb_bot_names[MB_MAX_BOTS][32];
static int mb_bot_name_count = 0;

const char *mb_rules_char_name(int char_id) {
    if (char_id < 0 || char_id >= mb_char_name_count) return NULL;
    return mb_char_names[char_id];
}

int mb_rules_char_id(const char *name) {
    int i;
    if (!name) return -1;
    for (i = 0; i < mb_char_name_count; i++)
        if (strcmp(mb_char_names[i], name) == 0) return i;
    return -1;
}

const char *mb_rules_bot_name(int bot_id) {
    if (bot_id < 0 || bot_id >= mb_bot_name_count) return NULL;
    return mb_bot_names[bot_id];
}

int mb_rules_bot_id(const char *name) {
    int i;
    if (!name) return -1;
    for (i = 0; i < mb_bot_name_count; i++)
        if (strcmp(mb_bot_names[i], name) == 0) return i;
    return -1;
}

static const char *mb_move_key_names[MB_MOVE_KEYS] = {
    "light", "heavy", "special", "stakes_down"
};

const char *mb_rules_move_key_name(int key) {
    if (key < 0 || key >= MB_MOVE_KEYS) return NULL;
    return mb_move_key_names[key];
}

int mb_rules_move_key(const char *name) {
    int i;
    if (!name) return -1;
    for (i = 0; i < MB_MOVE_KEYS; i++)
        if (strcmp(mb_move_key_names[i], name) == 0) return i;
    return -1;
}

/* sin(d degrees) in Q16.16 for whole degrees 0..90, rounded to nearest. A
 * table, not libm: cos/sin of an authored launch angle must be bit-identical
 * on x64, WASM and CUDA, and the three libms disagree in the last ulp
 * (components/README.md, "Precomputed at load"). */
static const mb_fp mb_sin_q16[91] = {
         0,   1144,   2287,   3430,   4572,   5712,
      6850,   7987,   9121,  10252,  11380,  12505,
     13626,  14742,  15855,  16962,  18064,  19161,
     20252,  21336,  22415,  23486,  24550,  25607,
     26656,  27697,  28729,  29753,  30767,  31772,
     32768,  33754,  34729,  35693,  36647,  37590,
     38521,  39441,  40348,  41243,  42126,  42995,
     43852,  44695,  45525,  46341,  47143,  47930,
     48703,  49461,  50203,  50931,  51643,  52339,
     53020,  53684,  54332,  54963,  55578,  56175,
     56756,  57319,  57865,  58393,  58903,  59396,
     59870,  60326,  60764,  61183,  61584,  61966,
     62328,  62672,  62997,  63303,  63589,  63856,
     64104,  64332,  64540,  64729,  64898,  65048,
     65177,  65287,  65376,  65446,  65496,  65526,
     65536
};

/* Probability -> u32 threshold over 2^32, compared against a raw RNG word.
 * 1.0 saturates to 0xFFFFFFFF rather than wrapping to 0. */
static uint32_t mb_q32(mb_fp p) {
    if (p <= 0) return 0u;
    if (p >= MB_FP_ONE) return 0xFFFFFFFFu;
    return (uint32_t)(((uint64_t)(uint32_t)p) << 16);
}

/* ------------------------------------------------------------ YAML read */

typedef struct {
    int is_seq;
    int idx;
    int has_key;
    char key[64];
} MbFrame;

static void mb_path_build(const MbFrame *fr, int d, char *out, size_t cap) {
    int i;
    size_t len = 0;
    out[0] = 0;
    for (i = 0; i < d; i++) {
        char seg[64];
        if (fr[i].is_seq) snprintf(seg, sizeof(seg), "%d", fr[i].idx);
        else if (fr[i].has_key) snprintf(seg, sizeof(seg), "%s", fr[i].key);
        else continue;
        if (len && len + 1 < cap) { out[len++] = '.'; out[len] = 0; }
        snprintf(out + len, cap - len, "%s", seg);
        len = strlen(out);
    }
}

static void mb_record(MbYamlDoc *doc, const MbFrame *fr, int d, const char *val) {
    if (doc->n >= MB_YAML_MAX_ENTRIES) return;
    mb_path_build(fr, d, doc->e[doc->n].key, MB_YAML_MAX_KEY);
    snprintf(doc->e[doc->n].val, MB_YAML_MAX_VAL, "%s", val);
    doc->n++;
}

int mb_yaml_read(const char *path, MbYamlDoc *doc) {
    FILE *fp;
    yaml_parser_t parser;
    MbFrame fr[MB_YAML_MAX_DEPTH];
    int d = 0;
    int ok = 1;

    doc->n = 0;
    fp = fopen(path, "rb");
    if (!fp) {
        fprintf(stderr, "monkey-baiting: cannot open %s\n", path);
        return 0;
    }
    if (!yaml_parser_initialize(&parser)) {
        fclose(fp);
        fprintf(stderr, "monkey-baiting: yaml parser init failed\n");
        return 0;
    }
    yaml_parser_set_input_file(&parser, fp);

    for (;;) {
        yaml_event_t ev;
        int done = 0;
        if (!yaml_parser_parse(&parser, &ev)) {
            fprintf(stderr, "monkey-baiting: YAML parse error in %s at line %lu\n",
                    path, (unsigned long)parser.problem_mark.line + 1);
            ok = 0;
            break;
        }
        switch (ev.type) {
        case YAML_STREAM_END_EVENT:
            done = 1;
            break;
        case YAML_MAPPING_START_EVENT:
        case YAML_SEQUENCE_START_EVENT:
            if (d < MB_YAML_MAX_DEPTH) {
                fr[d].is_seq = (ev.type == YAML_SEQUENCE_START_EVENT);
                fr[d].idx = 0;
                fr[d].has_key = 0;
                fr[d].key[0] = 0;
                d++;
            } else {
                fprintf(stderr, "monkey-baiting: %s nests deeper than %d\n",
                        path, MB_YAML_MAX_DEPTH);
                ok = 0;
                done = 1;
            }
            break;
        case YAML_MAPPING_END_EVENT:
        case YAML_SEQUENCE_END_EVENT:
            if (d > 0) d--;
            if (d > 0) {
                if (fr[d - 1].is_seq) fr[d - 1].idx++;
                else fr[d - 1].has_key = 0;
            }
            break;
        case YAML_SCALAR_EVENT: {
            const char *s = (const char *)ev.data.scalar.value;
            if (d == 0) break;                       /* bare scalar document */
            if (fr[d - 1].is_seq) {
                mb_record(doc, fr, d, s);
                fr[d - 1].idx++;
            } else if (!fr[d - 1].has_key) {
                snprintf(fr[d - 1].key, sizeof(fr[d - 1].key), "%s", s);
                fr[d - 1].has_key = 1;
            } else {
                mb_record(doc, fr, d, s);
                fr[d - 1].has_key = 0;
            }
            break;
        }
        default:
            break;
        }
        yaml_event_delete(&ev);
        if (done) break;
    }

    yaml_parser_delete(&parser);
    fclose(fp);
    return ok;
}

const char *mb_yaml_get(const MbYamlDoc *doc, const char *key) {
    int i;
    for (i = 0; i < doc->n; i++)
        if (strcmp(doc->e[i].key, key) == 0) return doc->e[i].val;
    return NULL;
}

/* -------------------------------------------------------------- scalars */

int mb_parse_fp(const char *s, mb_fp *out) {
    int64_t whole = 0, frac = 0, den = 1, v;
    int neg = 0, digits = 0;
    const char *p = s;

    if (*p == '-') { neg = 1; p++; } else if (*p == '+') { p++; }
    if (*p < '0' || *p > '9') return 0;
    while (*p >= '0' && *p <= '9') { whole = whole * 10 + (*p - '0'); p++; digits++; }
    if (*p == '.') {
        p++;
        while (*p >= '0' && *p <= '9') {
            if (den < 1000000000LL) { frac = frac * 10 + (*p - '0'); den *= 10; }
            p++;
        }
    }
    if (*p != 0 || !digits) return 0;

    v = ((int64_t)whole << MB_FP_SHIFT) +
        (((int64_t)frac << MB_FP_SHIFT) + den / 2) / den;
    if (v > 2147483647LL) return 0;
    *out = (mb_fp)(neg ? -v : v);
    return 1;
}

static int mb_parse_int(const char *s, int32_t *out) {
    char *end = NULL;
    long v;
    v = strtol(s, &end, 10);
    if (!end || *end != 0 || end == s) return 0;
    *out = (int32_t)v;
    return 1;
}

static int mb_need_int(const MbYamlDoc *d, const char *file, const char *key,
                       int32_t *out) {
    const char *v = mb_yaml_get(d, key);
    if (!v) {
        fprintf(stderr, "monkey-baiting: %s is missing required key '%s'\n",
                file, key);
        return 0;
    }
    if (!mb_parse_int(v, out)) {
        fprintf(stderr, "monkey-baiting: %s key '%s' is not an integer: '%s'\n",
                file, key, v);
        return 0;
    }
    return 1;
}

static int mb_need_fp(const MbYamlDoc *d, const char *file, const char *key,
                      mb_fp *out) {
    const char *v = mb_yaml_get(d, key);
    if (!v) {
        fprintf(stderr, "monkey-baiting: %s is missing required key '%s'\n",
                file, key);
        return 0;
    }
    if (!mb_parse_fp(v, out)) {
        fprintf(stderr, "monkey-baiting: %s key '%s' is not a number: '%s'\n",
                file, key, v);
        return 0;
    }
    return 1;
}

/* Optional readers: absent is not an error, it is "the key was not authored".
 * Present-but-malformed still fails loudly. */
static int mb_opt_int(const MbYamlDoc *d, const char *file, const char *key,
                      int32_t *out, int *ok) {
    const char *v = mb_yaml_get(d, key);
    if (!v) return 0;
    if (!mb_parse_int(v, out)) {
        fprintf(stderr, "monkey-baiting: %s key '%s' is not an integer: '%s'\n",
                file, key, v);
        *ok = 0;
        return 0;
    }
    return 1;
}

static int mb_opt_fp(const MbYamlDoc *d, const char *file, const char *key,
                     mb_fp *out, int *ok) {
    const char *v = mb_yaml_get(d, key);
    if (!v) return 0;
    if (!mb_parse_fp(v, out)) {
        fprintf(stderr, "monkey-baiting: %s key '%s' is not a number: '%s'\n",
                file, key, v);
        *ok = 0;
        return 0;
    }
    return 1;
}

/* Scoped key helpers: build "<prefix>.<leaf>" so a move's fields can be read
 * with the same required/optional machinery as a top-level key. */
static void mb_key(char *buf, size_t cap, const char *prefix, const char *leaf) {
    snprintf(buf, cap, "%s.%s", prefix, leaf);
}

static int mb_need_fp_at(const MbYamlDoc *d, const char *file,
                         const char *prefix, const char *leaf, mb_fp *out) {
    char k[MB_YAML_MAX_KEY];
    mb_key(k, sizeof(k), prefix, leaf);
    return mb_need_fp(d, file, k, out);
}

static int mb_need_int_at(const MbYamlDoc *d, const char *file,
                          const char *prefix, const char *leaf, int32_t *out) {
    char k[MB_YAML_MAX_KEY];
    mb_key(k, sizeof(k), prefix, leaf);
    return mb_need_int(d, file, k, out);
}

static int mb_opt_fp_at(const MbYamlDoc *d, const char *file,
                        const char *prefix, const char *leaf, mb_fp *out,
                        int *ok) {
    char k[MB_YAML_MAX_KEY];
    mb_key(k, sizeof(k), prefix, leaf);
    return mb_opt_fp(d, file, k, out, ok);
}

static int mb_opt_int_at(const MbYamlDoc *d, const char *file,
                         const char *prefix, const char *leaf, int32_t *out,
                         int *ok) {
    char k[MB_YAML_MAX_KEY];
    mb_key(k, sizeof(k), prefix, leaf);
    return mb_opt_int(d, file, k, out, ok);
}

static int mb_opt_bool_at(const MbYamlDoc *d, const char *prefix,
                          const char *leaf) {
    char k[MB_YAML_MAX_KEY];
    const char *v;
    mb_key(k, sizeof(k), prefix, leaf);
    v = mb_yaml_get(d, k);
    return v && (strcmp(v, "true") == 0 || strcmp(v, "yes") == 0);
}

/* ------------------------------------------------------------- moves */

static int mb_move_type(const char *s, int32_t *out) {
    if (!s) return 0;
    if (!strcmp(s, "strike"))       { *out = MB_MT_STRIKE; return 1; }
    if (!strcmp(s, "grab"))         { *out = MB_MT_GRAB; return 1; }
    if (!strcmp(s, "stance"))       { *out = MB_MT_STANCE; return 1; }
    if (!strcmp(s, "chain_yank"))   { *out = MB_MT_CHAIN_YANK; return 1; }
    if (!strcmp(s, "hazard_rats"))  { *out = MB_MT_HAZARD_RATS; return 1; }
    if (!strcmp(s, "hazard_coins")) { *out = MB_MT_HAZARD_COINS; return 1; }
    if (!strcmp(s, "retreat"))      { *out = MB_MT_RETREAT; return 1; }
    return 0;
}

static int mb_move_unranged(int32_t type) {
    return type == MB_MT_CHAIN_YANK || type == MB_MT_HAZARD_RATS ||
           type == MB_MT_HAZARD_COINS || type == MB_MT_RETREAT;
}

static int mb_load_move(MbMove *mv, const MbYamlDoc *d, const char *file,
                        const char *key, const MbRules *r, mb_fp hurt_w,
                        mb_fp max_health) {
    char prefix[96];
    const char *tname;
    char k[MB_YAML_MAX_KEY];
    int ok = 1;
    int32_t iv;
    mb_fp fv;

    snprintf(prefix, sizeof(prefix), "moves.%s", key);
    mb_key(k, sizeof(k), prefix, "type");
    tname = mb_yaml_get(d, k);
    if (!tname) return 1;                    /* the character has no such move */

    memset(mv, 0, sizeof(*mv));
    mv->present = 1;
    if (!mb_move_type(tname, &mv->type)) {
        fprintf(stderr, "monkey-baiting: %s move '%s' has unknown type '%s'\n",
                file, key, tname);
        return 0;
    }

    ok &= mb_need_int_at(d, file, prefix, "startup_frames", &mv->startup);
    ok &= mb_need_int_at(d, file, prefix, "active_frames", &mv->active);
    ok &= mb_need_int_at(d, file, prefix, "recovery_frames", &mv->recovery);
    ok &= mb_need_fp_at(d, file, prefix, "damage", &mv->damage);
    ok &= mb_need_fp_at(d, file, prefix, "base_knockback", &mv->base_knockback);
    ok &= mb_need_fp_at(d, file, prefix, "knockback_growth", &mv->knockback_growth);
    ok &= mb_need_int_at(d, file, prefix, "launch_angle", &mv->launch_angle_deg);
    ok &= mb_need_int_at(d, file, prefix, "hitstun", &mv->hitstun);
    ok &= mb_need_int_at(d, file, prefix, "blockstun", &mv->blockstun);
    ok &= mb_need_fp_at(d, file, prefix, "pushback_hit", &mv->pushback_hit);
    ok &= mb_need_fp_at(d, file, prefix, "pushback_block", &mv->pushback_block);
    ok &= mb_need_fp_at(d, file, prefix, "hitbox.x", &mv->hb_x);
    ok &= mb_need_fp_at(d, file, prefix, "hitbox.y", &mv->hb_y);
    ok &= mb_need_fp_at(d, file, prefix, "hitbox.w", &mv->hb_w);
    ok &= mb_need_fp_at(d, file, prefix, "hitbox.h", &mv->hb_h);
    ok &= mb_need_int_at(d, file, prefix, "hit_freeze", &mv->hit_freeze);
    ok &= mb_need_fp_at(d, file, prefix, "shake", &mv->shake);
    ok &= mb_need_int_at(d, file, prefix, "cooldown", &mv->cooldown);
    if (!ok) return 0;

    if (mv->launch_angle_deg < 0 || mv->launch_angle_deg > 90) {
        fprintf(stderr,
                "monkey-baiting: %s move '%s' launch_angle %d is outside 0..90 "
                "(the precomputed sin/cos table covers whole degrees only)\n",
                file, key, mv->launch_angle_deg);
        return 0;
    }
    mv->launch_sin = mb_sin_q16[mv->launch_angle_deg];
    mv->launch_cos = mb_sin_q16[90 - mv->launch_angle_deg];

    mv->unblockable = mb_opt_bool_at(d, prefix, "unblockable");
    if (mb_opt_int_at(d, file, prefix, "hits", &iv, &ok)) mv->hits = iv;
    if (mb_opt_int_at(d, file, prefix, "hit_interval", &iv, &ok)) mv->hit_interval = iv;
    if (mb_opt_fp_at(d, file, prefix, "move_forward", &fv, &ok)) mv->move_forward = fv;
    if (mb_opt_fp_at(d, file, prefix, "armor_frames.0", &fv, &ok)) {
        mv->has_armor_frames = 1;
        mv->armor_from = mb_to_int(fv);
        if (!mb_opt_fp_at(d, file, prefix, "armor_frames.1", &fv, &ok)) {
            fprintf(stderr, "monkey-baiting: %s move '%s' armor_frames needs two "
                            "values\n", file, key);
            return 0;
        }
        mv->armor_to = mb_to_int(fv);
        mv->armor_damage_ratio = MB_FP_ONE;
        if (mb_opt_fp_at(d, file, prefix, "armor_damage_ratio", &fv, &ok))
            mv->armor_damage_ratio = fv;
    }
    if (mb_opt_fp_at(d, file, prefix, "armor_if_health_above", &fv, &ok)) {
        mv->has_armor_health = 1;
        mv->armor_health_abs = mb_mul(fv, max_health);
    }
    if (mb_opt_fp_at(d, file, prefix, "leap.vx", &fv, &ok)) {
        mv->has_leap = 1;
        mv->leap_vx = fv;
        if (!mb_opt_fp_at(d, file, prefix, "leap.vy", &mv->leap_vy, &ok)) {
            fprintf(stderr, "monkey-baiting: %s move '%s' leap needs vx and vy\n",
                    file, key);
            return 0;
        }
    }
    {
        char ik[MB_YAML_MAX_KEY];
        const char *iv2;
        mb_key(ik, sizeof(ik), prefix, "input");
        iv2 = mb_yaml_get(d, ik);
        if (iv2) {
            if (!strcmp(iv2, "jump"))         mv->input_bit = MB_IN_JUMP;
            else if (!strcmp(iv2, "block"))   mv->input_bit = MB_IN_BLOCK;
            else if (!strcmp(iv2, "light"))   mv->input_bit = MB_IN_LIGHT;
            else if (!strcmp(iv2, "heavy"))   mv->input_bit = MB_IN_HEAVY;
            else if (!strcmp(iv2, "special")) mv->input_bit = MB_IN_SPECIAL;
            else {
                fprintf(stderr, "monkey-baiting: %s move '%s' input '%s' is not "
                                "a known button\n", file, key, iv2);
                return 0;
            }
        }
    }

    /* Type-conditional requirements: a move of a given type without the data
     * its handler reads is a data bug, not a default (decision 12). */
    switch (mv->type) {
    case MB_MT_GRAB:
        ok &= mb_need_int_at(d, file, prefix, "grab_hold_frames",
                             &mv->grab_hold_frames);
        if (ok && mv->grab_hold_frames <= 0) {
            fprintf(stderr, "monkey-baiting: %s move '%s' grab_hold_frames must "
                            "be > 0\n", file, key);
            return 0;
        }
        break;
    case MB_MT_STANCE:
        ok &= mb_need_fp_at(d, file, prefix, "stance_take_ratio",
                            &mv->stance_take_ratio);
        ok &= mb_need_fp_at(d, file, prefix, "stance_return_ratio",
                            &mv->stance_return_ratio);
        break;
    case MB_MT_CHAIN_YANK:
        ok &= mb_need_fp_at(d, file, prefix, "yank_speed", &mv->yank_speed);
        break;
    case MB_MT_HAZARD_RATS:
        ok &= mb_need_int_at(d, file, prefix, "rats_duration", &mv->rats_duration);
        ok &= mb_need_int_at(d, file, prefix, "rats_invuln_frames",
                             &mv->rats_invuln_frames);
        ok &= mb_need_fp_at(d, file, prefix, "rats_chip_dps", &mv->rats_chip_dps);
        break;
    case MB_MT_HAZARD_COINS:
        ok &= mb_need_int_at(d, file, prefix, "coins_duration", &mv->coins_duration);
        ok &= mb_need_int_at(d, file, prefix, "coins_zones", &mv->coins_zones);
        ok &= mb_need_fp_at(d, file, prefix, "coins_zone_width",
                            &mv->coins_zone_width);
        ok &= mb_need_fp_at(d, file, prefix, "coins_chip_dps", &mv->coins_chip_dps);
        if (ok && (mv->coins_zones <= 0 || mv->coins_zones > MB_HAZARD_CAP)) {
            /* root CLAUDE.md decision 17: the fixed bound is asserted against
             * the data, never silently truncated. */
            fprintf(stderr, "monkey-baiting: %s move '%s' coins_zones %d exceeds "
                            "MB_HAZARD_CAP %d\n",
                    file, key, mv->coins_zones, MB_HAZARD_CAP);
            return 0;
        }
        break;
    case MB_MT_RETREAT:
        ok &= mb_need_int_at(d, file, prefix, "projectile_interval",
                             &mv->projectile_interval);
        if (ok && mv->projectile_interval <= 0) {
            fprintf(stderr, "monkey-baiting: %s move '%s' projectile_interval "
                            "must be > 0\n", file, key);
            return 0;
        }
        break;
    default:
        break;
    }
    if (!ok) return 0;

    if (mv->hits > 0 && mv->hit_interval <= 0) {
        fprintf(stderr, "monkey-baiting: %s move '%s' has hits but no positive "
                        "hit_interval\n", file, key);
        return 0;
    }

    /* Spam reach, precomputed per (character, move). Same computation the
     * spam strategy and the bot proximity gate both use. */
    if (mb_move_unranged(mv->type)) {
        mv->reach = r->strat.spam_unranged_reach;
    } else {
        mv->reach = mv->hb_x + mv->hb_w - (hurt_w / 2) + r->strat.spam_reach_margin;
        if (mv->has_leap) mv->reach += r->strat.spam_leap_reach_bonus;
    }
    return 1;
}

/* --------------------------------------------------------- characters */

static int mb_load_char(MbChar *c, const MbYamlDoc *d, const char *file,
                        MbRules *r) {
    int ok = 1, k;
    int32_t iv;
    mb_fp fv;
    int32_t hp = 0;

    memset(c, 0, sizeof(*c));
    c->finisher_move = -1;

    ok &= mb_need_int(d, file, "max_health", &hp);
    if (!ok) return 0;
    if (hp <= 0) {
        fprintf(stderr, "monkey-baiting: %s max_health must be > 0\n", file);
        return 0;
    }
    c->max_health = mb_from_int(hp);

    ok &= mb_need_fp(d, file, "walk_speed", &c->walk_speed);
    ok &= mb_need_fp(d, file, "jump_velocity", &c->jump_velocity);
    ok &= mb_need_fp(d, file, "gravity", &c->gravity);
    ok &= mb_need_fp(d, file, "weight", &c->weight);
    ok &= mb_need_int(d, file, "grip_resistance", &c->grip_resistance);
    ok &= mb_need_fp(d, file, "hurtbox.w", &c->hurt_w);
    ok &= mb_need_fp(d, file, "hurtbox.h", &c->hurt_h);
    if (!ok) return 0;
    if (c->weight <= 0) {
        fprintf(stderr, "monkey-baiting: %s weight must be > 0 (it divides the "
                        "knockback)\n", file);
        return 0;
    }

    /* mechanics: every entry optional, but a present one must parse */
    {
        const char *fm = mb_yaml_get(d, "mechanics.finisher_move");
        if (fm) {
            c->finisher_move = mb_rules_move_key(fm);
            if (c->finisher_move < 0) {
                fprintf(stderr, "monkey-baiting: %s mechanics.finisher_move '%s' "
                                "is not a move key\n", file, fm);
                return 0;
            }
        }
    }
    if (mb_opt_fp(d, file, "mechanics.chain_radius", &fv, &ok)) {
        c->has_chain_radius = 1;
        c->chain_radius = fv;
    }
    if (mb_opt_int(d, file, "mechanics.ripple_frames", &iv, &ok))
        c->ripple_frames = iv;
    {
        const char *ws = mb_yaml_get(d, "mechanics.wall_scramble");
        c->wall_scramble = ws && strcmp(ws, "true") == 0;
    }
    if (mb_opt_int(d, file, "mechanics.post_exchange_retreat", &iv, &ok))
        c->post_exchange_retreat = iv;

    /* ON THE CROSS (the odds flip). Keyed on the DATA, not on a character
     * name: a character with cross_health gets the rule. */
    if (mb_opt_fp(d, file, "mechanics.cross_health", &fv, &ok)) {
        c->has_odds_flip = 1;
        c->odds_flip_health_abs = mb_mul(fv, c->max_health);
        if (!mb_need_fp(d, file, "mechanics.cross_damage_mult",
                        &c->odds_flip_damage_mult))
            return 0;
    }

    /* THE CROSS (the cheat). Same rule: presence of mechanics.the_cross. */
    if (mb_opt_fp(d, file, "mechanics.the_cross.trigger_health", &fv, &ok)) {
        mb_fp win = 0;
        c->has_the_cross = 1;
        c->cross_trigger_health_abs = mb_mul(fv, c->max_health);
        ok &= mb_need_fp(d, file, "mechanics.the_cross.window_seconds", &win);
        ok &= mb_need_fp(d, file, "mechanics.the_cross.drain_per_second",
                         &c->cross_drain_per_second);
        ok &= mb_need_fp(d, file, "mechanics.the_cross.min_health",
                         &c->cross_min_health);
        ok &= mb_need_fp(d, file, "mechanics.the_cross.break_bonus_damage",
                         &c->cross_break_bonus_damage);
        ok &= mb_need_int(d, file, "mechanics.the_cross.break_stagger_frames",
                          &c->cross_break_stagger_frames);
        if (!ok) return 0;
        c->cross_window_frames = mb_round_to_int(mb_mul(win,
                                                        mb_from_int(r->logic_hz)));
    }

    /* ai block */
    if (mb_yaml_get(d, "ai.aggression")) {
        c->has_ai = 1;
        ok &= mb_need_fp(d, file, "ai.aggression", &c->aggression);
        ok &= mb_need_fp(d, file, "ai.poke_range", &c->poke_range);
        ok &= mb_need_fp(d, file, "ai.special_min_range", &c->special_min_range);
        ok &= mb_need_fp(d, file, "ai.special_max_range", &c->special_max_range);
        ok &= mb_need_fp(d, file, "ai.block_chance", &fv);
        c->block_chance_q32 = mb_q32(fv);
        ok &= mb_need_fp(d, file, "ai.retreat_chance", &fv);
        c->retreat_chance_q32 = mb_q32(fv);
        ok &= mb_need_fp(d, file, "ai.jump_chance", &fv);
        c->jump_chance_q32 = mb_q32(fv);
        if (!ok) return 0;
        c->light_chance_q32   = mb_q32(c->aggression);
        c->heavy_chance_q32   = mb_q32(mb_mul(r->ai_heavy_roll_ratio,
                                              c->aggression));
        c->special_chance_q32 = mb_q32(mb_mul(r->ai_special_roll_ratio,
                                              c->aggression));
        if (mb_opt_fp(d, file, "ai.stance_chance", &fv, &ok)) {
            c->has_stance_chance = 1;
            c->stance_chance_q32 = mb_q32(fv);
        }
        if (mb_opt_fp(d, file, "ai.keep_range", &fv, &ok)) {
            c->has_keep_range = 1;
            c->keep_range = fv;
        }
        if (mb_opt_fp(d, file, "ai.stakes_down_health", &fv, &ok)) {
            c->has_stakes_down_health = 1;
            c->stakes_down_health_abs = mb_mul(fv, c->max_health);
        }
        if (!ok) return 0;
    }

    for (k = 0; k < MB_MOVE_KEYS; k++) {
        if (!mb_load_move(&c->moves[k], d, file, mb_move_key_names[k], r,
                          c->hurt_w, c->max_health))
            return 0;
        if (c->moves[k].present) c->move_count++;
    }
    if (c->move_count == 0) {
        fprintf(stderr, "monkey-baiting: %s authors no moves\n", file);
        return 0;
    }
    /* root CLAUDE.md decision 17: the compile-time cap is asserted against the
     * real data. A character with more moves than cooldown slots would drop
     * cooldowns silently. */
    if (c->move_count > MB_MAX_MOVES) {
        fprintf(stderr, "monkey-baiting: %s authors %d moves, MB_MAX_MOVES is "
                        "%d\n", file, c->move_count, MB_MAX_MOVES);
        return 0;
    }
    if (c->finisher_move >= 0 && !c->moves[c->finisher_move].present) {
        fprintf(stderr, "monkey-baiting: %s names finisher_move '%s' but does "
                        "not author it\n", file,
                mb_move_key_names[c->finisher_move]);
        return 0;
    }
    return 1;
}

/* ------------------------------------------------ strategies and bots */

static int mb_load_strategies(MbRules *r, const char *sandbox_dir,
                              MbYamlDoc *doc) {
    char path[512];
    mb_fp fv;
    int ok = 1;

    snprintf(path, sizeof(path), "%s/data/strategies.yaml", sandbox_dir);
    if (!mb_yaml_read(path, doc)) return 0;

    ok &= mb_need_fp(doc, path, "strategies.spam.params.reach_margin",
                     &r->strat.spam_reach_margin);
    ok &= mb_need_fp(doc, path, "strategies.spam.params.leap_reach_bonus",
                     &r->strat.spam_leap_reach_bonus);
    ok &= mb_need_fp(doc, path, "strategies.spam.params.unranged_reach",
                     &r->strat.spam_unranged_reach);
    ok &= mb_need_int(doc, path, "strategies.random.params.decision_interval",
                      &r->strat.random_interval);
    ok &= mb_need_fp(doc, path, "strategies.random.params.move_weight", &fv);
    r->strat.random_move_weight_q32 = mb_q32(fv);
    ok &= mb_need_fp(doc, path, "strategies.passive.params.block_chance", &fv);
    r->strat.passive_block_chance_q32 = mb_q32(fv);
    ok &= mb_need_fp(doc, path, "strategies.passive.params.maintain_distance",
                     &r->strat.passive_distance);
    ok &= mb_need_fp(doc, path, "strategies.passive.params.near_margin",
                     &r->strat.passive_near_margin);
    ok &= mb_need_fp(doc, path, "strategies.passive.params.far_margin",
                     &r->strat.passive_far_margin);
    ok &= mb_need_int(doc, path, "strategies.perfect.params.hold_walk",
                      &r->strat.perfect_hold_walk);
    ok &= mb_need_int(doc, path, "strategies.perfect.params.hold_block",
                      &r->strat.perfect_hold_block);
    ok &= mb_need_int(doc, path, "strategies.perfect.params.hold_wait",
                      &r->strat.perfect_hold_wait);
    ok &= mb_need_int(doc, path, "strategies.perfect.params.hold_move",
                      &r->strat.perfect_hold_move);
    ok &= mb_need_int(doc, path, "strategies.perfect.params.hold_cd_miss",
                      &r->strat.perfect_hold_cd_miss);
    if (ok && (r->strat.perfect_hold_walk < 0 || r->strat.perfect_hold_block < 0 ||
               r->strat.perfect_hold_wait < 0 || r->strat.perfect_hold_move < 0 ||
               r->strat.perfect_hold_cd_miss < 0)) {
        fprintf(stderr, "monkey-baiting: %s perfect hold_* must be >= 0\n", path);
        ok = 0;
    }
    if (ok && r->strat.random_interval <= 0) {
        fprintf(stderr, "monkey-baiting: %s random decision_interval must be > 0\n",
                path);
        ok = 0;
    }
    return ok;
}

/* Resolves a strategy reference used inside a bot table: "default",
 * "spam-heavy", "random", "passive", "perfect". */
static int mb_strategy_ref(const char *ref, int32_t *kind, int32_t *move_key,
                           const char *file, const char *bot) {
    *move_key = -1;
    if (strncmp(ref, "spam-", 5) == 0) {
        *kind = MB_POLICY_SPAM;
        *move_key = mb_rules_move_key(ref + 5);
        if (*move_key < 0) {
            fprintf(stderr, "monkey-baiting: %s bot '%s': '%s' names no move key\n",
                    file, bot, ref);
            return 0;
        }
        return 1;
    }
    if (!strcmp(ref, "default")) { *kind = MB_POLICY_DEFAULT; return 1; }
    if (!strcmp(ref, "random"))  { *kind = MB_POLICY_RANDOM;  return 1; }
    if (!strcmp(ref, "passive")) { *kind = MB_POLICY_PASSIVE; return 1; }
    if (!strcmp(ref, "perfect")) { *kind = MB_POLICY_PERFECT; return 1; }
    fprintf(stderr, "monkey-baiting: %s bot '%s' references unknown strategy "
                    "'%s'\n", file, bot, ref);
    return 0;
}

static int mb_bot_slot(const char *name, const char *file) {
    int id = mb_rules_bot_id(name);
    if (id >= 0) return id;
    if (mb_bot_name_count >= MB_MAX_BOTS) {
        fprintf(stderr, "monkey-baiting: %s declares more than %d bots\n",
                file, MB_MAX_BOTS);
        return -1;
    }
    snprintf(mb_bot_names[mb_bot_name_count], sizeof(mb_bot_names[0]), "%s", name);
    return mb_bot_name_count++;
}

static MbBotComp *mb_bot_comp(MbBot *b, int32_t kind, int32_t move_key) {
    int i;
    for (i = 0; i < b->count; i++)
        if (b->comp[i].kind == kind && b->comp[i].move_key == move_key)
            return &b->comp[i];
    if (b->count >= MB_MAX_BOT_COMPS) return NULL;
    b->comp[b->count].kind = kind;
    b->comp[b->count].move_key = move_key;
    b->comp[b->count].weight = 0;
    return &b->comp[b->count++];
}

static int mb_load_bots(MbRules *r, const char *sandbox_dir, MbYamlDoc *doc) {
    char path[512];
    const char *prefix = "bots.table.";
    size_t plen;
    int i, bi, ci, ok = 1;

    snprintf(path, sizeof(path), "%s/data/bots.yaml", sandbox_dir);
    if (!mb_yaml_read(path, doc)) return 0;
    plen = strlen(prefix);

    mb_bot_name_count = 0;
    memset(&r->bots, 0, sizeof(r->bots));
    if (!mb_need_int(doc, path, "bots.hold_frames", &r->bots.hold_frames))
        return 0;
    if (r->bots.hold_frames <= 0) {
        fprintf(stderr, "monkey-baiting: %s bots.hold_frames must be > 0\n", path);
        return 0;
    }

    for (i = 0; i < doc->n; i++) {
        const char *key = doc->e[i].key;
        const char *rest, *dot;
        char botname[64], ref[64];
        int32_t kind = 0, move_key = -1, num = 0;
        MbBot *b;
        MbBotComp *c;

        if (strncmp(key, prefix, plen) != 0) continue;
        rest = key + plen;
        dot = strchr(rest, '.');
        if (!dot) {
            fprintf(stderr, "monkey-baiting: %s key '%s' is not "
                            "bots.table.<bot>.<strategy>\n", path, key);
            return 0;
        }
        if ((size_t)(dot - rest) >= sizeof(botname)) return 0;
        memcpy(botname, rest, (size_t)(dot - rest));
        botname[dot - rest] = 0;

        rest = dot + 1;
        dot = strchr(rest, '.');
        if (dot) {
            if ((size_t)(dot - rest) >= sizeof(ref)) return 0;
            memcpy(ref, rest, (size_t)(dot - rest));
            ref[dot - rest] = 0;
        } else {
            snprintf(ref, sizeof(ref), "%s", rest);
        }

        bi = mb_bot_slot(botname, path);
        if (bi < 0) return 0;
        if (bi >= r->bots.count) r->bots.count = bi + 1;
        b = &r->bots.bot[bi];

        if (!mb_strategy_ref(ref, &kind, &move_key, path, botname)) return 0;
        c = mb_bot_comp(b, kind, move_key);
        if (!c) {
            fprintf(stderr, "monkey-baiting: %s bot '%s' has more than %d "
                            "components\n", path, botname, MB_MAX_BOT_COMPS);
            return 0;
        }

        if (!dot) {                                  /* shorthand: weight only */
            if (!mb_parse_int(doc->e[i].val, &num) || num <= 0) {
                fprintf(stderr, "monkey-baiting: %s bot '%s' entry '%s' weight "
                                "'%s' is not a positive integer\n",
                        path, botname, ref, doc->e[i].val);
                return 0;
            }
            c->weight = num;
        } else {
            const char *field = dot + 1;
            if (!strcmp(field, "weight")) {
                if (!mb_parse_int(doc->e[i].val, &num) || num <= 0) {
                    fprintf(stderr, "monkey-baiting: %s bot '%s' entry '%s' "
                                    "weight '%s' is not a positive integer\n",
                            path, botname, ref, doc->e[i].val);
                    return 0;
                }
                c->weight = num;
            } else if (!strcmp(field, "within")) {
                c->gated = 1;
                c->has_within = 1;
                if (!strcmp(doc->e[i].val, "reach")) c->within_is_reach = 1;
                else if (!mb_parse_fp(doc->e[i].val, &c->within)) {
                    fprintf(stderr, "monkey-baiting: %s bot '%s' entry '%s' "
                                    "within '%s' is neither 'reach' nor a "
                                    "number\n", path, botname, ref,
                            doc->e[i].val);
                    return 0;
                }
            } else if (!strcmp(field, "beyond")) {
                c->gated = 1;
                c->has_beyond = 1;
                if (!mb_parse_fp(doc->e[i].val, &c->beyond)) {
                    fprintf(stderr, "monkey-baiting: %s bot '%s' entry '%s' "
                                    "beyond '%s' is not a number\n",
                            path, botname, ref, doc->e[i].val);
                    return 0;
                }
            } else {
                fprintf(stderr, "monkey-baiting: %s bot '%s' entry '%s' has "
                                "unknown field '%s'\n",
                        path, botname, ref, field);
                return 0;
            }
        }
    }

    if (r->bots.count == 0) {
        fprintf(stderr, "monkey-baiting: %s declares no bots\n", path);
        return 0;
    }
    for (bi = 0; bi < r->bots.count; bi++) {
        MbBot *b = &r->bots.bot[bi];
        int ungated = 0, best = -1;
        if (b->count == 0) {
            fprintf(stderr, "monkey-baiting: %s bot '%s' has an empty table\n",
                    path, mb_bot_names[bi]);
            return 0;
        }
        for (ci = 0; ci < b->count; ci++) {
            if (b->comp[ci].weight <= 0) {
                fprintf(stderr, "monkey-baiting: %s bot '%s' has an entry with "
                                "no weight\n", path, mb_bot_names[bi]);
                return 0;
            }
            if (b->comp[ci].gated) continue;
            ungated++;
            if (best < 0 || b->comp[ci].weight > b->comp[best].weight) best = ci;
        }
        if (best < 0) {
            fprintf(stderr, "monkey-baiting: %s bot '%s' has no ungated entry "
                            "to fall back to\n", path, mb_bot_names[bi]);
            return 0;
        }
        b->fallback = best;
        b->pure = (b->count == 1 && ungated == 1);
    }
    return ok;
}

int mb_rules_resolve_entrant(const MbRules *rules, const char *entrant_id,
                             int have_policies, int *char_out, int *bot_out) {
    char name[64];
    const char *colon;
    int cid, bid, ci;
    const MbBot *b;

    colon = strchr(entrant_id, ':');
    if (!colon || colon == entrant_id || !colon[1]) {
        fprintf(stderr, "monkey-baiting: entrant id '%s' is not "
                        "<character>:<bot>\n", entrant_id);
        return 0;
    }
    if ((size_t)(colon - entrant_id) >= sizeof(name)) return 0;
    memcpy(name, entrant_id, (size_t)(colon - entrant_id));
    name[colon - entrant_id] = 0;

    cid = mb_rules_char_id(name);
    if (cid < 0) {
        fprintf(stderr, "monkey-baiting: entrant '%s' names no character '%s'\n",
                entrant_id, name);
        return 0;
    }
    bid = mb_rules_bot_id(colon + 1);
    if (bid < 0 || bid >= rules->bots.count) {
        fprintf(stderr, "monkey-baiting: entrant '%s' names no bot '%s'\n",
                entrant_id, colon + 1);
        return 0;
    }

    b = &rules->bots.bot[bid];
    for (ci = 0; ci < b->count; ci++) {
        if (b->comp[ci].kind == MB_POLICY_PERFECT && !have_policies) {
            /* Refused, never demoted. Which POLICY FILES this entrant needs
             * depends on who it is drawn against, so the per-pairing check
             * lives in mb_world_set_queue; this one only says that no policy
             * directory was loaded at all. */
            fprintf(stderr,
                    "monkey-baiting: entrant '%s' rolls the 'perfect' strategy, "
                    "but no solved policies are loaded - pass a policy "
                    "directory (mb_sim --perfect DIR); see "
                    "sandboxes/monkey-baiting/CLAUDE.md, "
                    "\"Perfect-policy playback\"\n", entrant_id);
            return 0;
        }
        if (b->comp[ci].kind == MB_POLICY_SPAM &&
            !rules->chars.c[cid].moves[b->comp[ci].move_key].present) {
            fprintf(stderr,
                    "monkey-baiting: entrant '%s' spams '%s', which %s does not "
                    "author\n", entrant_id,
                    mb_rules_move_key_name(b->comp[ci].move_key), name);
            return 0;
        }
    }
    *char_out = cid;
    *bot_out = bid;
    return 1;
}

/* ---------------------------------------------------------------- load */

int mb_rules_load(MbRules *out, const char *sandbox_dir) {
    MbYamlDoc *doc = (MbYamlDoc *)malloc(sizeof(MbYamlDoc));
    MbYamlDoc *cdoc = (MbYamlDoc *)malloc(sizeof(MbYamlDoc));
    char path[512];
    int ok = 1, i;

    if (!doc || !cdoc) { free(doc); free(cdoc); return 0; }
    memset(out, 0, sizeof(*out));

    snprintf(path, sizeof(path), "%s/app.yaml", sandbox_dir);
    if (!mb_yaml_read(path, doc)) { free(doc); free(cdoc); return 0; }

    ok &= mb_need_int(doc, path, "logic_hz", &out->logic_hz);
    ok &= mb_need_int(doc, path, "ring.left", &out->ring_left);
    ok &= mb_need_int(doc, path, "ring.right", &out->ring_right);
    ok &= mb_need_int(doc, path, "ring.center", &out->ring_center);
    ok &= mb_need_int(doc, path, "ring.start_offset", &out->ring_start_offset);
    ok &= mb_need_fp(doc, path, "combat.block_chip_ratio", &out->block_chip_ratio);
    ok &= mb_need_fp(doc, path, "combat.low_health_announce", &out->low_health_announce);
    ok &= mb_need_fp(doc, path, "combat.knockback_scale", &out->knockback_scale);
    ok &= mb_need_int(doc, path, "combat.ko_slowmo_frames", &out->ko_slowmo_frames);
    ok &= mb_need_int(doc, path, "combat.ko_fall_frames", &out->ko_fall_frames);
    ok &= mb_need_int(doc, path, "rounds.wins_to_take_match", &out->wins_to_take_match);
    ok &= mb_need_int(doc, path, "rounds.time_seconds", &out->time_seconds);
    ok &= mb_need_int(doc, path, "rounds.intro_frames", &out->intro_frames);
    ok &= mb_need_int(doc, path, "rounds.end_frames", &out->end_frames);
    ok &= mb_need_int(doc, path, "rounds.max_rounds_per_match", &out->max_rounds_per_match);
    ok &= mb_need_int(doc, path, "finisher.rearm_frames", &out->finisher_rearm_frames);
    ok &= mb_need_int(doc, path, "finisher.cinematic_frames", &out->finisher_cinematic_frames);
    ok &= mb_need_fp(doc, path, "finisher.health_threshold",
                     &out->finisher_health_threshold);
    ok &= mb_need_int(doc, path, "ai.decision_interval_frames", &out->ai_decision_interval);
    ok &= mb_need_int(doc, path, "sim.batch", &out->sim_batch);

    /* The gameplay constants that used to be literals in logic.js. */
    ok &= mb_need_fp(doc, path, "combat.ko_fall_vy", &out->ko_fall_vy);
    ok &= mb_need_fp(doc, path, "combat.ko_fall_vx", &out->ko_fall_vx);
    ok &= mb_need_fp(doc, path, "combat.idle_vx_decay", &out->idle_vx_decay);
    ok &= mb_need_fp(doc, path, "combat.stun_vx_decay", &out->stun_vx_decay);
    ok &= mb_need_fp(doc, path, "combat.ground_epsilon", &out->ground_epsilon);
    ok &= mb_need_fp(doc, path, "combat.air_epsilon", &out->air_epsilon);
    ok &= mb_need_fp(doc, path, "combat.knockback_vy_scale", &out->knockback_vy_scale);
    ok &= mb_need_fp(doc, path, "combat.launch_vy_threshold", &out->launch_vy_threshold);
    ok &= mb_need_fp(doc, path, "combat.pushback_hit_scale", &out->pushback_hit_scale);
    ok &= mb_need_fp(doc, path, "combat.pushback_block_scale", &out->pushback_block_scale);
    ok &= mb_need_int(doc, path, "combat.block_freeze", &out->block_freeze);
    ok &= mb_need_int(doc, path, "combat.armor_freeze", &out->armor_freeze);
    ok &= mb_need_int(doc, path, "combat.stance_freeze", &out->stance_freeze);
    ok &= mb_need_int(doc, path, "combat.stance_attacker_stun", &out->stance_attacker_stun);
    ok &= mb_need_fp(doc, path, "combat.stance_shake", &out->stance_shake);
    ok &= mb_need_fp(doc, path, "combat.stance_attacker_vx", &out->stance_attacker_vx);
    ok &= mb_need_fp(doc, path, "combat.separate_inset", &out->separate_inset);
    ok &= mb_need_fp(doc, path, "combat.separate_y_window", &out->separate_y_window);
    ok &= mb_need_fp(doc, path, "combat.grab_offset", &out->grab_offset);
    ok &= mb_need_fp(doc, path, "combat.yank_offset", &out->yank_offset);
    ok &= mb_need_fp(doc, path, "combat.yank_arrive_epsilon", &out->yank_arrive_epsilon);
    ok &= mb_need_fp(doc, path, "combat.walk_air_ratio", &out->walk_air_ratio);
    ok &= mb_need_fp(doc, path, "combat.walk_retreat_ratio", &out->walk_retreat_ratio);
    ok &= mb_need_fp(doc, path, "combat.wall_jump_ratio", &out->wall_jump_ratio);
    ok &= mb_need_fp(doc, path, "combat.wall_margin", &out->wall_margin);
    ok &= mb_need_fp(doc, path, "combat.retreat_step", &out->retreat_step);
    ok &= mb_need_fp(doc, path, "combat.retreat_epsilon", &out->retreat_epsilon);
    ok &= mb_need_int(doc, path, "combat.retreat_invuln_frames",
                      &out->retreat_invuln_frames);
    ok &= mb_need_int(doc, path, "combat.coins_margin", &out->coins_margin);
    ok &= mb_need_fp(doc, path, "combat.thrown_spawn_y", &out->thrown_spawn_y);
    ok &= mb_need_fp(doc, path, "combat.thrown_gravity", &out->thrown_gravity);
    ok &= mb_need_fp(doc, path, "combat.thrown_hit_radius", &out->thrown_hit_radius);
    ok &= mb_need_int(doc, path, "combat.thrown_spread", &out->thrown_spread);
    ok &= mb_need_int(doc, path, "combat.cross_break_freeze", &out->cross_break_freeze);
    ok &= mb_need_fp(doc, path, "combat.cross_break_shake", &out->cross_break_shake);
    ok &= mb_need_fp(doc, path, "combat.cross_break_vx", &out->cross_break_vx);

    ok &= mb_need_fp(doc, path, "ai.special_roll_ratio", &out->ai_special_roll_ratio);
    ok &= mb_need_fp(doc, path, "ai.heavy_roll_ratio", &out->ai_heavy_roll_ratio);
    {
        mb_fp fv = 0;
        ok &= mb_need_fp(doc, path, "ai.yank_dodge_chance", &fv);
        out->ai_yank_dodge_chance_q32 = mb_q32(fv);
        ok &= mb_need_fp(doc, path, "ai.yank_use_chance", &fv);
        out->ai_yank_use_chance_q32 = mb_q32(fv);
        ok &= mb_need_fp(doc, path, "ai.stakes_down_roll_chance", &fv);
        out->ai_stakes_down_roll_q32 = mb_q32(fv);
    }
    ok &= mb_need_fp(doc, path, "ai.block_range_bonus", &out->ai_block_range_bonus);
    ok &= mb_need_fp(doc, path, "ai.stance_range", &out->ai_stance_range);
    ok &= mb_need_fp(doc, path, "ai.stakes_down_range", &out->ai_stakes_down_range);
    ok &= mb_need_fp(doc, path, "ai.yank_min_range", &out->ai_yank_min_range);
    ok &= mb_need_fp(doc, path, "ai.heavy_range_bonus", &out->ai_heavy_range_bonus);
    ok &= mb_need_fp(doc, path, "ai.keep_range_margin", &out->ai_keep_range_margin);
    ok &= mb_need_fp(doc, path, "ai.poke_margin", &out->ai_poke_margin);

    if (ok) {
        mb_fp win = 0;
        ok &= mb_need_fp(doc, path, "finisher.window_seconds", &win);
        if (ok)
            out->finisher_window_frames =
                mb_round_to_int(mb_mul(win, mb_from_int(out->logic_hz)));
    }

    /* strategies and bots must load before the characters: the per-move spam
     * reach is precomputed from the spam params. */
    if (ok) ok = mb_load_strategies(out, sandbox_dir, cdoc);
    if (ok) ok = mb_load_bots(out, sandbox_dir, cdoc);

    mb_char_name_count = 0;
    for (i = 0; i < MB_MAX_CHARS; i++) {
        char key[64];
        const char *name;
        snprintf(key, sizeof(key), "characters.%d", i);
        name = mb_yaml_get(doc, key);
        if (!name) break;
        snprintf(mb_char_names[i], sizeof(mb_char_names[i]), "%s", name);
        mb_char_name_count++;
    }
    if (mb_char_name_count == 0) {
        fprintf(stderr, "monkey-baiting: %s has no 'characters:' roster\n", path);
        ok = 0;
    }
    out->chars.count = mb_char_name_count;

    for (i = 0; i < mb_char_name_count && ok; i++) {
        char cpath[512];
        snprintf(cpath, sizeof(cpath), "%s/data/characters/%s.yaml",
                 sandbox_dir, mb_char_names[i]);
        if (!mb_yaml_read(cpath, cdoc)) { ok = 0; break; }
        if (!mb_load_char(&out->chars.c[i], cdoc, cpath, out)) { ok = 0; break; }
        out->chars.max_health[i] = out->chars.c[i].max_health;
    }

    if (ok && out->ring_right <= out->ring_left) {
        fprintf(stderr, "monkey-baiting: %s ring.right must exceed ring.left\n", path);
        ok = 0;
    }
    if (ok && out->logic_hz <= 0) {
        fprintf(stderr, "monkey-baiting: %s logic_hz must be > 0\n", path);
        ok = 0;
    }

    free(doc);
    free(cdoc);
    return ok;
}
/* MONKEY BAITING - YAML reading and the rules loader (host only, never on
 * the hot path).
 *
 * mb_yaml_read flattens a YAML document to dotted scalar paths in document
 * order (sequence items are addressed by index: characters.0, fields.cd.count).
 * mb_rules_load uses it to build the immutable MbRules table from
 * sandboxes/monkey-baiting/app.yaml plus data/characters/*.yaml; the test
 * suite uses it to check components/*.yaml against the C schema.
 *
 * Every key mb_rules_load wants is required. A missing or malformed value
 * prints what is wrong and fails the load (root CLAUDE.md decision 12, no
 * silent fallbacks). Nothing is ever defaulted.
 *
 * Decimal scalars become Q16.16 by exact integer arithmetic - no strtod, no
 * float anywhere in the pipeline. */
#ifndef MB_RULES_H
#define MB_RULES_H

#include "mb_types.h"

#ifdef __cplusplus
extern "C" {
#endif

#define MB_YAML_MAX_ENTRIES 1024
#define MB_YAML_MAX_KEY     192
#define MB_YAML_MAX_VAL     128

typedef struct {
    char key[MB_YAML_MAX_KEY];
    char val[MB_YAML_MAX_VAL];
} MbYamlEntry;

typedef struct {
    MbYamlEntry e[MB_YAML_MAX_ENTRIES];
    int n;
} MbYamlDoc;

/* Reads path into doc. Returns 1 on success, 0 with a message on stderr. */
int mb_yaml_read(const char *path, MbYamlDoc *doc);

/* Value for a dotted key, or NULL. */
const char *mb_yaml_get(const MbYamlDoc *doc, const char *key);

/* Exact decimal -> Q16.16. Returns 1 on success. */
int mb_parse_fp(const char *s, mb_fp *out);

/* Returns 1 on success, 0 on failure (with a message on stderr).
 * sandbox_dir is e.g. "sandboxes/monkey-baiting". */
int mb_rules_load(MbRules *out, const char *sandbox_dir);

/* Character name for a char_id, or NULL. Host-side only: the step functions
 * never see a string. */
const char *mb_rules_char_name(int char_id);
/* char_id for a name, or -1. */
int mb_rules_char_id(const char *name);

/* Bot name <-> id, from data/bots.yaml. Host-side only, same rule. */
const char *mb_rules_bot_name(int bot_id);
int mb_rules_bot_id(const char *name);

/* Move key name ("light" / "heavy" / "special" / "stakes_down") for a key
 * index, or NULL. Host-side only. */
const char *mb_rules_move_key_name(int key);
int mb_rules_move_key(const char *name);

/* Resolves an entrant id of the form "<char_id>:<bot_id>" (see ../CLAUDE.md,
 * "Entrant identity") into a character index and a bot index. Returns 1 on
 * success; on failure prints what is wrong and returns 0. Refuses a
 * malformed id, an unknown character, an unknown bot, a spam component
 * naming a move the character does not author, and - when have_policies is
 * 0 - any bot that can roll `perfect`. All loudly, never by demotion.
 *
 * have_policies says only that a policy set was loaded. Whether the SPECIFIC
 * ordered pairs this entrant will be drawn into are present is not knowable
 * from one entrant, so that check lives in mb_world_set_queue, which sees
 * the pairings. */
int mb_rules_resolve_entrant(const MbRules *rules, const char *entrant_id,
                             int have_policies, int *char_out, int *bot_out);

#ifdef __cplusplus
}
#endif

#endif /* MB_RULES_H */
/* MONKEY BAITING - the component schema, in C.
 *
 * This table is the C-side declaration of what ../../components/*.yaml says.
 * mb_world_register uses it to build the components when they are not
 * already registered (the tournament simulator has no YAML component
 * loader), and tests/test_mb_sim.c parses the YAML files and compares them
 * against this table field by field, so the two cannot drift.
 *
 * Field order must match both the YAML and the C structs in mb_types.h. */
#include "mb_types.h"
#include <stddef.h>

#define MB_FIELDS(name) \
    static const MbFieldDesc mb_f_##name[]

MB_FIELDS(MbBody) = {
    { "x", "i32", 1 }, { "y", "i32", 1 }, { "vx", "i32", 1 }, { "vy", "i32", 1 }
};

MB_FIELDS(MbVitals) = {
    { "hp", "i32", 1 }, { "damage_mult", "i32", 1 },
    { "chip_residual", "i32", 1 },
    { "took_damage", "bool", 1 }, { "low_announced", "bool", 1 }
};

MB_FIELDS(MbFsm) = {
    { "state", "i32", 1 }, { "t", "i32", 1 }, { "stun_t", "i32", 1 },
    { "dazed_t", "i32", 1 }, { "invuln_frames", "i32", 1 },
    { "hit_index", "i32", 1 }, { "facing", "i32", 1 },
    { "block_stun", "bool", 1 }, { "prev_jump", "bool", 1 },
    { "wall_jumped", "bool", 1 }, { "ripple", "bool", 1 },
    { "attack_deferred", "bool", 1 }
};

MB_FIELDS(MbMoveSlot) = {
    { "move_id", "i32", 1 }, { "move_key", "i32", 1 },
    { "leap_vx", "i32", 1 }, { "proj_t", "i32", 1 }
};

MB_FIELDS(MbCooldowns) = {
    { "cd", "i32", MB_MAX_MOVES }
};

MB_FIELDS(MbRetreat) = {
    { "dir", "i32", 1 }, { "t", "i32", 1 }
};

MB_FIELDS(MbGrab) = {
    { "t", "i32", 1 }, { "move_id", "i32", 1 }, { "side_foe", "i32", 1 },
    { "foe", "entity", 1 }
};

MB_FIELDS(MbYank) = {
    { "target", "i32", 1 }, { "speed", "i32", 1 }, { "active", "bool", 1 }
};

MB_FIELDS(MbRefs) = {
    { "char_id", "i32", 1 }, { "entrant_id", "i32", 1 }, { "slot", "i32", 1 },
    { "side", "i32", 1 }, { "rounds_won", "i32", 1 }
};

MB_FIELDS(MbBrain) = {
    { "policy_kind", "i32", 1 }, { "policy_id", "i32", 1 },
    { "hold", "i32", 1 }, { "plan_action", "i32", 1 },
    { "plan_left", "i32", 1 }, { "held_input", "u32", 1 },
    { "bot_id", "i32", 1 }, { "bot_hold", "i32", 1 },
    { "was_busy", "bool", 1 }
};

MB_FIELDS(MbInput) = {
    { "bits", "u32", 1 }
};

MB_FIELDS(MbClock) = {
    { "frame", "i32", 1 }, { "timer", "i32", 1 }, { "round", "i32", 1 },
    { "phase", "i32", 1 }, { "phase_t", "i32", 1 }, { "freeze", "i32", 1 },
    { "slowmo", "i32", 1 }, { "shake", "i32", 1 }, { "active", "bool", 1 }
};

MB_FIELDS(MbRng) = {
    { "state", "u32", 1 }, { "seed", "u32", 1 }
};

MB_FIELDS(MbPair) = {
    { "entrant0", "i32", 1 }, { "entrant1", "i32", 1 },
    { "char0", "i32", 1 }, { "char1", "i32", 1 },
    { "seed_index", "i32", 1 }, { "result_index", "i32", 1 }
};

MB_FIELDS(MbCross) = {
    { "t", "i32", 1 }, { "window", "i32", 1 }, { "cheater", "i32", 1 },
    { "victim", "i32", 1 }, { "used", "bool", 1 }, { "puss_cross", "bool", 1 }
};

MB_FIELDS(MbFinisher) = {
    { "window_t", "i32", 1 }, { "rearm", "i32", 1 },
    { "armed", "bool", 1 }, { "done", "bool", 1 }
};

MB_FIELDS(MbOutcome) = {
    { "winner", "i32", 1 }, { "frames", "i32", 1 }, { "rounds", "i32", 1 },
    { "tie_rounds", "i32", 1 }, { "timeouts", "i32", 1 },
    { "finishers", "i32", 1 }, { "capped", "bool", 1 }, { "drawn", "bool", 1 }
};

MB_FIELDS(MbHazards) = {
    { "count", "i32", 1 },
    { "kind", "i32", MB_HAZARD_CAP }, { "t", "i32", MB_HAZARD_CAP },
    { "dur", "i32", MB_HAZARD_CAP },  { "owner", "i32", MB_HAZARD_CAP },
    { "dps", "i32", MB_HAZARD_CAP },  { "x", "i32", MB_HAZARD_CAP },
    { "w", "i32", MB_HAZARD_CAP },    { "y", "i32", MB_HAZARD_CAP },
    { "vy", "i32", MB_HAZARD_CAP }
};

#define MB_COMP(n) \
    { #n, "component", mb_f_##n, (int)(sizeof(mb_f_##n) / sizeof(MbFieldDesc)), \
      (uint32_t)sizeof(n) }
#define MB_MARKER(n) { #n, "marker", NULL, 0, 0 }

const MbCompDesc mb_schema[] = {
    /* fighter */
    MB_COMP(MbBody),
    MB_COMP(MbVitals),
    MB_COMP(MbFsm),
    MB_COMP(MbMoveSlot),
    MB_COMP(MbCooldowns),
    MB_COMP(MbRetreat),
    MB_COMP(MbGrab),
    MB_COMP(MbYank),
    MB_COMP(MbRefs),
    MB_COMP(MbBrain),
    MB_COMP(MbInput),
    MB_MARKER(MbFighter),
    /* match */
    MB_COMP(MbClock),
    MB_COMP(MbRng),
    MB_COMP(MbPair),
    MB_COMP(MbCross),
    MB_COMP(MbFinisher),
    MB_COMP(MbOutcome),
    MB_COMP(MbHazards),
    MB_MARKER(MbMatch)
};

const int mb_schema_count = (int)(sizeof(mb_schema) / sizeof(MbCompDesc));
/* MONKEY BAITING - the pure step functions. See mb_step.h for the contract.
 *
 * SCOPE. The whole fight is here: locomotion, the attack state machine, hit
 * resolution (block / stance / armor / clean), grabs, the chain yank,
 * hazards, THE CROSS, the finisher, separation, the KO fall, and all five AI
 * strategies with their bot tables - including `perfect`, which plays a
 * solved policy loaded host-side by mb_perfect.c and reaches here read-only
 * through MbBatch.perfect. An entrant that would roll it without its pair's
 * policy is refused before any match is queued, never silently demoted.
 *
 * NO NUMBER IS AUTHORED HERE. Every gameplay constant arrives through
 * MbRules (app.yaml) or MbChar/MbMove (data/characters/*.yaml). Root
 * CLAUDE.md decision 12: a missing value fails the load, it is never
 * defaulted in code.
 *
 * The RNG draw order is the determinism contract, documented in
 * ../../CLAUDE.md ("The draw contract"). Read it before moving a draw.
 *
 * Reference: web/monkey-baiting/logic.js. It is a read-only reference for
 * BEHAVIOUR, not an oracle: where its float arithmetic and this fixed-point
 * contract disagree, fixed point wins (architecture spec ruling 7).
 *
 * Nothing here calls libc, allocates, recurses, or touches a global. */
#include <stddef.h> /* size_t (freestanding, like stdint.h; MSVC pulled it in transitively, clang/emcc does not) */
#include "mb_step.h"
#include "mb_rng.h"

/* ---------------------------------------------------------- accessors */

MB_LOCAL const MbChar *mb_char(const MbBatch *b, int fi) {
    return &b->rules->chars.c[b->refs[fi].char_id];
}

MB_LOCAL mb_fp mb_max_health(const MbBatch *b, int fi) {
    return mb_char(b, fi)->max_health;
}

/* The move a fighter is currently committed to, or NULL. */
MB_LOCAL const MbMove *mb_cur_move(const MbBatch *b, int fi) {
    int k = b->move_slot[fi].move_key;
    if (k < 0 || k >= MB_MOVE_KEYS) return 0;
    return &mb_char(b, fi)->moves[k];
}

MB_LOCAL int mb_busy(const MbBatch *b, int fi) {
    int s = b->fsm[fi].state;
    return s == MB_ST_ATTACK || s == MB_ST_STUN || s == MB_ST_KO ||
           s == MB_ST_DOWN || s == MB_ST_GRAB_HOLD || s == MB_ST_GRABBED ||
           s == MB_ST_DAZED || s == MB_ST_FINISH || s == MB_ST_FINISH_VICTIM;
}

MB_LOCAL int mb_grounded(const MbBatch *b, int fi) {
    mb_fp eps = b->rules->ground_epsilon;
    return b->body[fi].y <= eps && b->body[fi].vy >= -eps;
}

/* Attack phase: 0 = windup, 1 = active, 2 = recovery, -1 = not attacking. */
MB_LOCAL int mb_attack_phase(const MbBatch *b, int fi) {
    const MbMove *mv;
    if (b->fsm[fi].state != MB_ST_ATTACK) return -1;
    mv = mb_cur_move(b, fi);
    if (!mv || !mv->present) return -1;
    if (b->fsm[fi].t < mv->startup) return 0;
    if (b->fsm[fi].t < mv->startup + mv->active) return 1;
    return 2;
}

/* Signed horizontal gap between the two hurtboxes of a match, always >= the
 * negative overlap. Mirrors logic.js `dist`. */
MB_LOCAL mb_fp mb_gap(const MbBatch *b, int m, int side) {
    int f0 = MB_F(m, side), f1 = MB_F(m, 1 - side);
    mb_fp d = mb_abs(b->body[f1].x - b->body[f0].x);
    return d - ((mb_char(b, f0)->hurt_w + mb_char(b, f1)->hurt_w) / 2);
}

typedef struct { mb_fp x, y, w, h; } MbRect;

MB_LOCAL MbRect mb_hurtbox(const MbBatch *b, int fi) {
    const MbChar *c = mb_char(b, fi);
    MbRect r;
    r.x = b->body[fi].x - c->hurt_w / 2;
    r.y = -b->body[fi].y - c->hurt_h;   /* y axis: 0 at floor, negative = up */
    r.w = c->hurt_w;
    r.h = c->hurt_h;
    return r;
}

MB_LOCAL MbRect mb_hitbox(const MbBatch *b, int fi, const MbMove *mv) {
    MbRect r;
    r.x = b->fsm[fi].facing > 0 ? b->body[fi].x + mv->hb_x
                                : b->body[fi].x - mv->hb_x - mv->hb_w;
    r.y = mv->hb_y - b->body[fi].y;
    r.w = mv->hb_w;
    r.h = mv->hb_h;
    return r;
}

MB_LOCAL int mb_overlap(MbRect a, MbRect c) {
    return a.x < c.x + c.w && c.x < a.x + a.w &&
           a.y < c.y + c.h && c.y < a.y + a.h;
}

/* ------------------------------------------------ accumulating divisions */

/* Per-frame damage of `numerator / denom_frames`, applied exactly.
 * MbVitals.chip_residual carries the UNAPPLIED numerator, so after N frames
 * the total taken is (N * numerator - residual) / denom - never N
 * independently rounded quotients (components/README.md). */
MB_FN void mb_chip_apply(MbVitals *v, mb_fp numerator, int32_t denom) {
    int64_t acc, whole;
    if (denom <= 0) return;              /* loader rejects this; belt and braces */
    acc = (int64_t)v->chip_residual + (int64_t)numerator;
    whole = acc / denom;
    v->chip_residual = (mb_fp)(acc - whole * denom);
    if (whole != 0) {
        v->hp -= (mb_fp)whole;
        v->took_damage = 1;
    }
}

MB_LOCAL void mb_chip(MbBatch *b, int fi, mb_fp numerator, int32_t denom) {
    mb_chip_apply(&b->vitals[fi], numerator, denom);
}

/* --------------------------------------------------------- ring clamps */

MB_LOCAL void mb_clamp_x(MbBatch *b, int fi) {
    const MbRules *r = b->rules;
    const MbChar *c = mb_char(b, fi);
    mb_fp half = c->hurt_w / 2;
    mb_fp lo = mb_from_int(r->ring_left) + half;
    mb_fp hi = mb_from_int(r->ring_right) - half;
    b->body[fi].x = mb_clamp(b->body[fi].x, lo, hi);
}

/* ------------------------------------------------------- slot lifecycle */

MB_FN void mb_k_reset_fighter(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side);
    MbBody *bo = &b->body[fi];
    MbVitals *v = &b->vitals[fi];
    MbFsm *f = &b->fsm[fi];
    int i;

    bo->x = mb_from_int(side == 0 ? r->ring_center - r->ring_start_offset
                                  : r->ring_center + r->ring_start_offset);
    bo->y = 0; bo->vx = 0; bo->vy = 0;

    v->hp = mb_max_health(b, fi);
    /* damage_mult persists across rounds only through the odds-flip rule,
     * which re-applies it in mb_k_start_round; reset it here. */
    v->damage_mult = MB_FP_ONE;
    v->chip_residual = 0;
    v->took_damage = 0;
    v->low_announced = 0;

    f->state = MB_ST_IDLE;
    f->t = 0; f->stun_t = 0; f->dazed_t = 0;
    f->invuln_frames = 0; f->hit_index = -1;
    f->facing = side == 0 ? 1 : -1;
    f->block_stun = 0; f->prev_jump = 0; f->wall_jumped = 0; f->ripple = 0;
    f->attack_deferred = 0;

    b->move_slot[fi].move_id = -1;
    b->move_slot[fi].move_key = -1;
    b->move_slot[fi].leap_vx = 0;
    b->move_slot[fi].proj_t = 0;

    for (i = 0; i < MB_MAX_MOVES; i++) b->cd[fi].cd[i] = 0;

    b->retreat[fi].dir = 0; b->retreat[fi].t = 0;
    b->grab[fi].t = 0; b->grab[fi].move_id = -1; b->grab[fi].side_foe = -1;
    b->grab[fi].foe = 0;
    b->yank[fi].target = 0; b->yank[fi].speed = 0; b->yank[fi].active = 0;

    b->brain[fi].hold = 0;
    b->brain[fi].bot_hold = 0;
    b->brain[fi].was_busy = 0;
    b->brain[fi].plan_action = -1;
    b->brain[fi].plan_left = 0;
    b->brain[fi].held_input = 0;
    b->brain[fi].policy_kind = -1;
    b->brain[fi].policy_id = -1;
    b->input[fi].bits = 0;
}

MB_FN void mb_k_start_round(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    MbClock *c = &b->clock[m];
    int i, side;

    c->round++;
    b->outcome[m].rounds = c->round;
    c->phase = MB_PHASE_INTRO;
    c->phase_t = r->intro_frames;
    c->timer = r->time_seconds * r->logic_hz;
    c->freeze = 0;
    c->slowmo = 0;
    c->shake = 0;
    c->active = 0;

    b->hazards[m].count = 0;
    for (i = 0; i < MB_HAZARD_CAP; i++) b->hazards[m].t[i] = 0;

    b->finisher[m].window_t = 0;
    b->finisher[m].armed = 0;

    /* used / puss_cross deliberately persist across rounds, as in the JS
     * reference: the cheat is once per MATCH, and ON THE CROSS is permanent
     * once she has been told. */
    b->cross[m].t = 0;
    b->cross[m].window = 0;
    b->cross[m].cheater = -1;
    b->cross[m].victim = -1;

    mb_k_reset_fighter(b, m, 0);
    mb_k_reset_fighter(b, m, 1);

    /* the odds flip is permanent for the match once triggered */
    if (b->cross[m].puss_cross) {
        for (side = 0; side < 2; side++) {
            int fi = MB_F(m, side);
            const MbChar *ch = mb_char(b, fi);
            if (ch->has_odds_flip)
                b->vitals[fi].damage_mult = ch->odds_flip_damage_mult;
        }
    }
}

MB_FN void mb_k_reset_slot(MbBatch *b, int m) {
    MbClock *c = &b->clock[m];
    MbOutcome *o = &b->outcome[m];

    c->frame = 0; c->timer = 0; c->round = 0;
    c->phase = MB_PHASE_EMPTY; c->phase_t = 0;
    c->freeze = 0; c->slowmo = 0; c->shake = 0; c->active = 0;

    o->winner = -1; o->frames = 0; o->rounds = 0; o->tie_rounds = 0;
    o->timeouts = 0; o->finishers = 0; o->capped = 0; o->drawn = 0;

    b->cross[m].used = 0;
    b->cross[m].puss_cross = 0;
    b->finisher[m].done = 0;
    b->finisher[m].rearm = 0;
    b->hazards[m].count = 0;

    b->refs[MB_F(m, 0)].rounds_won = 0;
    b->refs[MB_F(m, 1)].rounds_won = 0;
}

MB_FN void mb_k_begin_match(MbBatch *b, int m) {
    mb_k_reset_slot(b, m);
    mb_k_start_round(b, m);   /* round 1, intro */
}

/* ------------------------------------------------------------- helpers */

/* Round end. winner_side < 0 means a DRAWN round: no fall to either side,
 * and an extra round is played (capped by max_rounds_per_match). */
MB_LOCAL void mb_end_round(MbBatch *b, int m, int winner_side, int was_ko) {
    const MbRules *r = b->rules;
    MbClock *c = &b->clock[m];

    if (winner_side >= 0) b->refs[MB_F(m, winner_side)].rounds_won++;
    else b->outcome[m].tie_rounds++;

    c->phase = MB_PHASE_ROUNDEND;
    c->phase_t = r->end_frames + (was_ko ? r->ko_slowmo_frames : 0);
    c->active = 0;
    b->finisher[m].window_t = 0;
    b->finisher[m].armed = 0;
}

/* The fall itself: state plus the sprawl. Shared by single and double KO. */
MB_LOCAL void mb_ko_fall(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side);
    b->vitals[fi].hp = 0;
    b->fsm[fi].state = MB_ST_KO;
    b->fsm[fi].t = 0;
    b->body[fi].vy = r->ko_fall_vy;
    b->body[fi].vx = -b->fsm[fi].facing * r->ko_fall_vx;
    b->body[fi].y = mb_max(b->body[fi].y, r->air_epsilon);
}

/* Knockback slide and gravity only, during the round-end lull. */
MB_LOCAL void mb_physics_only(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    int side;
    for (side = 0; side < 2; side++) {
        int fi = MB_F(m, side);
        MbBody *bo = &b->body[fi];
        if (bo->y > 0 || bo->vy < 0) {
            bo->vy += mb_char(b, fi)->gravity;
            bo->y = mb_max(0, bo->y - bo->vy);
            if (bo->y <= 0 && bo->vy > 0) {
                bo->vy = 0;
                if (b->fsm[fi].state == MB_ST_KO) b->fsm[fi].state = MB_ST_DOWN;
            }
        }
        bo->x += bo->vx;
        bo->vx = mb_mul(bo->vx, r->idle_vx_decay);
        mb_clamp_x(b, fi);
        b->fsm[fi].t++;
    }
}

/* ROUNDEND expiry: take the match, cap it as a draw, or play another round. */
MB_LOCAL void mb_round_transition(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    MbClock *c = &b->clock[m];
    MbOutcome *o = &b->outcome[m];
    int rw0 = b->refs[MB_F(m, 0)].rounds_won;
    int rw1 = b->refs[MB_F(m, 1)].rounds_won;
    int w = r->wins_to_take_match;

    if (rw0 >= w || rw1 >= w) {
        c->phase = MB_PHASE_END;
        o->winner = (rw0 >= w) ? 0 : 1;
        o->drawn = 0;
    } else if (c->round >= r->max_rounds_per_match) {
        /* the cap: drawn rounds bought no falls, so nobody takes the match */
        c->phase = MB_PHASE_END;
        o->winner = -1;
        o->drawn = 1;
    } else {
        mb_k_start_round(b, m);
        return;
    }
    o->frames = c->frame;
    o->finishers = b->finisher[m].done ? 1 : 0;
}

/* ------------------------------------------------------ move lifecycle */

MB_LOCAL void mb_start_move(MbBatch *b, int m, int side, int key) {
    int fi = MB_F(m, side);
    const MbMove *mv = &mb_char(b, fi)->moves[key];

    b->fsm[fi].state = MB_ST_ATTACK;
    b->fsm[fi].t = 0;
    b->fsm[fi].hit_index = -1;
    b->move_slot[fi].move_key = key;
    b->move_slot[fi].move_id = key;
    b->cd[fi].cd[key] = mv->cooldown;
    if (mv->type == MB_MT_RETREAT) {
        /* back to his own edge of the ring */
        b->retreat[fi].dir = (side == 0) ? -1 : 1;
        b->move_slot[fi].proj_t = 0;
    }
}

MB_LOCAL void mb_end_move(MbBatch *b, int fi) {
    b->fsm[fi].state = MB_ST_IDLE;
    b->fsm[fi].t = 0;
    b->move_slot[fi].move_key = -1;
    b->move_slot[fi].move_id = -1;
}

/* ------------------------------------------------------ hit resolution */

MB_LOCAL void mb_trigger_finisher(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    int f0 = MB_F(m, 0), f1 = MB_F(m, 1);
    b->clock[m].phase = MB_PHASE_FINISHER;
    b->clock[m].phase_t = r->finisher_cinematic_frames;
    b->clock[m].active = 0;
    b->finisher[m].armed = 0;
    b->finisher[m].window_t = 0;
    mb_end_move(b, f0);
    b->fsm[f0].state = MB_ST_FINISH;
    b->fsm[f0].t = 0;
    b->body[f0].y = 0; b->body[f0].vy = 0; b->body[f0].vx = 0;
    b->body[f1].y = 0; b->body[f1].vy = 0; b->body[f1].vx = 0;
    b->fsm[f1].state = MB_ST_FINISH_VICTIM; b->fsm[f1].t = 0;
}

MB_LOCAL void mb_break_cross(MbBatch *b, int m, int breaker_side,
                           int cheater_side) {
    const MbRules *r = b->rules;
    int bf = MB_F(m, breaker_side), cf = MB_F(m, cheater_side);
    const MbChar *ch = mb_char(b, cf);

    b->vitals[cf].hp -= ch->cross_break_bonus_damage;
    b->vitals[cf].took_damage = 1;
    b->fsm[cf].state = MB_ST_STUN;
    b->fsm[cf].stun_t = ch->cross_break_stagger_frames;
    b->fsm[cf].t = 0;
    b->fsm[cf].block_stun = 0;
    b->body[cf].vx = b->fsm[bf].facing * r->cross_break_vx;
    b->cross[m].t = 0;
    b->cross[m].window = 0;
    b->cross[m].cheater = -1;
    b->cross[m].victim = -1;
    b->clock[m].freeze = r->cross_break_freeze;
    b->clock[m].shake = r->cross_break_shake;
}

/* Post-exchange consequences shared by every hit outcome. */
MB_LOCAL void mb_on_exchange(MbBatch *b, int m, int att_side, int vic_side) {
    int side;
    for (side = 0; side < 2; side++) {
        int fi = MB_F(m, side);
        const MbChar *c = mb_char(b, fi);
        if (side != att_side && side != vic_side) continue;
        if (c->post_exchange_retreat > 0) {
            b->retreat[fi].dir = (side == 0) ? -1 : 1;
            b->retreat[fi].t = c->post_exchange_retreat;
        }
    }
    /* the odds flip: at its health threshold, this fighter has been told to
     * lose slowly. Once per match, and permanent. */
    if (!b->cross[m].puss_cross) {
        for (side = 0; side < 2; side++) {
            int fi = MB_F(m, side);
            const MbChar *c = mb_char(b, fi);
            if (!c->has_odds_flip) continue;
            if (b->vitals[fi].hp <= c->odds_flip_health_abs) {
                b->cross[m].puss_cross = 1;
                b->vitals[fi].damage_mult = c->odds_flip_damage_mult;
                break;
            }
        }
    }
}

/* Applies one landed hit of `mv` from att_side to vic_side. */
MB_LOCAL void mb_resolve_hit(MbBatch *b, int m, int att_side, int vic_side,
                           const MbMove *mv) {
    const MbRules *r = b->rules;
    int af = MB_F(m, att_side), vf = MB_F(m, vic_side);
    const MbChar *vc = mb_char(b, vf);
    const MbMove *vmv;
    mb_fp dmg, dir_fp;
    int dir, blocking, armored = 0;
    mb_fp armor_ratio = MB_FP_ONE;

    if (b->fsm[vf].invuln_frames > 0 || b->fsm[vf].state == MB_ST_KO ||
        b->fsm[vf].state == MB_ST_DOWN) return;

    /* the finisher: landing your named move inside the window triggers it */
    if (b->finisher[m].armed && att_side == 0 && vic_side == 1 &&
        b->move_slot[af].move_key == mb_char(b, af)->finisher_move) {
        mb_trigger_finisher(b, m);
        return;
    }
    /* THE CROSS breaks if its victim lands their own signature move on the
     * cheat */
    if (b->cross[m].window > 0 && att_side == b->cross[m].victim &&
        vic_side == b->cross[m].cheater &&
        b->move_slot[af].move_key == mb_char(b, af)->finisher_move) {
        mb_break_cross(b, m, att_side, vic_side);
        return;
    }

    dir = b->body[vf].x >= b->body[af].x ? 1 : -1;
    dir_fp = mb_from_int(dir);
    dmg = mb_mul(mv->damage, b->vitals[af].damage_mult);

    blocking = (b->fsm[vf].state == MB_ST_BLOCK ||
                (b->fsm[vf].state == MB_ST_STUN && b->fsm[vf].block_stun)) &&
               mb_grounded(b, vf) && !mv->unblockable;
    if (blocking) {
        b->vitals[vf].hp -= mb_mul(dmg, r->block_chip_ratio);
        b->vitals[vf].took_damage = 1;
        b->fsm[vf].state = MB_ST_STUN;
        b->fsm[vf].stun_t = mv->blockstun;
        b->fsm[vf].block_stun = 1;
        b->fsm[vf].t = 0;
        b->body[vf].vx = mb_mul(dir_fp,
                                mb_mul(mv->pushback_block, r->pushback_block_scale));
        if (b->clock[m].freeze < r->block_freeze)
            b->clock[m].freeze = r->block_freeze;
        mb_on_exchange(b, m, att_side, vic_side);
        return;
    }

    /* stance (Brock's Barrel Set): takes a fraction, returns half */
    vmv = mb_cur_move(b, vf);
    if (b->fsm[vf].state == MB_ST_ATTACK && vmv && vmv->type == MB_MT_STANCE &&
        mb_attack_phase(b, vf) == 1) {
        b->vitals[vf].hp -= mb_mul(dmg, vmv->stance_take_ratio);
        b->vitals[vf].took_damage = 1;
        b->vitals[af].hp -= mb_mul(dmg, vmv->stance_return_ratio);
        b->vitals[af].took_damage = 1;
        b->fsm[af].state = MB_ST_STUN;
        b->fsm[af].stun_t = r->stance_attacker_stun;
        b->fsm[af].block_stun = 0;
        b->fsm[af].t = 0;
        b->body[af].vx = -dir * r->stance_attacker_vx;
        if (b->clock[m].freeze < r->stance_freeze)
            b->clock[m].freeze = r->stance_freeze;
        if (b->clock[m].shake < r->stance_shake)
            b->clock[m].shake = r->stance_shake;
        mb_on_exchange(b, m, att_side, vic_side);
        return;
    }

    /* armour */
    if (b->fsm[vf].state == MB_ST_ATTACK && vmv) {
        if (vmv->has_armor_frames && b->fsm[vf].t >= vmv->armor_from &&
            b->fsm[vf].t <= vmv->armor_to) {
            armored = 1;
            armor_ratio = vmv->armor_damage_ratio;
        }
        if (vmv->has_armor_health && b->vitals[vf].hp > vmv->armor_health_abs &&
            mb_attack_phase(b, vf) == 1) {
            armored = 1;
            armor_ratio = MB_FP_ONE;
        }
    }
    if (armored) {
        b->vitals[vf].hp -= mb_mul(dmg, armor_ratio);
        b->vitals[vf].took_damage = 1;
        if (b->clock[m].freeze < r->armor_freeze)
            b->clock[m].freeze = r->armor_freeze;
        mb_on_exchange(b, m, att_side, vic_side);
        return;
    }

    /* clean hit */
    {
        mb_fp remaining, kb, vy;
        b->vitals[vf].hp -= dmg;
        b->vitals[vf].took_damage = 1;
        remaining = MB_FP_ONE - mb_div(mb_max(0, b->vitals[vf].hp),
                                       vc->max_health);
        kb = mb_div(mb_mul(mv->base_knockback +
                               mb_mul(mv->knockback_growth, remaining),
                           r->knockback_scale),
                    vc->weight);
        b->body[vf].vx = mb_mul(dir_fp,
                                mb_mul(mv->launch_cos, kb) +
                                mb_mul(mv->pushback_hit, r->pushback_hit_scale));
        vy = mb_mul(mb_mul(mv->launch_sin, kb), r->knockback_vy_scale);
        if (vy > r->launch_vy_threshold && mb_grounded(b, vf)) {
            b->body[vf].vy = -vy;
            b->body[vf].y = r->air_epsilon;
        }
        b->fsm[vf].state = MB_ST_STUN;
        b->fsm[vf].stun_t = mv->hitstun;
        b->fsm[vf].block_stun = 0;
        b->fsm[vf].t = 0;
        b->move_slot[vf].move_key = -1;
        b->move_slot[vf].move_id = -1;
        if (b->clock[m].freeze < mv->hit_freeze)
            b->clock[m].freeze = mv->hit_freeze;
        if (b->clock[m].shake < mv->shake) b->clock[m].shake = mv->shake;
    }
    mb_on_exchange(b, m, att_side, vic_side);
}

/* ---------------------------------------------------------------- AI */

/* Presses that survive between decision frames: directions and block. */
MB_LOCAL uint32_t mb_drop_presses(uint32_t in) {
    return in & ~(uint32_t)MB_IN_PRESSES;
}

MB_LOCAL uint32_t mb_toward(const MbBatch *b, int m, int side) {
    int f0 = MB_F(m, side), f1 = MB_F(m, 1 - side);
    return b->body[f1].x > b->body[f0].x ? MB_IN_RIGHT : MB_IN_LEFT;
}

MB_LOCAL uint32_t mb_away(const MbBatch *b, int m, int side) {
    return mb_toward(b, m, side) == MB_IN_RIGHT ? MB_IN_LEFT : MB_IN_RIGHT;
}

MB_LOCAL uint32_t mb_press_bit(const MbMove *mv, int key) {
    if (mv->input_bit) return mv->input_bit;
    switch (key) {
    case MB_MK_LIGHT:       return MB_IN_LIGHT;
    case MB_MK_HEAVY:       return MB_IN_HEAVY;
    case MB_MK_SPECIAL:     return MB_IN_SPECIAL;
    case MB_MK_STAKES_DOWN: return MB_IN_STAKES_DOWN;
    default:                return 0;
    }
}

MB_LOCAL int mb_ready(const MbBatch *b, int fi, int key) {
    return b->cd[fi].cd[key] <= 0;
}

/* The tuned house AI. Draw order is fixed and documented: dodge, block,
 * stance, stakes-down, special, heavy, light, spacing, jump. Every draw is
 * taken only when its guard passes, exactly as written here. */
MB_LOCAL uint32_t mb_policy_default(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    const MbChar *c = mb_char(b, fi);
    const MbMove *fmv;
    uint32_t *rng = &b->rng[m].state;
    uint32_t in = 0;
    mb_fp dist;
    int foe_winding;

    if (!c->has_ai) return 0;
    if (mb_busy(b, fi) && b->fsm[fi].state != MB_ST_ATTACK) return 0;

    dist = mb_gap(b, m, side);
    fmv = mb_cur_move(b, oi);
    foe_winding = b->fsm[oi].state == MB_ST_ATTACK && mb_attack_phase(b, oi) == 0;

    /* dodge the chain yank: be airborne when it fires */
    if (foe_winding && fmv && fmv->type == MB_MT_CHAIN_YANK &&
        mb_grounded(b, fi) && mb_rng_chance(rng, r->ai_yank_dodge_chance_q32))
        return MB_IN_JUMP;

    if (foe_winding && dist < c->poke_range + r->ai_block_range_bonus &&
        mb_rng_chance(rng, c->block_chance_q32))
        return MB_IN_BLOCK;

    /* answer pressure with a stance */
    if (c->has_stance_chance && b->fsm[oi].state == MB_ST_ATTACK &&
        dist < r->ai_stance_range && mb_rng_chance(rng, c->stance_chance_q32) &&
        mb_ready(b, fi, MB_MK_HEAVY) && c->moves[MB_MK_HEAVY].present)
        return MB_IN_HEAVY;

    /* step out of the ring when pressed */
    if (c->has_stakes_down_health && c->moves[MB_MK_STAKES_DOWN].present &&
        b->vitals[fi].hp < c->stakes_down_health_abs &&
        dist < r->ai_stakes_down_range && mb_ready(b, fi, MB_MK_STAKES_DOWN) &&
        mb_rng_chance(rng, r->ai_stakes_down_roll_q32))
        return mb_press_bit(&c->moves[MB_MK_STAKES_DOWN], MB_MK_STAKES_DOWN);

    if (c->moves[MB_MK_SPECIAL].present && dist >= c->special_min_range &&
        dist <= c->special_max_range && mb_ready(b, fi, MB_MK_SPECIAL) &&
        mb_rng_chance(rng, c->special_chance_q32))
        return MB_IN_SPECIAL;

    if (c->moves[MB_MK_HEAVY].present) {
        int heavy_ok = mb_ready(b, fi, MB_MK_HEAVY);
        if (c->moves[MB_MK_HEAVY].type == MB_MT_CHAIN_YANK) {
            if (heavy_ok && dist > r->ai_yank_min_range && mb_grounded(b, oi) &&
                mb_rng_chance(rng, r->ai_yank_use_chance_q32))
                return MB_IN_HEAVY;
        } else if (heavy_ok && dist < c->poke_range + r->ai_heavy_range_bonus &&
                   mb_rng_chance(rng, c->heavy_chance_q32)) {
            return MB_IN_HEAVY;
        }
    }

    if (c->moves[MB_MK_LIGHT].present && dist < c->poke_range &&
        mb_rng_chance(rng, c->light_chance_q32))
        return MB_IN_LIGHT;

    /* spacing */
    if (c->has_keep_range && dist < c->keep_range - r->ai_keep_range_margin) {
        in |= mb_away(b, m, side);
    } else if (dist > c->poke_range - r->ai_poke_margin) {
        in |= mb_rng_chance(rng, c->retreat_chance_q32) ? mb_away(b, m, side)
                                                        : mb_toward(b, m, side);
    } else if (mb_rng_chance(rng, c->retreat_chance_q32)) {
        in |= mb_away(b, m, side);
    }
    if (mb_rng_chance(rng, c->jump_chance_q32)) in |= MB_IN_JUMP;
    return in;
}

/* spam(move): walk in until the move can reach, then use only that move on
 * cooldown. Never blocks, never jumps. Consumes no draws at all. */
MB_LOCAL uint32_t mb_policy_spam(MbBatch *b, int m, int side, int key) {
    int fi = MB_F(m, side);
    const MbChar *c = mb_char(b, fi);
    const MbMove *mv = &c->moves[key];
    mb_fp dist;

    if (!mv->present) return 0;
    dist = mb_gap(b, m, side);
    if (mb_ready(b, fi, key) && dist <= mv->reach)
        return mb_press_bit(mv, key);
    return mb_toward(b, m, side);
}

/* passive: never attacks. One draw for the block reaction when a threat is
 * winding up, then pure spacing. */
MB_LOCAL uint32_t mb_policy_passive(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    uint32_t *rng = &b->rng[m].state;
    mb_fp dist;

    if (mb_busy(b, fi)) return 0;
    if (b->fsm[oi].state == MB_ST_ATTACK && mb_attack_phase(b, oi) == 0 &&
        mb_rng_chance(rng, r->strat.passive_block_chance_q32))
        return MB_IN_BLOCK;
    if (r->strat.passive_distance <= 0) return 0;
    dist = mb_gap(b, m, side);
    if (dist < r->strat.passive_distance - r->strat.passive_near_margin)
        return mb_away(b, m, side);
    if (dist > r->strat.passive_distance + r->strat.passive_far_margin)
        return mb_toward(b, m, side);
    return 0;
}

MB_LOCAL uint32_t mb_apply_pick(const MbBatch *b, int m, int side, int pick) {
    int fi = MB_F(m, side);
    const MbChar *c = mb_char(b, fi);
    if (pick >= MB_PICK_MOVE) {
        int key = pick - MB_PICK_MOVE;
        if (key < 0 || key >= MB_MOVE_KEYS || !c->moves[key].present) return 0;
        return mb_press_bit(&c->moves[key], key);
    }
    switch (pick) {
    case MB_PICK_WALK_TO:   return mb_toward(b, m, side);
    case MB_PICK_WALK_AWAY: return mb_away(b, m, side);
    case MB_PICK_JUMP:      return MB_IN_JUMP;
    case MB_PICK_BLOCK:     return MB_IN_BLOCK;
    default:                return 0;
    }
}

/* uniform-random legal play. Draw order: the attack/movement split, then
 * either the ready-move index or the movement-option index - never both. */
MB_LOCAL uint32_t mb_policy_random(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side);
    const MbChar *c = mb_char(b, fi);
    uint32_t *rng = &b->rng[m].state;
    MbBrain *br = &b->brain[fi];
    int pick;

    if (mb_busy(b, fi)) { br->plan_left = 0; return 0; }
    if (br->plan_left > 0) {
        br->plan_left--;
        return mb_apply_pick(b, m, side, br->plan_action);
    }
    if (mb_rng_chance(rng, r->strat.random_move_weight_q32)) {
        int ready[MB_MOVE_KEYS], n = 0, k;
        for (k = 0; k < MB_MOVE_KEYS; k++)
            if (c->moves[k].present && mb_ready(b, fi, k)) ready[n++] = k;
        pick = n ? (int)MB_PICK_MOVE + ready[mb_rng_below(rng, (uint32_t)n)]
                 : (int)MB_PICK_WAIT;
    } else {
        /* the movement options, in this fixed order */
        static const int opts[5] = { MB_PICK_WALK_TO, MB_PICK_WALK_AWAY,
                                     MB_PICK_JUMP, MB_PICK_BLOCK, MB_PICK_WAIT };
        pick = opts[mb_rng_below(rng, 5u)];
    }
    br->plan_action = pick;
    br->plan_left = r->strat.random_interval - 1;
    return mb_apply_pick(b, m, side, pick);
}

/* ------------------------------------------------ perfect-policy playback
 *
 * Plays a solved equilibrium policy (MbPolicy, state encoding 3). The
 * reference is web/monkey-baiting/logic.js makePerfectPolicy; the INDEX
 * ARITHMETIC BELOW IS THE CONTRACT, not that reference's float form.
 *
 * THE BUCKETING CONTRACT. Both quantized distances index the policy table,
 * so a one-unit disagreement selects a different action. Both are therefore
 * computed in DOUBLED Q16.16 units, which is what makes them exact: the two
 * halvings the reference performs in floating point (half the summed hurtbox
 * widths for the gap, half a hurtbox width for the retreat room) would each
 * truncate 1/65536 px in fixed point and could tip a bucket boundary. In
 * doubled units they never happen at all.
 *
 *   gap2  = 2*|x_foe - x_self| - (w_self + w_foe)
 *   gq    = clamp( floor( (gap2 + gapStep*2^16) / (gapStep*2^17) ),
 *                  0, gapBuckets-1 )
 *   back2 = 2*x_self - w_self - 2*ringLeft      (foe is to the right)
 *         | 2*ringRight - 2*x_self - w_self     (foe is to the left)
 *   bb    = min( floor( max(0, back2) / (backStep*2^17) ), backBuckets-1 )
 *
 * The gap form is the reference's round-half-up written as a floor, since
 * floor(g/s + 1/2) == floor((2g + s)/(2s)); the back form is a plain floor
 * of a non-negative quotient, so C truncation IS the floor. No division is
 * inexact and no intermediate is rounded, so the bucket a state falls in is
 * a function of the integer state alone. */

MB_FN int mb_perfect_gap_bucket(const MbBatch *b, int m, int side,
                                const MbPolicy *p) {
    int f0 = MB_F(m, side), f1 = MB_F(m, 1 - side);
    mb_fp gap2 = mb_abs(b->body[f1].x - b->body[f0].x) * 2
               - (mb_char(b, f0)->hurt_w + mb_char(b, f1)->hurt_w);
    int32_t num = gap2 + (p->gap_step << MB_FP_SHIFT);
    int32_t q;
    if (num <= 0) return 0;                    /* floor <= 0, then clamped */
    q = num / (p->gap_step << (MB_FP_SHIFT + 1));
    return q >= p->gap_buckets ? p->gap_buckets - 1 : q;
}

/* Retreat room behind `who`: the distance from his back edge to the wall he
 * would back into. Bucketed exactly as the solver buckets it. */
MB_FN int mb_perfect_back_bucket(const MbBatch *b, int who, int foe,
                                 const MbPolicy *p) {
    const MbRules *r = b->rules;
    mb_fp xw = b->body[who].x, w = mb_char(b, who)->hurt_w;
    mb_fp back2 = b->body[foe].x > xw
                ? xw * 2 - w - mb_from_int(r->ring_left) * 2
                : mb_from_int(r->ring_right) * 2 - xw * 2 - w;
    int32_t q;
    if (back2 <= 0) return 0;
    q = back2 / (p->back_step << (MB_FP_SHIFT + 1));
    return q >= p->back_buckets ? p->back_buckets - 1 : q;
}

/* Per-side quantized state: 0 = free, 1..stunQMax = stun, then the committed
 * move ticks. A move the policy does not model reads as free - the solver
 * documents that approximation and the runtime must agree with it. */
MB_FN int mb_perfect_side_state(const MbBatch *b, int fi, const MbPolicy *p) {
    const MbFsm *f = &b->fsm[fi];
    if (f->state == MB_ST_ATTACK) {
        int key = b->move_slot[fi].move_key, tick, qf;
        if (key < 0 || key >= MB_MOVE_KEYS) return 0;
        if (p->foe_mi[key] < 0) return 0;
        qf = p->foe_qf[key];
        tick = f->t / p->fq;
        if (tick > qf - 1) tick = qf - 1;
        if (tick < 0) tick = 0;
        return 1 + p->stun_q_max + p->foe_offset[key] + tick;
    }
    if (f->state == MB_ST_STUN || f->state == MB_ST_GRABBED ||
        f->state == MB_ST_DAZED) {
        int k = f->stun_t ? f->stun_t : (f->dazed_t ? f->dazed_t : 1);
        int q = (k + p->fq - 1) / p->fq - 1;    /* ceil(k / fq) - 1 */
        if (q < 0) q = 0;
        if (q > p->stun_q_max - 1) q = p->stun_q_max - 1;
        return 1 + q;
    }
    return 0;
}

/* The policy table row for one fighter's view of the match. Dimension order,
 * slowest to fastest: gap bucket, the packed pair of retreat-room buckets
 * (SELF first), the self cooldown mask, the foe cooldown mask. */
MB_FN int mb_perfect_row(const MbBatch *b, int m, int side, const MbPolicy *p) {
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    int bb = p->back_buckets, gq, rq, cd0 = 0, cd1 = 0, i;

    gq = mb_perfect_gap_bucket(b, m, side, p);
    rq = mb_perfect_back_bucket(b, fi, oi, p) * bb
       + mb_perfect_back_bucket(b, oi, fi, p);
    for (i = 0; i < p->self_cd_count; i++)
        if (b->cd[fi].cd[p->self_cd_key[i]] > 0) cd0 |= 1 << i;
    for (i = 0; i < p->foe_cd_count; i++)
        if (b->cd[oi].cd[p->foe_cd_key[i]] > 0) cd1 |= 1 << i;
    return ((gq * (bb * bb) + rq) * (1 << p->self_cd_count) + cd0)
           * (1 << p->foe_cd_count) + cd1;
}

MB_LOCAL uint32_t mb_perfect_apply(const MbBatch *b, int m, int side, int a) {
    const MbPolicyAction *act =
        &MB_POLICY_AT(b->perfect, b->refs[MB_F(m, side)].char_id,
                      b->refs[MB_F(m, 1 - side)].char_id)->action[a];
    switch (act->kind) {
    case MB_PACT_MOVE: {
        const MbChar *c = mb_char(b, MB_F(m, side));
        if (!c->moves[act->move_key].present) return 0;
        return mb_press_bit(&c->moves[act->move_key], act->move_key);
    }
    case MB_PACT_WALK_TO:   return mb_toward(b, m, side);
    case MB_PACT_WALK_AWAY: return mb_away(b, m, side);
    case MB_PACT_BLOCK:     return MB_IN_BLOCK;
    case MB_PACT_JUMP:      return MB_IN_JUMP;
    default:                return 0;   /* wait: no input at all */
    }
}

/* THE DRAW: exactly one u32 per decision, and only when the foe's quantized
 * side state is FREE. A committed or stunned foe is answered by a pure best
 * response out of vs_committed, which consumes no randomness at all. Frames
 * on which the fighter is not actionable, and frames inside a held plan,
 * decide nothing and draw nothing. */
MB_LOCAL uint32_t mb_policy_perfect(MbBatch *b, int m, int side) {
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    MbBrain *br = &b->brain[fi];
    int st = b->fsm[fi].state;
    const MbPolicy *p;
    int row, s1, a;

    /* The plan survives the states the plan itself causes; anything else
     * (attacking, stunned, KO'd) drops it. */
    if (st != MB_ST_IDLE && st != MB_ST_WALK && st != MB_ST_BLOCK &&
        st != MB_ST_JUMP) {
        br->plan_left = 0;
        return 0;
    }
    if (br->plan_left > 0) {
        br->plan_left--;
        return mb_perfect_apply(b, m, side, br->plan_action);
    }

    p = MB_POLICY_AT(b->perfect, b->refs[fi].char_id, b->refs[oi].char_id);
    /* Unreachable: mb_world_set_queue refuses a queue whose entrants can roll
     * `perfect` without the pair's policy loaded. Guarded, not defaulted -
     * there is no other action this could take without inventing one. */
    if (!p->present) return 0;

    row = mb_perfect_row(b, m, side, p);
    s1 = mb_perfect_side_state(b, oi, p);
    if (s1 == 0) {
        const uint32_t *cdf = p->cdf + (size_t)row * (size_t)p->n_actions;
        uint32_t r = mb_rng_next(&b->rng[m].state);
        for (a = 0; a < p->n_actions; a++)
            if (r < cdf[a]) break;
        if (a >= p->n_actions) a = p->n_actions - 1;   /* rounding residue */
    } else {
        a = p->vs_committed[(size_t)row * (size_t)(p->foe_states - 1)
                            + (size_t)(s1 - 1)];
    }

    /* The quantized cooldown flag can disagree with the real timer near its
     * end. Pressing a locked button would no-op and re-decide the same way
     * next frame, so walk instead - the reference's guard, kept. */
    if (p->action[a].kind == MB_PACT_MOVE &&
        !mb_ready(b, fi, p->action[a].move_key)) {
        a = p->walk_to_action;
        br->plan_left = b->rules->strat.perfect_hold_cd_miss;
    } else {
        br->plan_left = p->action[a].hold;
    }
    br->plan_action = a;
    return mb_perfect_apply(b, m, side, a);
}

/* Decision cadence, in frames, of one strategy. */
MB_LOCAL int mb_strategy_interval(const MbBatch *b, int kind) {
    switch (kind) {
    case MB_POLICY_DEFAULT: return b->rules->ai_decision_interval;
    case MB_POLICY_RANDOM:  return 1;   /* the strategy paces itself */
    case MB_POLICY_SPAM:    return 1;
    case MB_POLICY_PASSIVE: return 1;
    case MB_POLICY_PERFECT: return 1;   /* self-paced by the action hold */
    default:                return 1;
    }
}

/* Proximity gate of one bot component. */
MB_LOCAL int mb_comp_eligible(const MbBatch *b, int m, int side,
                            const MbBotComp *c) {
    int fi = MB_F(m, side);
    mb_fp gap;
    if (!c->gated) return 1;
    gap = mb_gap(b, m, side);
    if (c->has_within) {
        mb_fp lim = c->within;
        if (c->within_is_reach) {
            const MbChar *ch = mb_char(b, fi);
            if (c->move_key < 0 || !ch->moves[c->move_key].present) return 0;
            lim = ch->moves[c->move_key].reach;
        }
        if (gap > lim) return 0;
    }
    if (c->has_beyond && gap < c->beyond) return 0;
    return 1;
}

/* Rolls the bot table for one fighter. Exactly ONE draw, and only when the
 * bot can actually branch (see the draw contract). */
MB_LOCAL void mb_roll_bot(MbBatch *b, int m, int side) {
    const MbBot *bot = &b->rules->bots.bot[b->brain[MB_F(m, side)].bot_id];
    int fi = MB_F(m, side);
    MbBrain *br = &b->brain[fi];
    int i, chosen = bot->fallback, total = 0;

    if (bot->pure) {
        chosen = 0;
    } else {
        for (i = 0; i < bot->count; i++)
            if (mb_comp_eligible(b, m, side, &bot->comp[i]))
                total += bot->comp[i].weight;
        if (total <= 0) {
            chosen = bot->fallback;
        } else {
            uint32_t roll = mb_rng_below(&b->rng[m].state, (uint32_t)total);
            int acc = 0;
            chosen = bot->fallback;
            for (i = 0; i < bot->count; i++) {
                if (!mb_comp_eligible(b, m, side, &bot->comp[i])) continue;
                acc += bot->comp[i].weight;
                if ((int)roll < acc) { chosen = i; break; }
            }
        }
    }
    br->policy_kind = bot->comp[chosen].kind;
    br->policy_id = bot->comp[chosen].move_key;
    br->bot_hold = b->rules->bots.hold_frames;
    br->plan_left = 0;
    br->hold = 0;
}

MB_LOCAL uint32_t mb_run_strategy(MbBatch *b, int m, int side) {
    MbBrain *br = &b->brain[MB_F(m, side)];
    switch (br->policy_kind) {
    case MB_POLICY_DEFAULT: return mb_policy_default(b, m, side);
    case MB_POLICY_SPAM:    return mb_policy_spam(b, m, side, br->policy_id);
    case MB_POLICY_RANDOM:  return mb_policy_random(b, m, side);
    case MB_POLICY_PASSIVE: return mb_policy_passive(b, m, side);
    case MB_POLICY_PERFECT: return mb_policy_perfect(b, m, side);
    default:                return 0;
    }
}

/* ------------------------------------------------------------- systems */

MB_FN void mb_k_match_phase(MbBatch *b, int m) {
    MbClock *c = &b->clock[m];

    c->active = 0;
    if (c->phase == MB_PHASE_EMPTY || c->phase == MB_PHASE_END ||
        c->phase == MB_PHASE_DONE) return;

    c->frame++;
    if (c->shake > 0) {
        c->shake -= MB_FP_HALF;
        if (c->shake < 0) c->shake = 0;
    }
    if (c->slowmo > 0) c->slowmo--;

    if (c->phase == MB_PHASE_INTRO) {
        if (--c->phase_t <= 0) c->phase = MB_PHASE_FIGHT;
        return;
    }
    if (c->phase == MB_PHASE_ROUNDEND) {
        mb_physics_only(b, m);
        if (--c->phase_t <= 0) mb_round_transition(b, m);
        return;
    }
    if (c->phase == MB_PHASE_FINISHER) {
        if (--c->phase_t <= 0) {
            /* the cinematic resolves: side 1 goes down, side 0 takes the round */
            b->vitals[MB_F(m, 1)].hp = 0;
            b->fsm[MB_F(m, 1)].state = MB_ST_DOWN;
            b->finisher[m].done = 1;
            mb_end_round(b, m, 0, 0);
        }
        return;
    }

    /* fight phase: a hit-freeze frame advances nothing else */
    if (c->freeze > 0) { c->freeze--; return; }
    c->active = 1;
}

MB_FN void mb_k_ai_decide(MbBatch *b, int m) {
    int side;
    if (!b->clock[m].active) return;

    /* Side 0 decides before side 1. Both draw from the same per-match
     * generator, so the ORDER of draws is part of the determinism contract,
     * not an implementation detail. See ../../CLAUDE.md. */
    for (side = 0; side < 2; side++) {
        int fi = MB_F(m, side);
        MbBrain *br = &b->brain[fi];
        int busy_now = mb_busy(b, fi);
        uint32_t in;

        /* 1. the bot table re-rolls when its hold elapses or the fighter's
         *    busy state flips (it just became actionable again). */
        if (br->policy_kind < 0 || br->bot_hold <= 0 ||
            br->was_busy != (mb_bool)busy_now) {
            mb_roll_bot(b, m, side);
        }
        br->bot_hold--;
        br->was_busy = (mb_bool)busy_now;

        /* 2. the chosen strategy decides on its own cadence; between
         *    decisions the last input is replayed with presses dropped. */
        if (br->hold > 0) {
            br->hold--;
            br->held_input = mb_drop_presses(br->held_input);
            b->input[fi].bits = br->held_input;
            continue;
        }
        br->hold = mb_strategy_interval(b, br->policy_kind) - 1;
        in = mb_run_strategy(b, m, side);
        br->held_input = in;
        b->input[fi].bits = in;
    }
}

/* The per-fighter tail: latch the jump edge, advance the clock, clamp to the
 * ring, and run the post-exchange retreat shuffle. Runs exactly once per
 * fighter per frame, in step_fighter or step_attack (never both). */
MB_LOCAL void mb_fighter_tail(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side);
    MbFsm *f = &b->fsm[fi];

    f->prev_jump = (b->input[fi].bits & MB_IN_JUMP) ? 1 : 0;
    f->t++;
    mb_clamp_x(b, fi);

    if (b->retreat[fi].t > 0 &&
        (f->state == MB_ST_IDLE || f->state == MB_ST_WALK)) {
        b->body[fi].x += mb_mul(mb_from_int(b->retreat[fi].dir),
                                mb_mul(mb_char(b, fi)->walk_speed,
                                       r->walk_retreat_ratio));
        b->retreat[fi].t--;
        f->state = MB_ST_WALK;
    }
}

/* idle / walk: the grounded branch of the state machine. */
MB_LOCAL void mb_step_grounded(MbBatch *b, int m, int side) {
    int fi = MB_F(m, side);
    const MbChar *c = mb_char(b, fi);
    MbFsm *f = &b->fsm[fi];
    uint32_t in = b->input[fi].bits;
    int key = -1, k;

    if (in & MB_IN_BLOCK) { f->state = MB_ST_BLOCK; f->t = 0; return; }

    if (in & MB_IN_LIGHT)        key = MB_MK_LIGHT;
    else if (in & MB_IN_HEAVY)   key = MB_MK_HEAVY;
    else if (in & MB_IN_SPECIAL) key = MB_MK_SPECIAL;
    else if ((in & MB_IN_STAKES_DOWN) && c->moves[MB_MK_STAKES_DOWN].present)
        key = MB_MK_STAKES_DOWN;
    else {
        /* moves bound to another button via their YAML `input:` field */
        for (k = 0; k < MB_MOVE_KEYS; k++) {
            const MbMove *mv = &c->moves[k];
            if (!mv->present || !mv->input_bit) continue;
            if (!(in & mv->input_bit)) continue;
            if (mv->input_bit == MB_IN_JUMP && f->prev_jump) continue;
            key = k;
            break;
        }
    }
    if (key >= 0 && c->moves[key].present && mb_ready(b, fi, key)) {
        mb_start_move(b, m, side, key);
        return;
    }

    if ((in & MB_IN_JUMP) && !f->prev_jump) {
        b->body[fi].vy = c->jump_velocity;
        b->body[fi].y = b->rules->air_epsilon;
        f->state = MB_ST_JUMP;
        f->t = 0;
        return;
    }
    if (in & (MB_IN_LEFT | MB_IN_RIGHT)) {
        f->state = MB_ST_WALK;
        b->body[fi].x += (in & MB_IN_RIGHT) ? c->walk_speed : -c->walk_speed;
    } else if (f->state != MB_ST_IDLE) {
        f->state = MB_ST_IDLE;
        f->t = 0;
    }
}

MB_FN void mb_k_fighter(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    int side;
    if (!b->clock[m].active) return;

    for (side = 0; side < 2; side++) {
        int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
        const MbChar *c = mb_char(b, fi);
        MbFsm *f = &b->fsm[fi];
        MbBody *bo = &b->body[fi];
        uint32_t in = b->input[fi].bits;
        int k, entry_state;

        f->attack_deferred = 0;
        if (f->invuln_frames > 0) f->invuln_frames--;
        for (k = 0; k < MB_MAX_MOVES; k++)
            if (b->cd[fi].cd[k] > 0) b->cd[fi].cd[k]--;
        f->ripple = 0;

        /* auto-face when actionable */
        if (!mb_busy(b, fi) || f->state == MB_ST_DAZED)
            f->facing = b->body[oi].x >= bo->x ? 1 : -1;

        /* gravity */
        if (bo->y > 0 || bo->vy < 0) {
            bo->vy += c->gravity;
            bo->y -= bo->vy;
            if (bo->y <= 0) {
                bo->y = 0; bo->vy = 0; f->wall_jumped = 0;
                if (f->state == MB_ST_JUMP) { f->state = MB_ST_IDLE; f->t = 0; }
                if (f->state == MB_ST_KO)   { f->state = MB_ST_DOWN; f->t = 0; }
            }
        }

        /* knockback slide decay */
        if (f->state == MB_ST_STUN || f->state == MB_ST_KO ||
            f->state == MB_ST_DOWN) {
            bo->x += bo->vx;
            bo->vx = mb_mul(bo->vx, r->stun_vx_decay);
        }

        entry_state = f->state;
        switch (entry_state) {
        case MB_ST_STUN:
            /* the chain yank drags its victim across the ring during this stun */
            if (b->yank[fi].active) {
                mb_fp d = b->yank[fi].target - bo->x;
                mb_fp step = mb_min(mb_abs(d), b->yank[fi].speed);
                bo->x += mb_sign(d) * step;
                if (mb_abs(d) < r->yank_arrive_epsilon) b->yank[fi].active = 0;
            }
            if (--f->stun_t <= 0) {
                f->state = MB_ST_IDLE; f->t = 0;
                f->block_stun = 0;
                b->yank[fi].active = 0;
            }
            break;

        case MB_ST_BLOCK:
            if (!(in & MB_IN_BLOCK)) { f->state = MB_ST_IDLE; f->t = 0; }
            break;

        case MB_ST_DAZED:
            if (--f->dazed_t <= 0) { f->state = MB_ST_IDLE; f->t = 0; }
            break;

        case MB_ST_ATTACK:
        case MB_ST_GRAB_HOLD:
            /* step_attack owns this fighter's whole frame from here */
            f->attack_deferred = 1;
            break;

        case MB_ST_GRABBED:
        case MB_ST_KO:
        case MB_ST_DOWN:
        case MB_ST_FINISH:
        case MB_ST_FINISH_VICTIM:
            break;

        case MB_ST_JUMP:
            if (in & MB_IN_LEFT)
                bo->x -= mb_mul(c->walk_speed, r->walk_air_ratio);
            if (in & MB_IN_RIGHT)
                bo->x += mb_mul(c->walk_speed, r->walk_air_ratio);
            /* wall scramble off the ring boards */
            if (c->wall_scramble && !f->wall_jumped && (in & MB_IN_JUMP) &&
                !f->prev_jump) {
                mb_fp half = c->hurt_w / 2;
                mb_fp lo = mb_from_int(r->ring_left) + half + r->wall_margin;
                mb_fp hi = mb_from_int(r->ring_right) - half - r->wall_margin;
                if (bo->x <= lo || bo->x >= hi) {
                    bo->vy = mb_mul(c->jump_velocity, r->wall_jump_ratio);
                    f->wall_jumped = 1;
                }
            }
            break;

        default:
            mb_step_grounded(b, m, side);
            break;
        }

        if (!f->attack_deferred) mb_fighter_tail(b, m, side);
    }
}

/* --------------------------------------------------- attack sub-steps */

MB_LOCAL void mb_step_strike(MbBatch *b, int m, int side, const MbMove *mv) {
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    int idx = 0;
    if (mv->hits > 0)
        idx = (b->fsm[fi].t - mv->startup) / mv->hit_interval;
    if (idx <= b->fsm[fi].hit_index) return;
    if (mv->hits > 0 && idx >= mv->hits) return;
    if (mb_overlap(mb_hitbox(b, fi, mv), mb_hurtbox(b, oi))) {
        b->fsm[fi].hit_index = idx;
        mb_resolve_hit(b, m, side, 1 - side, mv);
    }
}

MB_LOCAL void mb_step_grab_attempt(MbBatch *b, int m, int side, const MbMove *mv) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    const MbChar *c = mb_char(b, fi);

    if (b->fsm[fi].hit_index >= 0) return;
    if (b->fsm[oi].invuln_frames > 0 || b->fsm[oi].state == MB_ST_KO ||
        b->fsm[oi].state == MB_ST_DOWN) return;
    /* grip resistance: a 9+ target with its ripple tell active cannot be
     * grabbed */
    if (mb_char(b, oi)->grip_resistance >= 9 && b->fsm[oi].ripple) return;
    if (!mb_overlap(mb_hitbox(b, fi, mv), mb_hurtbox(b, oi))) return;
    b->fsm[fi].hit_index = 0;

    if (b->finisher[m].armed && side == 0 &&
        b->move_slot[fi].move_key == c->finisher_move) {
        mb_trigger_finisher(b, m);
        return;
    }
    if (b->cross[m].window > 0 && side == b->cross[m].victim &&
        (1 - side) == b->cross[m].cheater) {
        mb_break_cross(b, m, side, 1 - side);
        mb_end_move(b, fi);
        b->body[fi].y = 0;
        b->body[fi].vy = 0;
        return;
    }

    b->fsm[fi].state = MB_ST_GRAB_HOLD;
    b->grab[fi].t = mv->grab_hold_frames;
    b->grab[fi].move_id = b->move_slot[fi].move_key;
    b->grab[fi].side_foe = 1 - side;
    b->body[fi].y = 0;
    b->body[fi].vy = 0;
    b->fsm[oi].state = MB_ST_GRABBED;
    b->fsm[oi].t = 0;
    b->body[oi].x = b->body[fi].x +
                    b->fsm[fi].facing * (c->hurt_w / 2 + r->grab_offset);
    b->body[oi].y = 0;
    b->body[oi].vy = 0;
    if (b->clock[m].freeze < mv->hit_freeze) b->clock[m].freeze = mv->hit_freeze;
}

MB_LOCAL void mb_step_grab_hold(MbBatch *b, int m, int side) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    int key = b->grab[fi].move_id;
    const MbMove *mv;
    const MbChar *oc = mb_char(b, oi);

    if (key < 0 || key >= MB_MOVE_KEYS) { mb_end_move(b, fi); return; }
    mv = &mb_char(b, fi)->moves[key];

    /* per-frame grab damage: an accumulating division, applied exactly */
    mb_chip(b, oi, mb_mul(mv->damage, b->vitals[fi].damage_mult),
            mv->grab_hold_frames);

    if (--b->grab[fi].t <= 0) {
        mb_fp remaining = MB_FP_ONE - mb_div(mb_max(0, b->vitals[oi].hp),
                                             oc->max_health);
        mb_fp kb = mb_div(mb_mul(mv->base_knockback +
                                     mb_mul(mv->knockback_growth, remaining),
                                 r->knockback_scale),
                          oc->weight);
        b->body[oi].vx = b->fsm[fi].facing * mb_mul(mv->launch_cos, kb);
        b->body[oi].vy = -mb_mul(mb_mul(mv->launch_sin, kb),
                                 r->knockback_vy_scale);
        b->body[oi].y = mb_max(b->body[oi].y, r->air_epsilon);
        b->fsm[oi].state = MB_ST_STUN;
        b->fsm[oi].stun_t = mv->hitstun;
        b->fsm[oi].t = 0;
        b->grab[fi].side_foe = -1;
        mb_end_move(b, fi);
        mb_on_exchange(b, m, side, 1 - side);
    }
}

MB_LOCAL void mb_step_yank(MbBatch *b, int m, int side, const MbMove *mv) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    const MbChar *c = mb_char(b, fi);

    if (b->fsm[fi].hit_index >= 0) return;
    b->fsm[fi].hit_index = 0;
    /* the only counter is to be airborne when it fires */
    if (!mb_grounded(b, oi)) return;
    if (b->finisher[m].armed && side == 0 &&
        b->move_slot[fi].move_key == c->finisher_move) {
        mb_trigger_finisher(b, m);
        return;
    }
    b->vitals[oi].hp -= mb_mul(mv->damage, b->vitals[fi].damage_mult);
    b->vitals[oi].took_damage = 1;
    b->fsm[oi].state = MB_ST_STUN;
    b->fsm[oi].stun_t = mv->hitstun;
    b->fsm[oi].block_stun = 0;
    b->fsm[oi].t = 0;
    /* dragged to the yanker's feet regardless of position */
    b->yank[oi].target = b->body[fi].x +
                         b->fsm[fi].facing * (c->hurt_w / 2 + r->yank_offset);
    b->yank[oi].speed = mv->yank_speed;
    b->yank[oi].active = 1;
    b->body[oi].vx = 0;
    if (b->clock[m].freeze < mv->hit_freeze) b->clock[m].freeze = mv->hit_freeze;
    if (b->clock[m].shake < mv->shake) b->clock[m].shake = mv->shake;
    mb_on_exchange(b, m, side, 1 - side);
}

/* Appends one hazard. Returns 0 when the ring is full - a full ring drops the
 * spawn rather than corrupting a slot, and the loader has already proved the
 * authored zone counts fit (root CLAUDE.md decision 17). */
MB_LOCAL int mb_hazard_push(MbBatch *b, int m, int kind, int owner_side,
                          int dur, mb_fp dps, mb_fp x, mb_fp w,
                          mb_fp y, mb_fp vy) {
    MbHazards *h = &b->hazards[m];
    int i = h->count;
    if (i >= MB_HAZARD_CAP) return 0;
    h->kind[i] = kind;
    h->t[i] = 0;
    h->dur[i] = dur;
    h->owner[i] = owner_side;
    h->dps[i] = dps;
    h->x[i] = x;
    h->w[i] = w;
    h->y[i] = y;
    h->vy[i] = vy;
    h->count = i + 1;
    return 1;
}

MB_LOCAL void mb_spawn_rats(MbBatch *b, int m, int side, const MbMove *mv) {
    int fi = MB_F(m, side);
    if (b->fsm[fi].hit_index >= 0) return;
    b->fsm[fi].hit_index = 0;
    b->fsm[fi].invuln_frames = mv->rats_invuln_frames;
    mb_hazard_push(b, m, MB_HZ_RATS, side, mv->rats_duration, mv->rats_chip_dps,
                   0, 0, 0, 0);
}

MB_LOCAL void mb_spawn_coins(MbBatch *b, int m, int side, const MbMove *mv) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side);
    int i;
    int span = r->ring_right - r->ring_left - 2 * r->coins_margin;
    if (b->fsm[fi].hit_index >= 0) return;
    b->fsm[fi].hit_index = 0;
    if (span < 1) span = 1;
    for (i = 0; i < mv->coins_zones; i++) {
        /* One draw per zone, in zone order - part of the draw contract. The
         * centre lands on a whole pixel; the JS reference used a continuous
         * float here and the difference is deliberate (fixed point wins). */
        uint32_t off = mb_rng_below(&b->rng[m].state, (uint32_t)span);
        mb_fp cx = mb_from_int(r->ring_left + r->coins_margin + (int32_t)off);
        mb_hazard_push(b, m, MB_HZ_COINS, side, mv->coins_duration,
                       mv->coins_chip_dps, cx - mv->coins_zone_width / 2,
                       mv->coins_zone_width, 0, 0);
    }
}

MB_LOCAL void mb_step_retreat(MbBatch *b, int m, int side, const MbMove *mv) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, side), oi = MB_F(m, 1 - side);
    const MbChar *c = mb_char(b, fi);
    mb_fp half = c->hurt_w / 2;
    mb_fp edge = b->retreat[fi].dir > 0 ? mb_from_int(r->ring_right) - half
                                        : mb_from_int(r->ring_left) + half;
    mb_fp d = edge - b->body[fi].x;

    if (mb_abs(d) > r->retreat_epsilon)
        b->body[fi].x += mb_sign(d) * r->retreat_step;
    b->fsm[fi].invuln_frames = r->retreat_invuln_frames;
    b->move_slot[fi].proj_t++;
    if (b->move_slot[fi].proj_t % mv->projectile_interval == 0) {
        /* one draw: where in the scatter the object comes down */
        uint32_t off = mb_rng_below(&b->rng[m].state,
                                    (uint32_t)r->thrown_spread);
        mb_fp x = b->body[oi].x +
                  mb_from_int((int32_t)off - r->thrown_spread / 2);
        mb_hazard_push(b, m, MB_HZ_THROWN, side, 0, 0, x, 0,
                       r->thrown_spawn_y, 0);
    }
}

MB_FN void mb_k_attack(MbBatch *b, int m) {
    int side;
    if (!b->clock[m].active) return;

    for (side = 0; side < 2; side++) {
        int fi = MB_F(m, side);
        MbFsm *f = &b->fsm[fi];
        const MbChar *c = mb_char(b, fi);
        const MbMove *mv;
        int phase;

        if (!f->attack_deferred) continue;
        f->attack_deferred = 0;

        if (f->state == MB_ST_GRAB_HOLD) {
            mb_step_grab_hold(b, m, side);
            mb_fighter_tail(b, m, side);
            continue;
        }

        mv = mb_cur_move(b, fi);
        if (!mv || !mv->present) {
            mb_end_move(b, fi);
            mb_fighter_tail(b, m, side);
            continue;
        }
        phase = mb_attack_phase(b, fi);

        /* the skin moves before he does: a grab-immune tell over the last
         * ripple_frames of any windup */
        if (c->ripple_frames > 0 && phase == 0 &&
            f->t >= mv->startup - c->ripple_frames)
            f->ripple = 1;

        /* leap moves launch at the startup -> active boundary */
        if (mv->has_leap && f->t == mv->startup) {
            b->body[fi].vy = mv->leap_vy;
            b->body[fi].y = mb_max(b->body[fi].y, b->rules->air_epsilon);
            b->move_slot[fi].leap_vx = mv->leap_vx * f->facing;
        }
        if (mv->has_leap && b->body[fi].y > 0)
            b->body[fi].x += b->move_slot[fi].leap_vx;

        if (phase == 1) {
            if (mv->move_forward)
                b->body[fi].x += mv->move_forward * f->facing;
            switch (mv->type) {
            case MB_MT_STRIKE:       mb_step_strike(b, m, side, mv); break;
            case MB_MT_GRAB:         mb_step_grab_attempt(b, m, side, mv); break;
            case MB_MT_STANCE:       /* passive; mb_resolve_hit handles it */ break;
            case MB_MT_CHAIN_YANK:   mb_step_yank(b, m, side, mv); break;
            case MB_MT_HAZARD_RATS:  mb_spawn_rats(b, m, side, mv); break;
            case MB_MT_HAZARD_COINS: mb_spawn_coins(b, m, side, mv); break;
            case MB_MT_RETREAT:      mb_step_retreat(b, m, side, mv); break;
            default: break;
            }
        }

        /* a grab or a finisher may have changed the state out from under us */
        if (f->state == MB_ST_ATTACK &&
            f->t >= mv->startup + mv->active + mv->recovery) {
            mb_end_move(b, fi);
            if (mv->type == MB_MT_RETREAT) f->invuln_frames = 0;
        }
        mb_fighter_tail(b, m, side);
    }
}

MB_FN void mb_k_hazards(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    MbHazards *h = &b->hazards[m];
    int i, out = 0;
    if (!b->clock[m].active) return;

    for (i = 0; i < h->count; i++) {
        int owner = h->owner[i];
        int vf = MB_F(m, 1 - owner);
        int vulnerable = mb_grounded(b, vf) && b->fsm[vf].state != MB_ST_KO &&
                         b->fsm[vf].state != MB_ST_DOWN;
        int keep = 1;

        h->t[i]++;
        if (h->kind[i] == MB_HZ_RATS) {
            /* the sawdust boils: chip to whoever is caught in the wave */
            if (vulnerable) mb_chip(b, vf, h->dps[i], r->logic_hz);
            if (h->t[i] >= h->dur[i]) keep = 0;
        } else if (h->kind[i] == MB_HZ_COINS) {
            if (vulnerable && b->body[vf].x > h->x[i] &&
                b->body[vf].x < h->x[i] + h->w[i])
                mb_chip(b, vf, h->dps[i], r->logic_hz);
            if (h->t[i] >= h->dur[i]) keep = 0;
        } else {                                       /* MB_HZ_THROWN */
            h->vy[i] += r->thrown_gravity;
            h->y[i] += h->vy[i];
            if (h->y[i] >= 0) {
                if (mb_abs(h->x[i] - b->body[vf].x) < r->thrown_hit_radius &&
                    vulnerable && b->fsm[vf].invuln_frames <= 0) {
                    const MbMove *mv =
                        &mb_char(b, MB_F(m, owner))->moves[MB_MK_STAKES_DOWN];
                    if (mv->present) mb_resolve_hit(b, m, owner, 1 - owner, mv);
                }
                keep = 0;
            }
        }

        if (keep) {
            /* compact in place, preserving spawn order */
            if (out != i) {
                h->kind[out] = h->kind[i]; h->t[out] = h->t[i];
                h->dur[out] = h->dur[i];   h->owner[out] = h->owner[i];
                h->dps[out] = h->dps[i];   h->x[out] = h->x[i];
                h->w[out] = h->w[i];       h->y[out] = h->y[i];
                h->vy[out] = h->vy[i];
            }
            out++;
        }
    }
    h->count = out;
}

MB_FN void mb_k_cross(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    MbCross *x = &b->cross[m];
    int side, cheat = -1;
    (void)r;
    if (!b->clock[m].active) return;

    for (side = 0; side < 2; side++)
        if (mb_char(b, MB_F(m, side))->has_the_cross) { cheat = side; break; }
    if (cheat < 0) return;

    {
        int cf = MB_F(m, cheat);
        const MbChar *c = mb_char(b, cf);
        int st = b->fsm[cf].state;

        if (!x->used && b->clock[m].phase == MB_PHASE_FIGHT &&
            b->vitals[cf].hp > 0 &&
            b->vitals[cf].hp <= c->cross_trigger_health_abs &&
            (st == MB_ST_IDLE || st == MB_ST_WALK)) {
            x->used = 1;
            x->t = 0;
            x->window = c->cross_window_frames;
            x->cheater = cheat;
            x->victim = 1 - cheat;
        }
        if (x->window > 0) {
            int vf = MB_F(m, x->victim);
            x->t++;
            /* the drain is an accumulating division; it stops at the floor */
            if (b->vitals[vf].hp > c->cross_min_health) {
                mb_chip(b, vf, c->cross_drain_per_second, b->rules->logic_hz);
                if (b->vitals[vf].hp < c->cross_min_health)
                    b->vitals[vf].hp = c->cross_min_health;
            }
            if (x->t >= x->window) {
                x->window = 0;
                x->cheater = -1;
                x->victim = -1;
            }
        }
    }
}

MB_FN void mb_k_finisher(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    MbFinisher *fin = &b->finisher[m];
    int f1 = MB_F(m, 1);
    if (!b->clock[m].active) return;

    if (fin->rearm > 0) fin->rearm--;
    if (fin->armed) {
        if (--fin->window_t <= 0) {
            fin->armed = 0;
            fin->rearm = r->finisher_rearm_frames;
            if (b->fsm[f1].state == MB_ST_DAZED) {
                b->fsm[f1].state = MB_ST_IDLE;
                b->fsm[f1].t = 0;
            }
        }
        return;
    }

    /* offered only at match point, on a grounded, low, un-crossed opponent */
    if (b->refs[MB_F(m, 0)].rounds_won == r->wins_to_take_match - 1 &&
        fin->rearm <= 0 && b->vitals[f1].hp > 0 &&
        b->vitals[f1].hp <= mb_mul(r->finisher_health_threshold,
                                   mb_max_health(b, f1)) &&
        mb_grounded(b, f1) && b->fsm[f1].state != MB_ST_KO &&
        b->fsm[f1].state != MB_ST_DOWN && b->cross[m].window <= 0) {
        fin->armed = 1;
        fin->window_t = r->finisher_window_frames;
        b->fsm[f1].state = MB_ST_DAZED;
        b->fsm[f1].dazed_t = fin->window_t;
        b->fsm[f1].t = 0;
        b->move_slot[f1].move_key = -1;
        b->move_slot[f1].move_id = -1;
    }
}

MB_FN void mb_k_separate(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    int f0 = MB_F(m, 0), f1 = MB_F(m, 1);
    mb_fp min, dx;
    if (!b->clock[m].active) return;
    if (b->fsm[f0].state == MB_ST_GRAB_HOLD ||
        b->fsm[f1].state == MB_ST_GRAB_HOLD) return;

    min = (mb_char(b, f0)->hurt_w + mb_char(b, f1)->hurt_w) / 2 -
          r->separate_inset;
    dx = b->body[f1].x - b->body[f0].x;
    if (mb_abs(dx) < min &&
        mb_abs(b->body[f0].y - b->body[f1].y) < r->separate_y_window) {
        mb_fp push = (min - mb_abs(dx)) / 2;
        int dir = dx >= 0 ? 1 : -1;
        b->body[f0].x -= dir * push;
        b->body[f1].x += dir * push;
        mb_clamp_x(b, f0);
        mb_clamp_x(b, f1);
    }
}

MB_FN void mb_k_announcements(MbBatch *b, int m) {
    const MbRules *r = b->rules;
    int fi = MB_F(m, 0);
    MbVitals *v = &b->vitals[fi];
    if (!b->clock[m].active) return;

    /* Only side 0 is announced, as in the JS reference. */
    if (!v->low_announced && v->hp > 0 &&
        v->hp <= mb_mul(r->low_health_announce, mb_max_health(b, fi))) {
        v->low_announced = 1;
    }
}

MB_FN void mb_k_round_resolve(MbBatch *b, int m) {
    MbClock *c = &b->clock[m];
    int f0 = MB_F(m, 0), f1 = MB_F(m, 1);
    int out0, out1;
    if (!c->active) return;

    if (--c->timer <= 0) {
        int cmp = mb_cmp_ratio(b->vitals[f0].hp, mb_max_health(b, f0),
                               b->vitals[f1].hp, mb_max_health(b, f1));
        b->outcome[m].timeouts++;
        /* Dead even on the watch is a real tie; otherwise the healthier
         * side. The comparison is an integer cross-multiply, never a
         * division (components/README.md, "Equality comparisons"). */
        if (cmp == 0) mb_end_round(b, m, -1, 0);
        else mb_end_round(b, m, cmp > 0 ? 0 : 1, 0);
        return;
    }

    /* KO check - both at zero on the same frame is a double KO, not a race */
    out1 = b->vitals[f1].hp <= 0 && b->fsm[f1].state != MB_ST_KO;
    out0 = b->vitals[f0].hp <= 0 && b->fsm[f0].state != MB_ST_KO;
    if (out0 && out1) {
        mb_ko_fall(b, m, 0);
        mb_ko_fall(b, m, 1);
        c->slowmo = b->rules->ko_slowmo_frames;
        mb_end_round(b, m, -1, 1);
    } else if (out1) {
        mb_ko_fall(b, m, 1);
        c->slowmo = b->rules->ko_slowmo_frames;
        mb_end_round(b, m, 0, 1);
    } else if (out0) {
        mb_ko_fall(b, m, 0);
        c->slowmo = b->rules->ko_slowmo_frames;
        mb_end_round(b, m, 1, 1);
    }
}

/* --------------------------------------------------------- batch sweeps */

#define MB_SWEEP(fn) \
    MB_FN void mb_step_##fn(MbBatch *b) { \
        int m; \
        for (m = 0; m < b->count; m++) mb_k_##fn(b, m); \
    }

MB_SWEEP(match_phase)
MB_SWEEP(ai_decide)
MB_SWEEP(fighter)
MB_SWEEP(attack)
MB_SWEEP(hazards)
MB_SWEEP(cross)
MB_SWEEP(finisher)
MB_SWEEP(separate)
MB_SWEEP(announcements)
MB_SWEEP(round_resolve)

MB_FN void mb_step_tick(MbBatch *b) {
    mb_step_match_phase(b);
    mb_step_ai_decide(b);
    mb_step_fighter(b);
    mb_step_attack(b);
    mb_step_hazards(b);
    mb_step_cross(b);
    mb_step_finisher(b);
    mb_step_separate(b);
    mb_step_announcements(b);
    mb_step_round_resolve(b);
}

MB_FN int mb_slot_finished(const MbBatch *b, int m) {
    return b->clock[m].phase == MB_PHASE_END;
}
/* MONKEY BAITING - the pure step functions.
 *
 * This is the whole simulation. It is deliberately free of flecs, of globals,
 * of file-static state, of allocation, and of libc: everything it touches
 * arrives through MbBatch (mutable per-match columns) and MbRules (immutable
 * shared data). The flecs systems in mb_world.c are thin shells that gather
 * column pointers and call in here; a CUDA kernel would do the same.
 *
 * Batch width == future kernel launch width. MbBatch.count is W: one lane per
 * match slot, columns already in SoA, no pointer chasing between them.
 *
 * Per-slot entry points are the mb_k_* functions (one match, one frame - the
 * kernel body). The mb_step_* wrappers loop over the batch; on a device the
 * loop becomes the launch.
 *
 * System order is fixed and mirrors app.yaml system_order, which mirrors
 * docs/specs/tournament-simulator-architecture.md section 4.3. Every system
 * self-gates on MbClock.active (root CLAUDE.md decision 15: self-governing
 * systems - no central coordinator decides who runs). */
#ifndef MB_STEP_H
#define MB_STEP_H

#include "mb_types.h"

/* Out-of-line step functions. A CUDA build defines this to a device
 * annotation before including - sim/mb_cuda.cu uses "__device__ static": the
 * host copy already exists in mb_core, and nvcc's host-side stub for a
 * non-static __device__ function carries that function's external name, so
 * without the `static` the linker can bind mb_core's callers to the stub.
 *
 * MB_LOCAL is the same shim for the file-local helpers INSIDE mb_step.c. An
 * undecorated function is host-only to nvcc, so a device-side mb_k_* could not
 * call one; the CUDA build defines it to "__device__ static". Both macros are
 * compile-portability annotations and neither can move a result row: on every
 * non-CUDA target MB_FN is empty and MB_LOCAL is exactly `static`. */
#ifndef MB_FN
#define MB_FN
#endif

#ifndef MB_LOCAL
#define MB_LOCAL static
#endif

#ifdef __cplusplus
extern "C" {
#endif

/* ---- perfect-policy index arithmetic ----------------------------------
 *
 * Exposed because it IS the contract, not an implementation detail: these
 * quantized values index the solved policy table, so a one-unit difference
 * selects a different action. The test suite asserts them directly against
 * hand-computed states rather than only observing whole matches. See the
 * bucketing contract at their definitions in mb_step.c. */

MB_FN int mb_perfect_gap_bucket(const MbBatch *b, int m, int side,
                                const MbPolicy *p);
MB_FN int mb_perfect_back_bucket(const MbBatch *b, int who, int foe,
                                 const MbPolicy *p);
MB_FN int mb_perfect_side_state(const MbBatch *b, int fi, const MbPolicy *p);
MB_FN int mb_perfect_row(const MbBatch *b, int m, int side, const MbPolicy *p);

/* ---- per-slot kernels (one match slot, one frame) ---------------------- */

MB_FN void mb_k_match_phase(MbBatch *b, int m);
MB_FN void mb_k_ai_decide(MbBatch *b, int m);
MB_FN void mb_k_fighter(MbBatch *b, int m);
MB_FN void mb_k_attack(MbBatch *b, int m);
MB_FN void mb_k_hazards(MbBatch *b, int m);
MB_FN void mb_k_cross(MbBatch *b, int m);
MB_FN void mb_k_finisher(MbBatch *b, int m);
MB_FN void mb_k_separate(MbBatch *b, int m);
MB_FN void mb_k_announcements(MbBatch *b, int m);
MB_FN void mb_k_round_resolve(MbBatch *b, int m);

/* Slot lifecycle. mb_k_reset_slot puts a slot into MB_PHASE_EMPTY with clean
 * state; mb_k_begin_match arms it for the pairing already written into
 * MbPair/MbRng/MbRefs; mb_k_start_round starts the next round of a live
 * match. All three are pure - the host decides WHICH pairing, never HOW. */
MB_FN void mb_k_reset_slot(MbBatch *b, int m);
MB_FN void mb_k_begin_match(MbBatch *b, int m);
MB_FN void mb_k_start_round(MbBatch *b, int m);
MB_FN void mb_k_reset_fighter(MbBatch *b, int m, int side);

/* ---- host-side batch sweeps (the loop becomes a launch on a device) ---- */

MB_FN void mb_step_match_phase(MbBatch *b);
MB_FN void mb_step_ai_decide(MbBatch *b);
MB_FN void mb_step_fighter(MbBatch *b);
MB_FN void mb_step_attack(MbBatch *b);
MB_FN void mb_step_hazards(MbBatch *b);
MB_FN void mb_step_cross(MbBatch *b);
MB_FN void mb_step_finisher(MbBatch *b);
MB_FN void mb_step_separate(MbBatch *b);
MB_FN void mb_step_announcements(MbBatch *b);
MB_FN void mb_step_round_resolve(MbBatch *b);

/* All ten in canonical order. Harvest is not here: it is host-side
 * scheduling (result placement and slot refill), not simulation. */
MB_FN void mb_step_tick(MbBatch *b);

/* True when the slot has finished and is waiting to be harvested. */
MB_FN int mb_slot_finished(const MbBatch *b, int m);

/* One frame of an accumulating division applied to hp: `numerator / denom`
 * per frame, with the unapplied numerator carried in MbVitals.chip_residual
 * so the total after N frames is exact rather than N independently rounded
 * quotients. Used by grab damage, hazard chip and THE CROSS drain, and
 * exposed here because it is the highest-risk item in the fixed-point
 * inventory and therefore unit-tested directly. */
MB_FN void mb_chip_apply(MbVitals *v, mb_fp numerator, int32_t denom);

#ifdef __cplusplus
}
#endif

#endif /* MB_STEP_H */
/* MONKEY BAITING - component structs, shared read-only tables, and the batch
 * context handed to the pure step functions.
 *
 * These structs mirror ../../components/*.yaml field for field, in order.
 * mb_world_bind asserts the registered Flecs type size equals sizeof each
 * struct, and tests/test_mb_sim.c parses the YAML and compares field names,
 * types and array counts against mb_schema[] - so the two declarations
 * cannot drift silently.
 *
 * Nothing in this header includes flecs. It is the interface the pure step
 * functions (mb_step.c) see, and the interface a future CUDA kernel sees. */
#ifndef MB_TYPES_H
#define MB_TYPES_H

#include <stdint.h>
#include "mb_fixed.h"

/* THE ORACLE STAMP. This is the single source of truth for sim_version; it is
 * printed by `mb_sim --version` and `mb_sim --json`, and the Python driver
 * (tools/mb_driver.py) copies it into every run record. Nothing else in the
 * tree may declare a simulator version.
 *
 * BUMP RULE (architecture spec section 1.4 ruling 5(a), section 6.1): any
 * change that can move a result row bumps this - the draw contract in
 * ../../CLAUDE.md (order or count of RNG draws), any gameplay step function,
 * any authored constant in app.yaml or data/, the entrant-identity or seeding
 * rules, the perfect-policy bucketing or CDF math. Results produced under
 * different sim_versions are NOT comparable and must never be scored against
 * each other; champions are re-scored instead. Performance-only changes
 * (threads, batch width, partition) must NOT bump it - they cannot move a row,
 * and the batch/thread invariance gates in tests/test_mb_sim.c prove it. */
#define MB_SIM_VERSION "mb-1"

/* Fixed bounds. Root CLAUDE.md decision 17: these must match the data, and
 * an undersized bound silently drops state. MB_MAX_MOVES matches
 * MbCooldowns.cd count, MB_HAZARD_CAP matches the MbHazards array counts.
 *
 * These stay compile-time caps (fixed array bounds, no allocation on the hot
 * path) but the loader ASSERTS the real data against them and fails loud when
 * a character declares more moves than MB_MAX_MOVES, or a move would spawn
 * more hazards than MB_HAZARD_CAP. Nothing is silently dropped. */
#define MB_MAX_MOVES  8
#define MB_HAZARD_CAP 8
#define MB_MAX_CHARS  16

/* The authored move keys, in canonical order. A move key index is ALSO the
 * MbCooldowns.cd slot, so this order is part of the save/replay contract:
 * append, never reorder. */
#define MB_MK_LIGHT       0
#define MB_MK_HEAVY       1
#define MB_MK_SPECIAL     2
#define MB_MK_STAKES_DOWN 3
#define MB_MOVE_KEYS      4

/* Move types (the `type:` field of a move in data/characters/*.yaml). */
typedef enum {
    MB_MT_NONE = 0, MB_MT_STRIKE, MB_MT_GRAB, MB_MT_STANCE,
    MB_MT_CHAIN_YANK, MB_MT_HAZARD_RATS, MB_MT_HAZARD_COINS, MB_MT_RETREAT
} MbMoveType;

/* Hazard kinds (MbHazards.kind). */
typedef enum { MB_HZ_RATS = 1, MB_HZ_COINS, MB_HZ_THROWN } MbHazardKind;

/* Match phase. EMPTY is a free batch slot; DONE is harvested and awaiting
 * refill. Slots are reused in place, so a batch is one archetype for its
 * whole life and there is no per-match structural churn. */
typedef enum {
    MB_PHASE_EMPTY    = 0,
    MB_PHASE_INTRO    = 1,
    MB_PHASE_FIGHT    = 2,
    MB_PHASE_ROUNDEND = 3,
    MB_PHASE_FINISHER = 4,
    MB_PHASE_END      = 5,
    MB_PHASE_DONE     = 6
} MbPhase;

/* Fighter state machine, mirroring the JS reference state strings. */
typedef enum {
    MB_ST_IDLE = 0, MB_ST_WALK, MB_ST_JUMP, MB_ST_ATTACK, MB_ST_STUN,
    MB_ST_BLOCK, MB_ST_DAZED, MB_ST_KO, MB_ST_DOWN, MB_ST_GRAB_HOLD,
    MB_ST_GRABBED, MB_ST_FINISH, MB_ST_FINISH_VICTIM
} MbState;

/* MbInput.bits */
#define MB_IN_LEFT        (1u << 0)
#define MB_IN_RIGHT       (1u << 1)
#define MB_IN_JUMP        (1u << 2)
#define MB_IN_LIGHT       (1u << 3)
#define MB_IN_HEAVY       (1u << 4)
#define MB_IN_SPECIAL     (1u << 5)
#define MB_IN_BLOCK       (1u << 6)
#define MB_IN_STAKES_DOWN (1u << 7)

/* Presses that must not be held across a whole decision interval (the JS
 * dropPresses set). */
#define MB_IN_PRESSES (MB_IN_JUMP | MB_IN_LIGHT | MB_IN_HEAVY | \
                       MB_IN_SPECIAL | MB_IN_STAKES_DOWN)

typedef enum {
    MB_POLICY_DEFAULT = 0, MB_POLICY_SPAM, MB_POLICY_RANDOM,
    MB_POLICY_PASSIVE, MB_POLICY_PERFECT
} MbPolicyKind;

/* Random-strategy picks (MbBrain.plan_action while MB_POLICY_RANDOM holds). */
typedef enum {
    MB_PICK_WAIT = 0, MB_PICK_WALK_TO, MB_PICK_WALK_AWAY, MB_PICK_JUMP,
    MB_PICK_BLOCK, MB_PICK_MOVE     /* MB_PICK_MOVE + key index */
} MbPick;

typedef unsigned char mb_bool;   /* matches ecs_bool_t width (1 byte) */

/* ---------------------------------------------------------- fighter state */

typedef struct { mb_fp x, y, vx, vy; } MbBody;

typedef struct {
    mb_fp hp, damage_mult, chip_residual;
    mb_bool took_damage, low_announced;
} MbVitals;

/* attack_deferred is the one-frame handshake between step_fighter and
 * step_attack: step_fighter sets it when it finds the fighter already in an
 * attack/grab_hold state at ITS entry, and leaves the whole per-fighter tail
 * (prev_jump, t++, clamp, retreat shuffle) to step_attack. A fighter that
 * STARTS a move inside step_fighter is finished by step_fighter, exactly as
 * the JS reference finishes it inside one stepFighter call - so a move's
 * first active frame is never double-stepped. */
typedef struct {
    int32_t state, t, stun_t, dazed_t, invuln_frames, hit_index, facing;
    mb_bool block_stun, prev_jump, wall_jumped, ripple, attack_deferred;
} MbFsm;

typedef struct { int32_t move_id, move_key; mb_fp leap_vx; int32_t proj_t; } MbMoveSlot;

typedef struct { int32_t cd[MB_MAX_MOVES]; } MbCooldowns;

typedef struct { int32_t dir, t; } MbRetreat;

typedef struct { int32_t t, move_id, side_foe; uint64_t foe; } MbGrab;

typedef struct { mb_fp target, speed; mb_bool active; } MbYank;

typedef struct { int32_t char_id, entrant_id, slot, side, rounds_won; } MbRefs;

/* bot_id indexes MbBotTable. policy_kind / policy_id are the STRATEGY the bot
 * table last rolled (kind + spam move key). hold counts down the strategy's
 * own decision cadence; bot_hold counts down the bot table's re-roll cadence;
 * was_busy is the busy-state edge that also forces a re-roll. plan_action /
 * plan_left are the random strategy's held pick. See the draw contract in
 * ../../CLAUDE.md. */
typedef struct {
    int32_t policy_kind, policy_id, hold, plan_action, plan_left;
    uint32_t held_input;
    int32_t bot_id, bot_hold;
    mb_bool was_busy;
} MbBrain;

typedef struct { uint32_t bits; } MbInput;

/* ------------------------------------------------------------ match state */

typedef struct {
    int32_t frame, timer, round, phase, phase_t, freeze, slowmo;
    mb_fp shake;
    mb_bool active;
} MbClock;

typedef struct { uint32_t state, seed; } MbRng;

typedef struct {
    int32_t entrant0, entrant1, char0, char1, seed_index, result_index;
} MbPair;

typedef struct {
    int32_t t, window, cheater, victim;
    mb_bool used, puss_cross;
} MbCross;

typedef struct { int32_t window_t, rearm; mb_bool armed, done; } MbFinisher;

typedef struct {
    int32_t winner, frames, rounds, tie_rounds, timeouts, finishers;
    mb_bool capped, drawn;
} MbOutcome;

typedef struct {
    int32_t count;
    int32_t kind[MB_HAZARD_CAP], t[MB_HAZARD_CAP], dur[MB_HAZARD_CAP],
            owner[MB_HAZARD_CAP];
    mb_fp dps[MB_HAZARD_CAP], x[MB_HAZARD_CAP], w[MB_HAZARD_CAP],
          y[MB_HAZARD_CAP], vy[MB_HAZARD_CAP];
} MbHazards;

/* ------------------------------------------- immutable shared game data */

/* One move of one character. Everything fractional is Q16.16, resolved at
 * load; everything angular is resolved at load into launch_cos / launch_sin
 * so there is no runtime trigonometry (components/README.md). `present` is 0
 * for a move key the character does not author - never a zeroed record that
 * would silently behave like a real move. */
typedef struct {
    int32_t present;
    int32_t type;                       /* MbMoveType */
    int32_t startup, active, recovery;
    mb_fp   damage;
    mb_fp   base_knockback, knockback_growth;
    int32_t launch_angle_deg;           /* authored, whole degrees 0..90 */
    mb_fp   launch_cos, launch_sin;     /* precomputed */
    int32_t hitstun, blockstun;
    mb_fp   pushback_hit, pushback_block;
    mb_fp   hb_x, hb_y, hb_w, hb_h;     /* hitbox rect, attacker-local */
    int32_t hit_freeze;
    mb_fp   shake;
    int32_t cooldown;
    int32_t unblockable;
    /* optional blocks; the has_* flags say whether the key was authored */
    int32_t hits, hit_interval;         /* multi-hit strikes; hits 0 = single */
    mb_fp   move_forward;
    int32_t has_armor_frames, armor_from, armor_to;
    mb_fp   armor_damage_ratio;
    int32_t has_armor_health;
    mb_fp   armor_health_abs;           /* armor_if_health_above * max_health */
    mb_fp   stance_take_ratio, stance_return_ratio;
    int32_t has_leap;
    mb_fp   leap_vx, leap_vy;
    int32_t grab_hold_frames;
    mb_fp   yank_speed;
    int32_t rats_duration, rats_invuln_frames;
    mb_fp   rats_chip_dps;
    int32_t coins_duration, coins_zones;
    mb_fp   coins_zone_width, coins_chip_dps;
    int32_t projectile_interval;
    /* `input:` binds a move to a non-native button (Aistrop's STAKES DOWN on
     * jump). MB_IN_* bit, or 0 when the move is pressed by its own key. */
    uint32_t input_bit;
    /* precomputed spam reach for this (character, move) pair */
    mb_fp   reach;
} MbMove;

/* One character. Health fractions are resolved into absolute Q16.16 hp at
 * load; probabilities into u32 thresholds pre-scaled to 2^32. */
typedef struct {
    mb_fp   max_health, walk_speed, jump_velocity, gravity, weight;
    int32_t grip_resistance;
    mb_fp   hurt_w, hurt_h;

    /* mechanics */
    int32_t finisher_move;              /* move key index, -1 when unauthored */
    int32_t has_chain_radius;
    mb_fp   chain_radius;
    int32_t ripple_frames;
    int32_t wall_scramble;
    int32_t post_exchange_retreat;
    /* mechanics.cross_health / cross_damage_mult (Puss's ON THE CROSS). The
     * rule is keyed on the DATA being present, never on a character name. */
    int32_t has_odds_flip;
    mb_fp   odds_flip_health_abs, odds_flip_damage_mult;
    /* mechanics.the_cross (Aistrop's THE CROSS) */
    int32_t has_the_cross;
    mb_fp   cross_trigger_health_abs, cross_min_health, cross_drain_per_second;
    int32_t cross_window_frames, cross_break_stagger_frames;
    mb_fp   cross_break_bonus_damage;

    /* ai block, all pre-resolved */
    int32_t has_ai;
    mb_fp   aggression, poke_range, special_min_range, special_max_range;
    uint32_t block_chance_q32, retreat_chance_q32, jump_chance_q32;
    uint32_t light_chance_q32, heavy_chance_q32, special_chance_q32;
    int32_t has_stance_chance;
    uint32_t stance_chance_q32;
    int32_t has_keep_range;
    mb_fp   keep_range;
    int32_t has_stakes_down_health;
    mb_fp   stakes_down_health_abs;

    MbMove  moves[MB_MOVE_KEYS];
    int32_t move_count;                 /* authored moves; <= MB_MAX_MOVES */
} MbChar;

/* ------------------------------------------------ solved perfect policies */

/* One entry of meta.actions, resolved at load. `hold` is the number of EXTRA
 * frames the action is replayed before the next decision (perfect.params in
 * data/strategies.yaml); the action costs hold + 1 frames in total. */
#define MB_PACT_MOVE      0
#define MB_PACT_WALK_TO   1
#define MB_PACT_WALK_AWAY 2
#define MB_PACT_WAIT      3
#define MB_PACT_BLOCK     4
#define MB_PACT_JUMP      5

#define MB_POLICY_MAX_ACTIONS 12

typedef struct {
    int32_t kind;        /* MB_PACT_* */
    int32_t move_key;    /* MB_MK_*, or -1 */
    int32_t hold;
} MbPolicyAction;

/* One solved equilibrium policy for one ORDERED character pair, as exported
 * by the solver (perfect-<self>-vs-<foe>.json, state encoding 3). Everything
 * here is immutable after load and SHARED by every match in every batch:
 * one allocation per pair, read-only on the hot path, never copied per slot.
 *
 * `cdf` is the both-free mixed strategy as a u32 cumulative distribution -
 * the one deliberate conversion away from the reference's float accumulation
 * (architecture spec 4.4). Row `row` occupies [row * n_actions, +n_actions);
 * entry n_actions-1 is UINT32_MAX so the final bucket absorbs the rounding
 * residue exactly as the reference's fall-through does.
 *
 * `vs_committed` is the pure best response when the foe is committed or
 * stunned, one action index per (row, foe_state - 1). It consumes NO
 * randomness.
 *
 * Only the FOE's move tables are kept. The reference computes a self side
 * state in stateOf and then discards it - neither table is indexed by it -
 * so the self move offsets/QF are validated at load and dropped here. */
typedef struct {
    int32_t present;
    int32_t self_char, foe_char;

    /* quantization, straight from meta; every stride comes from the file */
    int32_t gap_step, gap_buckets;      /* whole px, bucket count */
    int32_t back_step, back_buckets;    /* whole px, per-side buckets */
    int32_t fq, stun_q_max;
    int32_t foe_states;

    int32_t n_actions;
    MbPolicyAction action[MB_POLICY_MAX_ACTIONS];
    int32_t walk_to_action;             /* index of "walk_to"; required */

    /* foe move tables, re-indexed from meta.foeMoves order to move KEY, so
     * the hot path never searches a name list. -1 = not modelled. */
    int32_t foe_mi[MB_MOVE_KEYS];
    int32_t foe_offset[MB_MOVE_KEYS];
    int32_t foe_qf[MB_MOVE_KEYS];

    /* cooldown flag bits: bit i of cd0/cd1 is move key *_cd_key[i] */
    int32_t self_cd_key[MB_MOVE_KEYS], self_cd_count;
    int32_t foe_cd_key[MB_MOVE_KEYS], foe_cd_count;

    int32_t rows;                       /* gap_buckets * BB^2 * c0 * c1 */
    const uint32_t *cdf;                /* [rows * n_actions] */
    const uint8_t  *vs_committed;       /* [rows * (foe_states - 1)] */
    void           *blob;               /* the single owning allocation */
} MbPolicy;

/* Every loaded policy, indexed by ORDERED character pair. Host-allocated
 * once, pointed at by MbBatch, never written on the hot path. A pair with
 * present == 0 was never loaded, and the host refuses to install a queue
 * that would need it (mb_world_set_queue), so the step functions can index
 * it without a fallback. */
typedef struct {
    int32_t count;
    MbPolicy p[MB_MAX_CHARS * MB_MAX_CHARS];
} MbPerfectSet;

#define MB_POLICY_AT(set, self_char, foe_char) \
    (&(set)->p[(self_char) * MB_MAX_CHARS + (foe_char)])

/* Character stats are NOT components. They are flat read-only tables indexed
 * by MbRefs.char_id, loaded once and shared by every match, every world and
 * (later) every device thread. */
typedef struct {
    int32_t count;
    mb_fp   max_health[MB_MAX_CHARS];   /* Q16.16, hot enough to keep flat */
    MbChar  c[MB_MAX_CHARS];
} MbCharTable;

/* ------------------------------------------------- strategies and bots */

#define MB_MAX_BOTS      64
#define MB_MAX_BOT_COMPS 8

/* data/strategies.yaml params, resolved. */
typedef struct {
    mb_fp    spam_reach_margin, spam_leap_reach_bonus, spam_unranged_reach;
    int32_t  random_interval;
    uint32_t random_move_weight_q32;
    uint32_t passive_block_chance_q32;
    mb_fp    passive_distance, passive_near_margin, passive_far_margin;
    /* perfect: how many EXTRA frames each action class is replayed before the
     * next decision. Authored, never typed into a step function (rule 4);
     * the solver's rollout uses the same numbers. */
    int32_t  perfect_hold_walk, perfect_hold_block, perfect_hold_wait,
             perfect_hold_move, perfect_hold_cd_miss;
} MbStrategyParams;

/* One entry of a bot's weight table (data/bots.yaml). */
typedef struct {
    int32_t  kind;          /* MbPolicyKind */
    int32_t  move_key;      /* spam-<move>, else -1 */
    int32_t  weight;        /* positive integer; see the draw contract */
    int32_t  gated;
    int32_t  within_is_reach;
    int32_t  has_within, has_beyond;
    mb_fp    within, beyond;
} MbBotComp;

typedef struct {
    int32_t   count;
    int32_t   fallback;     /* heaviest ungated entry; validated at load */
    int32_t   pure;         /* single ungated entry: never rolls */
    MbBotComp comp[MB_MAX_BOT_COMPS];
} MbBot;

typedef struct {
    int32_t count;
    int32_t hold_frames;    /* frames a rolled component is held */
    MbBot   bot[MB_MAX_BOTS];
} MbBotTable;

/* Rules loaded from sandboxes/monkey-baiting/app.yaml. Every field is
 * required; the loader fails loudly on a missing key. */
typedef struct {
    int32_t logic_hz;
    int32_t ring_left, ring_right, ring_center;     /* whole px */
    int32_t ring_start_offset;
    mb_fp   block_chip_ratio, low_health_announce, knockback_scale;
    int32_t ko_slowmo_frames, ko_fall_frames;
    int32_t wins_to_take_match, time_seconds, intro_frames, end_frames;
    int32_t max_rounds_per_match;
    int32_t finisher_rearm_frames, finisher_cinematic_frames;
    int32_t finisher_window_frames;
    mb_fp   finisher_health_threshold;
    int32_t ai_decision_interval;
    int32_t sim_batch;

    /* Gameplay constants that were literals in the JS reference. Every one of
     * them is authored in app.yaml now (root CLAUDE.md decision 12). */
    mb_fp   ko_fall_vy, ko_fall_vx;
    mb_fp   idle_vx_decay, stun_vx_decay;
    mb_fp   ground_epsilon, air_epsilon;
    mb_fp   knockback_vy_scale, launch_vy_threshold;
    mb_fp   pushback_hit_scale, pushback_block_scale;
    int32_t block_freeze, armor_freeze;
    int32_t stance_freeze, stance_attacker_stun;
    mb_fp   stance_shake, stance_attacker_vx;
    mb_fp   separate_inset, separate_y_window;
    mb_fp   grab_offset, yank_offset, yank_arrive_epsilon;
    mb_fp   walk_air_ratio, walk_retreat_ratio;
    mb_fp   wall_jump_ratio, wall_margin;
    mb_fp   retreat_step, retreat_epsilon;
    int32_t retreat_invuln_frames;
    int32_t coins_margin;
    mb_fp   thrown_spawn_y, thrown_gravity, thrown_hit_radius;
    int32_t thrown_spread;
    int32_t cross_break_freeze;
    mb_fp   cross_break_shake, cross_break_vx;
    /* default-strategy shape constants */
    mb_fp   ai_special_roll_ratio, ai_heavy_roll_ratio;
    uint32_t ai_yank_dodge_chance_q32, ai_yank_use_chance_q32,
             ai_stakes_down_roll_q32;
    mb_fp   ai_block_range_bonus, ai_stance_range, ai_stakes_down_range,
            ai_yank_min_range, ai_heavy_range_bonus, ai_keep_range_margin,
            ai_poke_margin;

    MbStrategyParams strat;
    MbBotTable       bots;
    MbCharTable      chars;
} MbRules;

/* ------------------------------------------------------------- the batch */

/* Structure-of-arrays view of one batch of matches. `count` is the batch
 * width W: the number of match slots stepped per tick, and the launch width
 * a CUDA kernel would receive unchanged. Match m owns fighters at
 * m * 2 + 0 and m * 2 + 1 in every fighter column.
 *
 * The pointers are gathered once from the Flecs columns at bind time and
 * stay valid for the life of the batch, because slots are recycled in place
 * and no entity is ever created or destroyed mid-run. */
typedef struct {
    int32_t count;

    MbClock    *clock;
    MbRng      *rng;
    MbPair     *pair;
    MbCross    *cross;
    MbFinisher *finisher;
    MbOutcome  *outcome;
    MbHazards  *hazards;

    MbBody      *body;      /* [count * 2] */
    MbVitals    *vitals;
    MbFsm       *fsm;
    MbMoveSlot  *move_slot;
    MbCooldowns *cd;
    MbRetreat   *retreat;
    MbGrab      *grab;
    MbYank      *yank;
    MbRefs      *refs;
    MbBrain     *brain;
    MbInput     *input;

    const MbRules *rules;
    /* Solved policies, shared read-only across every match in the batch (and
     * across worlds). Never NULL: mb_world_create installs an empty set when
     * none was loaded, and mb_world_set_queue refuses a queue whose entrants
     * would need a pair that is not present. */
    const MbPerfectSet *perfect;
} MbBatch;

/* Fighter index for (match slot, side). */
#define MB_F(m, side) ((m) * 2 + (side))

/* ------------------------------------------------------- schema descriptor */

typedef struct { const char *name; const char *type; int count; } MbFieldDesc;

typedef struct {
    const char *name;       /* component name, matches components/<name>.yaml */
    const char *kind;       /* "component" or "marker" */
    const MbFieldDesc *fields;
    int field_count;
    uint32_t size;          /* sizeof the C struct, 0 for markers */
} MbCompDesc;

extern const MbCompDesc mb_schema[];
extern const int mb_schema_count;

#endif /* MB_TYPES_H */
/* MONKEY BAITING - the Flecs batch world. See mb_world.h. */
#include "mb_world.h"
#include "mb_step.h"
#include "mb_rng.h"
#include "mb_perfect.h"
#include "mb_rules.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Schema indices, in mb_schema[] order. */
enum {
    MB_C_BODY = 0, MB_C_VITALS, MB_C_FSM, MB_C_MOVESLOT, MB_C_COOLDOWNS,
    MB_C_RETREAT, MB_C_GRAB, MB_C_YANK, MB_C_REFS, MB_C_BRAIN, MB_C_INPUT,
    MB_C_FIGHTER_TAG,
    MB_C_CLOCK, MB_C_RNG, MB_C_PAIR, MB_C_CROSS, MB_C_FINISHER,
    MB_C_OUTCOME, MB_C_HAZARDS, MB_C_MATCH_TAG,
    MB_C_COUNT
};

struct MbWorld {
    ecs_world_t *world;
    int owns_world;               /* 0 when attached to a host's world (S6) */
    ecs_entity_t *ents;           /* slots then fighters, creation order */
    int ent_count;
    ecs_entity_t ids[MB_C_COUNT];
    MbRules rules;
    MbPerfectSet empty_perfect;   /* the "no policies loaded" set; never NULL */
    MbBatch batch;

    MbPairing *queue;
    int queue_len;
    int queue_next;

    MbResult *results;
    int results_len;
    int harvested;
};

/* ------------------------------------------------ component registration */

static ecs_entity_t mb_flecs_type(ecs_world_t *world, const char *t) {
    if (strcmp(t, "i32") == 0)    return ecs_id(ecs_i32_t);
    if (strcmp(t, "u32") == 0)    return ecs_id(ecs_u32_t);
    if (strcmp(t, "i64") == 0)    return ecs_id(ecs_i64_t);
    if (strcmp(t, "u64") == 0)    return ecs_id(ecs_u64_t);
    if (strcmp(t, "bool") == 0)   return ecs_id(ecs_bool_t);
    if (strcmp(t, "entity") == 0) return ecs_id(ecs_entity_t);
    (void)world;
    return 0;
}

int mb_world_register(ecs_world_t *world, ecs_entity_t *ids_out) {
    int i, f;

    for (i = 0; i < mb_schema_count; i++) {
        const MbCompDesc *d = &mb_schema[i];
        ecs_entity_t comp = ecs_lookup(world, d->name);

        if (!comp) {
            if (d->fields == NULL) {
                /* marker: a zero-sized tag */
                comp = ecs_entity(world, { .name = d->name });
            } else {
                ecs_struct_desc_t sd;
                memset(&sd, 0, sizeof(sd));
                sd.entity = ecs_entity(world, { .name = d->name });
                for (f = 0; f < d->field_count; f++) {
                    ecs_entity_t ft = mb_flecs_type(world, d->fields[f].type);
                    if (!ft) {
                        fprintf(stderr,
                                "monkey-baiting: %s.%s has unsupported type '%s'\n",
                                d->name, d->fields[f].name, d->fields[f].type);
                        return 0;
                    }
                    sd.members[f].name = d->fields[f].name;
                    sd.members[f].type = ft;
                    if (d->fields[f].count > 1)
                        sd.members[f].count = d->fields[f].count;
                }
                comp = ecs_struct_init(world, &sd);
                if (!comp) {
                    fprintf(stderr, "monkey-baiting: failed to register %s\n",
                            d->name);
                    return 0;
                }
            }
        }

        /* No silent drift: the registered type must be exactly the C struct
         * the step functions index (components/README.md). */
        if (d->fields != NULL) {
            const ecs_type_info_t *ti = ecs_get_type_info(world, comp);
            if (!ti || (uint32_t)ti->size != d->size) {
                fprintf(stderr,
                        "monkey-baiting: %s registered size %d != sizeof C struct %u\n",
                        d->name, ti ? ti->size : -1, d->size);
                return 0;
            }
        }
        ids_out[i] = comp;
    }
    return 1;
}

/* ---------------------------------------------------------- column bind */

static int mb_bind_columns(MbWorld *w) {
    ecs_query_t *qm, *qf;
    ecs_iter_t it;
    int tables, bad = 0;

    qm = ecs_query(w->world, {
        .terms = {
            { .id = w->ids[MB_C_CLOCK] },    { .id = w->ids[MB_C_RNG] },
            { .id = w->ids[MB_C_PAIR] },     { .id = w->ids[MB_C_CROSS] },
            { .id = w->ids[MB_C_FINISHER] }, { .id = w->ids[MB_C_OUTCOME] },
            { .id = w->ids[MB_C_HAZARDS] },  { .id = w->ids[MB_C_MATCH_TAG] }
        },
        .cache_kind = EcsQueryCacheNone
    });
    if (!qm) { fprintf(stderr, "monkey-baiting: match query failed\n"); return 0; }

    tables = 0;
    it = ecs_query_iter(w->world, qm);
    while (ecs_query_next(&it)) {
        tables++;
        if (tables > 1 || it.count != w->batch.count) {
            bad = 1;
            ecs_iter_fini(&it);   /* root CLAUDE.md decision 7 */
            break;
        }
        w->batch.clock    = ecs_field_w_size(&it, sizeof(MbClock), 0);
        w->batch.rng      = ecs_field_w_size(&it, sizeof(MbRng), 1);
        w->batch.pair     = ecs_field_w_size(&it, sizeof(MbPair), 2);
        w->batch.cross    = ecs_field_w_size(&it, sizeof(MbCross), 3);
        w->batch.finisher = ecs_field_w_size(&it, sizeof(MbFinisher), 4);
        w->batch.outcome  = ecs_field_w_size(&it, sizeof(MbOutcome), 5);
        w->batch.hazards  = ecs_field_w_size(&it, sizeof(MbHazards), 6);
    }
    ecs_query_fini(qm);
    if (bad || tables != 1) {
        fprintf(stderr, "monkey-baiting: match slots are not a single archetype\n");
        return 0;
    }

    qf = ecs_query(w->world, {
        .terms = {
            { .id = w->ids[MB_C_BODY] },      { .id = w->ids[MB_C_VITALS] },
            { .id = w->ids[MB_C_FSM] },       { .id = w->ids[MB_C_MOVESLOT] },
            { .id = w->ids[MB_C_COOLDOWNS] }, { .id = w->ids[MB_C_RETREAT] },
            { .id = w->ids[MB_C_GRAB] },      { .id = w->ids[MB_C_YANK] },
            { .id = w->ids[MB_C_REFS] },      { .id = w->ids[MB_C_BRAIN] },
            { .id = w->ids[MB_C_INPUT] },     { .id = w->ids[MB_C_FIGHTER_TAG] }
        },
        .cache_kind = EcsQueryCacheNone
    });
    if (!qf) { fprintf(stderr, "monkey-baiting: fighter query failed\n"); return 0; }

    tables = 0;
    bad = 0;
    it = ecs_query_iter(w->world, qf);
    while (ecs_query_next(&it)) {
        tables++;
        if (tables > 1 || it.count != w->batch.count * 2) {
            bad = 1;
            ecs_iter_fini(&it);
            break;
        }
        w->batch.body      = ecs_field_w_size(&it, sizeof(MbBody), 0);
        w->batch.vitals    = ecs_field_w_size(&it, sizeof(MbVitals), 1);
        w->batch.fsm       = ecs_field_w_size(&it, sizeof(MbFsm), 2);
        w->batch.move_slot = ecs_field_w_size(&it, sizeof(MbMoveSlot), 3);
        w->batch.cd        = ecs_field_w_size(&it, sizeof(MbCooldowns), 4);
        w->batch.retreat   = ecs_field_w_size(&it, sizeof(MbRetreat), 5);
        w->batch.grab      = ecs_field_w_size(&it, sizeof(MbGrab), 6);
        w->batch.yank      = ecs_field_w_size(&it, sizeof(MbYank), 7);
        w->batch.refs      = ecs_field_w_size(&it, sizeof(MbRefs), 8);
        w->batch.brain     = ecs_field_w_size(&it, sizeof(MbBrain), 9);
        w->batch.input     = ecs_field_w_size(&it, sizeof(MbInput), 10);
    }
    ecs_query_fini(qf);
    if (bad || tables != 1) {
        fprintf(stderr, "monkey-baiting: fighters are not a single archetype\n");
        return 0;
    }
    return 1;
}

/* ------------------------------------------------------------- lifecycle */

MbWorld *mb_world_attach(ecs_world_t *host, const MbRules *rules,
                         int batch_width) {
    MbWorld *w;
    int m, side, i, n = 0;

    if (batch_width <= 0) {
        fprintf(stderr, "monkey-baiting: batch width must be > 0\n");
        return NULL;
    }
    if (!rules || rules->chars.count <= 0) {
        fprintf(stderr, "monkey-baiting: rules were not loaded\n");
        return NULL;
    }

    w = (MbWorld *)calloc(1, sizeof(MbWorld));
    if (!w) return NULL;
    w->rules = *rules;
    w->batch.rules = &w->rules;
    /* MbBatch.perfect is never NULL: until mb_world_set_perfect installs a
     * real set, it points at this empty one, and mb_world_set_queue refuses
     * any pairing that would need a policy out of it. */
    mb_perfect_init(&w->empty_perfect);
    w->batch.perfect = &w->empty_perfect;
    w->batch.count = batch_width;

    if (host) {
        w->world = host;
        w->owns_world = 0;
    } else {
        w->world = ecs_init();
        w->owns_world = 1;
    }
    if (!w->world) { free(w); return NULL; }

    w->ent_count = batch_width * 3;
    w->ents = (ecs_entity_t *)calloc((size_t)w->ent_count, sizeof(ecs_entity_t));
    if (!w->ents) { mb_world_destroy(w); return NULL; }

    if (!mb_world_register(w->world, w->ids)) {
        mb_world_destroy(w);
        return NULL;
    }

    /* Slots first, then fighters: two component sets, two archetypes, both
     * created once and never structurally touched again. */
    for (m = 0; m < batch_width; m++) {
        ecs_entity_t e = ecs_new(w->world);
        for (i = MB_C_CLOCK; i <= MB_C_MATCH_TAG; i++)
            ecs_add_id(w->world, e, w->ids[i]);
        w->ents[n++] = e;
    }
    for (m = 0; m < batch_width; m++) {
        for (side = 0; side < 2; side++) {
            ecs_entity_t e = ecs_new(w->world);
            for (i = MB_C_BODY; i <= MB_C_FIGHTER_TAG; i++)
                ecs_add_id(w->world, e, w->ids[i]);
            w->ents[n++] = e;
        }
    }
    return w;
}

int mb_world_attach_bind(MbWorld *w) {
    int m, side;
    if (!w) return 0;
    if (!mb_bind_columns(w)) return 0;

    /* Identity is written through the columns, so column index IS the
     * canonical fighter index: fighter i belongs to slot i / 2, side i % 2. */
    for (m = 0; m < w->batch.count; m++) {
        for (side = 0; side < 2; side++) {
            MbRefs *r = &w->batch.refs[MB_F(m, side)];
            r->slot = m;
            r->side = side;
            r->char_id = 0;
            r->entrant_id = -1;
            r->rounds_won = 0;
            w->batch.brain[MB_F(m, side)].bot_id = 0;
        }
        w->batch.pair[m].result_index = -1;
        mb_k_reset_slot(&w->batch, m);
    }
    return 1;
}

const ecs_entity_t *mb_world_entities(const MbWorld *w, int *count) {
    if (count) *count = w ? w->ent_count : 0;
    return w ? w->ents : NULL;
}

MbWorld *mb_world_create(const MbRules *rules, int batch_width) {
    MbWorld *w = mb_world_attach(NULL, rules, batch_width);
    if (!w) return NULL;
    if (!mb_world_attach_bind(w)) {
        mb_world_destroy(w);
        return NULL;
    }
    return w;
}

void mb_world_destroy(MbWorld *w) {
    if (!w) return;
    if (w->world) {
        if (w->owns_world) {
            ecs_fini(w->world);
        } else {
            /* Attached: the host keeps its world, so give back only what we
             * created. The bound columns die with these entities, which is
             * why nothing may touch the batch after this. */
            int i;
            for (i = 0; i < w->ent_count; i++)
                if (w->ents[i] && ecs_is_alive(w->world, w->ents[i]))
                    ecs_delete(w->world, w->ents[i]);
        }
    }
    free(w->ents);
    free(w->queue);
    free(w->results);
    free(w);
}

void mb_world_release(MbWorld *w) {
    if (!w) return;
    if (w->owns_world) {
        fprintf(stderr, "monkey-baiting: mb_world_release on an owned world\n");
        return;
    }
    w->ent_count = 0;   /* nothing to delete: the host world is going away */
    w->world = NULL;
    mb_world_destroy(w);
}

ecs_world_t *mb_world_ecs(MbWorld *w) { return w ? w->world : NULL; }
MbBatch *mb_world_batch(MbWorld *w) { return w ? &w->batch : NULL; }

/* ------------------------------------------------------------- schedule */

uint32_t mb_seed_for(const char *id0, const char *id1, int seed_index) {
    char buf[128];
    snprintf(buf, sizeof(buf), "%s|%s|%d", id0, id1, seed_index);
    return mb_fnv1a(buf);
}

int mb_world_set_perfect(MbWorld *w, const MbPerfectSet *set) {
    if (!w) return 0;
    /* The set is SHARED, not copied: one allocation per solved pair backs
     * every match in every batch, and every world, read-only. */
    w->batch.perfect = set ? set : &w->empty_perfect;
    return 1;
}

/* Validation shared by set_queue and enqueue. i is the queue index, used only
 * in the messages. Returns 1 when the pairing may be queued. */
static int mb_pairing_check(const MbWorld *w, const MbPairing *p, int i) {
    if (p->char0 < 0 || p->char0 >= w->rules.chars.count ||
        p->char1 < 0 || p->char1 >= w->rules.chars.count) {
        fprintf(stderr,
                "monkey-baiting: pairing %d references char id outside the roster\n",
                i);
        return 0;
    }
    if (p->bot0 < 0 || p->bot0 >= w->rules.bots.count ||
        p->bot1 < 0 || p->bot1 >= w->rules.bots.count) {
        fprintf(stderr,
                "monkey-baiting: pairing %d references a bot id outside the "
                "bot table\n", i);
        return 0;
    }
    /* A perfect-capable entrant resolves only when THIS ordered pair's
     * policy is loaded. Checked here because only the queue knows who is
     * drawn against whom; a refusal, never a demotion. This is also what
     * makes the !present branch in mb_policy_perfect unreachable. */
    if (mb_perfect_bot_rolls(&w->rules, p->bot0) &&
        !mb_perfect_has_pair(w->batch.perfect, p->char0, p->char1)) {
        fprintf(stderr, "monkey-baiting: pairing %d needs the solved policy "
                "perfect-%s-vs-%s, which is not loaded\n", i,
                mb_rules_char_name(p->char0), mb_rules_char_name(p->char1));
        return 0;
    }
    if (mb_perfect_bot_rolls(&w->rules, p->bot1) &&
        !mb_perfect_has_pair(w->batch.perfect, p->char1, p->char0)) {
        fprintf(stderr, "monkey-baiting: pairing %d needs the solved policy "
                "perfect-%s-vs-%s, which is not loaded\n", i,
                mb_rules_char_name(p->char1), mb_rules_char_name(p->char0));
        return 0;
    }
    return 1;
}

int mb_world_set_queue(MbWorld *w, const MbPairing *pairings, int count) {
    int i;
    if (!w || count < 0) return 0;
    for (i = 0; i < count; i++)
        if (!mb_pairing_check(w, &pairings[i], i)) return 0;
    free(w->queue);
    free(w->results);
    w->queue = (MbPairing *)calloc((size_t)count ? (size_t)count : 1,
                                   sizeof(MbPairing));
    w->results = (MbResult *)calloc((size_t)count ? (size_t)count : 1,
                                    sizeof(MbResult));
    if (!w->queue || !w->results) return 0;
    memcpy(w->queue, pairings, sizeof(MbPairing) * (size_t)count);
    w->queue_len = count;
    w->queue_next = 0;
    w->results_len = count;
    w->harvested = 0;
    for (i = 0; i < count; i++) w->results[i].winner = -2;  /* not yet played */
    return 1;
}

int mb_world_enqueue(MbWorld *w, const MbPairing *p) {
    MbPairing *q;
    MbResult *r;
    int n;
    if (!w || !p) return 0;
    n = w->queue_len;
    if (!mb_pairing_check(w, p, n)) return 0;

    q = (MbPairing *)realloc(w->queue, sizeof(MbPairing) * (size_t)(n + 1));
    if (!q) return 0;
    w->queue = q;
    r = (MbResult *)realloc(w->results, sizeof(MbResult) * (size_t)(n + 1));
    if (!r) return 0;
    w->results = r;

    w->queue[n] = *p;
    memset(&w->results[n], 0, sizeof(MbResult));
    w->results[n].winner = -2;   /* not yet played */
    w->queue_len = n + 1;
    w->results_len = n + 1;
    return 1;
}

int mb_world_fill(MbWorld *w) {
    int m, started = 0;
    for (m = 0; m < w->batch.count && w->queue_next < w->queue_len; m++) {
        MbPairing *p;
        if (w->batch.clock[m].phase != MB_PHASE_EMPTY) continue;
        p = &w->queue[w->queue_next];

        w->batch.pair[m].entrant0 = p->entrant0;
        w->batch.pair[m].entrant1 = p->entrant1;
        w->batch.pair[m].char0 = p->char0;
        w->batch.pair[m].char1 = p->char1;
        w->batch.pair[m].seed_index = p->seed_index;
        w->batch.pair[m].result_index = w->queue_next;

        w->batch.rng[m].seed = p->seed;
        w->batch.rng[m].state = p->seed;

        w->batch.refs[MB_F(m, 0)].char_id = p->char0;
        w->batch.refs[MB_F(m, 1)].char_id = p->char1;
        w->batch.refs[MB_F(m, 0)].entrant_id = p->entrant0;
        w->batch.refs[MB_F(m, 1)].entrant_id = p->entrant1;

        mb_k_begin_match(&w->batch, m);
        /* the bot survives mb_k_reset_fighter, which clears only the rolled
         * strategy - the entrant's identity is the pairing's, not the round's */
        w->batch.brain[MB_F(m, 0)].bot_id = p->bot0;
        w->batch.brain[MB_F(m, 1)].bot_id = p->bot1;
        w->queue_next++;
        started++;
    }
    return started;
}

void mb_world_tick(MbWorld *w) {
    mb_step_tick(&w->batch);
}

int mb_world_harvest(MbWorld *w) {
    int m, n = 0;
    for (m = 0; m < w->batch.count; m++) {
        MbResult *res;
        int ri;
        if (!mb_slot_finished(&w->batch, m)) continue;

        ri = w->batch.pair[m].result_index;
        if (ri < 0 || ri >= w->results_len) {
            /* cannot happen: a live slot always carries its canonical index */
            fprintf(stderr, "monkey-baiting: slot %d has no result index\n", m);
            w->batch.clock[m].phase = MB_PHASE_EMPTY;
            continue;
        }
        res = &w->results[ri];
        res->entrant0   = w->batch.pair[m].entrant0;
        res->entrant1   = w->batch.pair[m].entrant1;
        res->seed_index = w->batch.pair[m].seed_index;
        res->winner     = w->batch.outcome[m].winner;
        res->frames     = w->batch.outcome[m].frames;
        res->rounds     = w->batch.outcome[m].rounds;
        res->tie_rounds = w->batch.outcome[m].tie_rounds;
        res->timeouts   = w->batch.outcome[m].timeouts;
        res->finishers  = w->batch.outcome[m].finishers;
        res->capped     = w->batch.outcome[m].capped;
        res->drawn      = w->batch.outcome[m].drawn;
        res->rng_state  = w->batch.rng[m].state;

        w->batch.clock[m].phase = MB_PHASE_EMPTY;
        w->batch.pair[m].result_index = -1;
        w->harvested++;
        n++;
    }
    return n;
}

int mb_world_pending(const MbWorld *w) {
    int m;
    if (w->queue_next < w->queue_len) return 1;
    for (m = 0; m < w->batch.count; m++)
        if (w->batch.clock[m].phase != MB_PHASE_EMPTY) return 1;
    return 0;
}

int mb_world_run(MbWorld *w, int64_t max_ticks, int64_t *ticks_out) {
    int64_t ticks = 0;
    mb_world_fill(w);
    while (mb_world_pending(w)) {
        if (max_ticks > 0 && ticks >= max_ticks) {
            if (ticks_out) *ticks_out = ticks;
            return 0;
        }
        mb_world_tick(w);
        ticks++;
        if (mb_world_harvest(w)) mb_world_fill(w);
    }
    if (ticks_out) *ticks_out = ticks;
    return 1;
}

const MbResult *mb_world_results(const MbWorld *w, int *count) {
    if (count) *count = w->results_len;
    return w->results;
}

uint32_t mb_world_result_hash(const MbWorld *w) {
    return mb_result_hash(w->results, w->results_len);
}

uint32_t mb_result_hash(const MbResult *results, int count) {
    /* FNV-1a over the canonical result table, field by field in a fixed
     * order. Never over raw struct bytes: padding is not defined. */
    uint32_t h = 2166136261u;
    int i, k;
    for (i = 0; i < count; i++) {
        const MbResult *r = &results[i];
        int32_t v[11];
        v[0] = r->entrant0; v[1] = r->entrant1; v[2] = r->seed_index;
        v[3] = r->winner;   v[4] = r->frames;   v[5] = r->rounds;
        v[6] = r->tie_rounds; v[7] = r->timeouts; v[8] = r->finishers;
        v[9] = r->capped;   v[10] = r->drawn;
        for (k = 0; k < 11; k++) {
            uint32_t u = (uint32_t)v[k];
            int b;
            for (b = 0; b < 4; b++) {
                h ^= (u >> (b * 8)) & 0xFFu;
                h *= 16777619u;
            }
        }
        {
            uint32_t u = r->rng_state;
            int b;
            for (b = 0; b < 4; b++) {
                h ^= (u >> (b * 8)) & 0xFFu;
                h *= 16777619u;
            }
        }
    }
    return h;
}
/* MONKEY BAITING - the Flecs batch world.
 *
 * One world holds ALL live matches as entities; every tick advances the
 * entire batch by one frame. This is the critical design requirement from
 * the architecture spec section 4.1: per-tick engine overhead is a fixed
 * cost divided by the number of live matches, so stepping one match per
 * progress would pay it 17 million times instead of 17 million / W.
 *
 * Slots are allocated once and recycled in place, so the batch is a single
 * archetype for its whole life, the component columns never move, and
 * MbBatch can hold direct pointers into them. Harvest is host-side
 * scheduling (result placement plus refill from the pairing queue), not
 * simulation - the pure step functions in mb_step.c never learn that a
 * tournament exists.
 *
 * There are no globals and no file-static component ids here. Everything a
 * system needs arrives through MbWorld / MbBatch, so N worlds can run on N
 * threads (each with its own slice of the pairing queue) without sharing
 * anything but the read-only MbRules. */
#ifndef MB_WORLD_H
#define MB_WORLD_H

#include "flecs.h"
#include "mb_types.h"

#ifdef __cplusplus
extern "C" {
#endif

/* One queued match: a (pairing, seed) tuple in canonical order. */
typedef struct {
    int32_t entrant0, entrant1;
    int32_t char0, char1;
    int32_t bot0, bot1;     /* index into MbRules.bots */
    int32_t seed_index;
    uint32_t seed;          /* mulberry32 seed, see mb_seed_for */
} MbPairing;

/* One harvested result, written to its canonical slot. */
typedef struct {
    int32_t entrant0, entrant1, seed_index;
    int32_t winner, frames, rounds, tie_rounds, timeouts, finishers;
    int32_t capped, drawn;
    uint32_t rng_state;     /* generator state at harvest */
} MbResult;

typedef struct MbWorld MbWorld;

/* Creates a world with batch_width match slots (2 * batch_width fighters).
 * rules is copied. Returns NULL with a message on stderr on failure. */
MbWorld *mb_world_create(const MbRules *rules, int batch_width);

/* Destroys the world. An ATTACHED world (mb_world_attach) is not ecs_fini'd:
 * only the slot entities this MbWorld created are deleted. */
void mb_world_destroy(MbWorld *w);

/* Frees the MbWorld without touching the host world at all - for the one
 * case where the host world is ITSELF being destroyed and deleting entities
 * out of it would be a use-after-free. */
void mb_world_release(MbWorld *w);

/* ---- engine hosting (architecture stage S6) ---------------------------
 *
 * The same batch, built on an ecs_world_t somebody else owns - the engine's
 * ModelWorld. Nothing about the simulation changes: the same slot entities,
 * the same single archetype, the same bound columns, the same step
 * functions. Only ownership of the world differs, so mb_world_destroy does
 * not ecs_fini an attached world; it deletes just the entities it created.
 *
 * TWO PHASES, deliberately. The column bind is done once and never repeated
 * (mb_world.h header comment), so it must happen after the last structural
 * change to the slot entities - and an engine host wants to add its own
 * (UserEntity, EntityId, a name) so the match is visible over REST. Between
 * attach and bind the caller may add components to every entity returned by
 * mb_world_entities; after bind it may not.
 *
 * mb_world_create is exactly attach-on-its-own-world plus bind. */
MbWorld *mb_world_attach(ecs_world_t *host, const MbRules *rules,
                         int batch_width);

/* The entities backing the batch, in creation order: batch_width match slots
 * first, then 2 * batch_width fighters (fighter i is slot i / 2, side i % 2).
 * Valid from attach onward. */
const ecs_entity_t *mb_world_entities(const MbWorld *w, int *count);

/* Binds the component columns and initialises the slots. Returns 1, or 0
 * with a message on stderr when the slots are not a single archetype. */
int mb_world_attach_bind(MbWorld *w);

ecs_world_t *mb_world_ecs(MbWorld *w);
MbBatch *mb_world_batch(MbWorld *w);

/* Registers (or resolves, if already present) every component in mb_schema
 * on an arbitrary world, and checks that each registered type size matches
 * the C struct. ids_out receives one entity per mb_schema entry. */
int mb_world_register(ecs_world_t *world, ecs_entity_t *ids_out);

/* Installs the solved-policy set (mb_perfect.h). The set is SHARED, not
 * copied, and must outlive the world. Call before mb_world_set_queue, which
 * refuses any pairing whose entrants can roll `perfect` without that ordered
 * pair's policy present. Passing NULL restores the empty set. */
int mb_world_set_perfect(MbWorld *w, const MbPerfectSet *set);

/* Installs the pairing queue in canonical order. Copies the array. Each
 * pairing gets a result slot at its queue index; results are aggregated in
 * that order, never in completion order. */
int mb_world_set_queue(MbWorld *w, const MbPairing *pairings, int count);

/* Appends ONE pairing to the queue, growing the result table by one row and
 * leaving every existing row untouched. Same validation as set_queue.
 * mb_sim never uses it - it knows its whole canonical queue up front - but an
 * engine host admits matches one at a time as they are injected. */
int mb_world_enqueue(MbWorld *w, const MbPairing *p);

int mb_world_fill(MbWorld *w);        /* start queued matches in free slots */
void mb_world_tick(MbWorld *w);       /* one frame for the whole batch */
int mb_world_harvest(MbWorld *w);     /* returns matches harvested */
int mb_world_pending(const MbWorld *w);

/* Fill / tick / harvest until the queue drains or max_ticks is reached.
 * Returns 1 when everything finished, 0 when max_ticks ran out first. */
int mb_world_run(MbWorld *w, int64_t max_ticks, int64_t *ticks_out);

const MbResult *mb_world_results(const MbWorld *w, int *count);

/* FNV-1a over the canonical result table. Two runs of the same queue must
 * produce the same hash, whatever the batch width. */
uint32_t mb_world_result_hash(const MbWorld *w);

/* The same hash over a bare canonical result table - what the multi-world
 * pool (sim/mb_pool.h) aggregates into, since no single world then holds the
 * whole tournament. mb_world_result_hash is this over the world's own table. */
uint32_t mb_result_hash(const MbResult *results, int count);

/* Exact port of the per-match seeding in test/tournament.js:
 * mulberry32(fnv1a(id0 + "|" + id1 + "|" + seed)). */
uint32_t mb_seed_for(const char *id0, const char *id1, int seed_index);

#ifdef __cplusplus
}
#endif

#endif /* MB_WORLD_H */
