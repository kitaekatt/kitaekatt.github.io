#define SANDBOX "sandboxes/monkey-baiting"

/* The pairing the determinism spot-check plays on both paths. Deliberately
 * NOT app.yaml's, so the test cannot pass by accident on the config the host
 * would have built anyway. */
#define P_CHAR0 "billy"
#define P_BOT0  "house"
#define P_CHAR1 "puss"
#define P_BOT1  "chaos"
#define P_SEED  3

/* A match is bounded by the rules (max_rounds_per_match x time_seconds), so
 * this only has to exceed that. */
#define MAX_FRAMES 60000

/* ------------------------------------------------------------- the oracle */

/* The same pairing on mb_sim's path: its own world, mb_world_run, no engine.
 * Fields are built by the two rules that define entrant identity
 * (../CLAUDE.md), exactly as test_mb_engine does it. */
static int reference_row(const char *id0, const char *id1, int seed_index,
                         MbResult *out) {
    MbRules rules;
    MbWorld *w;
    MbPairing p;
    const MbResult *rs;
    int c0, b0, c1, b1, n = 0;
    int64_t ticks = 0;

    if (!mb_rules_load(&rules, SANDBOX)) return 0;
    if (!mb_rules_resolve_entrant(&rules, id0, 0, &c0, &b0)) return 0;
    if (!mb_rules_resolve_entrant(&rules, id1, 0, &c1, &b1)) return 0;

    memset(&p, 0, sizeof(p));
    p.entrant0 = 0;
    p.entrant1 = 1;
    p.char0 = c0; p.char1 = c1;
    p.bot0 = b0;  p.bot1 = b1;
    p.seed_index = seed_index;
    p.seed = mb_seed_for(id0, id1, seed_index);

    w = mb_world_create(&rules, 1);
    if (!w) return 0;
    if (!mb_world_set_queue(w, &p, 1)) { mb_world_destroy(w); return 0; }
    mb_world_run(w, MAX_FRAMES, &ticks);
    rs = mb_world_results(w, &n);
    if (!rs || n < 1) { mb_world_destroy(w); return 0; }
    *out = rs[0];
    mb_world_destroy(w);
    return 1;
}

/* Ticks the exported surface until the match is harvested. Returns frames
 * taken, or -1. */
static int tick_until_harvested(int max_frames) {
    int t;
    for (t = 1; t <= max_frames; t++) {
        wasm_tick();
        if (wasm_harvested() >= 1) return t;
    }
    return -1;
}

/* ------------------------------------------------------ totality of reads */

TEST(every_accessor_is_safe_before_init) {
    /* No engine exists yet. Nothing may crash, and nothing may claim state:
     * the documented "nothing" value is 0 (or -1 for an identity). */
    wasm_free();                    /* idempotent, and there is nothing to free */
    ASSERT_EQ(wasm_char_count(), 0);
    ASSERT_EQ(wasm_ring_left(), 0);
    ASSERT_EQ(wasm_match_phase(), 0);
    ASSERT_EQ(wasm_match_finished(), 0);
    ASSERT_EQ(wasm_hazard_count(), 0);
    ASSERT_EQ(wasm_f_x(0), 0);
    ASSERT_EQ(wasm_f_char_id(0), -1);
    ASSERT_EQ(wasm_f_facing(1), 1);
    ASSERT_EQ(wasm_harvested(), 0);
    ASSERT_EQ((int)wasm_result_hash(), 0);
    ASSERT_STR_EQ(wasm_char_name(0), "");
    /* The version stamp is compiled in, so it is readable with no engine. */
    ASSERT_STR_EQ(wasm_sim_version(), MB_SIM_VERSION);
    /* Setting input with no host is a no-op, not a crash. */
    wasm_set_human(3);
    wasm_set_input(0, wasm_in_right());
    ASSERT_EQ(wasm_get_human(), 0);
}

TEST(out_of_range_indices_return_nothing) {
    ASSERT_EQ(wasm_init(), 1);

    ASSERT_STR_EQ(wasm_char_name(-1), "");
    ASSERT_STR_EQ(wasm_char_name(9999), "");
    ASSERT_STR_EQ(wasm_bot_name(-1), "");
    ASSERT_STR_EQ(wasm_bot_name(9999), "");
    ASSERT_EQ(wasm_char_has_move(-1, 0), 0);
    ASSERT_EQ(wasm_char_has_move(0, 99), 0);
    ASSERT_EQ(wasm_char_max_health(-1), 0);
    ASSERT_EQ(wasm_hazard_kind(-1), 0);
    ASSERT_EQ(wasm_hazard_kind(999), 0);
    /* Side 2 does not exist. */
    ASSERT_EQ(wasm_f_x(2), 0);
    ASSERT_EQ(wasm_f_char_id(-1), -1);
    ASSERT_EQ(wasm_f_cooldown(0, -1), 0);
    ASSERT_EQ(wasm_f_cooldown(0, 999), 0);
    ASSERT_EQ(wasm_result_field(999, 0), 0);
    ASSERT_EQ(wasm_result_field(0, 999), 0);

    wasm_free();
}

/* --------------------------------------------------------- the read surface */

TEST(init_exposes_the_ring_and_the_cast) {
    MbRules rules;
    int i;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT(mb_rules_load(&rules, SANDBOX));

    /* Ring geometry and match structure come from app.yaml, never from the
     * shell (root CLAUDE.md decision 13: no parameter injection from
     * clients). Every one of these is a number the shell would otherwise
     * have had to hardcode. */
    ASSERT_EQ(wasm_fp_one(), MB_FP_ONE);
    ASSERT_EQ(wasm_ring_left(), rules.ring_left);
    ASSERT_EQ(wasm_ring_right(), rules.ring_right);
    ASSERT_EQ(wasm_ring_center(), rules.ring_center);
    ASSERT_EQ(wasm_logic_hz(), rules.logic_hz);
    ASSERT_EQ(wasm_time_seconds(), rules.time_seconds);
    ASSERT_EQ(wasm_wins_to_take_match(), rules.wins_to_take_match);
    ASSERT_EQ(wasm_max_rounds(), rules.max_rounds_per_match);

    /* The cast, in canonical order - the character-select list. */
    ASSERT_EQ(wasm_char_count(), rules.chars.count);
    ASSERT(wasm_char_count() > 0);
    for (i = 0; i < wasm_char_count(); i++) {
        ASSERT_STR_EQ(wasm_char_name(i), mb_rules_char_name(i));
        ASSERT_EQ(wasm_char_max_health(i), (int)rules.chars.max_health[i]);
    }

    ASSERT_EQ(wasm_bot_count(), rules.bots.count);
    ASSERT(wasm_bot_count() > 0);
    ASSERT_STR_EQ(wasm_bot_name(0), mb_rules_bot_name(0));

    /* Move keys and which character authors which - the shell greys a button
     * rather than guessing. */
    ASSERT_EQ(wasm_move_key_count(), MB_MOVE_KEYS);
    ASSERT_STR_EQ(wasm_move_key_name(MB_MK_LIGHT), "light");
    for (i = 0; i < MB_MOVE_KEYS; i++)
        ASSERT_EQ(wasm_char_has_move(0, i),
                  rules.chars.c[0].moves[i].present ? 1 : 0);

    wasm_free();
}

TEST(the_cast_palettes_come_from_the_authored_yaml) {
    /* The shell draws each fighter in its authored colours. If those had to
     * live in JavaScript, the character files and the shipped game could
     * disagree with nothing to catch it. Instead they are read out of the
     * same data/characters/<name>.yaml the rules loader used. */
    int i;
    ASSERT_EQ(wasm_init(), 1);

    /* Every character in the roster authors a palette, and each entry is a
     * hex colour, not an empty string that would draw as black. */
    for (i = 0; i < wasm_char_count(); i++) {
        char first[64];
        MbYamlDoc doc;
        char path[512];
        int j, found = 0;

        snprintf(path, sizeof(path), "%s/data/characters/%s.yaml",
                 SANDBOX, wasm_char_name(i));
        ASSERT(mb_yaml_read(path, &doc));
        for (j = 0; j < doc.n; j++) {
            if (strncmp(doc.e[j].key, "palette.", 8) == 0) {
                snprintf(first, sizeof(first), "%s", doc.e[j].key + 8);
                found = 1;
                break;
            }
        }
        ASSERT(found);
        ASSERT_STR_EQ(wasm_char_palette(i, first), doc.e[j].val);
        ASSERT(wasm_char_palette(i, first)[0] == '#');
    }

    /* An unauthored key is empty, never a plausible default colour. */
    ASSERT_STR_EQ(wasm_char_palette(0, "no_such_colour"), "");
    ASSERT_STR_EQ(wasm_char_palette(999, "fur"), "");

    wasm_free();
}

TEST(a_started_match_presents_two_live_fighters) {
    int c0 = mb_rules_char_id(P_CHAR0), c1 = mb_rules_char_id(P_CHAR1);
    int f;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);

    ASSERT_EQ(wasm_f_char_id(0), c0);
    ASSERT_EQ(wasm_f_char_id(1), c1);
    ASSERT_EQ(wasm_match_seed_index(), P_SEED);

    /* Both start at full health, facing each other, on the floor. */
    ASSERT_EQ(wasm_f_hp(0), wasm_f_max_hp(0));
    ASSERT_EQ(wasm_f_hp(1), wasm_f_max_hp(1));
    ASSERT(wasm_f_max_hp(0) > 0);
    ASSERT(wasm_f_hurt_w(0) > 0);
    ASSERT(wasm_f_hurt_h(0) > 0);
    ASSERT_EQ(wasm_f_facing(0), 1);
    ASSERT_EQ(wasm_f_facing(1), -1);
    ASSERT(wasm_f_x(0) < wasm_f_x(1));
    ASSERT_EQ(wasm_f_y(0), 0);

    /* The intro plays before the fight, exactly as the reference did. */
    ASSERT_EQ(wasm_match_phase(), MB_PHASE_INTRO);
    ASSERT_EQ(wasm_match_round(), 1);
    ASSERT_EQ(wasm_match_finished(), 0);
    ASSERT_EQ(wasm_match_winner(), -1);

    /* Ticking reaches the fight, and the clock then runs. */
    for (f = 0; f < 600 && wasm_match_phase() != MB_PHASE_FIGHT; f++)
        wasm_tick();
    ASSERT_EQ(wasm_match_phase(), MB_PHASE_FIGHT);
    /* MbClock.active is derived by match_phase for the tick it is about to
     * run, so the frame the phase FLIPS is not yet an active one; the next
     * one is. The shell reads it to decide whether to animate. */
    wasm_tick();
    ASSERT_EQ(wasm_match_active(), 1);
    ASSERT(wasm_match_timer() > 0);
    ASSERT(wasm_match_frame() > 0);

    wasm_free();
}

TEST(an_unknown_entrant_refuses_rather_than_defaulting) {
    ASSERT_EQ(wasm_init(), 1);
    /* No silent fallback (root CLAUDE.md decision 12): a bad pick from the
     * character-select screen must fail, not quietly play somebody else. */
    ASSERT_EQ(wasm_start_match("nosuchmonkey", P_BOT0, P_CHAR1, P_BOT1, 0), 0);
    ASSERT_EQ(wasm_start_match(P_CHAR0, "nosuchbot", P_CHAR1, P_BOT1, 0), 0);
    ASSERT_EQ(wasm_start_match(NULL, P_BOT0, P_CHAR1, P_BOT1, 0), 0);
    wasm_free();
}

/* ------------------------------------------------- the determinism gate */

TEST(a_match_played_through_the_exports_is_the_mb_sim_row) {
    MbResult ref;
    char id0[64], id1[64];
    int frames;

    snprintf(id0, sizeof(id0), "%s:%s", P_CHAR0, P_BOT0);
    snprintf(id1, sizeof(id1), "%s:%s", P_CHAR1, P_BOT1);
    ASSERT(reference_row(id0, id1, P_SEED, &ref));

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);

    frames = tick_until_harvested(MAX_FRAMES);
    ASSERT(frames > 0);

    /* THE GATE. Same pairing, same seed, same sim_version -> the same row,
     * whether mb_world_run stepped it or the browser's wasm_tick did. */
    ASSERT_EQ(wasm_result_field(0, 3), ref.winner);
    ASSERT_EQ(wasm_result_field(0, 4), ref.frames);
    ASSERT_EQ(wasm_result_field(0, 5), ref.rounds);
    ASSERT_EQ(wasm_result_field(0, 6), ref.tie_rounds);
    ASSERT_EQ(wasm_result_field(0, 7), ref.timeouts);
    ASSERT_EQ(wasm_result_field(0, 8), ref.finishers);
    ASSERT_EQ(wasm_result_field(0, 9), ref.capped);
    ASSERT_EQ(wasm_result_field(0, 10), ref.drawn);
    ASSERT_EQ(wasm_result_field(0, 2), ref.seed_index);

    wasm_free();
}

TEST(two_runs_of_the_same_pick_are_identical) {
    unsigned int h1, h2;
    int f1, f2;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);
    ASSERT(tick_until_harvested(MAX_FRAMES) > 0);
    h1 = wasm_result_hash();
    f1 = wasm_result_field(0, 4);
    wasm_free();

    /* A fresh engine, the same pick: the browser's "rematch" button must not
     * be able to produce a different fight. */
    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);
    ASSERT(tick_until_harvested(MAX_FRAMES) > 0);
    h2 = wasm_result_hash();
    f2 = wasm_result_field(0, 4);
    wasm_free();

    ASSERT_EQ((int)h1, (int)h2);
    ASSERT_EQ(f1, f2);
    ASSERT(f1 > 0);
}

TEST(a_different_seed_index_is_a_different_fight) {
    int frames_a, frames_b;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);
    ASSERT(tick_until_harvested(MAX_FRAMES) > 0);
    frames_a = wasm_result_field(0, 4);
    wasm_free();

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED + 1), 1);
    ASSERT(tick_until_harvested(MAX_FRAMES) > 0);
    frames_b = wasm_result_field(0, 4);
    wasm_free();

    /* Not a determinism claim - a non-triviality one. If the seed index did
     * not reach the simulation, every "next fight" would be the same fight. */
    ASSERT(frames_a != frames_b);
}

/* ------------------------------------------------------- the human seam */

TEST(an_unclaimed_side_is_played_by_its_bot) {
    int seen_nonzero = 0, f;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);
    ASSERT_EQ(wasm_get_human(), 0);

    /* Setting input bits while no side is claimed must change nothing: the
     * mask is what enables the override, so a stale wasm_set_input from a
     * previous fight cannot leak into a bot-vs-bot exhibition. */
    wasm_set_input(0, wasm_in_left());
    for (f = 0; f < 400; f++) {
        wasm_tick();
        if (wasm_f_input(0) != wasm_in_left()) seen_nonzero++;
    }
    ASSERT(seen_nonzero > 0);

    wasm_free();
}

TEST(a_claimed_side_takes_the_players_buttons) {
    int f, x0, x1;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);

    wasm_set_human(1);              /* side 0 is the player */
    ASSERT_EQ(wasm_get_human(), 1);

    /* Get past the intro so the fighters can act. */
    for (f = 0; f < 600 && wasm_match_phase() != MB_PHASE_FIGHT; f++)
        wasm_tick();
    ASSERT_EQ(wasm_match_phase(), MB_PHASE_FIGHT);

    /* Hold RIGHT. human_input runs after ai_decide, so the bits the fighter
     * carries into step_fighter are the player's, whatever the bot decided. */
    wasm_set_input(0, wasm_in_right());
    x0 = wasm_f_x(0);
    for (f = 0; f < 30; f++) {
        wasm_tick();
        ASSERT_EQ(wasm_f_input(0), wasm_in_right());
    }
    x1 = wasm_f_x(0);
    ASSERT(x1 > x0);           /* the fighter actually walked right */

    /* Hold LEFT: the same seam reverses it. */
    wasm_set_input(0, wasm_in_left());
    x0 = wasm_f_x(0);
    for (f = 0; f < 30; f++) wasm_tick();
    ASSERT(wasm_f_x(0) < x0);

    /* Side 1 was never claimed and is still its bot's. */
    ASSERT_EQ(wasm_get_human(), 1);

    wasm_free();
}

TEST(releasing_a_side_clears_its_latched_buttons) {
    int f;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);
    wasm_set_human(1);
    wasm_set_input(0, wasm_in_block());
    for (f = 0; f < 600 && wasm_match_phase() != MB_PHASE_FIGHT; f++)
        wasm_tick();

    wasm_tick();
    ASSERT_EQ(wasm_f_input(0), wasm_in_block());

    /* Handing the side back to its bot must not leave BLOCK held down. */
    wasm_set_human(0);
    ASSERT_EQ(wasm_get_human(), 0);
    wasm_set_human(1);
    wasm_tick();
    ASSERT_EQ(wasm_f_input(0), 0);

    wasm_free();
}

/* ------------------------------------- everything the shell has to draw */

TEST(the_shell_can_read_a_whole_frame_of_presentation_state) {
    int f, saw_attack = 0, saw_move_frames = 0, saw_damage = 0;

    ASSERT_EQ(wasm_init(), 1);
    ASSERT_EQ(wasm_start_match(P_CHAR0, P_BOT0, P_CHAR1, P_BOT1, P_SEED), 1);

    for (f = 0; f < 4000; f++) {
        int side;
        wasm_tick();

        /* Phase, clock and camera state: everything drawStage and the HUD
         * need, with nothing left for JS to derive from a rule. */
        ASSERT(wasm_match_phase() >= MB_PHASE_EMPTY);
        ASSERT(wasm_match_phase() <= MB_PHASE_DONE);
        ASSERT(wasm_match_phase_t() >= 0);
        ASSERT(wasm_match_freeze() >= 0);
        ASSERT(wasm_match_slowmo() >= 0);
        ASSERT(wasm_match_shake() >= 0);
        ASSERT(wasm_match_round() >= 1);

        /* Hazards are a live list, index-addressed. */
        ASSERT(wasm_hazard_count() >= 0);
        ASSERT(wasm_hazard_count() <= MB_HAZARD_CAP);
        if (wasm_hazard_count() > 0) {
            ASSERT(wasm_hazard_kind(0) >= MB_HZ_RATS);
            ASSERT(wasm_hazard_kind(0) <= MB_HZ_THROWN);
            ASSERT(wasm_hazard_dur(0) >= 0);
            ASSERT(wasm_hazard_w(0) >= 0);
            (void)wasm_hazard_x(0);
            (void)wasm_hazard_y(0);
            (void)wasm_hazard_t(0);
            (void)wasm_hazard_owner(0);
        }

        for (side = 0; side < 2; side++) {
            /* Pose inputs: the reference's specOf needed state, t, ripple,
             * blockStun, airborne and the current move's three phases. All
             * present. */
            ASSERT(wasm_f_state(side) >= MB_ST_IDLE);
            ASSERT(wasm_f_state(side) <= MB_ST_FINISH_VICTIM);
            ASSERT(wasm_f_t(side) >= 0);
            ASSERT(wasm_f_facing(side) == 1 || wasm_f_facing(side) == -1);
            ASSERT(wasm_f_y(side) >= 0);
            ASSERT(wasm_f_hp(side) <= wasm_f_max_hp(side));
            ASSERT(wasm_f_rounds_won(side) >= 0);
            (void)wasm_f_vx(side);
            (void)wasm_f_vy(side);
            (void)wasm_f_stun_t(side);
            (void)wasm_f_dazed_t(side);
            (void)wasm_f_block_stun(side);
            (void)wasm_f_ripple(side);
            (void)wasm_f_grab_t(side);
            (void)wasm_f_yank_active(side);
            (void)wasm_f_policy_kind(side);
            (void)wasm_f_cooldown(side, MB_MK_LIGHT);
            (void)wasm_cross_window();
            (void)wasm_cross_t();
            (void)wasm_cross_cheater();
            (void)wasm_cross_victim();
            (void)wasm_finisher_armed();
            (void)wasm_finisher_window();
            (void)wasm_finisher_done();

            if (wasm_f_state(side) == MB_ST_ATTACK) {
                saw_attack++;
                /* An attacking fighter always has its move's frame data, so
                 * the shell can place the pose in startup/active/recovery
                 * without a JS copy of the character files. */
                if (wasm_f_move_startup(side) + wasm_f_move_active(side) +
                    wasm_f_move_recovery(side) > 0) saw_move_frames++;
                ASSERT(wasm_f_move_key(side) >= 0);
                ASSERT(wasm_f_move_key(side) < MB_MOVE_KEYS);
                ASSERT(wasm_f_move_type(side) != MB_MT_NONE);
            }
            if (wasm_f_took_damage(side)) saw_damage++;
        }
        if (wasm_match_finished()) break;
    }

    /* A fight that never attacked and never connected would make the above
     * vacuous. */
    ASSERT(saw_attack > 0);
    ASSERT_EQ(saw_move_frames, saw_attack);
    ASSERT(saw_damage > 0);

    wasm_free();
}

int main(void) {
    TEST_SUITE("monkey-baiting WASM export surface (stage S7)");

    RUN(every_accessor_is_safe_before_init);
    RUN(out_of_range_indices_return_nothing);
    RUN(init_exposes_the_ring_and_the_cast);
    RUN(the_cast_palettes_come_from_the_authored_yaml);
    RUN(a_started_match_presents_two_live_fighters);
    RUN(an_unknown_entrant_refuses_rather_than_defaulting);
    RUN(a_match_played_through_the_exports_is_the_mb_sim_row);
    RUN(two_runs_of_the_same_pick_are_identical);
    RUN(a_different_seed_index_is_a_different_fight);
    RUN(an_unclaimed_side_is_played_by_its_bot);
    RUN(a_claimed_side_takes_the_players_buttons);
    RUN(releasing_a_side_clears_its_latched_buttons);
    RUN(the_shell_can_read_a_whole_frame_of_presentation_state);

    TEST_RESULTS();
}
