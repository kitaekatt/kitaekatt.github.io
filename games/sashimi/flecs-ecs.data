    const CGameTime *gt = ecs_get_id(g_engine->world, g_ids.game_state_e,
                                     g_ids.game_time);
    return gt ? (double)gt->tick : 0;
}

EMSCRIPTEN_KEEPALIVE
int wasm_get_tick_rate(void) {
    if (!g_engine || !g_ids.game_config_e || !g_ids.game_time_config) return 60;
    const CGameTimeConfig *tc = ecs_get_id(g_engine->world,
                                           g_ids.game_config_e,
                                           g_ids.game_time_config);
    return (tc && tc->tick_rate > 0) ? tc->tick_rate : 60;
}

/* â”€â”€ Pre-spawn telegraph exports (client presentation only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

EMSCRIPTEN_KEEPALIVE
int wasm_get_pending_count(void) { return g_pending_count; }
EMSCRIPTEN_KEEPALIVE
float wasm_get_pending_x(int i) {
    return (i >= 0 && i < g_pending_count) ? g_pending[i].x : 0.0f;
}
EMSCRIPTEN_KEEPALIVE
float wasm_get_pending_y(int i) {
    return (i >= 0 && i < g_pending_count) ? g_pending[i].y : 0.0f;
}
