      "2": [
        "frog-select-1",
        "frog-select-2",
        "frog-select-3"
      ]
    },
    "weaponFired": {
      "10": [
        "wispShot-fire"
      ],
      "8": [
        "shuriken-fire"
      ],
      "9": [
        "feather-fire"
      ]
    },
    "windup": {
      "3": [
        "slime-windup-1",
        "slime-windup-2"
      ],
      "4": [
        "wolf-windup-1"
      ],
      "5": [
        "golem-windup-1"
      ],
      "6": [
        "wisp-windup-1",
        "wisp-windup-2"
      ],
      "7": [
        "cube-windup-1"
      ]
