    RUN(projectile_stats_replace_serialized_base);
    RUN(bounce_fuel_and_failed_bounce_keeps_flying);
    RUN(single_bounce_per_tick_and_fuel_keeps_remaining);
    RUN(projectile_moves_before_damage_same_tick);
