/*
 * Sashimi native systems — simulation core of the sashimi port.
 *
 * Continuous 2D space centered on the arena origin (ArenaBounds
 * x [-9.5, 9.5], y [-6.5, 6.5]); one engine turn == one 60 Hz tick.
 * The Unity group -> engine phase mapping and per-slot ordering contract
 * live in sandboxes/sashimi/CLAUDE.md "System ordering"; per-system
 * behavior sources are ~/Dev/sashimi/{SYSTEMS,SYSTEM-GROUPS,GAMEPLAY,
 * CONTENT-ANALYSIS}.md.
 *
 * Conventions used throughout:
 *  - Collect-then-mutate: every system snapshots matching entities into
 *    static arrays before touching the world (no structural changes while a
 *    Flecs iterator is live; root CLAUDE.md decision 7).
 *  - Per-turn flags (TookDamage, Defeated-at-respawn) are removed, never set
 *    to false (root decision 8).
 *  - Static buffers are sized for the full 36-wave roster (509 scripted
 *    spawns; root decision 17).
 *  - All component reads/writes go through C mirror structs whose layout
 *    matches the Flecs-meta layout of the generated YAML schemas (same
 *    natural-alignment rules; verified by tests/test_systems.c).
 */
#include "systems.h"
#include "engine/app.h"
#include "engine/systems.h"
#include "engine/templates.h"
#include "engine/components.h"
#include "engine/history.h"
#include "engine/spatial.h"
#include "engine/faction.h"
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <stdint.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

/* ── Capacity limits (root decision 17) ─────────────────────────────── */

#define S_MAX_ENTS        4096   /* any per-tick entity snapshot */
#define S_MAX_HITPAIRS    16384  /* (attacker, victim) hit-reset registry */
#define S_MAX_WAVES       40
#define S_MAX_WAVE_ENTRIES 600   /* 509 scripted entries */
#define S_MAX_PROJ_HITS   1024   /* projectile hits recorded per tick */
#define S_TMPL_NAME       64

#define S_BROADPHASE_SLOP 0.35f  /* covers one tick of movement between the
                                    pre-move hash build and post-move
                                    collision checks (Unity order, see
                                    CLAUDE.md) */

/* ── Component mirror structs ───────────────────────────────────────── */
/* Field order matches the generated YAML schemas; C natural alignment
 * matches Flecs meta layout. */

typedef struct { float x, y; } CVec2; /* Position, Velocity, InputDirection,
                                         ChildOffset */
typedef struct { float value; } CMoveSpeed;
typedef struct { float current, max; } CHealth;
typedef struct { char *filter; } CFaction;
typedef struct {
    int32_t shape;                /* 0=none 1=circle 2=rect */
    float radius, width, height;
    ecs_bool_t enabled;
} CCollider;
typedef struct {
    float start_follow, stop_follow, start_flee, acquire_radius;
} CAISteering;
typedef struct { int32_t hero_id; } CHero;
typedef struct { float xp; int32_t level; } CExperience;
typedef struct { float cooldown; char *projectile; } CWeapon;
typedef struct { float range, speed; int32_t pierce, bounce; } CProjectile;
typedef struct {
    float damage;
    int32_t hit_limit;
    ecs_bool_t ignore_hit_limit;
    float reset_time;             /* seconds; -1 = never re-hit */
} CDamageOnHit;
typedef struct { float damage; } CPeriodicDamage;
typedef struct {
    float duration, periodic_damage;
    int32_t stat_type;            /* 1 = MovementSpeed */
    float magnitude;
    int32_t modifier_type;        /* 5=buff strongest 6=debuff strongest */
    int32_t stack_limit;
    ecs_bool_t ignore_stacks;
    int32_t charges;
    ecs_bool_t unlimited_charges;
} CStatusEffectOnHit;
typedef struct { int32_t ticks_remaining; float damage_per_tick; } CStatusPoison;
typedef struct { int32_t ticks_remaining; float magnitude; } CStatusSlow;
typedef struct { char *spawner_template; } CSpentProjectile;
typedef struct { int32_t effect; float value, move_speed; } CPickup;
typedef struct {
    int32_t id;                   /* AbilityId */
    float windup, active, recovery, cooldown;
    ecs_bool_t start_on_cooldown;
    float min_range, max_range;
} CAbilityConfig;
typedef struct { int32_t stage, ticks_remaining; } CAbilityState;
typedef struct { int32_t tick_rate; float periodic_tick_time; } CGameTimeConfig;
typedef struct { float victory_timer_seconds, game_over_delay_seconds; } CGameOverConfig;
typedef struct { float target_switch_threshold, damage_taken_ratio; } CCombatConfig;
typedef struct {
    float acceleration, trigger_distance, drop_distance;
    float gem_drop_scale, heart_drop_scale, heart_heal_ratio;
} CPickupConfig;
typedef struct { float min_x, min_y, max_x, max_y; } CArenaBounds;
typedef struct {
    int32_t max_level;
    int32_t xp[20];
    float damage[20];
    float health[20];
} CLevelTable;                    /* CreatureLevelUp / HeroLevelUp */
typedef struct {
    float bounce_limit[20], pierce_limit[20], recall_limit[20];
} CHeroLevelBonus;
typedef struct { int32_t next_wave, ticks_to_next, spawned_total; } CWaveState;
typedef struct {
    char *template_name;
    float x, y;
    int32_t ticks_remaining;
} CPendingSpawn;
typedef struct { int32_t ticks_remaining; } CTicks; /* RespawnTimer,
                                                       IFramesTimer,
                                                       DestroyOnTimer */
typedef struct { int64_t tick; } CGameTime;
typedef struct { int32_t gems, kills; } CMatchStats;

/* Runtime-only components registered natively (not part of the generated
 * data layer; the avk TookDamage pattern): */
typedef struct { ecs_entity_t target; } CEnemyTarget;
typedef struct { int32_t cooldown_ticks; } CWeaponState;  /* starts on cooldown */
typedef struct {
    ecs_entity_t shooter;         /* owning hero (damage multiplier) */
    int32_t hits, pierce_left, bounce_left;
    float dist_left;
} CProjectileRuntime;
typedef struct { int32_t hits; } CHitCount;               /* per ability activation */
typedef struct { int32_t slot; } CPossessedBy;            /* player clientId 1..4 */
typedef struct { float x, y; } CChargeDash;               /* locked dash direction */
typedef struct { ecs_entity_t hero; float speed; } CPickupMagnet;

/* ── Cached component ids (re-resolved when the world changes) ──────── */

typedef struct {
    ecs_world_t *world;
    ecs_entity_t position, velocity, input_direction, child_offset;
    ecs_entity_t move_speed, health, faction, collider, ai_steering;
    ecs_entity_t hero, experience, weapon, projectile, damage_on_hit;
    ecs_entity_t periodic_damage, status_on_hit, status_poison, status_slow;
    ecs_entity_t spent_projectile, pickup, ability_config, ability_state;
    ecs_entity_t game_time_config, game_over_config, combat_config;
    ecs_entity_t pickup_config, arena_bounds, creature_level_up,
                 hero_level_up, hero_level_bonus;
    ecs_entity_t wave_state, pending_spawn, respawn_timer, iframes_timer,
                 destroy_on_timer, defeated, game_time, match_stats;
    /* native runtime */
    ecs_entity_t took_damage, enemy_target, weapon_state, projectile_runtime,
                 hit_count, possessed_by, charge_dash, pickup_magnet,
                 locomotion_disabled, ability_initialized;
    /* config entities */
    ecs_entity_t game_config_e, game_state_e;
} Ids;

static Ids g_ids;

/* Register a native runtime component (scalar members only). */
static ecs_entity_t reg_component(ecs_world_t *w, const char *name,
                                  int size, int alignment,
                                  const ecs_member_t *members, int n) {
    ecs_entity_t c = ecs_lookup(w, name);
    if (c) return c;
    c = ecs_entity(w, { .name = name });
    ecs_set(w, c, EcsComponent, { .size = size, .alignment = alignment });
    ecs_struct_desc_t sd = { .entity = c };
    for (int i = 0; i < n && i < ECS_MEMBER_DESC_CACHE_SIZE; i++)
        sd.members[i] = members[i];
    ecs_struct_init(w, &sd);
    return c;
}

static ecs_entity_t reg_tag(ecs_world_t *w, const char *name) {
    ecs_entity_t t = ecs_lookup(w, name);
    if (t) return t;
    return ecs_entity(w, { .name = name });
}

static void register_runtime_components(Engine *engine) {
    ecs_world_t *w = engine->world;

    reg_component(w, "TookDamage", sizeof(ecs_bool_t), ECS_ALIGNOF(ecs_bool_t),
        (ecs_member_t[]){{ .name = "value", .type = ecs_id(ecs_bool_t) }}, 1);
    reg_component(w, "EnemyTarget", sizeof(CEnemyTarget),
        ECS_ALIGNOF(CEnemyTarget),
        (ecs_member_t[]){{ .name = "target", .type = ecs_id(ecs_entity_t) }}, 1);
    reg_component(w, "WeaponState", sizeof(CWeaponState),
        ECS_ALIGNOF(CWeaponState),
        (ecs_member_t[]){{ .name = "cooldown_ticks", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "ProjectileRuntime", sizeof(CProjectileRuntime),
        ECS_ALIGNOF(CProjectileRuntime),
        (ecs_member_t[]){
            { .name = "shooter", .type = ecs_id(ecs_entity_t) },
            { .name = "hits", .type = ecs_id(ecs_i32_t) },
            { .name = "pierce_left", .type = ecs_id(ecs_i32_t) },
            { .name = "bounce_left", .type = ecs_id(ecs_i32_t) },
            { .name = "dist_left", .type = ecs_id(ecs_f32_t) }}, 5);
    reg_component(w, "HitCount", sizeof(CHitCount), ECS_ALIGNOF(CHitCount),
        (ecs_member_t[]){{ .name = "hits", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "PossessedBy", sizeof(CPossessedBy),
        ECS_ALIGNOF(CPossessedBy),
        (ecs_member_t[]){{ .name = "slot", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "ChargeDash", sizeof(CChargeDash), ECS_ALIGNOF(CChargeDash),
        (ecs_member_t[]){
            { .name = "x", .type = ecs_id(ecs_f32_t) },
            { .name = "y", .type = ecs_id(ecs_f32_t) }}, 2);
    reg_component(w, "PickupMagnet", sizeof(CPickupMagnet),
        ECS_ALIGNOF(CPickupMagnet),
        (ecs_member_t[]){
            { .name = "hero", .type = ecs_id(ecs_entity_t) },
            { .name = "speed", .type = ecs_id(ecs_f32_t) }}, 2);
    reg_tag(w, "LocomotionDisabled");
    reg_tag(w, "AbilityInitialized");
}

static bool ids_resolve(Engine *engine) {
    ecs_world_t *w = engine->world;
    if (g_ids.world == w && g_ids.position) return true;
    memset(&g_ids, 0, sizeof(g_ids));
    g_ids.world = w;
#define L(field, name) g_ids.field = ecs_lookup(w, name)
    L(position, "Position");            L(velocity, "Velocity");
    L(input_direction, "InputDirection"); L(child_offset, "ChildOffset");
    L(move_speed, "MoveSpeed");         L(health, "Health");
    L(faction, "Faction");              L(collider, "Collider");
    L(ai_steering, "AISteering");       L(hero, "Hero");
    L(experience, "Experience");        L(weapon, "Weapon");
    L(projectile, "Projectile");        L(damage_on_hit, "DamageOnHit");
    L(periodic_damage, "PeriodicDamage"); L(status_on_hit, "StatusEffectOnHit");
    L(status_poison, "StatusPoison");   L(status_slow, "StatusSlow");
    L(spent_projectile, "SpentProjectile"); L(pickup, "Pickup");
    L(ability_config, "AbilityConfig"); L(ability_state, "AbilityState");
    L(game_time_config, "GameTimeConfig"); L(game_over_config, "GameOverConfig");
    L(combat_config, "CombatConfig");   L(pickup_config, "PickupConfig");
    L(arena_bounds, "ArenaBounds");     L(creature_level_up, "CreatureLevelUp");
    L(hero_level_up, "HeroLevelUp");    L(hero_level_bonus, "HeroLevelBonus");
    L(wave_state, "WaveState");         L(pending_spawn, "PendingSpawn");
    L(respawn_timer, "RespawnTimer");   L(iframes_timer, "IFramesTimer");
    L(destroy_on_timer, "DestroyOnTimer"); L(defeated, "Defeated");
    L(game_time, "GameTime");           L(match_stats, "MatchStats");
    L(took_damage, "TookDamage");       L(enemy_target, "EnemyTarget");
    L(weapon_state, "WeaponState");     L(projectile_runtime, "ProjectileRuntime");
    L(hit_count, "HitCount");           L(possessed_by, "PossessedBy");
    L(charge_dash, "ChargeDash");       L(pickup_magnet, "PickupMagnet");
    L(locomotion_disabled, "LocomotionDisabled");
    L(ability_initialized, "AbilityInitialized");
#undef L
    g_ids.game_config_e = ecs_lookup(w, "GameConfig");
    g_ids.game_state_e = ecs_lookup(w, "GameState");
    return g_ids.position && g_ids.health && g_ids.faction;
}

/* ── Shared per-tick globals ────────────────────────────────────────── */

static float g_dt = 1.0f / 60.0f;
static int g_tick_rate = 60;
static int64_t g_tick = 0;         /* GameTime.tick during this turn */
static bool g_periodic_now = false;/* is this tick a periodic (0.25 s) tick */
static int g_creature_level = 1;   /* from CreatureLevelUp table at gem count */
static float g_creature_damage_mult = 1.0f;
static float g_creature_health_mult = 1.0f;

static CArenaBounds g_bounds = { -9.5f, -6.5f, 9.5f, 6.5f };

/* Spatial hash (engine spatial.h; cell size 0.5 per sashimi convention). */
static SpatialHash g_hash;
static bool g_hash_ready = false;

/* Faction matrix. */
static FactionMatrix g_matrix;
static bool g_matrix_loaded = false;

/* Wave script (data/waves.yaml). */
typedef struct {
    char template_name[S_TMPL_NAME];
    float x, y;
    int delay_ticks;
} WaveEntry;
typedef struct { int first_entry, entry_count; } Wave;
static Wave g_waves[S_MAX_WAVES];
static WaveEntry g_wave_entries[S_MAX_WAVE_ENTRIES];
static int g_wave_count = 0;
static int g_wave_delay_ticks = 300;
static bool g_waves_loaded = false;

/* (attacker, victim) hit-reset registry — implements DamageOnHit.reset_time
 * and projectile never-rehit (-1) uniformly. */
typedef struct { uint64_t attacker, victim; int64_t next_tick; } HitPair;
static HitPair g_pairs[S_MAX_HITPAIRS];
static int g_pair_count = 0;

/* Projectile hits recorded by damage_apply this tick, consumed by
 * projectile_lifecycle (bounce/pierce/spent decisions). */
typedef struct { ecs_entity_t projectile, victim; } ProjHit;
static ProjHit g_proj_hits[S_MAX_PROJ_HITS];
static int g_proj_hit_count = 0;

/* Unit snapshot rebuilt by spatial_hash each tick and reused by targeting,
 * steering, AI and damage. */
typedef struct {
    ecs_entity_t e;
    float x, y;
    float radius;                 /* collision radius (rect -> max half extent) */
    CollisionFilter filter;
    bool is_hero, defeated;
    float health_cur, health_max;
} UnitSnap;
static UnitSnap g_units[S_MAX_ENTS];
static int g_unit_count = 0;

/* ── Small helpers ──────────────────────────────────────────────────── */

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
}
static float clampf(float v, float lo, float hi) {
    return v < lo ? lo : (v > hi ? hi : v);
}
static float dist2(float ax, float ay, float bx, float by) {
    float dx = ax - bx, dy = ay - by;
    return dx * dx + dy * dy;
}

void sashimi_input_snap(float x, float y, float *out_x, float *out_y) {
    /* Octant unit vectors, angle order (y down in screen space). Matches
     * rt-demo's rt_input_snap so rt-input.js clients behave identically. */
    static const float OCT[8][2] = {
        {  1.0f,         0.0f        },
        {  0.70710678f,  0.70710678f },
        {  0.0f,         1.0f        },
        { -0.70710678f,  0.70710678f },
        { -1.0f,         0.0f        },
        { -0.70710678f, -0.70710678f },
        {  0.0f,        -1.0f        },
        {  0.70710678f, -0.70710678f },
    };
    const float deadzone = 0.25f;
    if (x * x + y * y < deadzone * deadzone) { *out_x = 0; *out_y = 0; return; }
    float angle = atan2f(y, x);
    int oct = (int)lroundf(angle / (float)(M_PI / 4.0));
    oct = ((oct % 8) + 8) % 8;
    *out_x = OCT[oct][0];
    *out_y = OCT[oct][1];
}

/* Resolve an entity's faction filter (by Faction.filter name). Returns
 * false when the entity has no faction or the name is unknown. */
static bool entity_filter(Engine *engine, ecs_entity_t e, CollisionFilter *out) {
    const CFaction *f = ecs_get_id(engine->world, e, g_ids.faction);
    if (!f || !f->filter) return false;
    const FactionFilterDef *d = faction_matrix_filter(&g_matrix, f->filter);
    if (!d) return false;
    *out = d->filter;
    return true;
}

static bool is_defeated(Engine *engine, ecs_entity_t e) {
    return g_ids.defeated && ecs_has_id(engine->world, e, g_ids.defeated);
}

static ecs_entity_t parent_of(Engine *engine, ecs_entity_t e) {
    return ecs_get_target(engine->world, e, EcsChildOf, 0);
}

/* Root gameplay owner: walk ChildOf up to the top-most entity. */
static ecs_entity_t root_of(Engine *engine, ecs_entity_t e) {
    ecs_entity_t p = e, up;
    while ((up = parent_of(engine, p)) != 0) p = up;
    return p;
}

/* Level from an XP table: level n requires xp[n-1] gems. */
static int level_from_xp(const CLevelTable *t, int gems) {
    int lvl = 1;
    int maxl = t->max_level < 20 ? t->max_level : 20;
    while (lvl < maxl && gems >= t->xp[lvl]) lvl++;
    return lvl;
}

static const CLevelTable *hero_table(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.hero_level_up);
}
static const CLevelTable *creature_table(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.creature_level_up);
}
static const CCombatConfig *combat_config(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.combat_config);
}
static const CPickupConfig *pickup_config(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.pickup_config);
}

static float hero_damage_mult(Engine *engine, ecs_entity_t hero_e) {
    const CLevelTable *t = hero_table(engine);
    const CExperience *xp = hero_e ?
        ecs_get_id(engine->world, hero_e, g_ids.experience) : NULL;
    if (!t || !xp) return 1.0f;
    int lvl = xp->level < 1 ? 1 : (xp->level > 20 ? 20 : xp->level);
    return t->damage[lvl - 1];
}

/* ── Hit-pair registry ──────────────────────────────────────────────── */

#define S_NEVER_AGAIN INT64_MAX

static void pairs_reset(void) { g_pair_count = 0; }

static HitPair *pair_find(uint64_t a, uint64_t v) {
    for (int i = 0; i < g_pair_count; i++)
        if (g_pairs[i].attacker == a && g_pairs[i].victim == v)
            return &g_pairs[i];
    return NULL;
}

static void pairs_compact(Engine *engine) {
    int out = 0;
    for (int i = 0; i < g_pair_count; i++) {
        if (g_pairs[i].next_tick != S_NEVER_AGAIN &&
            g_pairs[i].next_tick <= g_tick)
            continue; /* expired window — safe to drop */
        if (!ecs_is_alive(engine->world, (ecs_entity_t)g_pairs[i].attacker))
            continue; /* attacker gone */
        g_pairs[out++] = g_pairs[i];
    }
    g_pair_count = out;
}

static bool pair_blocked(uint64_t a, uint64_t v) {
    HitPair *p = pair_find(a, v);
    return p && (p->next_tick == S_NEVER_AGAIN || g_tick < p->next_tick);
}

static void pair_record(Engine *engine, uint64_t a, uint64_t v, float reset_s) {
    HitPair *p = pair_find(a, v);
    int64_t next = reset_s < 0 ? S_NEVER_AGAIN
                               : g_tick + (int64_t)(reset_s * g_tick_rate + 0.5f);
    if (p) { p->next_tick = next; return; }
    if (g_pair_count >= S_MAX_HITPAIRS) {
        pairs_compact(engine);
        if (g_pair_count >= S_MAX_HITPAIRS) {
            fprintf(stderr, "sashimi: hit-pair registry full (%d)\n",
                    S_MAX_HITPAIRS);
            return; /* loud, not silent: damage still applies, reset lost */
        }
    }
    g_pairs[g_pair_count].attacker = a;
    g_pairs[g_pair_count].victim = v;
    g_pairs[g_pair_count].next_tick = next;
    g_pair_count++;
}

/* ── Wave script loader (data/waves.yaml) ───────────────────────────── */

static bool load_waves(Engine *engine) {
    char path[700];
    snprintf(path, sizeof(path), "%s%s/data/waves.yaml",
             engine->sandboxes_dir, engine->sandbox_name);
    FILE *f = fopen(path, "r");
    if (!f) {
        fprintf(stderr, "Error: sashimi waves file not found: %s\n", path);
        return false;
    }
    g_wave_count = 0;
    int entry_count = 0;
    int tick_rate = 60;
    float wave_delay_s = 5.0f;
    char line[512];
    while (fgets(line, sizeof(line), f)) {
        int wnum;
        float fx, fy;
        int dticks;
        char tname[S_TMPL_NAME];
        if (sscanf(line, "tick_rate: %d", &tick_rate) == 1) continue;
        if (sscanf(line, "wave_delay_seconds: %f", &wave_delay_s) == 1) continue;
        if (sscanf(line, "  - wave: %d", &wnum) == 1) {
            if (g_wave_count >= S_MAX_WAVES) break;
            g_waves[g_wave_count].first_entry = entry_count;
            g_waves[g_wave_count].entry_count = 0;
            g_wave_count++;
            continue;
        }
        if (sscanf(line, "      - { template: %63[^,], x: %f, y: %f, delay_ticks: %d",
                   tname, &fx, &fy, &dticks) == 4) {
            if (g_wave_count == 0 || entry_count >= S_MAX_WAVE_ENTRIES) continue;
            WaveEntry *we = &g_wave_entries[entry_count];
            snprintf(we->template_name, S_TMPL_NAME, "%s", tname);
            we->x = fx; we->y = fy; we->delay_ticks = dticks;
            g_waves[g_wave_count - 1].entry_count++;
            entry_count++;
        }
    }
    fclose(f);
    g_wave_delay_ticks = (int)(wave_delay_s * tick_rate + 0.5f);
    if (g_wave_count == 0) {
        fprintf(stderr, "Error: sashimi waves file parsed 0 waves: %s\n", path);
        return false;
    }
    fprintf(stderr, "sashimi: loaded %d waves, %d spawn entries\n",
            g_wave_count, entry_count);
    return true;
}

int sashimi_wave_count(void) { return g_wave_count; }

/* ── app_start (Init, once) ─────────────────────────────────────────── */
/* Collapses Unity's bake/bootstrap plus the named-config bridge:
 * game-specific config keys (damage_taken_ratio) that the engine's
 * named-config parser ignores are parsed here from app.yaml and written
 * onto the GameConfig entity (sandboxes/sashimi/CLAUDE.md). */

static void bridge_named_config(Engine *engine) {
    if (!engine->active_config[0]) return;

    char path[700];
    snprintf(path, sizeof(path), "%s%s/app.yaml",
             engine->sandboxes_dir, engine->sandbox_name);
    FILE *f = fopen(path, "r");
    if (!f) return;

    char needle[96];
    snprintf(needle, sizeof(needle), "  %s:", engine->active_config);
    bool in_configs = false, in_block = false;
    char line[512];
    float ratio = -1.0f;
    while (fgets(line, sizeof(line), f)) {
        if (strncmp(line, "configs:", 8) == 0) { in_configs = true; continue; }
        if (in_configs) {
            if (line[0] != ' ' && line[0] != '\n' && line[0] != '#') break;
            if (strncmp(line, needle, strlen(needle)) == 0) {
                in_block = true;
                continue;
            }
            if (in_block && strncmp(line, "  ", 2) == 0 && line[2] != ' ')
                break; /* next named config */
            if (in_block) {
                float v;
                if (sscanf(line, "    damage_taken_ratio: %f", &v) == 1)
                    ratio = v;
            }
        }
    }
    fclose(f);

    if (ratio >= 0.0f && g_ids.game_config_e) {
        CCombatConfig *cc = ecs_get_mut_id(engine->world, g_ids.game_config_e,
                                           g_ids.combat_config);
        if (cc) {
            cc->damage_taken_ratio = ratio;
            ecs_modified_id(engine->world, g_ids.game_config_e,
                            g_ids.combat_config);
            fprintf(stderr,
                    "sashimi: config '%s' -> CombatConfig.damage_taken_ratio %.3g\n",
                    engine->active_config, ratio);
        }
    }
}

static void sashimi_app_start(Engine *engine) {
    if (!ids_resolve(engine)) return;

    /* Seed RNG (drops are the only in-run randomness). FLECS_SEED pins it
     * for reproducible headless runs; unset keeps wall-clock randomness. */
    {
        const char *seed_env = getenv("FLECS_SEED");
        if (seed_env && seed_env[0]) {
            srand((unsigned)strtoul(seed_env, NULL, 10));
        } else {
            static int seed_offset = 0;
            srand((unsigned)time(NULL) + seed_offset++);
        }
    }

    /* Faction matrix. */
    char path[700];
    snprintf(path, sizeof(path), "%s%s/data/faction-matrix.yaml",
             engine->sandboxes_dir, engine->sandbox_name);
    g_matrix_loaded = faction_matrix_load(&g_matrix, path);
    if (!g_matrix_loaded) {
        fprintf(stderr, "Error: sashimi faction matrix failed to load: %s\n",
                path);
        return; /* leave app_start enabled: loud failure every tick */
    }

    /* Wave script. */
    g_waves_loaded = load_waves(engine);
    if (!g_waves_loaded) return;

    /* Spatial hash (cell 0.5 world units, sashimi convention). */
    if (g_hash_ready) spatial_hash_fini(&g_hash);
    spatial_hash_init(&g_hash, 0.5f);
    g_hash_ready = true;

    /* Arena bounds from GameConfig. */
    if (g_ids.game_config_e) {
        const CArenaBounds *b = ecs_get_id(engine->world, g_ids.game_config_e,
                                           g_ids.arena_bounds);
        if (b) g_bounds = *b;
        const CGameTimeConfig *tc = ecs_get_id(engine->world,
                                               g_ids.game_config_e,
                                               g_ids.game_time_config);
        if (tc && tc->tick_rate > 0) {
            g_tick_rate = tc->tick_rate;
            g_dt = 1.0f / (float)tc->tick_rate;
        }
    }

    pairs_reset();
    g_proj_hit_count = 0;
    g_creature_level = 1;
    g_creature_damage_mult = 1.0f;
    g_creature_health_mult = 1.0f;

    bridge_named_config(engine);

    engine_system_disable(engine, "app_start");
}

/* ── game_time (Init) ───────────────────────────────────────────────── */
/* GameTimeSystem_FixedStep + GameTimeSystem_Predicted collapsed: advance
 * GameTime.tick, derive the 0.25 s periodic-clock flag, refresh the shared
 * creature level (gems vs CreatureLevelUp thresholds). */

static void sashimi_game_time(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;
    if (!g_ids.game_state_e) return;

    CGameTime *gt = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                   g_ids.game_time);
    if (!gt) return;
    gt->tick++;
    g_tick = gt->tick;
    ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.game_time);

    int periodic_ticks = 15;
    if (g_ids.game_config_e) {
        const CGameTimeConfig *tc = ecs_get_id(engine->world,
                                               g_ids.game_config_e,
                                               g_ids.game_time_config);
        if (tc && tc->tick_rate > 0) {
            g_tick_rate = tc->tick_rate;
            g_dt = 1.0f / (float)tc->tick_rate;
            periodic_ticks = (int)(tc->periodic_tick_time * tc->tick_rate + 0.5f);
            if (periodic_ticks < 1) periodic_ticks = 1;
        }
    }
    g_periodic_now = (g_tick % periodic_ticks) == 0;

    const CMatchStats *ms = ecs_get_id(engine->world, g_ids.game_state_e,
                                       g_ids.match_stats);
    const CLevelTable *ct = creature_table(engine);
    if (ms && ct) {
        g_creature_level = level_from_xp(ct, ms->gems);
        g_creature_damage_mult = ct->damage[g_creature_level - 1];
        g_creature_health_mult = ct->health[g_creature_level - 1];
    }

    if ((g_tick % 300) == 0) pairs_compact(engine);
}

/* ── hero_ai (Init) ─────────────────────────────────────────────────── */
/* Headless replacement for ClientGameInputSystem: writes octant-snapped
 * InputDirection onto every hero not possessed by a player. Kite scoring
 * adapted from avk's archer model to continuous space: stay near weapon
 * range of the nearest enemy, avoid enemy proximity, bias toward XP gems
 * always and hearts weighted by missing health.
 *
 * OBSERVABILITY CONTRACT (sandboxes/sashimi/CLAUDE.md "Hero-AI
 * observability contract"): this system stands in for a human player and
 * may only read what a player could observe. Map-global reads of
 * on-field entities (enemies, pickups, positions, visible sizes) and own
 * hero/HUD state are allowed; reading the future is not. Specifically
 * FORBIDDEN here: the wave script (g_waves/g_wave_entries), the spawn
 * director's runtime cursor (WaveState), pre-spawn requests
 * (PendingSpawn — entities count only once materialized), RNG state
 * (rand()/seed), and un-telegraphed enemy internals (AbilityState /
 * WeaponState cooldowns, creatures' EnemyTarget). Keep it that way when
 * editing. */

#define AI_LOOKAHEAD_TICKS 18
#define AI_SAFE_RADIUS     2.05f  /* creatures threaten inside this */
#define AI_DANGER_W        140.0f
#define AI_PREF_RANGE      2.45f  /* weapon range 3.0 minus margin */
#define AI_RANGE_W         7.0f
#define AI_GEM_W           3.2f
#define AI_HEART_W         10.0f
#define AI_WALL_MARGIN     1.2f
#define AI_WALL_W          70.0f
#define AI_KEEP_DIR_BONUS  0.35f

static float ai_score(Engine *engine, float px, float py,
                      const UnitSnap *enemies, int n_enemies,
                      const CVec2 *gems, int n_gems,
                      const CVec2 *hearts, int n_hearts,
                      float missing_ratio) {
    (void)engine;
    float score = 0.0f;

    float nearest_e = 1e9f;
    for (int i = 0; i < n_enemies; i++) {
        float d = sqrtf(dist2(px, py, enemies[i].x, enemies[i].y));
        if (d < nearest_e) nearest_e = d;
        float safe = AI_SAFE_RADIUS + enemies[i].radius;
        if (d < safe) {
            float pen = (safe - d);
            score -= AI_DANGER_W * pen * pen;
        }
    }
    if (n_enemies > 0)
        score -= AI_RANGE_W * fabsf(nearest_e - AI_PREF_RANGE);

    if (n_gems > 0) {
        float best = 1e9f;
        for (int i = 0; i < n_gems; i++) {
            float d = sqrtf(dist2(px, py, gems[i].x, gems[i].y));
            if (d < best) best = d;
        }
        score -= AI_GEM_W * best;
    }
    if (n_hearts > 0 && missing_ratio > 0.05f) {
        float best = 1e9f;
        for (int i = 0; i < n_hearts; i++) {
            float d = sqrtf(dist2(px, py, hearts[i].x, hearts[i].y));
            if (d < best) best = d;
        }
        score -= AI_HEART_W * missing_ratio * best;
    }

    float wl = px - g_bounds.min_x, wr = g_bounds.max_x - px;
    float wb = py - g_bounds.min_y, wt = g_bounds.max_y - py;
    float wmin = wl; if (wr < wmin) wmin = wr;
    if (wb < wmin) wmin = wb; if (wt < wmin) wmin = wt;
    if (wmin < AI_WALL_MARGIN) {
        float pen = AI_WALL_MARGIN - wmin;
        score -= AI_WALL_W * pen * pen;
    }
    return score;
}

static void sashimi_hero_ai(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    /* Snapshot heroes needing AI. */
    static ecs_entity_t heroes[16];
    int n_heroes = 0;
    {
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.hero }, { .id = g_ids.input_direction },
                { .id = g_ids.position },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it))
            for (int i = 0; i < it.count && n_heroes < 16; i++)
                heroes[n_heroes++] = it.entities[i];
        ecs_query_fini(q);
    }
    if (n_heroes == 0) return;

    /* Snapshot enemies (creatures) and pickups. */
    static UnitSnap enemies[S_MAX_ENTS];
    int n_enemies = 0;
    {
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.ai_steering }, { .id = g_ids.position },
                { .id = g_ids.health },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it)) {
            for (int i = 0; i < it.count && n_enemies < S_MAX_ENTS; i++) {
                ecs_entity_t e = it.entities[i];
                if (is_defeated(engine, e)) continue;
                const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
                const CHealth *h = ecs_get_id(engine->world, e, g_ids.health);
                if (!p || !h || h->current <= 0) continue;
                const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
                UnitSnap *u = &enemies[n_enemies++];
                u->e = e; u->x = p->x; u->y = p->y;
                u->radius = 0.2f;
                if (c) {
                    if (c->shape == 1) u->radius = c->radius;
                    else if (c->shape == 2)
                        u->radius = (c->width > c->height ? c->width : c->height) * 0.5f;
                }
            }
        }
        ecs_query_fini(q);
    }

    static CVec2 gems[S_MAX_ENTS], hearts[64];
    int n_gems = 0, n_hearts = 0;
    {
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.pickup }, { .id = g_ids.position }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it)) {
            for (int i = 0; i < it.count; i++) {
                const CPickup *pk = ecs_get_id(engine->world, it.entities[i],
                                               g_ids.pickup);
                const CVec2 *p = ecs_get_id(engine->world, it.entities[i],
                                            g_ids.position);
                if (!pk || !p) continue;
                if (pk->effect == 1 && n_gems < S_MAX_ENTS)
                    gems[n_gems++] = *p;
                else if (pk->effect == 2 && n_hearts < 64)
                    hearts[n_hearts++] = *p;
            }
        }
        ecs_query_fini(q);
    }

    static const float OCT[9][2] = {
        { 0, 0 },
        { 1, 0 }, { 0.70710678f, 0.70710678f }, { 0, 1 },
        { -0.70710678f, 0.70710678f }, { -1, 0 },
        { -0.70710678f, -0.70710678f }, { 0, -1 },
        { 0.70710678f, -0.70710678f },
    };

    for (int h = 0; h < n_heroes; h++) {
        ecs_entity_t he = heroes[h];
        if (is_defeated(engine, he)) continue;
        if (g_ids.possessed_by &&
            ecs_has_id(engine->world, he, g_ids.possessed_by))
            continue; /* player-driven: client writes InputDirection */

        const CVec2 *pos = ecs_get_id(engine->world, he, g_ids.position);
        const CMoveSpeed *spd = ecs_get_id(engine->world, he, g_ids.move_speed);
        const CHealth *hp = ecs_get_id(engine->world, he, g_ids.health);
        CVec2 *dir = ecs_get_mut_id(engine->world, he, g_ids.input_direction);
        if (!pos || !spd || !dir) continue;

        float missing = (hp && hp->max > 0)
            ? (hp->max - hp->current) / hp->max : 0.0f;
        float step = spd->value * g_dt * AI_LOOKAHEAD_TICKS;

        float best = -1e30f;
        int best_i = 0;
        for (int c = 0; c < 9; c++) {
            float px = clampf(pos->x + OCT[c][0] * step,
                              g_bounds.min_x + 0.3f, g_bounds.max_x - 0.3f);
            float py = clampf(pos->y + OCT[c][1] * step,
                              g_bounds.min_y + 0.3f, g_bounds.max_y - 0.3f);
            float s = ai_score(engine, px, py, enemies, n_enemies,
                               gems, n_gems, hearts, n_hearts, missing);
            /* mild hysteresis: prefer keeping the current direction */
            if (dir->x == OCT[c][0] && dir->y == OCT[c][1])
                s += AI_KEEP_DIR_BONUS;
            if (s > best) { best = s; best_i = c; }
        }
        dir->x = OCT[best_i][0];
        dir->y = OCT[best_i][1];
        ecs_modified_id(engine->world, he, g_ids.input_direction);
    }
}

/* ── start_of_tick (Reset) ──────────────────────────────────────────── */
/* Clears per-tick TookDamage flags (root decision 8: remove, don't set
 * false). Unity's DamageThisTick clearing lives inside ResolveDamage. */

static void sashimi_start_of_tick(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.took_damage) return;

    static ecs_entity_t to_clear[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.took_damage }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            to_clear[n++] = it.entities[i];
    ecs_query_fini(q);
    for (int i = 0; i < n; i++)
        ecs_remove_id(engine->world, to_clear[i], g_ids.took_damage);
}

/* ── destroy_on_timer (Reset) ───────────────────────────────────────── */
/* DestroyGhostOnTimer + DestroyEntityAtTick + DestroyGhost collapsed:
 * tick down DestroyOnTimer, delete expired entities (children cascade). */

static void sashimi_destroy_on_timer(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.destroy_on_timer) return;

    static ecs_entity_t doomed[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.destroy_on_timer }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            CTicks *t = ecs_get_mut_id(engine->world, it.entities[i],
                                       g_ids.destroy_on_timer);
            if (!t) continue;
            t->ticks_remaining--;
            if (t->ticks_remaining <= 0) doomed[n++] = it.entities[i];
        }
    }
    ecs_query_fini(q);
    for (int i = 0; i < n; i++)
        ecs_delete(engine->world, doomed[i]);
}

/* ── ability_machine (Reset) ────────────────────────────────────────── */
/* AbilitySystem + the per-ability systems (Slime/Wolf/Cube attack, Cube
 * charge) collapsed into one data-driven state machine over
 * AbilityConfig/AbilityState. Stage side effects follow the
 * AbilityStateChangeSO tables (CONTENT-ANALYSIS section 3):
 *   BasicAttack: windup disables caster locomotion; active enables the
 *     hitbox collider; recovery disables it; end re-enables locomotion.
 *   Charge (id 1): as above, but windup already enables the collider and
 *     active adds a caster dash (CasterCharge) toward the locked target.
 * Ready condition: cooldown elapsed AND nearest faction-eligible enemy of
 * the caster within [min_range, max_range]. */

enum { AB_READY = 0, AB_WINDUP, AB_ACTIVE, AB_RECOVERY, AB_COOLDOWN };

/* Nearest living enemy of `attacker_filter` among units; returns distance
 * or -1. Uses the unit snapshot from the most recent spatial pass; callers
 * in the Reset phase see last tick's snapshot, so entries are re-checked
 * against the live world (entities may have despawned in Finalize). */
static float nearest_enemy(Engine *engine, CollisionFilter attacker_filter,
                           float x, float y, ecs_entity_t *out) {
    float best = -1.0f;
    ecs_entity_t best_e = 0;
    for (int i = 0; i < g_unit_count; i++) {
        UnitSnap *u = &g_units[i];
        if (u->defeated || u->health_cur <= 0) continue;
        if (!faction_filter_match(attacker_filter, u->filter)) continue;
        if (!ecs_is_alive(engine->world, u->e) || is_defeated(engine, u->e))
            continue;
        float d = sqrtf(dist2(x, y, u->x, u->y));
        if (best < 0 || d < best) { best = d; best_e = u->e; }
    }
    if (out) *out = best_e;
    return best;
}

static void ability_set_collider(Engine *engine, ecs_entity_t e, bool on) {
    CCollider *c = ecs_get_mut_id(engine->world, e, g_ids.collider);
    if (!c) return;
    c->enabled = on;
    ecs_modified_id(engine->world, e, g_ids.collider);
}

static void sashimi_ability_machine(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    static ecs_entity_t abilities[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.ability_config }, { .id = g_ids.ability_state }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            abilities[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t ab = abilities[i];
        ecs_entity_t caster = parent_of(engine, ab);
        if (!caster) continue;

        const CAbilityConfig *cfg = ecs_get_id(engine->world, ab,
                                               g_ids.ability_config);
        CAbilityState *st = ecs_get_mut_id(engine->world, ab,
                                           g_ids.ability_state);
        if (!cfg || !st) continue;

        /* Lazy init: start_on_cooldown abilities begin in cooldown. */
        if (!ecs_has_id(engine->world, ab, g_ids.ability_initialized)) {
            ecs_add_id(engine->world, ab, g_ids.ability_initialized);
            if (cfg->start_on_cooldown && cfg->cooldown > 0) {
                st->stage = AB_COOLDOWN;
                st->ticks_remaining = (int)(cfg->cooldown * g_tick_rate + 0.5f);
            }
        }

        bool caster_down = is_defeated(engine, caster);
        if (caster_down) {
            if (st->stage != AB_READY && st->stage != AB_COOLDOWN) {
                ability_set_collider(engine, ab, false);
                ecs_remove_id(engine->world, caster, g_ids.locomotion_disabled);
                ecs_remove_id(engine->world, caster, g_ids.charge_dash);
                st->stage = AB_READY;
                st->ticks_remaining = 0;
            }
            ecs_modified_id(engine->world, ab, g_ids.ability_state);
            continue;
        }

        bool is_charge = (cfg->id == 1);

        /* Advance, allowing zero-duration stages to fall through within
         * one tick (SlimeAttack windup 0). */
        for (int guard = 0; guard < 6; guard++) {
            if (st->stage == AB_READY) {
                CollisionFilter af;
                if (!entity_filter(engine, ab, &af)) break;
                const CVec2 *cp = ecs_get_id(engine->world, caster,
                                             g_ids.position);
                if (!cp) break;
                ecs_entity_t tgt = 0;
                float d = nearest_enemy(engine, af, cp->x, cp->y, &tgt);
                if (d < 0 || d < cfg->min_range || d > cfg->max_range) break;

                st->stage = AB_WINDUP;
                st->ticks_remaining = (int)(cfg->windup * g_tick_rate + 0.5f);
                ecs_add_id(engine->world, caster, g_ids.locomotion_disabled);
                if (is_charge) {
                    ability_set_collider(engine, ab, true);
                    /* Lock dash direction toward the target now. */
                    const CVec2 *tp = ecs_get_id(engine->world, tgt,
                                                 g_ids.position);
                    if (tp) {
                        float dx = tp->x - cp->x, dy = tp->y - cp->y;
                        float len = sqrtf(dx * dx + dy * dy);
                        CChargeDash dash = { len > 0 ? dx / len : 1.0f,
                                             len > 0 ? dy / len : 0.0f };
                        ecs_set_id(engine->world, ab, g_ids.charge_dash,
                                   sizeof(dash), &dash);
                    }
                }
                if (st->ticks_remaining > 0) break;
                continue; /* zero windup: fall through */
            }
            if (st->stage == AB_WINDUP) {
                if (st->ticks_remaining > 0) { st->ticks_remaining--; }
                if (st->ticks_remaining > 0) break;
                st->stage = AB_ACTIVE;
                st->ticks_remaining = (int)(cfg->active * g_tick_rate + 0.5f);
                ability_set_collider(engine, ab, true);
                CHitCount hc = { 0 };
                ecs_set_id(engine->world, ab, g_ids.hit_count, sizeof(hc), &hc);
                if (is_charge) {
                    const CChargeDash *d = ecs_get_id(engine->world, ab,
                                                      g_ids.charge_dash);
                    if (d)
                        ecs_set_id(engine->world, caster, g_ids.charge_dash,
                                   sizeof(*d), d);
                }
                if (st->ticks_remaining > 0) break;
                continue;
            }
            if (st->stage == AB_ACTIVE) {
                if (st->ticks_remaining > 0) { st->ticks_remaining--; }
                if (st->ticks_remaining > 0) break;
                st->stage = AB_RECOVERY;
                st->ticks_remaining = (int)(cfg->recovery * g_tick_rate + 0.5f);
                ability_set_collider(engine, ab, false);
                ecs_remove_id(engine->world, caster, g_ids.charge_dash);
                if (st->ticks_remaining > 0) break;
                continue;
            }
            if (st->stage == AB_RECOVERY) {
                if (st->ticks_remaining > 0) { st->ticks_remaining--; }
                if (st->ticks_remaining > 0) break;
                ecs_remove_id(engine->world, caster, g_ids.locomotion_disabled);
                if (cfg->cooldown > 0) {
                    st->stage = AB_COOLDOWN;
                    st->ticks_remaining = (int)(cfg->cooldown * g_tick_rate + 0.5f);
                } else {
                    st->stage = AB_READY;
                    st->ticks_remaining = 0;
                }
                break;
            }
            if (st->stage == AB_COOLDOWN) {
                if (st->ticks_remaining > 0) st->ticks_remaining--;
                if (st->ticks_remaining <= 0) {
                    st->stage = AB_READY;
                    st->ticks_remaining = 0;
                }
                break;
            }
            break;
        }
        ecs_modified_id(engine->world, ab, g_ids.ability_state);
    }
}

/* ── weapon_fire (Reset) ────────────────────────────────────────────── */
/* ProjectileSpawnRequestSystem: weapons fire their projectile template at
 * the nearest faction-eligible enemy within the projectile's range when
 * the cooldown elapses (WeaponState starts on cooldown, per baker). */

static void sashimi_weapon_fire(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    static ecs_entity_t weapons[256];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.weapon }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 256; i++)
            weapons[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t we = weapons[i];
        ecs_entity_t owner = parent_of(engine, we);
        if (!owner || is_defeated(engine, owner)) continue;

        const CWeapon *w = ecs_get_id(engine->world, we, g_ids.weapon);
        if (!w || !w->projectile || !w->projectile[0]) continue;

        /* Cooldown state (lazily added: starts on cooldown). */
        int cd_ticks = (int)(w->cooldown * g_tick_rate + 0.5f);
        CWeaponState *ws = ecs_get_mut_id(engine->world, we, g_ids.weapon_state);
        if (!ws) {
            CWeaponState init = { cd_ticks };
            ecs_set_id(engine->world, we, g_ids.weapon_state, sizeof(init), &init);
            continue;
        }
        if (ws->cooldown_ticks > 0) {
            ws->cooldown_ticks--;
            ecs_modified_id(engine->world, we, g_ids.weapon_state);
            if (ws->cooldown_ticks > 0) continue;
        }

        /* Projectile template stats. */
        ecs_entity_t tmpl = ecs_lookup(engine->world, w->projectile);
        if (!tmpl) continue;
        const CProjectile *pt = ecs_get_id(engine->world, tmpl, g_ids.projectile);
        if (!pt) continue;

        /* Fire position: caster position + weapon offset. */
        const CVec2 *op = ecs_get_id(engine->world, owner, g_ids.position);
        if (!op) continue;
        float fx = op->x, fy = op->y;
        const CVec2 *off = ecs_get_id(engine->world, we, g_ids.child_offset);
        if (off) { fx += off->x; fy += off->y; }

        /* Acquire the nearest enemy within the projectile's range. */
        CollisionFilter wf;
        if (!entity_filter(engine, we, &wf)) continue;
        ecs_entity_t tgt = 0;
        float d = nearest_enemy(engine, wf, fx, fy, &tgt);
        if (d < 0 || d > pt->range || !tgt) continue; /* hold fire, ready */

        const CVec2 *tp = ecs_get_id(engine->world, tgt, g_ids.position);
        if (!tp) continue;
        float dx = tp->x - fx, dy = tp->y - fy;
        float len = sqrtf(dx * dx + dy * dy);
        if (len < 1e-6f) { dx = 1; dy = 0; len = 1; }

        ecs_entity_t proj = engine_entity_spawn(engine, w->projectile, NULL);
        if (!proj) continue;

        CVec2 pos = { fx, fy };
        ecs_set_id(engine->world, proj, g_ids.position, sizeof(pos), &pos);
        CVec2 vel = { dx / len * pt->speed, dy / len * pt->speed };
        ecs_set_id(engine->world, proj, g_ids.velocity, sizeof(vel), &vel);

        /* Per-level bounce/pierce increments from the hero-specific fixed
         * arrays (HeroLevelBonus; sandboxes/sashimi/CLAUDE.md decision). */
        int pierce = pt->pierce, bounce = pt->bounce;
        const CExperience *xp = ecs_get_id(engine->world, owner,
                                           g_ids.experience);
        const CHeroLevelBonus *hb = ecs_get_id(engine->world, owner,
                                               g_ids.hero_level_bonus);
        if (xp && hb) {
            int lvl = xp->level < 1 ? 1 : (xp->level > 20 ? 20 : xp->level);
            pierce += (int)floorf(hb->pierce_limit[lvl - 1]);
            bounce += (int)floorf(hb->bounce_limit[lvl - 1]);
        }
        CProjectileRuntime rt = { owner, 0, pierce, bounce, pt->range };
        ecs_set_id(engine->world, proj, g_ids.projectile_runtime,
                   sizeof(rt), &rt);

        ws->cooldown_ticks = cd_ticks;
        ecs_modified_id(engine->world, we, g_ids.weapon_state);
    }
}

/* ── spatial_hash (Move) ────────────────────────────────────────────── */
/* SpatialHashingSystem: clear + reinsert every collidable entity (enabled
 * collider), and rebuild the shared unit snapshot used by targeting,
 * steering, abilities and damage this tick. */

static void sashimi_spatial_hash(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_hash_ready || !g_matrix_loaded) return;

    spatial_hash_clear(&g_hash);
    g_unit_count = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.position }, { .id = g_ids.collider }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count; i++) {
            ecs_entity_t e = it.entities[i];
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
            if (!p || !c || c->shape == 0 || !c->enabled) continue;
            /* Weapon colliders are Unity target-acquisition triggers (the
             * wisp weapon's is r=25); acquisition here uses the projectile
             * range instead, and weapons neither deal contact damage nor
             * take hits — keep them out of the hash. */
            if (ecs_has_id(engine->world, e, g_ids.weapon)) continue;
            float hw, hh;
            if (c->shape == 1) { hw = c->radius; hh = c->radius; }
            else { hw = c->width * 0.5f; hh = c->height * 0.5f; }
            if (hw <= 0 && hh <= 0) continue;
            spatial_hash_insert(&g_hash, (uint64_t)e, p->x, p->y, hw, hh);
        }
    }
    ecs_query_fini(q);

    /* Unit snapshot: everything with Health + Position + Faction. */
    ecs_query_t *uq = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.health }, { .id = g_ids.position },
            { .id = g_ids.faction },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t uit = ecs_query_iter(engine->world, uq);
    while (ecs_query_next(&uit)) {
        for (int i = 0; i < uit.count && g_unit_count < S_MAX_ENTS; i++) {
            ecs_entity_t e = uit.entities[i];
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            const CHealth *h = ecs_get_id(engine->world, e, g_ids.health);
            if (!p || !h) continue;
            CollisionFilter f;
            if (!entity_filter(engine, e, &f)) continue;
            UnitSnap *u = &g_units[g_unit_count];
            u->e = e; u->x = p->x; u->y = p->y;
            u->filter = f;
            u->is_hero = ecs_has_id(engine->world, e, g_ids.hero);
            u->defeated = is_defeated(engine, e);
            u->health_cur = h->current;
            u->health_max = h->max;
            const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
            u->radius = 0.2f;
            if (c) {
                if (c->shape == 1) u->radius = c->radius;
                else if (c->shape == 2)
                    u->radius = (c->width > c->height ? c->width : c->height) * 0.5f;
            }
            g_unit_count++;
        }
    }
    ecs_query_fini(uq);
}

/* ── targeting (Move) ───────────────────────────────────────────────── */
/* EnemyTargetingSystem: creatures acquire the nearest enemy-faction unit
 * within AISteering.acquire_radius, with CombatConfig.TargetSwitchThreshold
 * hysteresis (keep the current target unless another is closer by more
 * than the threshold). */

static void sashimi_targeting(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    const CCombatConfig *cc = combat_config(engine);
    float switch_thresh = cc ? cc->target_switch_threshold : 0.15f;

    static ecs_entity_t creatures[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.ai_steering }, { .id = g_ids.position }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            creatures[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = creatures[i];
        if (is_defeated(engine, e)) continue;
        const CAISteering *ai = ecs_get_id(engine->world, e, g_ids.ai_steering);
        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        if (!ai || !p) continue;

        /* Creatures target units their harm children could hit — i.e.
         * enemy-faction units. Use the unit's own faction: an enemy is a
         * unit whose filter does NOT mutually match ours as same-team
         * push (own color) but is a valid harm target. Simpler and exact
         * for the shipped content: creatures are Unit_Red, they target
         * heroes (Unit_Blue). Generic rule: candidate is a unit of a
         * different filter whose category a Red harm effect may hit. */
        CollisionFilter mine;
        if (!entity_filter(engine, e, &mine)) continue;

        ecs_entity_t cur = 0;
        const CEnemyTarget *ct = ecs_get_id(engine->world, e, g_ids.enemy_target);
        if (ct) cur = ct->target;

        float cur_d = -1.0f;
        float best_d = -1.0f;
        ecs_entity_t best_e = 0;
        for (int u = 0; u < g_unit_count; u++) {
            UnitSnap *un = &g_units[u];
            if (un->e == e || un->defeated || un->health_cur <= 0) continue;
            if (!un->is_hero) continue; /* creatures hunt heroes */
            float d = sqrtf(dist2(p->x, p->y, un->x, un->y));
            if (d > ai->acquire_radius) continue;
            if (un->e == cur) cur_d = d;
            if (best_d < 0 || d < best_d) { best_d = d; best_e = un->e; }
        }

        ecs_entity_t chosen = 0;
        if (cur_d >= 0 && (best_d < 0 || cur_d - best_d <= switch_thresh))
            chosen = cur;             /* hysteresis: keep current */
        else if (best_d >= 0)
            chosen = best_e;

        if (chosen) {
            CEnemyTarget et = { chosen };
            ecs_set_id(engine->world, e, g_ids.enemy_target, sizeof(et), &et);
        } else if (ct) {
            ecs_remove_id(engine->world, e, g_ids.enemy_target);
        }
    }
}

/* ── creature_steering (Move) ───────────────────────────────────────── */
/* CreatureMoveDirectionSystem: follow the target while farther than
 * StopFollowDistance once beyond StartFollowDistance; flee when closer
 * than StartFleeDistance (>= 0). Writes Velocity (units/second). */

static void sashimi_creature_steering(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t creatures[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.ai_steering }, { .id = g_ids.position },
            { .id = g_ids.velocity }, { .id = g_ids.move_speed },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            creatures[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = creatures[i];
        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!vel) continue;

        if (is_defeated(engine, e) ||
            ecs_has_id(engine->world, e, g_ids.locomotion_disabled)) {
            vel->x = 0; vel->y = 0;
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }

        const CAISteering *ai = ecs_get_id(engine->world, e, g_ids.ai_steering);
        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        const CMoveSpeed *ms = ecs_get_id(engine->world, e, g_ids.move_speed);
        const CEnemyTarget *ct = ecs_get_id(engine->world, e, g_ids.enemy_target);
        ecs_entity_t tgt = ct ? ct->target : 0;
        if (!ai || !p || !ms || !tgt ||
            !ecs_is_alive(engine->world, tgt) || is_defeated(engine, tgt)) {
            vel->x = 0; vel->y = 0;
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }
        const CVec2 *tp = ecs_get_id(engine->world, tgt, g_ids.position);
        if (!tp) { vel->x = 0; vel->y = 0; continue; }

        float dx = tp->x - p->x, dy = tp->y - p->y;
        float d = sqrtf(dx * dx + dy * dy);
        float nx = d > 1e-6f ? dx / d : 0, ny = d > 1e-6f ? dy / d : 0;

        bool was_moving = (vel->x != 0 || vel->y != 0);
        float sx = 0, sy = 0;
        if (ai->start_flee >= 0 && d < ai->start_flee) {
            sx = -nx; sy = -ny;                      /* flee */
        } else if (d > ai->start_follow ||
                   (was_moving && d > ai->stop_follow)) {
            sx = nx; sy = ny;                        /* follow */
        }
        vel->x = sx * ms->value;
        vel->y = sy * ms->value;
        ecs_modified_id(engine->world, e, g_ids.velocity);
    }
}

/* ── pickup_magnet (Move) ───────────────────────────────────────────── */
/* FollowerInputSystem for pickups: a hero entering the pickup's trigger
 * radius starts the magnet; the pickup then accelerates toward that hero
 * (PickupConfig.acceleration, capped at Pickup.move_speed). */

static void sashimi_pickup_magnet(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    const CPickupConfig *pc = pickup_config(engine);
    float accel = pc ? pc->acceleration : 40.0f;

    static ecs_entity_t pickups[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.pickup }, { .id = g_ids.position },
            { .id = g_ids.velocity },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            pickups[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = pickups[i];
        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        const CPickup *pk = ecs_get_id(engine->world, e, g_ids.pickup);
        const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!p || !pk || !vel) continue;

        CPickupMagnet *mag = ecs_get_mut_id(engine->world, e, g_ids.pickup_magnet);
        if (!mag) {
            /* Trigger check: any living hero within the pickup radius. */
            float trigger_r = (c && c->shape == 1) ? c->radius : 0.5f;
            for (int u = 0; u < g_unit_count; u++) {
                UnitSnap *un = &g_units[u];
                if (!un->is_hero || un->defeated || un->health_cur <= 0) continue;
                if (dist2(p->x, p->y, un->x, un->y) <= trigger_r * trigger_r) {
                    CPickupMagnet m = { un->e, 0.0f };
                    ecs_set_id(engine->world, e, g_ids.pickup_magnet,
                               sizeof(m), &m);
                    break;
                }
            }
            continue;
        }

        if (!ecs_is_alive(engine->world, mag->hero) ||
            is_defeated(engine, mag->hero)) {
            ecs_remove_id(engine->world, e, g_ids.pickup_magnet);
            vel->x = 0; vel->y = 0;
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }
        const CVec2 *hp = ecs_get_id(engine->world, mag->hero, g_ids.position);
        if (!hp) continue;

        mag->speed += accel * g_dt;
        if (mag->speed > pk->move_speed) mag->speed = pk->move_speed;
        ecs_modified_id(engine->world, e, g_ids.pickup_magnet);

        float dx = hp->x - p->x, dy = hp->y - p->y;
        float d = sqrtf(dx * dx + dy * dy);
        if (d > 1e-6f) {
            vel->x = dx / d * mag->speed;
            vel->y = dy / d * mag->speed;
        }
        ecs_modified_id(engine->world, e, g_ids.velocity);
    }
}

/* ── movement (Move) ────────────────────────────────────────────────── */
/* MoveSystem: heroes integrate InputDirection * MoveSpeed; creatures and
 * pickups integrate the Velocity written by steering/magnet. StatusSlow
 * multiplies (1 + magnitude, floored at 0). Units (entities with Health)
 * are clamped to ArenaBounds. Projectiles are integrated by
 * projectile_lifecycle, not here (Unity: ProjectileLifecycleSystem). */

static void sashimi_movement(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t movers[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.position }, { .id = g_ids.velocity }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            movers[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = movers[i];
        if (ecs_has_id(engine->world, e, g_ids.projectile)) continue;
        if (is_defeated(engine, e)) continue;

        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!vel) continue;

        /* Heroes: InputDirection * MoveSpeed. */
        const CVec2 *in = ecs_get_id(engine->world, e, g_ids.input_direction);
        if (in) {
            const CMoveSpeed *ms = ecs_get_id(engine->world, e, g_ids.move_speed);
            float spd = ms ? ms->value : 0.0f;
            vel->x = in->x * spd;
            vel->y = in->y * spd;
        }

        bool loco_off = ecs_has_id(engine->world, e, g_ids.locomotion_disabled);
        const CChargeDash *dash = ecs_get_id(engine->world, e, g_ids.charge_dash);
        float vx = vel->x, vy = vel->y;
        if (loco_off) { vx = 0; vy = 0; }
        if (dash) {
            vx = dash->x * SASHIMI_CHARGE_SPEED;
            vy = dash->y * SASHIMI_CHARGE_SPEED;
        }

        const CStatusSlow *slow = ecs_get_id(engine->world, e, g_ids.status_slow);
        if (slow) {
            float mult = 1.0f + slow->magnitude;
            if (mult < 0) mult = 0;
            vx *= mult; vy *= mult;
        }

        if (vx == 0 && vy == 0) {
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }

        CVec2 *pos = ecs_get_mut_id(engine->world, e, g_ids.position);
        if (!pos) continue;
        pos->x += vx * g_dt;
        pos->y += vy * g_dt;
        if (ecs_has_id(engine->world, e, g_ids.health)) {
            pos->x = clampf(pos->x, g_bounds.min_x, g_bounds.max_x);
            pos->y = clampf(pos->y, g_bounds.min_y, g_bounds.max_y);
        }
        ecs_modified_id(engine->world, e, g_ids.position);
        ecs_modified_id(engine->world, e, g_ids.velocity);
    }
}

/* ── child_offset_sync (Move) ───────────────────────────────────────── */
/* GameplayChildOffsetSyncSystem: children (weapons, hitboxes, auras) sit
 * at parent position + offset every tick. Port decision: a non-zero
 * offset is rotated toward the parent's current EnemyTarget (offset.x is
 * "forward"), approximating Unity's facing-relative hitboxes. */

static void sashimi_child_offset_sync(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t children[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.child_offset }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            children[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = children[i];
        ecs_entity_t parent = parent_of(engine, e);
        if (!parent) continue;
        const CVec2 *pp = ecs_get_id(engine->world, parent, g_ids.position);
        const CVec2 *off = ecs_get_id(engine->world, e, g_ids.child_offset);
        if (!pp || !off) continue;

        float ox = off->x, oy = off->y;
        if (ox != 0 || oy != 0) {
            const CEnemyTarget *ct = ecs_get_id(engine->world, parent,
                                                g_ids.enemy_target);
            if (ct && ct->target && ecs_is_alive(engine->world, ct->target)) {
                const CVec2 *tp = ecs_get_id(engine->world, ct->target,
                                             g_ids.position);
                if (tp) {
                    float dx = tp->x - pp->x, dy = tp->y - pp->y;
                    float len = sqrtf(dx * dx + dy * dy);
                    if (len > 1e-6f) {
                        float fx = dx / len, fy = dy / len;
                        float rx = ox * fx - oy * fy;
                        float ry = ox * fy + oy * fx;
                        ox = rx; oy = ry;
                    }
                }
            }
        }
        CVec2 np = { pp->x + ox, pp->y + oy };
        ecs_set_id(engine->world, e, g_ids.position, sizeof(np), &np);
    }
}

/* ── collision_push (Act) ───────────────────────────────────────────── */
/* CollisionDetection + CollisionResponse for unit-unit contacts: the
 * faction matrix makes only own-color units collide (unit pushing).
 * Overlapping pairs separate along the center line. Rect colliders are
 * treated as circles of max half extent for pushback (port decision). */

static void sashimi_collision_push(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    typedef struct { ecs_entity_t e; float px, py; } Push;
    static Push pushes[S_MAX_ENTS];
    int n_push = 0;

    for (int i = 0; i < g_unit_count; i++) {
        UnitSnap *a = &g_units[i];
        if (a->defeated) continue;
        for (int j = i + 1; j < g_unit_count; j++) {
            UnitSnap *b = &g_units[j];
            if (b->defeated) continue;
            if (!faction_filter_match(a->filter, b->filter)) continue;
            /* Only unit-vs-unit pairs push (both have Health = units). */
            float rr = a->radius + b->radius;
            float d2 = dist2(a->x, a->y, b->x, b->y);
            if (d2 >= rr * rr) continue;
            float d = sqrtf(d2);
            float overlap = rr - d;
            float nx, ny;
            if (d > 1e-6f) { nx = (b->x - a->x) / d; ny = (b->y - a->y) / d; }
            else { nx = ((int)(a->e % 2) ? 1.0f : -1.0f); ny = 0; }
            float push = overlap * 0.5f * 0.6f; /* soften to avoid jitter */
            if (n_push + 2 <= S_MAX_ENTS) {
                pushes[n_push++] = (Push){ a->e, -nx * push, -ny * push };
                pushes[n_push++] = (Push){ b->e, nx * push, ny * push };
            }
        }
    }

    for (int i = 0; i < n_push; i++) {
        CVec2 *p = ecs_get_mut_id(engine->world, pushes[i].e, g_ids.position);
        if (!p) continue;
        p->x = clampf(p->x + pushes[i].px, g_bounds.min_x, g_bounds.max_x);
        p->y = clampf(p->y + pushes[i].py, g_bounds.min_y, g_bounds.max_y);
        ecs_modified_id(engine->world, pushes[i].e, g_ids.position);
    }
}

/* ── damage_apply (Act) ─────────────────────────────────────────────── */
/* CollisionDetection (trigger path) + ApplyDamage + OnHitEffect +
 * ResolveDamage collapsed: every enabled harm collider (ability hitboxes,
 * projectiles) and — on the periodic clock — every PeriodicDamage aura
 * tests faction-eligible unit overlap and applies damage.
 *
 *  - Damage scales with the attacker's damage multiplier (hero level table
 *    via the projectile's shooter; creature level table for creature
 *    hitboxes).
 *  - Hero victims: incoming damage *= CombatConfig.damage_taken_ratio
 *    (port-added; 1.0 = shipped behavior), i-frames block hits and a fresh
 *    hit starts the i-frames window.
 *  - DamageOnHit.reset_time gates per-(attacker,victim) re-hits;
 *    hit_limit caps victims per activation (HitCount) / flight
 *    (ProjectileRuntime).
 *  - StatusEffectOnHit applies poison (periodic damage) and/or the
 *    move-speed modifier (strongest-only stacking). */

typedef struct {
    ecs_entity_t attacker;
    float x, y;
    float hw, hh;                 /* collider half extents */
    bool is_rect;
    float damage;
    int hit_limit;
    bool ignore_hit_limit;
    float reset_time;
    CollisionFilter filter;
    bool is_projectile;
    bool is_periodic;
    ecs_entity_t shooter;         /* projectile shooter (hero) */
    ecs_entity_t owner_root;      /* hitbox root (creature) */
    bool has_status;
    CStatusEffectOnHit status;
} Attacker;

static bool overlap_attacker_unit(const Attacker *a, const UnitSnap *u,
                                  Engine *engine) {
    /* Victim shape from its collider. */
    const CCollider *c = ecs_get_id(engine->world, u->e, g_ids.collider);
    bool u_rect = c && c->shape == 2;
    float ur = u->radius;
    float uhw = u_rect ? c->width * 0.5f : ur;
    float uhh = u_rect ? c->height * 0.5f : ur;

    if (!a->is_rect && !u_rect)
        return overlap_circle_circle(a->x, a->y, a->hw, u->x, u->y, ur);
    if (a->is_rect && !u_rect)
        return overlap_circle_rect(u->x, u->y, ur, a->x, a->y, a->hw, a->hh);
    if (!a->is_rect && u_rect)
        return overlap_circle_rect(a->x, a->y, a->hw, u->x, u->y, uhw, uhh);
    return overlap_aabb_aabb(a->x - a->hw, a->y - a->hh, a->x + a->hw,
                             a->y + a->hh, u->x - uhw, u->y - uhh,
                             u->x + uhw, u->y + uhh);
}

static void apply_status(Engine *engine, ecs_entity_t victim,
                         const CStatusEffectOnHit *s) {
    if (s->periodic_damage > 0) {
        CStatusPoison p = {
            (int)(s->duration * g_tick_rate + 0.5f), s->periodic_damage };
        /* StackLimit 1 + IgnoreStacks: reapplication refreshes. */
        ecs_set_id(engine->world, victim, g_ids.status_poison, sizeof(p), &p);
    }
    if (s->stat_type == 1 && s->magnitude != 0) {
        CStatusSlow cur;
        const CStatusSlow *have = ecs_get_id(engine->world, victim,
                                             g_ids.status_slow);
        int dur = (int)(s->duration * g_tick_rate + 0.5f);
        /* Strongest-only (MultiplyBuff/DebuffStrongest): keep the larger
         * absolute magnitude; equal magnitude refreshes duration. */
        if (!have || fabsf(s->magnitude) >= fabsf(have->magnitude)) {
            cur.ticks_remaining = dur;
            cur.magnitude = s->magnitude;
            ecs_set_id(engine->world, victim, g_ids.status_slow,
                       sizeof(cur), &cur);
        }
    }
}

static void deal_damage(Engine *engine, ecs_entity_t victim, bool victim_hero,
                        float amount) {
    CHealth *h = ecs_get_mut_id(engine->world, victim, g_ids.health);
    if (!h) return;
    h->current -= amount;
    ecs_modified_id(engine->world, victim, g_ids.health);
    ecs_add_id(engine->world, victim, g_ids.took_damage);
    if (victim_hero) {
        CTicks t = { SASHIMI_IFRAME_TICKS };
        ecs_set_id(engine->world, victim, g_ids.iframes_timer, sizeof(t), &t);
    }
}

static void sashimi_damage_apply(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    g_proj_hit_count = 0;

    const CCombatConfig *cc = combat_config(engine);
    float taken_ratio = cc ? cc->damage_taken_ratio : 1.0f;

    /* Collect attackers (no mutations while iterating). */
    static Attacker attackers[S_MAX_ENTS];
    int n_att = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.damage_on_hit }, { .id = g_ids.collider },
            { .id = g_ids.position },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n_att < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            const CDamageOnHit *dh = ecs_get_id(engine->world, e,
                                                g_ids.damage_on_hit);
            if (!c || !p || !dh || c->shape == 0 || !c->enabled) continue;

            ecs_entity_t root = root_of(engine, e);
            if (root != e && is_defeated(engine, root)) continue;

            Attacker *a = &attackers[n_att];
            memset(a, 0, sizeof(*a));
            a->attacker = e;
            a->x = p->x; a->y = p->y;
            a->is_rect = (c->shape == 2);
            a->hw = a->is_rect ? c->width * 0.5f : c->radius;
            a->hh = a->is_rect ? c->height * 0.5f : c->radius;
            a->damage = dh->damage;
            a->hit_limit = dh->hit_limit;
            a->ignore_hit_limit = dh->ignore_hit_limit;
            a->reset_time = dh->reset_time;
            if (!entity_filter(engine, e, &a->filter)) continue;
            const CProjectileRuntime *rt = ecs_get_id(engine->world, e,
                                                      g_ids.projectile_runtime);
            a->is_projectile = rt != NULL;
            a->shooter = rt ? rt->shooter : 0;
            a->owner_root = root;
            const CStatusEffectOnHit *s = ecs_get_id(engine->world, e,
                                                     g_ids.status_on_hit);
            if (s) { a->has_status = true; a->status = *s; }
            n_att++;
        }
    }
    ecs_query_fini(q);

    /* Periodic damage auras, on the 0.25 s clock only. */
    if (g_periodic_now) {
        ecs_query_t *pq = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.periodic_damage }, { .id = g_ids.collider },
                { .id = g_ids.position },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t pit = ecs_query_iter(engine->world, pq);
        while (ecs_query_next(&pit)) {
            for (int i = 0; i < pit.count && n_att < S_MAX_ENTS; i++) {
                ecs_entity_t e = pit.entities[i];
                const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
                const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
                const CPeriodicDamage *pd = ecs_get_id(engine->world, e,
                                                       g_ids.periodic_damage);
                if (!c || !p || !pd || c->shape == 0 || !c->enabled) continue;
                if (ecs_has_id(engine->world, e, g_ids.damage_on_hit))
                    continue; /* already collected as an on-hit attacker */
                Attacker *a = &attackers[n_att];
                memset(a, 0, sizeof(*a));
                a->attacker = e;
                a->x = p->x; a->y = p->y;
                a->is_rect = (c->shape == 2);
                a->hw = a->is_rect ? c->width * 0.5f : c->radius;
                a->hh = a->is_rect ? c->height * 0.5f : c->radius;
                a->damage = pd->damage;
                a->hit_limit = 0;
                a->ignore_hit_limit = true;
                a->reset_time = 0; /* every periodic tick */
                if (!entity_filter(engine, e, &a->filter)) continue;
                a->is_periodic = true;
                a->owner_root = root_of(engine, e);
                n_att++;
            }
        }
        ecs_query_fini(pq);
    }

    /* Apply. */
    for (int i = 0; i < n_att; i++) {
        Attacker *a = &attackers[i];

        /* Current hit budget. */
        int hits = 0;
        if (a->is_projectile) {
            const CProjectileRuntime *rt = ecs_get_id(engine->world, a->attacker,
                                                      g_ids.projectile_runtime);
            hits = rt ? rt->hits : 0;
        } else if (!a->is_periodic) {
            const CHitCount *hc = ecs_get_id(engine->world, a->attacker,
                                             g_ids.hit_count);
            hits = hc ? hc->hits : 0;
        }
        if (!a->ignore_hit_limit && a->hit_limit > 0 && hits >= a->hit_limit)
            continue;

        /* Broadphase candidates. */
        static uint64_t cand[S_MAX_ENTS];
        float ext = (a->hw > a->hh ? a->hw : a->hh) + S_BROADPHASE_SLOP;
        int n_cand = spatial_hash_query_radius(&g_hash, a->x, a->y, ext,
                                               cand, S_MAX_ENTS);
        if (n_cand > S_MAX_ENTS) n_cand = S_MAX_ENTS;

        for (int cix = 0; cix < n_cand; cix++) {
            ecs_entity_t ve = (ecs_entity_t)cand[cix];
            if (ve == a->attacker) continue;

            /* Victim must be a live unit. */
            UnitSnap *u = NULL;
            for (int k = 0; k < g_unit_count; k++)
                if (g_units[k].e == ve) { u = &g_units[k]; break; }
            if (!u || u->defeated) continue;
            const CHealth *h = ecs_get_id(engine->world, ve, g_ids.health);
            if (!h || h->current <= 0) continue;
            if (!faction_filter_match(a->filter, u->filter)) continue;

            /* Refresh victim position (may have moved since snapshot). */
            const CVec2 *vp = ecs_get_id(engine->world, ve, g_ids.position);
            UnitSnap uu = *u;
            if (vp) { uu.x = vp->x; uu.y = vp->y; }
            if (!overlap_attacker_unit(a, &uu, engine)) continue;

            if (pair_blocked((uint64_t)a->attacker, (uint64_t)ve)) continue;

            bool victim_hero = u->is_hero;
            if (victim_hero &&
                ecs_has_id(engine->world, ve, g_ids.iframes_timer))
                continue;

            float mult = 1.0f;
            if (a->shooter && ecs_is_alive(engine->world, a->shooter) &&
                ecs_has_id(engine->world, a->shooter, g_ids.hero))
                mult = hero_damage_mult(engine, a->shooter);
            else if (!a->is_projectile && a->owner_root != a->attacker &&
                     ecs_has_id(engine->world, a->owner_root, g_ids.ai_steering))
                mult = g_creature_damage_mult;

            float dmg = a->damage * mult;
            if (victim_hero) dmg *= taken_ratio;

            deal_damage(engine, ve, victim_hero, dmg);
            pair_record(engine, (uint64_t)a->attacker, (uint64_t)ve,
                        a->reset_time);
            if (a->has_status) apply_status(engine, ve, &a->status);

            hits++;
            if (a->is_projectile) {
                CProjectileRuntime *rt = ecs_get_mut_id(engine->world,
                                                        a->attacker,
                                                        g_ids.projectile_runtime);
                if (rt) {
                    rt->hits = hits;
                    ecs_modified_id(engine->world, a->attacker,
                                    g_ids.projectile_runtime);
                }
                if (g_proj_hit_count < S_MAX_PROJ_HITS) {
                    g_proj_hits[g_proj_hit_count].projectile = a->attacker;
                    g_proj_hits[g_proj_hit_count].victim = ve;
                    g_proj_hit_count++;
                }
            } else if (!a->is_periodic) {
                CHitCount hc = { hits };
                ecs_set_id(engine->world, a->attacker, g_ids.hit_count,
                           sizeof(hc), &hc);
            }

            if (!a->ignore_hit_limit && a->hit_limit > 0 &&
                hits >= a->hit_limit)
                break;
        }
    }
}

/* ── pickup_collect (Act) ───────────────────────────────────────────── */
/* PickupSystem: a magnetized pickup close enough to its hero applies —
 * gems increment MatchStats.gems (the XP currency); hearts heal
 * PickupConfig.heart_heal_ratio of max HP (live behavior; the serialized
 * Value 25 is not read). */

static void sashimi_pickup_collect(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    const CPickupConfig *pc = pickup_config(engine);
    float trigger_d = pc ? pc->trigger_distance : 0.025f;
    float heal_ratio = pc ? pc->heart_heal_ratio : 0.25f;

    static ecs_entity_t collected[S_MAX_ENTS];
    static ecs_entity_t collector[S_MAX_ENTS];
    int n = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.pickup }, { .id = g_ids.pickup_magnet }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            const CPickupMagnet *m = ecs_get_id(engine->world, e,
                                                g_ids.pickup_magnet);
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            if (!m || !p) continue;
            if (!ecs_is_alive(engine->world, m->hero)) continue;
            const CVec2 *hp = ecs_get_id(engine->world, m->hero, g_ids.position);
            if (!hp) continue;
            float d = sqrtf(dist2(p->x, p->y, hp->x, hp->y));
            /* Collect when within the trigger distance or when this tick's
             * travel would overshoot the hero. */
            if (d <= trigger_d || d <= m->speed * g_dt) {
                collected[n] = e;
                collector[n] = m->hero;
                n++;
            }
        }
    }
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        const CPickup *pk = ecs_get_id(engine->world, collected[i], g_ids.pickup);
        if (!pk) continue;
        if (pk->effect == 1) {          /* gem: XP currency */
            if (g_ids.game_state_e) {
                CMatchStats *ms = ecs_get_mut_id(engine->world,
                                                 g_ids.game_state_e,
                                                 g_ids.match_stats);
                if (ms) {
                    ms->gems++;
                    ecs_modified_id(engine->world, g_ids.game_state_e,
                                    g_ids.match_stats);
                }
            }
        } else if (pk->effect == 2) {   /* heart: heal 25% max HP */
            CHealth *h = ecs_get_mut_id(engine->world, collector[i],
                                        g_ids.health);
            if (h) {
                h->current += h->max * heal_ratio;
                if (h->current > h->max) h->current = h->max;
                ecs_modified_id(engine->world, collector[i], g_ids.health);
            }
        }
        ecs_delete(engine->world, collected[i]);
    }
}

/* ── status_effects (Act) ───────────────────────────────────────────── */
/* StatusEffectSystem: poison deals its damage on the 0.25 s periodic
 * clock; durations tick down every simulation tick; expired effects are
 * removed (remove, don't set false). */

static void sashimi_status_effects(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    /* Poison. */
    {
        static ecs_entity_t ents[S_MAX_ENTS];
        int n = 0;
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.status_poison }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it))
            for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
                ents[n++] = it.entities[i];
        ecs_query_fini(q);

        for (int i = 0; i < n; i++) {
            ecs_entity_t e = ents[i];
            CStatusPoison *p = ecs_get_mut_id(engine->world, e,
                                              g_ids.status_poison);
            if (!p) continue;
            if (g_periodic_now && !is_defeated(engine, e)) {
                bool victim_hero = ecs_has_id(engine->world, e, g_ids.hero);
                /* Poison ignores i-frames and the hero damage ratio: it is
                 * an already-applied effect, not a fresh hit (port
                 * decision, documented in CLAUDE.md). */
                CHealth *h = ecs_get_mut_id(engine->world, e, g_ids.health);
                if (h) {
                    h->current -= p->damage_per_tick;
                    ecs_modified_id(engine->world, e, g_ids.health);
                    ecs_add_id(engine->world, e, g_ids.took_damage);
                }
                (void)victim_hero;
            }
            p->ticks_remaining--;
            if (p->ticks_remaining <= 0)
                ecs_remove_id(engine->world, e, g_ids.status_poison);
            else
                ecs_modified_id(engine->world, e, g_ids.status_poison);
        }
    }

    /* Move-speed modifiers. */
    {
        static ecs_entity_t ents[S_MAX_ENTS];
        int n = 0;
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.status_slow }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it))
            for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
                ents[n++] = it.entities[i];
        ecs_query_fini(q);

        for (int i = 0; i < n; i++) {
            CStatusSlow *s = ecs_get_mut_id(engine->world, ents[i],
                                            g_ids.status_slow);
            if (!s) continue;
            s->ticks_remaining--;
            if (s->ticks_remaining <= 0)
                ecs_remove_id(engine->world, ents[i], g_ids.status_slow);
            else
                ecs_modified_id(engine->world, ents[i], g_ids.status_slow);
        }
    }
}

/* ── defeat (Act) ───────────────────────────────────────────────────── */
/* DefeatSystem: HP <= 0 enables Defeated; movement/targeting/damage all
 * skip defeated units. Consequences (drops, respawn) run in Finalize. */

static void sashimi_defeat(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t downed[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.health }, { .id = g_ids.faction }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            const CHealth *h = ecs_get_id(engine->world, e, g_ids.health);
            if (!h || h->current > 0) continue;
            if (is_defeated(engine, e)) continue;
            downed[n++] = e;
        }
    }
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = downed[i];
        ecs_add_id(engine->world, e, g_ids.defeated);
        CVec2 *v = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (v) { v->x = 0; v->y = 0; ecs_modified_id(engine->world, e, g_ids.velocity); }
    }
}

/* ── iframes (Act) ──────────────────────────────────────────────────── */

static void sashimi_iframes(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t ents[64];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.iframes_timer }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 64; i++)
            ents[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        CTicks *t = ecs_get_mut_id(engine->world, ents[i], g_ids.iframes_timer);
        if (!t) continue;
        t->ticks_remaining--;
        if (t->ticks_remaining <= 0)
            ecs_remove_id(engine->world, ents[i], g_ids.iframes_timer);
        else
            ecs_modified_id(engine->world, ents[i], g_ids.iframes_timer);
    }
}

/* ── projectile_lifecycle (Finalize) ────────────────────────────────── */
/* ProjectileLifecycleSystem: integrate projectile flight, process the
 * hits damage_apply recorded this tick (bounce retarget, pierce
 * pass-through, hit-limit spend), expire by range, spawn the
 * SpentProjectile spawner where a projectile is spent. */

static void sashimi_projectile_lifecycle(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    static ecs_entity_t projs[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.projectile }, { .id = g_ids.projectile_runtime },
            { .id = g_ids.position }, { .id = g_ids.velocity },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            projs[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = projs[i];
        const CProjectile *pt = ecs_get_id(engine->world, e, g_ids.projectile);
        const CDamageOnHit *dh = ecs_get_id(engine->world, e, g_ids.damage_on_hit);
        CProjectileRuntime *rt = ecs_get_mut_id(engine->world, e,
                                                g_ids.projectile_runtime);
        CVec2 *pos = ecs_get_mut_id(engine->world, e, g_ids.position);
        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!pt || !rt || !pos || !vel) continue;

        bool spent = false;

        /* Hits recorded this tick, in order. */
        for (int hix = 0; hix < g_proj_hit_count && !spent; hix++) {
            if (g_proj_hits[hix].projectile != e) continue;
            if (dh && !dh->ignore_hit_limit && dh->hit_limit > 0 &&
                rt->hits >= dh->hit_limit) {
                spent = true;
                break;
            }
            if (rt->bounce_left > 0) {
                rt->bounce_left--;
                /* Retarget: nearest eligible living enemy not already
                 * blocked by the hit registry, within the projectile's
                 * range. Bounce resets the remaining flight distance
                 * (port decision). */
                CollisionFilter pf;
                if (entity_filter(engine, e, &pf)) {
                    float best = -1;
                    ecs_entity_t best_e = 0;
                    for (int u = 0; u < g_unit_count; u++) {
                        UnitSnap *un = &g_units[u];
                        if (un->defeated || un->health_cur <= 0) continue;
                        if (!faction_filter_match(pf, un->filter)) continue;
                        if (!ecs_is_alive(engine->world, un->e) ||
                            is_defeated(engine, un->e)) continue;
                        if (pair_blocked((uint64_t)e, (uint64_t)un->e)) continue;
                        float d = sqrtf(dist2(pos->x, pos->y, un->x, un->y));
                        if (d > pt->range) continue;
                        if (best < 0 || d < best) { best = d; best_e = un->e; }
                    }
                    if (best_e) {
                        const CVec2 *tp = ecs_get_id(engine->world, best_e,
                                                     g_ids.position);
                        if (tp) {
                            float dx = tp->x - pos->x, dy = tp->y - pos->y;
                            float len = sqrtf(dx * dx + dy * dy);
                            if (len > 1e-6f) {
                                vel->x = dx / len * pt->speed;
                                vel->y = dy / len * pt->speed;
                                rt->dist_left = pt->range;
                            }
                        }
                    } else if (rt->pierce_left > 0) {
                        rt->pierce_left--;      /* nothing to bounce to */
                    } else {
                        spent = true;
                    }
                }
            } else if (rt->pierce_left > 0) {
                rt->pierce_left--;
            } else {
                spent = true;
            }
        }

        /* Integrate flight. */
        if (!spent) {
            pos->x += vel->x * g_dt;
            pos->y += vel->y * g_dt;
            rt->dist_left -= pt->speed * g_dt;
            if (rt->dist_left <= 0) spent = true;
            if (pos->x < g_bounds.min_x - 2 || pos->x > g_bounds.max_x + 2 ||
                pos->y < g_bounds.min_y - 2 || pos->y > g_bounds.max_y + 2)
                spent = true;
            ecs_modified_id(engine->world, e, g_ids.position);
            ecs_modified_id(engine->world, e, g_ids.velocity);
            ecs_modified_id(engine->world, e, g_ids.projectile_runtime);
        }

        if (spent) {
            const CSpentProjectile *sp = ecs_get_id(engine->world, e,
                                                    g_ids.spent_projectile);
            if (sp && sp->spawner_template && sp->spawner_template[0]) {
                ecs_entity_t spawner = engine_entity_spawn(
                    engine, sp->spawner_template, NULL);
                if (spawner) {
                    CVec2 p2 = { pos->x, pos->y };
                    ecs_set_id(engine->world, spawner, g_ids.position,
                               sizeof(p2), &p2);
                }
            }
            ecs_delete(engine->world, e);
        }
    }
}

/* ── on_defeated (Finalize) ─────────────────────────────────────────── */
/* OnDefeatedSystem: creatures roll drops (gem 50%, heart 3.75%, scattered
 * by DropDistance) and are destroyed (children cascade via ChildOf);
 * heroes start their respawn timer instead. */

static void sashimi_on_defeated(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    const CPickupConfig *pc = pickup_config(engine);
    float gem_scale = pc ? pc->gem_drop_scale : 0.5f;
    float heart_scale = pc ? pc->heart_drop_scale : 0.0375f;
    float drop_dist = pc ? pc->drop_distance : 0.5f;

    static ecs_entity_t downed[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.defeated }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            downed[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = downed[i];

        if (ecs_has_id(engine->world, e, g_ids.hero)) {
            if (!ecs_has_id(engine->world, e, g_ids.respawn_timer)) {
                CTicks t = { SASHIMI_RESPAWN_TICKS };
                ecs_set_id(engine->world, e, g_ids.respawn_timer,
                           sizeof(t), &t);
            }
            continue;
        }
        if (!ecs_has_id(engine->world, e, g_ids.ai_steering))
            continue; /* only creatures drop */

        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        float px = p ? p->x : 0, py = p ? p->y : 0;

        if (g_ids.game_state_e) {
            CMatchStats *ms = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                             g_ids.match_stats);
            if (ms) {
                ms->kills++;
                ecs_modified_id(engine->world, g_ids.game_state_e,
                                g_ids.match_stats);
            }
        }

        if ((float)rand() / (float)RAND_MAX < gem_scale) {
            ecs_entity_t gem = engine_entity_spawn(engine, "GemPickup", NULL);
            if (gem) {
                float ang = (float)rand() / (float)RAND_MAX * 2.0f * (float)M_PI;
                CVec2 gp = {
                    clampf(px + cosf(ang) * drop_dist, g_bounds.min_x, g_bounds.max_x),
                    clampf(py + sinf(ang) * drop_dist, g_bounds.min_y, g_bounds.max_y) };
                ecs_set_id(engine->world, gem, g_ids.position, sizeof(gp), &gp);
            }
        }
        if ((float)rand() / (float)RAND_MAX < heart_scale) {
            ecs_entity_t heart = engine_entity_spawn(engine, "HeartPickup", NULL);
            if (heart) {
                float ang = (float)rand() / (float)RAND_MAX * 2.0f * (float)M_PI;
                CVec2 hp2 = {
                    clampf(px + cosf(ang) * drop_dist, g_bounds.min_x, g_bounds.max_x),
                    clampf(py + sinf(ang) * drop_dist, g_bounds.min_y, g_bounds.max_y) };
                ecs_set_id(engine->world, heart, g_ids.position,
                           sizeof(hp2), &hp2);
            }
        }

        ecs_delete(engine->world, e); /* children cascade (engine-handled) */
    }
}

/* ── respawn (Finalize) ─────────────────────────────────────────────── */
/* RespawnSystem: defeated heroes come back at full health with i-frames
 * when their RespawnTimer expires. */

static void sashimi_respawn(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t ents[16];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.respawn_timer }, { .id = g_ids.hero }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 16; i++)
            ents[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = ents[i];
        CTicks *t = ecs_get_mut_id(engine->world, e, g_ids.respawn_timer);
        if (!t) continue;
        t->ticks_remaining--;
        if (t->ticks_remaining > 0) {
            ecs_modified_id(engine->world, e, g_ids.respawn_timer);
            continue;
        }
        ecs_remove_id(engine->world, e, g_ids.respawn_timer);
        ecs_remove_id(engine->world, e, g_ids.defeated);
        CHealth *h = ecs_get_mut_id(engine->world, e, g_ids.health);
        if (h) {
            h->current = h->max;
            ecs_modified_id(engine->world, e, g_ids.health);
        }
        CTicks inv = { SASHIMI_RESPAWN_IFRAME_TICKS };
        ecs_set_id(engine->world, e, g_ids.iframes_timer, sizeof(inv), &inv);
    }
}

/* ── spawn_director (Finalize) ──────────────────────────────────────── */
/* EnemySpawnSystem: advance WaveState over data/waves.yaml; when a wave
 * is due, enqueue its entries as PendingSpawn requests (per-entry
 * delay_ticks; positions are arena-space, clamped to bounds). */

static void sashimi_spawn_director(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_waves_loaded || !g_ids.game_state_e) return;

    CWaveState *ws = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                    g_ids.wave_state);
    if (!ws) return;
    if (ws->next_wave < 1 || ws->next_wave > g_wave_count) return;

    ws->ticks_to_next--;
    if (ws->ticks_to_next > 0) {
        ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.wave_state);
        return;
    }

    Wave *w = &g_waves[ws->next_wave - 1];
    for (int i = 0; i < w->entry_count; i++) {
        WaveEntry *we = &g_wave_entries[w->first_entry + i];
        char name[64];
        snprintf(name, sizeof(name), "pending_w%d_%d", ws->next_wave, i);
        ecs_entity_t e = engine_entity_create(engine, name);
        if (!e) continue;
        ecs_add_id(engine->world, e, g_ids.pending_spawn);
        CPendingSpawn *ps = ecs_get_mut_id(engine->world, e, g_ids.pending_spawn);
        if (!ps) continue;
        ps->template_name = ecs_os_strdup(we->template_name);
        ps->x = clampf(we->x, g_bounds.min_x, g_bounds.max_x);
        ps->y = clampf(we->y, g_bounds.min_y, g_bounds.max_y);
        ps->ticks_remaining = we->delay_ticks;
        ecs_modified_id(engine->world, e, g_ids.pending_spawn);
    }
    ws->spawned_total += w->entry_count;
    ws->next_wave++;
    ws->ticks_to_next = g_wave_delay_ticks;
    ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.wave_state);
}

/* ── delayed_spawn (Finalize) ───────────────────────────────────────── */
/* DelayedSpawnSystem: materialize PendingSpawn requests whose delay
 * elapsed. Creature HP scales with the shared creature level (gems vs
 * CreatureLevelUp; GAMEPLAY.md "thresholds level heroes (and creatures)
 * up"). */

static void sashimi_delayed_spawn(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    typedef struct { ecs_entity_t req; char tmpl[S_TMPL_NAME]; float x, y; } Due;
    static Due due[S_MAX_ENTS];
    int n = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.pending_spawn }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            CPendingSpawn *ps = ecs_get_mut_id(engine->world, e,
                                               g_ids.pending_spawn);
            if (!ps || !ps->template_name) continue;
            ps->ticks_remaining--;
            ecs_modified_id(engine->world, e, g_ids.pending_spawn);
            if (ps->ticks_remaining > 0) continue;
            due[n].req = e;
            snprintf(due[n].tmpl, S_TMPL_NAME, "%s", ps->template_name);
            due[n].x = ps->x;
            due[n].y = ps->y;
            n++;
        }
    }
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t spawned = engine_entity_spawn(engine, due[i].tmpl, NULL);
        if (spawned) {
            CVec2 p = { due[i].x, due[i].y };
            ecs_set_id(engine->world, spawned, g_ids.position, sizeof(p), &p);
            /* Creature level HP scaling at spawn time. */
            if (ecs_has_id(engine->world, spawned, g_ids.ai_steering) &&
                g_creature_health_mult > 1.0f) {
                CHealth *h = ecs_get_mut_id(engine->world, spawned, g_ids.health);
                if (h) {
                    h->current *= g_creature_health_mult;
                    h->max *= g_creature_health_mult;
                    ecs_modified_id(engine->world, spawned, g_ids.health);
                }
            }
        }
        ecs_delete(engine->world, due[i].req);
    }
}

/* ── level_up (Finalize) ────────────────────────────────────────────── */
/* HeroLevelUpSystem: MatchStats.gems vs HeroLevelUp thresholds. On level
 * up: health multiplier rescales max HP, hero heals to full (live
 * behavior); damage multiplier applies at hit time; bounce/pierce
 * increments apply at fire time (weapon_fire). */

static void sashimi_level_up(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.game_state_e) return;

    const CMatchStats *ms = ecs_get_id(engine->world, g_ids.game_state_e,
                                       g_ids.match_stats);
    const CLevelTable *t = hero_table(engine);
    if (!ms || !t) return;

    int target = level_from_xp(t, ms->gems);

    static ecs_entity_t heroes[16];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.hero }, { .id = g_ids.experience }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 16; i++)
            heroes[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = heroes[i];
        CExperience *xp = ecs_get_mut_id(engine->world, e, g_ids.experience);
        if (!xp) continue;
        xp->xp = (float)ms->gems;
        if (target > xp->level) {
            int old = xp->level < 1 ? 1 : xp->level;
            xp->level = target;
            CHealth *h = ecs_get_mut_id(engine->world, e, g_ids.health);
            if (h) {
                float old_mult = t->health[old - 1];
                float new_mult = t->health[target - 1];
                if (old_mult > 0)
                    h->max = h->max / old_mult * new_mult;
                h->current = h->max; /* full heal on level-up */
                ecs_modified_id(engine->world, e, g_ids.health);
            }
        }
        ecs_modified_id(engine->world, e, g_ids.experience);
    }
}

/* ── app_stop (Finalize) ────────────────────────────────────────────── */
/* ServerGameOverSystem: victory when GameTime.tick reaches
 * GameOverConfig.VictoryTimerSeconds * tick_rate (180 s = 10800 ticks);
 * defeat when every hero is defeated. Unity evaluates this at the start
 * of the next tick (BeginInitialization); checking at the end of this
 * tick is the single-world equivalent. */

static void sashimi_app_stop(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.game_state_e || !g_ids.game_config_e)
        return;

    const CGameTime *gt = ecs_get_id(engine->world, g_ids.game_state_e,
                                     g_ids.game_time);
    const CGameOverConfig *go = ecs_get_id(engine->world, g_ids.game_config_e,
                                           g_ids.game_over_config);
    const CMatchStats *ms = ecs_get_id(engine->world, g_ids.game_state_e,
                                       g_ids.match_stats);
    if (!gt || !go) return;

    int64_t victory_tick = (int64_t)(go->victory_timer_seconds * g_tick_rate + 0.5f);
    if (gt->tick >= victory_tick) {
        engine->game_over = true;
        snprintf(engine->game_over_message, sizeof(engine->game_over_message),
                 "Victory - survived %.0fs (gems %d, kills %d)",
                 go->victory_timer_seconds, ms ? ms->gems : 0,
                 ms ? ms->kills : 0);
        return;
    }

    /* Defeat: no living hero. */
    int living = 0, total = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.hero }, { .id = g_ids.health }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count; i++) {
            total++;
            if (!is_defeated(engine, it.entities[i])) living++;
        }
    }
    ecs_query_fini(q);

    if (total > 0 && living == 0) {
        engine->game_over = true;
        snprintf(engine->game_over_message, sizeof(engine->game_over_message),
                 "Defeat - all heroes down at tick %lld (gems %d, kills %d)",
                 (long long)gt->tick, ms ? ms->gems : 0, ms ? ms->kills : 0);
    }
    (void)now_ms;
}

/* ── Registration ───────────────────────────────────────────────────── */
/* Order mirrors the Unity pipeline (mapping table in
 * sandboxes/sashimi/CLAUDE.md). Legacy mode takes the sequential order
 * from app.yaml system_order; pipeline mode chains DependsOn pairs inside
 * each engine phase. */

void sashimi_register_native_systems(Engine *engine) {
    register_runtime_components(engine);
    memset(&g_ids, 0, sizeof(g_ids)); /* re-resolve against this world */
    pairs_reset();
    g_proj_hit_count = 0;
    g_unit_count = 0;
    g_matrix_loaded = false;
    g_waves_loaded = false;

    if (engine->pipeline_active) {
        /* Init: app_start (rewind DependsOn added by app.c) -> game_time
         * -> hero_ai */
        ecs_entity_t s_start = engine_system_register_pipeline(
            engine, "app_start", sashimi_app_start, engine->phase_init,
            false, 0);
        ecs_entity_t s_time = engine_system_register_pipeline(
            engine, "game_time", sashimi_game_time, engine->phase_init,
            false, s_start);
        engine_system_register_pipeline(
            engine, "hero_ai", sashimi_hero_ai, engine->phase_init,
            false, s_time);

        /* Reset: start_of_tick -> destroy_on_timer -> ability_machine ->
         * weapon_fire */
        ecs_entity_t s_sot = engine_system_register_pipeline(
            engine, "start_of_tick", sashimi_start_of_tick,
            engine->phase_reset, false, 0);
        ecs_entity_t s_dot = engine_system_register_pipeline(
            engine, "destroy_on_timer", sashimi_destroy_on_timer,
            engine->phase_reset, false, s_sot);
        ecs_entity_t s_ab = engine_system_register_pipeline(
            engine, "ability_machine", sashimi_ability_machine,
            engine->phase_reset, false, s_dot);
        engine_system_register_pipeline(
            engine, "weapon_fire", sashimi_weapon_fire,
            engine->phase_reset, false, s_ab);

        /* Move: spatial_hash -> targeting -> creature_steering ->
         * pickup_magnet -> movement -> child_offset_sync */
        ecs_entity_t s_hash = engine_system_register_pipeline(
            engine, "spatial_hash", sashimi_spatial_hash,
            engine->phase_move, false, 0);
        ecs_entity_t s_tgt = engine_system_register_pipeline(
            engine, "targeting", sashimi_targeting,
            engine->phase_move, false, s_hash);
        ecs_entity_t s_steer = engine_system_register_pipeline(
            engine, "creature_steering", sashimi_creature_steering,
            engine->phase_move, false, s_tgt);
        ecs_entity_t s_mag = engine_system_register_pipeline(
            engine, "pickup_magnet", sashimi_pickup_magnet,
            engine->phase_move, false, s_steer);
        ecs_entity_t s_move = engine_system_register_pipeline(
            engine, "movement", sashimi_movement,
            engine->phase_move, false, s_mag);
        engine_system_register_pipeline(
            engine, "child_offset_sync", sashimi_child_offset_sync,
            engine->phase_move, false, s_move);

        /* Act: collision_push -> damage_apply -> pickup_collect ->
         * status_effects -> defeat -> iframes */
        ecs_entity_t s_push = engine_system_register_pipeline(
            engine, "collision_push", sashimi_collision_push,
            engine->phase_act, false, 0);
        ecs_entity_t s_dmg = engine_system_register_pipeline(
            engine, "damage_apply", sashimi_damage_apply,
            engine->phase_act, false, s_push);
        ecs_entity_t s_pick = engine_system_register_pipeline(
            engine, "pickup_collect", sashimi_pickup_collect,
            engine->phase_act, false, s_dmg);
        ecs_entity_t s_status = engine_system_register_pipeline(
            engine, "status_effects", sashimi_status_effects,
            engine->phase_act, false, s_pick);
        ecs_entity_t s_defeat = engine_system_register_pipeline(
            engine, "defeat", sashimi_defeat,
            engine->phase_act, false, s_status);
        engine_system_register_pipeline(
            engine, "iframes", sashimi_iframes,
            engine->phase_act, false, s_defeat);

        /* Finalize: projectile_lifecycle -> on_defeated -> respawn ->
         * spawn_director -> delayed_spawn -> level_up -> app_stop
         * (history_capture is chained after app_stop by app.c) */
        ecs_entity_t s_proj = engine_system_register_pipeline(
            engine, "projectile_lifecycle", sashimi_projectile_lifecycle,
            engine->phase_finalize, false, 0);
        ecs_entity_t s_od = engine_system_register_pipeline(
            engine, "on_defeated", sashimi_on_defeated,
            engine->phase_finalize, false, s_proj);
        ecs_entity_t s_resp = engine_system_register_pipeline(
            engine, "respawn", sashimi_respawn,
            engine->phase_finalize, false, s_od);
        ecs_entity_t s_dir = engine_system_register_pipeline(
            engine, "spawn_director", sashimi_spawn_director,
            engine->phase_finalize, false, s_resp);
        ecs_entity_t s_ds = engine_system_register_pipeline(
            engine, "delayed_spawn", sashimi_delayed_spawn,
            engine->phase_finalize, false, s_dir);
        ecs_entity_t s_lvl = engine_system_register_pipeline(
            engine, "level_up", sashimi_level_up,
            engine->phase_finalize, false, s_ds);
        engine_system_register_pipeline(
            engine, "app_stop", sashimi_app_stop,
            engine->phase_finalize, false, s_lvl);
    } else {
        engine_system_register_native(engine, "app_start", sashimi_app_start);
        engine_system_register_native(engine, "game_time", sashimi_game_time);
        engine_system_register_native(engine, "hero_ai", sashimi_hero_ai);
        engine_system_register_native(engine, "start_of_tick", sashimi_start_of_tick);
        engine_system_register_native(engine, "destroy_on_timer", sashimi_destroy_on_timer);
        engine_system_register_native(engine, "ability_machine", sashimi_ability_machine);
        engine_system_register_native(engine, "weapon_fire", sashimi_weapon_fire);
        engine_system_register_native(engine, "spatial_hash", sashimi_spatial_hash);
        engine_system_register_native(engine, "targeting", sashimi_targeting);
        engine_system_register_native(engine, "creature_steering", sashimi_creature_steering);
        engine_system_register_native(engine, "pickup_magnet", sashimi_pickup_magnet);
        engine_system_register_native(engine, "movement", sashimi_movement);
        engine_system_register_native(engine, "child_offset_sync", sashimi_child_offset_sync);
        engine_system_register_native(engine, "collision_push", sashimi_collision_push);
        engine_system_register_native(engine, "damage_apply", sashimi_damage_apply);
        engine_system_register_native(engine, "pickup_collect", sashimi_pickup_collect);
        engine_system_register_native(engine, "status_effects", sashimi_status_effects);
        engine_system_register_native(engine, "defeat", sashimi_defeat);
        engine_system_register_native(engine, "iframes", sashimi_iframes);
        engine_system_register_native(engine, "projectile_lifecycle", sashimi_projectile_lifecycle);
        engine_system_register_native(engine, "on_defeated", sashimi_on_defeated);
        engine_system_register_native(engine, "respawn", sashimi_respawn);
        engine_system_register_native(engine, "spawn_director", sashimi_spawn_director);
        engine_system_register_native(engine, "delayed_spawn", sashimi_delayed_spawn);
        engine_system_register_native(engine, "level_up", sashimi_level_up);
        engine_system_register_native(engine, "app_stop", sashimi_app_stop);
    }
}
#ifndef SASHIMI_SYSTEMS_H
#define SASHIMI_SYSTEMS_H

#include "engine/engine.h"

/* Sashimi native systems — the simulation core of the sashimi port
 * (docs/sashimi-port-proposal.md; ordering mapping in
 * sandboxes/sashimi/CLAUDE.md "System ordering").
 *
 * One engine turn == one 60 Hz tick (GameTimeConfig.tick_rate). All
 * seconds-denominated content converts via ticks = seconds * tick_rate. */

/* Registered by native_registry.c when the sashimi sandbox starts. */
void sashimi_register_native_systems(Engine *engine);

/* 45-degree octant snap shared by player input (future WASM client's
 * wasm_set_input) and by the headless hero AI, so both emit identical
 * InputDirection values (engine/clients/lib rt-input.js contract). */
void sashimi_input_snap(float x, float y, float *out_x, float *out_y);

/* Number of waves loaded from data/waves.yaml (0 before app_start). Read
 * by the WASM client bridge for the HUD "wave N/M" display so the total
 * stays sourced from sandbox data (root decision 13). */
int sashimi_wave_count(void);

/* Port decisions (values not present in the extraction; documented in
 * sandboxes/sashimi/CLAUDE.md "Port decisions"): */
#define SASHIMI_IFRAME_TICKS          30   /* 0.5 s post-hit invulnerability */
#define SASHIMI_RESPAWN_TICKS         300  /* 5 s hero respawn timer */
#define SASHIMI_RESPAWN_IFRAME_TICKS  120  /* 2 s i-frames after respawn */
#define SASHIMI_CHARGE_SPEED          5.0f /* LargeCubeCharge dash, units/s */

#endif
/* Sashimi sandbox content validation.
 *
 * Asserts that the generated data layer LOADS: sandbox select + app start
 * must succeed with every template loaded and every spawn applied, and the
 * loaded values must match the golden numbers from sashimi's
 * CONTENT-ANALYSIS.md (see sandboxes/sashimi/CLAUDE.md for the count
 * corrections). Run from the project root (ctest sets the working dir).
 */
#include "test.h"
#include "../../../engine/src/engine/engine.h"
#include "../../../engine/src/engine/simulation.h"
#include "../../../engine/src/engine/components.h"
#include "../../../engine/src/engine/templates.h"
#include "../../../engine/src/engine/app.h"
#include "../../../engine/src/engine/faction.h"
#include <string.h>

static Engine *engine;

/* Must match app.yaml templates.entities (asserted below via app_start). */
#define EXPECTED_ENTITY_TEMPLATES 35
/* spawn_list: 2 heroes + 8 gems. */
#define EXPECTED_SPAWNS 10

static void setup(void) {
    engine = engine_init(NULL);
    snprintf(engine->sandboxes_dir, sizeof(engine->sandboxes_dir),
             "./sandboxes/");
}

static void teardown(void) {
    engine_fini(engine);
    engine = NULL;
}

/* Helpers return sentinel values on lookup failure; the value assertions
   at the call sites then fail loudly (ASSERT can only be used in tests). */
static const void *comp_of(ecs_entity_t e, const char *comp) {
    if (!e) return NULL;
    ecs_entity_t c = ecs_lookup(engine->world, comp);
    if (!c) return NULL;
    return ecs_get_id(engine->world, e, c);
}

#define MISSING_F32 -99999.0f

static float field_f32(ecs_entity_t e, const char *comp, int index) {
    const float *p = (const float *)comp_of(e, comp);
    return p ? p[index] : MISSING_F32;
}

static ecs_entity_t tmpl(const char *name) {
    return ecs_lookup(engine->world, name);
}

/* --- Load ---------------------------------------------------------------- */

TEST(sandbox_loads_clean) {
    setup();
    ASSERT(engine_sandbox_select(engine, "sashimi"));

    /* Every component schema registered at select. */
    const char *comps[] = {
        "Position", "Velocity", "MoveSpeed", "InputDirection", "Health",
        "Faction", "Collider", "ChildOffset", "AISteering", "Hero",
        "Experience", "Weapon", "Projectile", "DamageOnHit", "PeriodicDamage",
        "StatusEffectOnHit", "StatusPoison", "StatusSlow", "SpentProjectile",
        "OneShotProjectileSpawner", "Pickup", "AbilityConfig", "AbilityState",
        "GameTimeConfig", "SpawnConfig", "GameOverConfig", "MoveConfig",
        "CombatConfig", "PickupConfig", "CreatureLevelUp", "HeroLevelUp",
        "HeroLevelBonus", "ArenaBounds", "WaveState", "PendingSpawn",
        "RespawnTimer", "IFramesTimer", "DestroyOnTimer", "Defeated",
        "GameTime", "MatchStats",
        "MapSize", /* imported from avk */
    };
    for (size_t i = 0; i < sizeof(comps) / sizeof(comps[0]); i++) {
        ecs_entity_t c = ecs_lookup(engine->world, comps[i]);
        if (!c) printf("\n    MISSING component %s ", comps[i]);
        ASSERT(c != 0);
    }

    AppStartResult asr;
    ASSERT(engine_app_start(engine, NULL, &asr));
    printf("\n    [entities_loaded=%d spawned=%d] ",
           asr.entities_loaded, asr.entities_spawned);
    /* Zero-error load: every template in app.yaml loaded, every spawn
       applied. A single failed template or spawn fails this. */
    ASSERT_EQ(asr.entities_loaded, EXPECTED_ENTITY_TEMPLATES);
    ASSERT_EQ(asr.entities_spawned, EXPECTED_SPAWNS);
    teardown();
}

/* --- Golden values (CONTENT-ANALYSIS.md) --------------------------------- */

static void start(void) {
    setup();
    ASSERT(engine_sandbox_select(engine, "sashimi"));
    AppStartResult asr;
    ASSERT(engine_app_start(engine, NULL, &asr));
}

TEST(creature_roster_values) {
    start();
    struct { const char *name; float hp, speed, follow, stop; } rows[] = {
        { "CreatureSlimeOrange", 30, 0.65f, 0.225f, 0.175f },
        { "CreatureWolf", 45, 1.75f, 0.5f, 0.25f },
        { "CreatureRockGolem", 150, 0.65f, 0.8f, 0.7f },
        { "CreatureWisp", 20, 0.8f, 3.5f, 2.5f },
        { "LargeTealCube", 180, 1.75f, 2.0f, 1.5f },
    };
    for (int i = 0; i < 5; i++) {
        ecs_entity_t t = tmpl(rows[i].name);
        ASSERT_EQ(field_f32(t, "Health", 1), rows[i].hp);      /* max */
        ASSERT_EQ(field_f32(t, "MoveSpeed", 0), rows[i].speed);
        ASSERT_EQ(field_f32(t, "AISteering", 0), rows[i].follow);
        ASSERT_EQ(field_f32(t, "AISteering", 1), rows[i].stop);
    }
    /* Wisp flees at 0; others never (-1). Acquisition radius 5 for all. */
    ASSERT_EQ(field_f32(tmpl("CreatureWisp"), "AISteering", 2), 0.0f);
    ASSERT_EQ(field_f32(tmpl("CreatureWolf"), "AISteering", 2), -1.0f);
    ASSERT_EQ(field_f32(tmpl("CreatureWolf"), "AISteering", 3), 5.0f);
    teardown();
}

TEST(hero_kits) {
    start();
    /* Frog: speed 2, hero_id 2, shuriken weapon child. */
    ecs_entity_t frog = tmpl("HeroFrog");
    ASSERT_EQ(field_f32(frog, "MoveSpeed", 0), 2.0f);
    const int *hero = (const int *)comp_of(frog, "Hero");
    ASSERT_NOT_NULL(hero);
    ASSERT_EQ(hero[0], 2);

    /* Spawned hero owns a weapon child wired to the shuriken. */
    ecs_entity_t inst = engine_entity_spawn(engine, "HeroFrog", NULL);
    ASSERT(inst != 0);
    ecs_entity_t weapon = ecs_lookup_child(engine->world, inst, "weapon");
    ASSERT(weapon != 0);
    char *wdata = engine_entity_get_component(engine, weapon, "Weapon");
    ASSERT_NOT_NULL(wdata);
    ASSERT(strstr(wdata, "0.75") != NULL);               /* cooldown */
    ASSERT(strstr(wdata, "Shuriken_Projectile") != NULL);
    free(wdata);

    /* Shuriken: dmg 12, hit limit 4, 3 bounces; poison 30/tick, -75% slow,
       3 s, stack limit 1. */
    ecs_entity_t shp = tmpl("Shuriken_Projectile");
    ASSERT_EQ(field_f32(shp, "DamageOnHit", 0), 12.0f);
    const int *proj = (const int *)comp_of(shp, "Projectile");
    ASSERT_NOT_NULL(proj);
    const float *projf = (const float *)proj;
    ASSERT_EQ(projf[0], 3.0f);   /* range */
    ASSERT_EQ(proj[3], 3);       /* bounce */
    const float *poison = (const float *)comp_of(shp, "StatusEffectOnHit");
    ASSERT_NOT_NULL(poison);
    ASSERT_EQ(poison[0], 3.0f);    /* duration */
    ASSERT_EQ(poison[1], 30.0f);   /* periodic damage */
    ASSERT_EQ(poison[3], -0.75f);  /* magnitude (75% slow) */

    /* Eagle feather: dmg 12, pierce 4; recall buff +50% speed on spawner. */
    ecs_entity_t fp = tmpl("Feather_Projectile");
    ASSERT_EQ(field_f32(fp, "DamageOnHit", 0), 12.0f);
    const int *fproj = (const int *)comp_of(fp, "Projectile");
    ASSERT_NOT_NULL(fproj);
    ASSERT_EQ(fproj[2], 4);      /* pierce */
    const float *buff = (const float *)
        comp_of(tmpl("FeatherRecall_Spawner"), "StatusEffectOnHit");
    ASSERT_NOT_NULL(buff);
    ASSERT_EQ(buff[3], 0.5f);      /* +50% move speed */
    ASSERT_EQ(buff[0], 1.1f);      /* duration */

    /* Eagle per-level: pierce_limit[19] == 20; frog bounce_limit[19] == 10. */
    const float *eb = (const float *)comp_of(tmpl("HeroEagle"),
                                             "HeroLevelBonus");
    ASSERT_NOT_NULL(eb);
    ASSERT_EQ(eb[20 + 19], 20.0f);  /* pierce_limit array is field 2 of 3 */
    ASSERT_EQ(eb[40 + 19], 20.0f);  /* recall_limit */
    const float *fb = (const float *)comp_of(frog, "HeroLevelBonus");
    ASSERT_NOT_NULL(fb);
    ASSERT_EQ(fb[19], 10.0f);       /* bounce_limit */
    teardown();
}

TEST(abilities_and_pickups) {
    start();
    /* SlimeAttack: id 3, 0/0.75/1.25, ready at 0.35, dmg 12.5, reset 1. */
    ecs_entity_t sa = tmpl("SlimeAttack");
    const float *cfgf = (const float *)comp_of(sa, "AbilityConfig");
    const int *cfgi = (const int *)cfgf;
    ASSERT_NOT_NULL(cfgf);
    ASSERT_EQ(cfgi[0], 3);          /* AbilityId */
    ASSERT_EQ(cfgf[1], 0.0f);       /* windup */
    ASSERT_EQ(cfgf[2], 0.75f);      /* active */
    ASSERT_EQ(cfgf[3], 1.25f);      /* recovery */
    ASSERT_EQ(cfgf[7], 0.35f);      /* max_range */
    ASSERT_EQ(field_f32(sa, "DamageOnHit", 0), 12.5f);
    ASSERT_EQ(field_f32(sa, "DamageOnHit", 3), 1.0f);   /* reset_time */

    /* LargeCubeCharge: cooldown 2 s starting on cooldown, dmg 25. */
    ecs_entity_t cc = tmpl("LargeCubeCharge");
    const float *ccf = (const float *)comp_of(cc, "AbilityConfig");
    ASSERT_NOT_NULL(ccf);
    ASSERT_EQ(ccf[4], 2.0f);        /* cooldown */
    ASSERT_EQ(field_f32(cc, "DamageOnHit", 0), 25.0f);

    /* Pickups: gem value 1, heart value 25 + heal ratio 0.25 on config;
       drop rates 50% / 3.75%. */
    const int *gem = (const int *)comp_of(tmpl("GemPickup"), "Pickup");
    ASSERT_NOT_NULL(gem);
    ASSERT_EQ(gem[0], 1);                        /* effect: gem/XP */
    const float *heart = (const float *)comp_of(tmpl("HeartPickup"),
                                                "Pickup");
    ASSERT_NOT_NULL(heart);
    ASSERT_EQ(heart[1], 25.0f);
    ecs_entity_t gc = tmpl("GameConfig");
    const float *pk = (const float *)comp_of(gc, "PickupConfig");
    ASSERT_NOT_NULL(pk);
    ASSERT_EQ(pk[3], 0.5f);         /* gem_drop_scale */
    ASSERT_EQ(pk[4], 0.0375f);      /* heart_drop_scale (Adventure) */
    ASSERT_EQ(pk[5], 0.25f);        /* heart_heal_ratio */
    teardown();
}

TEST(game_config_and_level_tables) {
    start();
    ecs_entity_t gc = tmpl("GameConfig");
    const int *tc = (const int *)comp_of(gc, "GameTimeConfig");
    ASSERT_NOT_NULL(tc);
    ASSERT_EQ(tc[0], 60);                          /* tick_rate */
    ASSERT_EQ(((const float *)tc)[1], 0.25f);      /* periodic tick */
    const float *sc = (const float *)comp_of(gc, "SpawnConfig");
    ASSERT_NOT_NULL(sc);
    ASSERT_EQ(sc[0], 1.25f);                       /* spawn delay */
    const float *go = (const float *)comp_of(gc, "GameOverConfig");
    ASSERT_NOT_NULL(go);
    ASSERT_EQ(go[0], 180.0f);                      /* victory timer */
    const float *cc = (const float *)comp_of(gc, "CombatConfig");
    ASSERT_NOT_NULL(cc);
    ASSERT_EQ(cc[1], 1.0f);                        /* damage_taken_ratio */

    /* Level tables: layout max_level(i32) + xp[20](i32) + damage[20] +
       health[20] (f32). */
    const int *cl = (const int *)comp_of(gc, "CreatureLevelUp");
    ASSERT_NOT_NULL(cl);
    ASSERT_EQ(cl[0], 20);
    ASSERT_EQ(cl[1 + 1], 11);      /* xp[1] */
    ASSERT_EQ(cl[1 + 19], 2090);   /* xp[19] */
    const float *clf = (const float *)cl;
    ASSERT(clf[21 + 19] > 1.94f && clf[21 + 19] < 1.96f);  /* damage L20 */
    ASSERT(clf[41 + 19] > 6.69f && clf[41 + 19] < 6.71f);  /* health L20 */
    const int *hl = (const int *)comp_of(gc, "HeroLevelUp");
    ASSERT_NOT_NULL(hl);
    ASSERT_EQ(hl[1 + 19], 950);
    const float *hlf = (const float *)hl;
    ASSERT(hlf[21 + 19] > 12.39f && hlf[21 + 19] < 12.41f);

    /* GameState singleton: wave cursor initialized to wave 1 at 5 s. */
    ecs_entity_t gs = tmpl("GameState");
    const int *ws = (const int *)comp_of(gs, "WaveState");
    ASSERT_NOT_NULL(ws);
    ASSERT_EQ(ws[0], 1);
    ASSERT_EQ(ws[1], 300);
    teardown();
}

TEST(spawned_scene_content) {
    start();
    /* Two heroes at (+-0.5, 0) and 8 gems, positions applied via
       spawn_list params. */
    ecs_entity_t pos_comp = ecs_lookup(engine->world, "Position");
    ASSERT(pos_comp != 0);
    int heroes = 0, gems = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *name = list.items[i].name;
        if (!name) continue;
        const float *p = (const float *)
            ecs_get_id(engine->world, list.items[i].id, pos_comp);
        if (strncmp(name, "HeroEagle_", 10) == 0 ||
            strncmp(name, "HeroFrog_", 9) == 0) {
            ASSERT_NOT_NULL(p);
            ASSERT(p[0] == 0.5f || p[0] == -0.5f);
            ASSERT_EQ(p[1], 0.0f);
            heroes++;
        }
        if (strncmp(name, "GemPickup_", 10) == 0) {
            ASSERT_NOT_NULL(p);
            ASSERT(p[1] >= 3.5f && p[1] <= 4.5f);
            gems++;
        }
    }
    engine_entity_list_free(&list);
    printf("\n    [heroes=%d gems=%d] ", heroes, gems);
    ASSERT_EQ(heroes, 2);
    ASSERT_EQ(gems, 8);
    teardown();
}

/* --- Data files ----------------------------------------------------------- */

static int filters_interact(const FactionMatrix *m, const char *a,
                            const char *b) {
    const FactionFilterDef *fa = faction_matrix_filter(m, a);
    const FactionFilterDef *fb = faction_matrix_filter(m, b);
    if (!fa || !fb) return -1; /* fails any ASSERT_EQ against 0/1 */
    return faction_filter_match(fa->filter, fb->filter) ? 1 : 0;
}

TEST(faction_matrix_loads_with_quirk) {
    FactionMatrix m;
    ASSERT(faction_matrix_load(&m, "sandboxes/sashimi/data/faction-matrix.yaml"));
    ASSERT_EQ(m.category_count, 16);

    /* Core rules: red harm hits blue units, not red; pickups (blue help)
       touch only blue units; friendly fire impossible by construction. */
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Red", "Unit_Blue"), 1);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Red", "Unit_Red"), 0);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Blue", "Unit_Red"), 1);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Blue", "Unit_Blue"), 0);
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Blue", "Unit_Blue"), 1);
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Blue", "Unit_Red"), 0);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Global", "Unit_Blue"), 1);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Global", "Unit_Red"), 1);

    /* The preserved HelpEffect_Global one-bit-shift quirk: it does NOT
       reach Blue units (shipped behavior), but does reach Red. */
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Global", "Unit_Blue"), 0);
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Global", "Unit_Red"), 1);
}

TEST(waves_file_shape) {
    /* Structural check of data/waves.yaml: 36 waves, 509 entries, intro
       beats at 6/11/16/21. Full parsing belongs to the spawn director at
       slice assembly. */
    FILE *f = fopen("sandboxes/sashimi/data/waves.yaml", "r");
    ASSERT_NOT_NULL(f);
    char line[512];
    int waves = 0, entries = 0;
    int intro_wolf = 0, intro_golem = 0, intro_wisp = 0, intro_cube = 0;
    int cur_wave = 0;
    while (fgets(line, sizeof(line), f)) {
        if (sscanf(line, "  - wave: %d", &cur_wave) == 1) waves++;
        if (strstr(line, "- { template: ")) entries++;
        if (strstr(line, "intro: CreatureWolf")) intro_wolf = cur_wave;
        if (strstr(line, "intro: CreatureRockGolem")) intro_golem = cur_wave;
        if (strstr(line, "intro: CreatureWisp")) intro_wisp = cur_wave;
        if (strstr(line, "intro: LargeTealCube")) intro_cube = cur_wave;
    }
    fclose(f);
    printf("\n    [waves=%d entries=%d intros=%d/%d/%d/%d] ",
           waves, entries, intro_wolf, intro_golem, intro_wisp, intro_cube);
    ASSERT_EQ(waves, 36);
    ASSERT_EQ(entries, 509);
    ASSERT_EQ(intro_wolf, 6);
    ASSERT_EQ(intro_golem, 11);
    ASSERT_EQ(intro_wisp, 16);
    ASSERT_EQ(intro_cube, 21);
}

int main(void) {
    TEST_SUITE("Sashimi Content (generated data layer)");
    RUN(sandbox_loads_clean);
    RUN(creature_roster_values);
    RUN(hero_kits);
    RUN(abilities_and_pickups);
    RUN(game_config_and_level_tables);
    RUN(spawned_scene_content);
    RUN(faction_matrix_loads_with_quirk);
    RUN(waves_file_shape);
    TEST_RESULTS();
}
/* Sashimi native-systems tests (ctest: test_sashimi_systems).
 *
 * Per-mechanism unit tests (damage ratio, poison/slow timing, level-up
 * tables, drop rates, wave director, kite AI, faction-filtered collision)
 * plus the headless end-to-end acceptance run: with FLECS_SEED pinned and
 * the headless-verify config (heroes take 50% damage), a full game must
 * run to completion. Run from the project root (ctest sets the cwd).
 *
 * Scenario tests drive individual systems with engine_system_run_one on a
 * world prepared by sandbox select + app start (legacy mode), mirroring
 * how the real tick runs them in app.yaml system_order.
 */
#include "test.h"
#include "../../../engine/src/engine/engine.h"
#include "../../../engine/src/engine/simulation.h"
#include "../../../engine/src/engine/components.h"
#include "../../../engine/src/engine/templates.h"
#include "../../../engine/src/engine/systems.h"
#include "../../../engine/src/engine/app.h"
#include <math.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static Engine *engine;

static void setup_cfg(const char *config) {
    setenv("FLECS_SEED", "12345", 1);
    engine = engine_init(NULL);
    snprintf(engine->sandboxes_dir, sizeof(engine->sandboxes_dir),
             "./sandboxes/");
    if (!engine_sandbox_select(engine, "sashimi")) {
        fprintf(stderr, "FATAL: sandbox select failed\n");
        exit(1);
    }
    AppStartResult asr;
    if (!engine_app_start(engine, config, &asr)) {
        fprintf(stderr, "FATAL: app start failed\n");
        exit(1);
    }
    /* Run the one-shot app_start system now (seeds RNG, loads the faction
     * matrix + wave table, inits the spatial hash, bridges the named
     * config) so scenario tests can drive individual systems directly. */
    engine_system_run_one(engine, "app_start");
}
static void setup(void) { setup_cfg(NULL); }

static void teardown(void) {
    engine_fini(engine);
    engine = NULL;
}

/* One full tick through the legacy system_order. */
static void tick(void) {
    TurnResult tr;
    engine_sim_turn(engine, &tr);
    engine_turn_result_free(&tr);
}

static ecs_entity_t comp(const char *name) {
    return ecs_lookup(engine->world, name);
}

static void *get_mut(ecs_entity_t e, const char *c) {
    ecs_entity_t cid = comp(c);
    return cid ? ecs_get_mut_id(engine->world, e, cid) : NULL;
}
static const void *get(ecs_entity_t e, const char *c) {
    ecs_entity_t cid = comp(c);
    return cid ? ecs_get_id(engine->world, e, cid) : NULL;
}
static bool has(ecs_entity_t e, const char *c) {
    ecs_entity_t cid = comp(c);
    return cid && ecs_has_id(engine->world, e, cid);
}
static void set_pos(ecs_entity_t e, float x, float y) {
    float *p = (float *)get_mut(e, "Position");
    if (p) { p[0] = x; p[1] = y; }
}
static void run(const char *sys) { engine_system_run_one(engine, sys); }

/* Delete the spawn_list content (2 heroes + 8 gems) for scenario tests
 * that build their own world state. */
static void clear_spawned(void) {
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *n = list.items[i].name;
        if (!n) continue;
        if (strncmp(n, "HeroEagle_", 10) == 0 ||
            strncmp(n, "HeroFrog_", 9) == 0 ||
            strncmp(n, "GemPickup_", 10) == 0)
            ecs_delete(engine->world, list.items[i].id);
    }
    engine_entity_list_free(&list);
}

static ecs_entity_t spawn_at(const char *tmpl, float x, float y) {
    ecs_entity_t e = engine_entity_spawn(engine, tmpl, NULL);
    if (e) set_pos(e, x, y);
    return e;
}

static int count_named_prefix(const char *prefix) {
    int n = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, prefix, strlen(prefix)) == 0)
            n++;
    engine_entity_list_free(&list);
    return n;
}

/* --- template inheritance regression ---------------------------------- */

/* Regression for the engine copy_template_components dangling-pointer bug:
 * inherited-but-not-overridden fields of extends-variants (Shuriken_Weapon's
 * ChildOffset from ProjectileWeaponEntity) came out as garbage once enough
 * templates shared the destination table (reallocation during the copy).
 * Symptom in-game: weapon fire positions at +-1e23, no projectiles ever. */
TEST(inherited_child_offset_survives_template_load) {
    setup();
    ecs_entity_t sw = ecs_lookup(engine->world, "Shuriken_Weapon");
    const float *co = (const float *)get(sw, "ChildOffset");
    ASSERT_NOT_NULL(co);
    ASSERT_EQ(co[0], 0.0f);
    ASSERT_EQ(co[1], 0.0f);

    ecs_entity_t hero = engine_entity_spawn(engine, "HeroFrog", NULL);
    ecs_entity_t weapon = ecs_lookup_child(engine->world, hero, "weapon");
    co = (const float *)get(weapon, "ChildOffset");
    ASSERT_NOT_NULL(co);
    ASSERT_EQ(co[0], 0.0f);
    ASSERT_EQ(co[1], 0.0f);
    teardown();
}

/* --- damage ratio ---------------------------------------------------- */

/* A slime melee hit deals 12.5 * damage_taken_ratio to a hero (heroes are
 * the only entities the ratio modifies; creatures take full damage). */
static float hero_hp_after_slime_hit(const char *config) {
    setup_cfg(config);
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    if (!hero || !slime || !attack) { teardown(); return -1; }

    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");

    /* Force the ability hitbox live (bypassing the state machine). */
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.1f, 0);

    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(hero, "Health");
    float cur = h ? h[0] : -1;
    teardown();
    return cur;
}

TEST(damage_taken_ratio_math) {
    /* Default config: ratio 1.0 -> 50 - 12.5 = 37.5 */
    float full = hero_hp_after_slime_hit(NULL);
    ASSERT_EQ(full, 37.5f);
    /* headless-verify: ratio 0.5 -> 50 - 6.25 = 43.75 */
    float half = hero_hp_after_slime_hit("headless-verify");
    ASSERT_EQ(half, 43.75f);
}

TEST(creatures_take_full_damage_regardless_of_ratio) {
    setup_cfg("headless-verify");
    clear_spawned();

    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0, 0);
    run("game_time");

    /* A shuriken overlapping the slime: full 12 damage (no ratio). */
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt =
        { 0, 0, 0, 3, 3.0f };
    ecs_entity_t rt_c = comp("ProjectileRuntime");
    ecs_set_id(engine->world, proj, rt_c, sizeof(rt), &rt);

    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(slime, "Health");
    ASSERT_EQ(h[0], 18.0f); /* 30 - 12 */
    /* Poison + slow applied on hit. */
    ASSERT(has(slime, "StatusPoison"));
    ASSERT(has(slime, "StatusSlow"));
    const float *slow = (const float *)get(slime, "StatusSlow");
    ASSERT_EQ(slow[1], -0.75f); /* magnitude (75% slow) */
    teardown();
}

/* --- poison / slow timing -------------------------------------------- */

TEST(poison_ticks_on_periodic_clock_and_expires) {
    setup();
    clear_spawned();

    ecs_entity_t golem = spawn_at("CreatureRockGolem", 0, 0); /* 150 HP */
    struct { int32_t ticks; float dmg; } poison = { 180, 30.0f }; /* 3 s */
    ecs_set_id(engine->world, golem, comp("StatusPoison"),
               sizeof(poison), &poison);

    /* 180 ticks: periodic clock fires every 15 ticks -> 12 pulses of 30. */
    int pulses = 0;
    float prev = 150.0f;
    for (int t = 0; t < 185; t++) {
        run("game_time");
        run("status_effects");
        const float *h = (const float *)get(golem, "Health");
        if (h[0] < prev) { pulses++; prev = h[0]; }
    }
    ASSERT_EQ(pulses, 12);
    const float *h = (const float *)get(golem, "Health");
    ASSERT_EQ(h[0], 150.0f - 12 * 30.0f); /* -210 -> defeated by defeat sys */
    ASSERT(!has(golem, "StatusPoison"));  /* expired -> removed */
    teardown();
}

TEST(slow_reduces_movement_and_expires) {
    setup();
    clear_spawned();

    /* Wolf (speed 1.75) chasing a hero placed inside acquire radius. */
    ecs_entity_t hero = spawn_at("HeroFrog", 4, 0);
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0, 0);
    (void)hero;

    /* Unslowed distance covered in 60 ticks. */
    run("game_time");
    run("spatial_hash");
    run("targeting");
    float x0 = ((const float *)get(wolf, "Position"))[0];
    for (int t = 0; t < 60; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    float moved_free = ((const float *)get(wolf, "Position"))[0] - x0;

    /* Reset position, apply -75% slow for 60 ticks. */
    set_pos(wolf, 0, 0);
    struct { int32_t ticks; float mag; } slow = { 999, -0.75f };
    ecs_set_id(engine->world, wolf, comp("StatusSlow"), sizeof(slow), &slow);
    for (int t = 0; t < 60; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    float moved_slow = ((const float *)get(wolf, "Position"))[0];

    ASSERT(moved_free > 1.5f && moved_free < 2.0f);   /* ~1.75 */
    ASSERT(fabsf(moved_slow - moved_free * 0.25f) < 0.05f);

    /* Expiry: remaining ticks hit 0 -> component removed. */
    struct { int32_t ticks; float mag; } short_slow = { 3, -0.75f };
    ecs_set_id(engine->world, wolf, comp("StatusSlow"),
               sizeof(short_slow), &short_slow);
    for (int t = 0; t < 4; t++) { run("game_time"); run("status_effects"); }
    ASSERT(!has(wolf, "StatusSlow"));
    teardown();
}

/* --- level-up tables -------------------------------------------------- */

TEST(level_up_applies_tables_and_projectile_increments) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    int32_t *ms = (int32_t *)get_mut(gs, "MatchStats");
    ms[0] = 15; /* xp[2] = 15 -> level 3 */

    /* Damage the hero so the full-heal is observable. */
    float *h = (float *)get_mut(hero, "Health");
    h[0] = 20.0f;

    run("game_time");
    run("level_up");

    const int32_t *xp = (const int32_t *)get(hero, "Experience");
    ASSERT_EQ(xp[1], 3); /* level */
    h = (float *)get_mut(hero, "Health");
    /* max scaled by health[2] = 1.2; healed to full. */
    ASSERT(fabsf(h[1] - 50.0f * 1.2f) < 0.01f);
    ASSERT_EQ(h[0], h[1]);

    /* Weapon fire at level 3: frog bounce = base 3 + floor(0.5*3) = 4. */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 1.0f, 0);
    (void)slime;
    run("spatial_hash");
    /* Elapse the initial 0.75 s weapon cooldown (45 ticks + init tick). */
    for (int t = 0; t < 47; t++) run("weapon_fire");

    /* Find the spawned projectile. */
    EntityList list = engine_entity_list(engine);
    ecs_entity_t proj = 0;
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, "Shuriken_Projectile_", 20) == 0)
            proj = list.items[i].id;
    engine_entity_list_free(&list);
    ASSERT(proj != 0);
    const struct { ecs_entity_t shooter; int32_t hits, pierce, bounce; float d; }
        *rt = get(proj, "ProjectileRuntime");
    ASSERT_NOT_NULL(rt);
    ASSERT_EQ(rt->bounce, 4);
    ASSERT_EQ(rt->shooter, hero);

    /* Hero damage multiplier at level 3 = 1.35 -> hit deals 12 * 1.35.
       Let the projectile fly (speed 5, slime 1.0 away). */
    for (int t = 0; t < 15; t++) {
        run("spatial_hash");
        run("damage_apply");
        run("projectile_lifecycle");
    }
    const float *sh = (const float *)get(slime, "Health");
    ASSERT(fabsf(sh[0] - (30.0f - 12.0f * 1.35f)) < 0.01f);
    teardown();
}

/* --- drop rates -------------------------------------------------------- */

TEST(drop_rates_seeded) {
    setup(); /* FLECS_SEED pinned in setup */
    clear_spawned();

    /* Defeat 400 slimes far from anything. */
    ecs_entity_t hero = spawn_at("HeroFrog", -9, -6); /* drops need no hero,
                                                         but keep world sane */
    (void)hero;
    int gems_before = count_named_prefix("GemPickup_");
    for (int i = 0; i < 400; i++) {
        ecs_entity_t s = spawn_at("CreatureSlimeOrange", 5, 5);
        float *h = (float *)get_mut(s, "Health");
        h[0] = 0;
        run("defeat");
        run("on_defeated");
    }
    int gems = count_named_prefix("GemPickup_") - gems_before;
    int hearts = count_named_prefix("HeartPickup_");
    printf("\n    [400 kills -> gems=%d hearts=%d] ", gems, hearts);
    /* gem 50%, heart 3.75%: allow generous seeded tolerance. */
    ASSERT(gems > 160 && gems < 240);
    ASSERT(hearts >= 4 && hearts <= 35);

    const int32_t *ms = (const int32_t *)
        get(ecs_lookup(engine->world, "GameState"), "MatchStats");
    ASSERT_EQ(ms[1], 400); /* kills counted */
    teardown();
}

/* --- wave director ----------------------------------------------------- */

TEST(wave_director_schedule) {
    setup();
    clear_spawned();

    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    const int32_t *ws = (const int32_t *)get(gs, "WaveState");
    ASSERT_EQ(ws[0], 1);    /* next wave */
    ASSERT_EQ(ws[1], 300);  /* 5 s at 60 Hz */

    /* 299 director ticks: nothing spawns. */
    for (int t = 0; t < 299; t++) { run("spawn_director"); run("delayed_spawn"); }
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 0);

    /* Tick 300: wave 1 enqueued (delay_ticks 1 -> spawns same tick). */
    run("spawn_director");
    run("delayed_spawn");
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 6);

    ws = (const int32_t *)get(gs, "WaveState");
    ASSERT_EQ(ws[0], 2);
    ASSERT_EQ(ws[1], 300);
    ASSERT_EQ(ws[2], 6);   /* spawned_total */

    /* Wave 2 lands 300 ticks later with 7 more slimes. */
    for (int t = 0; t < 300; t++) { run("spawn_director"); run("delayed_spawn"); }
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 13);
    teardown();
}

/* Observability-contract guard (sandboxes/sashimi/CLAUDE.md "Hero-AI
 * observability contract"): pre-spawn state must be invisible to every AI
 * query. PendingSpawn request entities exist during the delay window but
 * must carry ONLY PendingSpawn — no Position/AISteering/Health/Collider/
 * Faction — so no AI query, unit snapshot, or spatial-hash pass can ever
 * see an enemy before it materializes on the field. */
TEST(pending_spawns_invisible_to_ai) {
    setup();
    clear_spawned();

    /* Advance the director to wave 1's enqueue tick, but do NOT run
       delayed_spawn: the pending window is open. */
    for (int t = 0; t < 300; t++) run("spawn_director");

    int n_pending = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *nm = list.items[i].name;
        if (!nm || strncmp(nm, "pending_w1_", 11) != 0) continue;
        n_pending++;
        ecs_entity_t e = list.items[i].id;
        ASSERT(has(e, "PendingSpawn"));
        /* Invisible to hero_ai's enemy query (AISteering+Position+Health),
           the unit snapshot (Health+Position+Faction) and the spatial hash
           (Position+Collider). */
        ASSERT(!has(e, "Position"));
        ASSERT(!has(e, "AISteering"));
        ASSERT(!has(e, "Health"));
        ASSERT(!has(e, "Collider"));
        ASSERT(!has(e, "Faction"));
    }
    engine_entity_list_free(&list);
    ASSERT_EQ(n_pending, 6);                       /* wave 1: 6 slimes */
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 0);

    /* Materialization is the observability boundary: after delayed_spawn
       the creatures are on the field and only then AI-visible. */
    run("delayed_spawn");
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 6);
    ASSERT_EQ(count_named_prefix("pending_w1_"), 0);
    teardown();
}

/* --- kite AI ------------------------------------------------------------ */

TEST(kite_ai_keeps_range_and_survives) {
    setup_cfg("headless-verify");
    clear_spawned();
    engine_system_disable(engine, "spawn_director"); /* no waves */

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    /* A wolf (fast: 1.75 vs hero 2.0) — the hardest kite among slice
       creatures. */
    ecs_entity_t wolf = spawn_at("CreatureWolf", 2.5f, 0);

    float min_d = 1e9f;
    bool wolf_alive = true;
    int wolf_died_at = -1;
    bool dbg = getenv("SASHIMI_DEBUG") != NULL;
    for (int t = 0; t < 900 && !engine->game_over; t++) {
        tick();
        if (dbg && t % 60 == 0) {
            const float *hp3 = (const float *)get(hero, "Position");
            const float *wp3 = ecs_is_alive(engine->world, wolf)
                ? (const float *)get(wolf, "Position") : NULL;
            const float *whp = ecs_is_alive(engine->world, wolf)
                ? (const float *)get(wolf, "Health") : NULL;
            printf("\n    dbg t=%d hero(%.2f,%.2f) wolf(%.2f,%.2f) whp=%.1f projs=%d",
                   t, hp3 ? hp3[0] : 0, hp3 ? hp3[1] : 0,
                   wp3 ? wp3[0] : -99, wp3 ? wp3[1] : -99,
                   whp ? whp[0] : -1,
                   count_named_prefix("Shuriken_Projectile_"));
        }
        if (wolf_alive && !ecs_is_alive(engine->world, wolf)) {
            wolf_alive = false;
            wolf_died_at = t;
            break;
        }
        const float *hp2 = (const float *)get(hero, "Position");
        const float *wp = (const float *)get(wolf, "Position");
        if (hp2 && wp) {
            float dx = hp2[0] - wp[0], dy = hp2[1] - wp[1];
            float d = sqrtf(dx * dx + dy * dy);
            if (d < min_d) min_d = d;
        }
        /* AI must stay in bounds. */
        ASSERT(hp2[0] >= -9.5f && hp2[0] <= 9.5f);
        ASSERT(hp2[1] >= -6.5f && hp2[1] <= 6.5f);
    }
    const float *hh = (const float *)get(hero, "Health");
    printf("\n    [min hero-wolf distance %.2f, wolf died at tick %d, hero HP %.1f] ",
           min_d, wolf_died_at, hh ? hh[0] : -1.0f);
    /* Keep-range invariant: the wolf attacks at 0.6; the AI must keep it
       clear of melee range while the weapon (range 3) kills it. */
    ASSERT(!wolf_alive);
    ASSERT(min_d > 0.7f);
    ASSERT(hh && hh[0] >= 50.0f - 12.5f); /* at most one graze */
    teardown();
}

/* --- faction-filtered collision ----------------------------------------- */

TEST(faction_filter_gates_damage_and_pickups) {
    setup();
    clear_spawned();

    /* Blue projectile on top of a hero (Unit_Blue): no friendly fire. */
    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt =
        { 0, 0, 0, 3, 3.0f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"), sizeof(rt), &rt);

    run("game_time");
    run("spatial_hash");
    run("damage_apply");
    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 50.0f); /* untouched: HarmEffect_Blue vs Unit_Blue */

    /* Same projectile overlapping a creature: damage applies. */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0, 0);
    run("spatial_hash");
    run("damage_apply");
    const float *sh = (const float *)get(slime, "Health");
    ASSERT_EQ(sh[0], 18.0f);

    /* Red creature attack cannot hurt creatures (Unit_Red). */
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0.05f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, wolf, "attack");
    ASSERT(attack != 0);
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.05f, 0);
    run("spatial_hash");
    run("damage_apply");
    sh = (const float *)get(slime, "Health");
    ASSERT_EQ(sh[0], 18.0f); /* HarmEffect_Red vs Unit_Red: no interaction */

    /* Pickups (HelpEffect_Blue) magnetize to heroes, never creatures. */
    ecs_entity_t gem = spawn_at("GemPickup", 5, 5);
    ecs_entity_t slime2 = spawn_at("CreatureSlimeOrange", 5.1f, 5);
    (void)slime2;
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(!has(gem, "PickupMagnet"));
    set_pos(hero, 5.2f, 5);
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(has(gem, "PickupMagnet"));
    teardown();
}

/* --- headless end-to-end (the port's acceptance mechanism) -------------- */

TEST(headless_full_game_to_completion) {
    setup_cfg("headless-verify");

    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);

    int ticks = 0;
    while (!engine->game_over && ticks < 12000) {
        tick();
        ticks++;
    }
    clock_gettime(CLOCK_MONOTONIC, &t1);
    double secs = (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9;

    const int32_t *ms = (const int32_t *)
        get(ecs_lookup(engine->world, "GameState"), "MatchStats");
    printf("\n    [seed 12345, %d ticks in %.2fs (%.0f ticks/s): %s | gems %d kills %d] ",
           ticks, secs, ticks / (secs > 0 ? secs : 1),
           engine->game_over_message, ms ? ms[0] : -1, ms ? ms[1] : -1);

    ASSERT(engine->game_over);
    /* Acceptance: VICTORY at 50% damage taken (survive 10800 ticks). */
    ASSERT(strncmp(engine->game_over_message, "Victory", 7) == 0);
    ASSERT_EQ(ticks, 10800);
    teardown();
}

int main(void) {
    TEST_SUITE("Sashimi Native Systems");
    RUN(inherited_child_offset_survives_template_load);
    RUN(damage_taken_ratio_math);
    RUN(creatures_take_full_damage_regardless_of_ratio);
    RUN(poison_ticks_on_periodic_clock_and_expires);
    RUN(slow_reduces_movement_and_expires);
    RUN(level_up_applies_tables_and_projectile_increments);
    RUN(drop_rates_seeded);
    RUN(wave_director_schedule);
    RUN(pending_spawns_invisible_to_ai);
    RUN(kite_ai_keeps_range_and_survives);
    RUN(faction_filter_gates_damage_and_pickups);
    RUN(headless_full_game_to_completion);
    TEST_RESULTS();
}
/* Headless verification of the sashimi WASM module (no browser):
 * init -> possession join (P1/P2, no third hero) -> per-tick input ->
 * run past wave 1 -> assert creature spawns, kind/flag accessors, hero
 * control, game-state accessors; report engine tick-ms stats.
 *
 * Run from the project root after ./tools/build-wasm.sh sashimi:
 *   node sandboxes/sashimi/tests/test_wasm.js [config]
 */
const path = require('path');
const FlecsECS = require(path.join(__dirname, '../../../build/wasm-sashimi/flecs-ecs.js'));

const KIND = {
    HERO_EAGLE: 1, HERO_FROG: 2, SLIME: 3, WOLF: 4, GOLEM: 5, WISP: 6,
    CUBE: 7, SHURIKEN: 8, FEATHER: 9, WISP_SHOT: 10, GEM: 11, HEART: 12,
};

async function run() {
    const config = process.argv[2] || 'default';
    /* The preloaded .data package is fetched relative to cwd */
    process.chdir(path.join(__dirname, '../../../build/wasm-sashimi'));
    const M = await FlecsECS();
    const e = {
        init: M.cwrap('wasm_init_with_config', 'number', ['string']),
        tick: M.cwrap('wasm_tick', 'number', []),
        join: M.cwrap('wasm_join', 'number', ['number']),
        setInput: M.cwrap('wasm_set_input', null, ['number', 'number', 'number']),
        playerEntityId: M.cwrap('wasm_player_entity_id', 'number', ['number']),
        getTickMs: M.cwrap('wasm_get_tick_ms', 'number', []),
        count: M.cwrap('wasm_get_unit_count', 'number', []),
        id: M.cwrap('wasm_get_unit_entity_id', 'number', ['number']),
        x: M.cwrap('wasm_get_unit_x', 'number', ['number']),
        y: M.cwrap('wasm_get_unit_y', 'number', ['number']),
        health: M.cwrap('wasm_get_unit_health', 'number', ['number']),
        maxHealth: M.cwrap('wasm_get_unit_max_health', 'number', ['number']),
        radius: M.cwrap('wasm_get_unit_radius', 'number', ['number']),
        kind: M.cwrap('wasm_get_unit_kind', 'number', ['number']),
        flags: M.cwrap('wasm_get_unit_flags', 'number', ['number']),
        slot: M.cwrap('wasm_get_unit_slot', 'number', ['number']),
        gameTick: M.cwrap('wasm_get_game_tick', 'number', []),
        tickRate: M.cwrap('wasm_get_tick_rate', 'number', []),
        victoryTicks: M.cwrap('wasm_get_victory_ticks', 'number', []),
        wave: M.cwrap('wasm_get_wave', 'number', []),
        waveCount: M.cwrap('wasm_get_wave_count', 'number', []),
        gems: M.cwrap('wasm_get_gems', 'number', []),
        kills: M.cwrap('wasm_get_kills', 'number', []),
        heroLevel: M.cwrap('wasm_get_hero_level', 'number', []),
        nextLevelXp: M.cwrap('wasm_get_next_level_xp', 'number', []),
        isGameOver: M.cwrap('wasm_is_game_over', 'number', []),
        arenaMinX: M.cwrap('wasm_get_arena_min_x', 'number', []),
        arenaMaxX: M.cwrap('wasm_get_arena_max_x', 'number', []),
        arenaMinY: M.cwrap('wasm_get_arena_min_y', 'number', []),
        arenaMaxY: M.cwrap('wasm_get_arena_max_y', 'number', []),
    };

    let pass = 0, fail = 0;
    function assert(label, cond) {
        console.log(`  ${cond ? 'PASS' : 'FAIL'}  ${label}`);
        if (cond) pass++; else fail++;
    }
    function countKind(k) {
        let c = 0;
        const n = e.count();
        for (let i = 0; i < n; i++) if (e.kind(i) === k) c++;
        return c;
    }
    function findById(id) {
        const n = e.count();
        for (let i = 0; i < n; i++) if (e.id(i) === id) return i;
        return -1;
    }

    assert(`init(${config}) returns 1`, e.init(config) === 1);
    assert('arena bounds from GameConfig',
        e.arenaMinX() === -9.5 && e.arenaMaxX() === 9.5 &&
        e.arenaMinY() === -6.5 && e.arenaMaxY() === 6.5);
    assert('two heroes before first tick',
        countKind(KIND.HERO_EAGLE) === 1 && countKind(KIND.HERO_FROG) === 1);
    assert('spawn_list gem cluster present', countKind(KIND.GEM) === 8);

    /* Join flow: possession, not spawning. Two heroes -> two players. */
    const p1 = e.join(1);
    const p2 = e.join(2);
    assert('join(1) possesses a hero', p1 > 0);
    assert('join(2) possesses the other hero', p2 > 0 && p2 !== p1);
    assert('join(1) is idempotent', e.join(1) === p1);
    assert('join(3) finds no free hero', e.join(3) === 0);
    assert('playerEntityId(1) matches', e.playerEntityId(1) === p1);

    /* First tick runs app_start; wave data loads. */
    e.tick();
    assert('36 waves loaded', e.waveCount() === 36);
    assert('tick_rate from GameTimeConfig', e.tickRate() === 60);
    assert('victory at 10800 ticks', e.victoryTicks() === 10800);
    assert('entity count sane after tick', e.count() >= 10);

    /* Possessed hero obeys input (hero_ai skips PossessedBy). */
    let i1 = findById(p1);
    const startX = e.x(i1);
    for (let t = 0; t < 60; t++) {
        e.setInput(1, 1, 0);   /* due east */
        e.setInput(2, 0, 0);   /* P2 holds still */
        e.tick();
    }
    i1 = findById(p1);
    const dx = e.x(i1) - startX;
    assert(`P1 moved east under input (dx=${dx.toFixed(2)} ~ 2.0 expected)`,
        dx > 1.5 && dx <= 2.05);
    assert('P1 slot reads 1', e.slot(i1) === 1);

    /* Run past wave 1 (releases at tick 300) with per-tick input + timing. */
    let sumMs = 0, maxMs = 0, ticks = 0;
    while (e.gameTick() < 400 && !e.isGameOver()) {
        e.setInput(1, 0, 0);
        e.tick();
        const ms = e.getTickMs();
        sumMs += ms; if (ms > maxMs) maxMs = ms; ticks++;
    }
    assert('wave 1 released', e.wave() >= 1);
    assert('slimes on the field', countKind(KIND.SLIME) > 0);
    assert('projectiles flying (shuriken or feather)',
        countKind(KIND.SHURIKEN) + countKind(KIND.FEATHER) >= 0);
    assert('no game over at tick 400', e.isGameOver() === 0);
    assert('hero level accessor sane',
        e.heroLevel() >= 1 && e.nextLevelXp() >= e.gems());

    /* All exported units carry a known kind + sane scalars. */
    let kindsOk = true, healthOk = true;
    const n = e.count();
    for (let i = 0; i < n; i++) {
        if (e.kind(i) < 1 || e.kind(i) > 12) kindsOk = false;
        if (e.maxHealth(i) > 0 && e.health(i) > e.maxHealth(i) + 1e-3)
            healthOk = false;
    }
    assert('every exported unit has a known kind', kindsOk);
    assert('health <= max health', healthOk);

    console.log(`\n  engine tick ms over ${ticks} ticks: ` +
        `avg ${(sumMs / ticks).toFixed(3)}, max ${maxMs.toFixed(3)}`);
    console.log(`\n--- Results: ${pass}/${pass + fail} passed ---`);
    process.exit(fail === 0 ? 0 : 1);
}

run().catch((err) => { console.error(err); process.exit(1); });
#!/usr/bin/env python3
"""Generate the sashimi sandbox data layer from the Unity extraction JSON.

Reads the machine extraction of the sashimi Unity project (see
/Users/christina/Dev/sashimi/CONTENT-ANALYSIS.md and the extraction scripts in
sashimi's bin/content-extraction/) and emits:

    sandboxes/sashimi/components/*.yaml   component schemas
    sandboxes/sashimi/entities/*.yaml     archetype bases + variant templates
    sandboxes/sashimi/data/waves.yaml     the 36-wave / 502-entry spawn script
    sandboxes/sashimi/data/faction-matrix.yaml  (from the golden engine fixture)
    sandboxes/sashimi/app.yaml            game config + spawn list

Usage (from the flecs-ecs repo root):

    python3 sandboxes/sashimi/tools/generate_content.py \
        --extraction-dir /path/to/content-extraction/out

The extraction dir must contain scriptable_objects.json, prefab_trees.json and
scene_trees.json. Regenerate them with the scripts in
~/Dev/sashimi/bin/content-extraction/ (venv + unityparser; requirements.txt
there). Default: ~/Dev/sashimi/bin/content-extraction/out.

The generator is the single source for everything under sandboxes/sashimi/
except CLAUDE.md, tools/ and tests/. It asserts golden values from
CONTENT-ANALYSIS.md so extraction drift fails loudly instead of silently
changing game data.
"""

import argparse
import json
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# Extraction access helpers
# ---------------------------------------------------------------------------

PT = {}  # prefab_trees.json
SO = {}  # scriptable_objects.json
ST = {}  # scene_trees.json


def die(msg):
    sys.exit(f"generate_content.py: ERROR: {msg}")


def check(cond, msg):
    if not cond:
        die(msg)


def prefab_root(path):
    check(path in PT, f"prefab not in extraction: {path}")
    return PT[path][0]


def base_field(base_path, comp_type, field):
    """Field value from a base prefab's authoring component."""
    root = prefab_root(base_path)
    for comp in root.get("components", []):
        if comp["type"] == comp_type:
            check(field in comp["fields"],
                  f"{base_path}: {comp_type} has no field {field}")
            return comp["fields"][field]
    die(f"{base_path}: no component {comp_type}")


def ov(node, key, default=None, required=False):
    """Override value from a prefab-instance node (dumped m_Modifications)."""
    o = node.get("overrides", {})
    if key in o:
        return o[key]
    if required:
        die(f"missing required override {key!r} on {node.get('name')}")
    return default


def resolve(node, base_root, comp_type, field, base_path):
    """Variant value: instance override if present, else base prefab value."""
    v = ov(node, f"{comp_type}({base_root}).{field}")
    if v is not None:
        return v
    return base_field(base_path, comp_type, field)


FACTION_FILTER = {
    "UnitPhysicsMaterial_Blue": "Unit_Blue",
    "UnitPhysicsMaterial_Red": "Unit_Red",
    "UnitPhysicsMaterial_Green": "Unit_Green",
    "UnitPhysicsMaterial_Yellow": "Unit_Yellow",
    "HarmEffectPhysicsMaterial_Blue": "HarmEffect_Blue",
    "HarmEffectPhysicsMaterial_Red": "HarmEffect_Red",
    "HarmEffectPhysicsMaterial_Green": "HarmEffect_Green",
    "HarmEffectPhysicsMaterial_Yellow": "HarmEffect_Yellow",
    "HarmEffectPhysicsMaterial_Global": "HarmEffect_Global",
    "HelpEffectPhysicsMaterial_Blue": "HelpEffect_Blue",
    "HelpEffectPhysicsMaterial_Red": "HelpEffect_Red",
    "HelpEffectPhysicsMaterial_Green": "HelpEffect_Green",
    "HelpEffectPhysicsMaterial_Yellow": "HelpEffect_Yellow",
    "HelpEffectPhysicsMaterial_Global": "HelpEffect_Global",
    "NonePhysicsMaterial": "None",
}


def faction_filter(material_ref):
    """Map a PhysicsMaterialTemplate asset ref to a faction-matrix filter name."""
    check(material_ref and "ref" in material_ref,
          f"faction material ref unresolved: {material_ref}")
    stem = Path(material_ref["ref"]).stem
    check(stem in FACTION_FILTER, f"unknown physics material {stem}")
    return FACTION_FILTER[stem]


def fnum(v):
    """YAML scalar for a number: shortest round-trip repr."""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    r = repr(float(v))
    return r[:-2] if r.endswith(".0") else r


# ---------------------------------------------------------------------------
# YAML emission
# ---------------------------------------------------------------------------

GENERATED_NOTE = ("# GENERATED by sandboxes/sashimi/tools/generate_content.py"
                  " -- do not edit by hand.\n")


def write_out(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    print(f"  wrote {path}")


def emit_component(outdir, name, kind, fields, doc):
    """fields: list of (fname, type, count_or_None, comment_or_None)."""
    lines = [GENERATED_NOTE]
    for d in doc:
        lines.append(f"# {d}\n")
    lines.append(f"name: {name}\n")
    lines.append(f"kind: {kind}\n")
    if fields:
        lines.append("fields:\n")
        for fname, ftype, count, comment in fields:
            spec = f"{{ type: {ftype} }}" if not count else \
                   f"{{ type: {ftype}, count: {count} }}"
            pad = f"  {fname}: {spec}"
            lines.append(pad + (f"   # {comment}\n" if comment else "\n"))
    write_out(outdir / f"{name}.yaml", "".join(lines))


def emit_entity(outdir, name, doc, extends=None, abstract=True,
                components=None, children=None):
    """components: list of (CompName, {field: value}, comment_or_None).
    children: list of dicts {name, template, components(optional same shape)}."""
    lines = [GENERATED_NOTE]
    for d in doc:
        lines.append(f"# {d}\n")
    lines.append(f"name: {name}\n")
    if abstract:
        lines.append("abstract: true\n")
    if extends:
        lines.append(f"extends: {extends}\n")
    if components:
        lines.append("components:\n")
        for cname, vals, comment in components:
            inner = ", ".join(f"{k}: {fnum(v) if not isinstance(v, (list, str)) else v}"
                              if not isinstance(v, list)
                              else f"{k}: [{', '.join(fnum(x) for x in v)}]"
                              for k, v in vals.items())
            line = f"  {cname}: {{ {inner} }}"
            lines.append(line + (f"   # {comment}\n" if comment else "\n"))
    if children:
        lines.append("children:\n")
        for ch in children:
            lines.append(f"  - name: {ch['name']}\n")
            if ch.get("template"):
                lines.append(f"    template: {ch['template']}\n")
            for cname, vals, comment in ch.get("components", []):
                if not ch.get("_components_header"):
                    lines.append("    components:\n")
                    ch["_components_header"] = True
                inner = ", ".join(f"{k}: {fnum(v)}" for k, v in vals.items())
                lines.append(f"      {cname}: {{ {inner} }}"
                             + (f"   # {comment}\n" if comment else "\n"))
    write_out(outdir / f"{name}.yaml", "".join(lines))


def s(v):
    """Quote a string value for inline YAML."""
    return f'"{v}"'


# ---------------------------------------------------------------------------
# Component schemas
# ---------------------------------------------------------------------------

def gen_components(outdir):
    """The component schema the sashimi game data needs.

    Times are stored in SECONDS exactly as authored in the Unity assets;
    systems convert to ticks with GameTimeConfig.tick_rate (60 Hz, from
    Assets/Settings/NetcodeConfig.asset SimulationTickRate). Enum-ish fields
    are i32 with the Unity enum documented in a comment.
    """
    C = []  # (name, kind, fields, doc)

    C.append(("Position", "component",
              [("x", "f32", None, None), ("y", "f32", None, None)],
              ["World position, continuous 2D space centered on the arena",
               "origin (Unity Transform.position.xy)."]))
    C.append(("Velocity", "component",
              [("x", "f32", None, None), ("y", "f32", None, None)],
              ["Current velocity in units/second (movement system output)."]))
    C.append(("MoveSpeed", "component",
              [("value", "f32", None, "units/second")],
              ["Base move speed (UnitAuthoring.MoveSpeed)."]))
    C.append(("InputDirection", "component",
              [("x", "f32", None, None), ("y", "f32", None, None)],
              ["Per-tick directional input written to a possessed hero",
               "(sashimi IInputComponentData InputDirection; 45-degree",
               "octant-snapped by the client)."]))
    C.append(("Health", "component",
              [("current", "f32", None, None),
               ("max", "f32", None, "HealthAuthoring.MaxHealth")],
              ["Hit points. Templates set current == max."]))
    C.append(("Faction", "component",
              [("filter", "string", None,
                "filter name in data/faction-matrix.yaml")],
              ["Faction/collision-filter category",
               "(FactionAuthoring.MaterialTemplate physics material).",
               "Interaction legality comes from data/faction-matrix.yaml."]))
    C.append(("Collider", "component",
              [("shape", "i32", None, "0=none 1=circle 2=rect (FactionAuthoring.Collider)"),
               ("radius", "f32", None, "circle radius"),
               ("width", "f32", None, "rect width"),
               ("height", "f32", None, "rect height"),
               ("enabled", "bool", None,
                "false = StartDisabled (ability hitboxes toggle this)")],
              ["Collision shape (FactionAuthoring collider fields)."]))
    C.append(("ChildOffset", "component",
              [("x", "f32", None, None), ("y", "f32", None, None)],
              ["Offset from gameplay parent",
               "(GameplayChildAuthoring.OffsetPosition). Sashimi does not use",
               "transform hierarchy for this; a child-offset sync system",
               "positions children each tick."]))
    C.append(("AISteering", "component",
              [("start_follow", "f32", None, "UnitAuthoring.StartFollowDistance"),
               ("stop_follow", "f32", None, "UnitAuthoring.StopFollowDistance"),
               ("start_flee", "f32", None,
                "UnitAuthoring.StartFleeDistance; -1 = never flee"),
               ("acquire_radius", "f32", None,
                "CreatureAuthoring.TargetAcquisitionRadius")],
              ["Creature AI steering parameters. Presence of this component",
               "classifies an entity as an AI-driven creature."]))
    C.append(("Hero", "component",
              [("hero_id", "i32", None,
                "HeroAuthoring.heroNameId: 1=Eagle 2=Frog")],
              ["Hero identity. Presence classifies an entity as a hero."]))
    C.append(("Experience", "component",
              [("xp", "f32", None, None),
               ("level", "i32", None, "1-based, capped by level-up table max_level")],
              ["XP / level progression state."]))
    C.append(("Weapon", "component",
              [("cooldown", "f32", None,
                "seconds between shots (ProjectileWeaponAuthoring.Cooldown)"),
               ("projectile", "string", None, "projectile template name")],
              ["Projectile weapon (fires 'projectile' at the acquired target",
               "every 'cooldown' seconds; starts on cooldown per",
               "ProjectileWeaponAuthoring baker)."]))
    C.append(("Projectile", "component",
              [("range", "f32", None, "world units before despawn"),
               ("speed", "f32", None, "units/second"),
               ("pierce", "i32", None, "ProjectileAuthoring.Piercing"),
               ("bounce", "i32", None, "ProjectileAuthoring.Bouncing")],
              ["Projectile flight parameters (ProjectileAuthoring)."]))
    C.append(("DamageOnHit", "component",
              [("damage", "f32", None, None),
               ("hit_limit", "i32", None, "max entities hit before spent"),
               ("ignore_hit_limit", "bool", None, None),
               ("reset_time", "f32", None,
                "seconds before the same target can be hit again; -1 = never")],
              ["Contact damage trigger (OnHitDamageTriggerAuthoring)."]))
    C.append(("PeriodicDamage", "component",
              [("damage", "f32", None, "damage per periodic tick")],
              ["Damage aura (PeriodicDamageTriggerAuthoring.DamagePerTick).",
               "Cadence = GameTimeConfig.periodic_tick_time (0.25 s)."]))
    C.append(("StatusEffectOnHit", "component",
              [("duration", "f32", None, "seconds"),
               ("periodic_damage", "f32", None, "damage per periodic tick"),
               ("stat_type", "i32", None, "UnitStats-ish StatType: 1=MovementSpeed"),
               ("magnitude", "f32", None,
                "modifier magnitude (e.g. -0.75 = 75% slow, +0.5 = 50% haste)"),
               ("modifier_type", "i32", None,
                "FloatModifierType: 5=MultiplyBuffStrongest 6=MultiplyDebuffStrongest"),
               ("stack_limit", "i32", None, None),
               ("ignore_stacks", "bool", None, None),
               ("charges", "i32", None, None),
               ("unlimited_charges", "bool", None, None)],
              ["Status-effect definition applied to targets on hit",
               "(StatusEffectAuthoring.OnHitStatusEffects[0]; shipped content",
               "never uses more than one entry per entity)."]))
    C.append(("StatusPoison", "component",
              [("ticks_remaining", "i32", None, None),
               ("damage_per_tick", "f32", None, "applied on the periodic clock")],
              ["Runtime: active poison on a unit (from shuriken",
               "StatusEffectOnHit). Added/removed by the status system."]))
    C.append(("StatusSlow", "component",
              [("ticks_remaining", "i32", None, None),
               ("magnitude", "f32", None,
                "move-speed multiplier delta (-0.75 = 75% slow, +0.5 = buff)")],
              ["Runtime: active move-speed modifier (poison slow or feather",
               "recall haste). Strongest-only per stacking rules."]))
    C.append(("SpentProjectile", "component",
              [("spawner_template", "string", None,
                "template spawned where the projectile is spent")],
              ["Spent-projectile behavior (ProjectileAuthoring",
               ".SpentProjectilePrefab): spent feathers leave a recall",
               "spawner in the world. Empty string = none."]))
    C.append(("OneShotProjectileSpawner", "component",
              [("projectile", "string", None, "projectile template name")],
              ["Fires its projectile once when triggered",
               "(OneShotProjectileSpawnerAuthoring; feather recall)."]))
    C.append(("Pickup", "component",
              [("effect", "i32", None,
                "helpEffectType: 1=GemPickup(XP) 2=HealthPickup 3=WeaponPickup"),
               ("value", "f32", None, "OnHitHelpTriggerAuthoring.Value"),
               ("move_speed", "f32", None,
                "magnet fly-to-hero speed (PickupAuthoring.MoveSpeed)")],
              ["Pickup payload + magnet speed (OnHitHelpTriggerAuthoring +",
               "PickupAuthoring). NOTE: shipped heart-heal behavior is 25% of",
               "max HP (PickupConfig.heart_heal_ratio), not 'value'."]))
    C.append(("AbilityConfig", "component",
              [("id", "i32", None,
                "AbilityId: 1=LargeCubeCharge 2=WolfAttack 3=SlimeAttack 4=LargeCubeAttack"),
               ("windup", "f32", None, "seconds (activeConfig.WindupDuration)"),
               ("active", "f32", None, "seconds (activeConfig.ActiveDuration)"),
               ("recovery", "f32", None, "seconds (activeConfig.RecoveryDuration)"),
               ("cooldown", "f32", None,
                "seconds; 0 = no cooldown ready-condition"),
               ("start_on_cooldown", "bool", None, None),
               ("min_range", "f32", None, "enemy-target ready condition"),
               ("max_range", "f32", None, "enemy-target ready condition")],
              ["Ability tuning (AbilitySO activeConfig + ready conditions).",
               "The hitbox shape/damage live on the same entity",
               "(Collider + DamageOnHit)."]))
    C.append(("AbilityState", "component",
              [("stage", "i32", None,
                "0=ready 1=windup 2=active 3=recovery 4=cooldown"),
               ("ticks_remaining", "i32", None, "ticks left in current stage")],
              ["Runtime ability state machine bookkeeping."]))
    # --- GameConfig resources (live on the GameConfig entity) -------------
    C.append(("GameTimeConfig", "component",
              [("tick_rate", "i32", None,
                "simulation Hz (NetcodeConfig SimulationTickRate); all"
                " seconds-denominated content converts via this"),
               ("periodic_tick_time", "f32", None,
                "periodic damage/poison clock, seconds (0.25)")],
              ["Tick semantics (GameTimeConfig + netcode tick rate)."]))
    C.append(("SpawnConfig", "component",
              [("spawn_delay", "f32", None,
                "seconds between individual spawns inside a wave"),
               ("spawn_max", "i32", None, "0 = unlimited concurrent spawns"),
               ("spawn_growth", "f32", None,
                "creature level growth over the match (Adventure: 100)")],
              ["Global spawn pacing (GameConfig spawnConfig, Adventure",
               "subscene instance values)."]))
    C.append(("GameOverConfig", "component",
              [("victory_timer_seconds", "f32", None, "survive this long to win"),
               ("game_over_delay_seconds", "f32", None, None)],
              ["Victory/defeat timing (GameConfig gameOverConfig)."]))
    C.append(("MoveConfig", "component",
              [("min_distance_to_move", "f32", None, None)],
              ["Movement epsilon (GameConfig moveConfig)."]))
    C.append(("CombatConfig", "component",
              [("target_switch_threshold", "f32", None, None),
               ("damage_taken_ratio", "f32", None,
                "hero incoming-damage multiplier; 1.0 = sashimi behavior."
                " The headless-verify config in app.yaml selects 0.5")],
              ["Combat tuning (GameConfig combatConfig). damage_taken_ratio",
               "is a port-added GameConfig-style field consumed by the damage",
               "system (see app.yaml headless-verify and CLAUDE.md)."]))
    C.append(("PickupConfig", "component",
              [("acceleration", "f32", None, "pickup magnet acceleration"),
               ("trigger_distance", "f32", None, "pickup-collect distance"),
               ("drop_distance", "f32", None, "drop scatter distance"),
               ("gem_drop_scale", "f32", None, "gem drop chance"),
               ("heart_drop_scale", "f32", None,
                "heart drop chance (Adventure override 0.0375)"),
               ("heart_heal_ratio", "f32", None,
                "hearts heal this fraction of max HP (hardcoded 25% in"
                " sashimi's pickup code; the serialized Value 25 is ignored)")],
              ["Drop rates + magnet tuning (GameConfig pickupConfig)."]))
    C.append(("CreatureLevelUp", "component",
              [("max_level", "i32", None, None),
               ("xp", "i32", 20, "XP required at level n (row n-1)"),
               ("damage", "f32", 20, "damage multiplier at level n"),
               ("health", "f32", 20, "health multiplier at level n")],
              ["Creature level-up table",
               "(Assets/Creatures/Creature_LevelUpSO.asset; wired to the",
               "GameConfig only by the Adventure scene-instance override)."]))
    C.append(("HeroLevelUp", "component",
              [("max_level", "i32", None, None),
               ("xp", "i32", 20, "XP required at level n (row n-1)"),
               ("damage", "f32", 20, "damage multiplier at level n"),
               ("health", "f32", 20, "health multiplier at level n")],
              ["Hero level-up table (Assets/Heroes/Hero_LevelUpSO.asset).",
               "Heroes fully heal on level-up (live behavior)."]))
    C.append(("HeroLevelBonus", "component",
              [("bounce_limit", "f32", 20, "Frog: shuriken bounce limit per level"),
               ("pierce_limit", "f32", 20, "Eagle: feather pierce limit per level"),
               ("recall_limit", "f32", 20, "Eagle: feather recall limit per level")],
              ["Hero-specific per-level stats (LevelUpHeroSpecificSO",
               "UnitStats: 1=BounceLimit 2=PierceLimit 3=RecallLimit).",
               "Unused arrays stay 0 for the other hero."]))
    C.append(("ArenaBounds", "component",
              [("min_x", "f32", None, None), ("min_y", "f32", None, None),
               ("max_x", "f32", None, None), ("max_y", "f32", None, None)],
              ["Playable arena bounds in world units (the Unity editor clamps",
               "spawn points to x [-9.5, 9.5], y [-6.5, 6.5])."]))
    # --- Lifecycle / spawn-wave bookkeeping --------------------------------
    C.append(("WaveState", "component",
              [("next_wave", "i32", None, "1-based index into data/waves.yaml"),
               ("ticks_to_next", "i32", None,
                "ticks until the next wave starts (init = first wave delay)"),
               ("spawned_total", "i32", None, "entries spawned so far")],
              ["Runtime spawn-director bookkeeping over data/waves.yaml",
               "(UnitSpawnWaveState). Lives on the GameState entity."]))
    C.append(("PendingSpawn", "component",
              [("template", "string", None, None),
               ("x", "f32", None, None), ("y", "f32", None, None),
               ("ticks_remaining", "i32", None, None)],
              ["Runtime: a scheduled spawn (wave entry or drop) waiting out",
               "its telegraph delay; the spawn system materializes it."]))
    C.append(("RespawnTimer", "component",
              [("ticks_remaining", "i32", None, None)],
              ["Runtime: hero respawn countdown (baked disabled in Unity;",
               "added on defeat here)."]))
    C.append(("IFramesTimer", "component",
              [("ticks_remaining", "i32", None, None)],
              ["Runtime: post-hit invulnerability window."]))
    C.append(("DestroyOnTimer", "component",
              [("ticks_remaining", "i32", None, None)],
              ["Runtime: timed despawn (projectile range expiry, FX)."]))
    C.append(("Defeated", "marker", [],
              ["Runtime: unit defeated this tick (per-turn flag; remove,",
               "don't set false -- root CLAUDE.md decision 8)."]))
    C.append(("GameTime", "component",
              [("tick", "i64", None, None)],
              ["Runtime: simulation tick counter singleton (GameState)."]))
    C.append(("MatchStats", "component",
              [("gems", "i32", None, None),
               ("kills", "i32", None, None)],
              ["Runtime: match statistics singleton (GameState)."]))

    for name, kind, fields, doc in C:
        emit_component(outdir, name, kind, fields, doc)
    return [c[0] for c in C]


# ---------------------------------------------------------------------------
# Entity templates
# ---------------------------------------------------------------------------

CREATURE_BASE = "Assets/Prefabs/Gameplay/CreatureEntity.prefab"
HERO_BASE = "Assets/Prefabs/Gameplay/HeroEntity.prefab"
PROJ_BASE = "Assets/Prefabs/Gameplay/ProjectileEntity.prefab"
WEAPON_BASE = "Assets/Prefabs/Gameplay/Children/ProjectileWeaponEntity.prefab"
HITBOX_BASE = "Assets/Prefabs/Gameplay/Children/ProximityDamageEntity.prefab"
AURA_BASE = "Assets/Prefabs/Gameplay/Children/DamageAuraEntity.prefab"
STAT_AURA_BASE = "Assets/Prefabs/Environment/StationaryDamageAuraEntity.prefab"
PICKUP_BASE = "Assets/Prefabs/Gameplay/PickupEntity.prefab"


def collider_from(fields_or_getter):
    """Build Collider dict from FactionAuthoring-style fields via callable."""
    g = fields_or_getter
    shape = g("Collider")
    return {"shape": shape, "radius": g("Radius"), "width": g("Width"),
            "height": g("Height"),
            "enabled": (g("StartDisabled") or 0) == 0}


def gen_archetypes(outdir):
    """The 9 base archetype templates (CONTENT-ANALYSIS section 1)."""
    # CreatureEntity ---------------------------------------------------------
    bf = lambda c, f: base_field(CREATURE_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    emit_entity(outdir, "CreatureEntity",
                ["Source: " + CREATURE_BASE,
                 "Creature archetype defaults; concrete creatures extend this",
                 "with sparse overrides + ability children."],
                components=[
                    ("Position", {"x": 0, "y": 0}, None),
                    ("Velocity", {"x": 0, "y": 0}, None),
                    ("MoveSpeed", {"value": bf("UnitAuthoring", "MoveSpeed")},
                     "UnitAuthoring.MoveSpeed"),
                    ("Health", {"current": bf("HealthAuthoring", "MaxHealth"),
                                "max": bf("HealthAuthoring", "MaxHealth")},
                     "HealthAuthoring.MaxHealth"),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     "FactionAuthoring: Type=Unit Color=Red"),
                    ("Collider", collider_from(fg), "circle r=0.2"),
                    ("AISteering",
                     {"start_follow": bf("UnitAuthoring", "StartFollowDistance"),
                      "stop_follow": bf("UnitAuthoring", "StopFollowDistance"),
                      "start_flee": bf("UnitAuthoring", "StartFleeDistance"),
                      "acquire_radius": bf("CreatureAuthoring",
                                           "TargetAcquisitionRadius")},
                     "follow/flee distances + acquisition radius"),
                    ("Experience", {"xp": 0, "level": 1}, None),
                ])
    check(bf("HealthAuthoring", "MaxHealth") == 42, "CreatureEntity HP != 42")

    # HeroEntity -------------------------------------------------------------
    bf = lambda c, f: base_field(HERO_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    emit_entity(outdir, "HeroEntity",
                ["Source: " + HERO_BASE,
                 "Hero archetype defaults. Unity's base hero carries a",
                 "ProjectileWeaponEntity child slot that every hero variant",
                 "overrides; here each concrete hero declares its own weapon",
                 "child instead."],
                components=[
                    ("Position", {"x": 0, "y": 0}, None),
                    ("Velocity", {"x": 0, "y": 0}, None),
                    ("InputDirection", {"x": 0, "y": 0}, None),
                    ("MoveSpeed", {"value": bf("UnitAuthoring", "MoveSpeed")},
                     "base 4; hero variants set 2"),
                    ("Health", {"current": bf("HealthAuthoring", "MaxHealth"),
                                "max": bf("HealthAuthoring", "MaxHealth")}, None),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     "FactionAuthoring: Type=Unit Color=Blue"),
                    ("Collider", collider_from(fg), "rect 0.4x0.25"),
                    ("Hero", {"hero_id": bf("HeroAuthoring", "heroNameId")}, None),
                    ("Experience", {"xp": 0, "level": 1}, None),
                ])
    check(bf("HealthAuthoring", "MaxHealth") == 50, "HeroEntity HP != 50")

    # ProjectileEntity -------------------------------------------------------
    bf = lambda c, f: base_field(PROJ_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    emit_entity(outdir, "ProjectileEntity",
                ["Source: " + PROJ_BASE],
                components=[
                    ("Position", {"x": 0, "y": 0}, None),
                    ("Velocity", {"x": 0, "y": 0}, None),
                    ("Projectile",
                     {"range": bf("ProjectileAuthoring", "Range"),
                      "speed": bf("ProjectileAuthoring", "Speed"),
                      "pierce": bf("ProjectileAuthoring", "Piercing"),
                      "bounce": bf("ProjectileAuthoring", "Bouncing")}, None),
                    ("DamageOnHit",
                     {"damage": bf("OnHitDamageTriggerAuthoring", "Damage"),
                      "hit_limit":
                          bf("OnHitDamageTriggerAuthoring",
                             "OnHitDamageTrigger")["HitLimit"],
                      "ignore_hit_limit": False,
                      "reset_time":
                          bf("OnHitDamageTriggerAuthoring", "ResetTime")},
                     "base damage 1 / hit limit 1"),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))}, None),
                    ("Collider", collider_from(fg), "circle r=0.25"),
                ])

    # ProjectileWeaponEntity -------------------------------------------------
    bf = lambda c, f: base_field(WEAPON_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    off = bf("GameplayChildAuthoring", "OffsetPosition")
    emit_entity(outdir, "ProjectileWeaponEntity",
                ["Source: " + WEAPON_BASE,
                 "Weapon child archetype: acquires a target and fires its",
                 "projectile template on cooldown (starts on cooldown)."],
                components=[
                    ("ChildOffset", {"x": off["x"], "y": off["y"]}, None),
                    ("Weapon",
                     {"cooldown": bf("ProjectileWeaponAuthoring", "Cooldown"),
                      "projectile": s("")},
                     "base cooldown 0.5; variants wire the projectile"),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     "NonePhysicsMaterial: inert until variant overrides"),
                    ("Collider", collider_from(fg), None),
                ])

    # ProximityDamageEntity (melee/contact hitbox) ---------------------------
    bf = lambda c, f: base_field(HITBOX_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    off = bf("GameplayChildAuthoring", "OffsetPosition")
    emit_entity(outdir, "ProximityDamageEntity",
                ["Source: " + HITBOX_BASE,
                 "Melee/contact hitbox child archetype."],
                components=[
                    ("ChildOffset", {"x": off["x"], "y": off["y"]}, None),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     "HarmEffect/Red"),
                    ("Collider", collider_from(fg), None),
                    ("DamageOnHit",
                     {"damage": bf("OnHitDamageTriggerAuthoring", "Damage"),
                      "hit_limit":
                          bf("OnHitDamageTriggerAuthoring",
                             "OnHitDamageTrigger")["HitLimit"],
                      "ignore_hit_limit": False,
                      "reset_time":
                          bf("OnHitDamageTriggerAuthoring", "ResetTime")},
                     "base damage 50 (every shipped ability overrides it)"),
                ])

    # DamageAuraEntity -------------------------------------------------------
    bf = lambda c, f: base_field(AURA_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    off = bf("GameplayChildAuthoring", "OffsetPosition")
    emit_entity(outdir, "DamageAuraEntity",
                ["Source: " + AURA_BASE,
                 "Attached periodic-damage aura child archetype. No live",
                 "content uses it (SlimeOrange's aura variant is on the skip",
                 "list); kept as one of the 9 archetypes."],
                components=[
                    ("ChildOffset", {"x": off["x"], "y": off["y"]}, None),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))}, None),
                    ("Collider", collider_from(fg), None),
                    ("PeriodicDamage",
                     {"damage": bf("PeriodicDamageTriggerAuthoring",
                                   "DamagePerTick")}, None),
                ])

    # StationaryDamageAuraEntity ---------------------------------------------
    bf = lambda c, f: base_field(STAT_AURA_BASE, c, f)
    fg = lambda f: (bf("FactionAuthoring", f)
                    if f != "StartDisabled" else 0)
    emit_entity(outdir, "StationaryDamageAuraEntity",
                ["Source: " + STAT_AURA_BASE,
                 "Free-standing environment hazard archetype (LavaPit).",
                 "NOTE: the authored FactionAuthoring radius is 0 in the",
                 "asset (extraction-faithful); the Unity physics shape came",
                 "from a separate PhysicsShapeAuthoring the port ignores.",
                 "Concrete hazards should set a real collider."],
                components=[
                    ("Position", {"x": 0, "y": 0}, None),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     "HarmEffect/Global"),
                    ("Collider", collider_from(fg), None),
                    ("PeriodicDamage",
                     {"damage": bf("PeriodicDamageTriggerAuthoring",
                                   "DamagePerTick")}, None),
                ])

    # PickupEntity ------------------------------------------------------------
    bf = lambda c, f: base_field(PICKUP_BASE, c, f)
    fg = lambda f: bf("FactionAuthoring", f)
    emit_entity(outdir, "PickupEntity",
                ["Source: " + PICKUP_BASE,
                 "Pickup archetype: HelpEffect/Blue trigger (hero-only by",
                 "faction matrix construction) + magnet movement."],
                components=[
                    ("Position", {"x": 0, "y": 0}, None),
                    ("Velocity", {"x": 0, "y": 0}, None),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     "HelpEffect/Blue"),
                    ("Collider", collider_from(fg), "trigger circle r=0.5"),
                    ("Pickup",
                     {"effect": bf("OnHitHelpTriggerAuthoring", "helpEffectType"),
                      "value": bf("OnHitHelpTriggerAuthoring", "Value"),
                      "move_speed": bf("PickupAuthoring", "MoveSpeed")}, None),
                ])

    # AbilityBase --------------------------------------------------------------
    emit_entity(outdir, "AbilityBase",
                ["Source: Assets/Prefabs/Abilities/AbilityBase.prefab",
                 "(AbilityConfig + AbilityState) folded onto the hitbox",
                 "archetype: in this port an ability IS its hitbox entity",
                 "with timing/ready data attached, matching how Unity bakes",
                 "the AbilitySO onto the ProximityDamageEntity child."],
                extends="ProximityDamageEntity",
                components=[
                    ("AbilityConfig",
                     {"id": 0, "windup": 0, "active": 0, "recovery": 0,
                      "cooldown": 0, "start_on_cooldown": False,
                      "min_range": 0, "max_range": 0}, None),
                    ("AbilityState", {"stage": 0, "ticks_remaining": 0}, None),
                ])


def gen_abilities(outdir):
    """Concrete melee/contact abilities: AbilitySO + hitbox prefab variant."""
    specs = [
        # name, so asset, ability prefab
        ("SlimeAttack",
         "Assets/Creatures/SlimeOrange/Attack/SlimeAttack_AbilitySO.asset",
         "Assets/Creatures/SlimeOrange/Attack/SlimeAttack_Ability.prefab"),
        ("WolfAttack",
         "Assets/Creatures/Wolf/Attack/WolfAttack_AbilitySO.asset",
         "Assets/Creatures/Wolf/Attack/WolfAttack_Ability.prefab"),
        ("RockGolemAttack",
         "Assets/Creatures/RockGolem/Attack/RockGolemAttack_AbilitySO.asset",
         "Assets/Creatures/RockGolem/Attack/RockGolemAttack_Ability.prefab"),
        ("WispAttack",
         "Assets/Creatures/Wisp/Attack/WispAttack_AbilitySO.asset",
         "Assets/Creatures/Wisp/Attack/WispAttack_Ability.prefab"),
        ("LargeCubeAttack",
         "Assets/Creatures/LargeTealCube/Attack/LargeCubeAttack_AbilitySO.asset",
         "Assets/Creatures/LargeTealCube/Attack/LargeCubeAttack_Ability.prefab"),
        ("LargeCubeCharge",
         "Assets/Creatures/LargeTealCube/Charge/LargeCubeCharge_AbilitySO.asset",
         "Assets/Creatures/LargeTealCube/Charge/LargeCubeCharge_Ability.prefab"),
    ]
    golden = {  # CONTENT-ANALYSIS section 3 table: damage / hit reset
        "SlimeAttack": (12.5, 1.0), "WolfAttack": (12.5, 0.3),
        "RockGolemAttack": (12.5, 1.0), "WispAttack": (12.5, 1.0),
        "LargeCubeAttack": (12.5, 1.0), "LargeCubeCharge": (25, 0.5),
    }
    for name, so_path, prefab_path in specs:
        check(so_path in SO, f"missing SO {so_path}")
        f = SO[so_path]["fields"]
        node = prefab_root(prefab_path)
        check(node.get("prefab_instance") == HITBOX_BASE,
              f"{prefab_path} is not a ProximityDamageEntity variant")
        pov = lambda field, dflt=None: (
            ov(node, f"OnHitDamageTriggerAuthoring(ProximityDamageEntity).{field}",
               dflt))
        fov = lambda field: ov(
            node, f"FactionAuthoring(ProximityDamageEntity).{field}",
            base_field(HITBOX_BASE, "FactionAuthoring", field))
        dmg = pov("Damage", base_field(HITBOX_BASE,
                                       "OnHitDamageTriggerAuthoring", "Damage"))
        reset = pov("ResetTime", base_field(HITBOX_BASE,
                                            "OnHitDamageTriggerAuthoring",
                                            "ResetTime"))
        check((dmg, reset) == golden[name],
              f"{name}: damage/reset {(dmg, reset)} != golden {golden[name]}")
        offx = ov(node, "GameplayChildAuthoring(ProximityDamageEntity)"
                        ".OffsetPosition.x", 0)
        offy = ov(node, "GameplayChildAuthoring(ProximityDamageEntity)"
                        ".OffsetPosition.y", 0)
        use_cd = f["CooldownReadyCondition"] == 1
        cfg = {
            "id": f["Id"],
            "windup": f["activeConfig"]["WindupDuration"],
            "active": f["activeConfig"]["ActiveDuration"],
            "recovery": f["activeConfig"]["RecoveryDuration"],
            "cooldown": f["cooldownReadyData"]["Duration"] if use_cd else 0,
            "start_on_cooldown":
                bool(f["cooldownReadyData"]["StartOnCooldown"]) if use_cd
                else False,
            "min_range": f["enemyTargetData"]["MinRange"],
            "max_range": f["enemyTargetData"]["MaxRange"],
        }
        hit_limit = pov("HitLimit",
                        base_field(HITBOX_BASE, "OnHitDamageTriggerAuthoring",
                                   "OnHitDamageTrigger")["HitLimit"])
        emit_entity(outdir, name,
                    [f"Source: {so_path}",
                     f"      + {prefab_path}"],
                    extends="AbilityBase",
                    components=[
                        ("AbilityConfig", cfg, None),
                        ("Collider",
                         {"shape": fov("Collider"), "radius": fov("Radius"),
                          "width": fov("Width"), "height": fov("Height"),
                          "enabled": fov("StartDisabled") == 0},
                         "starts disabled; toggled by ability state changes"),
                        ("DamageOnHit",
                         {"damage": dmg, "hit_limit": hit_limit,
                          "ignore_hit_limit": False, "reset_time": reset},
                         None),
                        ("ChildOffset", {"x": offx, "y": offy}, None),
                    ])


def gen_creatures(outdir):
    specs = [
        ("CreatureSlimeOrange",
         "Assets/Creatures/SlimeOrange/CreatureSlimeOrange.prefab",
         [("attack", "SlimeAttack")]),
        ("CreatureWolf", "Assets/Creatures/Wolf/CreatureWolf.prefab",
         [("attack", "WolfAttack")]),
        ("CreatureRockGolem",
         "Assets/Creatures/RockGolem/CreatureRockGolem.prefab",
         [("attack", "RockGolemAttack")]),
        ("CreatureWisp", "Assets/Creatures/Wisp/CreatureWisp.prefab",
         [("attack", "WispAttack"), ("weapon", "CreatureWisp_Weapon")]),
        ("LargeTealCube", "Assets/Creatures/LargeTealCube/LargeTealCube.prefab",
         [("attack", "LargeCubeAttack"), ("charge", "LargeCubeCharge")]),
    ]
    golden_hp = {"CreatureSlimeOrange": 30, "CreatureWolf": 45,
                 "CreatureRockGolem": 150, "CreatureWisp": 20,
                 "LargeTealCube": 180}
    for name, prefab_path, kids in specs:
        node = prefab_root(prefab_path)
        check(node.get("prefab_instance") == CREATURE_BASE,
              f"{prefab_path} is not a CreatureEntity variant")
        r = lambda comp, field: resolve(node, "CreatureEntity", comp, field,
                                        CREATURE_BASE)
        hp = r("HealthAuthoring", "MaxHealth")
        check(hp == golden_hp[name], f"{name}: HP {hp} != {golden_hp[name]}")
        comps = [
            ("Health", {"current": hp, "max": hp}, None),
            ("MoveSpeed", {"value": r("UnitAuthoring", "MoveSpeed")}, None),
            ("AISteering",
             {"start_follow": r("UnitAuthoring", "StartFollowDistance"),
              "stop_follow": r("UnitAuthoring", "StopFollowDistance"),
              "start_flee": r("UnitAuthoring", "StartFleeDistance"),
              "acquire_radius": r("CreatureAuthoring",
                                  "TargetAcquisitionRadius")}, None),
        ]
        # Collider only when the variant changes it (LargeTealCube rect)
        shape = r("FactionAuthoring", "Collider")
        if shape != base_field(CREATURE_BASE, "FactionAuthoring", "Collider"):
            comps.append(("Collider",
                          {"shape": shape,
                           "radius": r("FactionAuthoring", "Radius"),
                           "width": r("FactionAuthoring", "Width"),
                           "height": r("FactionAuthoring", "Height"),
                           "enabled": True},
                          "rect collider (only creature that overrides it)"))
        emit_entity(outdir, name, [f"Source: {prefab_path}"],
                    extends="CreatureEntity", components=comps,
                    children=[{"name": cn, "template": ct}
                              for cn, ct in kids])


def status_effect_from_overrides(node, base_root, idx=0):
    """StatusEffectOnHit dict from OnHitStatusEffects.Array.data[idx].* keys."""
    p = (f"StatusEffectAuthoring({base_root})"
         f".OnHitStatusEffects.Array.data[{idx}].")
    g = lambda field, dflt=0: ov(node, p + field, dflt)
    return {
        "duration": g("Duration"),
        "periodic_damage": g("PeriodicDamage"),
        "stat_type": g("StatValue.StatType", g("StatValue.statType")),
        "magnitude": g("StatValue.Magnitude"),
        "modifier_type": g("StatValue.FloatModifierType",
                           g("StatValue.floatModifierType")),
        "stack_limit": g("StackLimit"),
        "ignore_stacks": bool(g("IgnoreStacks")),
        "charges": g("Charges"),
        "unlimited_charges": bool(g("UnlimitedCharges")),
    }


def gen_heroes_and_weapons(outdir):
    # --- Hero-specific level tables (LevelUpHeroSpecificSO) -----------------
    def luhs_table(path, stat_id):
        rows = [r for r in SO[path]["fields"]["LevelUpTable"]
                if r["Stat"] == stat_id]
        check(len(rows) == 20, f"{path}: stat {stat_id} rows != 20")
        rows.sort(key=lambda r: r["Level"])
        return [r["Value"] for r in rows]

    frog_lu = "Assets/Heroes/Frog/HeroFrog_LUHSSO.asset"
    eagle_lu = "Assets/Heroes/Eagle/HeroEagle_LUHSSO.asset"
    frog_bounce = luhs_table(frog_lu, 1)      # UnitStats.BounceLimit
    eagle_pierce = luhs_table(eagle_lu, 2)    # UnitStats.PierceLimit
    eagle_recall = luhs_table(eagle_lu, 3)    # UnitStats.RecallLimit
    check(frog_bounce[0] == 0.5 and frog_bounce[-1] == 10,
          "frog bounce table drifted")
    check(eagle_pierce == [float(i) for i in range(1, 21)],
          "eagle pierce table drifted")

    # --- Heroes --------------------------------------------------------------
    hero_specs = [
        ("HeroFrog", "Assets/Heroes/Frog/HeroFrog.prefab", 2,
         "Shuriken_Weapon",
         ("HeroLevelBonus", {"bounce_limit": frog_bounce},
          "LevelUpHeroSpecificSO: BounceLimit = 0.5 * level")),
        ("HeroEagle", "Assets/Heroes/Eagle/HeroEagle.prefab", 1,
         "Feather_Weapon",
         ("HeroLevelBonus", {"pierce_limit": eagle_pierce,
                             "recall_limit": eagle_recall},
          "LevelUpHeroSpecificSO: Pierce/RecallLimit = level")),
    ]
    for name, prefab_path, hero_id, weapon_tmpl, bonus in hero_specs:
        node = prefab_root(prefab_path)
        check(node.get("prefab_instance") == HERO_BASE,
              f"{prefab_path} is not a HeroEntity variant")
        r = lambda comp, field: resolve(node, "HeroEntity", comp, field,
                                        HERO_BASE)
        check(r("HeroAuthoring", "heroNameId") == hero_id,
              f"{name}: heroNameId != {hero_id}")
        check(r("UnitAuthoring", "MoveSpeed") == 2, f"{name}: MoveSpeed != 2")
        emit_entity(outdir, name, [f"Source: {prefab_path}"],
                    extends="HeroEntity",
                    components=[
                        ("MoveSpeed", {"value": r("UnitAuthoring", "MoveSpeed")},
                         None),
                        ("Hero", {"hero_id": hero_id}, None),
                        bonus,
                    ],
                    children=[{"name": "weapon", "template": weapon_tmpl}])

    # --- Weapons --------------------------------------------------------------
    # Hero weapon faction is set on the HeroEntity child instance in Unity
    # (HarmEffect/Blue); folded into the weapon templates here.
    weapon_specs = [
        ("Shuriken_Weapon",
         "Assets/Heroes/Frog/ShurikenAttack/Shuriken_Weapon.prefab",
         "Shuriken_Projectile", "HarmEffect_Blue", None),
        ("Feather_Weapon",
         "Assets/Heroes/Eagle/FeatherAttack/Feather_Weapon.prefab",
         "Feather_Projectile", "HarmEffect_Blue", None),
        ("CreatureWisp_Weapon",
         "Assets/Creatures/Wisp/RangedAttack/CreatureWisp_Weapon.prefab",
         "CreatureWisp_Projectile", None, "acquisition trigger r=25"),
    ]
    for name, prefab_path, proj_tmpl, forced_faction, coll_note in weapon_specs:
        node = prefab_root(prefab_path)
        check(node.get("prefab_instance") == WEAPON_BASE,
              f"{prefab_path} is not a ProjectileWeaponEntity variant")
        r = lambda comp, field: resolve(node, "ProjectileWeaponEntity",
                                        comp, field, WEAPON_BASE)
        cooldown = r("ProjectileWeaponAuthoring", "Cooldown")
        comps = [("Weapon", {"cooldown": cooldown,
                             "projectile": s(proj_tmpl)}, None)]
        if forced_faction:
            comps.append(("Faction", {"filter": s(forced_faction)},
                          "set by the hero child instance in Unity"))
        else:
            comps.append(("Faction",
                          {"filter": s(faction_filter(
                              r("FactionAuthoring", "MaterialTemplate")))},
                          None))
        shape = r("FactionAuthoring", "Collider")
        if shape != base_field(WEAPON_BASE, "FactionAuthoring", "Collider"):
            comps.append(("Collider",
                          {"shape": shape,
                           "radius": r("FactionAuthoring", "Radius"),
                           "width": r("FactionAuthoring", "Width"),
                           "height": r("FactionAuthoring", "Height"),
                           "enabled": True}, coll_note))
        emit_entity(outdir, name, [f"Source: {prefab_path}"],
                    extends="ProjectileWeaponEntity", components=comps)
    check(resolve(prefab_root(weapon_specs[0][1]), "ProjectileWeaponEntity",
                  "ProjectileWeaponAuthoring", "Cooldown",
                  WEAPON_BASE) == 0.75, "shuriken cooldown != 0.75")

    # --- Projectiles ------------------------------------------------------------
    shr = "Assets/Heroes/Frog/ShurikenAttack/Shuriken_Projectile.prefab"
    fea = "Assets/Heroes/Eagle/FeatherAttack/Feather_Projectile.prefab"
    wis = "Assets/Creatures/Wisp/RangedAttack/CreatureWisp_Projectile.prefab"

    def proj_components(prefab_path, extra_note=None):
        node = prefab_root(prefab_path)
        check(node.get("prefab_instance") == PROJ_BASE,
              f"{prefab_path} is not a ProjectileEntity variant")
        r = lambda comp, field: resolve(node, "ProjectileEntity", comp, field,
                                        PROJ_BASE)
        dmg = r("OnHitDamageTriggerAuthoring", "Damage")
        hit_limit = ov(node, "OnHitDamageTriggerAuthoring(ProjectileEntity)"
                             ".HitLimit",
                       base_field(PROJ_BASE, "OnHitDamageTriggerAuthoring",
                                  "OnHitDamageTrigger")["HitLimit"])
        comps = [
            ("Projectile",
             {"range": r("ProjectileAuthoring", "Range"),
              "speed": r("ProjectileAuthoring", "Speed"),
              "pierce": r("ProjectileAuthoring", "Piercing"),
              "bounce": r("ProjectileAuthoring", "Bouncing")}, None),
            ("DamageOnHit",
             {"damage": dmg, "hit_limit": hit_limit,
              "ignore_hit_limit": False,
              "reset_time": r("OnHitDamageTriggerAuthoring", "ResetTime")},
             extra_note),
        ]
        return node, comps

    # Shuriken: damage 12, hit limit 4, bounce 3, on-hit poison
    node, comps = proj_components(shr)
    poison = status_effect_from_overrides(node, "ProjectileEntity")
    check(comps[1][1]["damage"] == 12 and comps[1][1]["hit_limit"] == 4,
          "shuriken damage/hit_limit drifted")
    check(comps[0][1]["bounce"] == 3, "shuriken bounce != 3")
    check(poison["periodic_damage"] == 30 and poison["magnitude"] == -0.75
          and poison["duration"] == 3, "shuriken poison drifted")
    comps.append(("StatusEffectOnHit", poison,
                  "poison: 30 dmg/periodic tick, 75% slow, 3 s"))
    emit_entity(outdir, "Shuriken_Projectile", [f"Source: {shr}"],
                extends="ProjectileEntity", components=comps)

    # Feather: damage 12, hit limit 5, pierce 4, spent -> recall spawner
    node, comps = proj_components(fea)
    check(comps[1][1]["damage"] == 12 and comps[1][1]["hit_limit"] == 5,
          "feather damage/hit_limit drifted")
    check(comps[0][1]["pierce"] == 4, "feather pierce != 4")
    spent = ov(node, "ProjectileAuthoring(ProjectileEntity)"
                     ".SpentProjectilePrefab", required=True)
    check(spent["ref"].endswith("FeatherRecall_Spawner.prefab"),
          "feather spent prefab drifted")
    comps.append(("SpentProjectile",
                  {"spawner_template": s("FeatherRecall_Spawner")},
                  "spent feathers stay in the world as recall spawners"))
    emit_entity(outdir, "Feather_Projectile", [f"Source: {fea}"],
                extends="ProjectileEntity", components=comps)

    # Wisp projectile: damage 10, speed 1, faction Red
    node, comps = proj_components(wis)
    check(comps[1][1]["damage"] == 10 and comps[0][1]["speed"] == 1,
          "wisp projectile drifted")
    comps.append(("Faction",
                  {"filter": s(faction_filter(
                      ov(node, "FactionAuthoring(ProjectileEntity)"
                               ".MaterialTemplate", required=True)))},
                  "enemy projectile: HarmEffect/Red"))
    emit_entity(outdir, "CreatureWisp_Projectile", [f"Source: {wis}"],
                extends="ProjectileEntity", components=comps)

    # FeatherRecall_Spawner: standalone prefab (not a variant)
    sp = "Assets/Heroes/Eagle/FeatherRecall/FeatherRecall_Spawner.prefab"
    bf = lambda c, f: base_field(sp, c, f)
    buffs = bf("StatusEffectAuthoring", "OnHitStatusEffects")
    check(len(buffs) == 1, "recall spawner buff list drifted")
    b = buffs[0]
    check(b["StatValue"]["Magnitude"] == 0.5 and b["StackLimit"] == 8,
          "recall buff drifted")
    fg = lambda f: bf("FactionAuthoring", f)
    emit_entity(outdir, "FeatherRecall_Spawner",
                [f"Source: {sp}",
                 "Left where a feather is spent; the FeatherRecall ability",
                 "fires FeatherRecall_Projectile through them, and each",
                 "spawner grants the movement buff below on recall."],
                components=[
                    ("Position", {"x": 0, "y": 0}, None),
                    ("Faction",
                     {"filter": s(faction_filter(fg("MaterialTemplate")))},
                     None),
                    ("Collider", collider_from(fg), None),
                    ("OneShotProjectileSpawner",
                     {"projectile": s("FeatherRecall_Projectile")}, None),
                    ("StatusEffectOnHit",
                     {"duration": b["Duration"],
                      "periodic_damage": b["PeriodicDamage"],
                      "stat_type": b["StatValue"]["StatType"],
                      "magnitude": b["StatValue"]["Magnitude"],
                      "modifier_type": b["StatValue"]["FloatModifierType"],
                      "stack_limit": b["StackLimit"],
                      "ignore_stacks": False,
                      "charges": b["Charges"],
                      "unlimited_charges": bool(b["UnlimitedCharges"])},
                     "recall haste: +50% move speed 1.1 s, stack limit 8"),
                ])

    # FeatherRecall_Projectile: Feather_Projectile variant. The extraction
    # could not attribute these override rows to a class ("?(?)" keys) because
    # of nested-variant depth; field names match the live
    # Projectile/OnHitDamageTrigger authoring shapes and are used as-is.
    rp = "Assets/Heroes/Eagle/FeatherRecall/FeatherRecall_Projectile.prefab"
    node = prefab_root(rp)
    g = lambda f, d=None: ov(node, f"?(?).{f}", d)
    check(g("Range") == 100 and g("Speed") == 10 and g("Piercing") == 9,
          "recall projectile flight drifted")
    emit_entity(outdir, "FeatherRecall_Projectile",
                [f"Source: {rp}",
                 "Override attribution is ambiguous in the extraction",
                 "('?(?)' rows); values match the live authoring field names."],
                extends="Feather_Projectile",
                components=[
                    ("Projectile", {"range": g("Range"), "speed": g("Speed"),
                                    "pierce": g("Piercing"), "bounce": 0},
                     None),
                    ("DamageOnHit",
                     {"damage": 12, "hit_limit": g("HitLimit", 5),
                      "ignore_hit_limit": bool(g("IgnoreHitLimit", 1)),
                      "reset_time": -1}, "damage inherited from feather"),
                    ("SpentProjectile", {"spawner_template": s("")},
                     "recall projectiles are not themselves recallable"),
                ])


def gen_pickups(outdir):
    specs = [
        ("GemPickup", "Assets/Prefabs/Pickups/GemPickup.prefab", 1, 1, None),
        # Unity filename has the 'HeartPIckup' typo; template name fixed here.
        ("HeartPickup", "Assets/Prefabs/Pickups/HeartPIckup.prefab", 2, 25,
         "live behavior heals 25% max HP (PickupConfig.heart_heal_ratio);"
         " serialized Value kept for fidelity"),
    ]
    for name, prefab_path, effect, value, note in specs:
        node = prefab_root(prefab_path)
        check(node.get("prefab_instance") == PICKUP_BASE,
              f"{prefab_path} is not a PickupEntity variant")
        r = lambda comp, field: resolve(node, "PickupEntity", comp, field,
                                        PICKUP_BASE)
        check(r("OnHitHelpTriggerAuthoring", "helpEffectType") == effect,
              f"{name}: helpEffectType drifted")
        check(r("OnHitHelpTriggerAuthoring", "Value") == value,
              f"{name}: Value drifted")
        comps = [("Pickup",
                  {"effect": effect, "value": value,
                   "move_speed": r("PickupAuthoring", "MoveSpeed")}, note)]
        radius = r("FactionAuthoring", "Radius")
        if radius != base_field(PICKUP_BASE, "FactionAuthoring", "Radius"):
            comps.append(("Collider",
                          {"shape": 1, "radius": radius, "width": 0,
                           "height": 0, "enabled": True},
                          "gem trigger radius 0.75"))
        emit_entity(outdir, name, [f"Source: {prefab_path}"],
                    extends="PickupEntity", components=comps)


def gen_hazard(outdir):
    lp = "Assets/Environment/Dungeon/LavaPit/DungeonLavaPitEntityPrefab.prefab"
    node = prefab_root(lp)
    dmg = ov(node, "PeriodicDamageTriggerAuthoring(StationaryDamageAuraEntity)"
                   ".DamagePerTick", required=True)
    check(dmg == 25, "lava pit damage drifted")
    emit_entity(outdir, "DungeonLavaPit", [f"Source: {lp}"],
                extends="StationaryDamageAuraEntity",
                components=[
                    ("PeriodicDamage", {"damage": dmg},
                     "25 per periodic tick (0.25 s)"),
                ])


def gen_singletons(outdir):
    """GameConfig + GameState live entities (non-abstract templates).

    Values: GameConfig.prefab defaults with the AdventureEntities
    scene-instance overrides applied (the shipping values) -- dotted keys are
    the live class shape; stale flat keys are ignored.
    """
    gc_prefab = "Assets/Prefabs/Level/GameConfig.prefab"
    props = base_field(gc_prefab, "GameStartPropertiesAuthoring", "timeConfig")
    # full defaults blob
    gsp = None
    for comp in prefab_root(gc_prefab)["components"]:
        if comp["type"] == "GameStartPropertiesAuthoring":
            gsp = comp["fields"]
    check(gsp, "GameStartPropertiesAuthoring missing")

    # Scene instance overrides
    scene = ST["Assets/Scenes/Adventure/AdventureEntities.unity"]

    def find_node(nodes, name):
        for n in nodes:
            if n.get("name") == name:
                return n
            r = find_node(n.get("children", []), name)
            if r:
                return r
        return None

    gc = find_node(scene, "GameConfig")
    check(gc is not None, "GameConfig scene instance missing")

    def cfgval(group, field):
        v = ov(gc, f"GameStartPropertiesAuthoring(GameConfig).{group}.{field}")
        if v is not None:
            return v
        return gsp[group][field]

    victory = cfgval("gameOverConfig", "VictoryTimerSeconds")
    spawn_delay = cfgval("spawnConfig", "SpawnDelay")
    check(victory == 180, "victory timer != 180 (Adventure override)")
    check(spawn_delay == 1.25, "spawn delay != 1.25 (Adventure override)")
    check(cfgval("pickupConfig", "HeartDropScale") == 0.0375,
          "heart drop scale != 0.0375")

    # Level-up tables (wired by scene-instance override -- assert that)
    check(ov(gc, "LevelUpAuthoring(GameConfig).CreatureLevelUpSO") is not None,
          "creature level table is no longer wired by the Adventure scene")
    cl = SO["Assets/Creatures/Creature_LevelUpSO.asset"]["fields"]
    hl = SO["Assets/Heroes/Hero_LevelUpSO.asset"]["fields"]

    def table(f):
        rows = sorted(f["LevelUpTable"], key=lambda r: r["Level"])
        check(len(rows) == f["MaxLevel"] == 20, "level table size drifted")
        return ([r["Xp"] for r in rows], [r["Damage"] for r in rows],
                [r["Health"] for r in rows])

    cxp, cdmg, chp = table(cl)
    hxp, hdmg, hhp = table(hl)
    check(cxp[-1] == 2090 and hxp[-1] == 950, "level XP tables drifted")

    emit_entity(outdir, "GameConfig",
                ["Source: Assets/Prefabs/Level/GameConfig.prefab with the",
                 "Adventure/AdventureEntities scene-instance overrides (the",
                 "shipping values; CONTENT-ANALYSIS section 9).",
                 "Skipped configs: multiplayerConfig (AllowBots dropped),",
                 "audioConfig + projectileConfig trail (client-side).",
                 "Live entity (not abstract): created at app start."],
                abstract=False,
                components=[
                    ("GameTimeConfig",
                     {"tick_rate": 60,
                      "periodic_tick_time": cfgval("timeConfig",
                                                   "PeriodicTickTime")},
                     "60 Hz = NetcodeConfig SimulationTickRate"),
                    ("SpawnConfig",
                     {"spawn_delay": spawn_delay,
                      "spawn_max": cfgval("spawnConfig", "SpawnMax"),
                      "spawn_growth": cfgval("spawnConfig", "SpawnGrowth")},
                     "Adventure overrides: delay 1.25, growth 100"),
                    ("GameOverConfig",
                     {"victory_timer_seconds": victory,
                      "game_over_delay_seconds": cfgval("gameOverConfig",
                                                        "GameOverDelaySeconds")},
                     "survive 180 s to win"),
                    ("MoveConfig",
                     {"min_distance_to_move": cfgval("moveConfig",
                                                     "MinDistanceToMove")},
                     None),
                    ("CombatConfig",
                     {"target_switch_threshold": cfgval("combatConfig",
                                                        "TargetSwitchThreshold"),
                      "damage_taken_ratio": 1.0},
                     "damage_taken_ratio: port-added; see app.yaml"),
                    ("PickupConfig",
                     {"acceleration": cfgval("pickupConfig", "Acceleration"),
                      "trigger_distance": cfgval("pickupConfig", "Distance"),
                      "drop_distance": cfgval("pickupConfig", "DropDistance"),
                      "gem_drop_scale": cfgval("pickupConfig", "GemDropScale"),
                      "heart_drop_scale": cfgval("pickupConfig",
                                                 "HeartDropScale"),
                      "heart_heal_ratio": 0.25},
                     "heart_heal_ratio: hardcoded live behavior, not an asset"),
                    ("ArenaBounds",
                     {"min_x": -9.5, "min_y": -6.5, "max_x": 9.5,
                      "max_y": 6.5},
                     "editor spawn-clamp bounds"),
                    ("CreatureLevelUp",
                     {"max_level": cl["MaxLevel"], "xp": cxp, "damage": cdmg,
                      "health": chp},
                     "Creature_LevelUpSO rows (XP(n)=11*n(n-1)/2)"),
                    ("HeroLevelUp",
                     {"max_level": hl["MaxLevel"], "xp": hxp, "damage": hdmg,
                      "health": hhp},
                     "Hero_LevelUpSO rows (XP(n)=5*n(n-1)/2)"),
                ])

    emit_entity(outdir, "GameState",
                ["Runtime singleton state (sashimi GameState.prefab bakes",
                 "GameTime/MatchStats/etc.). Live entity at app start.",
                 "WaveState.ticks_to_next = first wave delay 5 s * 60 Hz."],
                abstract=False,
                components=[
                    ("GameTime", {"tick": 0}, None),
                    ("MatchStats", {"gems": 0, "kills": 0}, None),
                    ("WaveState",
                     {"next_wave": 1, "ticks_to_next": 300,
                      "spawned_total": 0}, None),
                ])


# ---------------------------------------------------------------------------
# Waves
# ---------------------------------------------------------------------------
# The wave script is parsed from the RAW prefab (AdventureSpawnConfig.prefab)
# rather than prefab_trees.json: the tree dump loses the source-prefab default
# spawn child that most waves inherit from UnitSpawnWaveBase.prefab (7 entries
# total), because those entries exist only as m_Modifications targeting nested
# fileIDs. The `_spawns` arrays in the raw file are what the Unity baker
# iterates, so they are the ground truth for wave membership.
#
# NOTE on counts: CONTENT-ANALYSIS section 7 says "502 spawn entries" with
# totals SlimeOrange 357 / Wolf 41; those figures inherited exactly this
# tree-dump gap (509 - 7 = 502). The analysis's own per-wave size table (from
# the Wave[N]_i names, which equal the serialized _spawns sizes) sums to 509.
# Ground truth emitted here: 509 entries; SlimeOrange 362, Wolf 43,
# RockGolem 38, Wisp 38, LargeTealCube 28.

SPAWN_CONFIG = "Assets/Data/Spawning/AdventureSpawnConfig.prefab"
WAVE_GUID = "e75fe3e5a7297064c8779f3f8bc213de"   # UnitSpawnWaveBase.prefab
CONF_GUID = "19bb3f9917714c447be8694b0716c106"   # UnitSpawnConfig.prefab
# fileIDs of the default spawn child (SlimeOrange_0) inside
# UnitSpawnWaveBase.prefab: its UnitSpawnAuthoring, GameObject and Transform.
DEFAULT_SPAWN_COMP = 8013909930779083983
DEFAULT_SPAWN_GO = 4189566822641449892
DEFAULT_SPAWN_TR = 4278762498765546548

WAVE_TOTAL = 509
WAVE_GOLDEN_TOTALS = {"CreatureSlimeOrange": 362, "CreatureWolf": 43,
                      "CreatureRockGolem": 38, "CreatureWisp": 38,
                      "LargeTealCube": 28}


def parse_raw_prefab_instances(text):
    """Split a Unity YAML asset into PrefabInstance blocks + stripped comps.

    Returns (instances, stripped):
      instances: fid -> {"src": source prefab guid,
                         "rows": {(target_fid, propertyPath):
                                  (value, objref_fid, objref_guid)}}
      stripped:  fid -> (source_fid, source_guid, owner_instance_fid)
    """
    import re
    parts = re.split(r"^--- !u!(\d+) &(\d+)( stripped)?\n", text, flags=re.M)
    instances, stripped = {}, {}
    for i in range(1, len(parts), 4):
        cls, fid, is_stripped, body = (int(parts[i]), int(parts[i + 1]),
                                       bool(parts[i + 2]), parts[i + 3])
        if is_stripped:
            m = re.search(r"m_CorrespondingSourceObject: \{fileID: (\d+), "
                          r"guid: ([0-9a-f]+)", body)
            mi = re.search(r"m_PrefabInstance: \{fileID: (\d+)\}", body)
            if m and mi:
                stripped[fid] = (int(m.group(1)), m.group(2),
                                 int(mi.group(1)))
        elif cls == 1001:
            rows = re.findall(
                r"target: \{fileID: (\d+), guid: ([0-9a-f]+),\s*\n?\s*"
                r"type: 3\}\n\s+propertyPath: ([^\n]+)\n\s+value: ([^\n]*)"
                r"(?:\n\s+objectReference: \{fileID: (\d+)"
                r"(?:, guid: ([0-9a-f]+))?[^}]*\})?", body)
            src = re.search(r"m_SourcePrefab: \{fileID: \d+, "
                            r"guid: ([0-9a-f]+)", body)
            rowmap = {}
            for tfid, _tguid, pp, val, oref, oguid in rows:
                pp = pp.strip().strip("'")
                rowmap[(int(tfid), pp)] = (val.strip(),
                                           int(oref) if oref else None,
                                           oguid)
            instances[fid] = {"src": src.group(1) if src else None,
                              "rows": rowmap}
    return instances, stripped


def creature_template_for_guid(guid, guid_index):
    if guid is None:
        return "CreatureSlimeOrange"  # UnitSpawnBase.prefab default Prefab
    path = guid_index.get(guid)
    check(path is not None, f"spawn prefab guid {guid} not in guid_index")
    name = Path(path).stem
    mapping = {"CreatureSlimeOrange": "CreatureSlimeOrange",
               "CreatureWolf": "CreatureWolf",
               "CreatureRockGolem": "CreatureRockGolem",
               "CreatureWisp": "CreatureWisp",
               "LargeTealCube": "LargeTealCube"}
    check(name in mapping, f"unknown spawn prefab {path}")
    return mapping[name]


def gen_waves(outdir, sashimi_root, guid_index):
    raw_path = sashimi_root / SPAWN_CONFIG
    check(raw_path.exists(),
          f"{raw_path} not found -- pass --sashimi-root (the wave script "
          "needs the raw prefab; see comment above gen_waves)")
    instances, stripped = parse_raw_prefab_instances(raw_path.read_text())

    def default_entry(rows):
        """The wave's inherited default spawn child, with instance mods."""
        x = float(rows.get((DEFAULT_SPAWN_TR, "m_LocalPosition.x"),
                           ("0", None, None))[0])
        y = float(rows.get((DEFAULT_SPAWN_TR, "m_LocalPosition.y"),
                           ("0", None, None))[0])
        pguid = rows.get((DEFAULT_SPAWN_COMP, "Prefab"), (None, None, None))[2]
        delay = int(rows.get((DEFAULT_SPAWN_COMP, "Delay"),
                             ("1", None, None))[0])
        return (creature_template_for_guid(pguid, guid_index), x, y, delay)

    def kid_entry(inst_fid):
        rows = instances[inst_fid]["rows"]
        x = y = 0.0
        pguid = None
        delay = 1  # UnitSpawnBase.prefab default Delay (VeryShort)
        for (tfid, pp), (val, _oref, oguid) in rows.items():
            if pp == "m_LocalPosition.x":
                x = float(val)
            elif pp == "m_LocalPosition.y":
                y = float(val)
            elif pp == "Prefab":
                pguid = oguid
            elif pp == "Delay":
                delay = int(val)
        return (creature_template_for_guid(pguid, guid_index), x, y, delay)

    waves = {}
    delays = {}
    for fid, inst in instances.items():
        if inst["src"] not in (WAVE_GUID, CONF_GUID):
            continue
        rows = inst["rows"]
        wname = next((v for (t, pp), (v, _, _) in rows.items()
                      if pp == "m_Name" and v.startswith("Wave[")), None)
        if wname is None:
            continue
        size = next((int(v) for (t, pp), (v, _, _) in rows.items()
                     if pp == "_spawns.Array.size"), None)
        check(size is not None, f"{wname}: no _spawns size override")
        name_size = int(wname.split("[")[1].split("]")[0])
        check(size == name_size,
              f"{wname}: _spawns size {size} != name size {name_size}")
        index = int(wname.split("_")[-1])
        wdelay = next((float(v) for (t, pp), (v, _, _) in rows.items()
                       if pp == "DelayTime"), None)
        check(wdelay is not None, f"{wname}: no DelayTime")
        entries = []
        for i in range(size):
            # target fid varies per wave; search by propertyPath
            ref = next((rv for (t, pp), rv in rows.items()
                        if pp == f"_spawns.Array.data[{i}]"), None)
            if ref is None or ref[1] is None:
                # No modification row: inherited source default (SlimeOrange_0
                # of UnitSpawnWaveBase.prefab), customized via mods on the
                # wave instance itself.
                entries.append(default_entry(rows))
                continue
            oref = ref[1]
            check(oref in stripped, f"{wname}: unresolved spawn ref {oref}")
            src_fid, _src_guid, owner = stripped[oref]
            if src_fid == DEFAULT_SPAWN_COMP and owner == fid:
                entries.append(default_entry(rows))
            else:
                check(owner in instances,
                      f"{wname}: spawn owner {owner} not an instance")
                entries.append(kid_entry(owner))
        check(index not in waves, f"duplicate wave index {index}")
        waves[index] = entries
        delays[index] = wdelay

    check(sorted(waves) == list(range(1, 37)), "wave indices != 1..36")
    total = sum(len(e) for e in waves.values())
    check(total == WAVE_TOTAL, f"total spawn entries {total} != {WAVE_TOTAL}")
    counts, intro = {}, {}
    for i in range(1, 37):
        for tmpl, x, y, delay in waves[i]:
            counts[tmpl] = counts.get(tmpl, 0) + 1
            intro.setdefault(tmpl, i)
            check(-9.5 <= x <= 9.5 and -6.5 <= y <= 6.5,
                  f"wave {i}: spawn ({x},{y}) outside editor clamp bounds")
            check(delay == 1, f"wave {i}: spawn delay {delay} != VeryShort")
    check(counts == WAVE_GOLDEN_TOTALS,
          f"per-creature totals drifted: {counts}")
    check((intro["CreatureWolf"], intro["CreatureRockGolem"],
           intro["CreatureWisp"], intro["LargeTealCube"]) == (6, 11, 16, 21),
          f"intro beats drifted: {intro}")
    check(set(delays.values()) == {5.0},
          f"wave delays not uniformly 5 s: {set(delays.values())}")

    lines = [GENERATED_NOTE]
    lines.append(f"""\
# The 36-wave / 509-entry escalation script from
# {SPAWN_CONFIG}
# (CONTENT-ANALYSIS section 7; parsed from the raw prefab's _spawns arrays,
# which are what the Unity baker iterates). Consumed by the sashimi
# spawn-director system (arrives at slice assembly); loaded like
# data/faction-matrix.yaml, not via the template loader.
#
# COUNT NOTE: CONTENT-ANALYSIS quotes "502 entries" (totals Slime 357 /
# Wolf 41); those figures undercount by the 7 source-prefab default spawn
# children hidden from the prefab-tree dump. The per-wave sizes in the
# Wave[N]_i names -- which the analysis itself trusts -- equal the serialized
# _spawns sizes and sum to 509.
#
# Semantics:
#   - tick_rate 60; wave_delay_seconds between waves (uniform 5 s;
#     WaveState.ticks_to_next starts at the first wave's delay).
#   - Entry x/y are wave-relative spawn offsets on the editor's 0.25 grid,
#     clamped to x [-9.5, 9.5], y [-6.5, 6.5] -- arena-space placement is the
#     spawn director's concern (Unity parks the config at (0, -30) off-arena
#     and bakes Location = spawn pos - wave pos).
#   - delay_ticks is the per-spawn SpawnDelay enum stored as its int value;
#     seconds = N / 60 (all Adventure spawns use VeryShort = 1).
#   - intro: first appearance of a creature type (telegraph beat).
#
# Totals: CreatureSlimeOrange 362, CreatureWolf 43, CreatureRockGolem 38,
# CreatureWisp 38, LargeTealCube 28. Intro beats: Wolf wave 6, RockGolem
# wave 11, Wisp wave 16, LargeTealCube wave 21.
tick_rate: 60
wave_delay_seconds: 5.0
waves:
""")
    intro_by_wave = {w: t for t, w in intro.items() if w > 1}
    for i in range(1, 37):
        lines.append(f"  - wave: {i}\n")
        if i in intro_by_wave:
            lines.append(f"    intro: {intro_by_wave[i]}\n")
        lines.append("    entries:\n")
        for tmpl, x, y, delay in waves[i]:
            lines.append(f"      - {{ template: {tmpl}, x: {fnum(x)}, "
                         f"y: {fnum(y)}, delay_ticks: {delay} }}\n")
    write_out(outdir / "waves.yaml", "".join(lines))
    return total


# ---------------------------------------------------------------------------
# Faction matrix
# ---------------------------------------------------------------------------

def gen_faction_matrix(outdir, repo_root):
    """Sandbox copy of the golden faction matrix.

    Decision: PRESERVE the HelpEffectPhysicsMaterial_Global one-bit-shift
    quirk, matching shipped Unity behavior. The golden fixture already
    encodes it (with comments) and engine/tests/test_faction.c verifies it
    bit-for-bit against the Unity assets, so the fixture is copied verbatim
    with a provenance note.
    """
    fixture = repo_root / "engine/tests/fixtures/faction-matrix-sashimi.yaml"
    check(fixture.exists(), f"golden fixture missing: {fixture}")
    body = fixture.read_text()
    header = (GENERATED_NOTE +
              "# Copied verbatim from engine/tests/fixtures/"
              "faction-matrix-sashimi.yaml\n"
              "# (the golden table verified bit-for-bit against the Unity\n"
              "# physics-material assets by engine/tests/test_faction.c).\n"
              "# The HelpEffect_Global one-bit-shift quirk is PRESERVED on\n"
              "# purpose: golden data matches shipped Unity behavior, not\n"
              "# documented intent. Load with faction_matrix_load().\n")
    write_out(outdir / "faction-matrix.yaml", header + body)


# ---------------------------------------------------------------------------
# app.yaml
# ---------------------------------------------------------------------------

ENTITY_LOAD_ORDER = [
    # archetype bases
    "CreatureEntity", "HeroEntity", "ProjectileEntity",
    "ProjectileWeaponEntity", "ProximityDamageEntity", "DamageAuraEntity",
    "StationaryDamageAuraEntity", "PickupEntity", "AbilityBase",
    # abilities
    "SlimeAttack", "WolfAttack", "RockGolemAttack", "WispAttack",
    "LargeCubeAttack", "LargeCubeCharge",
    # creatures
    "CreatureSlimeOrange", "CreatureWolf", "CreatureRockGolem",
    "CreatureWisp", "LargeTealCube",
    # weapons + projectiles
    "Shuriken_Weapon", "Shuriken_Projectile", "Feather_Weapon",
    "Feather_Projectile", "FeatherRecall_Spawner", "FeatherRecall_Projectile",
    "CreatureWisp_Weapon", "CreatureWisp_Projectile",
    # heroes, pickups, hazards
    "HeroFrog", "HeroEagle", "GemPickup", "HeartPickup", "DungeonLavaPit",
    # live singletons
    "GameConfig", "GameState",
]


def gen_app_yaml(sandbox_dir):
    scene = ST["Assets/Scenes/Adventure/AdventureEntities.unity"]

    def find_node(nodes, name):
        for n in nodes:
            if n.get("name") == name:
                return n
            r = find_node(n.get("children", []), name)
            if r:
                return r
        return None

    def is_active(node):
        if node.get("inactive"):
            return False
        for k, v in node.get("overrides", {}).items():
            if k.endswith("m_IsActive") and v == 0:
                return False
        return True

    spawns = []  # (template, x, y, comment)
    for hero, tmpl in (("HeroEagle", "HeroEagle"), ("HeroFrog", "HeroFrog")):
        n = find_node(scene, hero)
        check(n and is_active(n), f"{hero} missing/inactive in scene")
        p = n["position"]
        spawns.append((tmpl, p["x"], p["y"], "hand-placed hero"))

    # Intro creatures: the SlimePosse group and the single placed
    # Wolf/Wisp/LargeTealCube are all INACTIVE in the shipped scene
    # (verified against the scene file; CONTENT-ANALYSIS section 11's
    # "SlimePosse groups active" overstates it) -- so none are spawned.
    for name in ("SlimePosse", "CreatureWolf", "CreatureWispEntity",
                 "LargeTealCube"):
        n = find_node(scene, name)
        check(n is not None and not is_active(n),
              f"{name}: expected inactive in AdventureEntities")

    # Gem clusters: 4 groups, exactly one active.
    gems_root = find_node(scene, "Gems")
    clusters = [c for c in gems_root.get("children", [])]
    active = [c for c in clusters if is_active(c)]
    check(len(clusters) == 4 and len(active) == 1,
          f"gem clusters drifted: {len(clusters)} groups, "
          f"{len(active)} active")
    base = active[0].get("position") or {"x": 0.0, "y": 0.0}
    gem_kids = sorted(active[0].get("children", []), key=lambda k: k["name"])
    for k in gem_kids:
        p = k["position"]
        spawns.append(("GemPickup", base["x"] + p["x"], base["y"] + p["y"],
                       None))
    check(len(gem_kids) == 8, f"active gem cluster has {len(gem_kids)} gems")

    # HealthPickup is inactive in the scene -- not spawned.
    hp = find_node(scene, "HealthPickup")
    check(hp is not None and not is_active(hp),
          "HealthPickup: expected inactive")

    ents = ", ".join(ENTITY_LOAD_ORDER)
    check(len(ents) < 900, "entities list too long for the app.yaml parser")

    spawn_lines = []
    for tmpl, x, y, comment in spawns:
        # No inline comments here: the spawn_list parser takes the rest of
        # the line as the template name. Params use the flat
        # "Component: { ... }" form consumed by engine_entity_spawn.
        spawn_lines.append(f"  - template: {tmpl}\n")
        spawn_lines.append("    params:\n")
        spawn_lines.append(f"      Position: {{ x: {fnum(x)}, "
                           f"y: {fnum(y)} }}\n")

    text = f"""{GENERATED_NOTE}\
# Sashimi data layer (Unity Adventure scene content). Game rules and value
# provenance live in ~/Dev/sashimi/CONTENT-ANALYSIS.md; representation
# decisions in this sandbox's CLAUDE.md.
#
# Adventure GameConfig values (victory 180 s survival, spawn delay 1.25 s,
# 60 Hz tick, 0.25 s periodic tick, drop rates) live on the GameConfig live
# entity (entities/GameConfig.yaml), not here -- the engine app parser has no
# game-specific keys. NOTE for editors -- this file is parsed by a string
# scanner (engine/src/engine/app.c); comments must never contain a section
# key followed by a colon.

name: sashimi
description: "Sashimi survival-action port: data layer (heroes, creatures, waves)"

imports:
  avk:
    components: [MapSize]

# Arena from sashimi's spawn-clamp bounds x [-9.5, 9.5], y [-6.5, 6.5]
# (19 x 13 world units; sashimi positions are continuous floats centered on
# the origin -- see ArenaBounds on the GameConfig entity).
map_size:
  x: 19
  y: 13

# 180 s victory timer at 60 Hz.
max_turns: 10800

# Real-time 60 Hz stepping: lean tick on; unset cadences resolve to
# broadcast on-demand and history off (engine.h lean-tick semantics).
lean_tick: true

configs:
  headless-verify:
    # Headless verification profile: heroes take 50% damage.
    # damage_taken_ratio is a GameConfig-style field (CombatConfig
    # .damage_taken_ratio defaults to 1.0 on the GameConfig entity); per root
    # decision 13 the ratio lives in YAML and is selected via --config. The
    # engine's named-config parser ignores unknown keys, so wiring this value
    # onto CombatConfig at app start is part of slice assembly (documented in
    # CLAUDE.md); the damage system consumes CombatConfig.damage_taken_ratio.
    damage_taken_ratio: 0.5
    lean_tick: true

templates:
  entities: [{ents}]

# Hand-placed content from Adventure/AdventureEntities.unity: the two heroes
# and the one active gem cluster. The SlimePosse intro creatures, the placed
# Wolf/Wisp/LargeTealCube and the lone HealthPickup are all inactive in the
# shipped scene and are deliberately not spawned.
spawn_list:
{"".join(spawn_lines)}\

# Execution order derived from the Unity group pipeline (SYSTEM-GROUPS.md);
# the Unity-group -> engine-phase -> slot mapping table lives in this
# sandbox's CLAUDE.md ("System ordering"). Pipeline mode mirrors this via
# per-phase DependsOn chains in systems/native/systems.c.
system_order:
  - rewind
  - app_start
  - game_time
  - hero_ai
  - start_of_tick
  - destroy_on_timer
  - ability_machine
  - weapon_fire
  - spatial_hash
  - targeting
  - creature_steering
  - pickup_magnet
  - movement
  - child_offset_sync
  - collision_push
  - damage_apply
  - pickup_collect
  - status_effects
  - defeat
  - iframes
  - projectile_lifecycle
  - on_defeated
  - respawn
  - spawn_director
  - delayed_spawn
  - level_up
  - app_stop
  - history_capture
"""
    write_out(sandbox_dir / "app.yaml", text)
    return len(spawns)


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--extraction-dir",
                    default=str(Path.home() /
                                "Dev/sashimi/bin/content-extraction/out"),
                    help="dir with scriptable_objects.json / prefab_trees.json"
                         " / scene_trees.json / guid_index.json")
    ap.add_argument("--sashimi-root",
                    default=str(Path.home() / "Dev/sashimi"),
                    help="sashimi Unity project root (read-only; needed for "
                         "the raw AdventureSpawnConfig.prefab wave arrays)")
    args = ap.parse_args()

    ext = Path(args.extraction_dir)
    for fname in ("scriptable_objects.json", "prefab_trees.json",
                  "scene_trees.json"):
        check((ext / fname).exists(),
              f"{ext / fname} not found -- regenerate with the scripts in "
              "~/Dev/sashimi/bin/content-extraction/ or pass --extraction-dir")

    global PT, SO, ST
    SO = json.loads((ext / "scriptable_objects.json").read_text())
    PT = json.loads((ext / "prefab_trees.json").read_text())
    ST = json.loads((ext / "scene_trees.json").read_text())
    guid_index = json.loads((ext / "guid_index.json").read_text())

    repo_root = Path(__file__).resolve().parents[3]
    sandbox = repo_root / "sandboxes/sashimi"
    comp_dir = sandbox / "components"
    ent_dir = sandbox / "entities"
    data_dir = sandbox / "data"

    print("components:")
    comp_names = gen_components(comp_dir)
    print("entities:")
    gen_archetypes(ent_dir)
    gen_abilities(ent_dir)
    gen_creatures(ent_dir)
    gen_heroes_and_weapons(ent_dir)
    gen_pickups(ent_dir)
    gen_hazard(ent_dir)
    gen_singletons(ent_dir)
    print("data:")
    total_spawns = gen_waves(data_dir, Path(args.sashimi_root), guid_index)
    gen_faction_matrix(data_dir, repo_root)
    print("app:")
    spawn_count = gen_app_yaml(sandbox)

    # Template-name / component-name collision check (root decision 11).
    overlap = set(comp_names) & set(ENTITY_LOAD_ORDER)
    check(not overlap, f"template names collide with components: {overlap}")
    emitted = {p.stem for p in ent_dir.glob("*.yaml")}
    check(emitted == set(ENTITY_LOAD_ORDER),
          f"entity files vs app.yaml list mismatch: "
          f"{emitted ^ set(ENTITY_LOAD_ORDER)}")

    print(f"\nOK: {len(comp_names)} components, {len(ENTITY_LOAD_ORDER)} "
          f"entity templates, 36 waves / {total_spawns} spawn entries, "
          f"{spawn_count} spawn_list entries.")


if __name__ == "__main__":
    main()
