}
EMSCRIPTEN_KEEPALIVE
int wasm_get_pending_ticks(int i) {
    return (i >= 0 && i < g_pending_count) ? g_pending[i].ticks_left : 0;
}

/* Full telegraph window in ticks: SpawnConfig.spawn_delay * tick rate,
 * +1 matching spawn_warning()'s initial ticks_remaining (systems.c) â€”
 * so pending_ticks/telegraph_ticks is a clean 1 -> 0 progress ratio. */
EMSCRIPTEN_KEEPALIVE
int wasm_get_telegraph_ticks(void) {
    float delay = 1.25f;
    if (g_engine && g_ids.game_config_e && g_ids.spawn_config) {
        const CSpawnConfig *sc = ecs_get_id(g_engine->world,
                                            g_ids.game_config_e,
                                            g_ids.spawn_config);
        if (sc && sc->spawn_delay > 0) delay = sc->spawn_delay;
    }
    return (int)(delay * wasm_get_tick_rate() + 0.5f) + 1;
}

EMSCRIPTEN_KEEPALIVE
double wasm_get_victory_ticks(void) {
    if (!g_engine || !g_ids.game_config_e || !g_ids.game_over_config) return 0;
    const CGameOverConfig *go = ecs_get_id(g_engine->world,
                                           g_ids.game_config_e,
                                           g_ids.game_over_config);
    if (!go) return 0;
    return (double)go->victory_timer_seconds * wasm_get_tick_rate();
}

EMSCRIPTEN_KEEPALIVE
int wasm_get_wave(void) {
    /* Waves released so far (WaveState.next_wave - 1). */
    if (!g_engine || !g_ids.game_state_e || !g_ids.wave_state) return 0;
    const CWaveState *ws = ecs_get_id(g_engine->world, g_ids.game_state_e,
                                      g_ids.wave_state);
    return ws ? ws->next_wave - 1 : 0;
}

