# GENERATED by sandboxes/sashimi/tools/generate_content.py -- do not edit by hand.
# Copied verbatim from engine/tests/fixtures/faction-matrix-sashimi.yaml
# (the golden table verified bit-for-bit against the Unity
# physics-material assets by engine/tests/test_faction.c).
# The HelpEffect_Global one-bit-shift quirk is PRESERVED on
# purpose: golden data matches shipped Unity behavior, not
# documented intent. Load with faction_matrix_load().
# Sashimi faction interaction matrix (golden data).
#
# Ground truth extracted 2026-07-03 from the Unity project:
#   categories: sashimi Assets/Settings/PhysicsCategoryNames.asset
#               (m_CategoryNames, first 16 entries; index = bit position)
#   filters:    sashimi Assets/Resources/PhysicsMaterials/*.asset
#               (m_BelongsToCategories / m_CollidesWithCategories bit flags,
#                one filter per physics material, all 15 materials)
# See sashimi CONTENT-ANALYSIS.md section 10 and PORTING.md must-reproduce #2.
#
# Semantics (mutual rule, Unity.Physics IsCollisionEnabled):
#   interact(a, b) = (a.belongs & b.collides) && (b.belongs & a.collides)
# Heroes are Blue units, creatures Red. Harm filters collide every Unit color
# except their own; Help filters collide only their own color's Units.
# Friendly fire is impossible by construction.
#
# Known data quirk, preserved verbatim from the assets: HelpEffect_Global's
# collides mask is shifted one bit from its documented intent â€” it lists
# RedUnits/GreenUnits/YellowUnits/BlueHelpEffects instead of the four Unit
# colors. Golden tests encode the asset values, not the intent.

categories:
  - BlocksPathing
  - BlocksAirborn
  - BlueUnits
  - RedUnits
  - GreenUnits
  - YellowUnits
  - BlueHelpEffects
  - RedHelpEffects
  - GreenHelpEffects
  - YellowHelpEffects
  - GlobalHelpEffects
  - BlueHarmEffects
  - RedHarmEffects
  - GreenHarmEffects
  - YellowHarmEffects
  - GlobalHarmEffects

filters:
  # UnitPhysicsMaterial_<Color>: belongs own-color Units; collides pathing
  # blockers, own-color Units (unit-unit pushing), own-color Help, GlobalHelp,
  # all other-color Harm + GlobalHarm.
  Unit_Blue:
    belongs: [BlueUnits]
    collides: [BlocksPathing, BlocksAirborn, BlueUnits, BlueHelpEffects,
               GlobalHelpEffects, RedHarmEffects, GreenHarmEffects,
               YellowHarmEffects, GlobalHarmEffects]
  Unit_Red:
    belongs: [RedUnits]
    collides: [BlocksPathing, BlocksAirborn, RedUnits, RedHelpEffects,
               GlobalHelpEffects, BlueHarmEffects, GreenHarmEffects,
               YellowHarmEffects, GlobalHarmEffects]
  Unit_Green:
    belongs: [GreenUnits]
    collides: [BlocksPathing, BlocksAirborn, GreenUnits, GreenHelpEffects,
               GlobalHelpEffects, BlueHarmEffects, RedHarmEffects,
               YellowHarmEffects, GlobalHarmEffects]
  Unit_Yellow:
    belongs: [YellowUnits]
    collides: [BlocksPathing, BlocksAirborn, YellowUnits, YellowHelpEffects,
               GlobalHelpEffects, BlueHarmEffects, RedHarmEffects,
               GreenHarmEffects, GlobalHarmEffects]

  # HarmEffectPhysicsMaterial_<Color>: belongs own-color Harm; collides all
  # Units except own color. _Global hits all four unit colors (LavaPit).
  HarmEffect_Blue:
    belongs: [BlueHarmEffects]
    collides: [RedUnits, GreenUnits, YellowUnits]
  HarmEffect_Red:
    belongs: [RedHarmEffects]
    collides: [BlueUnits, GreenUnits, YellowUnits]
  HarmEffect_Green:
    belongs: [GreenHarmEffects]
    collides: [BlueUnits, RedUnits, YellowUnits]
  HarmEffect_Yellow:
    belongs: [YellowHarmEffects]
    collides: [BlueUnits, RedUnits, GreenUnits]
  HarmEffect_Global:
    belongs: [GlobalHarmEffects]
    collides: [BlueUnits, RedUnits, GreenUnits, YellowUnits]

  # HelpEffectPhysicsMaterial_<Color>: belongs own-color Help; collides only
  # own-color Units (pickups are Blue = hero-only).
  HelpEffect_Blue:
    belongs: [BlueHelpEffects]
    collides: [BlueUnits]
  HelpEffect_Red:
    belongs: [RedHelpEffects]
    collides: [RedUnits]
  HelpEffect_Green:
    belongs: [GreenHelpEffects]
    collides: [GreenUnits]
  HelpEffect_Yellow:
    belongs: [YellowHelpEffects]
    collides: [YellowUnits]
  HelpEffect_Global:
    # Quirk preserved from the asset (see header comment): mask is shifted
    # one bit from the four Unit colors.
    belongs: [GlobalHelpEffects]
    collides: [RedUnits, GreenUnits, YellowUnits, BlueHelpEffects]

  # NonePhysicsMaterial: inert filter (never interacts).
  None:
    belongs: []
    collides: []
# GENERATED by sandboxes/sashimi/tools/generate_content.py -- do not edit by hand.
# The 36-wave / 509-entry escalation script from
# Assets/Data/Spawning/AdventureSpawnConfig.prefab
# (CONTENT-ANALYSIS section 7; parsed from the raw prefab's _spawns arrays,
# which are what the Unity baker iterates). Consumed by the sashimi
# spawn-director system (arrives at slice assembly); loaded like
# data/faction-matrix.yaml, not via the template loader.
#
# COUNT NOTE: CONTENT-ANALYSIS quotes "502 entries" (totals Slime 357 /
# Wolf 41); those figures undercount by the 7 source-prefab default spawn
# children hidden from the prefab-tree dump. The per-wave sizes in the
# Wave[N]_i names -- which the analysis itself trusts -- equal the serialized
# _spawns sizes and sum to 509.
#
# Semantics:
#   - tick_rate 60; wave_delay_seconds between waves (uniform 5 s;
#     WaveState.ticks_to_next starts at the first wave's delay).
#   - Entry x/y are wave-relative spawn offsets on the editor's 0.25 grid,
#     clamped to x [-9.5, 9.5], y [-6.5, 6.5] -- arena-space placement is the
#     spawn director's concern (Unity parks the config at (0, -30) off-arena
#     and bakes Location = spawn pos - wave pos).
#   - delay_ticks is the per-spawn SpawnDelay enum stored as its int value;
#     seconds = N / 60 (all Adventure spawns use VeryShort = 1).
#   - intro: first appearance of a creature type (telegraph beat).
#
# Totals: CreatureSlimeOrange 362, CreatureWolf 43, CreatureRockGolem 38,
# CreatureWisp 38, LargeTealCube 28. Intro beats: Wolf wave 6, RockGolem
# wave 11, Wisp wave 16, LargeTealCube wave 21.
tick_rate: 60
wave_delay_seconds: 5.0
waves:
  - wave: 1
    entries:
      - { template: CreatureSlimeOrange, x: 0, y: 0, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -3, y: 1.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -4, y: 2, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6.25, y: 2, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6, y: 3, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -4.25, y: 4.5, delay_ticks: 1 }
  - wave: 2
    entries:
      - { template: CreatureSlimeOrange, x: 3, y: -4.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 4, y: -5.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 5.25, y: 4.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 4.5, y: 5.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.75, y: -2, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.75, y: -1.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 8.75, y: -1.75, delay_ticks: 1 }
  - wave: 3
    entries:
      - { template: CreatureSlimeOrange, x: -7.5, y: 4.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.5, y: 3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.5, y: -3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.5, y: -4.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.5, y: 4.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.5, y: 3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.5, y: -4.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.5, y: -3.5, delay_ticks: 1 }
  - wave: 4
    entries:
      - { template: CreatureSlimeOrange, x: -6, y: -0.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6, y: 1, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6.5, y: 1.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6.5, y: -1.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.25, y: 2.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.25, y: -2, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -8, y: 2.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -8, y: -2.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -5.5, y: 0, delay_ticks: 1 }
  - wave: 5
    entries:
      - { template: CreatureSlimeOrange, x: 6, y: -0.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 6, y: 1, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 6.5, y: 1.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 6.5, y: -1.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.25, y: 2.25, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.25, y: -2, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 8, y: 2.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 8, y: -2.75, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 5.5, y: 0, delay_ticks: 1 }
  - wave: 6
    intro: CreatureWolf
    entries:
      - { template: CreatureWolf, x: -7.5, y: -0.5, delay_ticks: 1 }
      - { template: CreatureWolf, x: -7.5, y: 0.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -5.5, y: 2.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -5.5, y: -2.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6.5, y: -3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -6.5, y: 3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.5, y: -4.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: -7.5, y: 4.5, delay_ticks: 1 }
  - wave: 7
    entries:
      - { template: CreatureWolf, x: 7.5, y: -0.5, delay_ticks: 1 }
      - { template: CreatureWolf, x: 7.5, y: 0.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 5.5, y: 2.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 5.5, y: -2.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 6.5, y: -3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 6.5, y: 3.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.5, y: -4.5, delay_ticks: 1 }
      - { template: CreatureSlimeOrange, x: 7.5, y: 4.5, delay_ticks: 1 }
