                        simHz: +s.simHz.toFixed(1),
                        tickMs: +s.tickMs.toFixed(3),
                        engineMs: +engineMs.toFixed(3),
                        renderMs: +s.renderMs.toFixed(3),
                        droppedMs: Math.round(s.droppedMs),
