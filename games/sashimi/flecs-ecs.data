                    hp: hero ? hero.health : 0,
                    maxHp: hero ? hero.maxHealth : 0,
                    down: hero ? (hero.flags & FLAG_DEFEATED) !== 0 : false,
                    level: engine.heroLevel(),
                    gems: engine.gems(),
                    xpFloor: engine.levelXp(),
                    xpNext: engine.nextLevelXp(),
                    wave: engine.wave(),
                    waveCount: engine.waveCount(),
                    timeSec: engine.gameTick() / tickRate,
                    victorySec: engine.victoryTicks() / tickRate,
                    kills: engine.kills(),
                    fps: s.fps,
                    tickMs: s.tickMs,
                    engineMs: engineMs,
                    drawMs: s.renderMs,
                    entities: units.length,
                    players: input.players().map(function(p) {
                        return 'P' + p.clientId;
                    }).join(' '),
                    paused: paused,
                });
            },
            statsEvery: 250,
        });

        loop.start();
        return { loop: loop, engine: engine, restart: restart,
                 audio: audio };
    }

    return { start: start };
})();
/**
 * SashimiHUD â€” DOM HUD layer for the sashimi client: status panel (HP,
 * XP/level, wave, survival timer, perf counters), join/pause banner, and the
 * game-over / victory overlay. Pure presentation: every number displayed is
 * read from the engine through the WASM bridge.
 */
var SashimiHUD = (function() {
    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
    function mmss(sec) {
        sec = Math.max(0, Math.floor(sec));
        return Math.floor(sec / 60) + ':' + pad2(sec % 60);
    }
    function bar(pct, width) {
        pct = Math.max(0, Math.min(1, pct));
        var full = Math.round(pct * width);
        var out = '';
        for (var i = 0; i < width; i++) out += i < full ? '#' : '.';
        return out;
    }

    function init(els) {
        var hudEl = els.hud, bannerEl = els.banner, overlayEl = els.overlay;

        function update(d) {
            var hpPct = d.maxHp > 0 ? d.hp / d.maxHp : 0;
            var xpSpan = d.xpNext < 0 ? 0 : d.xpNext - d.xpFloor;
            var xpPct = d.xpNext < 0 ? 1
                : (xpSpan > 0 ? (d.gems - d.xpFloor) / xpSpan : 0);
            hudEl.textContent =
                'HP    [' + bar(hpPct, 14) + '] ' +
                    Math.max(0, Math.round(d.hp)) + '/' + Math.round(d.maxHp) +
                    (d.down ? '  DOWN' : '') +
                '\nLV ' + d.level + ' [' + bar(xpPct, 14) + '] ' +
                    (d.xpNext < 0 ? 'MAX' : d.gems + '/' + d.xpNext + ' gems') +
                '\nwave  ' + d.wave + '/' + d.waveCount +
                '\ntime  ' + mmss(d.timeSec) + ' / ' + mmss(d.victorySec) +
                '\nkills ' + d.kills + '   gems ' + d.gems +
                '\n' +
                '\nfps      ' + d.fps.toFixed(0) +
                '\ntick ms  ' + d.tickMs.toFixed(2) +
                    ' (engine ' + d.engineMs.toFixed(2) + ')' +
                '\ndraw ms  ' + d.drawMs.toFixed(2) +
                '\nentities ' + d.entities +
                '\nplayers  ' + (d.players || 'none') +
                (d.paused ? '\n\n== PAUSED (P to resume) ==' : '');
        }

        function setBanner(text) { bannerEl.textContent = text; }

        function showGameOver(d) {
            overlayEl.innerHTML = '';
            var h1 = document.createElement('div');
            h1.className = 'go-title ' + (d.victory ? 'go-victory' : 'go-defeat');
            h1.textContent = d.victory ? 'VICTORY' : 'DEFEAT';
            var msg = document.createElement('div');
            msg.className = 'go-msg';
            msg.textContent = d.message;
            var stats = document.createElement('div');
            stats.className = 'go-stats';
            stats.textContent =
                'survived  ' + mmss(d.timeSec) +
                '\nwave      ' + d.wave + '/' + d.waveCount +
                '\nlevel     ' + d.level +
                '\ngems      ' + d.gems +
                '\nkills     ' + d.kills;
            overlayEl.appendChild(h1);
            overlayEl.appendChild(msg);
            overlayEl.appendChild(stats);
            if (d.onRestart) {
                var btn = document.createElement('button');
                btn.className = 'go-restart';
                btn.textContent = 'PLAY AGAIN';
                btn.addEventListener('click', d.onRestart);
                overlayEl.appendChild(btn);
            }
            var hint = document.createElement('div');
            hint.className = 'go-hint';
            hint.textContent = d.onRestart ? 'or press R' : 'Press R to play again';
            overlayEl.appendChild(hint);
            overlayEl.style.display = 'flex';
        }

        function hideGameOver() { overlayEl.style.display = 'none'; }

        return {
            update: update,
            setBanner: setBanner,
            showGameOver: showGameOver,
            hideGameOver: hideGameOver,
        };
    }

    return { init: init };
})();
/**
 * SashimiSprites â€” sprite sheets + animation tables for the sashimi client,
 * as rt-sprites.js unit definitions (sheet + directional animation table
 * with mirror fallback chains â€” the UnitAnimationDataSO pattern).
 *
 * Two art paths:
 *   REAL (default)   â€” the Unity project's actual sprites: packed sheet
 *     PNGs (assets/<name>.png, HTTP-loaded) + generated manifests
 *     (lib/sashimi-art-data.js), both emitted by
 *     clients/tools/extract-art.py from the UnitAnimationDataSO tables,
 *     .anim keyframes and texture slicing metadata. World sizes are
 *     PPU-derived, so entities render at exactly Unity's scale.
 *   PROCEDURAL (fallback) â€” the original placeholder painters, kept for
 *     art-less debugging and as a reference for the def format. Select
 *     with ?art=proc, or automatically when sashimi-art-data.js is absent.
 *
 * Kinds mirror the WASM bridge enum (wasm_main.c SW_KIND_*):
 *   1 HeroEagle  2 HeroFrog  3 Slime  4 Wolf  5 Golem  6 Wisp  7 Cube
 *   8 Shuriken  9 Feather  10 WispShot  11 Gem  12 Heart
 * KIND_INFO names match the manifest unit names 1:1.
 *
 * All values here are presentation-only (frame rects, anchors, on-screen
 * sizes). Game parameters stay engine-side (root CLAUDE.md decision 13).
 */
var SashimiSprites = (function() {
    var DIRS = ['E', 'NE', 'N', 'NW', 'W', 'SW', 'S', 'SE'];

    /* â”€â”€ Sheet builders â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    /* Radially symmetric unit (blobs, orbs, pickups): one authored row,
       every state x direction falls back to it. */
    function makeSimpleUnit(fs, frames, fps, anchorY, painter) {
        var canvas = document.createElement('canvas');
        canvas.width = fs * frames;
        canvas.height = fs;
        var g = canvas.getContext('2d');
        for (var f = 0; f < frames; f++) {
            g.save();
            g.translate(f * fs, 0);
            painter(g, fs, [0, 1], f / frames, true);
            g.restore();
        }
        var table = { idle_S: { row: 0, frames: frames, fps: fps } };
        for (var s = 0; s < 2; s++) {
            var state = s === 0 ? 'walk' : 'idle';
            for (var d = 0; d < DIRS.length; d++) {
                var key = state + '_' + DIRS[d];
                if (!table[key]) table[key] = { fallback: 'idle_S' };
            }
        }
        return { sheet: canvas, frameSize: fs, anchorY: anchorY, table: table };
    }

    /* Directional unit (heroes, wolf, golem, cube): authored walk E/S/N
       (4 frames) + idle S (2 frames), left side mirrors right. */
    function makeDirectionalUnit(fs, anchorY, painter) {
        var rows = [
            { key: 'walk_E', face: [1, 0],  frames: 4, walk: true },
            { key: 'walk_S', face: [0, 1],  frames: 4, walk: true },
            { key: 'walk_N', face: [0, -1], frames: 4, walk: true },
            { key: 'idle_S', face: [0, 1],  frames: 2, walk: false },
        ];
        var canvas = document.createElement('canvas');
        canvas.width = fs * 4;
        canvas.height = fs * rows.length;
        var g = canvas.getContext('2d');

        var table = {};
        for (var r = 0; r < rows.length; r++) {
            var row = rows[r];
            for (var f = 0; f < row.frames; f++) {
                g.save();
                g.translate(f * fs, r * fs);
                var phase = row.walk ? f / row.frames : (f === 0 ? 0 : 0.5);
                painter(g, fs, row.face, phase, row.walk);
                g.restore();
            }
            table[row.key] = { row: r, frames: row.frames,
                               fps: row.walk ? 8 : 2 };
        }
        table.walk_W  = { fallback: 'walk_E', mirror: true };
        table.walk_NE = { fallback: 'walk_E' };
        table.walk_SE = { fallback: 'walk_E' };
        table.walk_NW = { fallback: 'walk_E', mirror: true };
        table.walk_SW = { fallback: 'walk_E', mirror: true };
        table.idle_E  = { fallback: 'idle_S' };
        table.idle_N  = { fallback: 'idle_S' };
        table.idle_NE = { fallback: 'idle_S' };
        table.idle_NW = { fallback: 'idle_S' };
        table.idle_W  = { fallback: 'idle_S' };
        table.idle_SW = { fallback: 'idle_S' };
        table.idle_SE = { fallback: 'idle_S' };
        return { sheet: canvas, frameSize: fs, anchorY: anchorY, table: table };
    }

    function shadow(g, fs, w) {
        g.fillStyle = 'rgba(0,0,0,0.25)';
        g.beginPath();
        g.ellipse(fs / 2, fs * 0.85, fs * w, fs * w * 0.35, 0, 0, Math.PI * 2);
        g.fill();
    }

    /* â”€â”€ Painters (one frame each) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    function paintSlime(pal) {
        return function(g, fs, face, phase) {
            var squash = Math.sin(phase * Math.PI * 2);
            shadow(g, fs, 0.24);
            var w = fs * (0.26 + squash * 0.04);
            var h = fs * (0.22 - squash * 0.05);
            var cy = fs * 0.85 - h;
            g.fillStyle = pal.body;
            g.beginPath();
            g.ellipse(fs / 2, cy + h * 0.35, w, h, 0, 0, Math.PI * 2);
            g.fill();
            g.strokeStyle = pal.outline;
            g.lineWidth = 1;
            g.stroke();
            g.fillStyle = pal.eye;
            g.beginPath();
            g.arc(fs / 2 - w * 0.35, cy, fs * 0.035, 0, Math.PI * 2);
            g.arc(fs / 2 + w * 0.35, cy, fs * 0.035, 0, Math.PI * 2);
            g.fill();
        };
    }

    function paintWolf(pal) {
        return function(g, fs, face, phase, walk) {
            var swing = walk ? Math.sin(phase * Math.PI * 2) : 0;
            shadow(g, fs, 0.3);
            var cy = fs * 0.66 - Math.abs(swing) * fs * 0.02;
            g.strokeStyle = pal.legs;
            g.lineWidth = Math.max(2, fs * 0.05);
            g.lineCap = 'round';
            g.beginPath();
            g.moveTo(fs * 0.36, cy);
            g.lineTo(fs * 0.36 + swing * fs * 0.06, fs * 0.85);
            g.moveTo(fs * 0.62, cy);
            g.lineTo(fs * 0.62 - swing * fs * 0.06, fs * 0.85);
            g.stroke();
            /* body along facing axis */
            g.fillStyle = pal.body;
            g.beginPath();
            if (face[1] === 0) {           /* E: long horizontal body */
                g.ellipse(fs / 2, cy, fs * 0.3, fs * 0.14, 0, 0, Math.PI * 2);
            } else {                       /* N/S: foreshortened */
                g.ellipse(fs / 2, cy, fs * 0.18, fs * 0.2, 0, 0, Math.PI * 2);
            }
            g.fill();
            g.strokeStyle = pal.outline;
            g.lineWidth = 1;
            g.stroke();
            /* head + snout toward facing */
            var hx = fs / 2 + face[0] * fs * 0.3;
            var hy = cy + face[1] * fs * 0.2 - fs * 0.06;
            g.fillStyle = pal.body;
            g.beginPath();
            g.arc(hx, hy, fs * 0.11, 0, Math.PI * 2);
            g.fill();
            g.stroke();
            g.fillStyle = pal.nose;
            g.beginPath();
            g.arc(hx + face[0] * fs * 0.09, hy + face[1] * fs * 0.07,
                  fs * 0.04, 0, Math.PI * 2);
            g.fill();
            /* ears */
            g.fillStyle = pal.body;
            g.beginPath();
            g.moveTo(hx - fs * 0.06, hy - fs * 0.08);
            g.lineTo(hx - fs * 0.02, hy - fs * 0.17);
            g.lineTo(hx + fs * 0.02, hy - fs * 0.08);
            g.fill();
        };
    }

    function paintGolem(pal) {
        return function(g, fs, face, phase, walk) {
            var bob = walk ? Math.abs(Math.sin(phase * Math.PI * 2)) : 0;
            shadow(g, fs, 0.32);
            var cy = fs * 0.55 - bob * fs * 0.02;
            /* bulky rock torso */
            g.fillStyle = pal.body;
            g.beginPath();
            g.moveTo(fs * 0.24, fs * 0.82);
            g.lineTo(fs * 0.2, cy);
            g.lineTo(fs * 0.34, cy - fs * 0.22);
            g.lineTo(fs * 0.66, cy - fs * 0.22);
            g.lineTo(fs * 0.8, cy);
            g.lineTo(fs * 0.76, fs * 0.82);
            g.closePath();
            g.fill();
            g.strokeStyle = pal.outline;
            g.lineWidth = 1.5;
            g.stroke();
            /* cracks */
            g.strokeStyle = pal.crack;
            g.lineWidth = 1;
            g.beginPath();
            g.moveTo(fs * 0.42, cy - fs * 0.1);
            g.lineTo(fs * 0.5, cy + fs * 0.05);
            g.lineTo(fs * 0.44, fs * 0.72);
            g.stroke();
            /* eyes toward facing */
            g.fillStyle = pal.eye;
            var ex = fs / 2 + face[0] * fs * 0.08;
            var ey = cy - fs * 0.12 + face[1] * fs * 0.04;
            g.beginPath();
            g.arc(ex - fs * 0.07, ey, fs * 0.03, 0, Math.PI * 2);
            g.arc(ex + fs * 0.07, ey, fs * 0.03, 0, Math.PI * 2);
            g.fill();
        };
    }

    function paintWisp(pal) {
        return function(g, fs, face, phase) {
            var hover = Math.sin(phase * Math.PI * 2) * fs * 0.04;
            shadow(g, fs, 0.16);
            var cy = fs * 0.45 + hover;
            /* glow */
            g.fillStyle = pal.glow;
            g.beginPath();
            g.arc(fs / 2, cy, fs * 0.22, 0, Math.PI * 2);
            g.fill();
            /* core */
            g.fillStyle = pal.body;
            g.beginPath();
            g.arc(fs / 2, cy, fs * 0.13, 0, Math.PI * 2);
            g.fill();
            /* wavy tail */
            g.strokeStyle = pal.body;
            g.lineWidth = Math.max(2, fs * 0.05);
            g.lineCap = 'round';
            g.beginPath();
            g.moveTo(fs / 2, cy + fs * 0.12);
            g.quadraticCurveTo(fs / 2 + Math.sin(phase * Math.PI * 2) * fs * 0.12,
                               cy + fs * 0.26, fs / 2, fs * 0.8 + hover * 0.5);
            g.stroke();
        };
    }

    function paintCube(pal) {
        return function(g, fs, face, phase, walk) {
            var tilt = walk ? Math.sin(phase * Math.PI * 2) * 0.12 : 0;
            shadow(g, fs, 0.34);
            g.save();
            g.translate(fs / 2, fs * 0.55);
            g.rotate(tilt);
            var s = fs * 0.3;
            g.fillStyle = pal.body;
            g.fillRect(-s, -s, s * 2, s * 2);
            g.strokeStyle = pal.outline;
            g.lineWidth = 2;
            g.strokeRect(-s, -s, s * 2, s * 2);
            g.fillStyle = pal.inner;
            g.fillRect(-s * 0.55, -s * 0.55, s * 1.1, s * 1.1);
            /* eyes toward facing */
            g.fillStyle = pal.eye;
            g.beginPath();
            g.arc(face[0] * s * 0.3 - s * 0.25, face[1] * s * 0.3 - s * 0.15,
                  fs * 0.035, 0, Math.PI * 2);
            g.arc(face[0] * s * 0.3 + s * 0.25, face[1] * s * 0.3 - s * 0.15,
                  fs * 0.035, 0, Math.PI * 2);
            g.fill();
            g.restore();
        };
    }

    function paintShuriken(pal) {
        return function(g, fs, face, phase) {
            g.save();
            g.translate(fs / 2, fs / 2);
            g.rotate(phase * Math.PI);   /* spins across frames */
            g.fillStyle = pal.body;
            for (var i = 0; i < 4; i++) {
                g.rotate(Math.PI / 2);
                g.beginPath();
                g.moveTo(0, 0);
                g.lineTo(fs * 0.1, -fs * 0.12);
                g.lineTo(0, -fs * 0.34);
                g.lineTo(-fs * 0.1, -fs * 0.12);
                g.closePath();
                g.fill();
            }
            g.fillStyle = pal.core;
            g.beginPath();
            g.arc(0, 0, fs * 0.07, 0, Math.PI * 2);
            g.fill();
            g.restore();
        };
    }

    function paintFeather(pal) {
        return function(g, fs, face, phase) {
            g.save();
            g.translate(fs / 2, fs / 2);
            g.rotate(-0.6 + Math.sin(phase * Math.PI * 2) * 0.25);
            g.fillStyle = pal.body;
            g.beginPath();
            g.ellipse(0, 0, fs * 0.1, fs * 0.3, 0, 0, Math.PI * 2);
            g.fill();
            g.strokeStyle = pal.spine;
            g.lineWidth = 1.5;
            g.beginPath();
            g.moveTo(0, -fs * 0.3);
            g.lineTo(0, fs * 0.34);
            g.stroke();
            g.restore();
        };
    }

    function paintOrb(pal) {
        return function(g, fs, face, phase) {
            var pulse = 1 + Math.sin(phase * Math.PI * 2) * 0.18;
            g.fillStyle = pal.glow;
            g.beginPath();
            g.arc(fs / 2, fs / 2, fs * 0.2 * pulse, 0, Math.PI * 2);
            g.fill();
            g.fillStyle = pal.body;
            g.beginPath();
            g.arc(fs / 2, fs / 2, fs * 0.11 * pulse, 0, Math.PI * 2);
            g.fill();
        };
    }

    function paintGem(pal) {
        return function(g, fs, face, phase) {
            var f = Math.floor(phase * 4);
            shadow(g, fs, 0.12);
            var cy = fs * 0.55 + Math.sin(phase * Math.PI * 2) * fs * 0.03;
            g.fillStyle = pal.body;
            g.beginPath();
            g.moveTo(fs / 2, cy - fs * 0.22);
            g.lineTo(fs / 2 + fs * 0.15, cy);
            g.lineTo(fs / 2, cy + fs * 0.22);
            g.lineTo(fs / 2 - fs * 0.15, cy);
            g.closePath();
            g.fill();
            g.strokeStyle = pal.edge;
            g.lineWidth = 1;
            g.stroke();
            if (f === 1) {  /* sparkle frame */
                g.strokeStyle = pal.sparkle;
                g.beginPath();
                g.moveTo(fs / 2 - fs * 0.24, cy - fs * 0.2);
                g.lineTo(fs / 2 - fs * 0.16, cy - fs * 0.12);
                g.moveTo(fs / 2 - 0.2 * fs, cy - fs * 0.2);
                g.lineTo(fs / 2 - 0.2 * fs, cy - fs * 0.11);
                g.stroke();
            }
        };
    }

    function paintHeart(pal) {
        return function(g, fs, face, phase) {
            var pulse = 1 + Math.sin(phase * Math.PI * 2) * 0.12;
            shadow(g, fs, 0.12);
            var cy = fs * 0.5;
            var s = fs * 0.2 * pulse;
            g.fillStyle = pal.body;
            g.beginPath();
            g.moveTo(fs / 2, cy + s);
            g.bezierCurveTo(fs / 2 - s * 1.4, cy, fs / 2 - s * 0.8, cy - s * 1.1,
                            fs / 2, cy - s * 0.35);
            g.bezierCurveTo(fs / 2 + s * 0.8, cy - s * 1.1, fs / 2 + s * 1.4, cy,
                            fs / 2, cy + s);
            g.fill();
        };
    }

    /* â”€â”€ Kind registry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    /* def name, on-screen size in world units (presentation-only). */
    var KIND_INFO = {
        1:  { name: 'eagle',    size: 1.0 },
        2:  { name: 'frog',     size: 1.0 },
        3:  { name: 'slime',    size: 0.7 },
        4:  { name: 'wolf',     size: 0.85 },
        5:  { name: 'golem',    size: 1.15 },
        6:  { name: 'wisp',     size: 0.75 },
        7:  { name: 'cube',     size: 1.1 },
        8:  { name: 'shuriken', size: 0.4 },
        9:  { name: 'feather',  size: 0.4 },
        10: { name: 'wispShot', size: 0.35 },
        11: { name: 'gem',      size: 0.45 },
        12: { name: 'heart',    size: 0.5 },
    };

    /* â”€â”€ Real art (extract-art.py manifests + packed sheet PNGs) â”€â”€â”€â”€â”€â”€ */

    function buildReal() {
        var version = SashimiArtData.version;
        var defs = {};
        var byKind = {};
        Object.keys(SashimiArtData.units).forEach(function(name) {
            var u = SashimiArtData.units[name];
            var img = new Image();
            /* content-hash version busts GitHub Pages caching (root
               CLAUDE.md decision 22); rt-sprites draws nothing until the
               sheet is decoded, so art pops in as it loads */
            img.src = u.sheet + '?v=' + version;
            defs[name] = {
                sheet: img,
                frameW: u.frameW, frameH: u.frameH,
                anchorX: u.anchorX, anchorY: u.anchorY,
                rotate: u.rotate,
                table: u.table,
            };
            if (u.kind > 0) byKind[u.kind] = { name: name, unit: u };
        });

        /* Spawn telegraph (kind 0 indicator def + the Unity window:
           spawnConfig.SpawnDelay, see extract-art.py). Drawn by the
           client's underlayFor hook, not a unit. */
        var warnUnit = SashimiArtData.units.spawnWarning;
        var warn = warnUnit ? {
            def: 'spawnWarning',
            seconds: SashimiArtData.spawnWarnSeconds || 1.25,
            size: warnUnit.worldH,
        } : null;

        return {
            real: true,
            defs: defs,
            warn: warn,
            defName: function(kind) {
                var k = byKind[kind];
                return k ? k.name : 'slime';
            },
            /* on-screen height in world units == Unity sprite height
               (frame px / PPU) */
            size: function(kind) {
                var k = byKind[kind];
                return k ? k.unit.worldH : 0.7;
            },
            /* health-bar geometry from the idle art's visual bounds (the
               frame cell is padded by defeat/attack FX frames) */
            barFor: function(kind, tilePx) {
                var k = byKind[kind];
                if (!k) return null;
                var w = Math.max(12, Math.min(60, k.unit.uiW * tilePx * 0.9));
                return { dy: k.unit.uiTop * tilePx + 6, w: w };
            },
            /* seconds a play-once state runs (0 = looping/absent) */
            stateDuration: function(kind, state) {
                var k = byKind[kind];
                if (!k) return 0;
                var a = RTSprites.resolve(k.unit.table, state + '_SE');
                if (!a) a = RTSprites.resolve(k.unit.table, state + '_S');
                return (a && a.once) ? a.frames / a.fps : 0;
            },
        };
    }

    /* â”€â”€ Procedural placeholder art (fallback path) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    function buildProcedural() {
        var FS = 32;
        var defs = {
            eagle: RTSprites.makePlaceholderUnit({
                frameSize: FS,
                body: '#e8e4d8', head: '#f0d890', nose: '#c87820',
                legs: '#907840', outline: '#403010',
            }),
            frog: RTSprites.makePlaceholderUnit({
                frameSize: FS,
                body: '#48a838', head: '#88d060', nose: '#184818',
                legs: '#286020', outline: '#103008',
            }),
            slime: makeSimpleUnit(FS, 4, 6, 0.85, paintSlime({
                body: '#e08828', outline: '#804810', eye: '#301800' })),
            wolf: makeDirectionalUnit(FS, 0.85, paintWolf({
                body: '#8890a0', legs: '#585c68', nose: '#282830',
                outline: '#303440' })),
            golem: makeDirectionalUnit(FS, 0.85, paintGolem({
                body: '#8a7860', outline: '#403828', crack: '#584c3c',
                eye: '#ffb020' })),
            wisp: makeSimpleUnit(FS, 4, 6, 0.8, paintWisp({
                body: '#70e8d8', glow: 'rgba(80,220,200,0.3)' })),
            cube: makeDirectionalUnit(FS, 0.85, paintCube({
                body: '#28a098', inner: '#40c8c0', outline: '#105850',
                eye: '#083430' })),
            shuriken: makeSimpleUnit(FS, 4, 12, 0.5, paintShuriken({
                body: '#c8ccd8', core: '#606878' })),
            feather: makeSimpleUnit(FS, 4, 8, 0.5, paintFeather({
                body: '#f0f0e8', spine: '#a8a8a0' })),
            wispShot: makeSimpleUnit(FS, 4, 8, 0.5, paintOrb({
                body: '#a0f0e0', glow: 'rgba(80,220,200,0.4)' })),
            gem: makeSimpleUnit(FS, 4, 4, 0.7, paintGem({
                body: '#4890f0', edge: '#1848a0', sparkle: '#d0e8ff' })),
            heart: makeSimpleUnit(FS, 4, 4, 0.7, paintHeart({
                body: '#e03848' })),
        };

        return {
            real: false,
            defs: defs,
            warn: null,                      /* no telegraph art */
            defName: function(kind) {
                var k = KIND_INFO[kind];
                return k ? k.name : 'slime';
            },
            size: function(kind) {
                var k = KIND_INFO[kind];
                return k ? k.size : 0.7;
            },
            barFor: function() { return null; },       /* default geometry */
            stateDuration: function() { return 0; },   /* nothing blocks */
        };
    }

    function build() {
        var wantProc = typeof location !== 'undefined' &&
            /[?&]art=proc\b/.test(location.search);
        if (wantProc || typeof SashimiArtData === 'undefined') {
            return buildProcedural();
        }
        return buildReal();
    }

    return { build: build };
})();
#!/usr/bin/env python3
"""Extract the real sashimi sprite art into rt-sprites manifests.

Reads the Unity project (READ-ONLY) at --sashimi-root and emits, per
renderable kind (wasm_main.c SW_KIND_*):

  - a packed sprite-sheet PNG        -> clients/wasm/assets/<name>.png
  - an rt-sprites animation manifest -> clients/lib/sashimi-art-data.js
    (generated JS: `var SashimiArtData = {...}`; consumed by
    sashimi-sprites.js, loaded by clients/wasm/index.html)

Sources, mirroring the Unity presentation pipeline:

  UnitAnimationDataSO (*_UASO.asset)      state rows: Name ("WalkSE"),
                                          AnimationClip guid, FallbackName,
                                          FallbackInverse (mirror)
  AnimationClip (.anim, text YAML)        m_PPtrCurves sprite keyframes
                                          (time, sprite fileID, texture guid),
                                          m_SampleRate, StopTime, LoopTime
  Texture .meta (text YAML)               spriteSheet slicing: per-sprite rect
                                          (y-up), pivot/alignment, and
                                          spritePixelsToUnits (PPU)
  Projectile / pickup prefab variants     StaticSprite {fileID, guid} refs
                                          (traced by hand, pinned below by
                                          guid + expected basename)

Packing: every frame of a unit is pasted pivot-aligned into a fixed cell
(the pivot of each source sprite lands on the same cell-relative anchor
point), then the cell is cropped to the union alpha bbox across all frames
(+1px pad) so on-screen size ~= visual size. World size = cell px / PPU,
so entity sprites scale exactly as Unity renders them (SpriteRenderer at
identity transform in the *_Presentation prefabs).

Direction model: the Unity art is authored for the four isometric
diagonals only (SE authored, SW = SE mirrored, NE/NW back rows falling
back per the UASO). The client speaks 8 octants; cardinals are mapped
E->SE, S->SE, W->SW, N->NE (fallback rows in the manifest, no mirror).
Non-directional states (Defeat, Spawn, Respawn) are authored once as
<state>_S with all other dirs falling back.

Deps (not in the system python):

  python3 -m venv .venv && .venv/bin/pip install pyyaml pillow
  .venv/bin/python sandboxes/sashimi/clients/tools/extract-art.py

Run from anywhere; paths are resolved relative to this file.
"""

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

try:
    import yaml
    from PIL import Image
except ImportError as e:  # pragma: no cover
    sys.exit(
        f"missing dependency ({e.name}). Create a venv first:\n"
        "  python3 -m venv .venv && .venv/bin/pip install pyyaml pillow\n"
        "  .venv/bin/python " + __file__
    )

TOOLS_DIR = Path(__file__).resolve().parent
CLIENTS_DIR = TOOLS_DIR.parent
DEFAULT_SASHIMI = Path.home() / "Dev" / "sashimi"

# Client octants (rt-sprites DIRS) and the Unity-diagonal mapping for the
# four cardinals the art never authors.
DIRS = ["E", "NE", "N", "NW", "W", "SW", "S", "SE"]
CARDINAL_TO_DIAGONAL = {"E": "SE", "S": "SE", "W": "SW", "N": "NE"}

# SpriteAlignment -> normalized pivot (x right, y up â€” Unity texture space)
ALIGNMENT_PIVOT = {
    0: (0.5, 0.5), 1: (0.0, 1.0), 2: (0.5, 1.0), 3: (1.0, 1.0),
    4: (0.0, 0.5), 5: (1.0, 0.5), 6: (0.0, 0.0), 7: (0.5, 0.0),
    8: (1.0, 0.0),  # 9 = Custom -> use the sprite's own pivot field
}

# kind -> source spec. Kinds mirror wasm_main.c SW_KIND_* and
# sashimi-sprites.js KIND_INFO. Provenance of the static-sprite guids:
#   shuriken  Shuriken_Projectile.prefab   EntityName SpritePoisonShuriken
#   feather   Feather_Projectile.prefab    EntityName Spritefeatherprojectile
#   wispShot  CreatureWisp_Projectile.prefab  sprite ProjectileCollisionEffect_0
#   gem/heart GemPickup.prefab / HeartPIckup.prefab StaticSprite refs
# Projectiles are spawned facing their travel direction
# (ProjectileLifecycleSystem.cs: AngleAxis(atan2(dir)) around forward), so
# they carry rotate: true; the client rotates them by the unit dir vector.
UNITS = {
    1: {"name": "eagle", "uaso": "Assets/Heroes/Eagle/HeroEagle_UASO.asset"},
    2: {"name": "frog", "uaso": "Assets/Heroes/Frog/HeroFrog_UASO.asset"},
    3: {"name": "slime",
        "uaso": "Assets/Creatures/SlimeOrange/CreatureSlimeOrange_UASO.asset"},
    4: {"name": "wolf", "uaso": "Assets/Creatures/Wolf/CreatureWolf_UASO.asset"},
    5: {"name": "golem",
        "uaso": "Assets/Creatures/RockGolem/CreatureRockGolem_UASO.asset"},
    6: {"name": "wisp", "uaso": "Assets/Creatures/Wisp/CreatureWisp_UASO.asset"},
    7: {"name": "cube",
        "uaso": "Assets/Creatures/LargeTealCube/LargeTealCube_UASO.asset"},
    8: {"name": "shuriken", "rotate": True,
        "static": {"guid": "9e4e6c59157ddc8419fc2a365f2a01e4",
                   "basename": "PoisonShuriken.png"}},
    9: {"name": "feather", "rotate": True,
        "static": {"guid": "b07feb3073ef0134fad148821efec27e",
                   "basename": "featherprojectile.png"}},
    10: {"name": "wispShot", "rotate": True,
         "static": {"guid": "7887ce7271252a544a7c2a3a89c94102",
                    "basename": "ProjectileCollisionEffect.png",
                    "sprite": "ProjectileCollisionEffect_0"}},
    11: {"name": "gem",
         "static": {"guid": "c370bc500b0d1bc44b8227b5085207a3",
                    "basename": "GemPickup.png"}},
    12: {"name": "heart",
         "static": {"guid": "1ddd93446f1df3047af05fb49de7229f",
                    "basename": "HeartPickup.png"}},
}

# Spawn-warning indicator (kind 0 â€” not a renderable unit; drawn by the
# client's rt-render underlayFor hook). SpawnWarning.prefab's StaticSprite
# is Assets/Art/SpawnWarning.png. Unity's EnemySpawnSystem instantiates
# the warning at each spawn point and DelayedSpawnSystem materializes the
# creature spawnConfig.SpawnDelay seconds later (Adventure subscene
# override 1.25; prefab default 0.65). The port's simulation materializes
# creatures on their per-entry wave delay instead (see the sandbox
# CLAUDE.md port decisions), so the telegraph window is client-side
# presentation: sashimi-client.js shows the indicator for
# SPAWN_WARN_SECONDS from a creature's first appearance and cross-fades
# it into the unit sprite.
SPAWN_WARNING_GUID = "0be51353274e5db4189904a8d1403058"   # SpawnWarning.png
SPAWN_WARN_SECONDS = 1.25


# â”€â”€ Unity YAML helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

TAG_RE = re.compile(r"^--- !u!\d+ &\d+.*$", re.M)


def load_unity_yaml(path):
    """Parse a Unity text-serialized asset; returns list of documents."""
    text = path.read_text(errors="replace")
    text = re.sub(r"^%.*$", "", text, flags=re.M)
    text = TAG_RE.sub("---", text)
    return [d for d in yaml.safe_load_all(text) if d is not None]


def build_guid_index(root):
    """guid -> asset path (from .meta files under Assets/)."""
    index = {}
    guid_re = re.compile(r"^guid: ([0-9a-f]{32})", re.M)
    for meta in (root / "Assets").rglob("*.meta"):
        try:
            head = meta.read_text(errors="replace")[:400]
        except OSError:
            continue
        m = guid_re.search(head)
        if m:
            index[m.group(1)] = meta.with_suffix("")
    return index


class TextureCache:
    """Loads texture .meta slicing + pixels once per texture guid."""

    def __init__(self, root, guid_index):
        self.root = root
        self.guid_index = guid_index
        self._cache = {}

    def get(self, guid):
        if guid in self._cache:
            return self._cache[guid]
        path = self.guid_index.get(guid)
        if path is None or not path.exists():
            sys.exit(f"texture guid {guid} not found in Assets/")
        meta = yaml.safe_load((path.parent / (path.name + ".meta")).read_text())
        imp = meta["TextureImporter"]
        ppu = float(imp["spritePixelsToUnits"])
        image = Image.open(path).convert("RGBA")
        sprites = {}  # fileID -> {name, rect(x,y,w,h y-up), pivot(nx,ny y-up)}
        if int(imp.get("spriteMode", 1)) == 1:
            # single-sprite texture: whole image, fileID 21300000
            pivot = self._pivot(int(imp.get("alignment", 0)),
                                imp.get("spritePivot"))
            sprites[21300000] = {
                "name": path.stem,
                "rect": (0, 0, image.width, image.height),
                "pivot": pivot,
            }
        else:
            for s in imp["spriteSheet"]["sprites"]:
                r = s["rect"]
                pivot = self._pivot(int(s.get("alignment", 0)), s.get("pivot"))
                sprites[int(s["internalID"])] = {
                    "name": s["name"],
                    "rect": (int(r["x"]), int(r["y"]),
                             int(r["width"]), int(r["height"])),
                    "pivot": pivot,
                }
        entry = {"path": path, "ppu": ppu, "image": image, "sprites": sprites}
        self._cache[guid] = entry
        return entry

    @staticmethod
    def _pivot(alignment, custom):
        if alignment == 9:
            return (float(custom["x"]), float(custom["y"]))
        return ALIGNMENT_PIVOT[alignment]

    def frame(self, guid, file_id):
        """-> (PIL image cropped to the sprite rect, pivot px from
        top-left of that crop (x right, y down), ppu, sprite name)."""
        tex = self.get(guid)
        spr = tex["sprites"].get(file_id)
        if spr is None:
            sys.exit(f"sprite fileID {file_id} not in {tex['path'].name}")
        x, y_up, w, h = spr["rect"]
        img_h = tex["image"].height
        top = img_h - (y_up + h)  # Unity rects are y-up from bottom-left
        crop = tex["image"].crop((x, top, x + w, top + h))
        px, py_up = spr["pivot"]
        pivot_px = (px * w, h - py_up * h)  # -> y-down from crop top
        return crop, pivot_px, tex["ppu"], spr["name"]


# â”€â”€ State naming â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

STATE_RE = re.compile(r"^(.*?)(NE|NW|SE|SW)$")


def state_key(unity_name):
    """'WalkSE' -> 'walk_SE'; 'Defeat' -> 'defeat_S' (non-directional)."""
    m = STATE_RE.match(unity_name)
    if m:
        return f"{m.group(1).lower()}_{m.group(2)}"
    return f"{unity_name.lower()}_S"


def clip_frames(clip_doc):
    """-> (list[(fileID, guid)], fps, loop) from an AnimationClip doc."""
    clip = clip_doc["AnimationClip"]
    curves = clip.get("m_PPtrCurves") or []
    sprite_curves = [c for c in curves if c.get("attribute") == "m_Sprite"]
    if len(sprite_curves) != 1:
        sys.exit(f"clip {clip.get('m_Name')}: expected 1 sprite curve, "
                 f"got {len(sprite_curves)}")
    keys = sprite_curves[0]["curve"]
    frames, times = [], []
    for k in keys:
        v = k["value"]
        frames.append((int(v["fileID"]), v["guid"]))
        times.append(float(k["time"]))
    settings = clip["m_AnimationClipSettings"]
    stop = float(settings["m_StopTime"])
    loop = bool(int(settings.get("m_LoopTime", 0)))
    if len(frames) > 1:
        # verify uniform spacing (rt-sprites rows are constant-fps)
        deltas = [times[i + 1] - times[i] for i in range(len(times) - 1)]
        if max(deltas) - min(deltas) > 1e-3:
            print(f"  WARNING: non-uniform keys in {clip.get('m_Name')}; "
                  f"averaging (deltas {deltas})")
    fps = (len(frames) / stop) if stop > 0 else 1.0
    return frames, round(fps, 4), loop


# â”€â”€ Packing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def pack_unit(name, rows, out_png):
    """rows: list of {key, frames: [(img, pivot_px)], fps, once}.
    Pastes pivot-aligned, crops to union alpha bbox, writes the sheet.
    -> manifest dict (sans table fallbacks)."""
    # cell extents around the shared pivot anchor
    left = right = up = down = 1.0
    for row in rows:
        for img, (px, py) in row["frames"]:
            left = max(left, px)
            right = max(right, img.width - px)
            up = max(up, py)
            down = max(down, img.height - py)
    cell_w, cell_h = int(-(-left // 1) + -(-right // 1)), None
    import math
    left, right = math.ceil(left), math.ceil(right)
    up, down = math.ceil(up), math.ceil(down)
    cell_w, cell_h = left + right, up + down

    # paste all frames into a working sheet
    max_frames = max(len(r["frames"]) for r in rows)
    sheet = Image.new("RGBA", (cell_w * max_frames, cell_h * len(rows)),
                      (0, 0, 0, 0))
    for ri, row in enumerate(rows):
        for fi, (img, (px, py)) in enumerate(row["frames"]):
            ox = fi * cell_w + left - round(px)
            oy = ri * cell_h + up - round(py)
            sheet.paste(img, (ox, oy))

    # union alpha bbox per cell position (same crop for every cell so rows
    # stay a regular grid), padded 1px, pivot kept inside
    union = None
    for ri, row in enumerate(rows):
        for fi in range(len(row["frames"])):
            cell = sheet.crop((fi * cell_w, ri * cell_h,
                               (fi + 1) * cell_w, (ri + 1) * cell_h))
            bb = cell.getbbox()
            if bb is None:
                continue
            union = bb if union is None else (
                min(union[0], bb[0]), min(union[1], bb[1]),
                max(union[2], bb[2]), max(union[3], bb[3]))
    if union is None:
        sys.exit(f"{name}: all frames empty")
    x0 = max(0, min(union[0] - 1, left))
    y0 = max(0, min(union[1] - 1, up))
    x1 = min(cell_w, max(union[2] + 1, left))
    y1 = min(cell_h, max(union[3] + 1, up))
    fw, fh = x1 - x0, y1 - y0

    packed = Image.new("RGBA", (fw * max_frames, fh * len(rows)), (0, 0, 0, 0))
    for ri in range(len(rows)):
        for fi in range(max_frames):
            cell = sheet.crop((fi * cell_w + x0, ri * cell_h + y0,
                               fi * cell_w + x1, ri * cell_h + y1))
            packed.paste(cell, (fi * fw, ri * fh))
    out_png.parent.mkdir(parents=True, exist_ok=True)
    packed.save(out_png, optimize=True)

    return {
        "frameW": fw, "frameH": fh,
        "anchorX": round((left - x0) / fw, 4),
        "anchorY": round((up - y0) / fh, 4),
    }


def ui_metrics(rows, ppu):
    """Visual bounds of the *idle* frames relative to the pivot, in world
    units. The packed cell can be much larger than the resting sprite
    (defeat poofs, attack sweeps share the cell), so health bars / labels
    anchor to these instead of the cell size:
      uiTop â€” distance from pivot up to the idle art's top edge
      uiW   â€” idle art width
    """
    idle = [r for r in rows if r["key"].startswith("idle_")] or rows[:1]
    top = w_min = w_max = None
    for row in idle:
        for img, (px, py) in row["frames"]:
            bb = img.getbbox()
            if bb is None:
                continue
            t = py - bb[1]
            top = t if top is None else max(top, t)
            lo, hi = bb[0] - px, bb[2] - px
            w_min = lo if w_min is None else min(w_min, lo)
            w_max = hi if w_max is None else max(w_max, hi)
    if top is None:
        return {"uiTop": 0.5, "uiW": 0.5}
    return {"uiTop": round(top / ppu, 4),
            "uiW": round((w_max - w_min) / ppu, 4)}


# â”€â”€ Table assembly â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def resolve_chain(table, key, guard=10):
    """Python mirror of RTSprites.resolve â€” sanity check only."""
    mirror = False
    for _ in range(guard):
        e = table.get(key)
        if e is None:
            return None
        if e.get("mirror"):
            mirror = not mirror
        if "row" in e:
            return {"row": e["row"], "mirror": mirror}
        key = e["fallback"]
    return None


def expand_dirs(table):
    """Add cardinal->diagonal fallbacks for every state in the table."""
    states = {k.rsplit("_", 1)[0] for k in table}
    for state in sorted(states):
        # non-directional authored as _S: everything falls back to it
        if f"{state}_S" in table and f"{state}_SE" not in table:
            for d in DIRS:
                key = f"{state}_{d}"
                if key not in table:
                    table[key] = {"fallback": f"{state}_S"}
            continue
        for card, diag in CARDINAL_TO_DIAGONAL.items():
            key, target = f"{state}_{card}", f"{state}_{diag}"
            if key not in table and target in table:
                table[key] = {"fallback": target}
    return table


def extract_animated(root, tex_cache, spec, assets_dir):
    docs = load_unity_yaml(root / spec["uaso"])
    mono = docs[0]["MonoBehaviour"]
    rows_info = mono["animationDataInfo"]

    guid_index = tex_cache.guid_index
    authored, fallbacks = [], {}
    ppu = None
    for row in rows_info:
        key = state_key(row["Name"])
        clip_ref = row.get("AnimationClip") or {}
        guid = clip_ref.get("guid")
        if guid and guid_index.get(guid) is None:
            # dangling reference in the Unity project itself (e.g. the
            # LargeTealCube AttackSE clip was deleted); treat as authored-
            # missing and use the row's fallback chain
            print(f"  WARNING: {spec['name']} {row['Name']}: clip guid "
                  f"{guid} dangling in Unity project; using fallback "
                  f"'{row.get('FallbackName')}'")
            guid = None
        if guid:
            clip_path = guid_index.get(guid)
            frames_ref, fps, loop = clip_frames(load_unity_yaml(clip_path)[0])
            frames = []
            for file_id, tex_guid in frames_ref:
                img, pivot, f_ppu, _ = tex_cache.frame(tex_guid, file_id)
                if ppu is None:
                    ppu = f_ppu
                elif f_ppu != ppu:
                    sys.exit(f"{spec['name']}: mixed PPU {ppu} vs {f_ppu}")
                frames.append((img, pivot))
            authored.append({"key": key, "frames": frames, "fps": fps,
                             "once": not loop})
        else:
            fb = row.get("FallbackName") or ""
            if fb:
                fallbacks[key] = {"fallback": state_key(fb),
                                  "mirror": bool(int(row.get("FallbackInverse", 0)))}

    out_png = assets_dir / f"{spec['name']}.png"
    manifest = pack_unit(spec["name"], authored, out_png)
    table = {}
    for i, row in enumerate(authored):
        entry = {"row": i, "frames": len(row["frames"]), "fps": row["fps"]}
        if row["once"]:
            entry["once"] = True
        table[row["key"]] = entry
    for key, entry in fallbacks.items():
        e = {"fallback": entry["fallback"]}
        if entry["mirror"]:
            e["mirror"] = True
        table[key] = e
    expand_dirs(table)
    manifest["table"] = table
    manifest["ppu"] = ppu
    manifest.update(ui_metrics(authored, ppu))
    return manifest


def extract_static(root, tex_cache, spec, assets_dir):
    st = spec["static"]
    tex = tex_cache.get(st["guid"])
    if tex["path"].name != st["basename"]:
        sys.exit(f"{spec['name']}: guid resolves to {tex['path'].name}, "
                 f"expected {st['basename']}")
    if "sprite" in st:
        file_id = next((fid for fid, s in tex["sprites"].items()
                        if s["name"] == st["sprite"]), None)
        if file_id is None:
            sys.exit(f"{spec['name']}: sprite {st['sprite']} not found")
    else:
        file_id = next(iter(tex["sprites"]))
    img, pivot, ppu, _ = tex_cache.frame(st["guid"], file_id)
    out_png = assets_dir / f"{spec['name']}.png"
    manifest = pack_unit(spec["name"],
                         [{"key": "idle_S", "frames": [(img, pivot)],
                           "fps": 1, "once": False}], out_png)
    table = {"idle_S": {"row": 0, "frames": 1, "fps": 1}}
    # everything (idle/walk any dir) falls back to the single sprite
    for state in ("idle", "walk"):
        for d in DIRS:
            key = f"{state}_{d}"
            if key not in table:
                table[key] = {"fallback": "idle_S"}
    manifest["table"] = table
    manifest["ppu"] = ppu
    manifest.update(ui_metrics(
        [{"key": "idle_S", "frames": [(img, pivot)]}], ppu))
    return manifest


def extract_spawn_warning(tex_cache, assets_dir):
    """SpawnWarning.png -> a 4-frame pulse row (the Unity prefab's motion
    comes from presentation FX not captured in the extraction; a synthetic
    scale/alpha pulse reads the same on a ground telegraph)."""
    img, pivot, ppu, name = tex_cache.frame(SPAWN_WARNING_GUID, 21300000)
    if name != "SpawnWarning":
        sys.exit(f"spawnWarning: guid resolves to sprite {name}, "
                 "expected SpawnWarning")
    frames = []
    for s, a in ((0.92, 0.75), (1.0, 0.9), (1.08, 1.0), (1.0, 0.9)):
        f = img.resize((max(1, round(img.width * s)),
                        max(1, round(img.height * s))), Image.LANCZOS)
        if a < 1.0:
            f.putalpha(f.getchannel("A").point(lambda v: int(v * a)))
        frames.append((f, (pivot[0] * s, pivot[1] * s)))
    m = pack_unit("spawnWarning",
                  [{"key": "idle_S", "frames": frames, "fps": 8,
                    "once": False}],
                  assets_dir / "spawnWarning.png")
    table = {"idle_S": {"row": 0, "frames": 4, "fps": 8}}
    for state in ("idle", "walk"):
        for d in DIRS:
            table.setdefault(f"{state}_{d}", {"fallback": "idle_S"})
    m["table"] = table
    m["ppu"] = ppu
    m.update(ui_metrics([{"key": "idle_S", "frames": frames}], ppu))
    return m


# â”€â”€ Golden checks (extraction drift fails loudly, generator pattern) â”€â”€â”€â”€

def golden_checks(units):
    wolf = units["wolf"]
    walk = wolf["table"]["walk_SE"]
    assert walk["frames"] == 4 and abs(walk["fps"] - 12.0) < 0.1, walk
    assert wolf["ppu"] == 16, wolf["ppu"]
    assert wolf["table"]["walk_SW"] == {"fallback": "walk_SE", "mirror": True}
    assert wolf["table"]["defeat_S"].get("once") is True
    for uname in ("eagle", "frog", "slime", "wolf", "golem", "wisp", "cube"):
        table = units[uname]["table"]
        for state in ("idle", "walk", "damage", "defeat"):
            for d in DIRS:
                assert resolve_chain(table, f"{state}_{d}") is not None, \
                    f"{uname}: {state}_{d} unresolved"
    for uname in ("shuriken", "feather", "wispShot", "gem", "heart"):
        assert resolve_chain(units[uname]["table"], "idle_S") is not None
    # Unity world sizes: 32px cells at PPU 16 -> heroes/creatures ~<=2 wu
    assert 0.2 < units["wolf"]["worldH"] <= 2.0
    assert 0.1 < units["shuriken"]["worldW"] < 0.5   # 164px @ PPU 512
    assert abs(units["gem"]["worldH"] - 75 / 200) < 0.01
    # SpawnWarning: 158px @ PPU 300 (~0.53 wu) + pulse headroom + pad
    assert 0.45 < units["spawnWarning"]["worldH"] < 0.65


# â”€â”€ Main â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--sashimi-root", type=Path, default=DEFAULT_SASHIMI)
    ap.add_argument("--assets-dir", type=Path,
                    default=CLIENTS_DIR / "wasm" / "assets")
    ap.add_argument("--manifest", type=Path,
                    default=CLIENTS_DIR / "lib" / "sashimi-art-data.js")
    args = ap.parse_args()

    root = args.sashimi_root
    if not (root / "Assets").is_dir():
        sys.exit(f"not a Unity project: {root}")

    print(f"indexing guids under {root}/Assets ...")
    guid_index = build_guid_index(root)
    tex_cache = TextureCache(root, guid_index)

    units = {}
    for kind in sorted(UNITS):
        spec = UNITS[kind]
        print(f"kind {kind:2d} {spec['name']}")
        if "uaso" in spec:
            m = extract_animated(root, tex_cache, spec, args.assets_dir)
        else:
            m = extract_static(root, tex_cache, spec, args.assets_dir)
        m["kind"] = kind
        m["rotate"] = bool(spec.get("rotate"))
        m["sheet"] = f"assets/{spec['name']}.png"
        m["worldW"] = round(m["frameW"] / m["ppu"], 4)
        m["worldH"] = round(m["frameH"] / m["ppu"], 4)
        units[spec["name"]] = m

    print("indicator spawnWarning")
    m = extract_spawn_warning(tex_cache, args.assets_dir)
    m["kind"] = 0   # indicator, not a unit kind
    m["rotate"] = False
    m["sheet"] = "assets/spawnWarning.png"
    m["worldW"] = round(m["frameW"] / m["ppu"], 4)
    m["worldH"] = round(m["frameH"] / m["ppu"], 4)
    units["spawnWarning"] = m

    golden_checks(units)

    # content hash -> cache-busting version for the sheet URLs
    h = hashlib.sha1()
    h.update(json.dumps(units, sort_keys=True).encode())
    for name in sorted(units):
        h.update((args.assets_dir / f"{name}.png").read_bytes())
    version = h.hexdigest()[:10]

    js = (
        "/* GENERATED by clients/tools/extract-art.py â€” do not edit.\n"
        " * Real sashimi art: packed sheets (clients/wasm/assets/*.png) +\n"
        " * rt-sprites animation tables extracted from the Unity project's\n"
        " * UnitAnimationDataSO / .anim / texture-meta slicing data.\n"
        " * Regenerate: see the extractor's module docstring. */\n"
        "var SashimiArtData = " + json.dumps(
            {"version": version,
             "spawnWarnSeconds": SPAWN_WARN_SECONDS,
             "units": units},
            indent=2, sort_keys=True) + ";\n"
        "if (typeof module !== 'undefined') module.exports = SashimiArtData;\n"
    )
    args.manifest.write_text(js)
    print(f"wrote {args.manifest}")
    print(f"assets in {args.assets_dir}  (version {version})")
    for name, m in sorted(units.items(), key=lambda kv: kv[1]["kind"]):
        rows = sum(1 for e in m["table"].values() if "row" in e)
        print(f"  {m['kind']:2d} {name:9s} cell {m['frameW']}x{m['frameH']}px "
              f"world {m['worldW']}x{m['worldH']}  rows {rows}  ppu {m['ppu']}")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Extract the real sashimi audio into a web clip set + event manifest.

Reads the Unity project (READ-ONLY) at --sashimi-root and emits:

  - web-friendly audio clips            -> clients/wasm/assets/audio/*.m4a
  - an event -> clip manifest           -> clients/lib/sashimi-audio-data.js
    (generated JS: `var SashimiAudioData = {...}`; consumed by
    sashimi-audio.js, loaded by clients/wasm/index.html)

Sources, mirroring the Unity audio pipeline (PlayAudioSystem and its
callers; see AudioEventSO.cs for the event/group enums):

  AudioEventSO (7 assets: 5 creatures, 2 heroes)
      rows {eventType, group, clip guid, volume, oneShot} per unit.
      Trigger sites: PresentUnitAnimationSystem (Hurt/Defeat/Respawn/
      Windup/Active), HeroLevelUpSystem (LevelUp), ClientGameOverSystem
      (MatchVictory/MatchDefeat), ClientPossessSystem (Select).
  PickupEntity.prefab + Gem/Heart variants
      PickupAuthoring.PickupSFX (played by PickupSystem on collect).
  Projectile prefab variants (Shuriken / Feather / CreatureWisp)
      OnHitDamageTriggerAuthoring.SpawnSFX -> AudioEventType.Spawn
      (played by ProjectileLifecycleSystem when the projectile spawns,
      i.e. the weapon-fire sound) and .HitSFX -> AudioEventType.Impact
      (played by PresentDamageSystem when the hit lands).
      ProjectileAuthoring's duplicate HitSFX rows reference the same
      clips and are deduped by guid. FireSFX m_Modifications are stale
      fields from an older ProjectileWeaponAuthoring shape (dropped at
      import; CONTENT-ANALYSIS section 5) and are skipped, as are the 4
      legacy Assets/Weapons/ prefabs and the two Fireball/Bomb overrides
      that reference audio by editor-session instanceId (unresolvable
      offline).
  MusicController.prefab
      AudioSource clips by child name: AdventureMusic (in-game loop,
      MusicOn=1 in the Adventure config), VictoryMusic / DefeatMusic
      (post-game loops). StartMusic is menu music - the port has no
      menu scene, skipped.

Events with NO clip in the Unity data (honestly unmapped, listed in the
manifest): wave started, hits by Slime/Wolf (no Impact rows in their
AESOs), creature spawn (creatures have no Spawn rows).

Conversion: everything is re-encoded to .m4a (AAC) because the source
mix of .wav/.ogg/.mp3 is not uniformly decodable (Safari cannot decode
ogg vorbis, and the hero VO is all .ogg). Requires ffmpeg on PATH
(`brew install ffmpeg`); stdlib-only otherwise. Note AAC encoder
priming adds a few ms of silence at the loop seam of the music tracks.

Run from anywhere; paths are resolved relative to this file:

  python3 sandboxes/sashimi/clients/tools/extract-audio.py
"""

import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

TOOLS_DIR = Path(__file__).resolve().parent
CLIENTS_DIR = TOOLS_DIR.parent
DEFAULT_SASHIMI = Path.home() / "Dev" / "sashimi"

AUDIO_EXT = re.compile(r"\.(wav|ogg|mp3|aiff?|flac)$", re.I)

# AudioEventSO.cs enum AudioEventType (index == serialized int)
EVENT_TYPES = [
    "None", "Attack", "Hurt", "Defeat", "Select", "Spawn", "Respawn",
    "LevelUp", "MatchVictory", "MatchDefeat", "Impact", "Pickup",
    "Windup", "Active", "Recovery",
]

# AudioEventSO asset -> (unit name, SW_KIND_* value, is_hero)
AESO_UNITS = [
    ("Assets/Resources/SFX/Heroes/HeroEagle/HeroEagle_AudioEventSO.asset",
     "eagle", 1, True),
    ("Assets/Resources/SFX/Heroes/HeroFrog/HeroFrog_AudioEventSO.asset",
     "frog", 2, True),
    ("Assets/Resources/SFX/Creatures/Slime/CreatureSlimeOrange_AudioEventSO.asset",
     "slime", 3, False),
    ("Assets/Resources/SFX/Creatures/Wolf/CreatureWolf_AudioEventSO.asset",
     "wolf", 4, False),
    ("Assets/Resources/SFX/Creatures/RockGolem/CreatureRockGolem_AudioEventSO.asset",
     "golem", 5, False),
    ("Assets/Resources/SFX/Creatures/Wisp/CreatureWisp_AudioEventSO.asset",
     "wisp", 6, False),
    ("Assets/Resources/SFX/Creatures/LargeCube/LargeCube_AESO.asset",
     "cube", 7, False),
]

# AudioEventSO eventType -> manifest event table (heroes/creatures split
# Defeat; Attack/Hurt only exist as hero rows in the shipped data).
def manifest_event(ev_name, is_hero):
    return {
        "Hurt": "heroHurt" if is_hero else None,       # creatures: no rows
        "Defeat": "heroDied" if is_hero else "creatureDied",
        "Respawn": "heroRespawn",
        "LevelUp": "levelUp",
        "MatchVictory": "matchVictory",
        "MatchDefeat": "matchDefeat",
        "Select": "select",
        "Windup": "windup",
        "Active": "active",
        "Impact": "hit",
    }.get(ev_name)

# Projectile prefab variants: (path, unit name, projectile SW kind)
PROJECTILES = [
    ("Assets/Heroes/Frog/ShurikenAttack/Shuriken_Projectile.prefab",
     "shuriken", 8),
    ("Assets/Heroes/Eagle/FeatherAttack/Feather_Projectile.prefab",
     "feather", 9),
    ("Assets/Creatures/Wisp/RangedAttack/CreatureWisp_Projectile.prefab",
     "wispShot", 10),
]
PROJECTILE_BASE = "Assets/Prefabs/Gameplay/ProjectileEntity.prefab"
ONHIT_AUTHORING = ("Assets/Scripts/kitae/auric/authoring/"
                   "OnHitDamageTriggerAuthoring.cs")

PICKUP_BASE = "Assets/Prefabs/Gameplay/PickupEntity.prefab"
PICKUPS = [  # (variant path, name, pickup SW kind)
    ("Assets/Prefabs/Pickups/GemPickup.prefab", "gem", 11),
    ("Assets/Prefabs/Pickups/HeartPIckup.prefab", "heart", 12),
]

MUSIC_CONTROLLER = "Assets/Prefabs/MusicController.prefab"
MUSIC_TRACKS = {  # child GameObject name -> manifest music key
    "AdventureMusic": "adventure",
    "VictoryMusic": "victory",
    "DefeatMusic": "defeat",
    # StartMusic: menu music, no menu scene in the port -> skipped
}


def guid_index(root: Path):
    """guid -> asset path for every audio file under Assets/."""
    idx = {}
    for meta in (root / "Assets").rglob("*.meta"):
        base = str(meta)[:-5]
        if not AUDIO_EXT.search(base):
            continue
        m = re.search(r"^guid: ([0-9a-f]{32})", meta.read_text(errors="ignore"),
                      re.M)
        if m:
            idx[m.group(1)] = Path(base)
    return idx


def meta_guid(root: Path, asset_rel: str) -> str:
    meta = root / (asset_rel + ".meta")
    m = re.search(r"^guid: ([0-9a-f]{32})", meta.read_text(errors="ignore"),
                  re.M)
    if not m:
        sys.exit(f"no guid in {meta}")
    return m.group(1)


def parse_aeso(path: Path):
    """AudioEventConfig rows: [{event, guid, volume, oneShot}]."""
    text = path.read_text(errors="ignore")
    rows = []
    for m in re.finditer(
            r"- eventType: (\d+)\s*\n"
            r"\s*group: \d+\s*\n"
            r"\s*audio: \{fileID: \d+, guid: ([0-9a-f]{32}), type: \d+\}\s*\n"
            r"\s*volume: ([\d.]+)\s*\n"
            r"\s*oneShot: (\d+)", text):
        rows.append({
            "event": EVENT_TYPES[int(m.group(1))],
            "guid": m.group(2),
            "volume": float(m.group(3)),
            "oneShot": m.group(4) == "1",
        })
    return rows


def parse_modifications(text: str):
    """Prefab-variant m_Modifications: [(target_fileid, propertyPath,
    value, objectReference guid or None)] â€” Unity emits value and
    objectReference on the two lines after propertyPath."""
    mods = []
    for m in re.finditer(
            r"- target: \{fileID: (-?\d+), guid: [0-9a-f]{32},\s*\n?"
            r"\s*type: \d+\}\s*\n"
            r"\s*propertyPath: ([^\n]+)\n"
            r"\s*value: ([^\n]*)\n"
            r"\s*objectReference: \{fileID: (?:\d+), guid: ([0-9a-f]{32}), "
            r"type: \d+\}", text):
        mods.append((m.group(1), m.group(2).strip(), m.group(3).strip(),
                     m.group(4)))
    for m in re.finditer(
            r"- target: \{fileID: (-?\d+), guid: [0-9a-f]{32},\s*\n?"
            r"\s*type: \d+\}\s*\n"
            r"\s*propertyPath: ([^\n]+)\n"
            r"\s*value: ([^\n]*)\n"
            r"\s*objectReference: \{fileID: 0\}", text):
        mods.append((m.group(1), m.group(2).strip(), m.group(3).strip(), None))
    return mods


def base_prefab_component_fileids(root: Path, prefab_rel: str,
                                  script_guid: str):
    """fileIDs of MonoBehaviour docs in a prefab whose m_Script matches."""
    text = (root / prefab_rel).read_text(errors="ignore")
    out = set()
    for m in re.finditer(r"--- !u!114 &(-?\d+)\n(.*?)(?=\n--- |\Z)", text,
                         re.S):
        if f"guid: {script_guid}" in m.group(2).split("m_Name")[0]:
            out.add(m.group(1))
    return out


def slug(name: str) -> str:
    s = re.sub(r"[^A-Za-z0-9]+", "-", name).strip("-").lower()
    return re.sub(r"-+", "-", s)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--sashimi-root", type=Path, default=DEFAULT_SASHIMI)
    ap.add_argument("--audio-dir", type=Path,
                    default=CLIENTS_DIR / "wasm" / "assets" / "audio")
    ap.add_argument("--data-out", type=Path,
                    default=CLIENTS_DIR / "lib" / "sashimi-audio-data.js")
    ap.add_argument("--sfx-bitrate", default="96k")
    ap.add_argument("--music-bitrate", default="128k")
    args = ap.parse_args()
    root = args.sashimi_root

    if not shutil.which("ffmpeg"):
        sys.exit("ffmpeg not found on PATH (brew install ffmpeg) â€” needed "
                 "to convert wav/ogg/mp3 to web-friendly m4a")

    idx = guid_index(root)
    print(f"indexed {len(idx)} audio assets")

    clips = {}          # clip key -> {file, volume, src Path}
    events = {}         # manifest event -> {kind(str): [clip keys]}
    music = {}

    def add_clip(key, guid, volume):
        src = idx.get(guid)
        if src is None:
            sys.exit(f"unresolved audio guid {guid} for clip {key}")
        clips[key] = {"src": src, "volume": round(volume, 3),
                      "guid": guid}
        return key

    def add_event(event, kind, key):
        events.setdefault(event, {}).setdefault(str(kind), []).append(key)

    # â”€â”€ AudioEventSO rows â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for rel, unit, kind, is_hero in AESO_UNITS:
        rows = parse_aeso(root / rel)
        if not rows:
            sys.exit(f"no AudioEventConfig rows parsed from {rel}")
        counters = {}
        for r in rows:
            ev = manifest_event(r["event"], is_hero)
            if ev is None:
                sys.exit(f"{rel}: unmapped eventType {r['event']}")
            counters[ev] = counters.get(ev, 0) + 1
            key = f"{unit}-{slug(r['event'])}-{counters[ev]}"
            add_clip(key, r["guid"], r["volume"])
            add_event(ev, kind, key)

    # â”€â”€ Pickups: base PickupSFX + variant overrides â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    base_text = (root / PICKUP_BASE).read_text(errors="ignore")
    m = re.search(r"PickupSFX:\s*\n\s*group: \d+\s*\n"
                  r"\s*audio: \{fileID: \d+, guid: ([0-9a-f]{32}), type: \d+\}"
                  r"\s*\n\s*volume: ([\d.]+)", base_text)
    if not m:
        sys.exit(f"no PickupSFX in {PICKUP_BASE}")
    base_pickup = {"guid": m.group(1), "volume": float(m.group(2))}
    for rel, unit, kind in PICKUPS:
        mods = parse_modifications((root / rel).read_text(errors="ignore"))
        guid = base_pickup["guid"]
        volume = base_pickup["volume"]
        for _t, path, value, obj in mods:
            if path == "PickupSFX.audio" and obj:
                guid = obj
            elif path == "PickupSFX.volume" and value:
                volume = float(value)
        key = f"{unit}-pickup"
        add_clip(key, guid, volume)
        add_event("pickup", kind, key)

    # â”€â”€ Projectiles: OnHitDamageTrigger SpawnSFX (fire) / HitSFX â”€â”€â”€â”€â”€
    onhit_guid = meta_guid(root, ONHIT_AUTHORING)
    onhit_fileids = base_prefab_component_fileids(root, PROJECTILE_BASE,
                                                  onhit_guid)
    if not onhit_fileids:
        sys.exit("could not locate OnHitDamageTriggerAuthoring in "
                 + PROJECTILE_BASE)
    for rel, unit, kind in PROJECTILES:
        mods = parse_modifications((root / rel).read_text(errors="ignore"))
        fire = {"guid": None, "volume": 1.0}
        hit = {"guid": None, "volume": 1.0}
        for target, path, value, obj in mods:
            if target not in onhit_fileids:
                continue  # ProjectileAuthoring duplicates + stale FireSFX
            if path == "SpawnSFX.audio" and obj:
                fire["guid"] = obj
            elif path == "SpawnSFX.volume" and value:
                fire["volume"] = float(value)
            elif path == "HitSFX.audio" and obj:
                hit["guid"] = obj
            elif path == "HitSFX.volume" and value:
                hit["volume"] = float(value)
        if fire["guid"]:
            key = add_clip(f"{unit}-fire", fire["guid"], fire["volume"])
            add_event("weaponFired", kind, key)
        if hit["guid"]:
            key = add_clip(f"{unit}-hit", hit["guid"], hit["volume"])
            add_event("hit", kind, key)

    # â”€â”€ Music â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    mc_text = (root / MUSIC_CONTROLLER).read_text(errors="ignore")
    docs = re.split(r"\n--- ", mc_text)
    # child name -> the AudioSource clip guid in the doc that follows the
    # GameObject (name and AudioSource live in sibling docs; match by
    # scanning name docs then the AudioSource with the same GameObject id)
    go_ids = {}
    for d in docs:
        m = re.search(r"!u!1 &(\d+)\n.*?m_Name: (\w+)", d, re.S)
        if m:
            go_ids[m.group(1)] = m.group(2)
    for d in docs:
        m = re.search(r"!u!82 &\d+\nAudioSource:.*?"
                      r"m_GameObject: \{fileID: (\d+)\}.*?"
                      r"m_Resource: \{fileID: \d+, guid: ([0-9a-f]{32})",
                      d, re.S)
        if not m:
            continue
        name = go_ids.get(m.group(1))
        track = MUSIC_TRACKS.get(name or "")
        if not track:
            continue
        src = idx.get(m.group(2))
        if src is None:
            sys.exit(f"unresolved music guid for {name}")
        music[track] = {"src": src, "guid": m.group(2)}

    # â”€â”€ Golden-value assertions (drift fails loudly) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    def check(cond, msg):
        if not cond:
            sys.exit(f"extraction drift: {msg}")
    check(clips["gem-pickup"]["src"].name == "magicalchime.wav" and
          clips["gem-pickup"]["volume"] == 0.5,
          "gem pickup should be magicalchime.wav at volume 0.5")
    check(clips["heart-pickup"]["src"].name == "magicalpotion.wav",
          "heart pickup should be magicalpotion.wav")
    check(clips["shuriken-fire"]["src"].name == "Throw.wav",
          "shuriken fire should be Throw.wav")
    check(clips["shuriken-hit"]["src"].name == "splat.wav",
          "shuriken hit should be splat.wav")
    check(clips["wolf-defeat-1"]["src"].name == "Wolf_Defeat01.wav",
          "wolf defeat should be Wolf_Defeat01.wav")
    check(len(events["heroHurt"]["1"]) == 6 and
          len(events["heroHurt"]["2"]) == 5,
          "hero hurt VO counts (eagle 6, frog 5)")
    check(music["adventure"]["src"].name ==
          "Zane Little - It Takes A Hero LOOP.wav",
          "adventure music should be It Takes A Hero LOOP")
    check(set(music) == {"adventure", "victory", "defeat"},
          "expected 3 music tracks")

    # â”€â”€ Convert (dedupe identical sources by guid) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    args.audio_dir.mkdir(parents=True, exist_ok=True)
    for old in args.audio_dir.glob("*.m4a"):
        old.unlink()

    out_by_guid = {}

    def convert(src: Path, guid: str, bitrate: str) -> str:
        if guid in out_by_guid:
            return out_by_guid[guid]
        name = f"{slug(src.stem)}-{guid[:6]}.m4a"
        dst = args.audio_dir / name
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-i", str(src), "-vn",
             "-c:a", "aac", "-b:a", bitrate, "-movflags", "+faststart",
             str(dst)],
            check=True)
        out_by_guid[guid] = name
        return name

    for key, c in clips.items():
        c["file"] = convert(c["src"], c["guid"], args.sfx_bitrate)
    for track, t in music.items():
        t["file"] = convert(t["src"], t["guid"], args.music_bitrate)

    total = sum(f.stat().st_size for f in args.audio_dir.glob("*.m4a"))
    print(f"{len(out_by_guid)} files ({total / 1e6:.1f} MB) "
          f"in {args.audio_dir}")

    # â”€â”€ Manifest â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    manifest = {
        "clips": {k: {"file": "assets/audio/" + c["file"],
                      "volume": c["volume"]}
                  for k, c in sorted(clips.items())},
        "events": {ev: dict(sorted(kinds.items()))
                   for ev, kinds in sorted(events.items())},
        "music": {t: {"file": "assets/audio/" + m["file"], "loop": True}
                  for t, m in sorted(music.items())},
        "unmapped": [
            "waveStarted: no clip assigned anywhere in the Unity data",
            "hit by slime (kind 3) / wolf (kind 4): no Impact rows in "
            "their AudioEventSOs",
            "creature spawn: creatures have no Spawn rows (Unity's "
            "DelayedSpawnSystem Spawn event is silent for them)",
            "wisp (kind 6) windup: mapped but never fires - the wisp "
            "attacks with a weapon (wispShot fire covers it), not an "
            "ability stage",
        ],
    }
    h = hashlib.sha1()
    h.update(json.dumps(manifest, sort_keys=True).encode())
    for f in sorted(args.audio_dir.glob("*.m4a")):
        h.update(f.read_bytes())
    manifest_full = {"version": h.hexdigest()[:10]}
    manifest_full.update(manifest)

    args.data_out.write_text(
        "/* GENERATED by clients/tools/extract-audio.py â€” do not edit.\n"
        " * Real sashimi audio: web clips (clients/wasm/assets/audio/) +\n"
        " * event->clip manifest extracted from the Unity project's\n"
        " * AudioEventSO / pickup / projectile / MusicController data.\n"
        " * Regenerate: see the extractor's module docstring. */\n"
        "var SashimiAudioData = "
        + json.dumps(manifest_full, indent=2, sort_keys=False)
        + ";\n")
    print(f"manifest {args.data_out}  (version {manifest_full['version']})")
    for ev in sorted(events):
        kinds = {k: len(v) for k, v in events[ev].items()}
        print(f"  {ev}: {kinds}")


if __name__ == "__main__":
    main()
