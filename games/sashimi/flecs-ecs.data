            g.stroke();
        };
    }

    function paintCube(pal) {
        return function(g, fs, face, phase, walk) {
            var tilt = walk ? Math.sin(phase * Math.PI * 2) * 0.12 : 0;
            shadow(g, fs, 0.34);
            g.save();
            g.translate(fs / 2, fs * 0.55);
            g.rotate(tilt);
            var s = fs * 0.3;
            g.fillStyle = pal.body;
            g.fillRect(-s, -s, s * 2, s * 2);
            g.strokeStyle = pal.outline;
            g.lineWidth = 2;
            g.strokeRect(-s, -s, s * 2, s * 2);
            g.fillStyle = pal.inner;
            g.fillRect(-s * 0.55, -s * 0.55, s * 1.1, s * 1.1);
            /* eyes toward facing */
            g.fillStyle = pal.eye;
            g.beginPath();
            g.arc(face[0] * s * 0.3 - s * 0.25, face[1] * s * 0.3 - s * 0.15,
                  fs * 0.035, 0, Math.PI * 2);
            g.arc(face[0] * s * 0.3 + s * 0.25, face[1] * s * 0.3 - s * 0.15,
                  fs * 0.035, 0, Math.PI * 2);
            g.fill();
            g.restore();
        };
    }

    function paintShuriken(pal) {
        return function(g, fs, face, phase) {
            g.save();
            g.translate(fs / 2, fs / 2);
            g.rotate(phase * Math.PI);   /* spins across frames */
            g.fillStyle = pal.body;
            for (var i = 0; i < 4; i++) {
                g.rotate(Math.PI / 2);
                g.beginPath();
                g.moveTo(0, 0);
                g.lineTo(fs * 0.1, -fs * 0.12);
                g.lineTo(0, -fs * 0.34);
                g.lineTo(-fs * 0.1, -fs * 0.12);
                g.closePath();
                g.fill();
            }
            g.fillStyle = pal.core;
            g.beginPath();
            g.arc(0, 0, fs * 0.07, 0, Math.PI * 2);
            g.fill();
            g.restore();
        };
    }

    function paintFeather(pal) {
        return function(g, fs, face, phase) {
            g.save();
            g.translate(fs / 2, fs / 2);
            g.rotate(-0.6 + Math.sin(phase * Math.PI * 2) * 0.25);
            g.fillStyle = pal.body;
            g.beginPath();
            g.ellipse(0, 0, fs * 0.1, fs * 0.3, 0, 0, Math.PI * 2);
            g.fill();
            g.strokeStyle = pal.spine;
            g.lineWidth = 1.5;
            g.beginPath();
            g.moveTo(0, -fs * 0.3);
            g.lineTo(0, fs * 0.34);
            g.stroke();
            g.restore();
        };
    }

    function paintOrb(pal) {
        return function(g, fs, face, phase) {
            var pulse = 1 + Math.sin(phase * Math.PI * 2) * 0.18;
            g.fillStyle = pal.glow;
            g.beginPath();
            g.arc(fs / 2, fs / 2, fs * 0.2 * pulse, 0, Math.PI * 2);
            g.fill();
            g.fillStyle = pal.body;
            g.beginPath();
            g.arc(fs / 2, fs / 2, fs * 0.11 * pulse, 0, Math.PI * 2);
            g.fill();
        };
    }

    function paintGem(pal) {
        return function(g, fs, face, phase) {
            var f = Math.floor(phase * 4);
            shadow(g, fs, 0.12);
            var cy = fs * 0.55 + Math.sin(phase * Math.PI * 2) * fs * 0.03;
            g.fillStyle = pal.body;
            g.beginPath();
            g.moveTo(fs / 2, cy - fs * 0.22);
            g.lineTo(fs / 2 + fs * 0.15, cy);
            g.lineTo(fs / 2, cy + fs * 0.22);
            g.lineTo(fs / 2 - fs * 0.15, cy);
            g.closePath();
            g.fill();
            g.strokeStyle = pal.edge;
            g.lineWidth = 1;
            g.stroke();
            if (f === 1) {  /* sparkle frame */
                g.strokeStyle = pal.sparkle;
                g.beginPath();
                g.moveTo(fs / 2 - fs * 0.24, cy - fs * 0.2);
                g.lineTo(fs / 2 - fs * 0.16, cy - fs * 0.12);
                g.moveTo(fs / 2 - 0.2 * fs, cy - fs * 0.2);
                g.lineTo(fs / 2 - 0.2 * fs, cy - fs * 0.11);
                g.stroke();
            }
        };
    }

    function paintHeart(pal) {
        return function(g, fs, face, phase) {
            var pulse = 1 + Math.sin(phase * Math.PI * 2) * 0.12;
            shadow(g, fs, 0.12);
            var cy = fs * 0.5;
            var s = fs * 0.2 * pulse;
            g.fillStyle = pal.body;
            g.beginPath();
            g.moveTo(fs / 2, cy + s);
            g.bezierCurveTo(fs / 2 - s * 1.4, cy, fs / 2 - s * 0.8, cy - s * 1.1,
                            fs / 2, cy - s * 0.35);
            g.bezierCurveTo(fs / 2 + s * 0.8, cy - s * 1.1, fs / 2 + s * 1.4, cy,
                            fs / 2, cy + s);
            g.fill();
        };
    }

    /* â”€â”€ Kind registry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    /* def name, on-screen size in world units (presentation-only). */
    var KIND_INFO = {
        1:  { name: 'eagle',    size: 1.0 },
        2:  { name: 'frog',     size: 1.0 },
        3:  { name: 'slime',    size: 0.7 },
        4:  { name: 'wolf',     size: 0.85 },
        5:  { name: 'golem',    size: 1.15 },
        6:  { name: 'wisp',     size: 0.75 },
        7:  { name: 'cube',     size: 1.1 },
        8:  { name: 'shuriken', size: 0.4 },
        9:  { name: 'feather',  size: 0.4 },
        10: { name: 'wispShot', size: 0.35 },
        11: { name: 'gem',      size: 0.45 },
        12: { name: 'heart',    size: 0.5 },
    };

    /* â”€â”€ Real art (extract-art.py manifests + packed sheet PNGs) â”€â”€â”€â”€â”€â”€ */

    function buildReal() {
        var version = SashimiArtData.version;
        var defs = {};
        var byKind = {};
        Object.keys(SashimiArtData.units).forEach(function(name) {
            var u = SashimiArtData.units[name];
            var img = new Image();
            /* content-hash version busts GitHub Pages caching (root
               CLAUDE.md decision 22); rt-sprites draws nothing until the
               sheet is decoded, so art pops in as it loads */
            img.src = u.sheet + '?v=' + version;
            defs[name] = {
                sheet: img,
                frameW: u.frameW, frameH: u.frameH,
                anchorX: u.anchorX, anchorY: u.anchorY,
                rotate: u.rotate,
                table: u.table,
            };
            byKind[u.kind] = { name: name, unit: u };
        });

        return {
            real: true,
            defs: defs,
            defName: function(kind) {
                var k = byKind[kind];
                return k ? k.name : 'slime';
            },
            /* on-screen height in world units == Unity sprite height
               (frame px / PPU) */
            size: function(kind) {
                var k = byKind[kind];
                return k ? k.unit.worldH : 0.7;
            },
            /* health-bar geometry from the idle art's visual bounds (the
               frame cell is padded by defeat/attack FX frames) */
            barFor: function(kind, tilePx) {
                var k = byKind[kind];
                if (!k) return null;
                var w = Math.max(12, Math.min(60, k.unit.uiW * tilePx * 0.9));
                return { dy: k.unit.uiTop * tilePx + 6, w: w };
            },
            /* seconds a play-once state runs (0 = looping/absent) */
            stateDuration: function(kind, state) {
                var k = byKind[kind];
                if (!k) return 0;
                var a = RTSprites.resolve(k.unit.table, state + '_SE');
                if (!a) a = RTSprites.resolve(k.unit.table, state + '_S');
                return (a && a.once) ? a.frames / a.fps : 0;
            },
        };
    }

    /* â”€â”€ Procedural placeholder art (fallback path) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    function buildProcedural() {
        var FS = 32;
        var defs = {
            eagle: RTSprites.makePlaceholderUnit({
                frameSize: FS,
                body: '#e8e4d8', head: '#f0d890', nose: '#c87820',
                legs: '#907840', outline: '#403010',
            }),
            frog: RTSprites.makePlaceholderUnit({
                frameSize: FS,
                body: '#48a838', head: '#88d060', nose: '#184818',
                legs: '#286020', outline: '#103008',
            }),
            slime: makeSimpleUnit(FS, 4, 6, 0.85, paintSlime({
                body: '#e08828', outline: '#804810', eye: '#301800' })),
            wolf: makeDirectionalUnit(FS, 0.85, paintWolf({
                body: '#8890a0', legs: '#585c68', nose: '#282830',
                outline: '#303440' })),
            golem: makeDirectionalUnit(FS, 0.85, paintGolem({
                body: '#8a7860', outline: '#403828', crack: '#584c3c',
                eye: '#ffb020' })),
            wisp: makeSimpleUnit(FS, 4, 6, 0.8, paintWisp({
                body: '#70e8d8', glow: 'rgba(80,220,200,0.3)' })),
            cube: makeDirectionalUnit(FS, 0.85, paintCube({
                body: '#28a098', inner: '#40c8c0', outline: '#105850',
                eye: '#083430' })),
            shuriken: makeSimpleUnit(FS, 4, 12, 0.5, paintShuriken({
                body: '#c8ccd8', core: '#606878' })),
            feather: makeSimpleUnit(FS, 4, 8, 0.5, paintFeather({
                body: '#f0f0e8', spine: '#a8a8a0' })),
            wispShot: makeSimpleUnit(FS, 4, 8, 0.5, paintOrb({
                body: '#a0f0e0', glow: 'rgba(80,220,200,0.4)' })),
            gem: makeSimpleUnit(FS, 4, 4, 0.7, paintGem({
                body: '#4890f0', edge: '#1848a0', sparkle: '#d0e8ff' })),
            heart: makeSimpleUnit(FS, 4, 4, 0.7, paintHeart({
                body: '#e03848' })),
        };

        return {
            real: false,
            defs: defs,
            defName: function(kind) {
                var k = KIND_INFO[kind];
                return k ? k.name : 'slime';
            },
            size: function(kind) {
                var k = KIND_INFO[kind];
                return k ? k.size : 0.7;
            },
            barFor: function() { return null; },       /* default geometry */
            stateDuration: function() { return 0; },   /* nothing blocks */
        };
    }

    function build() {
        var wantProc = typeof location !== 'undefined' &&
            /[?&]art=proc\b/.test(location.search);
        if (wantProc || typeof SashimiArtData === 'undefined') {
            return buildProcedural();
        }
        return buildReal();
    }

    return { build: build };
})();
#!/usr/bin/env python3
"""Extract the real sashimi sprite art into rt-sprites manifests.

Reads the Unity project (READ-ONLY) at --sashimi-root and emits, per
renderable kind (wasm_main.c SW_KIND_*):

  - a packed sprite-sheet PNG        -> clients/wasm/assets/<name>.png
  - an rt-sprites animation manifest -> clients/lib/sashimi-art-data.js
    (generated JS: `var SashimiArtData = {...}`; consumed by
    sashimi-sprites.js, loaded by clients/wasm/index.html)

Sources, mirroring the Unity presentation pipeline:

  UnitAnimationDataSO (*_UASO.asset)      state rows: Name ("WalkSE"),
                                          AnimationClip guid, FallbackName,
                                          FallbackInverse (mirror)
  AnimationClip (.anim, text YAML)        m_PPtrCurves sprite keyframes
                                          (time, sprite fileID, texture guid),
                                          m_SampleRate, StopTime, LoopTime
  Texture .meta (text YAML)               spriteSheet slicing: per-sprite rect
                                          (y-up), pivot/alignment, and
                                          spritePixelsToUnits (PPU)
  Projectile / pickup prefab variants     StaticSprite {fileID, guid} refs
                                          (traced by hand, pinned below by
                                          guid + expected basename)

Packing: every frame of a unit is pasted pivot-aligned into a fixed cell
(the pivot of each source sprite lands on the same cell-relative anchor
point), then the cell is cropped to the union alpha bbox across all frames
(+1px pad) so on-screen size ~= visual size. World size = cell px / PPU,
so entity sprites scale exactly as Unity renders them (SpriteRenderer at
identity transform in the *_Presentation prefabs).

Direction model: the Unity art is authored for the four isometric
diagonals only (SE authored, SW = SE mirrored, NE/NW back rows falling
back per the UASO). The client speaks 8 octants; cardinals are mapped
E->SE, S->SE, W->SW, N->NE (fallback rows in the manifest, no mirror).
Non-directional states (Defeat, Spawn, Respawn) are authored once as
<state>_S with all other dirs falling back.

Deps (not in the system python):

  python3 -m venv .venv && .venv/bin/pip install pyyaml pillow
  .venv/bin/python sandboxes/sashimi/clients/tools/extract-art.py

Run from anywhere; paths are resolved relative to this file.
"""

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

try:
    import yaml
    from PIL import Image
except ImportError as e:  # pragma: no cover
    sys.exit(
        f"missing dependency ({e.name}). Create a venv first:\n"
        "  python3 -m venv .venv && .venv/bin/pip install pyyaml pillow\n"
        "  .venv/bin/python " + __file__
    )

TOOLS_DIR = Path(__file__).resolve().parent
CLIENTS_DIR = TOOLS_DIR.parent
DEFAULT_SASHIMI = Path.home() / "Dev" / "sashimi"

# Client octants (rt-sprites DIRS) and the Unity-diagonal mapping for the
# four cardinals the art never authors.
DIRS = ["E", "NE", "N", "NW", "W", "SW", "S", "SE"]
CARDINAL_TO_DIAGONAL = {"E": "SE", "S": "SE", "W": "SW", "N": "NE"}

# SpriteAlignment -> normalized pivot (x right, y up â€” Unity texture space)
ALIGNMENT_PIVOT = {
    0: (0.5, 0.5), 1: (0.0, 1.0), 2: (0.5, 1.0), 3: (1.0, 1.0),
    4: (0.0, 0.5), 5: (1.0, 0.5), 6: (0.0, 0.0), 7: (0.5, 0.0),
    8: (1.0, 0.0),  # 9 = Custom -> use the sprite's own pivot field
}

# kind -> source spec. Kinds mirror wasm_main.c SW_KIND_* and
# sashimi-sprites.js KIND_INFO. Provenance of the static-sprite guids:
#   shuriken  Shuriken_Projectile.prefab   EntityName SpritePoisonShuriken
#   feather   Feather_Projectile.prefab    EntityName Spritefeatherprojectile
#   wispShot  CreatureWisp_Projectile.prefab  sprite ProjectileCollisionEffect_0
#   gem/heart GemPickup.prefab / HeartPIckup.prefab StaticSprite refs
# Projectiles are spawned facing their travel direction
# (ProjectileLifecycleSystem.cs: AngleAxis(atan2(dir)) around forward), so
# they carry rotate: true; the client rotates them by the unit dir vector.
UNITS = {
    1: {"name": "eagle", "uaso": "Assets/Heroes/Eagle/HeroEagle_UASO.asset"},
    2: {"name": "frog", "uaso": "Assets/Heroes/Frog/HeroFrog_UASO.asset"},
    3: {"name": "slime",
        "uaso": "Assets/Creatures/SlimeOrange/CreatureSlimeOrange_UASO.asset"},
    4: {"name": "wolf", "uaso": "Assets/Creatures/Wolf/CreatureWolf_UASO.asset"},
    5: {"name": "golem",
        "uaso": "Assets/Creatures/RockGolem/CreatureRockGolem_UASO.asset"},
    6: {"name": "wisp", "uaso": "Assets/Creatures/Wisp/CreatureWisp_UASO.asset"},
    7: {"name": "cube",
        "uaso": "Assets/Creatures/LargeTealCube/LargeTealCube_UASO.asset"},
    8: {"name": "shuriken", "rotate": True,
        "static": {"guid": "9e4e6c59157ddc8419fc2a365f2a01e4",
                   "basename": "PoisonShuriken.png"}},
    9: {"name": "feather", "rotate": True,
        "static": {"guid": "b07feb3073ef0134fad148821efec27e",
                   "basename": "featherprojectile.png"}},
    10: {"name": "wispShot", "rotate": True,
         "static": {"guid": "7887ce7271252a544a7c2a3a89c94102",
                    "basename": "ProjectileCollisionEffect.png",
                    "sprite": "ProjectileCollisionEffect_0"}},
    11: {"name": "gem",
         "static": {"guid": "c370bc500b0d1bc44b8227b5085207a3",
                    "basename": "GemPickup.png"}},
    12: {"name": "heart",
         "static": {"guid": "1ddd93446f1df3047af05fb49de7229f",
                    "basename": "HeartPickup.png"}},
}


# â”€â”€ Unity YAML helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

TAG_RE = re.compile(r"^--- !u!\d+ &\d+.*$", re.M)


def load_unity_yaml(path):
    """Parse a Unity text-serialized asset; returns list of documents."""
    text = path.read_text(errors="replace")
    text = re.sub(r"^%.*$", "", text, flags=re.M)
    text = TAG_RE.sub("---", text)
    return [d for d in yaml.safe_load_all(text) if d is not None]


def build_guid_index(root):
    """guid -> asset path (from .meta files under Assets/)."""
    index = {}
    guid_re = re.compile(r"^guid: ([0-9a-f]{32})", re.M)
    for meta in (root / "Assets").rglob("*.meta"):
        try:
            head = meta.read_text(errors="replace")[:400]
        except OSError:
            continue
        m = guid_re.search(head)
        if m:
            index[m.group(1)] = meta.with_suffix("")
    return index


class TextureCache:
    """Loads texture .meta slicing + pixels once per texture guid."""

    def __init__(self, root, guid_index):
        self.root = root
        self.guid_index = guid_index
        self._cache = {}

    def get(self, guid):
        if guid in self._cache:
            return self._cache[guid]
        path = self.guid_index.get(guid)
        if path is None or not path.exists():
            sys.exit(f"texture guid {guid} not found in Assets/")
        meta = yaml.safe_load((path.parent / (path.name + ".meta")).read_text())
        imp = meta["TextureImporter"]
        ppu = float(imp["spritePixelsToUnits"])
        image = Image.open(path).convert("RGBA")
        sprites = {}  # fileID -> {name, rect(x,y,w,h y-up), pivot(nx,ny y-up)}
        if int(imp.get("spriteMode", 1)) == 1:
            # single-sprite texture: whole image, fileID 21300000
            pivot = self._pivot(int(imp.get("alignment", 0)),
                                imp.get("spritePivot"))
            sprites[21300000] = {
                "name": path.stem,
                "rect": (0, 0, image.width, image.height),
                "pivot": pivot,
            }
        else:
            for s in imp["spriteSheet"]["sprites"]:
                r = s["rect"]
                pivot = self._pivot(int(s.get("alignment", 0)), s.get("pivot"))
                sprites[int(s["internalID"])] = {
                    "name": s["name"],
                    "rect": (int(r["x"]), int(r["y"]),
                             int(r["width"]), int(r["height"])),
                    "pivot": pivot,
                }
        entry = {"path": path, "ppu": ppu, "image": image, "sprites": sprites}
        self._cache[guid] = entry
        return entry

    @staticmethod
    def _pivot(alignment, custom):
        if alignment == 9:
            return (float(custom["x"]), float(custom["y"]))
        return ALIGNMENT_PIVOT[alignment]

    def frame(self, guid, file_id):
        """-> (PIL image cropped to the sprite rect, pivot px from
        top-left of that crop (x right, y down), ppu, sprite name)."""
        tex = self.get(guid)
        spr = tex["sprites"].get(file_id)
        if spr is None:
            sys.exit(f"sprite fileID {file_id} not in {tex['path'].name}")
        x, y_up, w, h = spr["rect"]
        img_h = tex["image"].height
        top = img_h - (y_up + h)  # Unity rects are y-up from bottom-left
        crop = tex["image"].crop((x, top, x + w, top + h))
        px, py_up = spr["pivot"]
        pivot_px = (px * w, h - py_up * h)  # -> y-down from crop top
        return crop, pivot_px, tex["ppu"], spr["name"]


# â”€â”€ State naming â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

STATE_RE = re.compile(r"^(.*?)(NE|NW|SE|SW)$")


def state_key(unity_name):
    """'WalkSE' -> 'walk_SE'; 'Defeat' -> 'defeat_S' (non-directional)."""
    m = STATE_RE.match(unity_name)
    if m:
        return f"{m.group(1).lower()}_{m.group(2)}"
    return f"{unity_name.lower()}_S"


def clip_frames(clip_doc):
    """-> (list[(fileID, guid)], fps, loop) from an AnimationClip doc."""
    clip = clip_doc["AnimationClip"]
    curves = clip.get("m_PPtrCurves") or []
    sprite_curves = [c for c in curves if c.get("attribute") == "m_Sprite"]
    if len(sprite_curves) != 1:
        sys.exit(f"clip {clip.get('m_Name')}: expected 1 sprite curve, "
                 f"got {len(sprite_curves)}")
    keys = sprite_curves[0]["curve"]
    frames, times = [], []
    for k in keys:
        v = k["value"]
        frames.append((int(v["fileID"]), v["guid"]))
        times.append(float(k["time"]))
    settings = clip["m_AnimationClipSettings"]
    stop = float(settings["m_StopTime"])
    loop = bool(int(settings.get("m_LoopTime", 0)))
    if len(frames) > 1:
        # verify uniform spacing (rt-sprites rows are constant-fps)
        deltas = [times[i + 1] - times[i] for i in range(len(times) - 1)]
        if max(deltas) - min(deltas) > 1e-3:
            print(f"  WARNING: non-uniform keys in {clip.get('m_Name')}; "
                  f"averaging (deltas {deltas})")
    fps = (len(frames) / stop) if stop > 0 else 1.0
    return frames, round(fps, 4), loop


# â”€â”€ Packing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def pack_unit(name, rows, out_png):
    """rows: list of {key, frames: [(img, pivot_px)], fps, once}.
    Pastes pivot-aligned, crops to union alpha bbox, writes the sheet.
    -> manifest dict (sans table fallbacks)."""
    # cell extents around the shared pivot anchor
    left = right = up = down = 1.0
    for row in rows:
        for img, (px, py) in row["frames"]:
            left = max(left, px)
            right = max(right, img.width - px)
            up = max(up, py)
            down = max(down, img.height - py)
    cell_w, cell_h = int(-(-left // 1) + -(-right // 1)), None
    import math
    left, right = math.ceil(left), math.ceil(right)
    up, down = math.ceil(up), math.ceil(down)
    cell_w, cell_h = left + right, up + down

    # paste all frames into a working sheet
    max_frames = max(len(r["frames"]) for r in rows)
    sheet = Image.new("RGBA", (cell_w * max_frames, cell_h * len(rows)),
                      (0, 0, 0, 0))
    for ri, row in enumerate(rows):
        for fi, (img, (px, py)) in enumerate(row["frames"]):
            ox = fi * cell_w + left - round(px)
            oy = ri * cell_h + up - round(py)
            sheet.paste(img, (ox, oy))

    # union alpha bbox per cell position (same crop for every cell so rows
    # stay a regular grid), padded 1px, pivot kept inside
    union = None
    for ri, row in enumerate(rows):
        for fi in range(len(row["frames"])):
            cell = sheet.crop((fi * cell_w, ri * cell_h,
                               (fi + 1) * cell_w, (ri + 1) * cell_h))
            bb = cell.getbbox()
            if bb is None:
                continue
            union = bb if union is None else (
                min(union[0], bb[0]), min(union[1], bb[1]),
                max(union[2], bb[2]), max(union[3], bb[3]))
    if union is None:
        sys.exit(f"{name}: all frames empty")
    x0 = max(0, min(union[0] - 1, left))
    y0 = max(0, min(union[1] - 1, up))
    x1 = min(cell_w, max(union[2] + 1, left))
    y1 = min(cell_h, max(union[3] + 1, up))
    fw, fh = x1 - x0, y1 - y0

    packed = Image.new("RGBA", (fw * max_frames, fh * len(rows)), (0, 0, 0, 0))
    for ri in range(len(rows)):
        for fi in range(max_frames):
            cell = sheet.crop((fi * cell_w + x0, ri * cell_h + y0,
                               fi * cell_w + x1, ri * cell_h + y1))
            packed.paste(cell, (fi * fw, ri * fh))
    out_png.parent.mkdir(parents=True, exist_ok=True)
    packed.save(out_png, optimize=True)

    return {
        "frameW": fw, "frameH": fh,
        "anchorX": round((left - x0) / fw, 4),
        "anchorY": round((up - y0) / fh, 4),
    }


def ui_metrics(rows, ppu):
    """Visual bounds of the *idle* frames relative to the pivot, in world
    units. The packed cell can be much larger than the resting sprite
    (defeat poofs, attack sweeps share the cell), so health bars / labels
    anchor to these instead of the cell size:
      uiTop â€” distance from pivot up to the idle art's top edge
      uiW   â€” idle art width
    """
    idle = [r for r in rows if r["key"].startswith("idle_")] or rows[:1]
    top = w_min = w_max = None
    for row in idle:
        for img, (px, py) in row["frames"]:
            bb = img.getbbox()
            if bb is None:
                continue
            t = py - bb[1]
            top = t if top is None else max(top, t)
            lo, hi = bb[0] - px, bb[2] - px
            w_min = lo if w_min is None else min(w_min, lo)
            w_max = hi if w_max is None else max(w_max, hi)
    if top is None:
        return {"uiTop": 0.5, "uiW": 0.5}
    return {"uiTop": round(top / ppu, 4),
            "uiW": round((w_max - w_min) / ppu, 4)}


# â”€â”€ Table assembly â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def resolve_chain(table, key, guard=10):
    """Python mirror of RTSprites.resolve â€” sanity check only."""
    mirror = False
    for _ in range(guard):
        e = table.get(key)
        if e is None:
            return None
        if e.get("mirror"):
            mirror = not mirror
        if "row" in e:
            return {"row": e["row"], "mirror": mirror}
        key = e["fallback"]
    return None


def expand_dirs(table):
    """Add cardinal->diagonal fallbacks for every state in the table."""
    states = {k.rsplit("_", 1)[0] for k in table}
    for state in sorted(states):
        # non-directional authored as _S: everything falls back to it
        if f"{state}_S" in table and f"{state}_SE" not in table:
            for d in DIRS:
                key = f"{state}_{d}"
                if key not in table:
                    table[key] = {"fallback": f"{state}_S"}
            continue
        for card, diag in CARDINAL_TO_DIAGONAL.items():
            key, target = f"{state}_{card}", f"{state}_{diag}"
            if key not in table and target in table:
                table[key] = {"fallback": target}
    return table


def extract_animated(root, tex_cache, spec, assets_dir):
    docs = load_unity_yaml(root / spec["uaso"])
    mono = docs[0]["MonoBehaviour"]
    rows_info = mono["animationDataInfo"]

    guid_index = tex_cache.guid_index
    authored, fallbacks = [], {}
    ppu = None
    for row in rows_info:
        key = state_key(row["Name"])
        clip_ref = row.get("AnimationClip") or {}
        guid = clip_ref.get("guid")
        if guid and guid_index.get(guid) is None:
            # dangling reference in the Unity project itself (e.g. the
            # LargeTealCube AttackSE clip was deleted); treat as authored-
            # missing and use the row's fallback chain
            print(f"  WARNING: {spec['name']} {row['Name']}: clip guid "
                  f"{guid} dangling in Unity project; using fallback "
                  f"'{row.get('FallbackName')}'")
            guid = None
        if guid:
            clip_path = guid_index.get(guid)
            frames_ref, fps, loop = clip_frames(load_unity_yaml(clip_path)[0])
            frames = []
            for file_id, tex_guid in frames_ref:
                img, pivot, f_ppu, _ = tex_cache.frame(tex_guid, file_id)
                if ppu is None:
                    ppu = f_ppu
                elif f_ppu != ppu:
                    sys.exit(f"{spec['name']}: mixed PPU {ppu} vs {f_ppu}")
                frames.append((img, pivot))
            authored.append({"key": key, "frames": frames, "fps": fps,
                             "once": not loop})
        else:
            fb = row.get("FallbackName") or ""
            if fb:
                fallbacks[key] = {"fallback": state_key(fb),
                                  "mirror": bool(int(row.get("FallbackInverse", 0)))}

    out_png = assets_dir / f"{spec['name']}.png"
    manifest = pack_unit(spec["name"], authored, out_png)
    table = {}
    for i, row in enumerate(authored):
        entry = {"row": i, "frames": len(row["frames"]), "fps": row["fps"]}
        if row["once"]:
            entry["once"] = True
        table[row["key"]] = entry
    for key, entry in fallbacks.items():
        e = {"fallback": entry["fallback"]}
        if entry["mirror"]:
            e["mirror"] = True
        table[key] = e
    expand_dirs(table)
    manifest["table"] = table
    manifest["ppu"] = ppu
    manifest.update(ui_metrics(authored, ppu))
    return manifest


def extract_static(root, tex_cache, spec, assets_dir):
    st = spec["static"]
    tex = tex_cache.get(st["guid"])
    if tex["path"].name != st["basename"]:
        sys.exit(f"{spec['name']}: guid resolves to {tex['path'].name}, "
                 f"expected {st['basename']}")
    if "sprite" in st:
        file_id = next((fid for fid, s in tex["sprites"].items()
                        if s["name"] == st["sprite"]), None)
        if file_id is None:
            sys.exit(f"{spec['name']}: sprite {st['sprite']} not found")
    else:
        file_id = next(iter(tex["sprites"]))
    img, pivot, ppu, _ = tex_cache.frame(st["guid"], file_id)
    out_png = assets_dir / f"{spec['name']}.png"
    manifest = pack_unit(spec["name"],
                         [{"key": "idle_S", "frames": [(img, pivot)],
                           "fps": 1, "once": False}], out_png)
    table = {"idle_S": {"row": 0, "frames": 1, "fps": 1}}
    # everything (idle/walk any dir) falls back to the single sprite
    for state in ("idle", "walk"):
        for d in DIRS:
            key = f"{state}_{d}"
            if key not in table:
                table[key] = {"fallback": "idle_S"}
    manifest["table"] = table
    manifest["ppu"] = ppu
    manifest.update(ui_metrics(
        [{"key": "idle_S", "frames": [(img, pivot)]}], ppu))
    return manifest


# â”€â”€ Golden checks (extraction drift fails loudly, generator pattern) â”€â”€â”€â”€

def golden_checks(units):
    wolf = units["wolf"]
    walk = wolf["table"]["walk_SE"]
    assert walk["frames"] == 4 and abs(walk["fps"] - 12.0) < 0.1, walk
    assert wolf["ppu"] == 16, wolf["ppu"]
    assert wolf["table"]["walk_SW"] == {"fallback": "walk_SE", "mirror": True}
    assert wolf["table"]["defeat_S"].get("once") is True
    for uname in ("eagle", "frog", "slime", "wolf", "golem", "wisp", "cube"):
        table = units[uname]["table"]
        for state in ("idle", "walk", "damage", "defeat"):
            for d in DIRS:
                assert resolve_chain(table, f"{state}_{d}") is not None, \
                    f"{uname}: {state}_{d} unresolved"
    for uname in ("shuriken", "feather", "wispShot", "gem", "heart"):
        assert resolve_chain(units[uname]["table"], "idle_S") is not None
    # Unity world sizes: 32px cells at PPU 16 -> heroes/creatures ~<=2 wu
    assert 0.2 < units["wolf"]["worldH"] <= 2.0
    assert 0.1 < units["shuriken"]["worldW"] < 0.5   # 164px @ PPU 512
    assert abs(units["gem"]["worldH"] - 75 / 200) < 0.01


# â”€â”€ Main â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--sashimi-root", type=Path, default=DEFAULT_SASHIMI)
    ap.add_argument("--assets-dir", type=Path,
                    default=CLIENTS_DIR / "wasm" / "assets")
    ap.add_argument("--manifest", type=Path,
                    default=CLIENTS_DIR / "lib" / "sashimi-art-data.js")
    args = ap.parse_args()

    root = args.sashimi_root
    if not (root / "Assets").is_dir():
        sys.exit(f"not a Unity project: {root}")

    print(f"indexing guids under {root}/Assets ...")
    guid_index = build_guid_index(root)
    tex_cache = TextureCache(root, guid_index)

    units = {}
    for kind in sorted(UNITS):
        spec = UNITS[kind]
        print(f"kind {kind:2d} {spec['name']}")
        if "uaso" in spec:
            m = extract_animated(root, tex_cache, spec, args.assets_dir)
        else:
            m = extract_static(root, tex_cache, spec, args.assets_dir)
        m["kind"] = kind
        m["rotate"] = bool(spec.get("rotate"))
        m["sheet"] = f"assets/{spec['name']}.png"
        m["worldW"] = round(m["frameW"] / m["ppu"], 4)
        m["worldH"] = round(m["frameH"] / m["ppu"], 4)
        units[spec["name"]] = m

    golden_checks(units)

    # content hash -> cache-busting version for the sheet URLs
    h = hashlib.sha1()
    h.update(json.dumps(units, sort_keys=True).encode())
    for spec in UNITS.values():
        h.update((args.assets_dir / f"{spec['name']}.png").read_bytes())
    version = h.hexdigest()[:10]

    js = (
        "/* GENERATED by clients/tools/extract-art.py â€” do not edit.\n"
        " * Real sashimi art: packed sheets (clients/wasm/assets/*.png) +\n"
        " * rt-sprites animation tables extracted from the Unity project's\n"
        " * UnitAnimationDataSO / .anim / texture-meta slicing data.\n"
        " * Regenerate: see the extractor's module docstring. */\n"
        "var SashimiArtData = " + json.dumps(
            {"version": version, "units": units},
            indent=2, sort_keys=True) + ";\n"
        "if (typeof module !== 'undefined') module.exports = SashimiArtData;\n"
    )
    args.manifest.write_text(js)
    print(f"wrote {args.manifest}")
    print(f"assets in {args.assets_dir}  (version {version})")
    for name, m in sorted(units.items(), key=lambda kv: kv[1]["kind"]):
        rows = sum(1 for e in m["table"].values() if "row" in e)
        print(f"  {m['kind']:2d} {name:9s} cell {m['frameW']}x{m['frameH']}px "
              f"world {m['worldW']}x{m['worldH']}  rows {rows}  ppu {m['ppu']}")


if __name__ == "__main__":
    main()
