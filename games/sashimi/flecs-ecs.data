 €HDç%ÎÊ=?tÐÝ;d'ëZîu³]	ÔÌ@Èq8–¿œ[«uûuOR␀„jN␀␀␀␀␀␀␀␀␀␀␀␀éé¾Þ{_= ?g­º³e’ ±␀ñ†1ÊÎ[ÕÆì½JšÎÙ@ä	¢YÙ¹±ºÓ{ï1f×YDeå␀$L±Ö…[ƒ4•juçß>H‘ ÌnS
2™`2ÍsI×±)û"J£,“Ašnªìïý¾	"tY9€6­-›íkçÖªo"³r®ü"9␀ý£O¯ð¨scI9P§)]È$€ä@r␀žbbq‡Š␀␀ý{µÁµ9Uæ␀␀␀␀IEND®B`‚<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>sashimi â€” survival action (60Hz WASM)</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body {
    height: 100%; overflow: hidden; background: #10101c;
    touch-action: none; overscroll-behavior: none;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
}
canvas { display: block; touch-action: none; }
#hud {
    position: fixed; z-index: 5;
    top: calc(env(safe-area-inset-top, 0px) + 8px);
    left: calc(env(safe-area-inset-left, 0px) + 8px);
    background: rgba(10, 10, 25, 0.78); border: 1px solid #333;
    border-radius: 6px; padding: 8px 12px;
    color: #9fe8a0; font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace;
    font-size: 12px; line-height: 1.5; white-space: pre;
}
#banner {
    position: fixed; left: 50%; transform: translateX(-50%);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
    z-index: 5; color: #ccc; font-family: monospace; font-size: 13px;
    background: rgba(10, 10, 25, 0.78); border: 1px solid #333;
    border-radius: 6px; padding: 6px 14px; white-space: pre;
    max-width: 94vw;
}
#pausebtn {
    position: fixed; z-index: 6;
    top: calc(env(safe-area-inset-top, 0px) + 8px);
    right: calc(env(safe-area-inset-right, 0px) + 8px);
    width: 44px; height: 44px;
    background: rgba(10, 10, 25, 0.78); border: 1px solid #444;
    border-radius: 8px; color: #9fe8a0;
    font: 16px monospace; cursor: pointer;
}
#pausebtn:active { background: rgba(40, 40, 70, 0.9); }
#mutebtn {
    position: fixed; z-index: 6;
    top: calc(env(safe-area-inset-top, 0px) + 60px);
    right: calc(env(safe-area-inset-right, 0px) + 8px);
    width: 44px; height: 44px;
    background: rgba(10, 10, 25, 0.78); border: 1px solid #444;
    border-radius: 8px; color: #9fe8a0;
    font: 16px monospace; cursor: pointer;
}
#mutebtn:active { background: rgba(40, 40, 70, 0.9); }
#volume {
    position: fixed; z-index: 6;
    top: calc(env(safe-area-inset-top, 0px) + 112px);
    right: calc(env(safe-area-inset-right, 0px) + 8px);
    width: 44px; height: 96px;
    writing-mode: vertical-lr; direction: rtl;
    accent-color: #9fe8a0;
}
#version { position: fixed; bottom: 2px; right: 6px; color: #444; font: 10px monospace; z-index: 5; }

/* â”€â”€ UI screens (SashimiScreens: title / hero select / results) â”€â”€
   Layout and type transcribed from the Unity UI documents:
   Assets/UI/*.uxml + GlobalUIStyle.uss over the shipped 1920x1080
   StaticScreens art (extracted by clients/tools/extract-ui.py).
   Each screen letterboxes the art on the art's own backdrop cyan
   (.fullscreen: background-size contain, centered); children position
   in percentages of the 16:9 stage. --su = 1% of stage width, so
   calc(var(--su) * N) == N/19.2 px of the 1920px Unity design. */
@font-face {
    font-family: 'Kenvector Future';   /* .uss .menu-button font */
    src: url('assets/fonts/kenvector_future.ttf?v=7') format('truetype');
}
@font-face {
    font-family: 'Boogaloo';           /* .uss victory/leaderboard font */
    src: url('assets/fonts/boogaloo.ttf?v=7') format('truetype');
}
#screens { position: fixed; inset: 0; z-index: 5; display: none; }
.screen {
    position: absolute; inset: 0; display: none;
    background: #6fe5ff;               /* the art's backdrop cyan */
    align-items: center; justify-content: center;
}
.screen.active { display: flex; }
.stage {
    position: relative; aspect-ratio: 16 / 9;
    width: min(100vw, 177.78vh);
    background-size: 100% 100%; background-repeat: no-repeat;
    --su: min(1vw, 1.7778vh);
}
/* GlobalUIStyle.uss .menu-button: kenvector, 40px @1920, focus = bold;
   chrome follows the art's card language (light fill, blue border). */
.menu-group {
    position: absolute; left: 3%; top: 4%;
    display: flex; flex-direction: column; align-items: flex-start;
    gap: calc(var(--su) * 1.2);
}
.menu-button {
    font-family: 'Kenvector Future', monospace;
    font-size: max(15px, calc(var(--su) * 2.08));
    color: #696969;                    /* uss --color-text-dark */
    background: #eee;                  /* the art's card fill */
    border: max(2px, calc(var(--su) * 0.16)) solid #1e90ff; /* --color-primary */
    border-radius: calc(var(--su) * 0.6);
    padding: calc(var(--su) * 0.5) calc(var(--su) * 1.4);
    min-height: 44px; cursor: pointer;
}
.menu-button.focused, .menu-button:hover {
    font-weight: bold; border-color: #00bfff; background: #fff;
}
.menu-button:disabled { opacity: 0.45; cursor: default; }
/* Hero select: transparent hotspots aligned to the art's baked cards */
.hero-card {
    position: absolute; background: transparent; border: none;
    border-radius: calc(var(--su) * 1.2); cursor: pointer;
}
.hero-card.focused {
    box-shadow: 0 0 0 max(3px, calc(var(--su) * 0.3)) #ff1497,
                0 0 calc(var(--su) * 1.5) rgba(255, 20, 151, 0.6);
}
.pick-badge {
    position: absolute; top: calc(var(--su) * -1.1);
    right: calc(var(--su) * -0.7);
    background: #ff1497; color: #fff;  /* the art's title pink */
    font-family: 'Boogaloo', sans-serif;
    font-size: max(13px, calc(var(--su) * 1.56));
    padding: calc(var(--su) * 0.15) calc(var(--su) * 0.8);
    border-radius: calc(var(--su) * 0.6); display: none;
}
.pick-status {
    position: absolute; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: calc(var(--su) * 0.5);
    font-family: 'Boogaloo', sans-serif; color: #696969;
    text-align: center;
}
.pick-line { font-size: max(12px, calc(var(--su) * 1.35)); }
.pick-hint {
    font-size: max(11px, calc(var(--su) * 1.05));
    color: #a9a9a9;                    /* uss --color-text-medium */
}
.pick-reset {
    background: none; border: none; cursor: pointer;
    color: #1e90ff; text-decoration: underline;
    font-family: 'Boogaloo', sans-serif;
    font-size: max(11px, calc(var(--su) * 1.05));
}
.start-button { position: absolute; left: 50%; top: 62%;
                transform: translateX(-50%); }
/* Results: VictoryVT score line (.uss score-title-group at 756,510;
   victory-title 50px dimgray, bold value dodgerblue) */
.victory-score { position: absolute; left: 39.38%; top: 47.22%;
                 white-space: nowrap; }
.victory-title {
    font-family: 'Boogaloo', sans-serif;
    font-size: calc(var(--su) * 2.6); color: #696969;
}
.victory-title-bold {
    font-family: 'Boogaloo', sans-serif;
    font-size: calc(var(--su) * 2.6); color: #1e90ff; font-weight: bold;
}
/* Results: match stats in the victory art's leaderboard slots
   (.uss leaderboard-entry: Boogaloo, whitesmoke) */
.leaderboard-entry {
    position: absolute; display: flex; align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--su) * 1);
    font-family: 'Boogaloo', sans-serif;
    font-size: calc(var(--su) * 1.7);
    color: #f5f5f5;                    /* uss --color-text-light */
}
.lb-label { text-transform: uppercase; letter-spacing: 0.05em; }
/* Results: defeat stats card (port-added; the defeat art has no panel) */
.defeat-stats {
    position: absolute; left: 3%; bottom: 6%;
    background: #eee;
    border: max(2px, calc(var(--su) * 0.16)) solid #1e90ff;
    border-radius: calc(var(--su) * 1);
    padding: calc(var(--su) * 0.8) calc(var(--su) * 1.4);
    font-family: 'Boogaloo', sans-serif; color: #696969;
    font-size: max(12px, calc(var(--su) * 1.5));
    min-width: calc(var(--su) * 16);
}
.defeat-stat-line {
    display: flex; justify-content: space-between;
    gap: calc(var(--su) * 2);
}
.defeat-stats .lb-value { color: #533cc0; }  /* the art's DEFEAT purple */
.result-msg {
    font-family: 'Boogaloo', sans-serif;
    font-size: max(10px, calc(var(--su) * 1.1)); color: #696969;
    max-width: calc(var(--su) * 24);
}

/* Phone-size HUD: smaller type, tighter panel, wrap the banner */
@media (max-width: 600px), (max-height: 500px) {
    #hud { font-size: 10px; line-height: 1.4; padding: 5px 8px; }
    #banner { font-size: 11px; white-space: normal; text-align: center; }
}
</style>
</head>
<body>

<canvas id="canvas"></canvas>
<div id="hud">loadingâ€¦</div>
<div id="banner">loading the engineâ€¦</div>
<button id="pausebtn" aria-label="pause">âšâš</button>
<button id="mutebtn" aria-label="mute">ðŸ”Š</button>
<input id="volume" type="range" min="0" max="1" step="0.05" value="1"
       aria-label="volume">
<div id="screens"></div>
<div id="version">dev</div>

<!-- Thin client per the Browser Client Rendering Policy: DOM shell +
     WASM-export transport + bootstrap. Loop/render/input/view logic is the
     shared engine runtime (lib/rt-*.js, source: engine/clients/lib/);
     sashimi-specific sprites/HUD/bootstrap live in the sandbox lib
     (lib/sashimi-*.js, source: sandboxes/sashimi/clients/lib/).
     ?v=N cache-busts GitHub Pages (root CLAUDE.md decision 22). -->
<script src="flecs-ecs.js?v=7"></script>
<script src="lib/rt-loop.js?v=7"></script>
<script src="lib/rt-control.js?v=7"></script>
<script src="lib/rt-input.js?v=7"></script>
<script src="lib/rt-view.js?v=7"></script>
<script src="lib/rt-sprites.js?v=7"></script>
<script src="lib/rt-render.js?v=7"></script>
<script src="lib/sashimi-art-data.js?v=7"></script>
<script src="lib/sashimi-audio-data.js?v=7"></script>
<script src="lib/sashimi-sprites.js?v=7"></script>
<script src="lib/sashimi-audio.js?v=7"></script>
<script src="lib/sashimi-fx.js?v=7"></script>
<script src="lib/sashimi-hud.js?v=7"></script>
<script src="lib/sashimi-screens.js?v=7"></script>
<script src="lib/sashimi-client.js?v=7"></script>
<script>
FlecsECS().then(function(M) {
    /* window.__sashimi: debug/test handle (loop, engine, restart, audio) */
    window.__sashimi = SashimiClient.start(M, {
        config: new URLSearchParams(location.search).get('config') || 'default',
        canvas: document.getElementById('canvas'),
        hud: document.getElementById('hud'),
        banner: document.getElementById('banner'),
        screens: document.getElementById('screens'),
        pauseBtn: document.getElementById('pausebtn'),
        muteBtn: document.getElementById('mutebtn'),
        volSlider: document.getElementById('volume'),
    });
});
</script>
</body>
</html>
/*
 * WASM entry point for the sashimi real-time client.
 *
 * Direct-link transport (rt-demo pattern): the browser steps the engine
 * in-process at 60Hz (wasm_tick) and reads state through per-field scalar
 * accessors (root CLAUDE.md decision 19). All game parameters come from the
 * sandbox YAML via the engine (root decision 13) â€” this bridge only projects
 * simulation state for rendering; it injects nothing but possession + input.
 *
 * Input path: the client samples devices once per simulation tick and calls
 * wasm_set_input(clientId, x, y) with raw vectors; sashimi_input_snap snaps
 * them to 45-degree octants before writing the InputDirection component â€”
 * the identical path the headless hero AI uses, so player and AI heroes are
 * indistinguishable to the simulation.
 *
 * Join path: wasm_join_hero(clientId, kind) possesses an un-possessed hero
 * (PossessedBy {slot}), preferring the hero whose spawn prefab kind matches
 * (hero select: SW_KIND_HERO_EAGLE / SW_KIND_HERO_FROG; 0 = no preference)
 * and falling back to the first free hero; wasm_join(clientId) is the
 * unpreferenced back-compat form. hero_ai skips possessed heroes. Both
 * heroes exist from app start (spawn_list), so local co-op is possession,
 * not spawning. No third hero exists â€” join returns 0.
 */
#include <emscripten.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

#include "engine/engine.h"
#include "engine/simulation.h"
#include "engine/app.h"
#include "engine/templates.h"
#include "systems.h"   /* sashimi native: sashimi_input_snap, sashimi_wave_count */

/* â”€â”€ Component mirror structs (layouts match the generated YAML schemas;
      same natural-alignment rules as systems/native/systems.c) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

typedef struct { float x, y; } CVec2;            /* Position, Velocity,
                                                    InputDirection */
typedef struct { int32_t stage, ticks_remaining; } CAbilityState;
typedef struct { float current, max; } CHealth;
typedef struct {
    int32_t shape;                /* 0=none 1=circle 2=rect */
    float radius, width, height;
    ecs_bool_t enabled;
} CCollider;
typedef struct { float xp; int32_t level; } CExperience;
typedef struct { int32_t slot; } CPossessedBy;
typedef struct { int64_t tick; } CGameTime;
typedef struct { int32_t gems, kills; } CMatchStats;
typedef struct { int32_t next_wave, ticks_to_next, spawned_total; } CWaveState;
typedef struct { int32_t tick_rate; float periodic_tick_time; } CGameTimeConfig;
typedef struct { float victory_timer_seconds, game_over_delay_seconds; } CGameOverConfig;
typedef struct { float min_x, min_y, max_x, max_y; } CArenaBounds;
typedef struct {
    int32_t max_level;
    int32_t xp[20];
    float damage[20];
    float health[20];
} CLevelTable;                    /* HeroLevelUp */
typedef struct {
    char *template_name;
    float x, y;
    int32_t ticks_remaining;
} CPendingSpawn;
typedef struct { float spawn_delay; int32_t spawn_max; float spawn_growth; } CSpawnConfig;

/* â”€â”€ Static state â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

static Engine *g_engine = NULL;

#define SW_MAX_UNITS   4096
#define SW_MAX_PLAYERS 4

/* Renderable kinds, resolved from the spawn prefab (IsA target). The
 * client's sprite manifest indexes by these values. */
enum {
    SW_KIND_NONE = 0,
    SW_KIND_HERO_EAGLE = 1,
    SW_KIND_HERO_FROG = 2,
    SW_KIND_SLIME = 3,
    SW_KIND_WOLF = 4,
    SW_KIND_GOLEM = 5,
    SW_KIND_WISP = 6,
    SW_KIND_CUBE = 7,
    SW_KIND_SHURIKEN = 8,
    SW_KIND_FEATHER = 9,
    SW_KIND_WISP_SHOT = 10,
    SW_KIND_GEM = 11,
    SW_KIND_HEART = 12,
    SW_KIND_COUNT
};

/* Anim-state flags exported per unit. Bit 2 covers BOTH protection
 * windows â€” post-hit i-frames and the 2 s post-respawn OutOfGame
 * (untargetable/unable-to-act) â€” so respawned heroes read as protected
 * (the client renders bit 2 as flicker). */
#define SW_FLAG_DEFEATED 1
#define SW_FLAG_HIT      2
#define SW_FLAG_IFRAMES  4

/* Ability stage exported per unit (from the unit's ability children's
 * AbilityState; systems.c AB_* stage machine). 0 also covers READY and
 * COOLDOWN â€” only the visible stages are distinguished. */
#define SW_STAGE_IDLE     0
#define SW_STAGE_WINDUP   1
#define SW_STAGE_ACTIVE   2
#define SW_STAGE_RECOVERY 3

typedef struct {
    float x, y;
    float dir_x, dir_y;           /* InputDirection (heroes) or Velocity */
    float health, max_health;     /* 0 max = no health bar */
    float radius;                 /* collider radius / max half extent */
    int32_t kind;
    int32_t flags;
    int32_t stage;                /* SW_STAGE_* (creature attack anims) */
    int32_t slot;                 /* 0 = AI, 1..4 = player clientId */
    int32_t entity_id;
} SwUnit;

static SwUnit g_units[SW_MAX_UNITS];
static int g_unit_count = 0;
static double g_tick_ms = 0;

/* Pre-spawn telegraph snapshot (Unity SpawnWarning presentation): every
 * PendingSpawn warning with its materialization countdown. CLIENT
 * presentation only â€” the hero-AI observability contract keeps
 * PendingSpawn invisible to AI queries/snapshots (component-bare in the
 * sim); a human player sees Unity's warnings, so the bridge may export
 * them to the renderer. Capacity = all 509 wave entries pending at once
 * (waves 2+ burst their warnings in one tick; decision 17). */
#define SW_MAX_PENDING 512
typedef struct { float x, y; int32_t kind, ticks_left; } SwPending;
static SwPending g_pending[SW_MAX_PENDING];
static int g_pending_count = 0;

static ecs_entity_t g_players[SW_MAX_PLAYERS + 1] = {0}; /* index by clientId */

/* Prefab entity -> kind mapping, resolved once per init. */
static ecs_entity_t g_kind_prefab[SW_KIND_COUNT] = {0};

/* Extra prefabs that render as an existing kind (no dedicated art row):
 * the resting spent feather (FeatherRecall_Spawner) and the homing recall
 * projectile (FeatherRecall_Projectile) both draw as the Feather. */
#define SW_KIND_ALIAS_COUNT 2
static ecs_entity_t g_alias_prefab[SW_KIND_ALIAS_COUNT] = {0};
static int g_alias_kind[SW_KIND_ALIAS_COUNT] = {0};

/* Cached component/entity ids. */
static struct {
    ecs_entity_t position, velocity, input_direction, health, collider;
    ecs_entity_t hero, experience, possessed_by, defeated, took_damage,
                 iframes_timer, out_of_game, ability_state;
    ecs_entity_t game_time, match_stats, wave_state;
    ecs_entity_t game_time_config, game_over_config, arena_bounds,
                 hero_level_up;
    ecs_entity_t pending_spawn, spawn_config;
    ecs_entity_t game_config_e, game_state_e;
} g_ids;

static void resolve_ids(void) {
    ecs_world_t *w = g_engine->world;
#define L(field, name) g_ids.field = ecs_lookup(w, name)
    L(position, "Position");             L(velocity, "Velocity");
    L(input_direction, "InputDirection"); L(health, "Health");
    L(collider, "Collider");             L(hero, "Hero");
    L(experience, "Experience");         L(possessed_by, "PossessedBy");
    L(defeated, "Defeated");             L(took_damage, "TookDamage");
    L(iframes_timer, "IFramesTimer");    L(out_of_game, "OutOfGame");
    L(game_time, "GameTime");
    L(ability_state, "AbilityState");
    L(match_stats, "MatchStats");        L(wave_state, "WaveState");
    L(game_time_config, "GameTimeConfig");
    L(game_over_config, "GameOverConfig");
    L(arena_bounds, "ArenaBounds");      L(hero_level_up, "HeroLevelUp");
    L(pending_spawn, "PendingSpawn");    L(spawn_config, "SpawnConfig");
#undef L
    g_ids.game_config_e = ecs_lookup(w, "GameConfig");
    g_ids.game_state_e = ecs_lookup(w, "GameState");

    static const struct { int kind; const char *tmpl; } KINDS[] = {
        { SW_KIND_HERO_EAGLE, "HeroEagle" },
        { SW_KIND_HERO_FROG,  "HeroFrog" },
        { SW_KIND_SLIME,      "CreatureSlimeOrange" },
        { SW_KIND_WOLF,       "CreatureWolf" },
        { SW_KIND_GOLEM,      "CreatureRockGolem" },
        { SW_KIND_WISP,       "CreatureWisp" },
        { SW_KIND_CUBE,       "LargeTealCube" },
        { SW_KIND_SHURIKEN,   "Shuriken_Projectile" },
        { SW_KIND_FEATHER,    "Feather_Projectile" },
        { SW_KIND_WISP_SHOT,  "CreatureWisp_Projectile" },
        { SW_KIND_GEM,        "GemPickup" },
        { SW_KIND_HEART,      "HeartPickup" },
    };
    memset(g_kind_prefab, 0, sizeof(g_kind_prefab));
    for (size_t i = 0; i < sizeof(KINDS) / sizeof(KINDS[0]); i++)
        g_kind_prefab[KINDS[i].kind] = ecs_lookup(w, KINDS[i].tmpl);

    static const struct { int kind; const char *tmpl; } ALIASES[] = {
        { SW_KIND_FEATHER, "FeatherRecall_Spawner" },
        { SW_KIND_FEATHER, "FeatherRecall_Projectile" },
    };
    for (int i = 0; i < SW_KIND_ALIAS_COUNT; i++) {
        g_alias_prefab[i] = ecs_lookup(w, ALIASES[i].tmpl);
        g_alias_kind[i] = ALIASES[i].kind;
    }
}

static int kind_of_prefab(ecs_entity_t prefab) {
    if (!prefab) return SW_KIND_NONE;
    for (int k = 1; k < SW_KIND_COUNT; k++)
        if (g_kind_prefab[k] == prefab) return k;
    for (int i = 0; i < SW_KIND_ALIAS_COUNT; i++)
        if (g_alias_prefab[i] && g_alias_prefab[i] == prefab)
            return g_alias_kind[i];
    return SW_KIND_NONE;
}

static int kind_of(ecs_entity_t e) {
    return kind_of_prefab(ecs_get_target(g_engine->world, e, EcsIsA, 0));
}

/* Visible ability stage of a unit: scan its ability children (AbilityState;
 * systems.c stage machine AB_READY=0 WINDUP=1 ACTIVE=2 RECOVERY=3
 * COOLDOWN=4). A unit can own several abilities (LargeTealCube: attack +
 * charge); the most visually-committed stage wins: ACTIVE > WINDUP >
 * RECOVERY. READY/COOLDOWN read as idle. */
static int stage_of(ecs_entity_t e) {
    if (!g_ids.ability_state) return SW_STAGE_IDLE;
    ecs_world_t *w = g_engine->world;
    int best = SW_STAGE_IDLE;
    static const int PRIO[5] = { 0, 2, 3, 1, 0 }; /* by AB_* stage */
    ecs_iter_t it = ecs_children(w, e);
    while (ecs_children_next(&it)) {
        for (int i = 0; i < it.count; i++) {
            const CAbilityState *st = ecs_get_id(w, it.entities[i],
                                                 g_ids.ability_state);
            if (!st || st->stage < 1 || st->stage > 3) continue;
            if (best == SW_STAGE_IDLE || PRIO[st->stage] > PRIO[best])
                best = st->stage; /* AB_* 1..3 == SW_STAGE_* 1..3 */
        }
    }
    return best;
}

/* â”€â”€ Collection (after each tick) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

static void collect_units(void) {
    ecs_world_t *w = g_engine->world;
    g_unit_count = 0;
    if (!g_ids.position) return;

    ecs_query_t *q = ecs_query(w, {
        .terms = {
            { .id = g_ids.position },
            { .id = g_engine->user_entity_tag },
        },
        .cache_kind = EcsQueryCacheNone
    });

    int count = 0;
    ecs_iter_t it = ecs_query_iter(w, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && count < SW_MAX_UNITS; i++) {
            ecs_entity_t e = it.entities[i];
            /* Roots only: weapon/ability children are not renderables. */
            if (ecs_get_target(w, e, EcsChildOf, 0)) continue;

            int kind = kind_of(e);
            if (kind == SW_KIND_NONE) continue;

            SwUnit *u = &g_units[count];
            u->kind = kind;

            const CVec2 *pos = ecs_get_id(w, e, g_ids.position);
            if (!pos) continue;
            u->x = pos->x;
            u->y = pos->y;

            /* Facing source: heroes have InputDirection; creatures,
             * projectiles and pickups move on Velocity. */
            const CVec2 *dir = g_ids.input_direction ?
                ecs_get_id(w, e, g_ids.input_direction) : NULL;
            if (!dir && g_ids.velocity)
                dir = ecs_get_id(w, e, g_ids.velocity);
            u->dir_x = dir ? dir->x : 0.0f;
            u->dir_y = dir ? dir->y : 0.0f;

            const CHealth *hp = g_ids.health ?
                ecs_get_id(w, e, g_ids.health) : NULL;
            u->health = hp ? hp->current : 0.0f;
            u->max_health = hp ? hp->max : 0.0f;

            const CCollider *c = g_ids.collider ?
                ecs_get_id(w, e, g_ids.collider) : NULL;
            u->radius = 0.2f;
            if (c) {
                if (c->shape == 1) u->radius = c->radius;
                else if (c->shape == 2)
                    u->radius = (c->width > c->height ? c->width
                                                      : c->height) * 0.5f;
            }

            /* Ability stage: creatures only (heroes fire weapons; kind
             * 3..7 are the AbilityConfig owners). */
            u->stage = (kind >= SW_KIND_SLIME && kind <= SW_KIND_CUBE)
                ? stage_of(e) : SW_STAGE_IDLE;

            u->flags = 0;
            if (g_ids.defeated && ecs_has_id(w, e, g_ids.defeated))
                u->flags |= SW_FLAG_DEFEATED;
            if (g_ids.took_damage && ecs_has_id(w, e, g_ids.took_damage))
                u->flags |= SW_FLAG_HIT;
            if (g_ids.iframes_timer && ecs_has_id(w, e, g_ids.iframes_timer))
                u->flags |= SW_FLAG_IFRAMES;
            if (g_ids.out_of_game && ecs_has_id(w, e, g_ids.out_of_game))
                u->flags |= SW_FLAG_IFRAMES; /* respawn OOG reads as protected */

            const CPossessedBy *pb = g_ids.possessed_by ?
                ecs_get_id(w, e, g_ids.possessed_by) : NULL;
            u->slot = pb ? pb->slot : 0;

            const int32_t *eid = ecs_get_id(w, e, g_engine->entity_id_comp);
            u->entity_id = eid ? *eid : 0;

            count++;
        }
    }
    ecs_query_fini(q);
    g_unit_count = count;
}

/* Pre-spawn telegraphs: snapshot every PendingSpawn warning. The kind
 * comes from the pending template name (the same prefab the creature
 * will spawn as), so the client can size/shape the indicator. */
static void collect_pending(void) {
    ecs_world_t *w = g_engine->world;
    g_pending_count = 0;
    if (!g_ids.pending_spawn) return;

    ecs_query_t *q = ecs_query(w, {
        .terms = {{ .id = g_ids.pending_spawn }},
        .cache_kind = EcsQueryCacheNone
    });

    int count = 0;
    ecs_iter_t it = ecs_query_iter(w, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && count < SW_MAX_PENDING; i++) {
            const CPendingSpawn *ps = ecs_get_id(w, it.entities[i],
                                                 g_ids.pending_spawn);
            if (!ps || !ps->template_name || ps->ticks_remaining <= 0)
                continue;
            SwPending *p = &g_pending[count];
            p->x = ps->x;
            p->y = ps->y;
            p->ticks_left = ps->ticks_remaining;
            p->kind = kind_of_prefab(ecs_lookup(w, ps->template_name));
            count++;
        }
    }
    ecs_query_fini(q);
    g_pending_count = count;
}

/* â”€â”€ Lifecycle â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

EMSCRIPTEN_KEEPALIVE
int wasm_init_with_config(const char *config_name) {
    if (g_engine) engine_fini(g_engine);
    memset(g_players, 0, sizeof(g_players));
    g_unit_count = 0;
    g_tick_ms = 0;

    g_engine = engine_init(NULL);
    if (!g_engine) return 0;

    if (!engine_sandbox_select(g_engine, "sashimi")) {
        engine_fini(g_engine);
        g_engine = NULL;
        return 0;
    }

    /* Empty / "default" mean the app.yaml top-level values. */
    const char *cfg = (config_name && config_name[0] &&
                       strcmp(config_name, "default") != 0) ? config_name
                                                            : NULL;
    AppStartResult asr;
    if (!engine_app_start(g_engine, cfg, &asr)) {
        engine_fini(g_engine);
        g_engine = NULL;
        return 0;
    }

    resolve_ids();
    collect_units();
    collect_pending();
    return 1;
}

/* Advance exactly one 60Hz simulation tick (lean mode: pipeline only). */
EMSCRIPTEN_KEEPALIVE
int wasm_tick(void) {
    if (!g_engine) return -1;
    double t0 = emscripten_get_now();
    sashimi_events_clear();   /* ring covers exactly this tick */
    TurnResult tr;
    if (engine_sim_turn(g_engine, &tr)) {
        engine_turn_result_free(&tr);
    }
    collect_units();
    collect_pending();
    g_tick_ms = emscripten_get_now() - t0;
    return g_engine->turn_counter;
}

/* â”€â”€ Input / join flow â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

/* Possess an un-possessed hero for player clientId (1..4), preferring the
 * hero whose spawn prefab kind (SW_KIND_HERO_EAGLE / SW_KIND_HERO_FROG)
 * matches `kind` â€” the hero-select contract. kind 0 = no preference.
 * Falls back to the first available hero when the requested kind is
 * already possessed (same-kind fallback: two players may pick the same
 * hero; the second gets the other one). Idempotent â€” returns the
 * already-possessed hero's entity_id if this client joined before.
 * Returns 0 when no free hero exists (2 heroes -> 2 players). */
EMSCRIPTEN_KEEPALIVE
int wasm_join_hero(int client_id, int kind) {
    if (!g_engine || client_id < 1 || client_id > SW_MAX_PLAYERS) return 0;
    ecs_world_t *w = g_engine->world;

    if (g_players[client_id] && ecs_is_alive(w, g_players[client_id])) {
        const int32_t *eid = ecs_get_id(w, g_players[client_id],
                                        g_engine->entity_id_comp);
        return eid ? *eid : 0;
    }
    if (!g_ids.hero || !g_ids.possessed_by) return 0;

    /* First un-possessed hero, lowest entity id (deterministic); a hero
     * matching the requested kind beats any non-matching candidate. */
    ecs_entity_t chosen = 0;
    int chosen_match = 0;
    ecs_query_t *q = ecs_query(w, {
        .terms = {{ .id = g_ids.hero }, { .id = g_engine->user_entity_tag }},
        .cache_kind = EcsQueryCacheNone
    });
    ecs_iter_t it = ecs_query_iter(w, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count; i++) {
            ecs_entity_t e = it.entities[i];
            if (ecs_has_id(w, e, g_ids.possessed_by)) continue;
            int match = (kind != 0 && kind_of(e) == kind);
            if (!chosen || match > chosen_match ||
                (match == chosen_match && e < chosen)) {
                chosen = e;
                chosen_match = match;
            }
        }
    }
    ecs_query_fini(q);
    if (!chosen) return 0;

    CPossessedBy pb = { client_id };
    ecs_set_id(w, chosen, g_ids.possessed_by, sizeof(pb), &pb);
    /* Stop the last AI-written direction from carrying over. */
    if (g_ids.input_direction) {
        CVec2 *dir = ecs_get_mut_id(w, chosen, g_ids.input_direction);
        if (dir) {
            dir->x = 0; dir->y = 0;
            ecs_modified_id(w, chosen, g_ids.input_direction);
        }
    }

    g_players[client_id] = chosen;
    const int32_t *eid = ecs_get_id(w, chosen, g_engine->entity_id_comp);
    return eid ? *eid : 0;
}

/* Back-compat unpreferenced join: first un-possessed hero. */
EMSCRIPTEN_KEEPALIVE
int wasm_join(int client_id) {
    return wasm_join_hero(client_id, 0);
}

/* Write a 45-degree-snapped InputDirection for one player. Called once per
 * simulation tick with the raw device vector (rt-input.js contract). */
EMSCRIPTEN_KEEPALIVE
void wasm_set_input(int client_id, double x, double y) {
    if (!g_engine || client_id < 1 || client_id > SW_MAX_PLAYERS) return;
    ecs_entity_t e = g_players[client_id];
    if (!e || !ecs_is_alive(g_engine->world, e)) return;

    float sx, sy;
    sashimi_input_snap((float)x, (float)y, &sx, &sy);

    if (!g_ids.input_direction) return;
    CVec2 *dir = ecs_get_mut_id(g_engine->world, e, g_ids.input_direction);
    if (dir) {
        dir->x = sx;
        dir->y = sy;
        ecs_modified_id(g_engine->world, e, g_ids.input_direction);
    }
}

EMSCRIPTEN_KEEPALIVE
int wasm_player_entity_id(int client_id) {
    if (!g_engine || client_id < 1 || client_id > SW_MAX_PLAYERS) return 0;
    ecs_entity_t e = g_players[client_id];
    if (!e || !ecs_is_alive(g_engine->world, e)) return 0;
    const int32_t *eid = ecs_get_id(g_engine->world, e,
                                    g_engine->entity_id_comp);
    return eid ? *eid : 0;
}

