/*
 * Sashimi native systems â€” simulation core of the sashimi port.
 *
 * Continuous 2D space centered on the arena origin (ArenaBounds
 * x [-9.5, 9.5], y [-6.5, 6.5]); one engine turn == one 60 Hz tick.
 * The Unity group -> engine phase mapping and per-slot ordering contract
 * live in sandboxes/sashimi/CLAUDE.md "System ordering"; per-system
 * behavior sources are ~/Dev/sashimi/{SYSTEMS,SYSTEM-GROUPS,GAMEPLAY,
 * CONTENT-ANALYSIS}.md.
 *
 * Conventions used throughout:
 *  - Collect-then-mutate: every system snapshots matching entities into
 *    static arrays before touching the world (no structural changes while a
 *    Flecs iterator is live; root CLAUDE.md decision 7).
 *  - Per-turn flags (TookDamage, Defeated-at-respawn) are removed, never set
 *    to false (root decision 8).
 *  - Static buffers are sized for the full 36-wave roster (509 scripted
 *    spawns; root decision 17).
 *  - All component reads/writes go through C mirror structs whose layout
 *    matches the Flecs-meta layout of the generated YAML schemas (same
 *    natural-alignment rules; verified by tests/test_systems.c).
 */
#include "systems.h"
#include "engine/app.h"
#include "engine/systems.h"
#include "engine/templates.h"
#include "engine/components.h"
#include "engine/history.h"
#include "engine/spatial.h"
#include "engine/faction.h"
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <stdint.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

/* â”€â”€ Capacity limits (root decision 17) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

#define S_MAX_ENTS        4096   /* any per-tick entity snapshot */
#define S_MAX_HITPAIRS    16384  /* (attacker, victim) hit-reset registry */
#define S_MAX_WAVES       40
#define S_MAX_WAVE_ENTRIES 600   /* 509 scripted entries */
#define S_MAX_PROJ_HITS   1024   /* projectile hits recorded per tick */
#define S_TMPL_NAME       64

#define S_BROADPHASE_SLOP 0.35f  /* covers one tick of movement between the
                                    pre-move hash build and post-move
                                    collision checks (Unity order, see
                                    CLAUDE.md) */

/* â”€â”€ Component mirror structs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* Field order matches the generated YAML schemas; C natural alignment
 * matches Flecs meta layout. */

typedef struct { float x, y; } CVec2; /* Position, Velocity, InputDirection,
                                         ChildOffset */
typedef struct { float value; } CMoveSpeed;
typedef struct { float current, max; } CHealth;
typedef struct { char *filter; } CFaction;
typedef struct {
    int32_t shape;                /* 0=none 1=circle 2=rect */
    float radius, width, height;
    ecs_bool_t enabled;
} CCollider;
typedef struct {
    float start_follow, stop_follow, start_flee, acquire_radius;
} CAISteering;
typedef struct { int32_t hero_id; } CHero;
typedef struct { float xp; int32_t level; } CExperience;
typedef struct { float cooldown; char *projectile; } CWeapon;
typedef struct { float range, speed; int32_t pierce, bounce; } CProjectile;
typedef struct {
    float damage;
    int32_t hit_limit;
    ecs_bool_t ignore_hit_limit;
    float reset_time;             /* seconds; -1 = never re-hit */
} CDamageOnHit;
typedef struct { float damage; } CPeriodicDamage;
typedef struct {
    float duration, periodic_damage;
    int32_t stat_type;            /* 1 = MovementSpeed */
    float magnitude;
    int32_t modifier_type;        /* 5=buff strongest 6=debuff strongest */
    int32_t stack_limit;
    ecs_bool_t ignore_stacks;
    int32_t charges;
    ecs_bool_t unlimited_charges;
} CStatusEffectOnHit;
typedef struct { int32_t ticks_remaining; float damage_per_tick; } CStatusPoison;
typedef struct { int32_t ticks_remaining; float magnitude; } CStatusSlow;
typedef struct { char *spawner_template; } CSpentProjectile;
typedef struct { int32_t effect; float value, move_speed; } CPickup;
typedef struct {
    int32_t id;                   /* AbilityId */
    float windup, active, recovery, cooldown;
    ecs_bool_t start_on_cooldown;
    float min_range, max_range;
} CAbilityConfig;
typedef struct { int32_t stage, ticks_remaining; } CAbilityState;
typedef struct { int32_t tick_rate; float periodic_tick_time; } CGameTimeConfig;
typedef struct { float victory_timer_seconds, game_over_delay_seconds; } CGameOverConfig;
typedef struct { float target_switch_threshold, damage_taken_ratio; } CCombatConfig;
typedef struct {
    float acceleration, trigger_distance, drop_distance;
    float gem_drop_scale, heart_drop_scale, heart_heal_ratio;
} CPickupConfig;
typedef struct { float min_x, min_y, max_x, max_y; } CArenaBounds;
typedef struct { float min_distance_to_move; } CMoveConfig;
typedef struct { float spawn_delay; int32_t spawn_max; float spawn_growth; } CSpawnConfig;
typedef struct {
    int32_t max_level;
    int32_t xp[20];
    float damage[20];
    float health[20];
} CLevelTable;                    /* CreatureLevelUp / HeroLevelUp */
typedef struct {
    float bounce_limit[20], pierce_limit[20], recall_limit[20];
} CHeroLevelBonus;
typedef struct { int32_t next_wave, ticks_to_next, spawned_total; } CWaveState;
typedef struct {
    char *template_name;
    float x, y;
    int32_t ticks_remaining;
} CPendingSpawn;
typedef struct { int32_t ticks_remaining; } CTicks; /* RespawnTimer,
                                                       IFramesTimer,
                                                       DestroyOnTimer */
typedef struct { int64_t tick; } CGameTime;
typedef struct { int32_t gems, kills; } CMatchStats;

/* Runtime-only components registered natively (not part of the generated
 * data layer; the avk TookDamage pattern): */
typedef struct { ecs_entity_t target; } CEnemyTarget;
typedef struct { int32_t cooldown_ticks; } CWeaponState;  /* starts on cooldown */
typedef struct {
    ecs_entity_t shooter;         /* owning hero (damage multiplier) */
    int32_t hits, pierce_left, bounce_left;
    float dist_left;              /* remaining flight fuel */
} CProjectileRuntime;             /* pierce_left records the spawn-time
                                     pierce stat (never decremented: the
                                     hit budget DamageOnHit.hit_limit =
                                     pierce + bounce + 1 is the whole
                                     spend, ProjectileLifecycleSystem.cs:
                                     167-174); bounce_left counts down */
typedef struct { int32_t hits; } CHitCount;               /* per ability activation */
typedef struct { int32_t slot; } CPossessedBy;            /* player clientId 1..4 */
typedef struct {                  /* caster dash impulse (Unity ImpulseElement,
                                     MoveSystem.cs HandleImpulseJob): locked
                                     direction + remaining fuel + speed =
                                     fuel / active duration. Integrates in
                                     movement independent of locomotion and
                                     of MoveSpeedStat (slow-immune). */
    float x, y;
    float fuel, speed;
} CChargeDash;
typedef struct { ecs_entity_t ability; } CActiveAbility;  /* caster's running
                                     ability (Unity ActiveAbility enableable on
                                     the caster; presence == enabled): at most
                                     one ability per caster from selection
                                     through the end of recovery
                                     (AbilitySystem.cs:626-750) */
typedef struct { ecs_entity_t hero; float speed; } CPickupMagnet;
typedef struct { float heart_pool, gem_pool; } CDropPools; /* OnDefeated pity
                                     pools (Unity keeps them on the MatchStats
                                     singleton, OnDefeatedSystem.cs:63-64; the
                                     generated MatchStats schema stays
                                     extraction-faithful, so the pools live in
                                     this native component on GameState) */
typedef struct { char *projectile; } COneShotSpawner; /* generated
                                     OneShotProjectileSpawner (feather
                                     recall spawner -> its projectile) */
typedef struct {                  /* Unity SpentProjectileId + the copied
                                     ProjectileState.Owner
                                     (ProjectileLifecycleSystem.cs:22-25,
                                     257-271): stamped on the spent-feather
                                     spawner so the recall ability can find
                                     ITS feathers and pick the NEWEST
                                     (highest id) first. */
    ecs_entity_t owner;
    int32_t id;                   /* monotonic; > 0 once stamped */
} CSpentProjectileId;
typedef struct { ecs_entity_t target; } CHomingTarget; /* Unity
                                     ProjectileEntityTracker
                                     (MoveSystem.cs:250-261): the recall
                                     projectile re-aims at this entity
                                     every tick */
typedef struct {                  /* Unity HeroEagleProjectileRecallAbility
                                     State (HeroEagleProjectileRecallAbility
                                     System.cs:20-26), tick-typed:
                                     stationary_since -1 == IsStationary
                                     false / StartStationaryFrame MaxValue;
                                     deactivation_since 0 == unset. */
    int32_t stationary_since;
    int32_t deactivation_since;
    ecs_bool_t activated;
} CRecallState;
typedef struct {                  /* Unity AppliedStatusEffectElement.Stacks
                                     for the recall haste riding StatusSlow
                                     (StatusEffectsSystem.cs:104-131,
                                     176-183): stacks extend DURATION only
                                     (magnitude stays the strongest single
                                     +0.5); each expiry drops one stack and
                                     re-arms duration_ticks. */
    int32_t stacks;
    int32_t duration_ticks;
} CRecallHaste;
typedef struct {                  /* spawn-director trickle cursor: the
                                     UnitSpawnWaveState fields the generated
                                     WaveState schema does not carry
                                     (CurrentSpawnIndex / TimeToNextSpawn /
                                     CurrentWaveLocation). Lives on GameState
                                     next to WaveState. */
    int32_t spawn_index;          /* next entry of the current wave */
    int32_t ticks_to_next_spawn;  /* may go (very) negative, see director */
    float origin_x, origin_y;     /* CurrentWaveLocation snapshot */
} CWaveDirector;

/* â”€â”€ Cached component ids (re-resolved when the world changes) â”€â”€â”€â”€â”€â”€â”€â”€ */

typedef struct {
    ecs_world_t *world;
    ecs_entity_t position, velocity, input_direction, child_offset;
    ecs_entity_t move_speed, health, faction, collider, ai_steering;
    ecs_entity_t hero, experience, weapon, projectile, damage_on_hit;
    ecs_entity_t periodic_damage, status_on_hit, status_poison, status_slow;
    ecs_entity_t spent_projectile, pickup, ability_config, ability_state;
    ecs_entity_t game_time_config, game_over_config, combat_config;
    ecs_entity_t pickup_config, arena_bounds, creature_level_up,
                 hero_level_up, hero_level_bonus, move_config;
    ecs_entity_t wave_state, pending_spawn, respawn_timer, iframes_timer,
                 destroy_on_timer, defeated, game_time, match_stats;
    ecs_entity_t spawn_config, one_shot_spawner;
    /* native runtime */
    ecs_entity_t took_damage, enemy_target, weapon_state, projectile_runtime,
                 hit_count, possessed_by, charge_dash, pickup_magnet,
                 locomotion_disabled, ability_initialized, out_of_game,
                 drop_pools, wave_director, active_ability, offset_flipped,
                 spent_projectile_id, spawn_one_shot, homing_target,
                 recall_state, recall_haste;
    /* config entities */
    ecs_entity_t game_config_e, game_state_e;
} Ids;

static Ids g_ids;

/* Register a native runtime component (scalar members only). */
static ecs_entity_t reg_component(ecs_world_t *w, const char *name,
                                  int size, int alignment,
                                  const ecs_member_t *members, int n) {
    ecs_entity_t c = ecs_lookup(w, name);
    if (c) return c;
    c = ecs_entity(w, { .name = name });
    ecs_set(w, c, EcsComponent, { .size = size, .alignment = alignment });
    ecs_struct_desc_t sd = { .entity = c };
    for (int i = 0; i < n && i < ECS_MEMBER_DESC_CACHE_SIZE; i++)
        sd.members[i] = members[i];
    ecs_struct_init(w, &sd);
    return c;
}

static ecs_entity_t reg_tag(ecs_world_t *w, const char *name) {
    ecs_entity_t t = ecs_lookup(w, name);
    if (t) return t;
    return ecs_entity(w, { .name = name });
}

static void register_runtime_components(Engine *engine) {
    ecs_world_t *w = engine->world;

    reg_component(w, "TookDamage", sizeof(ecs_bool_t), ECS_ALIGNOF(ecs_bool_t),
        (ecs_member_t[]){{ .name = "value", .type = ecs_id(ecs_bool_t) }}, 1);
    reg_component(w, "EnemyTarget", sizeof(CEnemyTarget),
        ECS_ALIGNOF(CEnemyTarget),
        (ecs_member_t[]){{ .name = "target", .type = ecs_id(ecs_entity_t) }}, 1);
    reg_component(w, "WeaponState", sizeof(CWeaponState),
        ECS_ALIGNOF(CWeaponState),
        (ecs_member_t[]){{ .name = "cooldown_ticks", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "ProjectileRuntime", sizeof(CProjectileRuntime),
        ECS_ALIGNOF(CProjectileRuntime),
        (ecs_member_t[]){
            { .name = "shooter", .type = ecs_id(ecs_entity_t) },
            { .name = "hits", .type = ecs_id(ecs_i32_t) },
            { .name = "pierce_left", .type = ecs_id(ecs_i32_t) },
            { .name = "bounce_left", .type = ecs_id(ecs_i32_t) },
            { .name = "dist_left", .type = ecs_id(ecs_f32_t) }}, 5);
    reg_component(w, "HitCount", sizeof(CHitCount), ECS_ALIGNOF(CHitCount),
        (ecs_member_t[]){{ .name = "hits", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "PossessedBy", sizeof(CPossessedBy),
        ECS_ALIGNOF(CPossessedBy),
        (ecs_member_t[]){{ .name = "slot", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "ChargeDash", sizeof(CChargeDash), ECS_ALIGNOF(CChargeDash),
        (ecs_member_t[]){
            { .name = "x", .type = ecs_id(ecs_f32_t) },
            { .name = "y", .type = ecs_id(ecs_f32_t) },
            { .name = "fuel", .type = ecs_id(ecs_f32_t) },
            { .name = "speed", .type = ecs_id(ecs_f32_t) }}, 4);
    reg_component(w, "ActiveAbility", sizeof(CActiveAbility),
        ECS_ALIGNOF(CActiveAbility),
        (ecs_member_t[]){{ .name = "ability", .type = ecs_id(ecs_entity_t) }}, 1);
    reg_component(w, "PickupMagnet", sizeof(CPickupMagnet),
        ECS_ALIGNOF(CPickupMagnet),
        (ecs_member_t[]){
            { .name = "hero", .type = ecs_id(ecs_entity_t) },
            { .name = "speed", .type = ecs_id(ecs_f32_t) }}, 2);
    /* OutOfGame: the OutOfGameTimer window (Unity enable-flagged component;
     * here presence == enabled, remove-don't-set-false per root decision 8).
     * Granted at hero respawn; heroes are fully off-field while it runs:
     * out of the spatial hash and unit snapshot, untargetable, take no
     * damage (fresh or poison), cannot move, fire or cast
     * (SpatialHashingSystem.cs:47,53; EnemyTargetingSystem.cs:37,118-133;
     * ApplyDamageSystem.cs:46-60; MoveSystem.cs:103,130,172;
     * AbilitySystem.cs WithDisabled(OutOfGameTimer) throughout). */
    reg_component(w, "OutOfGame", sizeof(CTicks), ECS_ALIGNOF(CTicks),
        (ecs_member_t[]){{ .name = "ticks_remaining", .type = ecs_id(ecs_i32_t) }}, 1);
    reg_component(w, "DropPools", sizeof(CDropPools), ECS_ALIGNOF(CDropPools),
        (ecs_member_t[]){
            { .name = "heart_pool", .type = ecs_id(ecs_f32_t) },
            { .name = "gem_pool", .type = ecs_id(ecs_f32_t) }}, 2);
    reg_component(w, "WaveDirector", sizeof(CWaveDirector),
        ECS_ALIGNOF(CWaveDirector),
        (ecs_member_t[]){
            { .name = "spawn_index", .type = ecs_id(ecs_i32_t) },
            { .name = "ticks_to_next_spawn", .type = ecs_id(ecs_i32_t) },
            { .name = "origin_x", .type = ecs_id(ecs_f32_t) },
            { .name = "origin_y", .type = ecs_id(ecs_f32_t) }}, 4);
    /* Eagle FeatherRecall runtime (trace: HeroEagleProjectileRecall
     * AbilitySystem.cs, ProjectileSpawnRequestSystem.cs:147-210,
     * MoveSystem.cs:250-261; values in entities/FeatherRecall_*.yaml and
     * systems.h SASHIMI_RECALL_*). */
    reg_component(w, "SpentProjectileId", sizeof(CSpentProjectileId),
        ECS_ALIGNOF(CSpentProjectileId),
        (ecs_member_t[]){
            { .name = "owner", .type = ecs_id(ecs_entity_t) },
            { .name = "id", .type = ecs_id(ecs_i32_t) }}, 2);
    reg_component(w, "HomingTarget", sizeof(CHomingTarget),
        ECS_ALIGNOF(CHomingTarget),
        (ecs_member_t[]){{ .name = "target", .type = ecs_id(ecs_entity_t) }}, 1);
    reg_component(w, "RecallState", sizeof(CRecallState),
        ECS_ALIGNOF(CRecallState),
        (ecs_member_t[]){
            { .name = "stationary_since", .type = ecs_id(ecs_i32_t) },
            { .name = "deactivation_since", .type = ecs_id(ecs_i32_t) },
            { .name = "activated", .type = ecs_id(ecs_bool_t) }}, 3);
    reg_component(w, "RecallHaste", sizeof(CRecallHaste),
        ECS_ALIGNOF(CRecallHaste),
        (ecs_member_t[]){
            { .name = "stacks", .type = ecs_id(ecs_i32_t) },
            { .name = "duration_ticks", .type = ecs_id(ecs_i32_t) }}, 2);
    /* Armed one-shot spawner (Unity's enableable SpawnOneShotProjectileTag;
     * presence == enabled, remove-don't-set-false per root decision 8):
     * set by the recall pass, consumed next tick by weapon_fire. */
    reg_tag(w, "SpawnOneShotProjectile");
    reg_tag(w, "LocomotionDisabled");
    reg_tag(w, "AbilityInitialized");
    /* Child-offset x-mirror state (GameplayParentOffset.Rotate,
     * GameplayParentAuthoring.cs:20-29): presence == the offset is
     * currently x-flipped. Persisted so the sync freeze while the parent's
     * locomotion is disabled keeps the LAST applied offset (Unity children
     * are transform children whose frozen LOCAL offset rides the parent). */
    reg_tag(w, "ChildOffsetFlipped");
}

static bool ids_resolve(Engine *engine) {
    ecs_world_t *w = engine->world;
    if (g_ids.world == w && g_ids.position) return true;
    memset(&g_ids, 0, sizeof(g_ids));
    g_ids.world = w;
#define L(field, name) g_ids.field = ecs_lookup(w, name)
    L(position, "Position");            L(velocity, "Velocity");
    L(input_direction, "InputDirection"); L(child_offset, "ChildOffset");
    L(move_speed, "MoveSpeed");         L(health, "Health");
    L(faction, "Faction");              L(collider, "Collider");
    L(ai_steering, "AISteering");       L(hero, "Hero");
    L(experience, "Experience");        L(weapon, "Weapon");
    L(projectile, "Projectile");        L(damage_on_hit, "DamageOnHit");
    L(periodic_damage, "PeriodicDamage"); L(status_on_hit, "StatusEffectOnHit");
    L(status_poison, "StatusPoison");   L(status_slow, "StatusSlow");
    L(spent_projectile, "SpentProjectile"); L(pickup, "Pickup");
    L(ability_config, "AbilityConfig"); L(ability_state, "AbilityState");
    L(game_time_config, "GameTimeConfig"); L(game_over_config, "GameOverConfig");
    L(combat_config, "CombatConfig");   L(pickup_config, "PickupConfig");
    L(arena_bounds, "ArenaBounds");     L(creature_level_up, "CreatureLevelUp");
    L(hero_level_up, "HeroLevelUp");    L(hero_level_bonus, "HeroLevelBonus");
    L(move_config, "MoveConfig");
    L(wave_state, "WaveState");         L(pending_spawn, "PendingSpawn");
    L(respawn_timer, "RespawnTimer");   L(iframes_timer, "IFramesTimer");
    L(destroy_on_timer, "DestroyOnTimer"); L(defeated, "Defeated");
    L(game_time, "GameTime");           L(match_stats, "MatchStats");
    L(spawn_config, "SpawnConfig");
    L(one_shot_spawner, "OneShotProjectileSpawner");
    L(spent_projectile_id, "SpentProjectileId");
    L(spawn_one_shot, "SpawnOneShotProjectile");
    L(homing_target, "HomingTarget");   L(recall_state, "RecallState");
    L(recall_haste, "RecallHaste");
    L(took_damage, "TookDamage");       L(enemy_target, "EnemyTarget");
    L(weapon_state, "WeaponState");     L(projectile_runtime, "ProjectileRuntime");
    L(hit_count, "HitCount");           L(possessed_by, "PossessedBy");
    L(charge_dash, "ChargeDash");       L(pickup_magnet, "PickupMagnet");
    L(locomotion_disabled, "LocomotionDisabled");
    L(ability_initialized, "AbilityInitialized");
    L(out_of_game, "OutOfGame");        L(drop_pools, "DropPools");
    L(wave_director, "WaveDirector");   L(active_ability, "ActiveAbility");
    L(offset_flipped, "ChildOffsetFlipped");
#undef L
    g_ids.game_config_e = ecs_lookup(w, "GameConfig");
    g_ids.game_state_e = ecs_lookup(w, "GameState");
    return g_ids.position && g_ids.health && g_ids.faction;
}

/* â”€â”€ Shared per-tick globals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

static float g_dt = 1.0f / 60.0f;
static int g_tick_rate = 60;
static int64_t g_tick = 0;         /* GameTime.tick during this turn */
static bool g_periodic_now = false;/* is this tick a periodic (0.25 s) tick */
static float g_periodic_time = 0.25f; /* GameTimeConfig.periodic_tick_time */

/* Co-op difficulty: creature HP multiplier when more than one living hero
 * exists at spawn time (UnitInitializationSystem.cs:55-58). This is the
 * ONLY live creature scaling: the CreatureLevelUp level driver (SpawnCount)
 * has no live writer â€” CreatureSpawnSystem.cs:14 is entirely #if false â€”
 * so shipped creatures never level (see delayed_spawn). */
#define S_COOP_HP_MULT 1.4f

static CArenaBounds g_bounds = { -9.5f, -6.5f, 9.5f, 6.5f };

/* Hero centroid (CameraFollowPointSystem.cs:45-65 â€” "gameplay relevant, do
 * not disable server simulation!"): the average position of possessed
 * heroes, updated every tick by game_time. Port equivalence for
 * "possessed": all LIVING heroes (the AI stand-in counts as a possessed
 * player). Not updated while no hero is alive (Unity keeps the last value
 * when followCount == 0); starts at the baked default float3.zero, which
 * is what wave 1's origin snapshot sees. Consumed by spawn_director (wave
 * origin snapshots) and, later, by creature no-target convergence. */
static CVec2 g_hero_centroid = { 0.0f, 0.0f };

/* Spatial hash (engine spatial.h; cell size 0.5 per sashimi convention). */
static SpatialHash g_hash;
static bool g_hash_ready = false;

/* Faction matrix. */
static FactionMatrix g_matrix;
static bool g_matrix_loaded = false;

/* Wave script (data/waves.yaml). */
typedef struct {
    char template_name[S_TMPL_NAME];
    float x, y;
    int delay_ticks;
} WaveEntry;
typedef struct { int first_entry, entry_count; } Wave;
static Wave g_waves[S_MAX_WAVES];
static WaveEntry g_wave_entries[S_MAX_WAVE_ENTRIES];
static int g_wave_count = 0;
static int g_wave_delay_ticks = 300;
static bool g_waves_loaded = false;

/* (attacker, victim) hit-reset registry â€” implements DamageOnHit.reset_time
 * and projectile never-rehit (-1) uniformly. */
typedef struct { uint64_t attacker, victim; int64_t next_tick; } HitPair;
static HitPair g_pairs[S_MAX_HITPAIRS];
static int g_pair_count = 0;

/* Projectile hits recorded by damage_apply this tick, consumed by
 * projectile_lifecycle (bounce/pierce/spent decisions). */
typedef struct { ecs_entity_t projectile, victim; } ProjHit;
static ProjHit g_proj_hits[S_MAX_PROJ_HITS];
static int g_proj_hit_count = 0;

/* Monotonic spent-projectile counter (Unity's server-side
 * SpentProjectileCounter, ProjectileLifecycleSystem.cs:34,270): the recall
 * ability recalls the NEWEST feather first (highest id). */
static int32_t g_spent_counter = 0;

/* Unit snapshot rebuilt by spatial_hash each tick and reused by targeting,
 * steering, AI and damage. */
typedef struct {
    ecs_entity_t e;
    float x, y;
    float radius;                 /* collision radius (rect -> max half extent) */
    CollisionFilter filter;
    bool is_hero, defeated;
    bool iframed;                 /* carries IFramesTimer: absent from the
                                     spatial hash and from every hash-fed
                                     interaction, but still present here
                                     for targeting (Unity's JustHeroes
                                     candidates are query-fed, not
                                     hash-fed) */
    float health_cur, health_max;
} UnitSnap;
static UnitSnap g_units[S_MAX_ENTS];
static int g_unit_count = 0;

/* â”€â”€ Presentation event ring (systems.h contract) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 * Write-only from the simulation's perspective: emit_event only reads
 * world state, so recording events cannot change an outcome. Headless
 * runs never drain the ring; it saturates at SASHIMI_EVENT_CAP and resets
 * on the next sashimi_events_clear()/registration. */
typedef struct {
    int32_t type;
    ecs_entity_t prefab;
    int32_t entity_id;
    int32_t data;
} SashimiEvent;
static SashimiEvent g_events[SASHIMI_EVENT_CAP];
static int g_event_count = 0;

void sashimi_events_clear(void) { g_event_count = 0; }
int  sashimi_events_count(void) { return g_event_count; }
int  sashimi_event_type(int i) {
    return (i >= 0 && i < g_event_count) ? g_events[i].type : 0;
}
uint64_t sashimi_event_prefab(int i) {
    return (i >= 0 && i < g_event_count) ? (uint64_t)g_events[i].prefab : 0;
}
int  sashimi_event_entity(int i) {
    return (i >= 0 && i < g_event_count) ? g_events[i].entity_id : 0;
}
int  sashimi_event_data(int i) {
    return (i >= 0 && i < g_event_count) ? g_events[i].data : 0;
}

/* Engine public id of an entity (the id clients address units by). */
static int32_t public_id(Engine *engine, ecs_entity_t e) {
    if (!e || !engine->entity_id_comp) return 0;
    const int32_t *eid = ecs_get_id(engine->world, e, engine->entity_id_comp);
    return eid ? *eid : 0;
}

static void emit_event(Engine *engine, int type, ecs_entity_t subject,
                       int data) {
    if (g_event_count >= SASHIMI_EVENT_CAP) return; /* drop overflow */
    SashimiEvent *ev = &g_events[g_event_count++];
    ev->type = type;
    ev->prefab = subject
        ? ecs_get_target(engine->world, subject, EcsIsA, 0) : 0;
    ev->entity_id = subject ? public_id(engine, subject) : 0;
    ev->data = data;
}

/* â”€â”€ Small helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
}
static float clampf(float v, float lo, float hi) {
    return v < lo ? lo : (v > hi ? hi : v);
}
static float dist2(float ax, float ay, float bx, float by) {
    float dx = ax - bx, dy = ay - by;
    return dx * dx + dy * dy;
}

/* Unity Ticks(): 1 + floor(round(d, 3) * rate) â€” every positive duration
 * runs one tick longer than the nominal count, and a 0-second duration
 * still occupies 1 tick (GameTimeSystem_FixedStep.cs:78-84; the
 * round-to-3-decimals absorbs float noise before the floor). Same math as
 * the hit-pair reset expiry. */
static int ticks_dur(float seconds) {
    if (seconds < 0) seconds = 0;
    float r = roundf(seconds * 1000.0f) / 1000.0f;
    return 1 + (int)floorf(r * (float)g_tick_rate);
}

/* Real-shape overlap between two collider-bearing entities at explicit
 * positions (Unity SpatialHashingMap.CheckCollision: circle/circle,
 * circle/rect, rect/rect â€” rects are axis-aligned here as in the shipped
 * content). Entities without an enabled collider never overlap. */
static bool overlap_entities(Engine *engine, ecs_entity_t a, float ax, float ay,
                             ecs_entity_t b, float bx, float by) {
    const CCollider *ca = ecs_get_id(engine->world, a, g_ids.collider);
    const CCollider *cb = ecs_get_id(engine->world, b, g_ids.collider);
    if (!ca || !cb || ca->shape == 0 || cb->shape == 0) return false;
    bool a_rect = ca->shape == 2, b_rect = cb->shape == 2;
    float ahw = a_rect ? ca->width * 0.5f : ca->radius;
    float ahh = a_rect ? ca->height * 0.5f : ca->radius;
    float bhw = b_rect ? cb->width * 0.5f : cb->radius;
    float bhh = b_rect ? cb->height * 0.5f : cb->radius;
    if (!a_rect && !b_rect)
        return overlap_circle_circle(ax, ay, ahw, bx, by, bhw);
    if (a_rect && !b_rect)
        return overlap_circle_rect(bx, by, bhw, ax, ay, ahw, ahh);
    if (!a_rect && b_rect)
        return overlap_circle_rect(ax, ay, ahw, bx, by, bhw, bhh);
    return overlap_aabb_aabb(ax - ahw, ay - ahh, ax + ahw, ay + ahh,
                             bx - bhw, by - bhh, bx + bhw, by + bhh);
}

void sashimi_input_snap(float x, float y, float *out_x, float *out_y) {
    /* Octant unit vectors, angle order (y down in screen space). Matches
     * rt-demo's rt_input_snap so rt-input.js clients behave identically. */
    static const float OCT[8][2] = {
        {  1.0f,         0.0f        },
        {  0.70710678f,  0.70710678f },
        {  0.0f,         1.0f        },
        { -0.70710678f,  0.70710678f },
        { -1.0f,         0.0f        },
        { -0.70710678f, -0.70710678f },
        {  0.0f,        -1.0f        },
        {  0.70710678f, -0.70710678f },
    };
    const float deadzone = 0.25f;
    if (x * x + y * y < deadzone * deadzone) { *out_x = 0; *out_y = 0; return; }
    float angle = atan2f(y, x);
    int oct = (int)lroundf(angle / (float)(M_PI / 4.0));
    oct = ((oct % 8) + 8) % 8;
    *out_x = OCT[oct][0];
    *out_y = OCT[oct][1];
}

/* Resolve an entity's faction filter (by Faction.filter name). Returns
 * false when the entity has no faction or the name is unknown. */
static bool entity_filter(Engine *engine, ecs_entity_t e, CollisionFilter *out) {
    const CFaction *f = ecs_get_id(engine->world, e, g_ids.faction);
    if (!f || !f->filter) return false;
    const FactionFilterDef *d = faction_matrix_filter(&g_matrix, f->filter);
    if (!d) return false;
    *out = d->filter;
    return true;
}

static bool is_defeated(Engine *engine, ecs_entity_t e) {
    return g_ids.defeated && ecs_has_id(engine->world, e, g_ids.defeated);
}

/* Fully out of game: the post-respawn OutOfGameTimer window (see the
 * OutOfGame registration comment for the gated surface). */
static bool is_out_of_game(Engine *engine, ecs_entity_t e) {
    return g_ids.out_of_game && ecs_has_id(engine->world, e, g_ids.out_of_game);
}

static ecs_entity_t parent_of(Engine *engine, ecs_entity_t e) {
    return ecs_get_target(engine->world, e, EcsChildOf, 0);
}

/* Root gameplay owner: walk ChildOf up to the top-most entity. */
static ecs_entity_t root_of(Engine *engine, ecs_entity_t e) {
    ecs_entity_t p = e, up;
    while ((up = parent_of(engine, p)) != 0) p = up;
    return p;
}

/* Level from an XP table: level n requires xp[n-1] gems. */
static int level_from_xp(const CLevelTable *t, int gems) {
    int lvl = 1;
    int maxl = t->max_level < 20 ? t->max_level : 20;
    while (lvl < maxl && gems >= t->xp[lvl]) lvl++;
    return lvl;
}

static const CLevelTable *hero_table(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.hero_level_up);
}
static const CCombatConfig *combat_config(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.combat_config);
}
static const CPickupConfig *pickup_config(Engine *engine) {
    if (!g_ids.game_config_e) return NULL;
    return ecs_get_id(engine->world, g_ids.game_config_e, g_ids.pickup_config);
}

static float hero_damage_mult(Engine *engine, ecs_entity_t hero_e) {
    const CLevelTable *t = hero_table(engine);
    const CExperience *xp = hero_e ?
        ecs_get_id(engine->world, hero_e, g_ids.experience) : NULL;
    if (!t || !xp) return 1.0f;
    int lvl = xp->level < 1 ? 1 : (xp->level > 20 ? 20 : xp->level);
    return t->damage[lvl - 1];
}

/* â”€â”€ Hit-pair registry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

#define S_NEVER_AGAIN INT64_MAX

static void pairs_reset(void) { g_pair_count = 0; }

static HitPair *pair_find(uint64_t a, uint64_t v) {
    for (int i = 0; i < g_pair_count; i++)
        if (g_pairs[i].attacker == a && g_pairs[i].victim == v)
            return &g_pairs[i];
    return NULL;
}

static void pairs_compact(Engine *engine) {
    int out = 0;
    for (int i = 0; i < g_pair_count; i++) {
        if (g_pairs[i].next_tick != S_NEVER_AGAIN &&
            g_pairs[i].next_tick <= g_tick)
            continue; /* expired window â€” safe to drop */
        if (!ecs_is_alive(engine->world, (ecs_entity_t)g_pairs[i].attacker))
            continue; /* attacker gone */
        g_pairs[out++] = g_pairs[i];
    }
    g_pair_count = out;
}

static bool pair_blocked(uint64_t a, uint64_t v) {
    HitPair *p = pair_find(a, v);
    return p && (p->next_tick == S_NEVER_AGAIN || g_tick < p->next_tick);
}

static void pair_record(Engine *engine, uint64_t a, uint64_t v, float reset_s) {
    HitPair *p = pair_find(a, v);
    /* Unity: ExpirationTick = InterpTick + Ticks(reset) with Ticks(d) =
     * 1 + floor(round(d, 3) * rate) â€” a 0-second reset still blocks for
     * one tick (CollisionDetectionSystem.cs:191-195,
     * GameTimeSystem_FixedStep.cs Ticks()). The round-to-3-decimals
     * absorbs float noise before the floor. */
    int64_t next;
    if (reset_s < 0) {
        next = S_NEVER_AGAIN;
    } else {
        float r = roundf(reset_s * 1000.0f) / 1000.0f;
        next = g_tick + 1 + (int64_t)floorf(r * (float)g_tick_rate);
    }
    if (p) { p->next_tick = next; return; }
    if (g_pair_count >= S_MAX_HITPAIRS) {
        pairs_compact(engine);
        if (g_pair_count >= S_MAX_HITPAIRS) {
            fprintf(stderr, "sashimi: hit-pair registry full (%d)\n",
                    S_MAX_HITPAIRS);
            return; /* loud, not silent: damage still applies, reset lost */
        }
    }
    g_pairs[g_pair_count].attacker = a;
    g_pairs[g_pair_count].victim = v;
    g_pairs[g_pair_count].next_tick = next;
    g_pair_count++;
}

/* â”€â”€ Wave script loader (data/waves.yaml) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

static bool load_waves(Engine *engine) {
    char path[700];
    snprintf(path, sizeof(path), "%s%s/data/waves.yaml",
             engine->sandboxes_dir, engine->sandbox_name);
    FILE *f = fopen(path, "r");
    if (!f) {
        fprintf(stderr, "Error: sashimi waves file not found: %s\n", path);
        return false;
    }
    g_wave_count = 0;
    int entry_count = 0;
    int tick_rate = 60;
    float wave_delay_s = 5.0f;
    char line[512];
    while (fgets(line, sizeof(line), f)) {
        int wnum;
        float fx, fy;
        int dticks;
        char tname[S_TMPL_NAME];
        if (sscanf(line, "tick_rate: %d", &tick_rate) == 1) continue;
        if (sscanf(line, "wave_delay_seconds: %f", &wave_delay_s) == 1) continue;
        if (sscanf(line, "  - wave: %d", &wnum) == 1) {
            if (g_wave_count >= S_MAX_WAVES) break;
            g_waves[g_wave_count].first_entry = entry_count;
            g_waves[g_wave_count].entry_count = 0;
            g_wave_count++;
            continue;
        }
        if (sscanf(line, "      - { template: %63[^,], x: %f, y: %f, delay_ticks: %d",
                   tname, &fx, &fy, &dticks) == 4) {
            if (g_wave_count == 0 || entry_count >= S_MAX_WAVE_ENTRIES) continue;
            WaveEntry *we = &g_wave_entries[entry_count];
            snprintf(we->template_name, S_TMPL_NAME, "%s", tname);
            we->x = fx; we->y = fy; we->delay_ticks = dticks;
            g_waves[g_wave_count - 1].entry_count++;
            entry_count++;
        }
    }
    fclose(f);
    g_wave_delay_ticks = (int)(wave_delay_s * tick_rate + 0.5f);
    if (g_wave_count == 0) {
        fprintf(stderr, "Error: sashimi waves file parsed 0 waves: %s\n", path);
        return false;
    }
    fprintf(stderr, "sashimi: loaded %d waves, %d spawn entries\n",
            g_wave_count, entry_count);
    return true;
}

int sashimi_wave_count(void) { return g_wave_count; }

/* â”€â”€ app_start (Init, once) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* Collapses Unity's bake/bootstrap plus the named-config bridge:
 * game-specific config keys (damage_taken_ratio) that the engine's
 * named-config parser ignores are parsed here from app.yaml and written
 * onto the GameConfig entity (sandboxes/sashimi/CLAUDE.md). */

static void bridge_named_config(Engine *engine) {
    if (!engine->active_config[0]) return;

    char path[700];
    snprintf(path, sizeof(path), "%s%s/app.yaml",
             engine->sandboxes_dir, engine->sandbox_name);
    FILE *f = fopen(path, "r");
    if (!f) return;

    char needle[96];
    snprintf(needle, sizeof(needle), "  %s:", engine->active_config);
    bool in_configs = false, in_block = false;
    char line[512];
    float ratio = -1.0f;
    while (fgets(line, sizeof(line), f)) {
        if (strncmp(line, "configs:", 8) == 0) { in_configs = true; continue; }
        if (in_configs) {
            if (line[0] != ' ' && line[0] != '\n' && line[0] != '#') break;
            if (strncmp(line, needle, strlen(needle)) == 0) {
                in_block = true;
                continue;
            }
            if (in_block && strncmp(line, "  ", 2) == 0 && line[2] != ' ')
                break; /* next named config */
            if (in_block) {
                float v;
                if (sscanf(line, "    damage_taken_ratio: %f", &v) == 1)
                    ratio = v;
            }
        }
    }
    fclose(f);

    if (ratio >= 0.0f && g_ids.game_config_e) {
        CCombatConfig *cc = ecs_get_mut_id(engine->world, g_ids.game_config_e,
                                           g_ids.combat_config);
        if (cc) {
            cc->damage_taken_ratio = ratio;
            ecs_modified_id(engine->world, g_ids.game_config_e,
                            g_ids.combat_config);
            fprintf(stderr,
                    "sashimi: config '%s' -> CombatConfig.damage_taken_ratio %.3g\n",
                    engine->active_config, ratio);
        }
    }
}

static void sashimi_app_start(Engine *engine) {
    if (!ids_resolve(engine)) return;

    /* Seed RNG (drops are the only in-run randomness). FLECS_SEED pins it
     * for reproducible headless runs; unset keeps wall-clock randomness. */
    {
        const char *seed_env = getenv("FLECS_SEED");
        if (seed_env && seed_env[0]) {
            srand((unsigned)strtoul(seed_env, NULL, 10));
        } else {
            static int seed_offset = 0;
            srand((unsigned)time(NULL) + seed_offset++);
        }
    }

    /* Faction matrix. */
    char path[700];
    snprintf(path, sizeof(path), "%s%s/data/faction-matrix.yaml",
             engine->sandboxes_dir, engine->sandbox_name);
    g_matrix_loaded = faction_matrix_load(&g_matrix, path);
    if (!g_matrix_loaded) {
        fprintf(stderr, "Error: sashimi faction matrix failed to load: %s\n",
                path);
        return; /* leave app_start enabled: loud failure every tick */
    }

    /* Wave script. */
    g_waves_loaded = load_waves(engine);
    if (!g_waves_loaded) return;

    /* Spatial hash (cell 0.5 world units, sashimi convention). */
    if (g_hash_ready) spatial_hash_fini(&g_hash);
    spatial_hash_init(&g_hash, 0.5f);
    g_hash_ready = true;

    /* Arena bounds from GameConfig. */
    if (g_ids.game_config_e) {
        const CArenaBounds *b = ecs_get_id(engine->world, g_ids.game_config_e,
                                           g_ids.arena_bounds);
        if (b) g_bounds = *b;
        const CGameTimeConfig *tc = ecs_get_id(engine->world,
                                               g_ids.game_config_e,
                                               g_ids.game_time_config);
        if (tc && tc->tick_rate > 0) {
            g_tick_rate = tc->tick_rate;
            g_dt = 1.0f / (float)tc->tick_rate;
        }
    }

    pairs_reset();
    g_proj_hit_count = 0;

    bridge_named_config(engine);

    engine_system_disable(engine, "app_start");
}

/* â”€â”€ game_time (Init) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* GameTimeSystem_FixedStep + GameTimeSystem_Predicted collapsed: advance
 * GameTime.tick, derive the 0.25 s periodic-clock flag. */

static void sashimi_game_time(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;
    if (!g_ids.game_state_e) return;

    CGameTime *gt = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                   g_ids.game_time);
    if (!gt) return;
    gt->tick++;
    g_tick = gt->tick;
    ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.game_time);

    int periodic_ticks = 15;
    if (g_ids.game_config_e) {
        const CGameTimeConfig *tc = ecs_get_id(engine->world,
                                               g_ids.game_config_e,
                                               g_ids.game_time_config);
        if (tc && tc->tick_rate > 0) {
            g_tick_rate = tc->tick_rate;
            g_dt = 1.0f / (float)tc->tick_rate;
            periodic_ticks = (int)(tc->periodic_tick_time * tc->tick_rate + 0.5f);
            if (periodic_ticks < 1) periodic_ticks = 1;
            if (tc->periodic_tick_time > 0)
                g_periodic_time = tc->periodic_tick_time;
        }
    }
    g_periodic_now = (g_tick % periodic_ticks) == 0;

    /* No shared creature level: live Unity creatures never level (the
     * SpawnCount driver is written only by #if false dead code,
     * CreatureSpawnSystem.cs:14). The CreatureLevelUp table stays loaded
     * (data-faithful) but has no runtime consumer. */

    /* Hero centroid (CameraFollowPointSystem.cs:45-65): average the living
     * heroes' positions; keep the previous value when none are alive
     * (Unity's followCount == 0 early-out). Unity samples pre-move
     * positions of the tick (WorldSimulation, before MoveSystem); reading
     * here in Init sees the same post-move-of-last-tick values. */
    {
        float sx = 0.0f, sy = 0.0f;
        int n = 0;
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.hero }, { .id = g_ids.position }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it)) {
            for (int i = 0; i < it.count; i++) {
                if (is_defeated(engine, it.entities[i])) continue;
                const CVec2 *p = ecs_get_id(engine->world, it.entities[i],
                                            g_ids.position);
                if (!p) continue;
                sx += p->x; sy += p->y; n++;
            }
        }
        ecs_query_fini(q);
        if (n > 0) {
            g_hero_centroid.x = sx / (float)n;
            g_hero_centroid.y = sy / (float)n;
        }
    }

    if ((g_tick % 300) == 0) pairs_compact(engine);
}

/* â”€â”€ hero_ai (Init) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* Headless replacement for ClientGameInputSystem: writes octant-snapped
 * InputDirection onto every hero not possessed by a player. Kite scoring
 * adapted from avk's archer model to continuous space: stay near weapon
 * range of the nearest enemy, avoid enemy proximity, bias toward XP gems
 * always and hearts weighted by missing health.
 *
 * OBSERVABILITY CONTRACT (sandboxes/sashimi/CLAUDE.md "Hero-AI
 * observability contract"): this system stands in for a human player and
 * may only read what a player could observe. Map-global reads of
 * on-field entities (enemies, pickups, positions, visible sizes) and own
 * hero/HUD state are allowed; reading the future is not. Specifically
 * FORBIDDEN here: the wave script (g_waves/g_wave_entries), the spawn
 * director's runtime cursor (WaveState), pre-spawn requests
 * (PendingSpawn â€” entities count only once materialized), RNG state
 * (rand()/seed), and un-telegraphed enemy internals (AbilityState /
 * WeaponState cooldowns, creatures' EnemyTarget). Keep it that way when
 * editing. */

#define AI_LOOKAHEAD_TICKS 18
#define AI_SAFE_RADIUS     2.05f  /* creatures threaten inside this */
#define AI_DANGER_W        140.0f
#define AI_PREF_RANGE      2.45f  /* weapon range 3.0 minus margin */
#define AI_RANGE_W         7.0f
#define AI_GEM_W           3.2f
#define AI_HEART_W         10.0f
#define AI_WALL_MARGIN     1.2f
#define AI_WALL_W          70.0f
#define AI_KEEP_DIR_BONUS  0.35f

static float ai_score(Engine *engine, float px, float py,
                      const UnitSnap *enemies, int n_enemies,
                      const CVec2 *gems, int n_gems,
                      const CVec2 *hearts, int n_hearts,
                      float missing_ratio) {
    (void)engine;
    float score = 0.0f;

    float nearest_e = 1e9f;
    for (int i = 0; i < n_enemies; i++) {
        float d = sqrtf(dist2(px, py, enemies[i].x, enemies[i].y));
        if (d < nearest_e) nearest_e = d;
        float safe = AI_SAFE_RADIUS + enemies[i].radius;
        if (d < safe) {
            float pen = (safe - d);
            score -= AI_DANGER_W * pen * pen;
        }
    }
    if (n_enemies > 0)
        score -= AI_RANGE_W * fabsf(nearest_e - AI_PREF_RANGE);

    if (n_gems > 0) {
        float best = 1e9f;
        for (int i = 0; i < n_gems; i++) {
            float d = sqrtf(dist2(px, py, gems[i].x, gems[i].y));
            if (d < best) best = d;
        }
        score -= AI_GEM_W * best;
    }
    if (n_hearts > 0 && missing_ratio > 0.05f) {
        float best = 1e9f;
        for (int i = 0; i < n_hearts; i++) {
            float d = sqrtf(dist2(px, py, hearts[i].x, hearts[i].y));
            if (d < best) best = d;
        }
        score -= AI_HEART_W * missing_ratio * best;
    }

    float wl = px - g_bounds.min_x, wr = g_bounds.max_x - px;
    float wb = py - g_bounds.min_y, wt = g_bounds.max_y - py;
    float wmin = wl; if (wr < wmin) wmin = wr;
    if (wb < wmin) wmin = wb; if (wt < wmin) wmin = wt;
    if (wmin < AI_WALL_MARGIN) {
        float pen = AI_WALL_MARGIN - wmin;
        score -= AI_WALL_W * pen * pen;
    }
    return score;
}

static void sashimi_hero_ai(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    /* Snapshot heroes needing AI. */
    static ecs_entity_t heroes[16];
    int n_heroes = 0;
    {
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.hero }, { .id = g_ids.input_direction },
                { .id = g_ids.position },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it))
            for (int i = 0; i < it.count && n_heroes < 16; i++)
                heroes[n_heroes++] = it.entities[i];
        ecs_query_fini(q);
    }
    if (n_heroes == 0) return;

    /* Snapshot enemies (creatures) and pickups. */
    static UnitSnap enemies[S_MAX_ENTS];
    int n_enemies = 0;
    {
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.ai_steering }, { .id = g_ids.position },
                { .id = g_ids.health },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it)) {
            for (int i = 0; i < it.count && n_enemies < S_MAX_ENTS; i++) {
                ecs_entity_t e = it.entities[i];
                if (is_defeated(engine, e)) continue;
                const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
                const CHealth *h = ecs_get_id(engine->world, e, g_ids.health);
                if (!p || !h || h->current <= 0) continue;
                const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
                UnitSnap *u = &enemies[n_enemies++];
                u->e = e; u->x = p->x; u->y = p->y;
                u->radius = 0.2f;
                if (c) {
                    if (c->shape == 1) u->radius = c->radius;
                    else if (c->shape == 2)
                        u->radius = (c->width > c->height ? c->width : c->height) * 0.5f;
                }
            }
        }
        ecs_query_fini(q);
    }

    static CVec2 gems[S_MAX_ENTS], hearts[64];
    int n_gems = 0, n_hearts = 0;
    {
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.pickup }, { .id = g_ids.position }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it)) {
            for (int i = 0; i < it.count; i++) {
                const CPickup *pk = ecs_get_id(engine->world, it.entities[i],
                                               g_ids.pickup);
                const CVec2 *p = ecs_get_id(engine->world, it.entities[i],
                                            g_ids.position);
                if (!pk || !p) continue;
                if (pk->effect == 1 && n_gems < S_MAX_ENTS)
                    gems[n_gems++] = *p;
                else if (pk->effect == 2 && n_hearts < 64)
                    hearts[n_hearts++] = *p;
            }
        }
        ecs_query_fini(q);
    }

    static const float OCT[9][2] = {
        { 0, 0 },
        { 1, 0 }, { 0.70710678f, 0.70710678f }, { 0, 1 },
        { -0.70710678f, 0.70710678f }, { -1, 0 },
        { -0.70710678f, -0.70710678f }, { 0, -1 },
        { 0.70710678f, -0.70710678f },
    };

    for (int h = 0; h < n_heroes; h++) {
        ecs_entity_t he = heroes[h];
        if (is_defeated(engine, he)) continue;
        if (g_ids.possessed_by &&
            ecs_has_id(engine->world, he, g_ids.possessed_by))
            continue; /* player-driven: client writes InputDirection */

        const CVec2 *pos = ecs_get_id(engine->world, he, g_ids.position);
        const CMoveSpeed *spd = ecs_get_id(engine->world, he, g_ids.move_speed);
        const CHealth *hp = ecs_get_id(engine->world, he, g_ids.health);
        CVec2 *dir = ecs_get_mut_id(engine->world, he, g_ids.input_direction);
        if (!pos || !spd || !dir) continue;

        float missing = (hp && hp->max > 0)
            ? (hp->max - hp->current) / hp->max : 0.0f;
        float step = spd->value * g_dt * AI_LOOKAHEAD_TICKS;

        float best = -1e30f;
        int best_i = 0;
        for (int c = 0; c < 9; c++) {
            float px = clampf(pos->x + OCT[c][0] * step,
                              g_bounds.min_x + 0.3f, g_bounds.max_x - 0.3f);
            float py = clampf(pos->y + OCT[c][1] * step,
                              g_bounds.min_y + 0.3f, g_bounds.max_y - 0.3f);
            float s = ai_score(engine, px, py, enemies, n_enemies,
                               gems, n_gems, hearts, n_hearts, missing);
            /* mild hysteresis: prefer keeping the current direction */
            if (dir->x == OCT[c][0] && dir->y == OCT[c][1])
                s += AI_KEEP_DIR_BONUS;
            if (s > best) { best = s; best_i = c; }
        }
        dir->x = OCT[best_i][0];
        dir->y = OCT[best_i][1];
        ecs_modified_id(engine->world, he, g_ids.input_direction);
    }
}

/* â”€â”€ start_of_tick (Reset) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* Clears per-tick TookDamage flags (root decision 8: remove, don't set
 * false). Unity's DamageThisTick clearing lives inside ResolveDamage. */

static void sashimi_start_of_tick(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.took_damage) return;

    static ecs_entity_t to_clear[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.took_damage }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            to_clear[n++] = it.entities[i];
    ecs_query_fini(q);
    for (int i = 0; i < n; i++)
        ecs_remove_id(engine->world, to_clear[i], g_ids.took_damage);
}

/* â”€â”€ destroy_on_timer (Reset) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* DestroyGhostOnTimer + DestroyEntityAtTick + DestroyGhost collapsed:
 * tick down DestroyOnTimer, delete expired entities (children cascade). */

static void sashimi_destroy_on_timer(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.destroy_on_timer) return;

    static ecs_entity_t doomed[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.destroy_on_timer }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            CTicks *t = ecs_get_mut_id(engine->world, it.entities[i],
                                       g_ids.destroy_on_timer);
            if (!t) continue;
            t->ticks_remaining--;
            if (t->ticks_remaining <= 0) doomed[n++] = it.entities[i];
        }
    }
    ecs_query_fini(q);
    for (int i = 0; i < n; i++)
        ecs_delete(engine->world, doomed[i]);
}

/* â”€â”€ ability_machine (Reset) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* AbilitySystem + the per-ability systems (Slime/Wolf/Cube attack, Cube
 * charge) collapsed into one data-driven state machine over
 * AbilityConfig/AbilityState. Stage side effects follow the
 * AbilityStateChangeSO tables (CONTENT-ANALYSIS section 3):
 *   BasicAttack: windup disables caster locomotion; active enables the
 *     hitbox collider; recovery disables it; end re-enables locomotion.
 *   Charge (id 1): as above, but windup already enables the collider and
 *     active adds a caster dash impulse (CasterCharge) toward the locked
 *     target: fuel = SASHIMI_CHARGE_DISTANCE, speed = fuel / active
 *     duration (AbilitySystem.cs:936-947).
 *
 * Trigger target (AbilitySystem.cs:510-519): the ready condition measures
 * the distance to the caster's CURRENT EnemyTarget (RecentPosition), not
 * to the nearest enemy â€” a creature whose kept target is out of range
 * does not attack a nearer non-target.
 *
 * Per-caster exclusivity (AbilitySystem.cs:626-750): the caster's
 * ActiveAbility slot admits ONE ability from selection through the end of
 * recovery. When several are ready the same tick, Unity's
 * ActivateActiveAbilityOnCasterJob keeps the LAST ready element of the
 * caster's AbilityElement buffer (:641-654); that buffer is the
 * LinkedEntityGroup REVERSED (AbilityElementBufferInitializationSystem
 * .cs:36), so the winner is the FIRST ready ability in prefab-hierarchy
 * order == this port's template child order (LargeTealCube: attack, then
 * charge â€” attack wins ties). The port picks the lowest-entity-id ready
 * ability per caster: children are created in template child order, so
 * id order == hierarchy order (query/table order is unusable â€” runtime
 * components move abilities between tables over time).
 *
 * Stage timing (GameTimeSystem_FixedStep.cs:78-84 Ticks() = 1 +
 * floor(d * 60); AbilitySystem job ordering): every positive stage and
 * cooldown runs 1 tick longer than nominal, zero-duration stages cascade
 * instantly, and selection precedes windup by exactly one tick (the
 * caster's OnCaster job picks the ability the tick it becomes ready; the
 * per-ability activation job â€” scheduled BEFORE it â€” only sees the pick
 * on the NEXT tick and starts the windup then). A selected ability whose
 * target leaves range before activation stays selected (sticky) until the
 * ready condition holds again â€” Unity's ActiveAbility.Id keeps pointing
 * at it and no other ability may start. */

enum { AB_READY = 0, AB_WINDUP, AB_ACTIVE, AB_RECOVERY, AB_COOLDOWN,
       AB_SELECTED };

/* Nearest living enemy of `attacker_filter` among units; returns distance
 * or -1. Uses the unit snapshot from the most recent spatial pass; callers
 * in the Reset phase see last tick's snapshot, so entries are re-checked
 * against the live world (entities may have despawned in Finalize). */
static float nearest_enemy(Engine *engine, CollisionFilter attacker_filter,
                           float x, float y, ecs_entity_t *out) {
    float best = -1.0f;
    ecs_entity_t best_e = 0;
    for (int i = 0; i < g_unit_count; i++) {
        UnitSnap *u = &g_units[i];
        if (u->defeated || u->health_cur <= 0) continue;
        if (!faction_filter_match(attacker_filter, u->filter)) continue;
        if (!ecs_is_alive(engine->world, u->e) || is_defeated(engine, u->e) ||
            is_out_of_game(engine, u->e))
            continue; /* OOG re-check covers the one-tick snapshot staleness
                         (OOG units are already absent from the snapshot) */
        float d = sqrtf(dist2(x, y, u->x, u->y));
        if (best < 0 || d < best) { best = d; best_e = u->e; }
    }
    if (out) *out = best_e;
    return best;
}

static void ability_set_collider(Engine *engine, ecs_entity_t e, bool on) {
    CCollider *c = ecs_get_mut_id(engine->world, e, g_ids.collider);
    if (!c) return;
    c->enabled = on;
    ecs_modified_id(engine->world, e, g_ids.collider);
}

/* Ability tie-break priority: Unity's winner is the FIRST ability child
 * in prefab-hierarchy order (see the header comment). The one stable
 * runtime source of that order is the caster template's children list
 * (the generator emits it from the prefab's m_Children): parse the
 * caster prefab's entity template YAML once and rank ability children by
 * their child-name position. Entity ids are NOT usable (recycling breaks
 * creation order) and query/children iteration is table order (runtime
 * component adds shuffle it). */
typedef struct {
    ecs_entity_t prefab;
    char names[8][S_TMPL_NAME];
    int n;
} ChildOrder;
static ChildOrder g_child_order[32];
static int g_child_order_count = 0;

static const ChildOrder *child_order_for(Engine *engine, ecs_entity_t prefab) {
    for (int i = 0; i < g_child_order_count; i++)
        if (g_child_order[i].prefab == prefab) return &g_child_order[i];
    if (g_child_order_count >= 32) return NULL;
    ChildOrder *co = &g_child_order[g_child_order_count++];
    memset(co, 0, sizeof(*co));
    co->prefab = prefab;
    const char *pname = ecs_get_name(engine->world, prefab);
    char *yaml = pname
        ? engine_template_get(engine, "entities", pname) : NULL;
    if (yaml) {
        bool in_children = false;
        const char *line = yaml;
        while (line && *line) {
            const char *nl = strchr(line, '\n');
            size_t len = nl ? (size_t)(nl - line) : strlen(line);
            if (strncmp(line, "children:", 9) == 0) {
                in_children = true;
            } else if (in_children && co->n < 8) {
                const char *nm = NULL;
                if (strncmp(line, "  - name:", 9) == 0) nm = line + 9;
                else if (strncmp(line, "- name:", 7) == 0) nm = line + 7;
                if (nm) {
                    while (*nm == ' ') nm++;
                    size_t l = len - (size_t)(nm - line);
                    if (l >= S_TMPL_NAME) l = S_TMPL_NAME - 1;
                    while (l > 0 && (nm[l - 1] == ' ' || nm[l - 1] == '\r'))
                        l--;
                    memcpy(co->names[co->n], nm, l);
                    co->names[co->n][l] = '\0';
                    co->n++;
                }
            }
            line = nl ? nl + 1 : NULL;
        }
        free(yaml);
    }
    return co;
}

/* Lower value = earlier in prefab-hierarchy order = wins selection ties. */
static int ability_child_priority(Engine *engine, ecs_entity_t caster,
                                  ecs_entity_t ab) {
    ecs_entity_t prefab = ecs_get_target(engine->world, caster, EcsIsA, 0);
    if (!prefab) return 1000;
    const ChildOrder *co = child_order_for(engine, prefab);
    if (!co) return 1000;
    const char *nm = ecs_get_name(engine->world, ab);
    if (!nm) return 1000;
    for (int i = 0; i < co->n; i++)
        if (strcmp(co->names[i], nm) == 0) return i;
    return 1000;
}

/* Ready condition on the caster's KEPT target (AbilitySystem.cs:510-519):
 * distance from the caster to its EnemyTarget within [min_range,
 * max_range], inclusive. Live re-validation covers targets that despawned
 * or went out of game since targeting last ran (ability_machine runs in
 * Reset, before this tick's targeting pass). */
static bool ability_target_ready(Engine *engine, ecs_entity_t caster,
                                 const CAbilityConfig *cfg,
                                 ecs_entity_t *out_target) {
    if (out_target) *out_target = 0;
    const CEnemyTarget *ct = ecs_get_id(engine->world, caster,
                                        g_ids.enemy_target);
    if (!ct || !ct->target || !ecs_is_alive(engine->world, ct->target))
        return false;
    if (is_defeated(engine, ct->target) ||
        is_out_of_game(engine, ct->target))
        return false;
    const CVec2 *cp = ecs_get_id(engine->world, caster, g_ids.position);
    const CVec2 *tp = ecs_get_id(engine->world, ct->target, g_ids.position);
    if (!cp || !tp) return false;
    if (out_target) *out_target = ct->target;
    float d = sqrtf(dist2(cp->x, cp->y, tp->x, tp->y));
    return d >= cfg->min_range && d <= cfg->max_range;
}

static void sashimi_ability_machine(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    static ecs_entity_t abilities[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.ability_config }, { .id = g_ids.ability_state }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            abilities[n++] = it.entities[i];
    ecs_query_fini(q);

    /* Phase 0 â€” lazy init (InitializeNewAbilityJob): start_on_cooldown
     * abilities begin their cooldown on their first simulated tick. The
     * -1 offsets the one-tick selection->windup pipeline below so the
     * first possible windup lands exactly where Unity's does. */
    for (int i = 0; i < n; i++) {
        ecs_entity_t ab = abilities[i];
        if (ecs_has_id(engine->world, ab, g_ids.ability_initialized))
            continue;
        ecs_add_id(engine->world, ab, g_ids.ability_initialized);
        const CAbilityConfig *cfg = ecs_get_id(engine->world, ab,
                                               g_ids.ability_config);
        CAbilityState *st = ecs_get_mut_id(engine->world, ab,
                                           g_ids.ability_state);
        if (!cfg || !st) continue;
        if (cfg->start_on_cooldown && cfg->cooldown > 0) {
            st->stage = AB_COOLDOWN;
            st->ticks_remaining = ticks_dur(cfg->cooldown) - 1;
            if (st->ticks_remaining <= 0) {
                st->stage = AB_READY;
                st->ticks_remaining = 0;
            }
            ecs_modified_id(engine->world, ab, g_ids.ability_state);
        }
    }

    /* Phase 1 â€” per-caster selection (ActivateActiveAbilityOnCasterJob):
     * a caster with no running ability picks the FIRST ready ability in
     * template-child (prefab-hierarchy) order == the LAST element of
     * Unity's reversed-LinkedEntityGroup buffer (see the header comment
     * and ability_child_priority). Selection only marks the ability â€” the
     * windup starts on the NEXT tick (phase 2). */
    {
        typedef struct { ecs_entity_t caster, ability; int prio; } Sel;
        static Sel sels[S_MAX_ENTS];
        int n_sel = 0;
        for (int i = 0; i < n; i++) {
            ecs_entity_t ab = abilities[i];
            ecs_entity_t caster = parent_of(engine, ab);
            if (!caster) continue;
            if (is_defeated(engine, caster) || is_out_of_game(engine, caster))
                continue;
            if (ecs_has_id(engine->world, caster, g_ids.active_ability))
                continue;
            const CAbilityConfig *cfg = ecs_get_id(engine->world, ab,
                                                   g_ids.ability_config);
            const CAbilityState *st = ecs_get_id(engine->world, ab,
                                                 g_ids.ability_state);
            if (!cfg || !st || st->stage != AB_READY) continue;
            if (!ability_target_ready(engine, caster, cfg, NULL)) continue;
            int prio = ability_child_priority(engine, caster, ab);
            Sel *s = NULL;
            for (int k = 0; k < n_sel; k++)
                if (sels[k].caster == caster) { s = &sels[k]; break; }
            if (!s && n_sel < S_MAX_ENTS) {
                sels[n_sel++] = (Sel){ caster, ab, prio };
            } else if (s && prio < s->prio) {
                s->ability = ab; /* earlier child wins */
                s->prio = prio;
            }
        }
        for (int k = 0; k < n_sel; k++) {
            CActiveAbility aa = { sels[k].ability };
            ecs_set_id(engine->world, sels[k].caster, g_ids.active_ability,
                       sizeof(aa), &aa);
            CAbilityState *st = ecs_get_mut_id(engine->world, sels[k].ability,
                                               g_ids.ability_state);
            if (!st) continue;
            st->stage = AB_SELECTED;
            st->ticks_remaining = -1; /* selected THIS tick; windup next */
            ecs_modified_id(engine->world, sels[k].ability,
                            g_ids.ability_state);
        }
    }

    /* Phase 2 â€” advance running abilities and cooldowns, allowing
     * zero-duration stages to fall through within one tick (SlimeAttack
     * windup 0). */
    for (int i = 0; i < n; i++) {
        ecs_entity_t ab = abilities[i];
        ecs_entity_t caster = parent_of(engine, ab);
        if (!caster) continue;

        const CAbilityConfig *cfg = ecs_get_id(engine->world, ab,
                                               g_ids.ability_config);
        CAbilityState *st = ecs_get_mut_id(engine->world, ab,
                                           g_ids.ability_state);
        if (!cfg || !st) continue;

        /* Out-of-game casters cannot start or advance abilities: every
         * ability job is [WithDisabled(OutOfGameTimer)] (AbilitySystem.cs
         * throughout) and OOG propagates to the ability children. Same
         * cleanup path as a defeated caster. */
        bool caster_down = is_defeated(engine, caster) ||
                           is_out_of_game(engine, caster);
        if (caster_down) {
            if (st->stage != AB_READY && st->stage != AB_COOLDOWN) {
                ability_set_collider(engine, ab, false);
                ecs_remove_id(engine->world, caster, g_ids.locomotion_disabled);
                ecs_remove_id(engine->world, caster, g_ids.charge_dash);
                ecs_remove_id(engine->world, caster, g_ids.active_ability);
                st->stage = AB_READY;
                st->ticks_remaining = 0;
            }
            ecs_modified_id(engine->world, ab, g_ids.ability_state);
            continue;
        }

        bool is_charge = (cfg->id == 1);

        for (int guard = 0; guard < 6; guard++) {
            if (st->stage == AB_SELECTED) {
                if (st->ticks_remaining < 0) {
                    st->ticks_remaining = 0; /* wait out the selection tick */
                    break;
                }
                /* Sticky selection: activation re-checks the ready
                 * condition each tick (Unity's per-ability activation job
                 * needs AbilityReadyTag again); an out-of-range target
                 * keeps the caster's slot occupied without starting. */
                ecs_entity_t tgt = 0;
                if (!ability_target_ready(engine, caster, cfg, &tgt)) break;

                st->stage = AB_WINDUP;
                st->ticks_remaining =
                    cfg->windup > 0 ? ticks_dur(cfg->windup) : 0;
                ecs_add_id(engine->world, caster, g_ids.locomotion_disabled);
                if (is_charge) {
                    ability_set_collider(engine, ab, true);
                    /* Lock the dash direction at activation toward the
                     * kept target (AbilitySystem.cs:738-748:
                     * state.Direction from the caster's EnemyTarget). */
                    const CVec2 *cp = ecs_get_id(engine->world, caster,
                                                 g_ids.position);
                    const CVec2 *tp = tgt
                        ? ecs_get_id(engine->world, tgt, g_ids.position)
                        : NULL;
                    CChargeDash dash = { 0, 0, 0, 0 };
                    if (cp && tp) {
                        float dx = tp->x - cp->x, dy = tp->y - cp->y;
                        float len = sqrtf(dx * dx + dy * dy);
                        if (len > 1e-6f) {
                            dash.x = dx / len;
                            dash.y = dy / len;
                        }
                    }
                    ecs_set_id(engine->world, ab, g_ids.charge_dash,
                               sizeof(dash), &dash);
                }
                if (st->ticks_remaining > 0) break;
                continue; /* zero windup: fall through */
            }
            if (st->stage == AB_WINDUP) {
                if (st->ticks_remaining > 0) { st->ticks_remaining--; }
                if (st->ticks_remaining > 0) break;
                st->stage = AB_ACTIVE;
                st->ticks_remaining =
                    cfg->active > 0 ? ticks_dur(cfg->active) : 0;
                ability_set_collider(engine, ab, true);
                CHitCount hc = { 0 };
                ecs_set_id(engine->world, ab, g_ids.hit_count, sizeof(hc), &hc);
                if (is_charge) {
                    /* Caster dash impulse: fuel = ImpulseDistance (3.0),
                     * speed = fuel / active duration = 7.5 u/s
                     * (AbilitySystem.cs:936-947). Integrates in movement,
                     * slow-immune. */
                    const CChargeDash *d = ecs_get_id(engine->world, ab,
                                                      g_ids.charge_dash);
                    if (d) {
                        CChargeDash dash = *d;
                        dash.fuel = SASHIMI_CHARGE_DISTANCE;
                        dash.speed = cfg->active > 0
                            ? SASHIMI_CHARGE_DISTANCE / cfg->active
                            : SASHIMI_CHARGE_DISTANCE * (float)g_tick_rate;
                        ecs_set_id(engine->world, caster, g_ids.charge_dash,
                                   sizeof(dash), &dash);
                    }
                }
                if (st->ticks_remaining > 0) break;
                continue;
            }
            if (st->stage == AB_ACTIVE) {
                if (st->ticks_remaining > 0) { st->ticks_remaining--; }
                if (st->ticks_remaining > 0) break;
                st->stage = AB_RECOVERY;
                st->ticks_remaining =
                    cfg->recovery > 0 ? ticks_dur(cfg->recovery) : 0;
                ability_set_collider(engine, ab, false);
                ecs_remove_id(engine->world, caster, g_ids.charge_dash);
                if (st->ticks_remaining > 0) break;
                continue;
            }
            if (st->stage == AB_RECOVERY) {
                if (st->ticks_remaining > 0) { st->ticks_remaining--; }
                if (st->ticks_remaining > 0) break;
                /* End: release the caster's exclusivity slot; the next
                 * selection can happen no earlier than the next tick
                 * (phase 1 already ran this tick â€” Unity's
                 * DeactivateActiveAbilityOnCasterJob likewise runs after
                 * the OnCaster selection job). */
                ecs_remove_id(engine->world, caster, g_ids.locomotion_disabled);
                ecs_remove_id(engine->world, caster, g_ids.active_ability);
                if (cfg->cooldown > 0) {
                    st->stage = AB_COOLDOWN;
                    /* -1: cooldown READY must be visible to selection
                     * exactly Ticks(cd) ticks after the End tick (Unity:
                     * CooldownStartTick = End tick, Expired at
                     * start-of-tick before selection; phase order here
                     * puts the READY flip a tick before selection). */
                    st->ticks_remaining = ticks_dur(cfg->cooldown) - 1;
                    if (st->ticks_remaining > 0) break;
                    /* fall through to READY */
                }
                st->stage = AB_READY;
                st->ticks_remaining = 0;
                break;
            }
            if (st->stage == AB_COOLDOWN) {
                if (st->ticks_remaining > 0) st->ticks_remaining--;
                if (st->ticks_remaining <= 0) {
                    st->stage = AB_READY;
                    st->ticks_remaining = 0;
                }
                break;
            }
            break;
        }
        ecs_modified_id(engine->world, ab, g_ids.ability_state);
    }
}

/* â”€â”€ weapon_fire (Reset) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* ProjectileSpawnRequestSystem: weapons fire their projectile template at
 * the nearest faction-eligible enemy within the projectile's range when
 * the cooldown elapses (WeaponState starts on cooldown, per baker). */

static void sashimi_weapon_fire(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    static ecs_entity_t weapons[256];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.weapon }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 256; i++)
            weapons[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t we = weapons[i];
        ecs_entity_t owner = parent_of(engine, we);
        if (!owner) continue;

        const CWeapon *w = ecs_get_id(engine->world, we, g_ids.weapon);
        if (!w || !w->projectile || !w->projectile[0]) continue;

        /* Cooldown state (lazily added: starts on cooldown). The countdown
         * runs even while the owner is down/out of game: Unity stores an
         * absolute expiry tick (WeaponState.CooldownGameTick,
         * ProjectileSpawnRequestSystem.cs:85,138-139), so a hero back from
         * the 10 s + 2 s respawn window fires as soon as it is in game. */
        int cd_ticks = (int)(w->cooldown * g_tick_rate + 0.5f);
        CWeaponState *ws = ecs_get_mut_id(engine->world, we, g_ids.weapon_state);
        if (!ws) {
            CWeaponState init = { cd_ticks };
            ecs_set_id(engine->world, we, g_ids.weapon_state, sizeof(init), &init);
            continue;
        }
        if (ws->cooldown_ticks > 0) {
            ws->cooldown_ticks--;
            ecs_modified_id(engine->world, we, g_ids.weapon_state);
            if (ws->cooldown_ticks > 0) continue;
        }

        /* Firing gate: a defeated owner cannot act, and an out-of-game
         * owner's weapon is itself OOG (propagated, OutOfGameSystem
         * SetChildrenOOGJob) with its EnemyTarget force-cleared every tick
         * (EnemyTargetingSystem.cs:118-124) â€” so it cannot fire. */
        if (is_defeated(engine, owner) || is_out_of_game(engine, owner))
            continue;

        /* Projectile template stats. */
        ecs_entity_t tmpl = ecs_lookup(engine->world, w->projectile);
        if (!tmpl) continue;
        const CProjectile *pt = ecs_get_id(engine->world, tmpl, g_ids.projectile);
        if (!pt) continue;

        /* Fire position: caster position + weapon offset. */
        const CVec2 *op = ecs_get_id(engine->world, owner, g_ids.position);
        if (!op) continue;
        float fx = op->x, fy = op->y;
        const CVec2 *off = ecs_get_id(engine->world, we, g_ids.child_offset);
        if (off) { fx += off->x; fy += off->y; }

        /* Acquire the nearest enemy within the projectile's range. */
        CollisionFilter wf;
        if (!entity_filter(engine, we, &wf)) continue;
        ecs_entity_t tgt = 0;
        float d = nearest_enemy(engine, wf, fx, fy, &tgt);
        if (d < 0 || d > pt->range || !tgt) continue; /* hold fire, ready */

        const CVec2 *tp = ecs_get_id(engine->world, tgt, g_ids.position);
        if (!tp) continue;
        float dx = tp->x - fx, dy = tp->y - fy;
        float len = sqrtf(dx * dx + dy * dy);
        if (len < 1e-6f) { dx = 1; dy = 0; len = 1; }

        ecs_entity_t proj = engine_entity_spawn(engine, w->projectile, NULL);
        if (!proj) continue;

        CVec2 pos = { fx, fy };
        ecs_set_id(engine->world, proj, g_ids.position, sizeof(pos), &pos);
        CVec2 vel = { dx / len * pt->speed, dy / len * pt->speed };
        ecs_set_id(engine->world, proj, g_ids.velocity, sizeof(vel), &vel);

        /* Unity REPLACES the prefab Piercing/Bouncing with the owner's
         * absolute per-level stats and recomputes HitLimit = Piercing +
         * Bouncing + 1 at projectile spawn
         * (ProjectileLifecycleSystem.cs:167-174). Owners without the
         * stats (creature weapons: wisp) resolve 0/0 -> hit budget 1
         * (TryGetComponent default). Stats from HeroLevelBonus: frog
         * bounce = floor(level / 2), eagle pierce = level, applied from
         * level 1 (LevelUpHeroSpecificSO.cs:53-72,
         * HeroLevelUpSystem.cs:160-212; the (int) cast mirrors Unity's
         * truncation). The serialized template pierce/bounce/hit_limit
         * stay extraction-faithful; runtime overrides them here. */
        int pierce = 0, bounce = 0;
        const CExperience *xp = ecs_get_id(engine->world, owner,
                                           g_ids.experience);
        const CHeroLevelBonus *hb = ecs_get_id(engine->world, owner,
                                               g_ids.hero_level_bonus);
        if (xp && hb) {
            int lvl = xp->level < 1 ? 1 : (xp->level > 20 ? 20 : xp->level);
            pierce = (int)hb->pierce_limit[lvl - 1];
            bounce = (int)hb->bounce_limit[lvl - 1];
        }
        CProjectileRuntime rt = { owner, 0, pierce, bounce, pt->range };
        ecs_set_id(engine->world, proj, g_ids.projectile_runtime,
                   sizeof(rt), &rt);
        CDamageOnHit *pdh = ecs_get_mut_id(engine->world, proj,
                                           g_ids.damage_on_hit);
        if (pdh) {
            pdh->hit_limit = pierce + bounce + 1;
            ecs_modified_id(engine->world, proj, g_ids.damage_on_hit);
        }

        /* Presentation: Unity's ProjectileLifecycleSystem plays the
         * projectile's SpawnSFX (AudioEventType.Spawn) here. */
        emit_event(engine, SASHIMI_EV_WEAPON_FIRED, proj,
                   public_id(engine, owner));

        ws->cooldown_ticks = cd_ticks;
        ecs_modified_id(engine->world, we, g_ids.weapon_state);
    }

    /* One-shot recall spawners (OneShotProjectileSpawnRequestJob,
     * ProjectileSpawnRequestSystem.cs:147-210 â€” the same Unity system as
     * the weapon job above, WorldInit): a spawner armed by the recall
     * pass LAST tick (Act) fires its projectile at its owner now â€” the
     * next-tick delay Unity gets from EffectApplication(T) ->
     * WorldInit(T+1). Fuel = distance(spawner, owner) at fire time
     * (:186); the projectile homes on the owner (ProjectileEntityTracker,
     * :198-199) and the spawner is destroyed (:200). Unity's zero-LTW
     * guard (:174) protects against unplaced netcode ghosts and has no
     * port equivalent (spawners are always placed at spawn). */
    if (g_ids.spawn_one_shot && g_ids.one_shot_spawner &&
        g_ids.spent_projectile_id) {
        static ecs_entity_t armed[256];
        int na = 0;
        ecs_query_t *aq = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.spawn_one_shot },
                { .id = g_ids.one_shot_spawner },
                { .id = g_ids.spent_projectile_id },
                { .id = g_ids.position },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t ait = ecs_query_iter(engine->world, aq);
        while (ecs_query_next(&ait))
            for (int i = 0; i < ait.count && na < 256; i++)
                armed[na++] = ait.entities[i];
        ecs_query_fini(aq);

        for (int i = 0; i < na; i++) {
            ecs_entity_t se = armed[i];
            const COneShotSpawner *os = ecs_get_id(engine->world, se,
                                                   g_ids.one_shot_spawner);
            const CSpentProjectileId *sid =
                ecs_get_id(engine->world, se, g_ids.spent_projectile_id);
            const CVec2 *sp = ecs_get_id(engine->world, se, g_ids.position);
            if (!os || !os->projectile || !os->projectile[0] || !sid || !sp)
                continue;
            /* Owner gone: Unity warns and returns, leaving the spawner
             * armed (:165-169). Heroes are never deleted here, so this is
             * purely defensive. */
            ecs_entity_t owner = sid->owner;
            if (!owner || !ecs_is_alive(engine->world, owner)) continue;
            const CVec2 *op = ecs_get_id(engine->world, owner, g_ids.position);
            if (!op) continue;

            ecs_entity_t tmpl = ecs_lookup(engine->world, os->projectile);
            const CProjectile *pt = tmpl ?
                ecs_get_id(engine->world, tmpl, g_ids.projectile) : NULL;
            if (!pt) continue;

            float dx = op->x - sp->x, dy = op->y - sp->y;
            float fuel = sqrtf(dx * dx + dy * dy);
            /* normalize-or-(1,0), SpawnProjectileJob:198 */
            if (fuel < 1e-6f) { dx = 1; dy = 0; }
            else { dx /= fuel; dy /= fuel; }

            ecs_entity_t proj = engine_entity_spawn(engine, os->projectile,
                                                    NULL);
            if (!proj) continue;
            CVec2 ppos = { sp->x, sp->y };
            ecs_set_id(engine->world, proj, g_ids.position,
                       sizeof(ppos), &ppos);
            CVec2 pvel = { dx * pt->speed, dy * pt->speed };
            ecs_set_id(engine->world, proj, g_ids.velocity,
                       sizeof(pvel), &pvel);

            /* Owner per-level stats REPLACE the serialized base, exactly
             * like the weapon path (ProjectileLifecycleSystem.cs:167-174;
             * the recall projectile serializes IgnoreHitLimit so the hit
             * budget is moot anyway). */
            int pierce = 0, bounce = 0;
            const CExperience *xp = ecs_get_id(engine->world, owner,
                                               g_ids.experience);
            const CHeroLevelBonus *hb = ecs_get_id(engine->world, owner,
                                                   g_ids.hero_level_bonus);
            if (xp && hb) {
                int lvl = xp->level < 1 ? 1 : (xp->level > 20 ? 20 : xp->level);
                pierce = (int)hb->pierce_limit[lvl - 1];
                bounce = (int)hb->bounce_limit[lvl - 1];
            }
            CProjectileRuntime rt = { owner, 0, pierce, bounce, fuel };
            ecs_set_id(engine->world, proj, g_ids.projectile_runtime,
                       sizeof(rt), &rt);
            CDamageOnHit *pdh = ecs_get_mut_id(engine->world, proj,
                                               g_ids.damage_on_hit);
            if (pdh) {
                pdh->hit_limit = pierce + bounce + 1;
                ecs_modified_id(engine->world, proj, g_ids.damage_on_hit);
            }

            CHomingTarget ht = { owner };
            ecs_set_id(engine->world, proj, g_ids.homing_target,
                       sizeof(ht), &ht);

            /* Presentation: the projectile's Spawn SFX plays through the
             * same lifecycle path as weapon projectiles
             * (ProjectileLifecycleSystem.cs:145-152). */
            emit_event(engine, SASHIMI_EV_WEAPON_FIRED, proj,
                       public_id(engine, owner));

            ecs_delete(engine->world, se);
        }
    }
}

/* â”€â”€ spatial_hash (Move) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* SpatialHashingSystem: clear + reinsert every collidable entity (enabled
 * collider), and rebuild the shared unit snapshot used by targeting,
 * steering, abilities and damage this tick. */

static void sashimi_spatial_hash(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_hash_ready || !g_matrix_loaded) return;

    spatial_hash_clear(&g_hash);
    g_unit_count = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.position }, { .id = g_ids.collider }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count; i++) {
            ecs_entity_t e = it.entities[i];
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
            if (!p || !c || c->shape == 0 || !c->enabled) continue;
            /* Weapon colliders are Unity target-acquisition triggers (the
             * wisp weapon's is r=25); acquisition here uses the projectile
             * range instead, and weapons neither deal contact damage nor
             * take hits â€” keep them out of the hash. */
            if (ecs_has_id(engine->world, e, g_ids.weapon)) continue;
            /* I-framed units leave the broadphase for the window: Unity's
             * hash inserts require IFramesTimer disabled
             * (SpatialHashingSystem.cs:44-55), so damage, anti-encroachment
             * and pickup triggering against a just-hit hero are
             * structurally impossible until the window ends. */
            if (g_ids.iframes_timer &&
                ecs_has_id(engine->world, e, g_ids.iframes_timer)) continue;
            /* Out-of-game units (and their propagated children) also leave
             * the broadphase: Unity's unit AND effect inserts both exclude
             * OutOfGameTimer (SpatialHashingSystem.cs:47,53). */
            if (is_out_of_game(engine, e) ||
                is_out_of_game(engine, root_of(engine, e))) continue;
            float hw, hh;
            if (c->shape == 1) { hw = c->radius; hh = c->radius; }
            else { hw = c->width * 0.5f; hh = c->height * 0.5f; }
            if (hw <= 0 && hh <= 0) continue;
            spatial_hash_insert(&g_hash, (uint64_t)e, p->x, p->y, hw, hh);
        }
    }
    ecs_query_fini(q);

    /* Unit snapshot: everything with Health + Position + Faction. */
    ecs_query_t *uq = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.health }, { .id = g_ids.position },
            { .id = g_ids.faction },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t uit = ecs_query_iter(engine->world, uq);
    while (ecs_query_next(&uit)) {
        for (int i = 0; i < uit.count && g_unit_count < S_MAX_ENTS; i++) {
            ecs_entity_t e = uit.entities[i];
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            const CHealth *h = ecs_get_id(engine->world, e, g_ids.health);
            if (!p || !h) continue;
            /* OOG units are absent from the snapshot entirely â€” unlike
             * i-framed units, Unity drops them from targeting too: the
             * JustHeroes query excludes OutOfGameTimer and current-target
             * validation clears OOG targets (EnemyTargetingSystem.cs:37,
             * 118-133). */
            if (is_out_of_game(engine, e)) continue;
            CollisionFilter f;
            if (!entity_filter(engine, e, &f)) continue;
            UnitSnap *u = &g_units[g_unit_count];
            u->e = e; u->x = p->x; u->y = p->y;
            u->filter = f;
            u->is_hero = ecs_has_id(engine->world, e, g_ids.hero);
            u->defeated = is_defeated(engine, e);
            u->iframed = g_ids.iframes_timer &&
                ecs_has_id(engine->world, e, g_ids.iframes_timer);
            u->health_cur = h->current;
            u->health_max = h->max;
            const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
            u->radius = 0.2f;
            if (c) {
                if (c->shape == 1) u->radius = c->radius;
                else if (c->shape == 2)
                    u->radius = (c->width > c->height ? c->width : c->height) * 0.5f;
            }
            g_unit_count++;
        }
    }
    ecs_query_fini(uq);
}

/* â”€â”€ targeting (Move) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* EnemyTargetingSystem: creatures acquire an enemy-faction unit within
 * AISteering.acquire_radius. Unity's candidate loop applies the
 * TargetSwitchThreshold to EVERY sequential comparison
 * (EnemyTargetingSystem.cs:161-190): the current target seeds the
 * best-so-far; a candidate replaces it only when closer by at least the
 * threshold (`distance + threshold > closestDistance` skips). With no
 * current target the FIRST in-range candidate in iteration order wins
 * unless a later one beats it by >= threshold. Unity iterates its hero
 * query order; the port iterates the unit snapshot â€” a different but
 * deterministic order (documented divergence; ties within 0.15 u only). */

static void sashimi_targeting(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    const CCombatConfig *cc = combat_config(engine);
    float switch_thresh = cc ? cc->target_switch_threshold : 0.15f;

    static ecs_entity_t creatures[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.ai_steering }, { .id = g_ids.position }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            creatures[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = creatures[i];
        if (is_defeated(engine, e)) continue;
        const CAISteering *ai = ecs_get_id(engine->world, e, g_ids.ai_steering);
        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        if (!ai || !p) continue;

        /* Creatures target units their harm children could hit â€” i.e.
         * enemy-faction units. Use the unit's own faction: an enemy is a
         * unit whose filter does NOT mutually match ours as same-team
         * push (own color) but is a valid harm target. Simpler and exact
         * for the shipped content: creatures are Unit_Red, they target
         * heroes (Unit_Blue). Generic rule: candidate is a unit of a
         * different filter whose category a Red harm effect may hit. */
        CollisionFilter mine;
        if (!entity_filter(engine, e, &mine)) continue;

        ecs_entity_t cur = 0;
        const CEnemyTarget *ct = ecs_get_id(engine->world, e, g_ids.enemy_target);
        if (ct) cur = ct->target;

        /* Seed the best-so-far with the current target if it is still a
         * valid in-range candidate (EnemyTargetingSystem.cs:131-156). */
        float closest_d = 1e30f;
        ecs_entity_t closest = 0;
        for (int u = 0; cur && u < g_unit_count; u++) {
            UnitSnap *un = &g_units[u];
            if (un->e != cur) continue;
            if (un->defeated || un->health_cur <= 0 || !un->is_hero) break;
            float d = sqrtf(dist2(p->x, p->y, un->x, un->y));
            if (d <= ai->acquire_radius) { closest_d = d; closest = cur; }
            break;
        }

        /* Candidate loop: sequential threshold-buffered comparisons. */
        for (int u = 0; u < g_unit_count; u++) {
            UnitSnap *un = &g_units[u];
            if (un->e == e || un->defeated || un->health_cur <= 0) continue;
            if (!un->is_hero) continue; /* creatures hunt heroes */
            /* No iframed skip: Unity's JustHeroes candidates come from a
             * hero query that only excludes OutOfGameTimer â€” never
             * IFramesTimer â€” and current-target validation does not
             * consult the spatial hash (EnemyTargetingSystem.cs:37,
             * 118-156). I-framed heroes stay targetable. */
            float d = sqrtf(dist2(p->x, p->y, un->x, un->y));
            if (d > ai->acquire_radius) continue;
            if (d + switch_thresh > closest_d) continue; /* buffered (:186) */
            closest_d = d;
            closest = un->e;
        }

        if (closest) {
            CEnemyTarget et = { closest };
            ecs_set_id(engine->world, e, g_ids.enemy_target, sizeof(et), &et);
        } else if (ct) {
            ecs_remove_id(engine->world, e, g_ids.enemy_target);
        }
    }
}

/* â”€â”€ creature_steering (Move) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* CreatureMoveDirectionSystem, trace-exact (CreatureMoveDirectionSystem.cs
 * :84-200). Each creature builds a per-tick WAYPOINT out of two competing
 * offsets and stores a unit direction scaled by its speed in Velocity
 * (movement integrates a full speed * dt step in that direction â€”
 * MoveSystem.cs:196 never reads the waypoint magnitude):
 *
 *  - Follow/flee offset (:107-139): follow position = the kept target's
 *    position, or â€” with NO target â€” the camera follow point == the
 *    hero centroid (:112, g_hero_centroid): the whole arena presses
 *    toward the players. shouldFollow compares against StopFollowDistance
 *    while already moving and StartFollowDistance from standstill (:115);
 *    flee mirrors it gated on StartFleeDistance > 0 (:116 â€” every shipped
 *    creature ships 0/-1, dead code on both sides). The offset magnitude
 *    clamps to min(distance - StopFollowDistance, speed/tick) (:119-138),
 *    aiming exactly at the stop ring; since integration is a full step,
 *    a creature crossing the ring overshoots into it by < one step and
 *    then stops (gated below).
 *  - Ally anti-encroachment offset (:98-101,157-200): query this tick's
 *    pre-move hash with a 1x1 extent (:163), narrowphase real shapes,
 *    select allies via the mutual faction filter {BelongsTo: mine,
 *    CollidesWith: mine} (:170), then normalize(sum(normalize(away))) *
 *    speed/tick (:191-199). This COMPETES with the follow offset inside
 *    one waypoint (:142) â€” separation is steering, not positional
 *    pushback; heroes are never displaced (the job is WithNone<HeroId>
 *    and no system pushes units).
 *
 * MinDistanceToMove gate (:144-148): an aggregate waypoint shorter than
 * MoveConfig.min_distance_to_move * speed/tick produces no motion at all
 * (Velocity zeroed; wasMoving false next tick).
 *
 * Defeated creatures zero their direction (ZeroMoveDirectionForDefeatedJob,
 * MoveSystem.cs:117-126); locomotion-disabled (attacking) creatures still
 * steer â€” MoveSystem's locomotion job is what skips them
 * (WithDisabled(UnitLocomotionDisabled)) â€” so they neither move nor
 * separate while attacking, but the wasMoving hysteresis stays live. */

static void sashimi_creature_steering(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    float min_dist = 0.1f; /* MoveConfig.min_distance_to_move (Adventure) */
    if (g_ids.game_config_e && g_ids.move_config) {
        const CMoveConfig *mc = ecs_get_id(engine->world, g_ids.game_config_e,
                                           g_ids.move_config);
        if (mc) min_dist = mc->min_distance_to_move;
    }

    static ecs_entity_t creatures[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.ai_steering }, { .id = g_ids.position },
            { .id = g_ids.velocity }, { .id = g_ids.move_speed },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            creatures[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = creatures[i];
        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!vel) continue;

        if (is_defeated(engine, e)) {
            vel->x = 0; vel->y = 0;
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }
        if (is_out_of_game(engine, e)) continue; /* WithNone<OutOfGameTimer> */

        const CAISteering *ai = ecs_get_id(engine->world, e, g_ids.ai_steering);
        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        const CMoveSpeed *ms = ecs_get_id(engine->world, e, g_ids.move_speed);
        if (!ai || !p || !ms) continue;

        /* Per-tick step (moveSpeedThisFrame, :99): Unity's
         * MoveSpeedStat.Current already carries the slow modifier, so the
         * clamp/gate math here uses the slowed speed too. */
        float slow_mult = 1.0f;
        const CStatusSlow *slow = ecs_get_id(engine->world, e, g_ids.status_slow);
        if (slow) {
            slow_mult = 1.0f + slow->magnitude;
            if (slow_mult < 0) slow_mult = 0;
        }
        float move_step = ms->value * slow_mult * g_dt;

        bool was_moving = (vel->x != 0 || vel->y != 0);

        /* Ally anti-encroachment offset. */
        float away_x = 0.0f, away_y = 0.0f;
        CollisionFilter mine;
        if (g_hash_ready && entity_filter(engine, e, &mine)) {
            CollisionFilter ally = { mine.belongs, mine.belongs };
            static uint64_t cand[S_MAX_ENTS];
            int n_cand = spatial_hash_query_aabb(&g_hash,
                                                 p->x - 1.0f, p->y - 1.0f,
                                                 p->x + 1.0f, p->y + 1.0f,
                                                 cand, S_MAX_ENTS);
            if (n_cand > S_MAX_ENTS) n_cand = S_MAX_ENTS;
            for (int cix = 0; cix < n_cand; cix++) {
                ecs_entity_t oe = (ecs_entity_t)cand[cix];
                if (oe == e) continue;
                UnitSnap *u = NULL;
                for (int k = 0; k < g_unit_count; k++)
                    if (g_units[k].e == oe) { u = &g_units[k]; break; }
                if (!u || u->defeated) continue;
                if (!faction_filter_match(ally, u->filter)) continue;
                if (!overlap_entities(engine, e, p->x, p->y, oe, u->x, u->y))
                    continue;
                float dx = p->x - u->x, dy = p->y - u->y;
                float len = sqrtf(dx * dx + dy * dy);
                /* Exactly-coincident allies: Unity's normalize(0) NaN
                 * would poison the whole sum to a zero offset; skip the
                 * term instead (deterministic guard, documented). */
                if (len < 1e-6f) continue;
                away_x += dx / len;
                away_y += dy / len;
            }
            float alen = sqrtf(away_x * away_x + away_y * away_y);
            if (alen >= 1e-6f) {
                away_x = away_x / alen * move_step;
                away_y = away_y / alen * move_step;
            } else {
                away_x = 0.0f; away_y = 0.0f;
            }
        }

        /* Follow/flee offset toward the target or the hero centroid. */
        float fpx = g_hero_centroid.x, fpy = g_hero_centroid.y;
        const CEnemyTarget *ct = ecs_get_id(engine->world, e, g_ids.enemy_target);
        if (ct && ct->target && ecs_is_alive(engine->world, ct->target) &&
            !is_defeated(engine, ct->target)) {
            const CVec2 *tp = ecs_get_id(engine->world, ct->target,
                                         g_ids.position);
            if (tp) { fpx = tp->x; fpy = tp->y; }
        }
        float dx = fpx - p->x, dy = fpy - p->y;
        float d = sqrtf(dx * dx + dy * dy);
        bool should_follow = was_moving ? d > ai->stop_follow
                                        : d > ai->start_follow;
        bool should_flee = was_moving
            ? (d < ai->stop_follow && ai->start_flee > 0)
            : d < ai->start_flee;

        float ff_x = 0.0f, ff_y = 0.0f;
        float ffd = should_follow ? d - ai->stop_follow
                  : should_flee  ? ai->stop_follow - d : 0.0f;
        if (ffd > 0 && d > 1e-6f) {
            float sx = should_follow ? dx / d : -dx / d;
            float sy = should_follow ? dy / d : -dy / d;
            float step = ffd > move_step ? move_step : ffd;
            ff_x = sx * step;
            ff_y = sy * step;
        }

        /* Aggregate waypoint + minimum-movement gate. */
        float wx = ff_x + away_x, wy = ff_y + away_y;
        float wlen = sqrtf(wx * wx + wy * wy);
        if (wlen < min_dist * move_step || wlen < 1e-6f) {
            vel->x = 0; vel->y = 0;
        } else {
            vel->x = wx / wlen * ms->value;
            vel->y = wy / wlen * ms->value;
        }
        ecs_modified_id(engine->world, e, g_ids.velocity);
    }
}

/* â”€â”€ pickup_magnet (Move) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* CollisionResponseSystem.HandlePickup (claim) + PickupSystem's move step.
 * Claim: a hero COLLIDER overlapping the pickup's trigger collider claims
 * it (CollisionResponseSystem.cs:207-217 â€” real shapes via the collision
 * pair, e.g. gem circle r=0.75 vs hero rect 0.4x0.25); the claim is
 * permanent (the claimed pickup goes OOG in Unity and can never re-pair).
 * Unity's hash inserts exclude i-framed/OOG heroes but NOT defeated ones
 * â€” a corpse can claim and receive pickups (shipped behavior). Move:
 * speed = Acceleration * ticks-since-claim / rate â€” an UNCAPPED ramp
 * (PickupSystem.cs:136; the baked Pickup.MoveSpeed 5 is dead data) with
 * the step clamped to land exactly on the target (:137). A dead claimant
 * keeps receiving the flight (the job only checks Entity.Null,
 * :122-130): gems still count, hearts heal the corpse. */

static void sashimi_pickup_magnet(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    const CPickupConfig *pc = pickup_config(engine);
    float accel = pc ? pc->acceleration : 40.0f;

    static ecs_entity_t pickups[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.pickup }, { .id = g_ids.position },
            { .id = g_ids.velocity },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            pickups[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = pickups[i];
        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        const CPickup *pk = ecs_get_id(engine->world, e, g_ids.pickup);
        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!p || !pk || !vel) continue;

        CPickupMagnet *mag = ecs_get_mut_id(engine->world, e, g_ids.pickup_magnet);
        if (!mag) {
            /* Claim check: a hero whose collider SHAPE overlaps the
             * pickup's trigger collider. Hash semantics: i-framed and OOG
             * heroes are out of the broadphase (no claim); defeated
             * heroes are NOT excluded â€” corpses claim (shipped Unity). */
            for (int u = 0; u < g_unit_count; u++) {
                UnitSnap *un = &g_units[u];
                if (!un->is_hero || un->iframed) continue;
                if (!overlap_entities(engine, e, p->x, p->y,
                                      un->e, un->x, un->y)) continue;
                CPickupMagnet m = { un->e, 0.0f };
                ecs_set_id(engine->world, e, g_ids.pickup_magnet,
                           sizeof(m), &m);
                break;
            }
            continue;
        }

        /* The claim is permanent: only a deleted claimant (never happens
         * to heroes) drops it. A defeated claimant keeps the flight â€”
         * the pickup completes on the corpse (PickupSystem.cs:122-163). */
        if (!ecs_is_alive(engine->world, mag->hero)) {
            ecs_remove_id(engine->world, e, g_ids.pickup_magnet);
            vel->x = 0; vel->y = 0;
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }
        const CVec2 *hp = ecs_get_id(engine->world, mag->hero, g_ids.position);
        if (!hp) continue;

        /* Uncapped ramp: speed = accel * ticks-since-claim / rate
         * (PickupSystem.cs:136). Pickup.move_speed is dead data. */
        mag->speed += accel * g_dt;
        ecs_modified_id(engine->world, e, g_ids.pickup_magnet);

        float dx = hp->x - p->x, dy = hp->y - p->y;
        float d = sqrtf(dx * dx + dy * dy);
        if (d > 1e-6f) {
            /* Step clamp (:137): never overshoot the claimant â€” the
             * integrated step is min(distance, speed * dt). */
            float eff = mag->speed;
            if (eff * g_dt > d) eff = d / g_dt;
            vel->x = dx / d * eff;
            vel->y = dy / d * eff;
        } else {
            vel->x = 0; vel->y = 0;
        }
        ecs_modified_id(engine->world, e, g_ids.velocity);
    }
}

/* â”€â”€ movement (Move) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* MoveSystem: heroes integrate InputDirection * MoveSpeed; creatures and
 * pickups integrate the Velocity written by steering/magnet. StatusSlow
 * multiplies locomotion (1 + magnitude, floored at 0) â€” never dash
 * impulses (MoveSystem.cs:135-168, HandleImpulseJob reads no
 * MoveSpeedStat). Units (entities with Health) are clamped to
 * ArenaBounds, and heroes additionally clamp to the co-op camera tether
 * rect (ClampHeroToScreen, :205-228). Projectiles integrate HERE too â€” Unity
 * moves them inside MoveSystem (HandleMoveProjectileJob,
 * MoveSystem.cs:230-328), before collision/damage, so this tick's damage
 * checks run against post-move projectile positions. The final step is
 * clamped to the remaining flight fuel (:281-294) and positions clamp to
 * MapBounds (:296): projectiles wall-slide until the fuel is out, never
 * culled at the bounds. Bounce/spend/spawner logic stays in
 * projectile_lifecycle (Unity splits the same way). */

static void sashimi_movement(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t movers[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.position }, { .id = g_ids.velocity }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            movers[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = movers[i];
        if (ecs_has_id(engine->world, e, g_ids.projectile)) {
            /* Projectile flight (HandleMoveProjectileJob). */
            const CProjectile *pt = ecs_get_id(engine->world, e,
                                               g_ids.projectile);
            CProjectileRuntime *rt = ecs_get_mut_id(engine->world, e,
                                                    g_ids.projectile_runtime);
            CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
            CVec2 *pos = ecs_get_mut_id(engine->world, e, g_ids.position);
            if (!pt || !rt || !vel || !pos) continue;
            if (rt->dist_left <= 0) continue; /* spent: lifecycle deletes */

            /* Homing tracker (recall projectiles; Unity
             * HandleMoveProjectileJob's ProjectileEntityTracker branch,
             * MoveSystem.cs:250-261): re-aim at the tracked entity every
             * tick, clamp the fuel DOWN to the target distance (it never
             * grows back if the target flees), and never overshoot the
             * target this tick (moveDistance = min(step, targetDistance)).
             * A dead tracker reads as position (0,0) â€” Unity's default
             * LocalToWorld lookup â€” unreachable here (heroes persist). */
            float step = pt->speed * g_dt;
            const CHomingTarget *ht = g_ids.homing_target ?
                ecs_get_id(engine->world, e, g_ids.homing_target) : NULL;
            if (ht) {
                float tx = 0.0f, ty = 0.0f;
                if (ht->target && ecs_is_alive(engine->world, ht->target)) {
                    const CVec2 *tp = ecs_get_id(engine->world, ht->target,
                                                 g_ids.position);
                    if (tp) { tx = tp->x; ty = tp->y; }
                }
                float dx = tx - pos->x, dy = ty - pos->y;
                float td = sqrtf(dx * dx + dy * dy);
                if (rt->dist_left > td) rt->dist_left = td;
                if (td < 1e-6f) {
                    /* On top of the target: fuel is now 0; the zero
                     * heading despawns it in projectile_lifecycle
                     * (MoveSystem.cs:270-277). */
                    vel->x = 0; vel->y = 0;
                    ecs_modified_id(engine->world, e, g_ids.velocity);
                    ecs_modified_id(engine->world, e, g_ids.projectile_runtime);
                    continue;
                }
                vel->x = dx / td * pt->speed;
                vel->y = dy / td * pt->speed;
                if (step > td) step = td;
            }

            float len = sqrtf(vel->x * vel->x + vel->y * vel->y);
            if (len < 1e-6f) continue;       /* zero direction: lifecycle
                                                spends it (MoveSystem.cs:
                                                270-277) */
            /* Clamp the final step to the remaining fuel; the projectile
             * still moves (and can still hit) this tick, then range
             * expiry spends it in projectile_lifecycle. */
            if (step >= rt->dist_left) step = rt->dist_left;
            pos->x += vel->x / len * step;
            pos->y += vel->y / len * step;
            pos->x = clampf(pos->x, g_bounds.min_x, g_bounds.max_x);
            pos->y = clampf(pos->y, g_bounds.min_y, g_bounds.max_y);
            rt->dist_left -= step;
            ecs_modified_id(engine->world, e, g_ids.position);
            ecs_modified_id(engine->world, e, g_ids.projectile_runtime);
            if (ht) ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }
        if (is_defeated(engine, e)) continue;
        /* Out-of-game units do not move at all â€” input and impulses are
         * ignored while the window runs (MoveSystem.cs:103,130,172 all
         * exclude OutOfGameTimer); clients/hero_ai still write
         * InputDirection, which is integrated again once back in game. */
        if (is_out_of_game(engine, e)) continue;

        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!vel) continue;

        /* Heroes: InputDirection * MoveSpeed. */
        const CVec2 *in = ecs_get_id(engine->world, e, g_ids.input_direction);
        if (in) {
            const CMoveSpeed *ms = ecs_get_id(engine->world, e, g_ids.move_speed);
            float spd = ms ? ms->value : 0.0f;
            vel->x = in->x * spd;
            vel->y = in->y * spd;
        }

        /* Locomotion velocity: gated by the locomotion lock and scaled by
         * the slow modifier (Unity: MoveSpeedStat.Current). */
        bool loco_off = ecs_has_id(engine->world, e, g_ids.locomotion_disabled);
        float vx = vel->x, vy = vel->y;
        if (loco_off) { vx = 0; vy = 0; }
        const CStatusSlow *slow = ecs_get_id(engine->world, e, g_ids.status_slow);
        if (slow) {
            float mult = 1.0f + slow->magnitude;
            if (mult < 0) mult = 0;
            vx *= mult; vy *= mult;
        }

        /* Dash impulse (HandleImpulseJob, MoveSystem.cs:135-168):
         * fuel-limited step = min(speed * dt, fuel), integrated on TOP of
         * (and independent of) locomotion â€” it runs for locomotion-locked
         * casters and NEVER reads MoveSpeedStat, so slows do not scale a
         * dash. Spent impulses are removed. */
        float ix = 0.0f, iy = 0.0f;
        CChargeDash *dash = ecs_get_mut_id(engine->world, e, g_ids.charge_dash);
        bool dash_spent = false;
        if (dash) {
            float step = dash->speed * g_dt;
            if (step > dash->fuel) step = dash->fuel;
            if (step > 0) {
                ix = dash->x * step;
                iy = dash->y * step;
                dash->fuel -= step;
            }
            if (dash->fuel <= 1e-6f) dash_spent = true;
            else ecs_modified_id(engine->world, e, g_ids.charge_dash);
        }
        if (dash_spent)
            ecs_remove_id(engine->world, e, g_ids.charge_dash);

        float mx = vx * g_dt + ix, my = vy * g_dt + iy;
        if (mx == 0 && my == 0) {
            ecs_modified_id(engine->world, e, g_ids.velocity);
            continue;
        }

        CVec2 *pos = ecs_get_mut_id(engine->world, e, g_ids.position);
        if (!pos) continue;
        pos->x += mx;
        pos->y += my;
        if (ecs_has_id(engine->world, e, g_ids.health)) {
            pos->x = clampf(pos->x, g_bounds.min_x, g_bounds.max_x);
            pos->y = clampf(pos->y, g_bounds.min_y, g_bounds.max_y);
        }
        ecs_modified_id(engine->world, e, g_ids.position);
        ecs_modified_id(engine->world, e, g_ids.velocity);
    }

    /* ClampHeroToScreen (MoveSystem.cs:205-228): after integration, every
     * hero â€” defeated and out-of-game included (the job filters only
     * Simulate/DestroyGhostTag) â€” clamps to a camera-relative rect around
     * the follow point (the hero centroid, sampled pre-move this tick):
     * x within +-5.5, y within [-2.5, +3]. Solo this is inert (the
     * centroid IS the hero, pre-move, and one step never exceeds the
     * rect); in co-op it tethers the pair to <= 11 x 5.5 â€” and drags a
     * downed hero's corpse along the rect edge as the living hero walks
     * away. */
    {
        static ecs_entity_t heroes[16];
        int nh = 0;
        ecs_query_t *hq = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.hero }, { .id = g_ids.position }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t hit = ecs_query_iter(engine->world, hq);
        while (ecs_query_next(&hit))
            for (int i = 0; i < hit.count && nh < 16; i++)
                heroes[nh++] = hit.entities[i];
        ecs_query_fini(hq);

        for (int i = 0; i < nh; i++) {
            CVec2 *pos = ecs_get_mut_id(engine->world, heroes[i],
                                        g_ids.position);
            if (!pos) continue;
            float sx = pos->x - g_hero_centroid.x;
            float sy = pos->y - g_hero_centroid.y;
            float mx2 = 0.0f, my2 = 0.0f;
            if (sx < -5.5f) mx2 = -(sx + 5.5f);
            if (sx >  5.5f) mx2 = -(sx - 5.5f);
            if (sy < -2.5f) my2 = -(sy + 2.5f);
            if (sy >  3.0f) my2 = -(sy - 3.0f);
            if (mx2 != 0.0f || my2 != 0.0f) {
                pos->x += mx2;
                pos->y += my2;
                ecs_modified_id(engine->world, heroes[i], g_ids.position);
            }
        }
    }
}

/* â”€â”€ child_offset_sync (Move) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* GameplayChildOffsetSyncSystem: children (weapons, hitboxes, auras) sit
 * at parent position + offset every tick. Unity does NOT rotate offsets:
 * GameplayParentOffset.Rotate is an X-MIRROR â€” if the direction to the
 * parent's EnemyTarget has x < 0, offset.x flips sign; y is untouched
 * (GameplayParentAuthoring.cs:20-29). The direction is measured from the
 * CHILD's world position (GameplayChildOffsetSyncSystem.cs:66-70). The
 * whole sync SKIPS while the parent's locomotion is disabled (:57-61) â€”
 * melee aim locks at windup start (the lock lands in Reset, before this
 * pass) and stays frozen through recovery. Unity children are transform
 * children whose frozen LOCAL offset still rides the parent, so the
 * frozen state here is the flip flag (ChildOffsetFlipped marker), and the
 * child keeps tracking parent position + frozen offset. */

static void sashimi_child_offset_sync(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t children[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.child_offset }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            children[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = children[i];
        ecs_entity_t parent = parent_of(engine, e);
        if (!parent) continue;
        const CVec2 *pp = ecs_get_id(engine->world, parent, g_ids.position);
        const CVec2 *off = ecs_get_id(engine->world, e, g_ids.child_offset);
        if (!pp || !off) continue;

        /* Aim update only while the parent's locomotion is enabled. With
         * no (valid) target Unity applies the RAW offset â€” the flip
         * resets (GameplayChildOffsetSyncSystem.cs:62-71). */
        if (!ecs_has_id(engine->world, parent, g_ids.locomotion_disabled)) {
            bool flip = false;
            const CEnemyTarget *ct = ecs_get_id(engine->world, parent,
                                                g_ids.enemy_target);
            if (ct && ct->target && ecs_is_alive(engine->world, ct->target)) {
                const CVec2 *tp = ecs_get_id(engine->world, ct->target,
                                             g_ids.position);
                const CVec2 *cp = ecs_get_id(engine->world, e, g_ids.position);
                float fromx = cp ? cp->x : pp->x;
                if (tp) flip = (tp->x - fromx < 0);
            }
            if (flip)
                ecs_add_id(engine->world, e, g_ids.offset_flipped);
            else
                ecs_remove_id(engine->world, e, g_ids.offset_flipped);
        }

        float ox = off->x, oy = off->y;
        if (ecs_has_id(engine->world, e, g_ids.offset_flipped))
            ox = -ox;
        CVec2 np = { pp->x + ox, pp->y + oy };
        ecs_set_id(engine->world, e, g_ids.position, sizeof(np), &np);
    }
}

/* â”€â”€ collision_push (Act) â€” RETIRED, intentional no-op â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* Unity has NO unit-unit positional pushback anywhere: crowd separation
 * is ally-only anti-encroachment steering folded into
 * CreatureMoveDirectionSystem (:157-200 â€” see creature_steering, slot 11),
 * which never displaces heroes or attacking creatures. The old push here
 * was a port-invented mechanism (SYSTEMS.md:95 mis-described the game).
 * The system stays registered and in app.yaml's system_order only because
 * app.yaml is generator-emitted and the extraction JSON is absent on this
 * machine (regeneration impossible); drop this slot from
 * tools/generate_content.py's system_order, the registration below, and
 * app.yaml together at the next regeneration. */

static void sashimi_collision_push(Engine *engine) {
    (void)engine; /* intentional no-op â€” see the retirement note above */
}

/* â”€â”€ damage_apply (Act) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* CollisionDetection (trigger path) + ApplyDamage + OnHitEffect +
 * ResolveDamage collapsed: every enabled harm collider (ability hitboxes,
 * projectiles) and â€” on the periodic clock â€” every PeriodicDamage aura
 * tests faction-eligible unit overlap and applies damage.
 *
 *  - Damage scales with the attacker's damage multiplier (hero level table
 *    via the projectile's shooter; creature level table for creature
 *    hitboxes).
 *  - Hero victims: incoming damage *= CombatConfig.damage_taken_ratio
 *    (port-added; 1.0 = shipped behavior), i-frames block hits and a fresh
 *    hit starts the i-frames window.
 *  - DamageOnHit.reset_time gates per-(attacker,victim) re-hits;
 *    hit_limit caps victims per activation (HitCount) / flight
 *    (ProjectileRuntime).
 *  - StatusEffectOnHit applies poison (periodic damage) and/or the
 *    move-speed modifier (strongest-only stacking). */

typedef struct {
    ecs_entity_t attacker;
    float x, y;
    float hw, hh;                 /* collider half extents */
    bool is_rect;
    float damage;
    int hit_limit;
    bool ignore_hit_limit;
    float reset_time;
    CollisionFilter filter;
    bool is_projectile;
    bool is_periodic;
    ecs_entity_t shooter;         /* projectile shooter (hero) */
    ecs_entity_t owner_root;      /* hitbox root (creature) */
    bool has_status;
    CStatusEffectOnHit status;
} Attacker;

static bool overlap_attacker_unit(const Attacker *a, const UnitSnap *u,
                                  Engine *engine) {
    /* Victim shape from its collider. */
    const CCollider *c = ecs_get_id(engine->world, u->e, g_ids.collider);
    bool u_rect = c && c->shape == 2;
    float ur = u->radius;
    float uhw = u_rect ? c->width * 0.5f : ur;
    float uhh = u_rect ? c->height * 0.5f : ur;

    if (!a->is_rect && !u_rect)
        return overlap_circle_circle(a->x, a->y, a->hw, u->x, u->y, ur);
    if (a->is_rect && !u_rect)
        return overlap_circle_rect(u->x, u->y, ur, a->x, a->y, a->hw, a->hh);
    if (!a->is_rect && u_rect)
        return overlap_circle_rect(a->x, a->y, a->hw, u->x, u->y, uhw, uhh);
    return overlap_aabb_aabb(a->x - a->hw, a->y - a->hh, a->x + a->hw,
                             a->y + a->hh, u->x - uhw, u->y - uhh,
                             u->x + uhw, u->y + uhh);
}

static void apply_status(Engine *engine, ecs_entity_t victim,
                         const CStatusEffectOnHit *s, float dmg_mult) {
    if (s->periodic_damage > 0) {
        /* Unity per-periodic-tick poison = PeriodicDamage *
         * PeriodicTickTime / Duration (StatusEffectsSystem.cs:294):
         * shuriken 30 * 0.25 / 3 = 2.5 per pulse, ~PeriodicDamage total
         * over the duration. The shooter's damage multiplier scales
         * PeriodicDamage at projectile spawn
         * (ProjectileLifecycleSystem.cs:183-191); the slow magnitude is
         * never scaled. */
        float per_tick = s->periodic_damage * dmg_mult;
        if (s->duration > 0)
            per_tick = per_tick * g_periodic_time / s->duration;
        CStatusPoison p = {
            (int)(s->duration * g_tick_rate + 0.5f), per_tick };
        /* StackLimit 1 + IgnoreStacks: reapplication refreshes. */
        ecs_set_id(engine->world, victim, g_ids.status_poison, sizeof(p), &p);
    }
    if (s->stat_type == 1 && s->magnitude != 0) {
        CStatusSlow cur;
        const CStatusSlow *have = ecs_get_id(engine->world, victim,
                                             g_ids.status_slow);
        int dur = (int)(s->duration * g_tick_rate + 0.5f);
        /* Strongest-only (MultiplyBuff/DebuffStrongest): keep the larger
         * absolute magnitude; equal magnitude refreshes duration. */
        if (!have || fabsf(s->magnitude) >= fabsf(have->magnitude)) {
            cur.ticks_remaining = dur;
            cur.magnitude = s->magnitude;
            ecs_set_id(engine->world, victim, g_ids.status_slow,
                       sizeof(cur), &cur);
        }
    }
}

/* Per-hit application for non-hero victims (hits SUM; hero hits collapse
 * to the tick MAX at resolution, see sashimi_damage_apply). */
static void deal_damage(Engine *engine, ecs_entity_t victim, float amount) {
    if (amount <= 0) return; /* ResolveDamageSystem.cs:121 */
    CHealth *h = ecs_get_mut_id(engine->world, victim, g_ids.health);
    if (!h) return;
    h->current -= amount;
    ecs_modified_id(engine->world, victim, g_ids.health);
    ecs_add_id(engine->world, victim, g_ids.took_damage);
}

static void sashimi_damage_apply(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    g_proj_hit_count = 0;

    const CCombatConfig *cc = combat_config(engine);
    float taken_ratio = cc ? cc->damage_taken_ratio : 1.0f;

    /* Collect attackers (no mutations while iterating). */
    static Attacker attackers[S_MAX_ENTS];
    int n_att = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.damage_on_hit }, { .id = g_ids.collider },
            { .id = g_ids.position },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n_att < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            const CDamageOnHit *dh = ecs_get_id(engine->world, e,
                                                g_ids.damage_on_hit);
            if (!c || !p || !dh || c->shape == 0 || !c->enabled) continue;

            ecs_entity_t root = root_of(engine, e);
            if (root != e && is_defeated(engine, root)) continue;
            /* OOG roots' harm children are OOG themselves (propagated) and
             * excluded from Unity's effect hash inserts
             * (SpatialHashingSystem.cs:53): they deal nothing. */
            if (is_out_of_game(engine, root)) continue;

            Attacker *a = &attackers[n_att];
            memset(a, 0, sizeof(*a));
            a->attacker = e;
            a->x = p->x; a->y = p->y;
            a->is_rect = (c->shape == 2);
            a->hw = a->is_rect ? c->width * 0.5f : c->radius;
            a->hh = a->is_rect ? c->height * 0.5f : c->radius;
            a->damage = dh->damage;
            a->hit_limit = dh->hit_limit;
            a->ignore_hit_limit = dh->ignore_hit_limit;
            /* All four ability hitbox prefabs serialize
             * OnHitDamageTrigger.IgnoreHitLimit = 1 (prefab-variant
             * overrides, e.g. SlimeAttack_Ability.prefab): unlimited
             * victims per activation; per-victim re-hits stay gated by
             * the pair registry (CollisionResetTime). The generated YAML
             * still carries the legacy hit_limit fields â€” the generator
             * fix is in generate_content.py but the extraction JSON is
             * absent on this machine, so regeneration is pending and the
             * override lives here at runtime. */
            if (ecs_has_id(engine->world, e, g_ids.ability_config))
                a->ignore_hit_limit = true;
            a->reset_time = dh->reset_time;
            if (!entity_filter(engine, e, &a->filter)) continue;
            const CProjectileRuntime *rt = ecs_get_id(engine->world, e,
                                                      g_ids.projectile_runtime);
            a->is_projectile = rt != NULL;
            a->shooter = rt ? rt->shooter : 0;
            a->owner_root = root;
            const CStatusEffectOnHit *s = ecs_get_id(engine->world, e,
                                                     g_ids.status_on_hit);
            if (s) { a->has_status = true; a->status = *s; }
            n_att++;
        }
    }
    ecs_query_fini(q);

    /* Periodic damage auras, on the 0.25 s clock only. */
    if (g_periodic_now) {
        ecs_query_t *pq = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.periodic_damage }, { .id = g_ids.collider },
                { .id = g_ids.position },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t pit = ecs_query_iter(engine->world, pq);
        while (ecs_query_next(&pit)) {
            for (int i = 0; i < pit.count && n_att < S_MAX_ENTS; i++) {
                ecs_entity_t e = pit.entities[i];
                const CCollider *c = ecs_get_id(engine->world, e, g_ids.collider);
                const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
                const CPeriodicDamage *pd = ecs_get_id(engine->world, e,
                                                       g_ids.periodic_damage);
                if (!c || !p || !pd || c->shape == 0 || !c->enabled) continue;
                if (ecs_has_id(engine->world, e, g_ids.damage_on_hit))
                    continue; /* already collected as an on-hit attacker */
                Attacker *a = &attackers[n_att];
                memset(a, 0, sizeof(*a));
                a->attacker = e;
                a->x = p->x; a->y = p->y;
                a->is_rect = (c->shape == 2);
                a->hw = a->is_rect ? c->width * 0.5f : c->radius;
                a->hh = a->is_rect ? c->height * 0.5f : c->radius;
                a->damage = pd->damage;
                a->hit_limit = 0;
                a->ignore_hit_limit = true;
                a->reset_time = 0; /* every periodic tick */
                if (!entity_filter(engine, e, &a->filter)) continue;
                a->is_periodic = true;
                a->owner_root = root_of(engine, e);
                if (is_out_of_game(engine, a->owner_root)) continue;
                n_att++;
            }
        }
        ecs_query_fini(pq);
    }

    /* Apply. Hero victims collapse same-tick hits to the MAX
     * (ApplyDamageSystem.cs:97-110 â€” "We only apply the highest damage
     * applied this tick to heroes"); author-confirmed intent: heroes gain
     * brief invulnerability on taking damage, enemies do not, so hero
     * same-tick hits collapse while non-hero damage sums. Every landing
     * attacker still runs full bookkeeping (pair entry, hit budget,
     * statuses, events) exactly as Unity records every landed hit. */
    typedef struct { ecs_entity_t hero; float max_hit; } HeroHit;
    static HeroHit hero_hits[16];
    int n_hero_hits = 0;

    for (int i = 0; i < n_att; i++) {
        Attacker *a = &attackers[i];

        /* Current hit budget. */
        int hits = 0;
        if (a->is_projectile) {
            const CProjectileRuntime *rt = ecs_get_id(engine->world, a->attacker,
                                                      g_ids.projectile_runtime);
            hits = rt ? rt->hits : 0;
        } else if (!a->is_periodic) {
            const CHitCount *hc = ecs_get_id(engine->world, a->attacker,
                                             g_ids.hit_count);
            hits = hc ? hc->hits : 0;
        }
        if (!a->ignore_hit_limit && a->hit_limit > 0 && hits >= a->hit_limit)
            continue;

        /* Broadphase candidates. */
        static uint64_t cand[S_MAX_ENTS];
        float ext = (a->hw > a->hh ? a->hw : a->hh) + S_BROADPHASE_SLOP;
        int n_cand = spatial_hash_query_radius(&g_hash, a->x, a->y, ext,
                                               cand, S_MAX_ENTS);
        if (n_cand > S_MAX_ENTS) n_cand = S_MAX_ENTS;

        for (int cix = 0; cix < n_cand; cix++) {
            ecs_entity_t ve = (ecs_entity_t)cand[cix];
            if (ve == a->attacker) continue;

            /* Victim must be a live unit. HP <= 0 does NOT skip: Unity
             * overkill hits still land (pair entry + hit-budget spend)
             * until DefeatSystem marks the victim next resolution. */
            UnitSnap *u = NULL;
            for (int k = 0; k < g_unit_count; k++)
                if (g_units[k].e == ve) { u = &g_units[k]; break; }
            if (!u || u->defeated) continue;
            const CHealth *h = ecs_get_id(engine->world, ve, g_ids.health);
            if (!h) continue;
            if (!faction_filter_match(a->filter, u->filter)) continue;

            /* Refresh victim position (may have moved since snapshot). */
            const CVec2 *vp = ecs_get_id(engine->world, ve, g_ids.position);
            UnitSnap uu = *u;
            if (vp) { uu.x = vp->x; uu.y = vp->y; }
            if (!overlap_attacker_unit(a, &uu, engine)) continue;

            if (pair_blocked((uint64_t)a->attacker, (uint64_t)ve)) continue;

            bool victim_hero = u->is_hero;
            /* I-framed victims never reach this point: they are absent
             * from the spatial hash (see spatial_hash), so they cannot be
             * broadphase candidates. The snapshot flag is a backstop. */
            if (u->iframed) continue;

            /* Only projectile spawns read the owner's DamageMultiplierStat
             * in Unity (ProjectileLifecycleSystem.cs:177-191); creature
             * melee/ability hitbox damage is NEVER multiplier-scaled. */
            float mult = 1.0f;
            if (a->shooter && ecs_is_alive(engine->world, a->shooter) &&
                ecs_has_id(engine->world, a->shooter, g_ids.hero))
                mult = hero_damage_mult(engine, a->shooter);

            float dmg = a->damage * mult;

            if (victim_hero) {
                /* Record for the MAX resolution below; HP is untouched
                 * until every attacker this tick has landed. */
                HeroHit *hh = NULL;
                for (int k = 0; k < n_hero_hits; k++)
                    if (hero_hits[k].hero == ve) { hh = &hero_hits[k]; break; }
                if (!hh && n_hero_hits < 16) {
                    hh = &hero_hits[n_hero_hits++];
                    hh->hero = ve;
                    hh->max_hit = 0.0f;
                }
                if (hh && dmg > hh->max_hit) hh->max_hit = dmg;
            } else {
                deal_damage(engine, ve, dmg);
            }
            pair_record(engine, (uint64_t)a->attacker, (uint64_t)ve,
                        a->reset_time);
            if (a->has_status) apply_status(engine, ve, &a->status, mult);

            /* Presentation: Unity's PresentDamageSystem plays the
             * attacker's Impact clip; PresentUnitAnimationSystem plays the
             * victim's Hurt VO (heroes only have Hurt clips). The HIT
             * subject is the projectile itself (its own HitSFX) or the
             * attacking unit root (its Impact clip) for ability hitboxes. */
            emit_event(engine, SASHIMI_EV_HIT,
                       a->is_projectile ? a->attacker : a->owner_root,
                       public_id(engine, ve));

            hits++;
            if (a->is_projectile) {
                CProjectileRuntime *rt = ecs_get_mut_id(engine->world,
                                                        a->attacker,
                                                        g_ids.projectile_runtime);
                if (rt) {
                    rt->hits = hits;
                    ecs_modified_id(engine->world, a->attacker,
                                    g_ids.projectile_runtime);
                }
                if (g_proj_hit_count < S_MAX_PROJ_HITS) {
                    g_proj_hits[g_proj_hit_count].projectile = a->attacker;
                    g_proj_hits[g_proj_hit_count].victim = ve;
                    g_proj_hit_count++;
                }
            } else if (!a->is_periodic) {
                CHitCount hc = { hits };
                ecs_set_id(engine->world, a->attacker, g_ids.hit_count,
                           sizeof(hc), &hc);
            }

            if (!a->ignore_hit_limit && a->hit_limit > 0 &&
                hits >= a->hit_limit)
                break;
        }
    }

    /* Hero resolution: apply the MAX of this tick's hits, scaled by the
     * victim-side damage_taken_ratio (port knob). I-frames start here â€”
     * at resolution, after every same-tick attacker landed â€” and only
     * when the resolved damage is > 0 (ResolveDamageSystem.cs:121,
     * 151-156: no damage reaction and no i-frames on a <= 0 resolve). */
    for (int i = 0; i < n_hero_hits; i++) {
        ecs_entity_t he = hero_hits[i].hero;
        float dmg = hero_hits[i].max_hit * taken_ratio;
        if (dmg <= 0) continue;
        CHealth *h = ecs_get_mut_id(engine->world, he, g_ids.health);
        if (!h) continue;
        h->current -= dmg;
        ecs_modified_id(engine->world, he, g_ids.health);
        ecs_add_id(engine->world, he, g_ids.took_damage);
        /* +1: Unity sets IFramesExpires via ECB, so the 12-tick window is
         * first evaluated on the NEXT tick; our iframes system already
         * decrements on the tick the window is set (damage_apply slot 16
         * precedes iframes slot 20), so store 12+1 to block hash inserts
         * for exactly ticks T+1..T+12 (hittable again at T+13). */
        CTicks t = { SASHIMI_IFRAME_TICKS + 1 };
        ecs_set_id(engine->world, he, g_ids.iframes_timer, sizeof(t), &t);
        emit_event(engine, SASHIMI_EV_HERO_HURT, he, 0);
    }
}

/* â”€â”€ pickup_collect (Act) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* PickupSystem: a magnetized pickup close enough to its hero applies â€”
 * gems increment MatchStats.gems (the XP currency); hearts heal
 * PickupConfig.heart_heal_ratio of max HP (live behavior; the serialized
 * Value 25 is not read). */

static void sashimi_pickup_collect(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    const CPickupConfig *pc = pickup_config(engine);
    float trigger_d = pc ? pc->trigger_distance : 0.025f;
    float heal_ratio = pc ? pc->heart_heal_ratio : 0.25f;

    static ecs_entity_t collected[S_MAX_ENTS];
    static ecs_entity_t collector[S_MAX_ENTS];
    int n = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.pickup }, { .id = g_ids.pickup_magnet }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            const CPickupMagnet *m = ecs_get_id(engine->world, e,
                                                g_ids.pickup_magnet);
            const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
            if (!m || !p) continue;
            if (!ecs_is_alive(engine->world, m->hero)) continue;
            const CVec2 *hp = ecs_get_id(engine->world, m->hero, g_ids.position);
            if (!hp) continue;
            float d = sqrtf(dist2(p->x, p->y, hp->x, hp->y));
            /* Collect within the trigger distance (PickupSystem.cs:145;
             * the magnet's step clamp lands the pickup exactly on the
             * claimant, so no overshoot case exists). A defeated claimant
             * still collects: gems count, hearts heal the corpse
             * (:150-163 â€” the job never checks DefeatedTag). */
            if (d <= trigger_d) {
                collected[n] = e;
                collector[n] = m->hero;
                n++;
            }
        }
    }
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        const CPickup *pk = ecs_get_id(engine->world, collected[i], g_ids.pickup);
        if (!pk) continue;
        /* Presentation: Unity's PickupSystem plays the pickup's PickupSFX. */
        emit_event(engine, SASHIMI_EV_PICKUP, collected[i], pk->effect);
        if (pk->effect == 1) {          /* gem: XP currency */
            if (g_ids.game_state_e) {
                CMatchStats *ms = ecs_get_mut_id(engine->world,
                                                 g_ids.game_state_e,
                                                 g_ids.match_stats);
                if (ms) {
                    ms->gems++;
                    ecs_modified_id(engine->world, g_ids.game_state_e,
                                    g_ids.match_stats);
                }
            }
        } else if (pk->effect == 2) {   /* heart: heal 25% max HP */
            CHealth *h = ecs_get_mut_id(engine->world, collector[i],
                                        g_ids.health);
            if (h) {
                h->current += h->max * heal_ratio;
                if (h->current > h->max) h->current = h->max;
                ecs_modified_id(engine->world, collector[i], g_ids.health);
            }
        }
        ecs_delete(engine->world, collected[i]);
    }
}

/* â”€â”€ status_effects (Act) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* StatusEffectSystem: poison deals its damage on the 0.25 s periodic
 * clock; durations tick down every simulation tick; expired effects are
 * removed (remove, don't set false). A recall-haste StatusSlow with
 * RecallHaste stacks > 1 drops one stack and re-arms its window instead
 * (AppliedStatusEffectElement.Stacks, StatusEffectsSystem.cs:104-131).
 *
 * This slot also HOSTS the Eagle FeatherRecall ability pass
 * (recall_ability_pass below): Unity's HeroEagleProjectileRecallAbility
 * System runs in EffectApplication and its queued buff is initialized by
 * StatusEffectSystem in EffectResolution the same tick â€” the port
 * collapses decision + application into this Act slot (app.yaml's
 * generator-emitted system_order cannot grow a new slot; the extraction
 * JSON is absent, same constraint as collision_push). The pass runs AFTER
 * the decrement loops so a fresh 67-tick buff first decrements next tick,
 * matching Unity's buffed-movement window T+1..T+67 exactly (MoveSystem
 * precedes EffectResolution within a Unity tick). Arming a spawner here
 * (Act) means weapon_fire (Reset) consumes it NEXT tick â€” Unity's
 * EffectApplication(T) -> WorldInit(T+1) delay. */

/* Eagle FeatherRecall (HeroEagleProjectileRecallAbilitySystem.cs â€” the
 * traced mechanic; NOT a boomerang, there is no auto-return):
 *  - Feathers spent on the ground are FeatherRecall_Spawner entities
 *    (owner + monotonic SpentProjectileId, stamped by
 *    projectile_lifecycle).
 *  - Stationary tracking (:68-82): input direction ~0 (Defeated units
 *    read stationary â€” Unity zeroes their MoveDirection,
 *    MoveSystem.cs:117-126); threshold = Ticks(ActivationTime 0.1 s) = 7
 *    ticks since the transition. Out-of-game eagles are skipped entirely
 *    (query WithNone<OutOfGameTimer>, :66).
 *  - Recall activates when feathers > 0 && stationary >= threshold
 *    (:93,97-101); it deactivates only after feathers == 0 && !stationary
 *    has held for Ticks(DeactivationTime 0.75 s) = 46 ticks (:94,102-113;
 *    the deactivation frame is only reset on activation â€” quirk kept).
 *  - Feathers >= ProjectileRecallLimitStat (= level, HeroEagle_LUHSSO
 *    Stat 3) force-recall one per tick even while moving (:88-90,115).
 *  - One feather per tick, NEWEST first (highest SpentProjectileId,
 *    :117-128): armed with SpawnOneShotProjectile (recall limit > 0,
 *    :132-136) or destroyed (limit 0, :137-140).
 *  - The +50% haste applies to the EAGLE at recall-fire time â€” never on
 *    projectile arrival â€” when the recall is stationary-activated AND
 *    feathers on the ground >= SpeedBuffThreshold 2 (:143-152,
 *    HeroEagle.prefab:303). Magnitude/duration/stack limit come from the
 *    spawner's StatusEffectOnHit (MovementSpeed MultiplyBuffStrongest
 *    +0.5, 1.1 s, StackLimit 8 â€” FeatherRecall_Spawner.prefab:177-194):
 *    reapplication combines stacks up to the limit and resets the window
 *    (StatusEffectsSystem.cs:176-183); stacks extend DURATION only, the
 *    multiplier stays the strongest single +50%. */
static void recall_ability_pass(Engine *engine) {
    if (!g_ids.hero_level_bonus || !g_ids.spent_projectile_id ||
        !g_ids.one_shot_spawner || !g_ids.spawn_one_shot ||
        !g_ids.recall_state || !g_ids.recall_haste)
        return;

    /* Recall-capable heroes: a nonzero recall_limit table stands in for
     * Unity's HeroEagleProjectileRecallAbilityConfig presence. */
    static ecs_entity_t eagles[16];
    int ne = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.hero }, { .id = g_ids.hero_level_bonus },
            { .id = g_ids.input_direction }, { .id = g_ids.position },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && ne < 16; i++)
            eagles[ne++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < ne; i++) {
        ecs_entity_t e = eagles[i];
        const CHeroLevelBonus *hb = ecs_get_id(engine->world, e,
                                               g_ids.hero_level_bonus);
        if (!hb || hb->recall_limit[0] <= 0) continue;
        if (is_out_of_game(engine, e)) continue; /* state frozen while OOG */

        CRecallState *st = ecs_get_mut_id(engine->world, e,
                                          g_ids.recall_state);
        if (!st) {
            CRecallState init = { -1, 0, false };
            ecs_set_id(engine->world, e, g_ids.recall_state,
                       sizeof(init), &init);
            st = ecs_get_mut_id(engine->world, e, g_ids.recall_state);
            if (!st) continue;
        }

        /* Stationary tracking. */
        bool stationary = true;
        if (!is_defeated(engine, e)) {
            const CVec2 *in = ecs_get_id(engine->world, e,
                                         g_ids.input_direction);
            stationary = !in ||
                sqrtf(in->x * in->x + in->y * in->y) < 1e-4f;
        }
        if (stationary) {
            if (st->stationary_since < 0)
                st->stationary_since = (int32_t)g_tick;
        } else {
            st->stationary_since = -1;
        }
        bool at_threshold = st->stationary_since >= 0 &&
            g_tick >= (int64_t)st->stationary_since +
                      SASHIMI_RECALL_ACTIVATION_TICKS;

        /* My resting feathers (armed ones no longer count: Unity's query
         * is WithNone<SpawnOneShotProjectileTag>, :51-52). */
        int n_feathers = 0;
        ecs_entity_t newest = 0;
        int32_t newest_id = 0;
        ecs_query_t *fq = ecs_query(engine->world, {
            .terms = {
                { .id = g_ids.spent_projectile_id },
                { .id = g_ids.one_shot_spawner },
            },
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t fit = ecs_query_iter(engine->world, fq);
        while (ecs_query_next(&fit)) {
            for (int f = 0; f < fit.count; f++) {
                ecs_entity_t fe = fit.entities[f];
                if (ecs_has_id(engine->world, fe, g_ids.spawn_one_shot))
                    continue;
                const CSpentProjectileId *sid =
                    ecs_get_id(engine->world, fe, g_ids.spent_projectile_id);
                if (!sid || sid->owner != e || sid->id <= 0) continue;
                n_feathers++;
                if (sid->id > newest_id) { newest_id = sid->id; newest = fe; }
            }
        }
        ecs_query_fini(fq);

        int lvl = 1;
        const CExperience *xp = ecs_get_id(engine->world, e,
                                           g_ids.experience);
        if (xp) lvl = xp->level < 1 ? 1 : (xp->level > 20 ? 20 : xp->level);
        int limit = (int)hb->recall_limit[lvl - 1];

        bool too_many = n_feathers >= limit;
        bool activate_cond = n_feathers > 0 && at_threshold;
        bool deactivate_cond = n_feathers == 0 && !at_threshold;

        if (!st->activated && activate_cond) {
            st->activated = true;
            st->deactivation_since = 0;
        } else if (st->activated && deactivate_cond) {
            if (st->deactivation_since == 0)
                st->deactivation_since = (int32_t)g_tick;
            if (g_tick >= (int64_t)st->deactivation_since +
                          SASHIMI_RECALL_DEACTIVATION_TICKS)
                st->activated = false;
        }
        ecs_modified_id(engine->world, e, g_ids.recall_state);

        if (!newest || !(too_many || st->activated)) continue;

        /* Read the spawner's buff BEFORE the recall decision consumes the
         * entity (Unity's ECB defers both). */
        CStatusEffectOnHit fx;
        bool has_fx = false;
        const CStatusEffectOnHit *fxp = ecs_get_id(engine->world, newest,
                                                   g_ids.status_on_hit);
        if (fxp) { fx = *fxp; has_fx = true; }

        bool recalled = false;
        if (limit > 0) {
            ecs_add_id(engine->world, newest, g_ids.spawn_one_shot);
            recalled = true;
        } else {
            ecs_delete(engine->world, newest); /* :137-140 */
        }

        if (recalled && has_fx && activate_cond &&
            n_feathers >= SASHIMI_RECALL_BUFF_THRESHOLD &&
            fx.stat_type == 1 && fx.magnitude != 0) {
            /* Ticks(1.1 s) = 67 (GameTimeSystem_FixedStep.cs:77-84). */
            int dur = 1 + (int)floorf(fx.duration * (float)g_tick_rate);
            int cap = fx.stack_limit > 0 ? fx.stack_limit : 1;
            CStatusSlow *slow = ecs_get_mut_id(engine->world, e,
                                               g_ids.status_slow);
            CRecallHaste *rh = ecs_get_mut_id(engine->world, e,
                                              g_ids.recall_haste);
            int stacks = 1;
            if (slow && rh) {
                stacks = rh->stacks + 1 > cap ? cap : rh->stacks + 1;
                rh->stacks = stacks;
                rh->duration_ticks = dur;
                slow->ticks_remaining = dur;
                slow->magnitude = fx.magnitude;
                ecs_modified_id(engine->world, e, g_ids.recall_haste);
                ecs_modified_id(engine->world, e, g_ids.status_slow);
            } else {
                CStatusSlow ns = { dur, fx.magnitude };
                ecs_set_id(engine->world, e, g_ids.status_slow,
                           sizeof(ns), &ns);
                CRecallHaste nh = { 1, dur };
                ecs_set_id(engine->world, e, g_ids.recall_haste,
                           sizeof(nh), &nh);
            }
            /* Presentation: jump anim + the spawner's Spawn audio + the
             * FeatherRecallBuff FX (:147-166). */
            emit_event(engine, SASHIMI_EV_RECALL_BUFF, e, stacks);
        }
    }
}

static void sashimi_status_effects(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    /* Poison. */
    {
        static ecs_entity_t ents[S_MAX_ENTS];
        int n = 0;
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.status_poison }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it))
            for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
                ents[n++] = it.entities[i];
        ecs_query_fini(q);

        for (int i = 0; i < n; i++) {
            ecs_entity_t e = ents[i];
            CStatusPoison *p = ecs_get_mut_id(engine->world, e,
                                              g_ids.status_poison);
            if (!p) continue;
            if (g_periodic_now && !is_defeated(engine, e) &&
                !is_out_of_game(engine, e)) {
                bool victim_hero = ecs_has_id(engine->world, e, g_ids.hero);
                /* Poison ignores i-frames and the hero damage ratio: it is
                 * an already-applied effect, not a fresh hit (port
                 * decision, documented in CLAUDE.md). Out-of-game victims
                 * take NO poison, though: Unity clears the whole damage
                 * buffer â€” which poison rides â€” while OutOfGameTimer is
                 * enabled (ApplyDamageSystem.cs:46-53); the duration keeps
                 * ticking. */
                CHealth *h = ecs_get_mut_id(engine->world, e, g_ids.health);
                if (h) {
                    h->current -= p->damage_per_tick;
                    ecs_modified_id(engine->world, e, g_ids.health);
                    ecs_add_id(engine->world, e, g_ids.took_damage);
                }
                (void)victim_hero;
            }
            p->ticks_remaining--;
            if (p->ticks_remaining <= 0)
                ecs_remove_id(engine->world, e, g_ids.status_poison);
            else
                ecs_modified_id(engine->world, e, g_ids.status_poison);
        }
    }

    /* Move-speed modifiers. */
    {
        static ecs_entity_t ents[S_MAX_ENTS];
        int n = 0;
        ecs_query_t *q = ecs_query(engine->world, {
            .terms = {{ .id = g_ids.status_slow }},
            .cache_kind = EcsQueryCacheNone });
        ecs_iter_t it = ecs_query_iter(engine->world, q);
        while (ecs_query_next(&it))
            for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
                ents[n++] = it.entities[i];
        ecs_query_fini(q);

        for (int i = 0; i < n; i++) {
            CStatusSlow *s = ecs_get_mut_id(engine->world, ents[i],
                                            g_ids.status_slow);
            if (!s) continue;
            s->ticks_remaining--;
            if (s->ticks_remaining <= 0) {
                /* Recall haste with stacks left: drop ONE stack and re-arm
                 * the window instead of removing (Unity decrements
                 * AppliedStatusEffectElement.Stacks and resets
                 * ExpirationTick, StatusEffectsSystem.cs:104-131). */
                CRecallHaste *rh = g_ids.recall_haste ?
                    ecs_get_mut_id(engine->world, ents[i],
                                   g_ids.recall_haste) : NULL;
                if (rh && s->magnitude > 0 && rh->stacks > 1) {
                    rh->stacks--;
                    s->ticks_remaining = rh->duration_ticks;
                    ecs_modified_id(engine->world, ents[i],
                                    g_ids.recall_haste);
                    ecs_modified_id(engine->world, ents[i],
                                    g_ids.status_slow);
                } else {
                    ecs_remove_id(engine->world, ents[i], g_ids.status_slow);
                    if (rh)
                        ecs_remove_id(engine->world, ents[i],
                                      g_ids.recall_haste);
                }
            } else {
                ecs_modified_id(engine->world, ents[i], g_ids.status_slow);
            }
        }
    }

    /* Eagle FeatherRecall (hosted here; see the header comment above and
     * the trace block at recall_ability_pass). Runs after the decrement
     * loops so a buff applied this tick keeps its full window. */
    recall_ability_pass(engine);
}

/* â”€â”€ defeat (Act) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* DefeatSystem: HP <= 0 enables Defeated; movement/targeting/damage all
 * skip defeated units. Consequences (drops, respawn) run in Finalize. */

static void sashimi_defeat(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t downed[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.health }, { .id = g_ids.faction }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            const CHealth *h = ecs_get_id(engine->world, e, g_ids.health);
            if (!h || h->current > 0) continue;
            if (is_defeated(engine, e)) continue;
            downed[n++] = e;
        }
    }
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = downed[i];
        ecs_add_id(engine->world, e, g_ids.defeated);
        CVec2 *v = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (v) { v->x = 0; v->y = 0; ecs_modified_id(engine->world, e, g_ids.velocity); }
    }
}

/* â”€â”€ iframes (Act) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* IFramesSystem + OutOfGameSystem expiry collapsed: both windows count
 * down in the Act phase (Unity: EffectResolution, after ResolveDamage â€”
 * OutOfGameSystem.cs:9-10), so on the expiry tick the earlier damage pass
 * was still blocked and the unit is back in play from the NEXT tick's
 * hash rebuild â€” matching Unity's Expired(EndTick) = EndTick <= InterpTick
 * (GameTimeSystem_FixedStep.cs:59-66). */

static void tick_down_window(Engine *engine, ecs_entity_t comp_id, int cap) {
    static ecs_entity_t ents[64];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = comp_id }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < cap; i++)
            ents[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        CTicks *t = ecs_get_mut_id(engine->world, ents[i], comp_id);
        if (!t) continue;
        t->ticks_remaining--;
        if (t->ticks_remaining <= 0)
            ecs_remove_id(engine->world, ents[i], comp_id);
        else
            ecs_modified_id(engine->world, ents[i], comp_id);
    }
}

static void sashimi_iframes(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    if (g_ids.iframes_timer)
        tick_down_window(engine, g_ids.iframes_timer, 64);
    if (g_ids.out_of_game)
        tick_down_window(engine, g_ids.out_of_game, 16);
}

/* â”€â”€ projectile_lifecycle (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* OnHitEffectSystem (bounce/spend) + ProjectileLifecycleSystem
 * (spent-spawner/destroy): process the hits damage_apply recorded this
 * tick â€” hit-budget spend, bounce retarget â€” expire by range (flight
 * itself integrates in movement, slot 13, mirroring Unity's MoveSystem),
 * and spawn the SpentProjectile spawner where a projectile is spent.
 *
 * Bounce semantics (OnHitEffectSystem.cs:94-192): processing runs at
 * most ONCE per projectile per tick (the job is per-entity, not per-hit:
 * a multi-victim tick consumes a single bounce); every bounce attempt
 * first sets fuel = max(remaining, Range * 0.5) (:131) and searches
 * within that fuel radius; a failed attempt forfeits ALL remaining
 * bounces and the projectile keeps flying straight, still able to hit
 * victims up to its hit budget (:173-177). Piercing has no per-hit
 * counter: HitLimit (= Piercing + Bouncing + 1, set at fire time) is
 * the entire budget. */

static void sashimi_projectile_lifecycle(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_matrix_loaded) return;

    static ecs_entity_t projs[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {
            { .id = g_ids.projectile }, { .id = g_ids.projectile_runtime },
            { .id = g_ids.position }, { .id = g_ids.velocity },
        },
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            projs[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = projs[i];
        const CProjectile *pt = ecs_get_id(engine->world, e, g_ids.projectile);
        const CDamageOnHit *dh = ecs_get_id(engine->world, e, g_ids.damage_on_hit);
        CProjectileRuntime *rt = ecs_get_mut_id(engine->world, e,
                                                g_ids.projectile_runtime);
        CVec2 *pos = ecs_get_mut_id(engine->world, e, g_ids.position);
        CVec2 *vel = ecs_get_mut_id(engine->world, e, g_ids.velocity);
        if (!pt || !rt || !pos || !vel) continue;

        bool spent = false;

        /* Zero heading: Unity despawns such projectiles
         * (MoveSystem.cs:270-277). */
        float vlen = sqrtf(vel->x * vel->x + vel->y * vel->y);
        if (vlen < 1e-6f) spent = true;

        /* Range expiry: movement clamped the final step to the remaining
         * fuel this tick (MoveSystem.cs:281-294); the projectile already
         * dealt this tick's damage and now expires. Fuel-spent
         * projectiles skip bounce processing entirely (Unity's bounce
         * job is [WithDisabled(ProjectileSpent)] and the fuel-out flag
         * plays back at the end of WorldSimulation, before it runs). */
        bool fuel_out = rt->dist_left <= 0.0f;

        /* Did damage_apply record any hit for this projectile this tick?
         * Bounce/spend processing runs at most once per projectile per
         * tick regardless of how many victims landed. */
        bool hit_this_tick = false;
        for (int hix = 0; hix < g_proj_hit_count; hix++)
            if (g_proj_hits[hix].projectile == e) { hit_this_tick = true; break; }

        if (!spent && hit_this_tick && !fuel_out) {
            if (dh && !dh->ignore_hit_limit && dh->hit_limit > 0 &&
                rt->hits >= dh->hit_limit) {
                /* Hit budget exhausted (OnHitEffectSystem.cs:111-119). */
                spent = true;
            } else if (rt->bounce_left > 0) {
                rt->bounce_left--;
                /* Bounce fuel: max(remaining, half range), set BEFORE
                 * the search; the retarget radius is this fuel value,
                 * not the full range (OnHitEffectSystem.cs:131-157). */
                if (rt->dist_left < pt->range * 0.5f)
                    rt->dist_left = pt->range * 0.5f;
                /* Retarget: eligible living enemy not already hit (the
                 * pair registry holds this projectile's never-expiring
                 * victims). Unity's shipped loop keeps the LAST candidate
                 * in hash-iteration order (assignment without comparison,
                 * a shipped bug â€” OnHitEffectSystem.cs:168-169); that
                 * order is not reproducible here, so the port keeps
                 * deterministic nearest-eligible (knowingly unmatched). */
                CollisionFilter pf;
                ecs_entity_t best_e = 0;
                if (entity_filter(engine, e, &pf)) {
                    float best = -1;
                    for (int u = 0; u < g_unit_count; u++) {
                        UnitSnap *un = &g_units[u];
                        if (un->defeated || un->health_cur <= 0) continue;
                        if (!faction_filter_match(pf, un->filter)) continue;
                        if (!ecs_is_alive(engine->world, un->e) ||
                            is_defeated(engine, un->e)) continue;
                        if (pair_blocked((uint64_t)e, (uint64_t)un->e)) continue;
                        float d = sqrtf(dist2(pos->x, pos->y, un->x, un->y));
                        if (d > rt->dist_left) continue;
                        if (best < 0 || d < best) { best = d; best_e = un->e; }
                    }
                }
                if (best_e) {
                    const CVec2 *tp = ecs_get_id(engine->world, best_e,
                                                 g_ids.position);
                    if (tp) {
                        float dx = tp->x - pos->x, dy = tp->y - pos->y;
                        float len = sqrtf(dx * dx + dy * dy);
                        if (len > 1e-6f) {
                            vel->x = dx / len * pt->speed;
                            vel->y = dy / len * pt->speed;
                        }
                    }
                } else {
                    /* No eligible target: forfeit ALL remaining bounces
                     * and keep flying straight, still able to hit
                     * victims up to the hit budget
                     * (OnHitEffectSystem.cs:173-177) â€” no pierce
                     * conversion, no despawn. */
                    rt->bounce_left = 0;
                }
                ecs_modified_id(engine->world, e, g_ids.projectile_runtime);
                ecs_modified_id(engine->world, e, g_ids.velocity);
            }
            /* else: below budget with no bounces left â€” keep flying
             * (piercing is implicit in the hit budget; Unity has no
             * per-pierce counter). */
        }

        if (fuel_out) spent = true;

        if (spent) {
            const CSpentProjectile *sp = ecs_get_id(engine->world, e,
                                                    g_ids.spent_projectile);
            if (sp && sp->spawner_template && sp->spawner_template[0]) {
                ecs_entity_t spawner = engine_entity_spawn(
                    engine, sp->spawner_template, NULL);
                if (spawner) {
                    CVec2 p2 = { pos->x, pos->y };
                    ecs_set_id(engine->world, spawner, g_ids.position,
                               sizeof(p2), &p2);
                    /* Unity copies the ProjectileState (Owner) onto the
                     * spent spawner and stamps a monotonic
                     * SpentProjectileId (ProjectileLifecycleSystem.cs:
                     * 266-271); the recall ability matches feathers by
                     * owner and recalls the newest id first. */
                    if (g_ids.spent_projectile_id) {
                        CSpentProjectileId sid = { rt->shooter,
                                                   ++g_spent_counter };
                        ecs_set_id(engine->world, spawner,
                                   g_ids.spent_projectile_id,
                                   sizeof(sid), &sid);
                    }
                }
            }
            ecs_delete(engine->world, e);
        }
    }
}

/* â”€â”€ on_defeated (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* OnDefeatedSystem: per defeated creature both pity pools accumulate
 * (GemsPool += 0.5, HeartPool += 0.0375), then the HEART roll runs first
 * and the GEM roll second â€” each drop when Random.value < pool, pool -= 1
 * (OnDefeatedSystem.cs:63-88; both can drop from one kill). Same expected
 * rates as iid rolls but with near-zero drought risk: a pool >= 1 is a
 * guaranteed drop, so a gem lands at latest every 2nd dropless kill. Drop
 * position: pos + (Random.value - 0.5) * DropDistance per axis â€” a
 * uniform +-0.25 square at DropDistance 0.5, UNCLAMPED (SelectSpawnPoint,
 * :95-102; Unity never clamps drops to bounds). Creatures are then
 * destroyed (children cascade); heroes start their respawn timer instead. */

static void drop_pickup(Engine *engine, const char *tmpl, float px, float py,
                        float drop_dist) {
    /* Random call order matches SelectSpawnPoint: x variance then y. */
    float dx = ((float)rand() / (float)RAND_MAX - 0.5f) * drop_dist;
    float dy = ((float)rand() / (float)RAND_MAX - 0.5f) * drop_dist;
    ecs_entity_t p = engine_entity_spawn(engine, tmpl, NULL);
    if (!p) return;
    CVec2 pos = { px + dx, py + dy };
    ecs_set_id(engine->world, p, g_ids.position, sizeof(pos), &pos);
}

static void sashimi_on_defeated(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    const CPickupConfig *pc = pickup_config(engine);
    float gem_scale = pc ? pc->gem_drop_scale : 0.5f;
    float heart_scale = pc ? pc->heart_drop_scale : 0.0375f;
    float drop_dist = pc ? pc->drop_distance : 0.5f;

    /* Pity pools live across the match (Unity: MatchStats singleton
     * fields; here the native DropPools component on GameState, lazily
     * added at first use â€” the generated MatchStats schema stays
     * extraction-faithful). */
    CDropPools *dp = NULL;
    if (g_ids.game_state_e && g_ids.drop_pools) {
        dp = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                            g_ids.drop_pools);
        if (!dp) {
            CDropPools init = { 0.0f, 0.0f };
            ecs_set_id(engine->world, g_ids.game_state_e, g_ids.drop_pools,
                       sizeof(init), &init);
            dp = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                g_ids.drop_pools);
        }
    }
    if (!dp) return;

    static ecs_entity_t downed[S_MAX_ENTS];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.defeated }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++)
            downed[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = downed[i];

        if (ecs_has_id(engine->world, e, g_ids.hero)) {
            if (!ecs_has_id(engine->world, e, g_ids.respawn_timer)) {
                /* Unity queues RespawnGameTick = death tick + 600 and
                 * RespawnSystem revives strictly AFTER it
                 * (DefeatSystem.cs:92-93, RespawnSystem.cs:55), i.e. at
                 * death + 601; our respawn pass (slot 23) already
                 * decrements on this same tick, so +2 lands the revival
                 * at exactly death + 601. */
                CTicks t = { SASHIMI_RESPAWN_TICKS + 2 };
                ecs_set_id(engine->world, e, g_ids.respawn_timer,
                           sizeof(t), &t);
                /* Presentation: hero Defeat VO on the first down tick. */
                emit_event(engine, SASHIMI_EV_HERO_DIED, e, 0);
            }
            continue;
        }
        if (!ecs_has_id(engine->world, e, g_ids.ai_steering))
            continue; /* only creatures drop */

        const CVec2 *p = ecs_get_id(engine->world, e, g_ids.position);
        float px = p ? p->x : 0, py = p ? p->y : 0;

        if (g_ids.game_state_e) {
            CMatchStats *ms = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                             g_ids.match_stats);
            if (ms) {
                ms->kills++;
                ecs_modified_id(engine->world, g_ids.game_state_e,
                                g_ids.match_stats);
            }
        }

        /* Both pools accumulate first (OnDefeatedSystem.cs:63-64), then
         * heart rolls BEFORE gem (:70-88); rand() call order mirrors the
         * Unity Random.value order (roll, then x/y variance per drop). */
        dp->gem_pool += gem_scale;
        dp->heart_pool += heart_scale;
        if ((float)rand() / (float)RAND_MAX < dp->heart_pool) {
            dp->heart_pool -= 1.0f;
            drop_pickup(engine, "HeartPickup", px, py, drop_dist);
        }
        if ((float)rand() / (float)RAND_MAX < dp->gem_pool) {
            dp->gem_pool -= 1.0f;
            drop_pickup(engine, "GemPickup", px, py, drop_dist);
        }
        ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.drop_pools);

        /* Presentation: creature Defeat clip (emit before delete â€” the
         * event captures the IsA prefab, which outlives the entity). */
        emit_event(engine, SASHIMI_EV_CREATURE_DIED, e, 0);

        ecs_delete(engine->world, e); /* children cascade (engine-handled) */
    }
}

/* â”€â”€ respawn (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* RespawnSystem: defeated heroes come back in place at HALF max health
 * (RespawnSystem.cs:61) when their RespawnTimer expires, and spend
 * 2.0 s fully out of game (:17,62-66) â€” untargetable, out of the hash
 * and snapshot, unable to move, fire or cast (see the OutOfGame
 * registration comment). Replaces the port's old full-heal +
 * respawn-i-frames approximation. */

static void sashimi_respawn(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    static ecs_entity_t ents[16];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.respawn_timer }, { .id = g_ids.hero }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 16; i++)
            ents[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = ents[i];
        CTicks *t = ecs_get_mut_id(engine->world, e, g_ids.respawn_timer);
        if (!t) continue;
        t->ticks_remaining--;
        if (t->ticks_remaining > 0) {
            ecs_modified_id(engine->world, e, g_ids.respawn_timer);
            continue;
        }
        ecs_remove_id(engine->world, e, g_ids.respawn_timer);
        ecs_remove_id(engine->world, e, g_ids.defeated);
        CHealth *h = ecs_get_mut_id(engine->world, e, g_ids.health);
        if (h) {
            h->current = h->max / 2.0f; /* RespawnSystem.cs:61 */
            ecs_modified_id(engine->world, e, g_ids.health);
        }
        /* 2 s out of game from the NEXT tick; the countdown (iframes
         * slot 20, Act) removes it during tick R+120, whose damage pass
         * had already run â€” blocked ticks are exactly R+1..R+120, back
         * in the hash at R+121 (Unity: ExpiresGameTick = R + 120 with
         * Expired() = EndTick <= InterpTick, checked in EffectResolution
         * after the damage pass). */
        CTicks oog = { SASHIMI_RESPAWN_OOG_TICKS };
        ecs_set_id(engine->world, e, g_ids.out_of_game, sizeof(oog), &oog);
        /* Presentation: hero Respawn VO. */
        emit_event(engine, SASHIMI_EV_HERO_RESPAWN, e, 0);
    }
}

/* â”€â”€ spawn_director (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* EnemySpawnSystem, trace-exact (EnemySpawnSystem.cs:84-146):
 *
 *  - Both timers count down every tick (TimeToNextWave / TimeToNextSpawn,
 *    :85-86). WaveState carries the wave timer and 1-based current wave;
 *    the native WaveDirector component carries the trickle cursor.
 *  - Wave ADVANCE (wave timer expired and a next wave exists, :90-112):
 *    flush any un-warned entries of the outgoing wave at its OLD origin,
 *    snapshot the hero centroid as the new wave's origin
 *    (CameraFollowPointSystem via LocalToWorld, :103-105), reset the
 *    entry cursor, keep a NEGATIVE spawn-timer carry (:110), and add the
 *    new wave's delay to the wave timer (:111 â€” negative carry keeps the
 *    cadence anchored at 5 s multiples: wave N advances at tick
 *    (N-1)*300; wave 1 never "advances" and starts trickling at tick 1).
 *  - TRICKLE (:115-126): while the spawn timer is negative and entries
 *    remain, emit one warning and add the entry's delay (1 tick for all
 *    Adventure entries) â€” one warning per tick in the steady state.
 *    NOTE the traced carry consequence: TimeToNextSpawn keeps draining
 *    after a wave's entries are exhausted and the advance keeps that
 *    (large) negative value, so waves 2..36 release ALL their warnings in
 *    the advance tick; only wave 1 is paced 1/tick. This is shipped Unity
 *    behavior, not a port simplification.
 *  - Every warning becomes a component-bare PendingSpawn (hero-AI
 *    observability contract) that materializes SpawnConfig.spawn_delay
 *    (1.25 s) later â€” the telegraph window (EnemySpawnSystem.cs:143).
 *  - Spawn position = wave origin + entry offset, clamped to ArenaBounds:
 *    PORT DECISION â€” Unity does not clamp (neither Spawn() nor
 *    DelayedSpawnSystem; off-bounds creatures are pulled back by
 *    MoveSystem's MapBounds clamp on their first move). The port clamps
 *    at warning time so a target-less creature can never idle
 *    unreachable outside the arena (documented in CLAUDE.md). */

static void spawn_warning(Engine *engine, int wave_num, int entry_ix,
                          const WaveEntry *we, float origin_x, float origin_y,
                          int telegraph_ticks) {
    char name[64];
    snprintf(name, sizeof(name), "pending_w%d_%d", wave_num, entry_ix);
    ecs_entity_t e = engine_entity_create(engine, name);
    if (!e) return;
    ecs_add_id(engine->world, e, g_ids.pending_spawn);
    CPendingSpawn *ps = ecs_get_mut_id(engine->world, e, g_ids.pending_spawn);
    if (!ps) return;
    ps->template_name = ecs_os_strdup(we->template_name);
    ps->x = clampf(origin_x + we->x, g_bounds.min_x, g_bounds.max_x);
    ps->y = clampf(origin_y + we->y, g_bounds.min_y, g_bounds.max_y);
    /* +1: delayed_spawn (slot 25) already decrements on this same tick;
     * Unity's warning is ECB-created at end of tick and first checked the
     * next one, materializing exactly telegraph_ticks later. */
    ps->ticks_remaining = telegraph_ticks + 1;
    ecs_modified_id(engine->world, e, g_ids.pending_spawn);
}

static void sashimi_spawn_director(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_waves_loaded || !g_ids.game_state_e) return;

    /* Trickle cursor (lazily added; origin starts at the baked default
     * (0,0), which is wave 1's origin). MUST be ensured before taking any
     * GameState component pointers: adding it moves GameState between
     * tables and would dangle them. */
    if (g_ids.wave_director &&
        !ecs_has_id(engine->world, g_ids.game_state_e, g_ids.wave_director)) {
        CWaveDirector init = { 0, 0, 0.0f, 0.0f };
        ecs_set_id(engine->world, g_ids.game_state_e, g_ids.wave_director,
                   sizeof(init), &init);
    }

    CWaveState *ws = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                    g_ids.wave_state);
    CWaveDirector *wd = ecs_get_mut_id(engine->world, g_ids.game_state_e,
                                       g_ids.wave_director);
    if (!ws || !wd) return;
    if (ws->next_wave < 1 || ws->next_wave > g_wave_count) return;

    /* SpawnConfig.spawn_delay: the warning-to-creature telegraph window
     * (EnemySpawnSystem.cs:143; Adventure 1.25 s = 75 ticks). */
    const CSpawnConfig *sc = g_ids.game_config_e && g_ids.spawn_config
        ? ecs_get_id(engine->world, g_ids.game_config_e, g_ids.spawn_config)
        : NULL;
    int telegraph = (int)((sc ? sc->spawn_delay : 1.25f) * g_tick_rate + 0.5f);

    ws->ticks_to_next--;          /* TimeToNextWave -= dt  (:85) */
    wd->ticks_to_next_spawn--;    /* TimeToNextSpawn -= dt (:86) */

    int cur = ws->next_wave;
    Wave *w = &g_waves[cur - 1];

    /* Wave advance (:90-112). Unity's float TimeToNextWave dips below 0
     * on the 300th tick (1/60f accumulation error), so the integer
     * equivalent advances at <= 0: wave N's warnings begin at tick
     * (N-1)*300. */
    if (ws->ticks_to_next <= 0 && cur + 1 <= g_wave_count) {
        while (wd->spawn_index < w->entry_count) { /* flush at OLD origin */
            spawn_warning(engine, cur, wd->spawn_index,
                          &g_wave_entries[w->first_entry + wd->spawn_index],
                          wd->origin_x, wd->origin_y, telegraph);
            wd->spawn_index++;
            ws->spawned_total++;
        }
        wd->origin_x = g_hero_centroid.x;   /* :103-105 snapshot */
        wd->origin_y = g_hero_centroid.y;
        cur++;
        ws->next_wave = cur;
        w = &g_waves[cur - 1];
        wd->spawn_index = 0;
        if (wd->ticks_to_next_spawn > 0)    /* keep negative carry (:110) */
            wd->ticks_to_next_spawn = 0;
        ws->ticks_to_next += g_wave_delay_ticks; /* negative carry (:111) */
        /* Presentation: wave started (no sound in the Unity data â€”
         * exported for UI/telegraph use). */
        emit_event(engine, SASHIMI_EV_WAVE_STARTED, 0, cur);
    }

    /* Trickle (:115-126). */
    while (wd->ticks_to_next_spawn < 0 && wd->spawn_index < w->entry_count) {
        if (cur == 1 && wd->spawn_index == 0)
            emit_event(engine, SASHIMI_EV_WAVE_STARTED, 0, 1);
        WaveEntry *we = &g_wave_entries[w->first_entry + wd->spawn_index];
        spawn_warning(engine, cur, wd->spawn_index, we,
                      wd->origin_x, wd->origin_y, telegraph);
        wd->spawn_index++;
        ws->spawned_total++;
        wd->ticks_to_next_spawn += we->delay_ticks;
    }

    ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.wave_state);
    ecs_modified_id(engine->world, g_ids.game_state_e, g_ids.wave_director);
}

/* â”€â”€ delayed_spawn (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* DelayedSpawnSystem: materialize PendingSpawn requests whose telegraph
 * delay (SpawnConfig.spawn_delay = 1.25 s, set by spawn_director) has
 * elapsed, at the warning's position (DelayedSpawnSystem.cs:47-53
 * materializes when tick * dt >= SpawnTime, at the warning transform).
 * Creature scaling at spawn mirrors live Unity
 * (UnitInitializationSystem.cs:44-58): the CreatureLevelUp level driver
 * (SpawnCount) has no live writer (CreatureSpawnSystem.cs:14 â€” the whole
 * spawner is #if false), so creatures always bake 1.0x level multipliers;
 * the ONLY live scaling is the co-op rule â€” more than one living hero at
 * spawn time multiplies creature HP by 1.4. The CreatureLevelUp table
 * stays loaded (data-faithful, unused at runtime). */

/* Living (non-defeated) heroes currently on the field. */
static int count_living_heroes(Engine *engine) {
    int living = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.hero }, { .id = g_ids.health }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count; i++)
            if (!is_defeated(engine, it.entities[i])) living++;
    ecs_query_fini(q);
    return living;
}

static void sashimi_delayed_spawn(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine)) return;

    typedef struct { ecs_entity_t req; char tmpl[S_TMPL_NAME]; float x, y; } Due;
    static Due due[S_MAX_ENTS];
    int n = 0;

    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.pending_spawn }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count && n < S_MAX_ENTS; i++) {
            ecs_entity_t e = it.entities[i];
            CPendingSpawn *ps = ecs_get_mut_id(engine->world, e,
                                               g_ids.pending_spawn);
            if (!ps || !ps->template_name) continue;
            ps->ticks_remaining--;
            ecs_modified_id(engine->world, e, g_ids.pending_spawn);
            if (ps->ticks_remaining > 0) continue;
            due[n].req = e;
            snprintf(due[n].tmpl, S_TMPL_NAME, "%s", ps->template_name);
            due[n].x = ps->x;
            due[n].y = ps->y;
            n++;
        }
    }
    ecs_query_fini(q);

    int living_heroes = n > 0 ? count_living_heroes(engine) : 0;

    for (int i = 0; i < n; i++) {
        ecs_entity_t spawned = engine_entity_spawn(engine, due[i].tmpl, NULL);
        if (spawned) {
            CVec2 p = { due[i].x, due[i].y };
            ecs_set_id(engine->world, spawned, g_ids.position, sizeof(p), &p);
            /* Co-op difficulty at spawn time
             * (UnitInitializationSystem.cs:55-58). */
            if (living_heroes > 1 &&
                ecs_has_id(engine->world, spawned, g_ids.ai_steering)) {
                CHealth *h = ecs_get_mut_id(engine->world, spawned, g_ids.health);
                if (h) {
                    h->current *= S_COOP_HP_MULT;
                    h->max *= S_COOP_HP_MULT;
                    ecs_modified_id(engine->world, spawned, g_ids.health);
                }
            }
        }
        ecs_delete(engine->world, due[i].req);
    }
}

/* â”€â”€ level_up (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* HeroLevelUpSystem: MatchStats.gems vs HeroLevelUp thresholds. On level
 * up: health multiplier rescales max HP, hero heals to full (live
 * behavior); damage multiplier applies at hit time; the per-level
 * pierce/bounce stats apply at fire time (weapon_fire REPLACES the
 * projectile's serialized base with them). */

static void sashimi_level_up(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.game_state_e) return;

    const CMatchStats *ms = ecs_get_id(engine->world, g_ids.game_state_e,
                                       g_ids.match_stats);
    const CLevelTable *t = hero_table(engine);
    if (!ms || !t) return;

    int target = level_from_xp(t, ms->gems);

    static ecs_entity_t heroes[16];
    int n = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.hero }, { .id = g_ids.experience }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it))
        for (int i = 0; i < it.count && n < 16; i++)
            heroes[n++] = it.entities[i];
    ecs_query_fini(q);

    for (int i = 0; i < n; i++) {
        ecs_entity_t e = heroes[i];
        CExperience *xp = ecs_get_mut_id(engine->world, e, g_ids.experience);
        if (!xp) continue;
        xp->xp = (float)ms->gems;
        if (target > xp->level) {
            int old = xp->level < 1 ? 1 : xp->level;
            xp->level = target;
            /* Presentation: Unity's HeroLevelUpSystem plays LevelUp VO. */
            emit_event(engine, SASHIMI_EV_LEVEL_UP, e, target);
            CHealth *h = ecs_get_mut_id(engine->world, e, g_ids.health);
            if (h) {
                float old_mult = t->health[old - 1];
                float new_mult = t->health[target - 1];
                if (old_mult > 0) {
                    h->max = h->max / old_mult * new_mult;
                    /* Current HP rescales proportionally with the max
                     * multiplier (HeroLevelUpSystem.cs:143-148); live
                     * Unity's heal-to-full block (:56-65) is commented
                     * out - no free heal on level-up. */
                    h->current = h->current / old_mult * new_mult;
                }
                ecs_modified_id(engine->world, e, g_ids.health);
            }
        }
        ecs_modified_id(engine->world, e, g_ids.experience);
    }
}

/* â”€â”€ app_stop (Finalize) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* ServerGameOverSystem: victory when GameTime.tick reaches
 * GameOverConfig.VictoryTimerSeconds * tick_rate (180 s = 10800 ticks);
 * defeat when every hero is defeated. Unity evaluates this at the start
 * of the next tick (BeginInitialization); checking at the end of this
 * tick is the single-world equivalent. */

static void sashimi_app_stop(Engine *engine) {
    if (is_simulation_paused(engine)) return;
    if (!ids_resolve(engine) || !g_ids.game_state_e || !g_ids.game_config_e)
        return;

    const CGameTime *gt = ecs_get_id(engine->world, g_ids.game_state_e,
                                     g_ids.game_time);
    const CGameOverConfig *go = ecs_get_id(engine->world, g_ids.game_config_e,
                                           g_ids.game_over_config);
    const CMatchStats *ms = ecs_get_id(engine->world, g_ids.game_state_e,
                                       g_ids.match_stats);
    if (!gt || !go) return;

    int64_t victory_tick = (int64_t)(go->victory_timer_seconds * g_tick_rate + 0.5f);
    /* Strict >: Unity ends the game when InterpTick EXCEEDS VictoryTick
     * (ServerGameOverSystem.cs:56), giving one more simulated tick; defeat
     * is only checked after victory fails, so all-heroes-dead at exactly
     * VictoryTick is a DEFEAT. */
    if (gt->tick > victory_tick) {
        engine->game_over = true;
        snprintf(engine->game_over_message, sizeof(engine->game_over_message),
                 "Victory - survived %.0fs (gems %d, kills %d)",
                 go->victory_timer_seconds, ms ? ms->gems : 0,
                 ms ? ms->kills : 0);
        return;
    }

    /* Defeat: no living hero. */
    int living = 0, total = 0;
    ecs_query_t *q = ecs_query(engine->world, {
        .terms = {{ .id = g_ids.hero }, { .id = g_ids.health }},
        .cache_kind = EcsQueryCacheNone });
    ecs_iter_t it = ecs_query_iter(engine->world, q);
    while (ecs_query_next(&it)) {
        for (int i = 0; i < it.count; i++) {
            total++;
            if (!is_defeated(engine, it.entities[i])) living++;
        }
    }
    ecs_query_fini(q);

    if (total > 0 && living == 0) {
        engine->game_over = true;
        snprintf(engine->game_over_message, sizeof(engine->game_over_message),
                 "Defeat - all heroes down at tick %lld (gems %d, kills %d)",
                 (long long)gt->tick, ms ? ms->gems : 0, ms ? ms->kills : 0);
    }
    (void)now_ms;
}

/* â”€â”€ Registration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
/* Order mirrors the Unity pipeline (mapping table in
 * sandboxes/sashimi/CLAUDE.md). Legacy mode takes the sequential order
 * from app.yaml system_order; pipeline mode chains DependsOn pairs inside
 * each engine phase. */

void sashimi_register_native_systems(Engine *engine) {
    register_runtime_components(engine);
    memset(&g_ids, 0, sizeof(g_ids)); /* re-resolve against this world */
    pairs_reset();
    g_proj_hit_count = 0;
    g_spent_counter = 0;
    g_unit_count = 0;
    g_event_count = 0;
    g_matrix_loaded = false;
    g_waves_loaded = false;
    g_child_order_count = 0; /* prefab ids are per-world */
    g_hero_centroid.x = 0.0f; /* baked default (float3.zero) */
    g_hero_centroid.y = 0.0f;

    if (engine->pipeline_active) {
        /* Init: app_start (rewind DependsOn added by app.c) -> game_time
         * -> hero_ai */
        ecs_entity_t s_start = engine_system_register_pipeline(
            engine, "app_start", sashimi_app_start, engine->phase_init,
            false, 0);
        ecs_entity_t s_time = engine_system_register_pipeline(
            engine, "game_time", sashimi_game_time, engine->phase_init,
            false, s_start);
        engine_system_register_pipeline(
            engine, "hero_ai", sashimi_hero_ai, engine->phase_init,
            false, s_time);

        /* Reset: start_of_tick -> destroy_on_timer -> ability_machine ->
         * weapon_fire */
        ecs_entity_t s_sot = engine_system_register_pipeline(
            engine, "start_of_tick", sashimi_start_of_tick,
            engine->phase_reset, false, 0);
        ecs_entity_t s_dot = engine_system_register_pipeline(
            engine, "destroy_on_timer", sashimi_destroy_on_timer,
            engine->phase_reset, false, s_sot);
        ecs_entity_t s_ab = engine_system_register_pipeline(
            engine, "ability_machine", sashimi_ability_machine,
            engine->phase_reset, false, s_dot);
        engine_system_register_pipeline(
            engine, "weapon_fire", sashimi_weapon_fire,
            engine->phase_reset, false, s_ab);

        /* Move: spatial_hash -> targeting -> creature_steering ->
         * pickup_magnet -> movement -> child_offset_sync */
        ecs_entity_t s_hash = engine_system_register_pipeline(
            engine, "spatial_hash", sashimi_spatial_hash,
            engine->phase_move, false, 0);
        ecs_entity_t s_tgt = engine_system_register_pipeline(
            engine, "targeting", sashimi_targeting,
            engine->phase_move, false, s_hash);
        ecs_entity_t s_steer = engine_system_register_pipeline(
            engine, "creature_steering", sashimi_creature_steering,
            engine->phase_move, false, s_tgt);
        ecs_entity_t s_mag = engine_system_register_pipeline(
            engine, "pickup_magnet", sashimi_pickup_magnet,
            engine->phase_move, false, s_steer);
        ecs_entity_t s_move = engine_system_register_pipeline(
            engine, "movement", sashimi_movement,
            engine->phase_move, false, s_mag);
        engine_system_register_pipeline(
            engine, "child_offset_sync", sashimi_child_offset_sync,
            engine->phase_move, false, s_move);

        /* Act: collision_push -> damage_apply -> pickup_collect ->
         * status_effects -> defeat -> iframes */
        ecs_entity_t s_push = engine_system_register_pipeline(
            engine, "collision_push", sashimi_collision_push,
            engine->phase_act, false, 0);
        ecs_entity_t s_dmg = engine_system_register_pipeline(
            engine, "damage_apply", sashimi_damage_apply,
            engine->phase_act, false, s_push);
        ecs_entity_t s_pick = engine_system_register_pipeline(
            engine, "pickup_collect", sashimi_pickup_collect,
            engine->phase_act, false, s_dmg);
        ecs_entity_t s_status = engine_system_register_pipeline(
            engine, "status_effects", sashimi_status_effects,
            engine->phase_act, false, s_pick);
        ecs_entity_t s_defeat = engine_system_register_pipeline(
            engine, "defeat", sashimi_defeat,
            engine->phase_act, false, s_status);
        engine_system_register_pipeline(
            engine, "iframes", sashimi_iframes,
            engine->phase_act, false, s_defeat);

        /* Finalize: projectile_lifecycle -> on_defeated -> respawn ->
         * spawn_director -> delayed_spawn -> level_up -> app_stop
         * (history_capture is chained after app_stop by app.c) */
        ecs_entity_t s_proj = engine_system_register_pipeline(
            engine, "projectile_lifecycle", sashimi_projectile_lifecycle,
            engine->phase_finalize, false, 0);
        ecs_entity_t s_od = engine_system_register_pipeline(
            engine, "on_defeated", sashimi_on_defeated,
            engine->phase_finalize, false, s_proj);
        ecs_entity_t s_resp = engine_system_register_pipeline(
            engine, "respawn", sashimi_respawn,
            engine->phase_finalize, false, s_od);
        ecs_entity_t s_dir = engine_system_register_pipeline(
            engine, "spawn_director", sashimi_spawn_director,
            engine->phase_finalize, false, s_resp);
        ecs_entity_t s_ds = engine_system_register_pipeline(
            engine, "delayed_spawn", sashimi_delayed_spawn,
            engine->phase_finalize, false, s_dir);
        ecs_entity_t s_lvl = engine_system_register_pipeline(
            engine, "level_up", sashimi_level_up,
            engine->phase_finalize, false, s_ds);
        engine_system_register_pipeline(
            engine, "app_stop", sashimi_app_stop,
            engine->phase_finalize, false, s_lvl);
    } else {
        engine_system_register_native(engine, "app_start", sashimi_app_start);
        engine_system_register_native(engine, "game_time", sashimi_game_time);
        engine_system_register_native(engine, "hero_ai", sashimi_hero_ai);
        engine_system_register_native(engine, "start_of_tick", sashimi_start_of_tick);
        engine_system_register_native(engine, "destroy_on_timer", sashimi_destroy_on_timer);
        engine_system_register_native(engine, "ability_machine", sashimi_ability_machine);
        engine_system_register_native(engine, "weapon_fire", sashimi_weapon_fire);
        engine_system_register_native(engine, "spatial_hash", sashimi_spatial_hash);
        engine_system_register_native(engine, "targeting", sashimi_targeting);
        engine_system_register_native(engine, "creature_steering", sashimi_creature_steering);
        engine_system_register_native(engine, "pickup_magnet", sashimi_pickup_magnet);
        engine_system_register_native(engine, "movement", sashimi_movement);
        engine_system_register_native(engine, "child_offset_sync", sashimi_child_offset_sync);
        engine_system_register_native(engine, "collision_push", sashimi_collision_push);
        engine_system_register_native(engine, "damage_apply", sashimi_damage_apply);
        engine_system_register_native(engine, "pickup_collect", sashimi_pickup_collect);
        engine_system_register_native(engine, "status_effects", sashimi_status_effects);
        engine_system_register_native(engine, "defeat", sashimi_defeat);
        engine_system_register_native(engine, "iframes", sashimi_iframes);
        engine_system_register_native(engine, "projectile_lifecycle", sashimi_projectile_lifecycle);
        engine_system_register_native(engine, "on_defeated", sashimi_on_defeated);
        engine_system_register_native(engine, "respawn", sashimi_respawn);
        engine_system_register_native(engine, "spawn_director", sashimi_spawn_director);
        engine_system_register_native(engine, "delayed_spawn", sashimi_delayed_spawn);
        engine_system_register_native(engine, "level_up", sashimi_level_up);
        engine_system_register_native(engine, "app_stop", sashimi_app_stop);
    }
}
#ifndef SASHIMI_SYSTEMS_H
#define SASHIMI_SYSTEMS_H

#include "engine/engine.h"

/* Sashimi native systems â€” the simulation core of the sashimi port
 * (docs/sashimi-port-proposal.md; ordering mapping in
 * sandboxes/sashimi/CLAUDE.md "System ordering").
 *
 * One engine turn == one 60 Hz tick (GameTimeConfig.tick_rate). All
 * seconds-denominated content converts via ticks = seconds * tick_rate. */

/* Registered by native_registry.c when the sashimi sandbox starts. */
void sashimi_register_native_systems(Engine *engine);

/* 45-degree octant snap shared by player input (future WASM client's
 * wasm_set_input) and by the headless hero AI, so both emit identical
 * InputDirection values (engine/clients/lib rt-input.js contract). */
void sashimi_input_snap(float x, float y, float *out_x, float *out_y);

/* Number of waves loaded from data/waves.yaml (0 before app_start). Read
 * by the WASM client bridge for the HUD "wave N/M" display so the total
 * stays sourced from sandbox data (root decision 13). */
int sashimi_wave_count(void);

/* â”€â”€ Per-tick presentation event ring â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 * Additive observation layer for clients (audio/FX): systems record what
 * happened this tick; nothing in the simulation reads these. The engine
 * stays headless â€” the WASM bridge drains the ring after each tick and the
 * browser client turns events into sounds. Mirrors the Unity audio trigger
 * sites (PlayAudioSystem callers: ProjectileLifecycleSystem spawn,
 * PresentDamageSystem impact, PresentUnitAnimationSystem hurt/defeat/
 * respawn, HeroLevelUpSystem, PickupSystem, ClientGameOverSystem).
 *
 * `prefab` is the subject's IsA target at emit time (stable prefab entity,
 * valid after the subject is deleted); `entity_id` is the engine public id
 * of the subject (or the acting unit, see each type); `data` is a small
 * per-type payload. Overflow beyond SASHIMI_EVENT_CAP is dropped. */

enum {
    SASHIMI_EV_WEAPON_FIRED  = 1, /* subject: projectile; data: owner id  */
    SASHIMI_EV_HIT           = 2, /* subject: projectile / attacking unit */
    SASHIMI_EV_HERO_HURT     = 3, /* subject: hero victim                 */
    SASHIMI_EV_CREATURE_DIED = 4, /* subject: creature (pre-delete)       */
    SASHIMI_EV_HERO_DIED     = 5, /* subject: hero (first down tick)      */
    SASHIMI_EV_HERO_RESPAWN  = 6, /* subject: hero                        */
    SASHIMI_EV_PICKUP        = 7, /* subject: pickup; data: effect (1|2)  */
    SASHIMI_EV_LEVEL_UP      = 8, /* subject: hero; data: new level       */
    SASHIMI_EV_WAVE_STARTED  = 9, /* data: wave number released           */
    SASHIMI_EV_RECALL_BUFF   = 10,/* subject: hero; data: haste stacks.
                                     Unity cue: jump anim + the spawner's
                                     Spawn audio + FeatherRecallBuff FX
                                     (HeroEagleProjectileRecallAbility
                                     System.cs:147-166) */
};

#define SASHIMI_EVENT_CAP 256

void sashimi_events_clear(void);
int  sashimi_events_count(void);
int  sashimi_event_type(int i);
uint64_t sashimi_event_prefab(int i);   /* ecs_entity_t of the IsA prefab */
int  sashimi_event_entity(int i);       /* engine public entity id, 0 if n/a */
int  sashimi_event_data(int i);

/* Timer constants â€” all source-pinned (2026-07 spawning/respawn batch):
 * SASHIMI_IFRAME_TICKS: Unity hardcodes IFramesExpires = InterpTick + 12
 * (0.2 s) at damage resolution (ResolveDamageSystem.cs:51).
 * SASHIMI_RESPAWN_TICKS: hardcoded UnitRespawnTime = 10.0 s
 * (DefeatSystem.cs:14,92).
 * SASHIMI_RESPAWN_OOG_TICKS: OOGTimerOnRespawn = 2.0 s of full
 * out-of-game after respawn (RespawnSystem.cs:17,62-66) â€” replaces the
 * port's old respawn-i-frames approximation.
 * SASHIMI_CHARGE_DISTANCE: the LargeCubeCharge dash is a fuel-based
 * impulse, not a timed velocity: the ability prefab serializes
 * ImpulseDistance = 3 (LargeCubeCharge_Ability.prefab:187, baked as
 * ImpulseElement.Fuel, AbilityConfigAuthoring.cs:94-98) and the active
 * stage computes Speed = Fuel / ActiveDuration = 3 / 0.4 = 7.5 u/s
 * (AbilitySystem.cs:944-946). Impulses integrate in MoveSystem separately
 * from locomotion and never read MoveSpeedStat â€” slows do not scale a
 * dash (MoveSystem.cs:135-168). */
#define SASHIMI_IFRAME_TICKS          12   /* 0.2 s post-hit invulnerability */
#define SASHIMI_RESPAWN_TICKS         600  /* 10 s hero respawn timer */
#define SASHIMI_RESPAWN_OOG_TICKS     120  /* 2 s out-of-game after respawn */
#define SASHIMI_CHARGE_DISTANCE       3.0f /* LargeCubeCharge dash fuel, units */

/* Eagle FeatherRecall ability constants â€” source-pinned from the
 * HeroEagle.prefab authoring override (HeroEagle.prefab:300-303:
 * ActivationTime 0.1, DeactivationTime 0.75, SpeedBuffThreshold 2 â€” the
 * HeroEagleAuthoring.cs code defaults 0.1/0/4 are overridden by the
 * prefab). Tick conversion is Unity's Ticks(d) = 1 + floor(d * 60)
 * (GameTimeSystem_FixedStep.cs:77-84). The buff itself
 * (MovementSpeed MultiplyBuffStrongest +0.5, 1.1 s, StackLimit 8) is NOT
 * a constant here: it is read at recall time from the spawner's generated
 * StatusEffectOnHit (entities/FeatherRecall_Spawner.yaml). */
#define SASHIMI_RECALL_ACTIVATION_TICKS   7  /* Ticks(0.1 s) stationary */
#define SASHIMI_RECALL_DEACTIVATION_TICKS 46 /* Ticks(0.75 s) sustained */
#define SASHIMI_RECALL_BUFF_THRESHOLD     2  /* feathers on ground for haste */

#endif
/* Sashimi sandbox content validation.
 *
 * Asserts that the generated data layer LOADS: sandbox select + app start
 * must succeed with every template loaded and every spawn applied, and the
 * loaded values must match the golden numbers from sashimi's
 * CONTENT-ANALYSIS.md (see sandboxes/sashimi/CLAUDE.md for the count
 * corrections). Run from the project root (ctest sets the working dir).
 */
#include "test.h"
#include "../../../engine/src/engine/engine.h"
#include "../../../engine/src/engine/simulation.h"
#include "../../../engine/src/engine/components.h"
#include "../../../engine/src/engine/templates.h"
#include "../../../engine/src/engine/app.h"
#include "../../../engine/src/engine/faction.h"
#include <string.h>

static Engine *engine;

/* Must match app.yaml templates.entities (asserted below via app_start). */
#define EXPECTED_ENTITY_TEMPLATES 35
/* spawn_list: 2 heroes + 8 gems. */
#define EXPECTED_SPAWNS 10

static void setup(void) {
    engine = engine_init(NULL);
    snprintf(engine->sandboxes_dir, sizeof(engine->sandboxes_dir),
             "./sandboxes/");
}

static void teardown(void) {
    engine_fini(engine);
    engine = NULL;
}

/* Helpers return sentinel values on lookup failure; the value assertions
   at the call sites then fail loudly (ASSERT can only be used in tests). */
static const void *comp_of(ecs_entity_t e, const char *comp) {
    if (!e) return NULL;
    ecs_entity_t c = ecs_lookup(engine->world, comp);
    if (!c) return NULL;
    return ecs_get_id(engine->world, e, c);
}

#define MISSING_F32 -99999.0f

static float field_f32(ecs_entity_t e, const char *comp, int index) {
    const float *p = (const float *)comp_of(e, comp);
    return p ? p[index] : MISSING_F32;
}

static ecs_entity_t tmpl(const char *name) {
    return ecs_lookup(engine->world, name);
}

/* --- Load ---------------------------------------------------------------- */

TEST(sandbox_loads_clean) {
    setup();
    ASSERT(engine_sandbox_select(engine, "sashimi"));

    /* Every component schema registered at select. */
    const char *comps[] = {
        "Position", "Velocity", "MoveSpeed", "InputDirection", "Health",
        "Faction", "Collider", "ChildOffset", "AISteering", "Hero",
        "Experience", "Weapon", "Projectile", "DamageOnHit", "PeriodicDamage",
        "StatusEffectOnHit", "StatusPoison", "StatusSlow", "SpentProjectile",
        "OneShotProjectileSpawner", "Pickup", "AbilityConfig", "AbilityState",
        "GameTimeConfig", "SpawnConfig", "GameOverConfig", "MoveConfig",
        "CombatConfig", "PickupConfig", "CreatureLevelUp", "HeroLevelUp",
        "HeroLevelBonus", "ArenaBounds", "WaveState", "PendingSpawn",
        "RespawnTimer", "IFramesTimer", "DestroyOnTimer", "Defeated",
        "GameTime", "MatchStats",
        "MapSize", /* imported from avk */
    };
    for (size_t i = 0; i < sizeof(comps) / sizeof(comps[0]); i++) {
        ecs_entity_t c = ecs_lookup(engine->world, comps[i]);
        if (!c) printf("\n    MISSING component %s ", comps[i]);
        ASSERT(c != 0);
    }

    AppStartResult asr;
    ASSERT(engine_app_start(engine, NULL, &asr));
    printf("\n    [entities_loaded=%d spawned=%d] ",
           asr.entities_loaded, asr.entities_spawned);
    /* Zero-error load: every template in app.yaml loaded, every spawn
       applied. A single failed template or spawn fails this. */
    ASSERT_EQ(asr.entities_loaded, EXPECTED_ENTITY_TEMPLATES);
    ASSERT_EQ(asr.entities_spawned, EXPECTED_SPAWNS);
    teardown();
}

/* --- Golden values (CONTENT-ANALYSIS.md) --------------------------------- */

static void start(void) {
    setup();
    ASSERT(engine_sandbox_select(engine, "sashimi"));
    AppStartResult asr;
    ASSERT(engine_app_start(engine, NULL, &asr));
}

TEST(creature_roster_values) {
    start();
    struct { const char *name; float hp, speed, follow, stop; } rows[] = {
        { "CreatureSlimeOrange", 30, 0.65f, 0.225f, 0.175f },
        { "CreatureWolf", 45, 1.75f, 0.5f, 0.25f },
        { "CreatureRockGolem", 150, 0.65f, 0.8f, 0.7f },
        { "CreatureWisp", 20, 0.8f, 3.5f, 2.5f },
        { "LargeTealCube", 180, 1.75f, 2.0f, 1.5f },
    };
    for (int i = 0; i < 5; i++) {
        ecs_entity_t t = tmpl(rows[i].name);
        ASSERT_EQ(field_f32(t, "Health", 1), rows[i].hp);      /* max */
        ASSERT_EQ(field_f32(t, "MoveSpeed", 0), rows[i].speed);
        ASSERT_EQ(field_f32(t, "AISteering", 0), rows[i].follow);
        ASSERT_EQ(field_f32(t, "AISteering", 1), rows[i].stop);
    }
    /* Wisp flees at 0; others never (-1). Acquisition radius 5 for all. */
    ASSERT_EQ(field_f32(tmpl("CreatureWisp"), "AISteering", 2), 0.0f);
    ASSERT_EQ(field_f32(tmpl("CreatureWolf"), "AISteering", 2), -1.0f);
    ASSERT_EQ(field_f32(tmpl("CreatureWolf"), "AISteering", 3), 5.0f);
    teardown();
}

TEST(hero_kits) {
    start();
    /* Frog: speed 2, hero_id 2, shuriken weapon child. */
    ecs_entity_t frog = tmpl("HeroFrog");
    ASSERT_EQ(field_f32(frog, "MoveSpeed", 0), 2.0f);
    const int *hero = (const int *)comp_of(frog, "Hero");
    ASSERT_NOT_NULL(hero);
    ASSERT_EQ(hero[0], 2);

    /* Spawned hero owns a weapon child wired to the shuriken. */
    ecs_entity_t inst = engine_entity_spawn(engine, "HeroFrog", NULL);
    ASSERT(inst != 0);
    ecs_entity_t weapon = ecs_lookup_child(engine->world, inst, "weapon");
    ASSERT(weapon != 0);
    char *wdata = engine_entity_get_component(engine, weapon, "Weapon");
    ASSERT_NOT_NULL(wdata);
    ASSERT(strstr(wdata, "0.75") != NULL);               /* cooldown */
    ASSERT(strstr(wdata, "Shuriken_Projectile") != NULL);
    free(wdata);

    /* Shuriken: dmg 12, hit limit 4, 3 bounces; poison 30 total over 3 s
       (2.5/periodic tick at runtime), -75% slow, stack limit 1. */
    ecs_entity_t shp = tmpl("Shuriken_Projectile");
    ASSERT_EQ(field_f32(shp, "DamageOnHit", 0), 12.0f);
    const int *proj = (const int *)comp_of(shp, "Projectile");
    ASSERT_NOT_NULL(proj);
    const float *projf = (const float *)proj;
    ASSERT_EQ(projf[0], 3.0f);   /* range */
    ASSERT_EQ(proj[3], 3);       /* bounce */
    const float *poison = (const float *)comp_of(shp, "StatusEffectOnHit");
    ASSERT_NOT_NULL(poison);
    ASSERT_EQ(poison[0], 3.0f);    /* duration */
    ASSERT_EQ(poison[1], 30.0f);   /* PeriodicDamage (~total over duration) */
    ASSERT_EQ(poison[3], -0.75f);  /* magnitude (75% slow) */

    /* Eagle feather: dmg 12, pierce 4; recall buff +50% speed on spawner. */
    ecs_entity_t fp = tmpl("Feather_Projectile");
    ASSERT_EQ(field_f32(fp, "DamageOnHit", 0), 12.0f);
    const int *fproj = (const int *)comp_of(fp, "Projectile");
    ASSERT_NOT_NULL(fproj);
    ASSERT_EQ(fproj[2], 4);      /* pierce */
    const float *buff = (const float *)
        comp_of(tmpl("FeatherRecall_Spawner"), "StatusEffectOnHit");
    ASSERT_NOT_NULL(buff);
    ASSERT_EQ(buff[3], 0.5f);      /* +50% move speed */
    ASSERT_EQ(buff[0], 1.1f);      /* duration */

    /* Eagle per-level: pierce_limit[19] == 20; frog bounce_limit[19] == 10. */
    const float *eb = (const float *)comp_of(tmpl("HeroEagle"),
                                             "HeroLevelBonus");
    ASSERT_NOT_NULL(eb);
    ASSERT_EQ(eb[20 + 19], 20.0f);  /* pierce_limit array is field 2 of 3 */
    ASSERT_EQ(eb[40 + 19], 20.0f);  /* recall_limit */
    const float *fb = (const float *)comp_of(frog, "HeroLevelBonus");
    ASSERT_NOT_NULL(fb);
    ASSERT_EQ(fb[19], 10.0f);       /* bounce_limit */
    teardown();
}

TEST(abilities_and_pickups) {
    start();
    /* SlimeAttack: id 3, 0/0.75/1.25, ready at 0.35, dmg 12.5, reset 1. */
    ecs_entity_t sa = tmpl("SlimeAttack");
    const float *cfgf = (const float *)comp_of(sa, "AbilityConfig");
    const int *cfgi = (const int *)cfgf;
    ASSERT_NOT_NULL(cfgf);
    ASSERT_EQ(cfgi[0], 3);          /* AbilityId */
    ASSERT_EQ(cfgf[1], 0.0f);       /* windup */
    ASSERT_EQ(cfgf[2], 0.75f);      /* active */
    ASSERT_EQ(cfgf[3], 1.25f);      /* recovery */
    ASSERT_EQ(cfgf[7], 0.35f);      /* max_range */
    ASSERT_EQ(field_f32(sa, "DamageOnHit", 0), 12.5f);
    ASSERT_EQ(field_f32(sa, "DamageOnHit", 3), 1.0f);   /* reset_time */

    /* LargeCubeCharge: cooldown 2 s starting on cooldown, dmg 25. */
    ecs_entity_t cc = tmpl("LargeCubeCharge");
    const float *ccf = (const float *)comp_of(cc, "AbilityConfig");
    ASSERT_NOT_NULL(ccf);
    ASSERT_EQ(ccf[4], 2.0f);        /* cooldown */
    ASSERT_EQ(field_f32(cc, "DamageOnHit", 0), 25.0f);

    /* Pickups: gem value 1, heart value 25 + heal ratio 0.25 on config;
       drop rates 50% / 3.75%. */
    const int *gem = (const int *)comp_of(tmpl("GemPickup"), "Pickup");
    ASSERT_NOT_NULL(gem);
    ASSERT_EQ(gem[0], 1);                        /* effect: gem/XP */
    const float *heart = (const float *)comp_of(tmpl("HeartPickup"),
                                                "Pickup");
    ASSERT_NOT_NULL(heart);
    ASSERT_EQ(heart[1], 25.0f);
    ecs_entity_t gc = tmpl("GameConfig");
    const float *pk = (const float *)comp_of(gc, "PickupConfig");
    ASSERT_NOT_NULL(pk);
    ASSERT_EQ(pk[3], 0.5f);         /* gem_drop_scale */
    ASSERT_EQ(pk[4], 0.0375f);      /* heart_drop_scale (Adventure) */
    ASSERT_EQ(pk[5], 0.25f);        /* heart_heal_ratio */
    teardown();
}

TEST(game_config_and_level_tables) {
    start();
    ecs_entity_t gc = tmpl("GameConfig");
    const int *tc = (const int *)comp_of(gc, "GameTimeConfig");
    ASSERT_NOT_NULL(tc);
    ASSERT_EQ(tc[0], 60);                          /* tick_rate */
    ASSERT_EQ(((const float *)tc)[1], 0.25f);      /* periodic tick */
    const float *sc = (const float *)comp_of(gc, "SpawnConfig");
    ASSERT_NOT_NULL(sc);
    ASSERT_EQ(sc[0], 1.25f);                       /* spawn delay */
    const float *go = (const float *)comp_of(gc, "GameOverConfig");
    ASSERT_NOT_NULL(go);
    ASSERT_EQ(go[0], 180.0f);                      /* victory timer */
    const float *cc = (const float *)comp_of(gc, "CombatConfig");
    ASSERT_NOT_NULL(cc);
    ASSERT_EQ(cc[1], 1.0f);                        /* damage_taken_ratio */

    /* Level tables: layout max_level(i32) + xp[20](i32) + damage[20] +
       health[20] (f32). */
    const int *cl = (const int *)comp_of(gc, "CreatureLevelUp");
    ASSERT_NOT_NULL(cl);
    ASSERT_EQ(cl[0], 20);
    ASSERT_EQ(cl[1 + 1], 11);      /* xp[1] */
    ASSERT_EQ(cl[1 + 19], 2090);   /* xp[19] */
    const float *clf = (const float *)cl;
    ASSERT(clf[21 + 19] > 1.94f && clf[21 + 19] < 1.96f);  /* damage L20 */
    ASSERT(clf[41 + 19] > 6.69f && clf[41 + 19] < 6.71f);  /* health L20 */
    const int *hl = (const int *)comp_of(gc, "HeroLevelUp");
    ASSERT_NOT_NULL(hl);
    ASSERT_EQ(hl[1 + 19], 950);
    const float *hlf = (const float *)hl;
    ASSERT(hlf[21 + 19] > 12.39f && hlf[21 + 19] < 12.41f);

    /* GameState singleton: wave cursor initialized to wave 1 at 5 s. */
    ecs_entity_t gs = tmpl("GameState");
    const int *ws = (const int *)comp_of(gs, "WaveState");
    ASSERT_NOT_NULL(ws);
    ASSERT_EQ(ws[0], 1);
    ASSERT_EQ(ws[1], 300);
    teardown();
}

TEST(spawned_scene_content) {
    start();
    /* Two heroes at (+-0.5, 0) and 8 gems, positions applied via
       spawn_list params. */
    ecs_entity_t pos_comp = ecs_lookup(engine->world, "Position");
    ASSERT(pos_comp != 0);
    int heroes = 0, gems = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *name = list.items[i].name;
        if (!name) continue;
        const float *p = (const float *)
            ecs_get_id(engine->world, list.items[i].id, pos_comp);
        if (strncmp(name, "HeroEagle_", 10) == 0 ||
            strncmp(name, "HeroFrog_", 9) == 0) {
            ASSERT_NOT_NULL(p);
            ASSERT(p[0] == 0.5f || p[0] == -0.5f);
            ASSERT_EQ(p[1], 0.0f);
            heroes++;
        }
        if (strncmp(name, "GemPickup_", 10) == 0) {
            ASSERT_NOT_NULL(p);
            ASSERT(p[1] >= 3.5f && p[1] <= 4.5f);
            gems++;
        }
    }
    engine_entity_list_free(&list);
    printf("\n    [heroes=%d gems=%d] ", heroes, gems);
    ASSERT_EQ(heroes, 2);
    ASSERT_EQ(gems, 8);
    teardown();
}

/* --- Data files ----------------------------------------------------------- */

static int filters_interact(const FactionMatrix *m, const char *a,
                            const char *b) {
    const FactionFilterDef *fa = faction_matrix_filter(m, a);
    const FactionFilterDef *fb = faction_matrix_filter(m, b);
    if (!fa || !fb) return -1; /* fails any ASSERT_EQ against 0/1 */
    return faction_filter_match(fa->filter, fb->filter) ? 1 : 0;
}

TEST(faction_matrix_loads_with_quirk) {
    FactionMatrix m;
    ASSERT(faction_matrix_load(&m, "sandboxes/sashimi/data/faction-matrix.yaml"));
    ASSERT_EQ(m.category_count, 16);

    /* Core rules: red harm hits blue units, not red; pickups (blue help)
       touch only blue units; friendly fire impossible by construction. */
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Red", "Unit_Blue"), 1);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Red", "Unit_Red"), 0);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Blue", "Unit_Red"), 1);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Blue", "Unit_Blue"), 0);
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Blue", "Unit_Blue"), 1);
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Blue", "Unit_Red"), 0);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Global", "Unit_Blue"), 1);
    ASSERT_EQ(filters_interact(&m, "HarmEffect_Global", "Unit_Red"), 1);

    /* The preserved HelpEffect_Global one-bit-shift quirk: it does NOT
       reach Blue units (shipped behavior), but does reach Red. */
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Global", "Unit_Blue"), 0);
    ASSERT_EQ(filters_interact(&m, "HelpEffect_Global", "Unit_Red"), 1);
}

TEST(waves_file_shape) {
    /* Structural check of data/waves.yaml: 36 waves, 509 entries, intro
       beats at 6/11/16/21. Full parsing belongs to the spawn director at
       slice assembly. */
    FILE *f = fopen("sandboxes/sashimi/data/waves.yaml", "r");
    ASSERT_NOT_NULL(f);
    char line[512];
    int waves = 0, entries = 0;
    int intro_wolf = 0, intro_golem = 0, intro_wisp = 0, intro_cube = 0;
    int cur_wave = 0;
    while (fgets(line, sizeof(line), f)) {
        if (sscanf(line, "  - wave: %d", &cur_wave) == 1) waves++;
        if (strstr(line, "- { template: ")) entries++;
        if (strstr(line, "intro: CreatureWolf")) intro_wolf = cur_wave;
        if (strstr(line, "intro: CreatureRockGolem")) intro_golem = cur_wave;
        if (strstr(line, "intro: CreatureWisp")) intro_wisp = cur_wave;
        if (strstr(line, "intro: LargeTealCube")) intro_cube = cur_wave;
    }
    fclose(f);
    printf("\n    [waves=%d entries=%d intros=%d/%d/%d/%d] ",
           waves, entries, intro_wolf, intro_golem, intro_wisp, intro_cube);
    ASSERT_EQ(waves, 36);
    ASSERT_EQ(entries, 509);
    ASSERT_EQ(intro_wolf, 6);
    ASSERT_EQ(intro_golem, 11);
    ASSERT_EQ(intro_wisp, 16);
    ASSERT_EQ(intro_cube, 21);
}

int main(void) {
    TEST_SUITE("Sashimi Content (generated data layer)");
    RUN(sandbox_loads_clean);
    RUN(creature_roster_values);
    RUN(hero_kits);
    RUN(abilities_and_pickups);
    RUN(game_config_and_level_tables);
    RUN(spawned_scene_content);
    RUN(faction_matrix_loads_with_quirk);
    RUN(waves_file_shape);
    TEST_RESULTS();
}
/* Sashimi native-systems tests (ctest: test_sashimi_systems).
 *
 * Per-mechanism unit tests (damage ratio, poison/slow timing, level-up
 * tables, drop rates, wave director, kite AI, faction-filtered collision)
 * plus the headless end-to-end acceptance run: with FLECS_SEED pinned and
 * the headless-verify config (heroes take 50% damage), a full game must
 * run to completion. Run from the project root (ctest sets the cwd).
 *
 * Scenario tests drive individual systems with engine_system_run_one on a
 * world prepared by sandbox select + app start (legacy mode), mirroring
 * how the real tick runs them in app.yaml system_order.
 */
#include "test.h"
#include "../../../engine/src/engine/engine.h"
#include "../../../engine/src/engine/simulation.h"
#include "../../../engine/src/engine/components.h"
#include "../../../engine/src/engine/templates.h"
#include "../../../engine/src/engine/systems.h"
#include "../../../engine/src/engine/app.h"
#include <math.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static Engine *engine;

static void setup_cfg(const char *config) {
    setenv("FLECS_SEED", "12345", 1);
    engine = engine_init(NULL);
    snprintf(engine->sandboxes_dir, sizeof(engine->sandboxes_dir),
             "./sandboxes/");
    if (!engine_sandbox_select(engine, "sashimi")) {
        fprintf(stderr, "FATAL: sandbox select failed\n");
        exit(1);
    }
    AppStartResult asr;
    if (!engine_app_start(engine, config, &asr)) {
        fprintf(stderr, "FATAL: app start failed\n");
        exit(1);
    }
    /* Run the one-shot app_start system now (seeds RNG, loads the faction
     * matrix + wave table, inits the spatial hash, bridges the named
     * config) so scenario tests can drive individual systems directly. */
    engine_system_run_one(engine, "app_start");
}
static void setup(void) { setup_cfg(NULL); }

static void teardown(void) {
    engine_fini(engine);
    engine = NULL;
}

/* One full tick through the legacy system_order. */
static void tick(void) {
    TurnResult tr;
    engine_sim_turn(engine, &tr);
    engine_turn_result_free(&tr);
}

static ecs_entity_t comp(const char *name) {
    return ecs_lookup(engine->world, name);
}

static void *get_mut(ecs_entity_t e, const char *c) {
    ecs_entity_t cid = comp(c);
    return cid ? ecs_get_mut_id(engine->world, e, cid) : NULL;
}
static const void *get(ecs_entity_t e, const char *c) {
    ecs_entity_t cid = comp(c);
    return cid ? ecs_get_id(engine->world, e, cid) : NULL;
}
static bool has(ecs_entity_t e, const char *c) {
    ecs_entity_t cid = comp(c);
    return cid && ecs_has_id(engine->world, e, cid);
}
static void set_pos(ecs_entity_t e, float x, float y) {
    float *p = (float *)get_mut(e, "Position");
    if (p) { p[0] = x; p[1] = y; }
}
static void run(const char *sys) { engine_system_run_one(engine, sys); }

/* Delete the spawn_list content (2 heroes + 8 gems) for scenario tests
 * that build their own world state. */
static void clear_spawned(void) {
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *n = list.items[i].name;
        if (!n) continue;
        if (strncmp(n, "HeroEagle_", 10) == 0 ||
            strncmp(n, "HeroFrog_", 9) == 0 ||
            strncmp(n, "GemPickup_", 10) == 0)
            ecs_delete(engine->world, list.items[i].id);
    }
    engine_entity_list_free(&list);
}

static ecs_entity_t spawn_at(const char *tmpl, float x, float y) {
    ecs_entity_t e = engine_entity_spawn(engine, tmpl, NULL);
    if (e) set_pos(e, x, y);
    return e;
}

static int count_named_prefix(const char *prefix) {
    int n = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, prefix, strlen(prefix)) == 0)
            n++;
    engine_entity_list_free(&list);
    return n;
}

static ecs_entity_t find_first_named(const char *prefix) {
    ecs_entity_t found = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, prefix, strlen(prefix)) == 0) {
            found = list.items[i].id;
            break;
        }
    engine_entity_list_free(&list);
    return found;
}

/* Shared mirror structs for the projectile tests (layouts match the
 * registered components; see systems.c). */
struct TRt { ecs_entity_t shooter; int32_t hits, pierce, bounce; float dist; };
struct TDmg { float damage; int32_t hit_limit; ecs_bool_t ign; float reset; };

/* --- template inheritance regression ---------------------------------- */

/* Regression for the engine copy_template_components dangling-pointer bug:
 * inherited-but-not-overridden fields of extends-variants (Shuriken_Weapon's
 * ChildOffset from ProjectileWeaponEntity) came out as garbage once enough
 * templates shared the destination table (reallocation during the copy).
 * Symptom in-game: weapon fire positions at +-1e23, no projectiles ever. */
TEST(inherited_child_offset_survives_template_load) {
    setup();
    ecs_entity_t sw = ecs_lookup(engine->world, "Shuriken_Weapon");
    const float *co = (const float *)get(sw, "ChildOffset");
    ASSERT_NOT_NULL(co);
    ASSERT_EQ(co[0], 0.0f);
    ASSERT_EQ(co[1], 0.0f);

    ecs_entity_t hero = engine_entity_spawn(engine, "HeroFrog", NULL);
    ecs_entity_t weapon = ecs_lookup_child(engine->world, hero, "weapon");
    co = (const float *)get(weapon, "ChildOffset");
    ASSERT_NOT_NULL(co);
    ASSERT_EQ(co[0], 0.0f);
    ASSERT_EQ(co[1], 0.0f);
    teardown();
}

/* --- damage ratio ---------------------------------------------------- */

/* A slime melee hit deals 12.5 * damage_taken_ratio to a hero (heroes are
 * the only entities the ratio modifies; creatures take full damage). */
static float hero_hp_after_slime_hit(const char *config) {
    setup_cfg(config);
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    if (!hero || !slime || !attack) { teardown(); return -1; }

    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");

    /* Force the ability hitbox live (bypassing the state machine). */
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.1f, 0);

    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(hero, "Health");
    float cur = h ? h[0] : -1;
    teardown();
    return cur;
}

TEST(damage_taken_ratio_math) {
    /* Default config: ratio 1.0 -> 50 - 12.5 = 37.5 */
    float full = hero_hp_after_slime_hit(NULL);
    ASSERT_EQ(full, 37.5f);
    /* headless-verify: ratio 0.5 -> 50 - 6.25 = 43.75 */
    float half = hero_hp_after_slime_hit("headless-verify");
    ASSERT_EQ(half, 43.75f);
}

TEST(creatures_take_full_damage_regardless_of_ratio) {
    setup_cfg("headless-verify");
    clear_spawned();

    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0, 0);
    run("game_time");

    /* A shuriken overlapping the slime: full 12 damage (no ratio). */
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt =
        { 0, 0, 0, 3, 3.0f };
    ecs_entity_t rt_c = comp("ProjectileRuntime");
    ecs_set_id(engine->world, proj, rt_c, sizeof(rt), &rt);

    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(slime, "Health");
    ASSERT_EQ(h[0], 18.0f); /* 30 - 12 */
    /* Poison + slow applied on hit. */
    ASSERT(has(slime, "StatusPoison"));
    ASSERT(has(slime, "StatusSlow"));
    const float *slow = (const float *)get(slime, "StatusSlow");
    ASSERT_EQ(slow[1], -0.75f); /* magnitude (75% slow) */
    teardown();
}

/* --- same-tick hero damage aggregation -------------------------------- */

/* Unity records every landed hit, then applies to heroes only the MAX of
 * the tick's hits (ApplyDamageSystem.cs:97-110); every landing attacker
 * still runs full bookkeeping (pair entry, hit-budget consumption,
 * statuses). Author-confirmed intent: heroes gain brief invulnerability
 * on taking damage, enemies do not, so hero same-tick hits collapse. */
TEST(hero_same_tick_hits_collapse_to_max) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0); /* 50 HP */
    ecs_entity_t s1 = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t s2 = spawn_at("CreatureSlimeOrange", -0.1f, 0);
    ecs_entity_t a1 = ecs_lookup_child(engine->world, s1, "attack");
    ecs_entity_t a2 = ecs_lookup_child(engine->world, s2, "attack");
    ASSERT(a1 && a2);

    /* Give the attack children positions, then force both hitboxes live
       with distinct damages: 12.5 and 20. */
    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct Col { int32_t shape; float r, w, h; ecs_bool_t on; } *col;
    col = get_mut(a1, "Collider"); col->on = true;
    col = get_mut(a2, "Collider"); col->on = true;
    set_pos(a1, 0.1f, 0);
    set_pos(a2, -0.1f, 0);
    struct Dmg { float damage; int32_t hit_limit; ecs_bool_t ign; float reset; }
        *dm = get_mut(a2, "DamageOnHit");
    dm->damage = 20.0f;

    run("spatial_hash");
    run("damage_apply");

    /* Hero HP change = MAX(12.5, 20) = 20, not the 32.5 sum. */
    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 30.0f);
    ASSERT(has(hero, "TookDamage"));
    ASSERT(has(hero, "IFramesTimer"));

    /* Both attackers landed: hit budgets consumed for BOTH (Unity's
       overkill/i-frame-free bookkeeping), not just the first. */
    const int32_t *hc1 = (const int32_t *)get(a1, "HitCount");
    const int32_t *hc2 = (const int32_t *)get(a2, "HitCount");
    ASSERT_NOT_NULL(hc1);
    ASSERT_NOT_NULL(hc2);
    ASSERT_EQ(hc1[0], 1);
    ASSERT_EQ(hc2[0], 1);
    teardown();
}

/* A resolved damage of <= 0 (damage_taken_ratio 0) is not a hit: no HP
 * change, no TookDamage, no i-frames (ResolveDamageSystem.cs:121 returns
 * before the damage reaction and the i-frame grant). */
TEST(zero_resolved_damage_sets_no_flags) {
    setup();
    clear_spawned();

    /* Victim-side ratio 0: heroes take no damage at all. */
    ecs_entity_t gc = ecs_lookup(engine->world, "GameConfig");
    float *cc = (float *)get_mut(gc, "CombatConfig");
    cc[1] = 0.0f; /* damage_taken_ratio */

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.1f, 0);
    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 50.0f);
    ASSERT(!has(hero, "TookDamage"));
    ASSERT(!has(hero, "IFramesTimer"));
    /* The attacker still landed (bookkeeping is pre-resolution). */
    const int32_t *hc = (const int32_t *)get(attack, "HitCount");
    ASSERT_NOT_NULL(hc);
    ASSERT_EQ(hc[0], 1);
    teardown();
}

/* Overkill hits on a dying non-hero still consume the projectile hit
 * budget: Unity keeps HP<=0 victims hittable until DefeatSystem runs. */
TEST(overkill_hits_consume_projectile_budget) {
    setup();
    clear_spawned();

    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0, 0); /* 30 HP */
    float *sh = (float *)get_mut(slime, "Health");
    sh[0] = 0.5f; /* dying, not yet Defeated */

    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt =
        { 0, 0, 0, 0, 3.0f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"), sizeof(rt), &rt);

    run("game_time");
    run("spatial_hash");
    run("damage_apply");
    const struct { ecs_entity_t sh2; int32_t hits, pl, bl; float dl; }
        *prt = get(proj, "ProjectileRuntime");
    ASSERT_EQ(prt->hits, 1);

    /* A second overlap victim at HP <= 0 (pre-Defeat) also consumes. */
    ecs_entity_t slime2 = spawn_at("CreatureSlimeOrange", 0.05f, 0);
    sh = (float *)get_mut(slime2, "Health");
    sh[0] = -5.0f;
    run("spatial_hash");
    run("damage_apply");
    prt = get(proj, "ProjectileRuntime");
    ASSERT_EQ(prt->hits, 2);
    teardown();
}

/* --- poison / slow timing -------------------------------------------- */

/* Unity per-periodic-tick poison = PeriodicDamage * PeriodicTickTime /
 * Duration (StatusEffectsSystem.cs:294): shuriken 30 * 0.25 / 3 = 2.5 per
 * pulse, ~30 total over the 3 s duration. The shooter's damage multiplier
 * scales PeriodicDamage at projectile spawn
 * (ProjectileLifecycleSystem.cs:183-191). */
TEST(poison_ticks_on_periodic_clock_and_expires) {
    setup();
    clear_spawned();

    ecs_entity_t golem = spawn_at("CreatureRockGolem", 0, 0); /* 150 HP */

    /* Apply poison through a real shuriken hit (unowned projectile:
       multiplier 1.0). */
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt =
        { 0, 0, 0, 3, 3.0f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"), sizeof(rt), &rt);
    run("game_time");
    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(golem, "Health");
    ASSERT_EQ(h[0], 138.0f); /* 150 - 12 direct hit */
    const struct { int32_t ticks; float dmg; } *p = get(golem, "StatusPoison");
    ASSERT_NOT_NULL(p);
    ASSERT_EQ(p->ticks, 180);            /* 3 s at 60 Hz */
    ASSERT(fabsf(p->dmg - 2.5f) < 1e-4f); /* 30 * 0.25 / 3 */
    ecs_delete(engine->world, proj);

    /* 180 ticks: periodic clock fires every 15 ticks -> 12 pulses of 2.5,
       total-over-duration = 30 (the serialized PeriodicDamage). */
    int pulses = 0;
    float prev = 138.0f;
    for (int t = 0; t < 185; t++) {
        run("game_time");
        run("status_effects");
        h = (const float *)get(golem, "Health");
        if (h[0] < prev) { pulses++; prev = h[0]; }
    }
    ASSERT_EQ(pulses, 12);
    h = (const float *)get(golem, "Health");
    ASSERT(fabsf(h[0] - (138.0f - 30.0f)) < 1e-3f); /* ~30 total, not 360 */
    ASSERT(!has(golem, "StatusPoison"));  /* expired -> removed */

    /* Shooter-scaled: a level-3 hero's shuriken (damage mult 1.35) poisons
       at 2.5 * 1.35 = 3.375 per pulse. */
    ecs_entity_t hero = spawn_at("HeroFrog", -9, -6);
    int32_t *xp = (int32_t *)get_mut(hero, "Experience");
    xp[1] = 3; /* level (xp field is f32 but level is the 2nd i32 slot) */
    ecs_entity_t golem2 = spawn_at("CreatureRockGolem", 5, 5);
    ecs_entity_t proj2 = spawn_at("Shuriken_Projectile", 5, 5);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt2 =
        { hero, 0, 0, 3, 3.0f };
    ecs_set_id(engine->world, proj2, comp("ProjectileRuntime"),
               sizeof(rt2), &rt2);
    run("spatial_hash");
    run("damage_apply");
    p = get(golem2, "StatusPoison");
    ASSERT_NOT_NULL(p);
    ASSERT(fabsf(p->dmg - 3.375f) < 1e-4f);
    teardown();
}

TEST(slow_reduces_movement_and_expires) {
    setup();
    clear_spawned();

    /* Wolf (speed 1.75) chasing a hero placed inside acquire radius. */
    ecs_entity_t hero = spawn_at("HeroFrog", 4, 0);
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0, 0);
    (void)hero;

    /* Unslowed distance covered in 60 ticks. */
    run("game_time");
    run("spatial_hash");
    run("targeting");
    float x0 = ((const float *)get(wolf, "Position"))[0];
    for (int t = 0; t < 60; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    float moved_free = ((const float *)get(wolf, "Position"))[0] - x0;

    /* Reset position, apply -75% slow for 60 ticks. */
    set_pos(wolf, 0, 0);
    struct { int32_t ticks; float mag; } slow = { 999, -0.75f };
    ecs_set_id(engine->world, wolf, comp("StatusSlow"), sizeof(slow), &slow);
    for (int t = 0; t < 60; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    float moved_slow = ((const float *)get(wolf, "Position"))[0];

    ASSERT(moved_free > 1.5f && moved_free < 2.0f);   /* ~1.75 */
    ASSERT(fabsf(moved_slow - moved_free * 0.25f) < 0.05f);

    /* Expiry: remaining ticks hit 0 -> component removed. */
    struct { int32_t ticks; float mag; } short_slow = { 3, -0.75f };
    ecs_set_id(engine->world, wolf, comp("StatusSlow"),
               sizeof(short_slow), &short_slow);
    for (int t = 0; t < 4; t++) { run("game_time"); run("status_effects"); }
    ASSERT(!has(wolf, "StatusSlow"));
    teardown();
}

/* --- level-up tables -------------------------------------------------- */

TEST(level_up_applies_tables_and_projectile_increments) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    int32_t *ms = (int32_t *)get_mut(gs, "MatchStats");
    ms[0] = 15; /* xp[2] = 15 -> level 3 */

    /* Damage the hero so the proportional rescale is observable. */
    float *h = (float *)get_mut(hero, "Health");
    h[0] = 20.0f;

    run("game_time");
    run("level_up");

    const int32_t *xp = (const int32_t *)get(hero, "Experience");
    ASSERT_EQ(xp[1], 3); /* level */
    h = (float *)get_mut(hero, "Health");
    /* max scaled by health[2] = 1.2; current rescales PROPORTIONALLY
       (HeroLevelUpSystem.cs:143-148 - the heal-to-full block at :56-65
       is commented out in live Unity; the damage fraction persists). */
    ASSERT(fabsf(h[1] - 50.0f * 1.2f) < 0.01f);
    ASSERT(fabsf(h[0] - 20.0f * 1.2f) < 0.01f);

    /* Weapon fire at level 3: frog bounce = floor(3/2) = 1 (the owner's
       absolute per-level stat REPLACES the serialized base 3;
       ProjectileLifecycleSystem.cs:167-174). */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 1.0f, 0);
    (void)slime;
    run("spatial_hash");
    /* Elapse the initial 0.75 s weapon cooldown (45 ticks + init tick). */
    for (int t = 0; t < 47; t++) run("weapon_fire");

    /* Find the spawned projectile. */
    ecs_entity_t proj = find_first_named("Shuriken_Projectile_");
    ASSERT(proj != 0);
    const struct TRt *rt = get(proj, "ProjectileRuntime");
    ASSERT_NOT_NULL(rt);
    ASSERT_EQ(rt->bounce, 1);
    ASSERT_EQ(rt->shooter, hero);
    const struct TDmg *pdm = get(proj, "DamageOnHit");
    ASSERT_EQ(pdm->hit_limit, 2); /* 0 + 1 + 1 */

    /* Hero damage multiplier at level 3 = 1.35 -> hit deals 12 * 1.35.
       Let the projectile fly (speed 5, slime 1.0 away). */
    for (int t = 0; t < 15; t++) {
        run("spatial_hash");
        run("movement");
        run("damage_apply");
        run("projectile_lifecycle");
    }
    const float *sh = (const float *)get(slime, "Health");
    ASSERT(fabsf(sh[0] - (30.0f - 12.0f * 1.35f)) < 0.01f);
    teardown();
}

/* --- drop rates -------------------------------------------------------- */

/* Pity pools, not Bernoulli (OnDefeatedSystem.cs:63-88): every kill adds
 * GemDropScale (0.5) / HeartDropScale (0.0375) to the match-wide pools;
 * a drop happens when Random.value < pool and subtracts 1. Same expected
 * rates, but the pool bounds the total tightly: after N kills the drop
 * count is N*scale - final_pool with final_pool in [0, ~1.5), so 400
 * kills yield exactly 199-200 gems and 14-15 hearts regardless of seed. */
TEST(drop_rates_seeded) {
    setup(); /* FLECS_SEED pinned in setup */
    clear_spawned();

    /* Defeat 400 slimes far from anything. */
    ecs_entity_t hero = spawn_at("HeroFrog", -9, -6); /* drops need no hero,
                                                         but keep world sane */
    (void)hero;
    int gems_before = count_named_prefix("GemPickup_");
    for (int i = 0; i < 400; i++) {
        ecs_entity_t s = spawn_at("CreatureSlimeOrange", 5, 5);
        float *h = (float *)get_mut(s, "Health");
        h[0] = 0;
        run("defeat");
        run("on_defeated");
    }
    int gems = count_named_prefix("GemPickup_") - gems_before;
    int hearts = count_named_prefix("HeartPickup_");
    printf("\n    [400 kills -> gems=%d hearts=%d] ", gems, hearts);
    ASSERT(gems >= 199 && gems <= 200);
    ASSERT(hearts >= 14 && hearts <= 15);

    const int32_t *ms = (const int32_t *)
        get(ecs_lookup(engine->world, "GameState"), "MatchStats");
    ASSERT_EQ(ms[1], 400); /* kills counted */
    teardown();
}

/* The gem pool guarantees a drop whenever it reaches 1.0: two dropless
 * kills raise it from any post-drop value (>= 0) to >= 1.0, so a gem
 * lands at latest every 3rd kill â€” no droughts. */
TEST(gem_pity_guarantee_no_droughts) {
    setup();
    clear_spawned();

    int prev_gems = count_named_prefix("GemPickup_");
    int streak = 0, worst = 0;
    for (int i = 0; i < 100; i++) {
        ecs_entity_t s = spawn_at("CreatureSlimeOrange", 5, 5);
        float *h = (float *)get_mut(s, "Health");
        h[0] = 0;
        run("defeat");
        run("on_defeated");
        int gems = count_named_prefix("GemPickup_");
        if (gems > prev_gems) streak = 0; else streak++;
        if (streak > worst) worst = streak;
        prev_gems = gems;
    }
    printf("\n    [worst dropless-kill streak %d] ", worst);
    ASSERT(worst <= 2);
    teardown();
}

/* Drop placement is a uniform square, not a ring: per axis
 * pos + (Random.value - 0.5) * DropDistance (+-0.25 at DropDistance 0.5),
 * and UNCLAMPED â€” Unity's SelectSpawnPoint (OnDefeatedSystem.cs:95-102)
 * never clamps to bounds, so wall kills can drop just outside the arena
 * (the magnet still reaches them: trigger radius 0.5 > 0.25). */
TEST(drop_position_uniform_square_unclamped) {
    setup();
    clear_spawned();

    /* Force a guaranteed gem per kill (pool >= 1 after the +0.5
       increment) and park the heart pool far negative. */
    struct Pools { float heart, gem; };
    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    ecs_entity_t pools_c = comp("DropPools");
    ASSERT(pools_c != 0);

    bool any_outside = false;
    for (int i = 0; i < 20; i++) {
        struct Pools pity = { -1000.0f, 1.0f };
        ecs_set_id(engine->world, gs, pools_c, sizeof(pity), &pity);
        ecs_entity_t s = spawn_at("CreatureSlimeOrange", 9.5f, 6.5f);
        float *h = (float *)get_mut(s, "Health");
        h[0] = 0;
        run("defeat");
        run("on_defeated");
    }
    int n_gems = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        if (!list.items[i].name ||
            strncmp(list.items[i].name, "GemPickup_", 10) != 0) continue;
        const float *p = (const float *)get(list.items[i].id, "Position");
        ASSERT_NOT_NULL(p);
        /* Inside the +-0.25 square around the kill... */
        ASSERT(fabsf(p[0] - 9.5f) <= 0.2500001f);
        ASSERT(fabsf(p[1] - 6.5f) <= 0.2500001f);
        /* ...and allowed past the arena walls. */
        if (p[0] > 9.5f || p[1] > 6.5f) any_outside = true;
        n_gems++;
    }
    engine_entity_list_free(&list);
    ASSERT_EQ(n_gems, 20);      /* pool >= 1 guarantees every kill */
    ASSERT(any_outside);        /* unclamped placement */
    ASSERT_EQ(count_named_prefix("HeartPickup_"), 0);
    teardown();
}

/* --- i-frames: broadphase exit ------------------------------------------ */

/* Unity's spatial-hash inserts require IFramesTimer disabled
 * (SpatialHashingSystem.cs:44-55): a just-hit hero leaves the broadphase
 * â€” and with it collision damage, anti-encroachment and pickup triggering
 * â€” for the 12-tick window (unhittable T+1..T+12, hittable again at
 * T+13). Creature targeting is NOT hash-fed in Unity (JustHeroes
 * candidates come from a hero query that only excludes OutOfGameTimer,
 * EnemyTargetingSystem.cs:37; current-target validation never consults
 * the hash, :118-156), so the creature KEEPS its target on the i-framed
 * hero throughout. */
TEST(iframed_hero_leaves_broadphase_for_window) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0); /* 50 HP */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.1f, 0);
    /* Re-hit every tick if the broadphase allows it. */
    struct { float damage; int32_t hit_limit; ecs_bool_t ign; float reset; }
        *dm = get_mut(attack, "DamageOnHit");
    dm->ign = true;
    dm->reset = 0.0f;

    /* Tick T: the hit lands. */
    run("spatial_hash");
    run("targeting");
    run("damage_apply");
    run("iframes");
    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 37.5f);
    ASSERT(has(hero, "IFramesTimer"));

    /* Ticks T+1..T+12: structurally unhittable (absent from the hash),
       but the creature keeps its EnemyTarget on the hero. */
    for (int k = 1; k <= 12; k++) {
        run("game_time");
        run("spatial_hash");
        run("targeting");
        run("damage_apply");
        run("iframes");
        h = (const float *)get(hero, "Health");
        ASSERT_EQ(h[0], 37.5f);
        const ecs_entity_t *et = (const ecs_entity_t *)
            get(slime, "EnemyTarget");
        ASSERT_NOT_NULL(et);
        ASSERT(et[0] == hero);
        /* Hash-fed pickup triggering is also blind to the hero. */
        if (k == 5) {
            ecs_entity_t gem = spawn_at("GemPickup", 0, 0);
            run("pickup_magnet");
            ASSERT(!has(gem, "PickupMagnet"));
            ecs_delete(engine->world, gem);
        }
    }

    /* Tick T+13: back in the hash, hittable again. */
    run("game_time");
    run("spatial_hash");
    run("targeting");
    run("damage_apply");
    h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 25.0f);
    teardown();
}

/* --- creature scaling --------------------------------------------------- */

/* Live Unity creatures never level (the SpawnCount level driver has no
 * live writer: CreatureSpawnSystem.cs is entirely #if false), so gems must
 * not scale creature HP or damage. The only live scaling is the co-op
 * rule: >1 living hero at spawn time -> creature HP *= 1.4
 * (UnitInitializationSystem.cs:55-58). */
static ecs_entity_t enqueue_pending(const char *tmpl, float x, float y) {
    static int seq = 0;
    char name[64];
    snprintf(name, sizeof(name), "pending_test_%d", seq++);
    ecs_entity_t e = engine_entity_create(engine, name);
    ecs_entity_t ps_c = comp("PendingSpawn");
    ecs_add_id(engine->world, e, ps_c);
    struct { char *tmpl; float x, y; int32_t ticks; } *ps =
        get_mut(e, "PendingSpawn");
    ps->tmpl = ecs_os_strdup(tmpl);
    ps->x = x; ps->y = y;
    ps->ticks = 1;
    return e;
}

TEST(coop_hp_multiplier_at_creature_spawn) {
    setup();
    clear_spawned();

    /* Two living heroes -> 1.4x HP at spawn. */
    ecs_entity_t h1 = spawn_at("HeroFrog", -9, -6);
    ecs_entity_t h2 = spawn_at("HeroEagle", -9, 6);
    (void)h2;
    run("game_time");
    int before = count_named_prefix("CreatureSlimeOrange_");
    enqueue_pending("CreatureSlimeOrange", 5, 5);
    run("delayed_spawn");
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), before + 1);
    EntityList list = engine_entity_list(engine);
    ecs_entity_t slime = 0;
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, "CreatureSlimeOrange_", 20) == 0)
            slime = list.items[i].id;
    engine_entity_list_free(&list);
    const float *h = (const float *)get(slime, "Health");
    ASSERT(fabsf(h[0] - 42.0f) < 1e-3f); /* 30 * 1.4 current */
    ASSERT(fabsf(h[1] - 42.0f) < 1e-3f); /* 30 * 1.4 max */

    /* Gems never scale creatures: even at a high gem count the next
       spawn is still only the co-op 1.4x. */
    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    int32_t *ms = (int32_t *)get_mut(gs, "MatchStats");
    ms[0] = 200; /* far beyond every CreatureLevelUp threshold */
    run("game_time");
    ecs_delete(engine->world, slime);
    enqueue_pending("CreatureSlimeOrange", 5, 5);
    run("delayed_spawn");
    list = engine_entity_list(engine);
    slime = 0;
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, "CreatureSlimeOrange_", 20) == 0)
            slime = list.items[i].id;
    engine_entity_list_free(&list);
    h = (const float *)get(slime, "Health");
    ASSERT(fabsf(h[1] - 42.0f) < 1e-3f); /* still 1.4x, not gem-leveled */
    ecs_delete(engine->world, slime);

    /* One living hero (other defeated) -> no multiplier. */
    ecs_add_id(engine->world, h1, comp("Defeated"));
    enqueue_pending("CreatureSlimeOrange", 5, 5);
    run("delayed_spawn");
    list = engine_entity_list(engine);
    slime = 0;
    for (int i = 0; i < list.count; i++)
        if (list.items[i].name &&
            strncmp(list.items[i].name, "CreatureSlimeOrange_", 20) == 0)
            slime = list.items[i].id;
    engine_entity_list_free(&list);
    h = (const float *)get(slime, "Health");
    ASSERT(fabsf(h[0] - 30.0f) < 1e-3f);
    ASSERT(fabsf(h[1] - 30.0f) < 1e-3f);
    teardown();
}

/* Creature melee damage is never multiplier-scaled: only projectile
 * spawns read DamageMultiplierStat (ProjectileLifecycleSystem.cs:177-191),
 * and the creature level never moves anyway. Gems must not change the
 * slime melee hit. */
TEST(creature_melee_damage_unscaled_by_gems) {
    setup();
    clear_spawned();

    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    int32_t *ms = (int32_t *)get_mut(gs, "MatchStats");
    ms[0] = 200;

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.1f, 0);
    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 37.5f); /* 50 - 12.5, no creature-level multiplier */
    teardown();
}

/* --- projectile per-level stats (weapon_fire) --------------------------- */

/* Unity REPLACES the projectile prefab's Piercing/Bouncing with the
 * owner's absolute per-level stats at projectile spawn and recomputes
 * HitLimit = Piercing + Bouncing + 1 (ProjectileLifecycleSystem.cs:
 * 167-174). Stats: frog bounce = floor(level / 2), eagle pierce = level,
 * applied from level 1 (LevelUpHeroSpecificSO.cs:53-72). The serialized
 * bases (shuriken bounce 3 / hit_limit 4, feather pierce 4 / hit_limit 5)
 * stay extraction-faithful on disk and are ignored at fire time. Owners
 * without the stats (creature weapons: wisp) resolve 0/0 -> hit budget 1
 * (Unity TryGetComponent default). */
TEST(projectile_stats_replace_serialized_base) {
    setup();
    clear_spawned();

    /* L1 frog shuriken: floor(1/2) = 0 bounces, hit budget 1. */
    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 1.0f, 0);
    run("game_time");
    run("spatial_hash");
    for (int t = 0; t < 47; t++) run("weapon_fire");
    ecs_entity_t proj = find_first_named("Shuriken_Projectile_");
    ASSERT(proj != 0);
    const struct TRt *rt = get(proj, "ProjectileRuntime");
    const struct TDmg *dm = get(proj, "DamageOnHit");
    ASSERT_NOT_NULL(rt);
    ASSERT_NOT_NULL(dm);
    ASSERT_EQ(rt->pierce, 0);
    ASSERT_EQ(rt->bounce, 0);
    ASSERT_EQ(dm->hit_limit, 1);
    ecs_delete(engine->world, proj);

    /* L4 frog: floor(4/2) = 2 bounces, hit budget 3. */
    int32_t *xp = (int32_t *)get_mut(hero, "Experience");
    xp[1] = 4; /* level */
    for (int t = 0; t < 47; t++) run("weapon_fire");
    proj = find_first_named("Shuriken_Projectile_");
    ASSERT(proj != 0);
    rt = get(proj, "ProjectileRuntime");
    dm = get(proj, "DamageOnHit");
    ASSERT_EQ(rt->pierce, 0);
    ASSERT_EQ(rt->bounce, 2);
    ASSERT_EQ(dm->hit_limit, 3);
    ecs_delete(engine->world, proj);
    ecs_delete(engine->world, hero);

    /* L1 eagle feather: pierce = level = 1, hit budget 2. */
    ecs_entity_t eagle = spawn_at("HeroEagle", 0, 0);
    for (int t = 0; t < 47; t++) run("weapon_fire");
    proj = find_first_named("Feather_Projectile_");
    ASSERT(proj != 0);
    rt = get(proj, "ProjectileRuntime");
    dm = get(proj, "DamageOnHit");
    ASSERT_EQ(rt->pierce, 1);
    ASSERT_EQ(rt->bounce, 0);
    ASSERT_EQ(dm->hit_limit, 2);
    ecs_delete(engine->world, proj);
    ecs_delete(engine->world, eagle);
    ecs_delete(engine->world, slime);

    /* Wisp shot: creature owner has no per-level projectile stats ->
       0 pierce / 0 bounce, hit budget 1 (cooldown 3 s = 180 ticks). */
    ecs_entity_t wisp = spawn_at("CreatureWisp", 0, 0);
    ecs_entity_t hero2 = spawn_at("HeroFrog", 2.0f, 0);
    (void)hero2;
    run("spatial_hash");
    for (int t = 0; t < 182; t++) run("weapon_fire");
    proj = find_first_named("CreatureWisp_Projectile_");
    ASSERT(proj != 0);
    rt = get(proj, "ProjectileRuntime");
    dm = get(proj, "DamageOnHit");
    ASSERT_EQ(rt->pierce, 0);
    ASSERT_EQ(rt->bounce, 0);
    ASSERT_EQ(dm->hit_limit, 1);
    ASSERT_EQ(rt->shooter, wisp);
    teardown();
}

/* --- bounce fuel / failed-bounce semantics (projectile_lifecycle) ------- */

/* Unity bounce (OnHitEffectSystem.cs:94-192): on every bounce attempt the
 * remaining flight fuel becomes max(remaining, Range * 0.5) BEFORE the
 * retarget search, and the search radius is that fuel value â€” not the
 * full Range (:131-157). A bounce attempt with NO eligible target
 * forfeits ALL remaining bounces (BouncedCount = Bouncing) and the
 * projectile KEEPS FLYING straight, still able to hit victims up to its
 * hit budget (:173-177) â€” it does not convert to pierce and does not
 * die. The bounce job is per-entity, once per tick: a multi-victim tick
 * consumes a single bounce. */
TEST(bounce_fuel_and_failed_bounce_keeps_flying) {
    setup();
    clear_spawned();

    /* Projectile overlapping slime A; the only other unit (slime B) sits
       at 2.0 â€” inside the full range 3 but OUTSIDE the bounce fuel
       max(0.4, 1.5) = 1.5 â€” so the bounce attempt must fail. */
    ecs_entity_t sa = spawn_at("CreatureSlimeOrange", 0, 0);
    ecs_entity_t sb = spawn_at("CreatureSlimeOrange", 2.0f, 0);
    (void)sa;
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct TRt rt0 = { 0, 0, 0, 2, 0.4f }; /* 2 bounces, 0.4 fuel left */
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"),
               sizeof(rt0), &rt0);
    float vel0[2] = { 5.0f, 0.0f };
    ecs_set_id(engine->world, proj, comp("Velocity"), sizeof(vel0), vel0);

    run("game_time");
    run("spatial_hash");
    run("damage_apply");
    run("projectile_lifecycle");

    /* Failed bounce: all bounces forfeited, fuel refilled to half range,
       heading unchanged, projectile still alive. */
    ASSERT(ecs_is_alive(engine->world, proj));
    const struct TRt *rt = get(proj, "ProjectileRuntime");
    ASSERT_EQ(rt->hits, 1);
    ASSERT_EQ(rt->bounce, 0);
    ASSERT(fabsf(rt->dist - 1.5f) < 1e-4f); /* max(0.4, 3 * 0.5) */
    const float *v = (const float *)get(proj, "Velocity");
    ASSERT_EQ(v[0], 5.0f);
    ASSERT_EQ(v[1], 0.0f);

    /* Still flying and still able to hit up to the budget: overlap slime
       B (fresh victim) -> hit 2 of hit_limit 4 -> keeps flying; overlap
       two more -> budget exhausted -> spent. */
    set_pos(proj, 2.0f, 0);
    run("spatial_hash");
    run("damage_apply");
    run("projectile_lifecycle");
    ASSERT(ecs_is_alive(engine->world, proj));
    rt = get(proj, "ProjectileRuntime");
    ASSERT_EQ(rt->hits, 2);
    const float *sbh = (const float *)get(sb, "Health");
    ASSERT_EQ(sbh[0], 18.0f); /* 30 - 12 */

    ecs_entity_t sc = spawn_at("CreatureSlimeOrange", 2.0f, 0.05f);
    (void)sc;
    run("spatial_hash");
    run("damage_apply");
    run("projectile_lifecycle");
    ASSERT(ecs_is_alive(engine->world, proj));
    rt = get(proj, "ProjectileRuntime");
    ASSERT_EQ(rt->hits, 3);

    ecs_entity_t sd = spawn_at("CreatureSlimeOrange", 2.0f, -0.05f);
    (void)sd;
    run("spatial_hash");
    run("damage_apply");
    run("projectile_lifecycle");
    ASSERT(!ecs_is_alive(engine->world, proj)); /* hits 4 >= hit_limit 4 */
    teardown();
}

TEST(single_bounce_per_tick_and_fuel_keeps_remaining) {
    setup();
    clear_spawned();

    /* Two victims the same tick, plus an eligible retarget at 1.0: only
       ONE bounce may be consumed (Unity's job granularity), and fuel
       2.8 > half range stays 2.8 (max(2.8, 1.5)). */
    ecs_entity_t sa = spawn_at("CreatureSlimeOrange", 0, 0);
    ecs_entity_t sb = spawn_at("CreatureSlimeOrange", 0.05f, 0);
    ecs_entity_t sc = spawn_at("CreatureSlimeOrange", 1.0f, 0);
    (void)sa; (void)sb; (void)sc;
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct TRt rt0 = { 0, 0, 0, 2, 2.8f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"),
               sizeof(rt0), &rt0);
    float vel0[2] = { 0.0f, 5.0f }; /* heading away from everyone */
    ecs_set_id(engine->world, proj, comp("Velocity"), sizeof(vel0), vel0);

    run("game_time");
    run("spatial_hash");
    run("damage_apply");
    run("projectile_lifecycle");

    ASSERT(ecs_is_alive(engine->world, proj));
    const struct TRt *rt = get(proj, "ProjectileRuntime");
    ASSERT_EQ(rt->hits, 2);        /* both victims landed */
    ASSERT_EQ(rt->bounce, 1);      /* exactly one bounce consumed */
    ASSERT(fabsf(rt->dist - 2.8f) < 1e-4f); /* max(2.8, 1.5) */
    /* Retargeted toward the un-hit slime at (1.0, 0). */
    const float *v = (const float *)get(proj, "Velocity");
    ASSERT(v[0] > 4.9f);
    ASSERT(fabsf(v[1]) < 0.5f);
    teardown();
}

/* --- projectile flight in the Move phase (movement) --------------------- */

/* Unity moves projectiles inside MoveSystem (HandleMoveProjectileJob,
 * MoveSystem.cs:230-328) â€” the Move phase, before collision/damage â€” so
 * damage checks run against post-move projectile positions the same
 * tick. The final step is clamped to the remaining fuel (:281-294). */
TEST(projectile_moves_before_damage_same_tick) {
    setup();
    clear_spawned();

    /* Slime at 0.5; collision reach = 0.25 (shuriken) + 0.2 (slime) =
       0.45. Pre-move gap 0.05 < one step (5/60 = 0.0833): the hit must
       land THIS tick, off the post-move position. */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.5f, 0);
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct TRt rt0 = { 0, 0, 0, 0, 3.0f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"),
               sizeof(rt0), &rt0);
    float vel0[2] = { 5.0f, 0.0f };
    ecs_set_id(engine->world, proj, comp("Velocity"), sizeof(vel0), vel0);

    run("game_time");
    run("spatial_hash");
    run("movement");
    const float *pp = (const float *)get(proj, "Position");
    ASSERT(fabsf(pp[0] - 5.0f / 60.0f) < 1e-4f); /* moved one step */
    run("damage_apply");
    const float *h = (const float *)get(slime, "Health");
    ASSERT_EQ(h[0], 18.0f); /* hit on the spawn tick, post-move */
    const struct TRt *rt = get(proj, "ProjectileRuntime");
    ASSERT(fabsf(rt->dist - (3.0f - 5.0f / 60.0f)) < 1e-4f);
    teardown();
}

/* Unity clamps projectiles to MapBounds (MoveSystem.cs:296): they slide
 * along walls until the fuel is out â€” never culled at the bounds. The
 * final step is clamped to the remaining fuel and still lands that tick
 * (:281-294); range expiry spends the projectile in the lifecycle pass. */
TEST(projectile_wall_slides_until_fuel_out) {
    setup();
    clear_spawned();

    /* Heading diagonally into the +x wall from (9.0, 0): x clamps at
       9.5 while y keeps advancing (wall slide). Fuel 3.0 at speed 5 =
       36 ticks of flight. */
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 9.0f, 0);
    struct TRt rt0 = { 0, 0, 0, 0, 3.0f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"),
               sizeof(rt0), &rt0);
    float vel0[2] = { 3.5355339f, 3.5355339f }; /* 45 degrees, |v| = 5 */
    ecs_set_id(engine->world, proj, comp("Velocity"), sizeof(vel0), vel0);

    run("game_time");
    for (int t = 0; t < 20; t++) {
        run("movement");
        run("projectile_lifecycle");
        ASSERT(ecs_is_alive(engine->world, proj));
    }
    const float *pp = (const float *)get(proj, "Position");
    ASSERT_EQ(pp[0], 9.5f);                    /* clamped to the wall */
    ASSERT(fabsf(pp[1] - 20.0f * 5.0f / 60.0f * 0.70710678f) < 1e-3f);

    /* Old port culled at bounds+2 (would be long dead by now); the
       projectile must instead die by range expiry at ~tick 36. */
    int died_at = -1;
    for (int t = 20; t < 45; t++) {
        run("movement");
        run("projectile_lifecycle");
        if (!ecs_is_alive(engine->world, proj)) { died_at = t + 1; break; }
    }
    ASSERT(died_at >= 35 && died_at <= 38); /* 36 +- float accumulation */
    teardown();
}

/* --- wisp projectile damage parity --------------------------------------- */

/* Unity scales creature projectiles by the shooter's spawn-time
 * DamageMultiplierStat (ProjectileLifecycleSystem.cs:177-191), which is
 * always 1.0 for creatures â€” they never level (CreatureSpawnSystem.cs is
 * dead code). Wisp shots must deal exactly their serialized damage (10)
 * regardless of the shared gem count. */
TEST(wisp_shot_damage_unscaled_by_gems) {
    setup();
    clear_spawned();

    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    int32_t *ms = (int32_t *)get_mut(gs, "MatchStats");
    ms[0] = 200; /* far beyond every level threshold */

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0); /* 50 HP */
    ecs_entity_t wisp = spawn_at("CreatureWisp", 5, 5);
    ecs_entity_t shot = spawn_at("CreatureWisp_Projectile", 0, 0);
    struct TRt rt0 = { wisp, 0, 0, 0, 5.0f };
    ecs_set_id(engine->world, shot, comp("ProjectileRuntime"),
               sizeof(rt0), &rt0);

    run("game_time");
    run("spatial_hash");
    run("damage_apply");

    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 40.0f); /* 50 - 10 serialized, no creature multiplier */
    teardown();
}

/* --- wave director ----------------------------------------------------- */

/* Trace-exact EnemySpawnSystem schedule (EnemySpawnSystem.cs:84-146 +
 * UnitSpawnConfigAuthoring.cs:65-68): TimeToNextSpawn starts at 0, so wave
 * 1's warnings begin on the FIRST tick, one per tick (per-entry Delay =
 * 1 tick gates the next entry); TimeToNextWave starts at the first wave's
 * 5 s delay and each advance adds the new wave's delay with negative
 * carry, so wave N's warnings begin at tick (N-1)*300. The unconditional
 * TimeToNextSpawn drain (:86) plus the kept negative carry (:110) means
 * waves 2+ release ALL their warnings in the advance tick â€” shipped Unity
 * behavior, only wave 1 is paced 1/tick. Each warning materializes
 * SpawnConfig.spawn_delay = 1.25 s (75 ticks) later
 * (EnemySpawnSystem.cs:143, DelayedSpawnSystem.cs:47-53). */
TEST(wave_director_schedule) {
    setup();
    clear_spawned();

    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    const int32_t *ws = (const int32_t *)get(gs, "WaveState");
    ASSERT_EQ(ws[0], 1);    /* current wave */
    ASSERT_EQ(ws[1], 300);  /* 5 s at 60 Hz */

    /* Ticks 1..6: one wave-1 warning per tick, from the very first tick. */
    for (int t = 1; t <= 6; t++) {
        run("game_time"); run("spawn_director"); run("delayed_spawn");
        ASSERT_EQ(count_named_prefix("pending_w1_"), t);
    }
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 0);

    /* Telegraph: the tick-1 warning materializes at tick 76; the tick-6
       warning at tick 81. */
    for (int t = 7; t <= 75; t++) {
        run("game_time"); run("spawn_director"); run("delayed_spawn");
    }
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 0);
    run("game_time"); run("spawn_director"); run("delayed_spawn"); /* 76 */
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 1);
    for (int t = 77; t <= 81; t++) {
        run("game_time"); run("spawn_director"); run("delayed_spawn");
    }
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 6);
    ASSERT_EQ(count_named_prefix("pending_w1_"), 0);

    /* Wave 2 advance lands at tick 300 exactly and bursts all 7 warnings
       in that tick (negative TimeToNextSpawn carry). */
    for (int t = 82; t <= 299; t++) {
        run("game_time"); run("spawn_director"); run("delayed_spawn");
    }
    ws = (const int32_t *)get(gs, "WaveState");
    ASSERT_EQ(ws[0], 1);
    ASSERT_EQ(count_named_prefix("pending_w2_"), 0);
    run("game_time"); run("spawn_director"); run("delayed_spawn"); /* 300 */
    ws = (const int32_t *)get(gs, "WaveState");
    ASSERT_EQ(ws[0], 2);
    ASSERT_EQ(ws[1], 300);  /* negative carry re-arms the 5 s cadence */
    ASSERT_EQ(ws[2], 13);   /* spawned_total: 6 + 7 warnings emitted */
    ASSERT_EQ(count_named_prefix("pending_w2_"), 7);

    /* Wave 2 creatures materialize at tick 375 (300 + 75). */
    for (int t = 301; t <= 374; t++) {
        run("game_time"); run("spawn_director"); run("delayed_spawn");
    }
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 6);
    run("game_time"); run("spawn_director"); run("delayed_spawn"); /* 375 */
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 13);
    teardown();
}

/* Wave origins chase the players (EnemySpawnSystem.cs:103-105,139): each
 * wave ADVANCE snapshots the possessed-hero centroid
 * (CameraFollowPointSystem.cs:45-65; port equivalence: all living heroes)
 * as CurrentWaveLocation, and every spawn position = entry offset +
 * origin. Wave 1 uses the baked default origin (float3.zero). The port
 * clamps the final position to ArenaBounds (port decision â€” Unity leaves
 * spawns unclamped and lets MoveSystem's bounds clamp pull walkers in). */
TEST(wave_origin_tracks_hero_centroid) {
    setup();
    clear_spawned();

    /* Living heroes at (2,1) and (4,3): centroid (3,2). */
    spawn_at("HeroFrog", 2, 1);
    spawn_at("HeroEagle", 4, 3);

    /* Drive to the wave-2 advance (tick 300) WITHOUT delayed_spawn so the
       pending warnings stay inspectable. */
    for (int t = 1; t <= 300; t++) { run("game_time"); run("spawn_director"); }

    struct Pend { char *tmpl; float x, y; int32_t ticks; };

    /* Wave 1 at the baked origin: entries (0,0) and (-3,1.75) verbatim. */
    const struct Pend *p0 = get(find_first_named("pending_w1_0"), "PendingSpawn");
    const struct Pend *p1 = get(find_first_named("pending_w1_1"), "PendingSpawn");
    ASSERT_NOT_NULL(p0);
    ASSERT_NOT_NULL(p1);
    ASSERT_EQ(p0->x, 0.0f);
    ASSERT_EQ(p0->y, 0.0f);
    ASSERT_EQ(p1->x, -3.0f);
    ASSERT_EQ(p1->y, 1.75f);

    /* Wave 2 offsets ride the snapshot: entry 0 (3,-4.25) -> (6,-2.25);
       entry 2 (5.25,4.75) -> (8.25, 6.75) with y clamped to the arena. */
    const struct Pend *q0 = get(find_first_named("pending_w2_0"), "PendingSpawn");
    const struct Pend *q2 = get(find_first_named("pending_w2_2"), "PendingSpawn");
    ASSERT_NOT_NULL(q0);
    ASSERT_NOT_NULL(q2);
    ASSERT(fabsf(q0->x - 6.0f) < 1e-4f);
    ASSERT(fabsf(q0->y - (-2.25f)) < 1e-4f);
    ASSERT(fabsf(q2->x - 8.25f) < 1e-4f);
    ASSERT(fabsf(q2->y - 6.5f) < 1e-4f); /* 2 + 4.75 = 6.75 -> clamp 6.5 */
    teardown();
}

/* End-to-end guard for the schedule fix: wave 36 begins at 175 s (tick
 * 10500 = 35 advances at 300-tick cadence) and its creatures materialize
 * at tick 10575 â€” on the field and fightable before the victory tick
 * (strict > 10800). Under the old +5 s schedule wave 36 landed ON the
 * victory tick and was never fought. */
TEST(final_wave_creatures_materialize_before_victory) {
    setup();
    clear_spawned(); /* no heroes: origins stay at the baked default */

    int creatures_before_final_wave = 0;
    for (int t = 1; t <= 10575; t++) {
        run("game_time"); run("spawn_director"); run("delayed_spawn");
        if (t == 10499)
            creatures_before_final_wave =
                count_named_prefix("Creature") +
                count_named_prefix("LargeTealCube_");
        if (t == 10500) {
            const int32_t *ws = (const int32_t *)
                get(ecs_lookup(engine->world, "GameState"), "WaveState");
            ASSERT_EQ(ws[0], 36);   /* final wave reached at 175 s */
            ASSERT_EQ(ws[2], 509);  /* every scripted warning emitted */
        }
    }
    int creatures = count_named_prefix("Creature") +
                    count_named_prefix("LargeTealCube_");
    ASSERT_EQ(creatures, 509);      /* all materialized by tick 10575 */
    ASSERT(creatures > creatures_before_final_wave); /* wave 36 fought */
    teardown();
}

/* Observability-contract guard (sandboxes/sashimi/CLAUDE.md "Hero-AI
 * observability contract"): pre-spawn state must be invisible to every AI
 * query. PendingSpawn request entities exist during the delay window but
 * must carry ONLY PendingSpawn â€” no Position/AISteering/Health/Collider/
 * Faction â€” so no AI query, unit snapshot, or spatial-hash pass can ever
 * see an enemy before it materializes on the field. */
TEST(pending_spawns_invisible_to_ai) {
    setup();
    clear_spawned();

    /* Trickle out all six wave-1 warnings (ticks 1..6), but do NOT run
       delayed_spawn: the 75-tick telegraph window is open. */
    for (int t = 0; t < 6; t++) run("spawn_director");

    int n_pending = 0;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *nm = list.items[i].name;
        if (!nm || strncmp(nm, "pending_w1_", 11) != 0) continue;
        n_pending++;
        ecs_entity_t e = list.items[i].id;
        ASSERT(has(e, "PendingSpawn"));
        /* Invisible to hero_ai's enemy query (AISteering+Position+Health),
           the unit snapshot (Health+Position+Faction) and the spatial hash
           (Position+Collider). */
        ASSERT(!has(e, "Position"));
        ASSERT(!has(e, "AISteering"));
        ASSERT(!has(e, "Health"));
        ASSERT(!has(e, "Collider"));
        ASSERT(!has(e, "Faction"));
    }
    engine_entity_list_free(&list);
    ASSERT_EQ(n_pending, 6);                       /* wave 1: 6 slimes */
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 0);

    /* Materialization is the observability boundary: the request entities
       stay bare through the whole telegraph window, then the creatures
       are on the field and only then AI-visible. */
    for (int t = 0; t < 75; t++) run("delayed_spawn");
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 0);
    run("delayed_spawn"); /* the tick-1 warning's 75-tick delay elapses */
    ASSERT_EQ(count_named_prefix("CreatureSlimeOrange_"), 6);
    ASSERT_EQ(count_named_prefix("pending_w1_"), 0);
    teardown();
}

/* --- kite AI ------------------------------------------------------------ */

TEST(kite_ai_keeps_range_and_survives) {
    setup_cfg("headless-verify");
    clear_spawned();
    engine_system_disable(engine, "spawn_director"); /* no waves */

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    /* A wolf (fast: 1.75 vs hero 2.0) â€” the hardest kite among slice
       creatures. */
    ecs_entity_t wolf = spawn_at("CreatureWolf", 2.5f, 0);

    float min_d = 1e9f;
    bool wolf_alive = true;
    int wolf_died_at = -1;
    bool dbg = getenv("SASHIMI_DEBUG") != NULL;
    for (int t = 0; t < 900 && !engine->game_over; t++) {
        tick();
        if (dbg && t % 60 == 0) {
            const float *hp3 = (const float *)get(hero, "Position");
            const float *wp3 = ecs_is_alive(engine->world, wolf)
                ? (const float *)get(wolf, "Position") : NULL;
            const float *whp = ecs_is_alive(engine->world, wolf)
                ? (const float *)get(wolf, "Health") : NULL;
            printf("\n    dbg t=%d hero(%.2f,%.2f) wolf(%.2f,%.2f) whp=%.1f projs=%d",
                   t, hp3 ? hp3[0] : 0, hp3 ? hp3[1] : 0,
                   wp3 ? wp3[0] : -99, wp3 ? wp3[1] : -99,
                   whp ? whp[0] : -1,
                   count_named_prefix("Shuriken_Projectile_"));
        }
        if (wolf_alive && !ecs_is_alive(engine->world, wolf)) {
            wolf_alive = false;
            wolf_died_at = t;
            break;
        }
        const float *hp2 = (const float *)get(hero, "Position");
        const float *wp = (const float *)get(wolf, "Position");
        if (hp2 && wp) {
            float dx = hp2[0] - wp[0], dy = hp2[1] - wp[1];
            float d = sqrtf(dx * dx + dy * dy);
            if (d < min_d) min_d = d;
        }
        /* AI must stay in bounds. */
        ASSERT(hp2[0] >= -9.5f && hp2[0] <= 9.5f);
        ASSERT(hp2[1] >= -6.5f && hp2[1] <= 6.5f);
    }
    const float *hh = (const float *)get(hero, "Health");
    printf("\n    [min hero-wolf distance %.2f, wolf died at tick %d, hero HP %.1f] ",
           min_d, wolf_died_at, hh ? hh[0] : -1.0f);
    /* Keep-range invariant: the wolf attacks at 0.6; the AI must keep it
       clear of melee range while the weapon (range 3) kills it. */
    ASSERT(!wolf_alive);
    ASSERT(min_d > 0.7f);
    ASSERT(hh && hh[0] >= 50.0f - 12.5f); /* at most one graze */
    teardown();
}

/* --- faction-filtered collision ----------------------------------------- */

TEST(faction_filter_gates_damage_and_pickups) {
    setup();
    clear_spawned();

    /* Blue projectile on top of a hero (Unit_Blue): no friendly fire. */
    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);
    ecs_entity_t proj = spawn_at("Shuriken_Projectile", 0, 0);
    struct { ecs_entity_t shooter; int32_t hits, pl, bl; float dl; } rt =
        { 0, 0, 0, 3, 3.0f };
    ecs_set_id(engine->world, proj, comp("ProjectileRuntime"), sizeof(rt), &rt);

    run("game_time");
    run("spatial_hash");
    run("damage_apply");
    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 50.0f); /* untouched: HarmEffect_Blue vs Unit_Blue */

    /* Same projectile overlapping a creature: damage applies. */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0, 0);
    run("spatial_hash");
    run("damage_apply");
    const float *sh = (const float *)get(slime, "Health");
    ASSERT_EQ(sh[0], 18.0f);

    /* Red creature attack cannot hurt creatures (Unit_Red). */
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0.05f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, wolf, "attack");
    ASSERT(attack != 0);
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.05f, 0);
    run("spatial_hash");
    run("damage_apply");
    sh = (const float *)get(slime, "Health");
    ASSERT_EQ(sh[0], 18.0f); /* HarmEffect_Red vs Unit_Red: no interaction */

    /* Pickups (HelpEffect_Blue) magnetize to heroes, never creatures. */
    ecs_entity_t gem = spawn_at("GemPickup", 5, 5);
    ecs_entity_t slime2 = spawn_at("CreatureSlimeOrange", 5.1f, 5);
    (void)slime2;
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(!has(gem, "PickupMagnet"));
    set_pos(hero, 5.2f, 5);
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(has(gem, "PickupMagnet"));
    teardown();
}

/* --- hit-pair reset rounding --------------------------------------------- */

/* Unity pair expiry: ExpirationTick = InterpTick + 1 + floor(reset * 60)
 * (CollisionDetectionSystem.cs:191-195 + GameTimeSystem_FixedStep.cs
 * Ticks()). reset 0.25 s -> re-hittable exactly 16 ticks later, not 15. */
TEST(pair_reset_rounds_one_plus_floor) {
    setup();
    clear_spawned();

    /* Hero victim: i-frames clear at T+12, so ticks T+13..T+15 isolate
       the pair gate (blocked through T+15, re-hittable at T+16). */
    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0); /* 50 HP */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0.1f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0.1f, 0);
    struct { float damage; int32_t hit_limit; ecs_bool_t ign; float reset; }
        *dm = get_mut(attack, "DamageOnHit");
    dm->ign = true;
    dm->reset = 0.25f;

    /* Tick T: first hit. */
    run("spatial_hash");
    run("damage_apply");
    run("iframes");
    const float *h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 37.5f); /* 50 - 12.5 */

    /* T+1..T+15: no re-hit (i-frames through T+12, then the pair window:
       1 + floor(0.25 * 60) = 16 ticks). */
    for (int k = 1; k <= 15; k++) {
        run("game_time");
        run("spatial_hash");
        run("damage_apply");
        run("iframes");
        h = (const float *)get(hero, "Health");
        ASSERT_EQ(h[0], 37.5f);
    }
    /* T+16: re-hit. */
    run("game_time");
    run("spatial_hash");
    run("damage_apply");
    h = (const float *)get(hero, "Health");
    ASSERT_EQ(h[0], 25.0f);
    teardown();
}

/* --- respawn / out-of-game ----------------------------------------------- */

/* Unity respawn contract: DefeatSystem queues RespawnGameTick = death +
 * 10 s (hardcoded UnitRespawnTime, DefeatSystem.cs:14,92) and RespawnSystem
 * revives strictly AFTER it (RespawnSystem.cs:55) â€” tick death+601 â€” at
 * HALF max health (:61), then grants 2.0 s of OutOfGameTimer (:17,62-66):
 * fully off-field (out of the spatial hash and unit snapshot, untargetable,
 * no damage, no movement) and unable to fire (the OOG weapon's EnemyTarget
 * is force-cleared, EnemyTargetingSystem.cs:118-124). Weapon cooldowns are
 * absolute ticks, so they elapse during the window and the hero fires the
 * first in-game tick. */
TEST(respawn_ten_seconds_half_hp_two_seconds_out_of_game) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0, 0);   /* 50 HP */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 2.0f, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, slime, "attack");
    ASSERT(attack != 0);

    /* Probe hitbox: forced live on top of the hero, re-hitting every tick
       the broadphase allows (child_offset_sync gives the child a Position
       first, as in the damage tests). */
    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0, 0);
    struct { float damage; int32_t hit_limit; ecs_bool_t ign; float reset; }
        *dm = get_mut(attack, "DamageOnHit");
    dm->ign = true;
    dm->reset = 0.0f;

    /* Death tick T. */
    float *h = (float *)get_mut(hero, "Health");
    h[0] = 0;
    run("game_time"); run("defeat"); run("on_defeated"); run("respawn");
    ASSERT(has(hero, "Defeated"));
    ASSERT(has(hero, "RespawnTimer"));

    /* T+1 .. T+600: still down (10 s wait). */
    for (int k = 1; k <= 600; k++) {
        run("game_time"); run("on_defeated"); run("respawn");
    }
    ASSERT(has(hero, "Defeated"));

    /* T+601: revived in place at HALF max health, fully out of game. */
    run("game_time"); run("on_defeated"); run("respawn");
    ASSERT(!has(hero, "Defeated"));
    ASSERT(!has(hero, "RespawnTimer"));
    const float *hh = (const float *)get(hero, "Health");
    ASSERT_EQ(hh[0], 25.0f);            /* max 50 / 2 (RespawnSystem.cs:61) */
    ASSERT(has(hero, "OutOfGame"));
    ASSERT(!has(hero, "IFramesTimer")); /* OOG replaced the old approximation */

    /* OOG window (ticks R+1..R+120): untargetable, unhittable, immobile,
       weapon silent; everything resumes at R+121. */
    int fired_at = -1, hit_at = -1;
    for (int k = 1; k <= 121; k++) {
        run("game_time");
        run("weapon_fire");
        run("spatial_hash");
        run("targeting");
        run("movement");
        run("damage_apply");
        run("iframes");
        if (fired_at < 0 && count_named_prefix("Shuriken_Projectile_") > 0)
            fired_at = k;
        const float *cur = (const float *)get(hero, "Health");
        if (hit_at < 0 && cur[0] < 25.0f) hit_at = k;
        if (k == 60) {
            /* Mid-window probes: creature blind to the hero; press right
               from here on â€” OOG must keep ignoring the input. */
            ASSERT(!has(slime, "EnemyTarget"));
            float *dir = (float *)get_mut(hero, "InputDirection");
            dir[0] = 1.0f; dir[1] = 0.0f;
            ASSERT(has(hero, "OutOfGame"));
        }
        if (k == 120) {
            /* Movement ran 60 ticks with input held: still pinned. */
            const float *hp = (const float *)get(hero, "Position");
            ASSERT_EQ(hp[0], 0.0f);
        }
    }
    printf("\n    [weapon fired at R+%d, first hit at R+%d] ", fired_at, hit_at);
    ASSERT(!has(hero, "OutOfGame"));
    ASSERT_EQ(fired_at, 121);            /* cooldown elapsed during OOG */
    ASSERT_EQ(hit_at, 121);              /* back in the broadphase */
    const float *hp = (const float *)get(hero, "Position");
    ASSERT(hp[0] > 0.0f);                /* input integrates again */
    teardown();
}

/* --- creature steering: no-target convergence + anti-encroachment ------- */

/* Unity creatures with no EnemyTarget steer toward the camera follow
 * point = the hero centroid (CreatureMoveDirectionSystem.cs:112) under
 * the same follow rules (start/stop distances, MinDistanceToMove gate,
 * per-tick step clamp toward the stop ring) â€” the whole arena presses
 * toward the players. With no living hero the centroid keeps its last
 * value (baked default (0,0) here). Slime: speed 0.65 (step 0.010833),
 * start_follow 0.225, stop_follow 0.175, gate 0.1 * step. */
TEST(no_target_creatures_converge_on_hero_centroid) {
    setup();
    clear_spawned(); /* no heroes: centroid stays at the baked (0,0) */

    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 8.0f, 0);
    for (int t = 0; t < 800; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    const float *p = (const float *)get(slime, "Position");
    float d = sqrtf(p[0] * p[0] + p[1] * p[1]);
    printf("\n    [no-target slime from x=8 rests at d=%.4f] ", d);
    /* Converged all the way across the arena and stopped at the stop
       ring: last full step lands within one step inside it, or the gate
       stops it just outside. */
    ASSERT(d > 0.175f - 0.012f && d < 0.175f + 0.002f);

    /* Stable: sub-threshold waypoint = no motion at all. */
    float x0 = p[0], y0 = p[1];
    for (int t = 0; t < 10; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    p = (const float *)get(slime, "Position");
    ASSERT_EQ(p[0], x0);
    ASSERT_EQ(p[1], y0);
    const float *v = (const float *)get(slime, "Velocity");
    ASSERT_EQ(v[0], 0.0f);
    ASSERT_EQ(v[1], 0.0f);

    /* A no-target creature already inside the centroid's stop ring never
       moves (standstill branch needs d > StartFollowDistance). Delete the
       converged slime first so ally anti-encroachment cannot interfere. */
    ecs_delete(engine->world, slime);
    ecs_entity_t near_slime = spawn_at("CreatureSlimeOrange", 0.15f, 0);
    for (int t = 0; t < 10; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    p = (const float *)get(near_slime, "Position");
    ASSERT_EQ(p[0], 0.15f);
    ASSERT_EQ(p[1], 0.0f);
    teardown();
}

/* Unity has NO unit-unit positional pushback: crowd separation is
 * ally-only anti-encroachment steering inside CreatureMoveDirection
 * (:98-101,142,157-200) â€” normalize(sum(normalize(away))) * speed/tick
 * folded into the waypoint. It competes with follow, never teleports,
 * never displaces heroes (WithNone<HeroId>), and never moves attacking
 * (locomotion-disabled) creatures. collision_push (slot 15) is a retired
 * no-op. */
TEST(ally_anti_encroachment_separates_without_pushback) {
    setup();
    clear_spawned(); /* centroid at (0,0) */

    /* Two overlapping same-color slimes (circle r=0.2 each): the one at
       the centroid separates in full per-tick steps; the follower's
       follow and away offsets cancel (both == one step) so it holds. */
    ecs_entity_t a = spawn_at("CreatureSlimeOrange", 0, 0);
    ecs_entity_t b = spawn_at("CreatureSlimeOrange", 0.3f, 0);
    const float step = 0.65f / 60.0f;
    float prev_ax = 0.0f;
    for (int t = 0; t < 15; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
        const float *pa = (const float *)get(a, "Position");
        /* no teleporting: at most one movement step per tick */
        ASSERT(fabsf(pa[0] - prev_ax) <= step + 1e-4f);
        prev_ax = pa[0];
    }
    const float *pa = (const float *)get(a, "Position");
    const float *pb = (const float *)get(b, "Position");
    float ddx = pa[0] - pb[0], ddy = pa[1] - pb[1];
    float dist = sqrtf(ddx * ddx + ddy * ddy);
    printf("\n    [pair separated to %.3f] ", dist);
    ASSERT(dist >= 0.38f); /* out of overlap (r+r = 0.4) */
    ecs_delete(engine->world, a);
    ecs_delete(engine->world, b);

    /* An attacking (locomotion-disabled) creature never separates. */
    ecs_entity_t c = spawn_at("CreatureSlimeOrange", 5.0f, 5.0f);
    ecs_entity_t d = spawn_at("CreatureSlimeOrange", 5.3f, 5.0f);
    ecs_add_id(engine->world, d, comp("LocomotionDisabled"));
    for (int t = 0; t < 20; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    const float *pd = (const float *)get(d, "Position");
    ASSERT_EQ(pd[0], 5.3f);
    ASSERT_EQ(pd[1], 5.0f);
    (void)c;
    ecs_delete(engine->world, c);
    ecs_delete(engine->world, d);

    /* Heroes are never displaced: a creature overlapping a hero neither
       pushes it nor gets pushed (the hero is not an ally; nothing else
       moves units). */
    ecs_entity_t hero = spawn_at("HeroFrog", -5.0f, -5.0f);
    ecs_entity_t s = spawn_at("CreatureSlimeOrange", -4.85f, -5.0f);
    for (int t = 0; t < 20; t++) {
        run("game_time"); run("spatial_hash"); run("targeting");
        run("creature_steering"); run("movement");
    }
    const float *ph = (const float *)get(hero, "Position");
    const float *ps = (const float *)get(s, "Position");
    ASSERT_EQ(ph[0], -5.0f);
    ASSERT_EQ(ph[1], -5.0f);
    ASSERT_EQ(ps[0], -4.85f);
    ASSERT_EQ(ps[1], -5.0f);
    teardown();
}

/* --- co-op hero tether (ClampHeroToScreen) ------------------------------- */

/* MoveSystem.cs:205-228: every hero clamps each tick to a rect around the
 * camera follow point (the pre-move hero centroid): x within +-5.5, y
 * within [-2.5, +3]. Solo this is inert; in co-op it tethers the pair. */
TEST(coop_hero_tether_clamps_to_camera_rect) {
    setup();
    clear_spawned();

    ecs_entity_t h1 = spawn_at("HeroFrog", -8.0f, 0);
    ecs_entity_t h2 = spawn_at("HeroEagle", 8.0f, 0);
    run("game_time");  /* centroid (0,0) */
    run("movement");
    const float *p1 = (const float *)get(h1, "Position");
    const float *p2 = (const float *)get(h2, "Position");
    ASSERT_EQ(p1[0], -5.5f);
    ASSERT_EQ(p2[0], 5.5f);

    /* Asymmetric y rect: [-2.5, +3]. */
    set_pos(h1, 0, 4.0f);
    set_pos(h2, 0, -4.0f);
    run("game_time");  /* centroid (0,0) */
    run("movement");
    p1 = (const float *)get(h1, "Position");
    p2 = (const float *)get(h2, "Position");
    ASSERT_EQ(p1[1], 3.0f);
    ASSERT_EQ(p2[1], -2.5f);

    /* Solo: the centroid is the hero itself â€” inert even at the arena
       edge. */
    ecs_delete(engine->world, h2);
    set_pos(h1, 9.4f, 6.4f);
    run("game_time");
    run("movement");
    p1 = (const float *)get(h1, "Position");
    ASSERT_EQ(p1[0], 9.4f);
    ASSERT_EQ(p1[1], 6.4f);
    teardown();
}

/* --- charge dash: fuel-based, slow-immune -------------------------------- */

/* The LargeCubeCharge dash is an impulse: ImpulseDistance 3 serialized on
 * the ability prefab, Speed = Fuel / ActiveDuration = 3 / 0.4 = 7.5 u/s
 * computed at active start (AbilityConfigAuthoring.cs:94-98,
 * AbilitySystem.cs:936-947). Impulses integrate in MoveSystem separately
 * from locomotion and never read MoveSpeedStat â€” a slow does not affect
 * a dash (MoveSystem.cs:135-168). */
static float drive_cube_dash(bool slowed, int *dash_ticks) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 1.5f, 0); /* charge range 2 */
    (void)hero;
    ecs_entity_t cube = spawn_at("LargeTealCube", 0, 0);
    if (slowed) {
        struct { int32_t ticks; float mag; } slow = { 100000, -0.75f };
        ecs_set_id(engine->world, cube, comp("StatusSlow"),
                   sizeof(slow), &slow);
    }

    /* Charge starts on cooldown (2 s): READY at k=121, selected 122,
       windup 123 (19 ticks), ACTIVE + dash from k=142; fuel 3.0 at
       7.5 u/s = 24 ticks of 0.125. The attack ability (max_range 0.4)
       never readies at distance 1.5. */
    float x_at_dash_start = -1.0f;
    int first_move = -1, last_move = -1;
    float prev_x = 0.0f;
    for (int k = 1; k <= 200; k++) {
        run("game_time"); run("ability_machine");
        run("spatial_hash"); run("targeting"); run("movement");
        const float *p = (const float *)get(cube, "Position");
        if (p[0] != prev_x) {
            if (first_move < 0) { first_move = k; x_at_dash_start = prev_x; }
            last_move = k;
        }
        prev_x = p[0];
    }
    if (dash_ticks)
        *dash_ticks = (first_move > 0) ? last_move - first_move + 1 : 0;
    float covered = prev_x - x_at_dash_start;
    teardown();
    return covered;
}

TEST(charge_dash_covers_three_units_and_ignores_slow) {
    int ticks_free = 0, ticks_slow = 0;
    float d_free = drive_cube_dash(false, &ticks_free);
    printf("\n    [dash covered %.4f units in %d ticks] ", d_free, ticks_free);
    ASSERT(fabsf(d_free - 3.0f) < 1e-3f);   /* ImpulseDistance 3.0 */
    ASSERT_EQ(ticks_free, 24);              /* 0.4 s at 7.5 u/s */

    /* A shuriken-slowed cube dashes at full speed (impulses never read
       MoveSpeedStat). */
    float d_slow = drive_cube_dash(true, &ticks_slow);
    ASSERT(fabsf(d_slow - 3.0f) < 1e-3f);
    ASSERT_EQ(ticks_slow, 24);
}

/* --- child offset sync: x-flip only + windup aim freeze ------------------ */

/* Unity does NOT rotate child offsets: GameplayParentOffset.Rotate is an
 * x-mirror (offset.x = -offset.x when the direction to the target has
 * x < 0; GameplayParentAuthoring.cs:20-29), measured from the CHILD's
 * world position (GameplayChildOffsetSyncSystem.cs:66-70); and the whole
 * sync SKIPS the aim update while the parent's locomotion is disabled
 * (:57-61) â€” melee aim locks at windup start while the frozen local
 * offset still rides the parent. */
TEST(child_offset_x_flip_only_and_freeze_while_attacking) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", -1.0f, 0.5f);
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, wolf, "attack");
    ASSERT(attack != 0);
    struct { ecs_entity_t target; } et = { hero };
    ecs_set_id(engine->world, wolf, comp("EnemyTarget"), sizeof(et), &et);

    /* Target up-left: the offset flips on x ONLY (no rotation off the
       x-axis despite the diagonal target). Wolf offset x=0.25. */
    run("child_offset_sync");
    const float *cp = (const float *)get(attack, "Position");
    ASSERT_EQ(cp[0], -0.25f);
    ASSERT_EQ(cp[1], 0.0f);

    /* Target to the right: raw offset. */
    set_pos(hero, 1.0f, -0.7f);
    run("child_offset_sync");
    cp = (const float *)get(attack, "Position");
    ASSERT_EQ(cp[0], 0.25f);
    ASSERT_EQ(cp[1], 0.0f);

    /* Locomotion disabled (windup/active): the aim freezes â€” the target
       strafing to the other side must not re-flip the hitbox â€” but the
       frozen offset still rides the parent. */
    ecs_add_id(engine->world, wolf, comp("LocomotionDisabled"));
    set_pos(hero, -1.0f, 0);
    run("child_offset_sync");
    cp = (const float *)get(attack, "Position");
    ASSERT_EQ(cp[0], 0.25f);
    ASSERT_EQ(cp[1], 0.0f);
    set_pos(wolf, 5.0f, 5.0f);
    run("child_offset_sync");
    cp = (const float *)get(attack, "Position");
    ASSERT_EQ(cp[0], 5.25f);
    ASSERT_EQ(cp[1], 5.0f);

    /* Unlocked: aim resumes from the child's world position. */
    ecs_remove_id(engine->world, wolf, comp("LocomotionDisabled"));
    run("child_offset_sync");
    cp = (const float *)get(attack, "Position");
    ASSERT_EQ(cp[0], 4.75f);
    ASSERT_EQ(cp[1], 5.0f);
    teardown();
}

/* --- ability machine: exclusivity, hit caps, trigger target, tick math --- */

/* One active ability per caster, selection through recovery end
 * (AbilitySystem.cs:626-750). Ties go to the LAST ready element of the
 * caster's buffer â€” the reversed LinkedEntityGroup â€” i.e. the FIRST
 * ability child in prefab-hierarchy (template child) order: for
 * LargeTealCube that is attack over charge. */
TEST(one_active_ability_per_caster_attack_wins_ties) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0.3f, 0); /* in attack range */
    (void)hero;
    ecs_entity_t cube = spawn_at("LargeTealCube", 0, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, cube, "attack");
    ecs_entity_t charge = ecs_lookup_child(engine->world, cube, "charge");
    ASSERT(attack && charge);

    int attack_actives = 0, prev_attack_stage = 0;
    for (int k = 1; k <= 400; k++) {
        run("game_time"); run("ability_machine");
        run("spatial_hash"); run("targeting");
        const int32_t *ast = (const int32_t *)get(attack, "AbilityState");
        const int32_t *cst = (const int32_t *)get(charge, "AbilityState");
        /* The charge may ready up (cooldown 2 s expires at k~121) but must
           never run: the attack (first child, always ready at 0.3) owns
           the caster's slot every time it frees up. */
        ASSERT(cst[0] == 0 /* READY */ || cst[0] == 4 /* COOLDOWN */);
        if (ast[0] == 2 && prev_attack_stage != 2) attack_actives++;
        prev_attack_stage = ast[0];
        /* Exclusivity invariant: while the attack runs (selected through
           recovery), the caster carries exactly it in ActiveAbility. */
        if (ast[0] == 1 || ast[0] == 2 || ast[0] == 3 || ast[0] == 5) {
            const ecs_entity_t *aa = (const ecs_entity_t *)
                get(cube, "ActiveAbility");
            ASSERT_NOT_NULL(aa);
            ASSERT(aa[0] == attack);
        }
    }
    printf("\n    [attack activations in 400 ticks: %d] ", attack_actives);
    ASSERT(attack_actives >= 3); /* cycling: exclusivity never deadlocks */
    teardown();
}

/* All four ability hitbox prefabs serialize OnHitDamageTrigger.
 * IgnoreHitLimit = 1: unlimited victims per activation (the generated
 * hit_limit: 1 is a legacy field); per-victim re-hits stay gated by the
 * pair registry. Two-hero melee: the cube attack hits BOTH heroes in one
 * activation. */
TEST(ability_hitbox_hits_all_victims_in_one_activation) {
    setup();
    clear_spawned();

    ecs_entity_t h1 = spawn_at("HeroFrog", 0.1f, 0);   /* 50 HP each */
    ecs_entity_t h2 = spawn_at("HeroEagle", -0.1f, 0);
    ecs_entity_t cube = spawn_at("LargeTealCube", 0, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, cube, "attack");
    ASSERT(attack != 0);

    run("game_time");
    run("spatial_hash");
    run("child_offset_sync");
    struct { int32_t shape; float r, w, h; ecs_bool_t on; } *col =
        get_mut(attack, "Collider");
    col->on = true;
    set_pos(attack, 0, 0);
    run("spatial_hash");
    run("damage_apply");

    const float *hp1 = (const float *)get(h1, "Health");
    const float *hp2 = (const float *)get(h2, "Health");
    ASSERT_EQ(hp1[0], 37.5f); /* 50 - 12.5 */
    ASSERT_EQ(hp2[0], 37.5f); /* hit_limit 1 would have spared this one */
    teardown();
}

/* Unity readies an ability on the distance to the caster's CURRENT
 * EnemyTarget.RecentPosition (AbilitySystem.cs:510-519) â€” never the
 * nearest enemy: a creature whose kept target is out of range does NOT
 * attack a nearer non-target. */
TEST(ability_triggers_on_kept_target_not_nearest) {
    setup();
    clear_spawned();

    ecs_entity_t far_hero = spawn_at("HeroFrog", 2.0f, 0);  /* > 0.6 range */
    ecs_entity_t near_hero = spawn_at("HeroEagle", 0.3f, 0);/* in range */
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, wolf, "attack");
    ASSERT(attack != 0);

    /* Kept target: the far hero. The nearer non-target must not trigger. */
    struct { ecs_entity_t target; } et = { far_hero };
    ecs_set_id(engine->world, wolf, comp("EnemyTarget"), sizeof(et), &et);
    for (int k = 0; k < 5; k++) run("ability_machine");
    const int32_t *ast = (const int32_t *)get(attack, "AbilityState");
    ASSERT_EQ(ast[0], 0); /* still READY: no windup */
    ASSERT(!has(wolf, "LocomotionDisabled"));

    /* Switch the kept target to the near hero: attack starts (selection
       tick + windup the next). */
    struct { ecs_entity_t target; } et2 = { near_hero };
    ecs_set_id(engine->world, wolf, comp("EnemyTarget"), sizeof(et2), &et2);
    run("ability_machine");
    ast = (const int32_t *)get(attack, "AbilityState");
    ASSERT_EQ(ast[0], 5); /* SELECTED */
    run("ability_machine");
    ast = (const int32_t *)get(attack, "AbilityState");
    ASSERT_EQ(ast[0], 1); /* WINDUP */
    ASSERT(has(wolf, "LocomotionDisabled"));
    teardown();
}

/* Unity stage/cooldown durations run Ticks(d) = 1 + floor(d * 60) ticks
 * (GameTimeSystem_FixedStep.cs:78-84) and the ready->windup handoff takes
 * exactly one tick of caster selection (job ordering; deterministic).
 * WolfAttack (0.25 / 0.25 / 0.5): selection k=1, windup k=2 for 16 ticks,
 * active k=18 for 16, recovery k=34 for 31, ready k=65, windup again
 * k=67. */
TEST(ability_stage_ticks_one_plus_floor) {
    setup();
    clear_spawned();

    ecs_entity_t hero = spawn_at("HeroFrog", 0.3f, 0);
    ecs_entity_t wolf = spawn_at("CreatureWolf", 0, 0);
    ecs_entity_t attack = ecs_lookup_child(engine->world, wolf, "attack");
    ASSERT(attack != 0);
    struct { ecs_entity_t target; } et = { hero };
    ecs_set_id(engine->world, wolf, comp("EnemyTarget"), sizeof(et), &et);

    int first_windup = -1, first_active = -1, first_recovery = -1;
    int ready_again = -1, second_windup = -1;
    int prev = -1;
    for (int k = 1; k <= 80; k++) {
        run("ability_machine");
        const int32_t *ast = (const int32_t *)get(attack, "AbilityState");
        int stage = ast[0];
        if (stage != prev) {
            if (stage == 1 && first_windup < 0) first_windup = k;
            else if (stage == 2 && first_active < 0) first_active = k;
            else if (stage == 3 && first_recovery < 0) first_recovery = k;
            else if (stage == 0 && prev == 3 && ready_again < 0)
                ready_again = k;
            else if (stage == 1 && first_windup > 0 && second_windup < 0)
                second_windup = k;
            prev = stage;
        }
    }
    printf("\n    [windup %d active %d recovery %d ready %d windup2 %d] ",
           first_windup, first_active, first_recovery, ready_again,
           second_windup);
    ASSERT_EQ(first_windup, 2);    /* selected k=1, windup k=2 */
    ASSERT_EQ(first_active, 18);   /* windup 1+floor(0.25*60) = 16 ticks */
    ASSERT_EQ(first_recovery, 34); /* active 16 ticks */
    ASSERT_EQ(ready_again, 65);    /* recovery 1+floor(0.5*60) = 31 ticks */
    ASSERT_EQ(second_windup, 67);  /* re-selection k=66, windup k=67 */
    teardown();
}

/* --- targeting tie-break -------------------------------------------------- */

/* Unity's candidate loop applies the 0.15 switch threshold to EVERY
 * sequential comparison (EnemyTargetingSystem.cs:161-190): with no
 * current target the FIRST in-range hero in iteration order wins unless a
 * later one is closer by >= 0.15. Iteration order here is the unit
 * snapshot (creation order) â€” deterministic, unlike Unity's hash order
 * (documented divergence bounded to 0.15 u). */
TEST(targeting_first_in_order_wins_within_threshold) {
    setup();
    clear_spawned();

    /* Snapshot iteration order is table creation order: the app-start
       spawn_list creates the HeroEagle table before HeroFrog's, so the
       eagle enumerates first regardless of spawn order here. */
    ecs_entity_t first = spawn_at("HeroEagle", 3.0f, 0);  /* first in order */
    ecs_entity_t second = spawn_at("HeroFrog", 0, 2.9f);  /* 0.1 closer */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 0, 0);

    run("game_time");
    run("spatial_hash");
    run("targeting");
    const ecs_entity_t *et = (const ecs_entity_t *)get(slime, "EnemyTarget");
    ASSERT_NOT_NULL(et);
    ASSERT(et[0] == first); /* 2.9 + 0.15 > 3.0: not enough to beat it */

    /* Closer by >= 0.15: the switch happens. */
    set_pos(second, 0, 2.7f);
    run("spatial_hash");
    run("targeting");
    et = (const ecs_entity_t *)get(slime, "EnemyTarget");
    ASSERT(et[0] == second);
    teardown();
}

/* --- pickup magnet: overlap claim, uncapped ramp, corpse completion ------ */

/* Claim happens when the pickup's trigger collider SHAPE overlaps the
 * hero's collider (CollisionResponseSystem.cs:207-217; gem trigger r=0.75
 * vs hero rect 0.4x0.25), the speed ramp accel * elapsed/rate is UNCAPPED
 * (PickupSystem.cs:136; MoveSpeed 5 is dead data) with the step clamped
 * to land on the claimant (:137), and a dead claimant still receives the
 * pickup: gems count, hearts heal the corpse (:122-163). */
TEST(pickup_magnet_overlap_claim_uncapped_corpse_completion) {
    setup();
    clear_spawned();

    /* No claim without shape overlap (hero rect edge at 1.0 - 0.2 = 0.8
       outside the gem's r=0.75 trigger). */
    ecs_entity_t hero = spawn_at("HeroFrog", 1.0f, 0);
    ecs_entity_t gem = spawn_at("GemPickup", 0, 0);
    run("game_time");
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(!has(gem, "PickupMagnet"));

    /* Claim at shape-overlap distance: edge at 0.9 - 0.2 = 0.7 inside the
       trigger â€” the old center-in-radius rule (0.9 > 0.75) would miss
       it. */
    set_pos(hero, 0.9f, 0);
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(has(gem, "PickupMagnet"));

    /* Uncapped ramp: speed = 40 * ticks/60 exceeds the dead cap 5 after
       0.125 s (8 ticks -> 5.33). */
    struct Mag { ecs_entity_t hero; float speed; };
    for (int t = 0; t < 8; t++) { run("spatial_hash"); run("pickup_magnet"); }
    const struct Mag *m = (const struct Mag *)get(gem, "PickupMagnet");
    ASSERT_NOT_NULL(m);
    printf("\n    [magnet speed after 8 ticks: %.2f u/s] ", m->speed);
    ASSERT(m->speed > 5.0f);
    ASSERT(fabsf(m->speed - 40.0f * 8.0f / 60.0f) < 1e-3f);
    ecs_delete(engine->world, gem);

    /* Corpse completion: a heart claimed by a hero who then dies keeps
       flying and heals the corpse (min(max, cur + max * 0.25)). */
    set_pos(hero, 2.5f, 0);
    ecs_entity_t heart = spawn_at("HeartPickup", 3.0f, 0); /* r=0.5 trigger */
    run("spatial_hash");
    run("pickup_magnet");
    ASSERT(has(heart, "PickupMagnet"));
    float *hh = (float *)get_mut(hero, "Health");
    hh[0] = -10.0f;
    ecs_add_id(engine->world, hero, comp("Defeated"));
    for (int t = 0; t < 40 && ecs_is_alive(engine->world, heart); t++) {
        run("game_time"); run("spatial_hash"); run("pickup_magnet");
        run("movement"); run("pickup_collect");
        if (ecs_is_alive(engine->world, heart))
            ASSERT(has(heart, "PickupMagnet")); /* claim survives death */
    }
    ASSERT(!ecs_is_alive(engine->world, heart)); /* collected on the corpse */
    const float *cur = (const float *)get(hero, "Health");
    ASSERT_EQ(cur[0], 2.5f); /* -10 + 50 * 0.25 */
    ASSERT(has(hero, "Defeated")); /* healing a corpse does not revive it */
    teardown();
}

/* --- Eagle FeatherRecall ------------------------------------------------- */
/* Traced mechanic (HeroEagleProjectileRecallAbilitySystem.cs; NOT a
 * boomerang): spent feathers rest on the ground as FeatherRecall_Spawner
 * entities stamped with the owner and a monotonic SpentProjectileId
 * (ProjectileLifecycleSystem.cs:257-271). The eagle standing still for
 * ActivationTime 0.1 s (HeroEagle.prefab:301) activates recall â€” or
 * feathers >= ProjectileRecallLimitStat (= level, HeroEagle_LUHSSO Stat 3)
 * force-recalls even while moving (:88-93). One feather per tick, newest
 * first (:115-135): the spawner is armed (SpawnOneShotProjectileTag) and
 * fires next tick (ProjectileSpawnRequestSystem.cs:147-210) a homing
 * FeatherRecall_Projectile at the eagle with Fuel = distance at fire time
 * (:186). The +50% speed applies to the EAGLE'S MoveSpeed at recall-fire
 * time â€” not on projectile arrival â€” when the recall was stationary-
 * activated and feathers-on-ground >= SpeedBuffThreshold 2
 * (HeroEagleProjectileRecallAbilitySystem.cs:143-152, HeroEagle.prefab:
 * 303): the spawner's buff (MovementSpeed MultiplyBuffStrongest 0.5,
 * duration 1.1 s, StackLimit 8 â€” FeatherRecall_Spawner.prefab:177-194)
 * stacks by duration only. The projectile damages creatures en route
 * (Feather_Projectile variant, IgnoreHitLimit 1) and simply despawns at
 * the eagle (SpentProjectilePrefab null): "collecting" is the despawn. */

struct TSid { ecs_entity_t owner; int32_t id; };
struct THaste { int32_t stacks, duration_ticks; };

static void possess(ecs_entity_t hero, int slot) {
    int32_t s = slot;
    ecs_set_id(engine->world, hero, comp("PossessedBy"), sizeof(s), &s);
}
static void set_input(ecs_entity_t hero, float x, float y) {
    float *in = (float *)get_mut(hero, "InputDirection");
    if (in) { in[0] = x; in[1] = y; }
}
static void set_level(ecs_entity_t hero, int level) {
    int32_t *xp = (int32_t *)get_mut(hero, "Experience");
    xp[1] = level; /* level is the 2nd i32 slot */
}
static ecs_entity_t spawn_feather_spawner(ecs_entity_t owner, int id,
                                          float x, float y) {
    ecs_entity_t sp = spawn_at("FeatherRecall_Spawner", x, y);
    struct TSid sid = { owner, id };
    ecs_set_id(engine->world, sp, comp("SpentProjectileId"),
               sizeof(sid), &sid);
    return sp;
}

/* Full loop, eagle-driven: feathers fired and spent, stationary recall,
 * homing recall projectile, haste on recall-fire, collection = despawn,
 * buff expiry. */
TEST(feather_recall_full_loop_with_haste) {
    setup();
    clear_spawned();

    /* Full ticks drive the spawn director; park the wave script so wave-1
       slimes (origin (0,0)) cannot maul the stationary eagle mid-test. */
    {
        int32_t *ws = (int32_t *)get_mut(ecs_lookup(engine->world,
                                                    "GameState"), "WaveState");
        ws[0] = 0; /* next_wave < 1: director idles */
    }

    ecs_entity_t eagle = spawn_at("HeroEagle", 0, 0);
    possess(eagle, 1);          /* hero_ai yields; the test scripts input */
    set_level(eagle, 3);        /* recall limit 3: 2 feathers can rest */

    /* A tanky, frozen golem inside feather range keeps the weapon firing
       but can never close to melee (attack max range < 2.5). */
    ecs_entity_t golem = spawn_at("CreatureRockGolem", 2.5f, 0);
    float *gh = (float *)get_mut(golem, "Health");
    gh[0] = gh[1] = 10000.0f;
    ecs_add_id(engine->world, golem, comp("LocomotionDisabled"));

    /* Oscillate input (never stationary) until two feathers lie spent. */
    int t = 0;
    while (count_named_prefix("FeatherRecall_Spawner_") < 2 && t < 400) {
        set_input(eagle, (t & 1) ? 1.0f : -1.0f, 0);
        tick();
        t++;
    }
    ASSERT_EQ(count_named_prefix("FeatherRecall_Spawner_"), 2);
    ASSERT(!has(eagle, "StatusSlow")); /* moving: recall never activated */

    /* Spawners carry the owner and increasing spent ids. */
    {
        EntityList list = engine_entity_list(engine);
        int seen = 0, last_id = 0;
        for (int i = 0; i < list.count; i++) {
            const char *n = list.items[i].name;
            if (!n || strncmp(n, "FeatherRecall_Spawner_", 22) != 0) continue;
            const struct TSid *sid = (const struct TSid *)
                get(list.items[i].id, "SpentProjectileId");
            ASSERT_NOT_NULL(sid);
            ASSERT(sid->owner == eagle);
            ASSERT(sid->id > last_id);
            last_id = sid->id;
            seen++;
        }
        engine_entity_list_free(&list);
        ASSERT_EQ(seen, 2);
    }

    /* Stop the weapon and clear any feather still in flight so exactly
       two spent feathers take part in the recall. */
    ecs_delete(engine->world, golem);
    {
        EntityList list = engine_entity_list(engine);
        for (int i = 0; i < list.count; i++)
            if (list.items[i].name &&
                strncmp(list.items[i].name, "Feather_Projectile_", 19) == 0)
                ecs_delete(engine->world, list.items[i].id);
        engine_entity_list_free(&list);
    }

    /* Stand still: activation after Ticks(0.1 s) = 7 stationary ticks,
       newest feather armed, projectile fired the tick after. */
    set_input(eagle, 0, 0);
    ecs_entity_t proj = 0;
    for (t = 0; t < 12 && !proj; t++) {
        tick();
        proj = find_first_named("FeatherRecall_Projectile_");
    }
    ASSERT(proj != 0);

    /* Homing at the eagle. */
    const ecs_entity_t *ht = (const ecs_entity_t *)get(proj, "HomingTarget");
    ASSERT_NOT_NULL(ht);
    ASSERT(ht[0] == eagle);

    /* Haste applied at recall-fire time (2 feathers >= threshold 2,
       stationary-activated): +50%, Ticks(1.1 s) = 67, one stack. */
    const float *slow = (const float *)get(eagle, "StatusSlow");
    ASSERT_NOT_NULL(slow);
    ASSERT_EQ(slow[1], 0.5f);
    const struct THaste *hs = (const struct THaste *)get(eagle, "RecallHaste");
    ASSERT_NOT_NULL(hs);
    ASSERT_EQ(hs->stacks, 1);
    ASSERT_EQ(hs->duration_ticks, 67);

    /* Collection: both recall projectiles despawn at the eagle; no spawner
       remains; the eagle takes no damage from its own feathers. */
    for (t = 0; t < 40 &&
         (count_named_prefix("FeatherRecall_Projectile_") > 0 ||
          count_named_prefix("FeatherRecall_Spawner_") > 0); t++)
        tick();
    ASSERT_EQ(count_named_prefix("FeatherRecall_Projectile_"), 0);
    ASSERT_EQ(count_named_prefix("FeatherRecall_Spawner_"), 0);
    const float *eh = (const float *)get(eagle, "Health");
    ASSERT_EQ(eh[0], eh[1]);

    /* Buffed locomotion: MoveSpeed 2 * (1 + 0.5) = 3 u/s while the buff
       holds (applied ~42 ticks ago, 67-tick duration). */
    ASSERT(has(eagle, "StatusSlow"));
    float y0 = ((const float *)get(eagle, "Position"))[1];
    for (t = 0; t < 10; t++) { set_input(eagle, 0, 1.0f); tick(); }
    float dy_buffed = ((const float *)get(eagle, "Position"))[1] - y0;
    ASSERT(fabsf(dy_buffed - 10.0f * 3.0f / 60.0f) < 1e-3f);

    /* Expiry: the buff and its stack tracker are removed together. */
    for (t = 0; t < 40; t++) { set_input(eagle, 0, 0); tick(); }
    ASSERT(!has(eagle, "StatusSlow"));
    ASSERT(!has(eagle, "RecallHaste"));
    y0 = ((const float *)get(eagle, "Position"))[1];
    for (t = 0; t < 10; t++) { set_input(eagle, 0, 1.0f); tick(); }
    float dy_plain = ((const float *)get(eagle, "Position"))[1] - y0;
    ASSERT(fabsf(dy_plain - 10.0f * 2.0f / 60.0f) < 1e-3f);
    teardown();
}

/* Fuel = distance(spawner, eagle) at fire time; the tracker re-aims every
 * tick, fuel only ever shrinks (min(fuel, target distance),
 * MoveSystem.cs:259), and a recall projectile that runs dry short of a
 * fleeing eagle despawns WITHOUT leaving a new spawner (its
 * SpentProjectilePrefab is null). */
TEST(recall_fuel_equals_distance_and_homing_never_regains_fuel) {
    setup();
    clear_spawned();

    ecs_entity_t eagle = spawn_at("HeroEagle", 0, 0);
    possess(eagle, 1);
    set_input(eagle, 1.0f, 0); /* moving: only the too-many path recalls */
    /* level 1 -> recall limit 1: one resting feather force-recalls. */
    ecs_entity_t sp = spawn_feather_spawner(eagle, 1, 3.0f, 4.0f);

    run("game_time");
    run("status_effects"); /* recall pass: arms the spawner (too many) */
    ASSERT(has(sp, "SpawnOneShotProjectile"));
    ASSERT(!has(eagle, "StatusSlow")); /* not stationary: no haste */
    set_input(eagle, 0, 0); /* park the eagle for exact-position asserts */

    run("game_time");
    run("weapon_fire");    /* one-shot fire next tick */
    ASSERT(!ecs_is_alive(engine->world, sp)); /* spawner consumed */
    ecs_entity_t proj = find_first_named("FeatherRecall_Projectile_");
    ASSERT(proj != 0);

    struct TRt *rt = (struct TRt *)get_mut(proj, "ProjectileRuntime");
    ASSERT_NOT_NULL(rt);
    ASSERT(rt->shooter == eagle);
    ASSERT(fabsf(rt->dist - 5.0f) < 1e-4f); /* fuel = distance(3,4 -> 0,0) */
    const float *v = (const float *)get(proj, "Velocity");
    ASSERT(fabsf(v[0] - (-6.0f)) < 1e-3f);  /* speed 10 toward the eagle */
    ASSERT(fabsf(v[1] - (-8.0f)) < 1e-3f);

    /* Re-aim: eagle teleports to (3,0), 4 away â€” fuel clamps DOWN to 4. */
    set_pos(eagle, 3.0f, 0);
    run("game_time");
    run("movement");
    rt = (struct TRt *)get_mut(proj, "ProjectileRuntime");
    ASSERT(fabsf(rt->dist - (4.0f - 10.0f / 60.0f)) < 1e-3f);
    const float *pp = (const float *)get(proj, "Position");
    ASSERT(fabsf(pp[0] - 3.0f) < 1e-3f); /* heading straight down at it */

    /* Eagle flees out of fuel range: the projectile runs dry mid-chase,
       despawns, and leaves NO new spawner behind. */
    set_pos(eagle, 3.0f, -6.0f);
    for (int t = 0; t < 30; t++) {
        run("game_time"); run("movement"); run("projectile_lifecycle");
    }
    ASSERT(!ecs_is_alive(engine->world, proj));
    ASSERT_EQ(count_named_prefix("FeatherRecall_Spawner_"), 0);
    teardown();
}

/* Stationary-activated recalls with feathers >= SpeedBuffThreshold stack
 * the haste BY DURATION only (StackLimit 8): reapplication combines stacks
 * and resets the window (StatusEffectsSystem.cs:176-183); each expiry
 * drops one stack and re-arms the timer (:104-131); magnitude stays +50%
 * (MultiplyBuffStrongest â€” strongest wins, never cumulative). */
TEST(recall_haste_stacks_extend_duration_only) {
    setup();
    clear_spawned();

    ecs_entity_t eagle = spawn_at("HeroEagle", 0, 0);
    possess(eagle, 1);
    set_input(eagle, 0, 0);
    set_level(eagle, 5); /* recall limit 5: 4 feathers rest freely */
    for (int i = 1; i <= 4; i++)
        spawn_feather_spawner(eagle, i, (float)i, 3.0f);

    /* Stationary since tick 1; threshold at tick 8 arms feather #4 and
       applies stack 1 (4 feathers >= 2). Ticks 9 and 10 recall #3 and #2
       with 3 and 2 feathers on the ground: stacks 2 and 3. */
    for (int t = 0; t < 10; t++) { run("game_time"); run("status_effects"); }
    const struct THaste *hs = (const struct THaste *)get(eagle, "RecallHaste");
    ASSERT_NOT_NULL(hs);
    ASSERT_EQ(hs->stacks, 3);
    const int32_t *st = (const int32_t *)get(eagle, "StatusSlow");
    ASSERT_EQ(st[0], 67); /* window reset by the latest application */
    const float *sf = (const float *)get(eagle, "StatusSlow");
    ASSERT_EQ(sf[1], 0.5f); /* strongest, not cumulative */

    /* Tick 11 recalls the last feather with only 1 on the ground: below
       the threshold, no fourth stack. */
    run("game_time"); run("status_effects");
    hs = (const struct THaste *)get(eagle, "RecallHaste");
    ASSERT_EQ(hs->stacks, 3);

    /* Expiry drops one stack and re-arms the 67-tick window (the third
       application landed on tick 10; decrements run ticks 12..77). */
    for (int t = 0; t < 66; t++) { run("game_time"); run("status_effects"); }
    hs = (const struct THaste *)get(eagle, "RecallHaste");
    ASSERT_NOT_NULL(hs);
    ASSERT_EQ(hs->stacks, 2);
    st = (const int32_t *)get(eagle, "StatusSlow");
    ASSERT_EQ(st[0], 67);

    /* Two more windows: gone entirely. */
    for (int t = 0; t < 134; t++) { run("game_time"); run("status_effects"); }
    ASSERT(!has(eagle, "StatusSlow"));
    ASSERT(!has(eagle, "RecallHaste"));
    teardown();
}

/* A DEAD eagle keeps recalling: Unity zeroes MoveDirection for Defeated
 * units (MoveSystem.cs:117-126) and the recall query excludes only
 * OutOfGameTimer/DestroyGhostTag â€” so the corpse counts as stationary.
 * The post-respawn 2 s OutOfGame window pauses recall entirely. */
TEST(recall_runs_while_dead_pauses_while_out_of_game) {
    setup();
    clear_spawned();

    ecs_entity_t eagle = spawn_at("HeroEagle", 0, 0);
    possess(eagle, 1);
    set_input(eagle, 1.0f, 0);   /* alive input says "moving"... */
    set_level(eagle, 5);
    ecs_entity_t sp = spawn_feather_spawner(eagle, 1, 2.0f, 0);
    ecs_add_id(engine->world, eagle, comp("Defeated")); /* ...but dead */

    /* Defeated => stationary: activation at start+7, armed on tick 8. */
    for (int t = 0; t < 8; t++) { run("game_time"); run("status_effects"); }
    ASSERT(has(sp, "SpawnOneShotProjectile"));
    /* 1 feather < threshold 2: recall fires, no haste. */
    ASSERT(!has(eagle, "StatusSlow"));

    /* Out of game (the respawn window): recall is fully paused. */
    ecs_entity_t sp2 = spawn_feather_spawner(eagle, 2, -2.0f, 0);
    struct { int32_t ticks; } oog = { 120 };
    ecs_set_id(engine->world, eagle, comp("OutOfGame"), sizeof(oog), &oog);
    ecs_remove_id(engine->world, eagle, comp("Defeated"));
    set_input(eagle, 0, 0);
    for (int t = 0; t < 20; t++) { run("game_time"); run("status_effects"); }
    ASSERT(!has(sp2, "SpawnOneShotProjectile"));

    /* Back in game: the stationary clock starts fresh and recalls. */
    ecs_remove_id(engine->world, eagle, comp("OutOfGame"));
    for (int t = 0; t < 8; t++) { run("game_time"); run("status_effects"); }
    ASSERT(has(sp2, "SpawnOneShotProjectile"));
    teardown();
}

/* The recall projectile is a live Feather variant: it damages creatures it
 * passes through (DamageOnHit 12, IgnoreHitLimit) but despawns at its
 * owner without hurting heroes (faction filter). */
TEST(recall_projectile_damages_creatures_en_route) {
    setup();
    clear_spawned();

    ecs_entity_t eagle = spawn_at("HeroEagle", 0, 0);
    possess(eagle, 1);
    set_input(eagle, 0, 0);
    /* Slime parked on the flight path, out of the eagle's weapon range
       (3.5 > 3) so no feathers muddy the ledger. */
    ecs_entity_t slime = spawn_at("CreatureSlimeOrange", 3.5f, 0);
    float *sh = (float *)get_mut(slime, "Health");
    sh[0] = sh[1] = 1000.0f;
    ecs_add_id(engine->world, slime, comp("LocomotionDisabled"));

    spawn_feather_spawner(eagle, 1, 7.0f, 0); /* limit 1 at level 1 */
    for (int t = 0; t < 60; t++) tick();

    ASSERT_EQ(count_named_prefix("FeatherRecall_Projectile_"), 0); /* arrived */
    const float *hp = (const float *)get(slime, "Health");
    ASSERT_EQ(hp[0], 988.0f); /* one 12-damage hit, never re-hit */
    const float *eh = (const float *)get(eagle, "Health");
    ASSERT_EQ(eh[0], eh[1]);  /* the owner is never a victim */
    teardown();
}

/* --- game over ------------------------------------------------------------ */

/* Unity ends the game when InterpTick strictly EXCEEDS VictoryTick
 * (ServerGameOverSystem.cs:56), one more simulated tick than >=; defeat is
 * only checked after victory fails, so all-heroes-dead at exactly tick
 * 10800 is a DEFEAT. */
TEST(victory_requires_strictly_past_victory_tick) {
    setup(); /* spawn_list heroes stay alive */

    ecs_entity_t gs = ecs_lookup(engine->world, "GameState");
    int64_t *gt = (int64_t *)get_mut(gs, "GameTime");
    run("game_time"); /* prime tick-rate globals */

    *gt = 10800;
    run("app_stop");
    ASSERT(!engine->game_over); /* 10800 > 10800 is false */

    *gt = 10801;
    run("app_stop");
    ASSERT(engine->game_over);
    ASSERT(strncmp(engine->game_over_message, "Victory", 7) == 0);

    /* All heroes down at exactly the victory tick: defeat wins the tie. */
    engine->game_over = false;
    engine->game_over_message[0] = '\0';
    *gt = 10800;
    EntityList list = engine_entity_list(engine);
    for (int i = 0; i < list.count; i++) {
        const char *n = list.items[i].name;
        if (n && (strncmp(n, "HeroEagle_", 10) == 0 ||
                  strncmp(n, "HeroFrog_", 9) == 0))
            ecs_add_id(engine->world, list.items[i].id, comp("Defeated"));
    }
    engine_entity_list_free(&list);
    run("app_stop");
    ASSERT(engine->game_over);
    ASSERT(strncmp(engine->game_over_message, "Defeat", 6) == 0);
    teardown();
}

/* --- headless end-to-end (the port's acceptance mechanism) -------------- */

TEST(headless_full_game_to_completion) {
    setup_cfg("headless-verify");

    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);

    int ticks = 0;
    while (!engine->game_over && ticks < 12000) {
        tick();
        ticks++;
    }
    clock_gettime(CLOCK_MONOTONIC, &t1);
    double secs = (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9;

    const int32_t *ms = (const int32_t *)
        get(ecs_lookup(engine->world, "GameState"), "MatchStats");
    printf("\n    [seed 12345, %d ticks in %.2fs (%.0f ticks/s): %s | gems %d kills %d] ",
           ticks, secs, ticks / (secs > 0 ? secs : 1),
           engine->game_over_message, ms ? ms[0] : -1, ms ? ms[1] : -1);

    ASSERT(engine->game_over);
    /* Acceptance: the deterministic outcome at 50% damage taken, seed
     * 12345. History of the pin:
     *  - 2026-07 combat-math batch: VICTORY at 10801 (strict > victory
     *    operator, ServerGameOverSystem.cs:56).
     *  - 2026-07 weapons/projectiles batch: VICTORY at 10801, gems
     *    192 -> 105, kills 422 -> 313 (per-level pierce/bounce REPLACE
     *    the serialized base).
     *  - 2026-07 spawning/waves/respawn batch: VICTORY at 10801, gems
     *    105 -> 147, kills 313 -> 410 (wave N at (N-1)*5 s chasing the
     *    hero centroid, 1.25 s telegraph, pity-pool drops, 10 s respawn
     *    + half heal + 2 s OOG).
     *  - 2026-07 steering/movement/abilities batch (this pin): the
     *    outcome FLIPS to DEFEAT at tick 7591, gems 147 -> 102, kills
     *    410 -> 265. No-target creatures now converge on the hero
     *    centroid (the whole arena presses in instead of idling at their
     *    spawn rings), ability stages run Unity's 1+floor(d*60) ticks,
     *    ability hitboxes hit unlimited victims per swing, and the co-op
     *    tether keeps both heroes inside an 11 x 5.5 camera rect â€”
     *    strictly harder conditions, observed and re-pinned per the
     *    acceptance policy (never tuned). Winnability sanity at lower
     *    difficulty, same seed/build: damage_taken_ratio 0.25 ->
     *    VICTORY at 10801 (gems 136, kills 469); ratio 0.125 ->
     *    VICTORY at 10801 (gems 140, kills 465).
     *  - 2026-07 level-up proportional-rescale fix: removing the
     *    port-only full heal on level-up (HeroLevelUpSystem.cs:56-65
     *    commented out in live Unity; current HP rescales by the max
     *    multiplier, :143-148) reshuffles the deterministic run back to
     *    VICTORY at 10801, gems 102 -> 150, kills 265 -> 440. Observed
     *    and re-pinned, never tuned.
     *  - 2026-07 Eagle FeatherRecall batch (this pin): the recall loop
     *    lands (spent feathers recalled as homing projectiles that
     *    damage creatures en route, +50% stationary-recall haste), so
     *    the AI eagle's feathers now recycle instead of resting inert.
     *    VICTORY at 10801, gems 150 -> 196, kills 440 -> 490. Observed
     *    and re-pinned, never tuned. */
    ASSERT(strncmp(engine->game_over_message, "Victory", 7) == 0);
    ASSERT_EQ(ticks, 10801);
    teardown();
}

int main(void) {
    TEST_SUITE("Sashimi Native Systems");
    RUN(inherited_child_offset_survives_template_load);
