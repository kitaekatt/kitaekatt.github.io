# Source: Assets/Prefabs/Gameplay/CreatureEntity.prefab
# Creature archetype defaults; concrete creatures extend this
# with sparse overrides + ability children.
name: CreatureEntity
abstract: true
components:
  Position: { x: 0, y: 0 }
  Velocity: { x: 0, y: 0 }
  MoveSpeed: { value: 0.8 }   # UnitAuthoring.MoveSpeed
  Health: { current: 42, max: 42 }   # HealthAuthoring.MaxHealth
  Faction: { filter: "Unit_Red" }   # FactionAuthoring: Type=Unit Color=Red
  Collider: { shape: 1, radius: 0.2, width: 0, height: 0, enabled: true }   # circle r=0.2
  AISteering: { start_follow: 1.5, stop_follow: 0.75, start_flee: -1, acquire_radius: 5 }   # follow/flee distances + acquisition radius
  Experience: { xp: 0, level: 1 }
