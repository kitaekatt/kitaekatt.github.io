        <!-- TITLE -->
        <mxCell id="title" value="claude-md-audit &#8212; Skill Architecture&#10;resolve -&gt; fan-out DETECT per file -&gt; barrier + report -&gt; Q&amp;A gate -&gt; fan-out REMEDIATE per file -&gt; summary" style="text;html=1;align=center;verticalAlign=middle;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
